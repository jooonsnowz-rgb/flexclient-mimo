                  "content": "<!doctype html>\n<html>\n <body>\n  <h3>Game Save</h3>\n  <form>\n   <fieldset>\n    \n    Save Slot Name: <input type=\"text\">\n    <br> Difficulty: <input type=\"text\">\n    <br> Start Date: <input type=\"date\">\n    <br> End Date: <input type=\"date\">\n   </fieldset>\n   <fieldset>\n    \n    Chapter: <input type=\"text\">\n    <br> \n    Current Level: <input type=\"text\">\n    <br> \n    Boss Defeated: <input type=\"text\">\n    <br> \n    From Date: <input type=\"date\">\n    <br> \n    To Date: <input type=\"date\">\n    <br> \n    Completed? <input type=\"checkbox\">Yes \n    <input type=\"checkbox\">No\n   </fieldset>\n   <button>Next</button>\n  </form>\n </body>\n</html>",
