            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Podemos usar a função <code>input</code> quantas vezes quisermos.</p><code version=\"2\" codelang=\"javascript\" name=\"script.py\" visible-if=\"always\"><content><text value=\"user_input_1 = input(\" /><text value=\"&quot;Enter a number: &quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"user_input_2 = input(\" /><text value=\"&quot;Enter another number: &quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"print(user_input_1)\" /><text type=\"break\" /><text value=\"print(user_input_2)\" /></content><output><content><text value=\"Enter a number: 100\" /><text type=\"break\" /><text value=\"Enter another number: 200\" /><text type=\"break\" /><text value=\"100\" /><text type=\"break\" /><text value=\"200\" /></content></output></code></body></html>",
