            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Adicione a palavra-chave para criar um loop while.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"if\" /></content></option><option correct=\"false\"><content><text value=\"false\" /></content></option><option startIndex=\"0\" endIndex=\"5\" /></options></interaction></interactions><content><text value=\"while\" class=\"keyword\" /><text value=\" (\" /><text value=\"false\" class=\"literal\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Pause screen&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Certifique-se de escolher <code>while</code>.</p></body></html>"
