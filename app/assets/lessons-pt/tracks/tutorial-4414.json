          {
            "title": "Lesson #1",
            "id": 147896,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Vamos nos aprofundar nos valores que um array pode armazenar e como podemos atualizá-los. Como um HUD de jogo pode rastrear as estatísticas do jogador durante um nível.</p><webview version=\"2\" content=\"&lt;!DOCTYPE html&gt;&#xA;&lt;html lang=&quot;en&quot;&gt;&#xA;&lt;head&gt;&#xA;    &lt;meta charset=&quot;UTF-8&quot;&gt;&#xA;    &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;&#xA;    &lt;title&gt;Game HUD&lt;/title&gt;&#xA;    &lt;style&gt;&#xA;        body {&#xA;            font-family: Arial, sans-serif;&#xA;            display: flex;&#xA;            justify-content: center;&#xA;            align-items: center;&#xA;            margin: 24px auto;&#xA;            background: radial-gradient(circle at top, #1a2a3a, #0b1220);&#xA;            color: #fff;&#xA;        }&#xA;        .hud {&#xA;            background-color: rgba(30, 144, 255, 0.15);&#xA;            border: 1px solid rgba(255, 255, 255, 0.2);&#xA;            border-radius: 10px;&#xA;            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);&#xA;            padding: 18px;&#xA;            width: 320px;&#xA;            text-align: center;&#xA;        }&#xA;        .hud-title {&#xA;            font-size: 20px;&#xA;            margin-bottom: 14px;&#xA;        }&#xA;        .tabs {&#xA;            display: flex;&#xA;            justify-content: space-around;&#xA;            gap: 8px;&#xA;            margin-bottom: 14px;&#xA;        }&#xA;        .tab {&#xA;            cursor: pointer;&#xA;            padding: 10px;&#xA;            border-radius: 8px;&#xA;            background-color: rgba(255, 255, 255, 0.12);&#xA;            user-select: none;&#xA;            flex: 1;&#xA;        }&#xA;        .tab.active {&#xA;            background-color: rgba(255, 255, 255, 0.22);&#xA;        }&#xA;        .panel {&#xA;            font-size: 14px;&#xA;        }&#xA;        .row {&#xA;            display: flex;&#xA;            justify-content: space-between;&#xA;            gap: 8px;&#xA;            margin-bottom: 10px;&#xA;        }&#xA;        .cell {&#xA;            flex: 1;&#xA;            text-align: center;&#xA;            padding: 8px 6px;&#xA;            border-radius: 8px;&#xA;            background: rgba(255, 255, 255, 0.08);&#xA;        }&#xA;        .label {&#xA;            opacity: 0.85;&#xA;            font-size: 12px;&#xA;            display: block;&#xA;            margin-top: 4px;&#xA;        }&#xA;    &lt;/style&gt;&#xA;&lt;/head&gt;&#xA;&lt;body&gt;&#xA;    &lt;div class=&quot;hud&quot;&gt;&#xA;        &lt;div class=&quot;hud-title&quot;&gt;Level 1 HUD&lt;/div&gt;&#xA;        &lt;div class=&quot;tabs&quot;&gt;&#xA;            &lt;div class=&quot;tab active&quot; data-panel=&quot;1&quot;&gt;🧍 Player&lt;/div&gt;&#xA;            &lt;div class=&quot;tab&quot; data-panel=&quot;2&quot;&gt;👾 Enemies&lt;/div&gt;&#xA;            &lt;div class=&quot;tab&quot; data-panel=&quot;3&quot;&gt;🎒 Inventory&lt;/div&gt;&#xA;        &lt;/div&gt;&#xA;        &lt;div class=&quot;panel&quot;&gt;&#xA;            &lt;div class=&quot;row&quot; data-panel=&quot;1&quot;&gt;&#xA;                &lt;div class=&quot;cell&quot;&gt;100&lt;span class=&quot;label&quot;&gt;Health&lt;/span&gt;&lt;/div&gt;&#xA;                &lt;div class=&quot;cell&quot;&gt;0&lt;span class=&quot;label&quot;&gt;Score&lt;/span&gt;&lt;/div&gt;&#xA;                &lt;div class=&quot;cell&quot;&gt;1&lt;span class=&quot;label&quot;&gt;Lives&lt;/span&gt;&lt;/div&gt;&#xA;            &lt;/div&gt;&#xA;            &lt;div class=&quot;row&quot; data-panel=&quot;2&quot; style=&quot;display: none;&quot;&gt;&#xA;                &lt;div class=&quot;cell&quot;&gt;3&lt;span class=&quot;label&quot;&gt;Slimes&lt;/span&gt;&lt;/div&gt;&#xA;                &lt;div class=&quot;cell&quot;&gt;1&lt;span class=&quot;label&quot;&gt;Bats&lt;/span&gt;&lt;/div&gt;&#xA;                &lt;div class=&quot;cell&quot;&gt;0&lt;span class=&quot;label&quot;&gt;Boss&lt;/span&gt;&lt;/div&gt;&#xA;            &lt;/div&gt;&#xA;            &lt;div class=&quot;row&quot; data-panel=&quot;3&quot; style=&quot;display: none;&quot;&gt;&#xA;                &lt;div class=&quot;cell&quot;&gt;🗡️&lt;span class=&quot;label&quot;&gt;Sword&lt;/span&gt;&lt;/div&gt;&#xA;                &lt;div class=&quot;cell&quot;&gt;🧪&lt;span class=&quot;label&quot;&gt;Potion&lt;/span&gt;&lt;/div&gt;&#xA;                &lt;div class=&quot;cell&quot;&gt;🗝️&lt;span class=&quot;label&quot;&gt;Key&lt;/span&gt;&lt;/div&gt;&#xA;            &lt;/div&gt;&#xA;        &lt;/div&gt;&#xA;    &lt;/div&gt;&#xA;&#xA;    &lt;script&gt;&#xA;        document.addEventListener(&quot;DOMContentLoaded&quot;, function() {&#xA;            const tabs = document.querySelectorAll(&quot;.tab&quot;);&#xA;            const panels = document.querySelectorAll(&quot;.panel .row&quot;);&#xA;&#xA;            tabs.forEach(tab =&gt; {&#xA;                tab.addEventListener(&quot;click&quot;, function() {&#xA;                    tabs.forEach(t =&gt; t.classList.remove(&quot;active&quot;));&#xA;                    this.classList.add(&quot;active&quot;);&#xA;&#xA;                    const panel = this.getAttribute(&quot;data-panel&quot;);&#xA;                    panels.forEach(row =&gt; {&#xA;                        if (row.getAttribute(&quot;data-panel&quot;) === panel) {&#xA;                            row.style.display = &quot;flex&quot;;&#xA;                        } else {&#xA;                            row.style.display = &quot;none&quot;;&#xA;                        }&#xA;                    });&#xA;                });&#xA;            });&#xA;        });&#xA;    &lt;/script&gt;&#xA;&lt;/body&gt;&#xA;&lt;/html&gt;\" /></body></html>"
          },
