            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Onde um parâmetro de rota é adicionado em uma URL?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">No caminho da URL</item><item value=\"2\" correct=\"false\">Na importação de requests</item><item value=\"3\" correct=\"false\">Nos dados da resposta</item></selection><p visible-if=\"wrong\">No caminho da URL.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Você muda uma solicitação de <code>/courses?id=12</code> para <code>/courses/12</code>. Onde o ID é passado agora?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">No caminho da URL</item><item value=\"2\" correct=\"false\">Na importação de requests</item><item value=\"3\" correct=\"false\">Nos dados da resposta</item><item value=\"4\" correct=\"false\">Na string de consulta após <code>?</code></item></selection><p visible-if=\"wrong\">Certifique-se de escolher No caminho da URL.</p></body></html>",
