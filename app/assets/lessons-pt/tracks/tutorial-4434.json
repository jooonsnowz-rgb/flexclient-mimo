            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Por que passamos múltiplos arrays para uma função?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Para realizar uma ação específica que inclua informações de múltiplos arrays</item><item value=\"2\" correct=\"false\">Para realizar uma ação específica que inclua informações de apenas um array</item></selection><p visible-if=\"wrong\">Para realizar uma ação específica que inclua informações de múltiplos arrays.</p></body></html>"
