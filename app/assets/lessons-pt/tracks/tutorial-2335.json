          {
            "title": "Example: Passing a value ",
            "id": 80246,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Passe o valor <code>\"Tom\"</code> para a chamada da função.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"make_greeting\" class=\"title\" /><text value=\"(name)\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"f&quot;Hi there, \" /><text value=\"{name}\" class=\"subst\" /><text value=\"&quot;\" /><text value=\")\" /><text type=\"break\" /><text type=\"break\" /><text value=\"make_greeting(\" /><text value=\"&quot;Tom&quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"69\" endIndex=\"74\" /></interactions><output><content><text value=\"Hi there, Tom\" /></content></output></code><p visible-if=\"wrong\">Certifique-se de escolher <code>\"Tom\"</code>.</p></body></html>"
