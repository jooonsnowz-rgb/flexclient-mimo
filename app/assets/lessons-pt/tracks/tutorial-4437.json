            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Como podemos passar os valores do array para a função inline <code>.map()</code> para modificação?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Adicionando um parâmetro à função inline</item><item value=\"2\" correct=\"false\">Usando a sintaxe de colchetes</item></selection><p visible-if=\"wrong\">Adicionando um parâmetro à função inline.</p></body></html>"
          },
