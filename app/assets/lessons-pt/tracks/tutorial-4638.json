            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Um rastreador de entregas precisa do status numérico da resposta. Complete o acesso ao atributo.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"status = response.status_code\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"18\" endIndex=\"29\" /><option correct=\"false\"><content><text value=\"ok\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Certifique-se de escolher <code>status_code</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Um rastreador de entregas precisa do status numérico da resposta. Complete o acesso ao atributo.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"status = response.status_code\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"18\" endIndex=\"29\" /><option correct=\"false\"><content><text value=\"ok\" /></content></option><option correct=\"false\"><content><text value=\"json\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Certifique-se de escolher <code>status_code</code>.</p></body></html>",
