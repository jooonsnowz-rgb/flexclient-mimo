            "id": 131997,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Qual é o propósito dos parâmetros de consulta em uma solicitação HTTP?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Eles são usados para passar dados adicionais para o servidor, como filtros ou critérios de busca</item><item value=\"2\" correct=\"false\">Eles são usados para enviar credenciais de autenticação</item><item value=\"3\" correct=\"false\">Eles são usados para enviar dados no corpo da solicitação</item></selection><p visible-if=\"wrong\">Eles são usados para passar dados adicionais para o servidor, como filtros ou critérios de busca.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Você inclui <code>?category=books</code> em uma solicitação de produtos. Qual é a finalidade desse parâmetro de consulta?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Ele passa critérios de filtragem ao servidor</item><item value=\"2\" correct=\"false\">Ele autentica a requisição com uma credencial</item><item value=\"3\" correct=\"false\">Ele cria um novo produto a partir dos dados do corpo da requisição</item></selection><p visible-if=\"wrong\">Ele passa critérios de filtragem ao servidor.</p></body></html>",
