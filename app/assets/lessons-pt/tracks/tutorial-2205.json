            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Defina <code>total</code> como o resultado de <code>score</code> menos <code>penalty</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" score = \" /><text value=\"1084\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" penalty = \" /><text value=\"500\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" total = score - penalty;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(total);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"56\" endIndex=\"61\" /><option startIndex=\"64\" endIndex=\"71\" /><option startIndex=\"62\" endIndex=\"63\" /><option correct=\"false\"><content><text value=\"+\" /></content></option></options></interaction></interactions><output><content><text value=\"584\" /></content></output></code><p visible-if=\"wrong\">Certifique-se de escolher <code>score</code> seguido de <code>-</code> e finalmente <code>penalty</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Use <code>score</code> e <code>penalty</code> para <code>total</code> armazenar a pontuação restante <code>584</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" score = \" /><text value=\"1084\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" penalty = \" /><text value=\"500\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" total = score - penalty;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(total);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"56\" endIndex=\"61\" /><option startIndex=\"64\" endIndex=\"71\" /><option startIndex=\"62\" endIndex=\"63\" /><option correct=\"false\"><content><text value=\"+\" /></content></option><option correct=\"false\"><content><text value=\"=\" /></content></option><option correct=\"false\"><content><text value=\"total\" /></content></option></options></interaction></interactions><output><content><text value=\"584\" /></content></output></code><p visible-if=\"wrong\">Certifique-se de escolher <code>score</code> seguido de <code>-</code> e finalmente <code>penalty</code>.</p></body></html>",
            "hardModeSelected": true
