            "interactiveContent": "<!DOCTYPE html ><html><body><p>Qual sinal transforma <code>true</code> em <code>false</code>?</p><selection multiple=\"multiple\" iscode=\"false\"><item correct=\"true\" value=\"1\"><code>!</code></item><item correct=\"false\" value=\"2\"><code>-</code></item><item correct=\"false\" value=\"2\"><code>?</code></item></selection><p visible-if=\"wrong\">Certifique-se de escolher <code>!</code>.</p></body></html>",
