            "id": 144705,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Para que servem as tags <code>&lt;strong&gt;</code> e <code>&lt;/strong&gt;</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Eles definem o texto como importante</item><item value=\"2\" correct=\"false\">Elas tornam o texto inquebrável por quebra de linha</item></selection><p visible-if=\"wrong\">Eles definem o texto como importante.</p></body></html>"
