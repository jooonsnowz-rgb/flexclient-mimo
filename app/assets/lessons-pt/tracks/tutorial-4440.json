            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Complete a sintaxe para chamar a função <code>.map()</code> no array <code>hitPoints</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"51\" endIndex=\"64\" isDefault=\"true\" /></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" hitPoints = [\" /><text value=\"10\" class=\"number\" /><text value=\", \" /><text value=\"31\" class=\"number\" /><text value=\", \" /><text value=\"42\" class=\"number\" /><text value=\", \" /><text value=\"73\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" isEven = hitPoints.map(\" /><text value=\"element\" class=\"params\" /><text value=\" =&gt;\" /><text value=\" (element % \" /><text value=\"2\" class=\"number\" /><text value=\" == \" /><text value=\"0\" class=\"number\" /><text value=\"));\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(isEven);}\" /></content></code><p visible-if=\"wrong\">Certifique-se de escolher <code>hitPoints.map</code>.</p></body></html>"
          },
