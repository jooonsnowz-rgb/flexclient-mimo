            "hardModeContent": "<!DOCTYPE html ><html><body><p>O que está acontecendo aqui?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"requests.put(course_url, json=course_data)\" /><text type=\"break\" /><text value=\"requests.delete(lesson_url)\" /></content></code><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">O código substitui um registro completo do curso e depois remove uma lição antiga</item><item value=\"2\" correct=\"false\">O código substitui um registro completo do curso</item><item value=\"3\" correct=\"false\">O código remove uma lição antiga</item><item value=\"4\" correct=\"false\">O código edita parcialmente o curso, mas mantém todas as lições intactas</item></selection><p visible-if=\"wrong\">O código substitui um registro completo do curso e depois remove uma lição antiga.</p></body></html>"
