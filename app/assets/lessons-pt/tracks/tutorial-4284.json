            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>O valor padrão para o tipo é <code>text</code>, o que permite que os jogadores insiram texto que eles podem ver.</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"placeholder\" /></content></option><option correct=\"false\"><content><text value=\"&lt;br&gt;\" /></content></option><option startIndex=\"66\" endIndex=\"70\" /></options></interaction></interactions><content><text value=\"&lt;!doctype html&gt;\" class=\"meta\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"h4\" class=\"name\" /><text value=\"&gt;\" /><text value=\"New Game\" /><text value=\"&lt;/\" /><text value=\"h4\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"input\" class=\"name\" /><text value=\" \" /><text value=\"type\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;text&quot;\" class=\"string\" /><text value=\" \" /><text value=\"placeholder\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;Hero name&quot;\" class=\"string\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"br\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"input\" class=\"name\" /><text value=\" \" /><text value=\"type\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;password&quot;\" class=\"string\" /><text value=\" \" /><text value=\"placeholder\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;Secret code&quot;\" class=\"s