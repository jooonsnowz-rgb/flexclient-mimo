            "id": 145157,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>O que a instrução especial <code>console.log()</code> faz?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">Ele exibe um valor no console</item><item correct=\"false\" value=\"2\">Cria uma variável</item></selection><p visible-if=\"wrong\">Ele exibe um valor no console.</p></body></html>"
          },
          {
