            "id": 145158,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>O que este código exibe no console?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"const\" class=\"keyword\" /><text value=\" levelName = \" /><text value=\"&quot;Dungeon 1&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(levelName);\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>Dungeon 1</code></item><item value=\"2\" correct=\"false\"><code>levelName</code></item></selection><p visible-if=\"wrong\"><code>Dungeon 1</code>.</p></body></html>"
          },
