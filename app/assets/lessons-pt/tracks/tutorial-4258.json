            "id": 145146,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Declare a variável corretamente.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"0\" endIndex=\"3\" isDefault=\"true\" /></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" currentLevel = \" /><text value=\"1\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"currentLevel = \" /><text value=\"2\" class=\"number\" /><text value=\";\" /></content></code><p visible-if=\"wrong\">Certifique-se de escolher <code>let</code>.</p></body></html>"
