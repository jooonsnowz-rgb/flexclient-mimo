            "interactiveContent": "<!DOCTYPE html ><html><body><p>O que é o console?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">Uma área que exibe saída</item><item correct=\"false\" value=\"2\">A área onde escrevemos o código</item></selection><p visible-if=\"wrong\">Uma área que exibe saída.</p></body></html>"
          },
