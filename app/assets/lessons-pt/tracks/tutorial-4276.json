            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Como começamos a agrupar código relacionado?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Adicionando a palavra-chave <code>function</code></item><item value=\"2\" correct=\"false\">Adicionando parênteses</item></selection><p visible-if=\"wrong\">Adicionando a palavra-chave <code>function</code>.</p></body></html>"
