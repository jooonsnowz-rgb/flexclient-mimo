            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>O que as chaves <code>{</code> e <code>}</code> fazem?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Eles marcam o bloco de código que pertence à função</item><item value=\"2\" correct=\"false\">Eles indicam qual código a função deve pular</item></selection><p visible-if=\"wrong\">Eles marcam o bloco de código que pertence à função.</p></body></html>"
