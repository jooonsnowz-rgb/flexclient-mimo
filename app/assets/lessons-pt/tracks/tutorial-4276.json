            "id": 145619,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Onde vai o código que queremos agrupar?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Entre as chaves <code>{</code> e <code>}</code></item><item value=\"2\" correct=\"false\">Entre os parênteses <code>(</code> e <code>)</code></item></selection><p visible-if=\"wrong\">Entre as chaves <code>{</code> e <code>}</code>.</p></body></html>"
