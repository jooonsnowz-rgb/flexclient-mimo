            "interactiveContent": "<!DOCTYPE html ><html><body><p>O que este código exibe no console?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"0\" class=\"number\" /><text value=\"; i &lt; \" /><text value=\"3\" class=\"number\" /><text value=\"; i++) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Enemy spawned!&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>Enemy spawned!</code> três vezes</item><item value=\"2\" correct=\"false\">Os números <code>1</code> a <code>3</code></item><item value=\"3\" correct=\"false\">Os números <code>0</code> até <code>3</code></item></selection><p visible-if=\"wrong\"><code>Enemy spawned!</code> três vezes.</p></body></html>"
          },
