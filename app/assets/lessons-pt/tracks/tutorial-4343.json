            "title": "Lesson #10",
            "id": 146825,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Qual variável é a variável contadora do loop for?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"let\" class=\"keyword\" /><text value=\" label = \" /><text value=\"&quot;Coins:&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"let\" class=\"keyword\" /><text value=\" line = \" /><text value=\"&quot;&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"1\" class=\"number\" /><text value=\"; i &lt; \" /><text value=\"6\" class=\"number\" /><text value=\"; i++) {\" /><text type=\"break\" /><text value=\" line += i;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(line);\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>i</code></item><item value=\"2\" correct=\"false\"><code>label</code></item><item value=\"3\" correct=\"false\"><code>line</code></item></selection><p visible-if=\"wrong\">Certifique-se de escolher <code>i</code>.</p></body></html>"
          },
