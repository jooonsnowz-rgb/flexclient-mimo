            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Qual URL <code>requests.get()</code> cria a partir desses filtros?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"import\" class=\"keyword\" /><text value=\" requests\" /><text type=\"break\" /><text type=\"break\" /><text value=\"url = \" /><text value=\"&quot;https://things.mimo.dev/api/things&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"filters = {\" /><text value=\"&quot;category&quot;\" class=\"string\" /><text value=\": \" /><text value=\"&quot;home&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;status&quot;\" class=\"string\" /><text value=\": \" /><text value=\"&quot;active&quot;\" class=\"string\" /><text value=\"}\" /><text type=\"break\" /><text value=\"response = requests.get(url, params=filters)\" /></content></code><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>https://things.mimo.dev/api/things?category=home&amp;status=active</code></item><item value=\"2\" correct=\"false\"><code>https://things.mimo.dev/api/things/category/home/status/active</code></item><item value=\"3\" correct=\"false\"><code>https://things.mimo.dev/api/things?category=home?status=active</code></item></selection><p visible-if=\"wrong\">Certifique-se de escolher <code>https://things.mimo.dev/api/things?category=home&amp;status=active</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Qual URL <code>requests.get()</code> cria a partir desses filtros?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"import\" class=\"keyword\" /><text value=\" requests\" /><text type=\"break\" /><text type=\"break\" /><text value=\"url = \" /><text value=\"&quot;https://things.mimo.dev/api/things&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"filters = {\" /><text value=\"&quot;category&quot;\" class=\"string\" /><text value=\": \" /><text value=\"&quot;home&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;status&quot;\" class=\"string\" /><text value=\": \" /><text value=\"&quot;active&quot;\" class=\"string\" /><text value=\"}\" /><text type=\"break\" /><text value=\"response = requests.get(url, params=filters)\" /></content></code><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>https://things.mimo.dev/api/things?category=home&amp;status=active</code></item><item value=\"2\" correct=\"false\"><code>https://things.mimo.dev/api/things/category/home/status/active</code></item><item value=\"3\" correct=\"false\"><code>https://things.mimo.dev/api/things?category=home?status=active</code></item><item value=\"4\" correct=\"false\"><code>https://things.mimo.dev/api/things?category=home&amp;status</code></item></selection><p visible-if=\"wrong\"><code>https://things.mimo.dev/api/things?category=home&amp;status=active</code>.</p></body></html>",
            "hardModeSelected": true
