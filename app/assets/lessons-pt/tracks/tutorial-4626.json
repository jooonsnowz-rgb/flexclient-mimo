            "hardModeContent": "<!DOCTYPE html ><html><body><p>Qual símbolo separa os parâmetros de consulta depois do primeiro?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>&amp;</code></item><item value=\"2\" correct=\"false\"><code>?</code></item><item value=\"3\" correct=\"false\"><code>,</code></item></selection><p visible-if=\"wrong\">Certifique-se de escolher <code>&amp;</code>.</p></body></html>"
