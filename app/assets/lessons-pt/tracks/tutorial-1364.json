            "id": 89455,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Como podemos reutilizar um conjunto?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Nós salvamos em uma variável</item><item value=\"2\" correct=\"false\">Não podemos reutilizá-lo, só podemos exibi-lo</item></selection><p visible-if=\"wrong\">Nós salvamos em uma variável.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Salvamos um conjunto em uma variável quando queremos reutilizá-lo.</p><p>Qual linha armazena um conjunto em <code>colors</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>colors = {\"red\", \"blue\"}</code></item><item value=\"2\" correct=\"false\"><code>print({\"red\", \"blue\"})</code></item><item value=\"3\" correct=\"false\"><code>colors == {\"red\", \"blue\"}</code></item></selection><p visible-if=\"wrong\">Certifique-se de escolher <code>colors = {\"red\", \"blue\"}</code>.</p></body></html>"
          },
