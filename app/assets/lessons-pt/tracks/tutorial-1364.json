            "id": 89454,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Como separamos valores dentro de um conjunto?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Usando vírgulas <code>,</code></item><item value=\"2\" correct=\"false\">Usando ponto e vírgula <code>;</code></item></selection><p visible-if=\"wrong\">Usando vírgulas <code>,</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Usamos vírgulas <code>,</code> para separar valores dentro de um conjunto.</p><p>Qual símbolo deve substituir <code>;</code> em <code>{\"red\"; \"blue\"}</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Uma vírgula <code>,</code></item><item value=\"2\" correct=\"false\">Dois-pontos <code>:</code></item><item value=\"3\" correct=\"false\">Nenhum símbolo, porque os valores do conjunto ficam juntos</item></selection><p visible-if=\"wrong\">Certifique-se de escolher Uma vírgula <code>,</code>.</p></body></html>",
