          {
            "title": "Example: Commas",
            "id": 91167,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Codifica <code>athlete</code> e <code>time</code> separati da una virgola <code>,</code> per ottenere una tabella di tutti gli atleti e del tempo che hanno impiegato per completare la gara.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE race (&#xA; athlete varchar(255),&#xA; country varchar(255),&#xA; time varchar(255)&#xA;);&#xA;&#xA;INSERT INTO race (athlete, country, time)&#xA;VALUES ('Vivian Cheruiyot', 'Kenya', '14:26');&#xA;&#xA;INSERT INTO race (athlete, country, time)&#xA;VALUES ('Hellen Onsando Obiri', 'Kenya', '14:29');&#xA;&#xA;INSERT INTO race (athlete, country, time)&#xA;VALUES ('Almaz Ayana', 'Ethiopia', '14:33');&#xA;\"><tables><table name=\"race\"><row><header content=\"athlete\" /><header content=\"country\" /><header content=\"time\" /></row><row><data content=\"Vivian Cheruiyot\" /><data content=\"Kenya\" /><data content=\"14:26\" /></row><row><data content=\"Hellen Onsando Obiri\" /><data content=\"Kenya\" /><data content=\"14:29\" /></row><row><data content=\"Almaz Ayana\" /><data content=\"Ethiopia\" /><data content=\"14:33\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" athlete, \" /><text value=\"time\" class=\"built_in\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" race;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"7\" endIndex=\"20\" /></interactions><output><table name=\"Result\"><row><header content=\"athlete\" /><header content=\"time\" /></row><row><data content=\"Vivian Cheruiyot\" /><data content=\"14:26\" /></row><row><data content=\"Hellen Onsando Obiri\" /><data content=\"14:29\" /></row><row><data content=\"Almaz Ayana\" /><data content=\"14:33\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>athlete, time</code>.</p></body></html>"
          },
          {
            "title": "Question: Selecting with duplicates",
            "id": 91172,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quanti valori <code>Wii</code> saranno presenti nel risultato di questa query?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE games (&#xA; game varchar(255),&#xA; platform varchar(255),&#xA; year int&#xA;);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('Super Mario', 'NES', 1985);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('Mario Kart', 'Wii', 2008);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('Just Dance', 'Wii', 2009);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('FIFA 16', 'PS4', 2015);&#xA;\"><tables><table name=\"games\"><row><header content=\"game\" /><header content=\"platform\" /><header content=\"year\" /></row><row><data content=\"Super Mario\" /><data content=\"NES\" /><data content=\"1985\" /></row><row><data content=\"Mario Kart\" /><data content=\"Wii\" /><data content=\"2008\" /></row><row><data content=\"Just Dance\" /><data content=\"Wii\" /><data content=\"2009\" /></row><row><data content=\"FIFA 16\" /><data content=\"PS4\" /><data content=\"2015\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" platform\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" games;\" /></content><output><table name=\"Result\"><row><header content=\"platform\" /></row><row><data content=\"NES\" /></row><row><data content=\"Wii\" /></row><row><data content=\"Wii\" /></row><row><data content=\"PS4\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Due, perché la colonna <code>platform</code> ha due valori <code>Wii</code></item><item value=\"2\" correct=\"false\">Solo uno, perché i duplicati non vengono selezionati</item><item value=\"3\" correct=\"false\">Nessun valore <code>Wii</code></item></selection><p visible-if=\"wrong\">Due, perché la colonna <code>platform</code> ha due valori <code>Wii</code>.</p></body></html>"
          },
          {
            "title": "Example: Select all columns",
            "id": 91164,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Scrivi una query che selezioni tutte le colonne dalla tabella <code>cereals</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE cereals (&#xA;name varchar(255),&#xA;fiber int,&#xA;sugar int&#xA;);&#xA;&#xA;INSERT INTO cereals (name, fiber, sugar)&#xA;VALUES ('Cheerios', 2, 1);&#xA;&#xA;INSERT INTO cereals (name, fiber, sugar)&#xA;VALUES ('Lucky Charms', 0, 12);&#xA;&#xA;INSERT INTO cereals (name, fiber, sugar)&#xA;VALUES ('Cocoa Puffs', 0, 13);&#xA;&#xA;INSERT INTO cereals (name, fiber, sugar)&#xA;VALUES ('100% Bran', 10, 6);&#xA;\"><tables><table name=\"cereals\"><row><header content=\"name\" /><header content=\"fiber\" /><header content=\"sugar\" /></row><row><data content=\"Cheerios\" /><data content=\"2\" /><data content=\"1\" /></row><row><data content=\"Lucky Charms\" /><data content=\"0\" /><data content=\"12\" /></row><row><data content=\"Cocoa Puffs\" /><data content=\"0\" /><data content=\"13\" /></row><row><data content=\"100% Bran\" /><data content=\"10\" /><data content=\"6\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" cereals;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"8\" /><option startIndex=\"9\" endIndex=\"13\" /><option startIndex=\"14\" endIndex=\"21\" /><option startIndex=\"21\" endIndex=\"22\" /><option correct=\"false\"><content><text value=\".\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"fiber\" /><header content=\"sugar\" /></row><row><data content=\"Cheerios\" /><data content=\"2\" /><data content=\"1\" /></row><row><data content=\"Lucky Charms\" /><data content=\"0\" /><data content=\"12\" /></row><row><data content=\"Cocoa Puffs\" /><data content=\"0\" /><data content=\"13\" /></row><row><data content=\"100% Bran\" /><data content=\"10\" /><data content=\"6\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>SELECT</code>, seguito da <code>*</code> e poi <code>FROM</code>, <code>cereals</code>, <code>;</code>.</p></body></html>"
          },
          {
            "title": "Question: Select *",
            "id": 91165,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Qual è la differenza tra queste due query?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE race (&#xA; athlete varchar(255),&#xA; country varchar(255),&#xA; time varchar(255)&#xA;);&#xA;&#xA;INSERT INTO race (athlete, country, time)&#xA;VALUES ('Vivian Cheruiyot', 'Kenya', '14:26');&#xA;&#xA;INSERT INTO race (athlete, country, time)&#xA;VALUES ('Hellen Onsando Obiri', 'Kenya', '14:29');&#xA;&#xA;INSERT INTO race (athlete, country, time)&#xA;VALUES ('Almaz Ayana', 'Ethiopia', '14:33');&#xA;\"><tables><table name=\"race\"><row><header content=\"athlete\" /><header content=\"country\" /><header content=\"time\" /></row><row><data content=\"Vivian Cheruiyot\" /><data content=\"Kenya\" /><data content=\"14:26\" /></row><row><data content=\"Hellen Onsando Obiri\" /><data content=\"Kenya\" /><data content=\"14:29\" /></row><row><data content=\"Almaz Ayana\" /><data content=\"Ethiopia\" /><data content=\"14:33\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" race;\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" athlete, country, \" /><text value=\"time\" class=\"built_in\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" race;\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Non c'è alcuna differenza: entrambe le query selezionano tutte le colonne dalla tabella <code>race</code></item><item value=\"2\" correct=\"false\">La prima query non seleziona nulla, mentre la seconda seleziona tutte le colonne</item><item value=\"3\" correct=\"false\">Alla prima query manca un'istruzione <code>SELECT</code></item></selection><p visible-if=\"wrong\">Non c'è alcuna differenza: entrambe le query selezionano tutte le colonne dalla tabella <code>race</code>.</p></body></html>"
          },
          {
            "title": "Example: Distinct",
            "id": 91174,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Scrivi <code>SELECT</code>, seguito da <code>DISTINCT</code> e dalla colonna <code>platform</code>, per selezionare solo i valori univoci di <code>platform</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE games (&#xA; game varchar(255),&#xA; platform varchar(255),&#xA; year int&#xA;);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('Super Mario', 'NES', 1985);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('Mario Kart', 'Wii', 2008);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('Just Dance', 'Wii', 2009);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('FIFA 16', 'PS4', 2015);&#xA;\"><tables><table name=\"games\"><row><header content=\"game\" /><header content=\"platform\" /><header content=\"year\" /></row><row><data content=\"Super Mario\" /><data content=\"NES\" /><data content=\"1985\" /></row><row><data content=\"Mario Kart\" /><data content=\"Wii\" /><data content=\"2008\" /></row><row><data content=\"Just Dance\" /><data content=\"Wii\" /><data content=\"2009\" /></row><row><data content=\"FIFA 16\" /><data content=\"PS4\" /><data content=\"2015\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"DISTINCT\" class=\"keyword\" /><text value=\" platform\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" games;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"0\" endIndex=\"24\" /></interactions><output><table name=\"Result\"><row><header content=\"platform\" /></row><row><data content=\"NES\" /></row><row><data content=\"Wii\" /></row><row><data content=\"PS4\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>SELECT DISTINCT platform</code>.</p></body></html>"
          },
          {
            "title": "Question: Ascending by default ",
            "id": 91780,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quale query ordina gli elementi in ordine crescente in base al loro <code>score</code>?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" score;\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" score \" /><text value=\"ASC\" class=\"keyword\" /><text value=\";\" /><text type=\"break\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Entrambi</item><item value=\"2\" correct=\"false\">Il primo</item><item value=\"3\" correct=\"false\">Il secondo</item></selection><p visible-if=\"wrong\">Assicurati di scegliere Entrambi.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Gli studenti hanno punteggi di <code>90</code>, <code>40</code> e <code>70</code>. Quale query mostrata li restituisce nell'ordine <code>40</code>, <code>70</code>, <code>90</code>?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" score;\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" score \" /><text value=\"ASC\" class=\"keyword\" /><text value=\";\" /><text type=\"break\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Entrambi</item><item value=\"2\" correct=\"false\">Il primo</item><item value=\"3\" correct=\"false\">Il secondo</item><item value=\"4\" correct=\"false\">Nessuna delle due query, perché l'ordine crescente richiede sempre <code>ASCENDING</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere Entrambi.</p></body></html>"
          },
          {
            "title": "Example: Order by ",
            "id": 91776,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Riordina gli elementi nella tabella <code>students</code> in base al loro <code>score</code> con <code>ORDER BY score</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; score int&#xA;);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Jean Miller', 5);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Emma Brown', 8);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Reese Jones', 2);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Kim Lee', 9);&#xA;\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"score\" /></row><row><data content=\"Jean Miller\" /><data content=\"5\" /></row><row><data content=\"Emma Brown\" /><data content=\"8\" /></row><row><data content=\"Reese Jones\" /><data content=\"2\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" score;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"23\" endIndex=\"37\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"score\" /></row><row><data content=\"Reese Jones\" /><data content=\"2\" /></row><row><data content=\"Jean Miller\" /><data content=\"5\" /></row><row><data content=\"Emma Brown\" /><data content=\"8\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>ORDER BY score</code>.</p></body></html>"
          },
          {
            "title": "Question: Alphabetical order",
            "id": 91778,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quali valori vengono prima quando ordiniamo in base a una proprietà testuale?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">I valori con le lettere che vengono prima nell'alfabeto vengono prima</item><item value=\"2\" correct=\"false\">Non possiamo saperlo: ordinare in base alle proprietà testuali produce risultati casuali</item><item value=\"3\" correct=\"false\">Non possiamo ordinare in base alle proprietà testuali</item></selection><p visible-if=\"wrong\">I valori con le lettere che vengono prima nell'alfabeto vengono prima.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Una proprietà testuale contiene <code>\"Zoe\"</code>, <code>\"Ava\"</code> e <code>\"Mia\"</code>. Quale valore viene per primo in ordine crescente?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>\"Ava\"</code>, perché la sua prima lettera viene prima nell'alfabeto</item><item value=\"2\" correct=\"false\"><code>\"Zoe\"</code>, perché i valori testuali vengono ordinati a partire dalla fine dell'alfabeto</item><item value=\"3\" correct=\"false\"><code>\"Mia\"</code>, perché il valore centrale rimane per primo</item><item value=\"4\" correct=\"false\">Nessun valore, perché le proprietà testuali non possono essere ordinate</item></selection><p visible-if=\"wrong\"><code>\"Ava\"</code>, perché la sua prima lettera viene prima nell'alfabeto.</p></body></html>"
          },
          {
            "title": "Question: Descending order",
            "id": 91781,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>In che modo questa query ordina gli elementi?<br /></p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" score \" /><text value=\"DESC\" class=\"keyword\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">In ordine decrescente</item><item value=\"2\" correct=\"false\">In ordine crescente</item><item value=\"3\" correct=\"false\">Lo stesso ordine, perché <code>DESC</code> non è una parola chiave valida</item></selection><p visible-if=\"wrong\">In ordine decrescente.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Gli studenti hanno punteggi di <code>42</code>, <code>95</code> e <code>70</code>. In quale ordine li restituisce la query?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" score \" /><text value=\"DESC\" class=\"keyword\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>95</code>, <code>70</code>, <code>42</code></item><item value=\"2\" correct=\"false\"><code>42</code>, <code>70</code>, <code>95</code></item><item value=\"3\" correct=\"false\"><code>42</code>, <code>95</code>, <code>70</code>, perché <code>DESC</code> mantiene l'ordine di memorizzazione</item><item value=\"4\" correct=\"false\">Nessuna riga, perché <code>DESC</code> filtra i punteggi più bassi</item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>95</code>, <code>70</code>, <code>42</code>.</p></body></html>"
          },
          {
            "title": "Example: Descending order",
            "id": 91784,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Codifica una parola chiave in modo che l'elemento con il valore <code>name</code><code>Reese Jones</code> venga per primo.<br /></p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; score int&#xA;);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Jean Miller', 5);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Emma Brown', 8);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Reese Jones', 2);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Kim Lee', 9);&#xA;\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"score\" /></row><row><data content=\"Jean Miller\" /><data content=\"5\" /></row><row><data content=\"Emma Brown\" /><data content=\"8\" /></row><row><data content=\"Reese Jones\" /><data content=\"2\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"DESC\" class=\"keyword\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"37\" endIndex=\"41\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"score\" /></row><row><data content=\"Reese Jones\" /><data content=\"2\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row><row><data content=\"Jean Miller\" /><data content=\"5\" /></row><row><data content=\"Emma Brown\" /><data content=\"8\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>DESC</code>.</p></body></html>"
          },
          {
            "title": "Question: The `=` operator 2",
            "id": 91793,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Per quali tipi di elementi filtra questa query?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" books\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" title = \" /><text value=\"'The Prince'\" class=\"string\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Elementi di libri con la proprietà <code>title</code> uguale a <code>'The Prince'</code></item><item value=\"2\" correct=\"false\">Elementi libro con la proprietà <code>title</code> diversa da <code>'The Prince'</code></item><item value=\"3\" correct=\"false\">Elementi di libri con tutte le proprietà uguali a <code>'The Prince'</code></item></selection><p visible-if=\"wrong\">Elementi di libri con la proprietà <code>title</code> uguale a <code>'The Prince'</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>La tabella contiene due libri intitolati <code>'The Prince'</code> e uno intitolato <code>'The Little Prince'</code>. Quali righe restituisce la query?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" books\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" title = \" /><text value=\"'The Prince'\" class=\"string\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Entrambe le righe il cui <code>title</code> è uguale a <code>'The Prince'</code></item><item value=\"2\" correct=\"false\">Solo la riga intitolata <code>'The Little Prince'</code></item><item value=\"3\" correct=\"false\">Tutte e tre le righe, perché <code>SELECT *</code> ignora il filtro</item><item value=\"4\" correct=\"false\">Solo la prima riga corrispondente, perché <code>WHERE</code> si ferma dopo una corrispondenza</item></selection><p visible-if=\"wrong\">Entrambe le righe il cui <code>title</code> è uguale a <code>'The Prince'</code>.</p></body></html>"
          },
          {
            "title": "Example: WHERE",
            "id": 91791,
