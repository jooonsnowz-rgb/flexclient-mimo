          {
            "title": "Intro",
            "id": 78173,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Impariamo a scrivere istruzioni condizionali che gestiscono condizioni specifiche, come nel programma qui sotto.</p><webview version=\"2\" visible-if=\"always\" content=\"&lt;!doctype html&gt;&#xA;&lt;html&gt;&#xA; &lt;head&gt;&#xA;  &lt;style&gt;&#xA;   body {&#xA;    text-align: center&#xA;   }&#xA;  &lt;/style&gt;&#xA; &lt;/head&gt;&#xA; &lt;body&gt;&#xA;  &lt;img id=&quot;greetingImage&quot;&#xA;   src=&quot;https://images.unsplash.com/photo-1506126383447-1baf4fb3c267?ixlib=rb-1.2.1&amp;ixid=eyJhcHBfaWQiOjEyMDd9&amp;auto=format&amp;fit=crop&amp;w=2850&amp;q=80&quot;&#xA;   height=&quot;200px&quot;&gt;&#xA;  &lt;h1 id=&quot;greeting&quot;&gt;Good Afternoon&lt;/h1&gt;&#xA;  &lt;h3&gt;Time: &lt;span id=&quot;hour&quot;&gt;12&lt;/span&gt;:00&lt;/h3&gt; 0:00 &lt;input id=&quot;slider&quot;&#xA;   type=&quot;range&quot; min=&quot;0&quot; max=&quot;23&quot; oninput=&quot;slide(this.value)&quot;&#xA;   onchange=&quot;slide(this.value)&quot;&gt; 23:00 &lt;script&gt;&#xA;   function slide(value) {&#xA;    const time = document.getElementById(&quot;hour&quot;);&#xA;    time.textContent = value;&#xA;    const image = document.getElementById(&quot;greetingImage&quot;);&#xA;    const greeting = document.getElementById(&quot;greeting&quot;);&#xA;    if (value &lt; 7) {&#xA;     image.setAttribute(&quot;src&quot;,&#xA;      &quot;https://mimo.app/i/ride-and-shine.png&quot;);&#xA;     greeting.textContent = &quot;Rise and shine&quot;;&#xA;    } else if (value &lt; 12) {&#xA;     image.setAttribute(&quot;src&quot;, &quot;https://mimo.app/i/good-morning.png&quot;);&#xA;     greeting.textContent = &quot;Good morning&quot;;&#xA;    } else if (value &lt; 17) {&#xA;     greeting.textContent = &quot;Good afternoon&quot;;&#xA;     image.setAttribute(&quot;src&quot;,&#xA;      &quot;https://mimo.app/i/good-afternoon.png&quot;);&#xA;    } else if (value &lt; 21) {&#xA;     image.setAttribute(&quot;src&quot;, &quot;https://mimo.app/i/good-evening.png&quot;);&#xA;     greeting.textContent = &quot;Good evening&quot;;&#xA;    } else {&#xA;     image.setAttribute(&quot;src&quot;, &quot;https://mimo.app/i/good-night.png&quot;);&#xA;     greeting.textContent = &quot;Good night&quot;;&#xA;    }&#xA;   }&#xA;  &lt;/script&gt;&#xA; &lt;/body&gt;&#xA;&lt;/html&gt;\" /></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Intro 2",
            "id": 78176,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quando sposti il cursore, questo programma usa istruzioni condizionali per mostrare saluti diversi se l'ora è inferiore a 7, 12, 17 e 21.</p><webview version=\"2\" visible-if=\"always\" content=\"&lt;!doctype html&gt;&#xA;&lt;html&gt;&#xA; &lt;head&gt;&#xA;  &lt;style&gt;&#xA;   body {&#xA;    text-align: center&#xA;   }&#xA;  &lt;/style&gt;&#xA; &lt;/head&gt;&#xA; &lt;body&gt;&#xA;  &lt;img id=&quot;greetingImage&quot;&#xA;   src=&quot;https://images.unsplash.com/photo-1506126383447-1baf4fb3c267?ixlib=rb-1.2.1&amp;ixid=eyJhcHBfaWQiOjEyMDd9&amp;auto=format&amp;fit=crop&amp;w=2850&amp;q=80&quot;&#xA;   height=&quot;200px&quot;&gt;&#xA;  &lt;h1 id=&quot;greeting&quot;&gt;Good Afternoon&lt;/h1&gt;&#xA;  &lt;h3&gt;Time: &lt;span id=&quot;hour&quot;&gt;12&lt;/span&gt;:00&lt;/h3&gt; 0:00 &lt;input id=&quot;slider&quot;&#xA;   type=&quot;range&quot; min=&quot;0&quot; max=&quot;23&quot; oninput=&quot;slide(this.value)&quot;&#xA;   onchange=&quot;slide(this.value)&quot;&gt; 23:00 &lt;script&gt;&#xA;   function slide(value) {&#xA;    const time = document.getElementById(&quot;hour&quot;);&#xA;    time.textContent = value;&#xA;    const image = document.getElementById(&quot;greetingImage&quot;);&#xA;    const greeting = document.getElementById(&quot;greeting&quot;);&#xA;    if (value &lt; 7) {&#xA;     image.setAttribute(&quot;src&quot;,&#xA;      &quot;https://mimo.app/i/ride-and-shine.png&quot;);&#xA;     greeting.textContent = &quot;Rise and shine&quot;;&#xA;    } else if (value &lt; 12) {&#xA;     image.setAttribute(&quot;src&quot;, &quot;https://mimo.app/i/good-morning.png&quot;);&#xA;     greeting.textContent = &quot;Good morning&quot;;&#xA;    } else if (value &lt; 17) {&#xA;     greeting.textContent = &quot;Good afternoon&quot;;&#xA;     image.setAttribute(&quot;src&quot;,&#xA;      &quot;https://mimo.app/i/good-afternoon.png&quot;);&#xA;    } else if (value &lt; 21) {&#xA;     image.setAttribute(&quot;src&quot;, &quot;https://mimo.app/i/good-evening.png&quot;);&#xA;     greeting.textContent = &quot;Good evening&quot;;&#xA;    } else {&#xA;     image.setAttribute(&quot;src&quot;, &quot;https://mimo.app/i/good-night.png&quot;);&#xA;     greeting.textContent = &quot;Good night&quot;;&#xA;    }&#xA;   }&#xA;  &lt;/script&gt;&#xA; &lt;/body&gt;&#xA;&lt;/html&gt;\" /></body></html>",
            "hardModeSelected": true
