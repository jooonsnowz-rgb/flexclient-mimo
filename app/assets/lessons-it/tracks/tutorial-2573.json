            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Che cos'è una classe?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Un modello che definisce metodi e proprietà relativi a un oggetto specifico</item><item value=\"2\" correct=\"false\">Una funzione integrata fornita da Swift</item><item value=\"3\" correct=\"false\">Un riferimento alle variabili utilizzate in una funzione</item></selection><p visible-if=\"wrong\">Un modello che definisce metodi e proprietà relativi a un oggetto specifico.</p></body></html>"
          },
