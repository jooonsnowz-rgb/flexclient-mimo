            "id": 120918,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Che cosa c'è che non va nel codice fornito?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE toys( &#xA;    name varchar(255), &#xA;    price int &#xA;); &#xA; &#xA;INSERT INTO toys(name, price) &#xA;VALUES(&quot;Teddy bear&quot;, 14); &#xA; &#xA;INSERT INTO toys(name, price) &#xA;VALUES(&quot;Remote controlled car&quot;, 12);\"><tables><table name=\"toys\"><row><header content=\"name\" /><header content=\"price\" /></row><row><data content=\"Teddy bear\" /><data content=\"14\" /></row><row><data content=\"Remote controlled car\" /><data content=\"12\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"INSERT\" class=\"keyword\" /><text value=\" \" /><text value=\"INTO\" class=\"keyword\" /><text value=\" toys(\" /><text value=\"name\" class=\"keyword\" /><text value=\", price, \" /><text value=\"store\" class=\"keyword\" /><text value=\") \" /><text type=\"break\" /><text value=\"VALUES\" class=\"keyword\" /><text value=\"(\" /><text value=\"&quot;Beyblade&quot;\" class=\"string\" /><text value=\", \" /><text value=\"13\" class=\"number\" /><text value=\"); \" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" toys;\" /></content><output><table name=\"Result\"><row><data content=\"No result!\" /></row></table></output></code><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Non esiste alcuna colonna denominata store</item><item value=\"2\" correct=\"false\">La riga <code>VALUES</code> deve venire prima</item><item value=\"3\" correct=\"false\"><code>INSERT</code>, non <code>INSERT INTO</code></item></selection><p visible-if=\"wrong\">Non esiste alcuna colonna denominata store.</p></body></html>"
          },
          {
            "title": "Example 1",
            "id": 120922,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Inserisci una nuova riga nella tabella <code>toys</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE toys( &#xA;    name varchar(255), &#xA;    price int &#xA;); &#xA; &#xA;INSERT INTO toys(name, price) &#xA;VALUES(&quot;Teddy bear&quot;, 14); &#xA; &#xA;INSERT INTO toys(name, price) &#xA;VALUES(&quot;Remote controlled car&quot;, 12);\"><tables><table name=\"toys\"><row><header content=\"name\" /><header content=\"price\" /></row><row><data content=\"Teddy bear\" /><data content=\"14\" /></row><row><data content=\"Remote controlled car\" /><data content=\"12\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"INSERT\" class=\"keyword\" /><text value=\" \" /><text value=\"INTO\" class=\"keyword\" /><text value=\" toys(\" /><text value=\"name\" class=\"keyword\" /><text value=\", price) \" /><text type=\"break\" /><text value=\"VALUES\" class=\"keyword\" /><text value=\"(\" /><text value=\"&quot;Clay mix&quot;\" class=\"string\" /><text value=\", \" /><text value=\"9\" class=\"number\" /><text value=\"); \" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" toys;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"11\" /><option correct=\"false\"><content><text value=\"SELECT\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"price\" /></row><row><data content=\"Teddy bear\" /><data content=\"14\" /></row><row><data content=\"Remote controlled car\" /><data content=\"12\" /></row><row><data content=\"Clay mix\" /><data content=\"9\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>INSERT</code>, seguito da <code>INTO</code>.</p></body></html>"
          },
          {
            "title": "Question 4",
            "id": 120920,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quale dei seguenti codici può eliminare tutti i valori dalla tabella fornita?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE toys( &#xA;    name varchar(255), &#xA;    price int &#xA;); &#xA; &#xA;INSERT INTO toys(name, price) &#xA;VALUES(&quot;Teddy bear&quot;, 14); &#xA; &#xA;INSERT INTO toys(name, price) &#xA;VALUES(&quot;Remote controlled car&quot;, 12);\"><tables><table name=\"toys\"><row><header content=\"name\" /><header content=\"price\" /></row><row><data content=\"Teddy bear\" /><data content=\"14\" /></row><row><data content=\"Remote controlled car\" /><data content=\"12\" /></row></table></tables></database><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>DELETE FROM toys</code></item><item value=\"2\" correct=\"false\"><code>DELETE FROM toys WHERE price &lt; 10</code></item><item value=\"3\" correct=\"false\"><code>DELETE</code></item></selection><p visible-if=\"wrong\"><code>DELETE FROM toys</code>.</p></body></html>"
          },
          {
            "title": "Example 5",
            "id": 120926,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Elimina tutti i valori della tabella <code>toys</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE toys( &#xA;    name varchar(255), &#xA;    price int &#xA;); &#xA; &#xA;INSERT INTO toys(name, price) &#xA;VALUES(&quot;Teddy bear&quot;, 14); &#xA; &#xA;INSERT INTO toys(name, price) &#xA;VALUES(&quot;Remote controlled car&quot;, 12); &#xA; &#xA;INSERT INTO toys(name, price) &#xA;VALUES(&quot;Clay mix&quot;, 9);\"><tables><table name=\"toys\"><row><header content=\"name\" /><header content=\"price\" /></row><row><data content=\"Teddy bear\" /><data content=\"14\" /></row><row><data content=\"Remote controlled car\" /><data content=\"12\" /></row><row><data content=\"Clay mix\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"DELETE\" class=\"keyword\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" toys; \" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" toys;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"12\" endIndex=\"16\" /></interactions><output><table name=\"Result\"><row><data content=\"No result!\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>toys</code>.</p></body></html>"
