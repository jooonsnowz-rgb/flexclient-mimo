            "interactiveContent": "<!DOCTYPE html ><html><body><p>Crea una tabella chiamata <code>Birthdays</code>.</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"CREATE\" class=\"keyword\" /><text value=\" \" /><text value=\"TABLE\" class=\"keyword\" /><text value=\" Birthdays (\" /><text type=\"break\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"TEXT\" class=\"built_in\" /><text value=\",\" /><text type=\"break\" /><text value=\" birthday \" /><text value=\"TEXT\" class=\"built_in\" /><text type=\"break\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"12\" /><option startIndex=\"13\" endIndex=\"22\" /><option correct=\"false\"><content><text value=\"NAMED\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><data content=\"No result!\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>CREATE</code>, seguito da <code>TABLE</code> e infine <code>Birthdays</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Crea una tabella chiamata <code>Reminders</code> con le colonne mostrate.</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"CREATE\" class=\"keyword\" /><text value=\" \" /><text value=\"TABLE\" class=\"keyword\" /><text value=\" \" /><text value=\"Reminders\" /><text value=\" \" /><text value=\"(\" /><text type=\"break\" /><text value=\" \" /><text value=\"title\" /><text value=\" \" /><text value=\"TEXT\" class=\"keyword\" /><text value=\",\" /><text type=\"break\" /><text value=\" \" /><text value=\"dueDate\" /><text value=\" \" /><text value=\"TEXT\" class=\"keyword\" /><text type=\"break\" /><text value=\")\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"12\" /><option startIndex=\"13\" endIndex=\"22\" /><option correct=\"false\"><content><text value=\"INSERT\" /></content></option><option correct=\"false\"><content><text value=\"INTO\" /></content></option><option correct=\"false\"><content><text value=\"Birthdays\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Assicurati di scegliere <code>CREATE</code>, seguito da <code>TABLE</code> e infine <code>Reminders</code>.</p></body></html>",
