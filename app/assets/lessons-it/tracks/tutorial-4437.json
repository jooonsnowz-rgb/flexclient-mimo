            "interactiveContent": "<!DOCTYPE html ><html><body><p>A cosa possiamo accedere includendo un secondo parametro nella funzione inline di <code>.map()</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">L'indice dell'iterazione</item><item value=\"3\" correct=\"false\">Il valore dell'array</item></selection><p visible-if=\"wrong\">L'indice dell'iterazione.</p></body></html>"
          },
          {
