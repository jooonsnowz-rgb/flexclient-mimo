            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Che cosa c'è che non va in questo codice?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"Musical\" class=\"title\" /><text value=\":\" /><text type=\"break\" /><text value=\"  name = \" /><text value=\"&quot;Hamilton&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"  length = \" /><text value=\"&quot;2h 40m&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"songs = \" /><text value=\"46\" class=\"number\" /><text type=\"break\" /><text type=\"break\" /><text value=\"hamilton = Musical()\" /><text type=\"break\" /><text value=\"print(hamilton.songs)\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">La variabile <code>songs</code> deve essere indentata per far parte della definizione della classe</item><item value=\"2\" correct=\"false\">Non c'è niente che non va in questo codice</item><item value=\"3\" correct=\"false\">La variabile <code>hamilton</code> deve iniziare con una lettera maiuscola</item></selection><p visible-if=\"wrong\">La variabile <code>songs</code> deve essere indentata per far parte della definizione della classe.</p></body></html>"
          },
