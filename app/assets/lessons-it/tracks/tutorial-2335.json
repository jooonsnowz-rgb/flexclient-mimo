          {
            "title": "Question: Similar code",
            "id": 80277,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Come facciamo a sapere che dovremmo spostare del codice all'interno di una funzione? </p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Quando c'è molto codice duplicato che fa la stessa cosa</item><item value=\"2\" correct=\"false\">Quando ci sono molte righe di codice</item><item value=\"3\" correct=\"false\">Quando creiamo molte variabili</item></selection><p visible-if=\"wrong\">Quando c'è molto codice duplicato che fa la stessa cosa.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Gli stessi passaggi di pagamento compaiono in cinque punti. Quale modifica riduce meglio questa duplicazione?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Spostare i passaggi in una funzione e chiamarla in ogni punto.</item><item value=\"2\" correct=\"false\">Creare più variabili lasciando ogni copia ripetuta.</item><item value=\"3\" correct=\"false\">Dividere ogni copia ripetuta su più righe.</item></selection><p visible-if=\"wrong\">Spostare i passaggi in una funzione e chiamarla in ogni punto.</p></body></html>"
