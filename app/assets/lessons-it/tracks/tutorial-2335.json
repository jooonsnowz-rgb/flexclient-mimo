            "id": 80323,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Restituisci la variabile da questa funzione.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"get_brightness\" class=\"title\" /><text value=\"()\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\"  brightness = \" /><text value=\"67\" class=\"number\" /><text type=\"break\" /><text value=\"  \" /><text value=\"return\" class=\"keyword\" /><text value=\" brightness\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(get_brightness())\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"49\" endIndex=\"59\" /></interactions><output><content><text value=\"67\" /></content></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>brightness</code>.</p></body></html>"
