            "interactiveContent": "<!DOCTYPE html ><html><body><p>Che cosa visualizza questo codice nella console?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"let\" class=\"keyword\" /><text value=\" frameCount = \" /><text value=\"14000\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"frameCount++;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(frameCount);\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>14001</code></item><item value=\"2\" correct=\"false\"><code>14000</code></item><item value=\"3\" correct=\"false\"><code>13999</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>14001</code>.</p></body></html>"
