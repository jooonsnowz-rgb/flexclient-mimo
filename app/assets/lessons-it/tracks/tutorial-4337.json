            "id": 146704,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Che cosa visualizza questo codice nella console?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"let\" class=\"keyword\" /><text value=\" inventory = \" /><text value=\"&quot;sword shield&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"inventory = inventory + \" /><text value=\"&quot; potion&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(inventory);\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>sword shield potion</code></item><item value=\"2\" correct=\"false\"><code>potion sword shield</code></item><item value=\"3\" correct=\"false\"><code>inventory potion</code></item></selection><p visible-if=\"wrong\"><code>sword shield potion</code>.</p></body></html>"
