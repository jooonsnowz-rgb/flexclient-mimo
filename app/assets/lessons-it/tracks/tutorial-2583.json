            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Che cosa fa l'operatore <code>!</code> in Swift?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">Converte i valori booleani <code>true</code> o <code>false</code> nel loro opposto</item><item correct=\"false\" value=\"2\">Controlla se i valori sono uguali</item></selection><p visible-if=\"wrong\">Converte i valori booleani <code>true</code> o <code>false</code> nel loro opposto.</p></body></html>"
          },
