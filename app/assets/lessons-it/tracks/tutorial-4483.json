            "id": 148951,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Qual è il nodo radice dell'albero della scena di questo gioco?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>scene</code></item><item value=\"2\" correct=\"false\"><code>layer</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>scene</code>.</p></body></html>"
          },
