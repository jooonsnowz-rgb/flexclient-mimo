            "id": 148950,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Come rappresenta l'albero della scena uno <code>sprite</code> e una <code>label</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Come nodi</item><item value=\"2\" correct=\"false\">Come testo</item></selection><p visible-if=\"wrong\">Come nodi.</p></body></html>"
          },
          {
