e=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" courses \" /><text type=\"break\" /><text value=\"RIGHT\" class=\"keyword\" /><text value=\" \" /><text value=\"JOIN\" class=\"keyword\" /><text value=\" students \" /><text type=\"break\" /><text value=\"ON\" class=\"keyword\" /><text value=\" students.course_id = courses.course_id;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"44\" endIndex=\"46\" /></interactions><output><table name=\"Result\"><row><header content=\"course_name\" /><header content=\"course_id\" /><header content=\"duration_in_years\" /><header content=\"name\" /><header content=\"student_id\" /><header content=\"course_id\" /></row><row><data content=\"Anthropology\" /><data content=\"102\" /><data content=\"3\" /><data content=\"Reagan\" /><data content=\"98\" /><data content=\"102\" /></row><row><data content=\"Liberal Arts\" /><data content=\"112\" /><data content=\"4\" /><data content=\"Pat\" /><data content=\"234\" /><data content=\"112\" /></row><row><data content=\"\" /><data content=\"\" /><data content=\"\" /><data content=\"Ash\" /><data content=\"712\" /><data content=\"212\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>ON</code>.</p></body></html>"
