            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Scegli quella più adatta per indicare che un utente si è disiscritto da un servizio.</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>subscribed = False</code></item><item value=\"2\" correct=\"false\"><code>subscribed = True</code></item></selection><p visible-if=\"wrong\"><code>subscribed = False</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Un utente non è più iscritto. Quale riga memorizza questo stato?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>subscribed = False</code></item><item value=\"2\" correct=\"false\"><code>subscribed = True</code></item><item value=\"3\" correct=\"false\"><code>subscribed = \"False\"</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>subscribed = False</code>.</p></body></html>"
