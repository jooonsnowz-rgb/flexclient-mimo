            "interactiveContent": "<!DOCTYPE html ><html><body><p>Che cosa visualizza questo codice nella console?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"is_close = \" /><text value=\"True\" class=\"literal\" /><text type=\"break\" /><text value=\"is_far = \" /><text value=\"not\" class=\"keyword\" /><text value=\" is_close\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(is_far)\" /></content><output><content><text value=\"False\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>False</code></item><item value=\"2\" correct=\"false\"><code>True</code></item><item value=\"3\" correct=\"false\"><code>\"True\"</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>False</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>is_close</code> inizia come <code>True</code> e <code>is_far</code> memorizza <code>not is_close</code>. Che cosa viene stampato?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"is_close = \" /><text value=\"True\" class=\"literal\" /><text type=\"break\" /><text value=\"is_far = \" /><text value=\"not\" class=\"keyword\" /><text value=\" is_close\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(is_far)\" /></content><output><content><text value=\"False\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>False</code></item><item value=\"2\" correct=\"false\"><code>True</code></item><item value=\"3\" correct=\"false\"><code>\"False\"</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>False</code>.</p></body></html>"
