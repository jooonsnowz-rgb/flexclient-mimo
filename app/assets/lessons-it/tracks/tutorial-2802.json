            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Che cos'è un tipo unione in TypeScript?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Un tipo che può essere uno di diversi tipi</item><item value=\"2\" correct=\"false\">Un tipo che combina più variabili in una sola</item><item value=\"3\" correct=\"false\">Un tipo che esclude determinate proprietà</item><item value=\"4\" correct=\"false\">Un tipo che rinomina le proprietà</item></selection><p visible-if=\"wrong\">Un tipo che può essere uno di diversi tipi.</p></body></html>"
