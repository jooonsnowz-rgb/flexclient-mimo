            "interactiveContent": "<!DOCTYPE html ><html><body><p>Come rimuoviamo un elemento da un set?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Con l'istruzione <code>remove()</code></item><item value=\"2\" correct=\"false\">Non possiamo rimuovere elementi dagli insiemi</item></selection><p visible-if=\"wrong\">Con l'istruzione <code>remove()</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Rimuoviamo un elemento da un set con l'istruzione <code>remove()</code>.</p><p>Quale riga rimuove <code>\"red\"</code> da <code>colors</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>colors.remove(\"red\")</code></item><item value=\"2\" correct=\"false\"><code>colors.add(\"red\")</code></item><item value=\"3\" correct=\"false\"><code>colors - \"red\"</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>colors.remove(\"red\")</code>.</p></body></html>",
