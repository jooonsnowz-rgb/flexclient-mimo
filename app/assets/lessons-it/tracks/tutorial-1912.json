              "solutionDatabaseTables": "{\"Tables\":[{\"Name\":\"Result\",\"Rows\":[{\"Cells\":[{\"CellType\":\"Header\",\"Content\":\"MIN(price)\"},{\"CellType\":\"Header\",\"Content\":\"MAX(price)\"}]},{\"Cells\":[{\"CellType\":\"Data\",\"Content\":\"4.0\"},{\"CellType\":\"Data\",\"Content\":\"6.0\"}]}]}]}"
