            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Qual è la parola chiave che dobbiamo specificare in una classe per indicare al codice che ci stiamo riferendo all'oggetto che stiamo creando?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>this</code></item><item value=\"2\" correct=\"false\"><code>new</code></item><item value=\"3\" correct=\"false\"><code>class</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>this</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>All'interno di un costruttore, quale parola chiave si riferisce all'oggetto in fase di creazione?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>this</code></item><item value=\"2\" correct=\"false\"><code>new</code></item><item value=\"3\" correct=\"false\"><code>class</code></item><item value=\"4\" correct=\"false\"><code>object</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>this</code>.</p></body></html>"
