            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quale segno trasforma <code>true</code> in <code>false</code>?</p><selection multiple=\"multiple\" iscode=\"false\"><item correct=\"true\" value=\"1\"><code>!</code></item><item correct=\"false\" value=\"2\"><code>-</code></item><item correct=\"false\" value=\"2\"><code>?</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>!</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Quale espressione restituisce <code>false</code> invertendo <code>true</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>!true</code></item><item value=\"2\" correct=\"false\"><code>-true</code></item><item value=\"3\" correct=\"false\"><code>?true</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>!true</code>.</p></body></html>"
