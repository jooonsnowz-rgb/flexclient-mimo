            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quale valore non è una stringa?</p><selection multiple=\"multiple\" iscode=\"false\"><item correct=\"true\" value=\"1\"><code>true</code></item><item correct=\"false\" value=\"2\"><code>\"true\"</code></item><item correct=\"false\" value=\"2\"><code>\"wrong\"</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>true</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>L'app è pronta. Quale valore speciale devi memorizzare in <code>isReady</code> per indicarlo?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>true</code></item><item value=\"2\" correct=\"false\"><code>\"true\"</code></item><item value=\"3\" correct=\"false\"><code>false</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>true</code>.</p></body></html>",
