            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quale confronto restituisce <code>False</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>5 &lt; 5</code></item><item value=\"2\" correct=\"false\"><code>5 &lt;= 5</code></item><item value=\"3\" correct=\"false\"><code>5 == 5</code></item></selection><p visible-if=\"wrong\"><code>5 &lt; 5</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Un punteggio è esattamente <code>5</code>. Quale confronto indica correttamente che il punteggio non è maggiore di <code>5</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>5 &lt;= 5</code></item><item value=\"2\" correct=\"false\"><code>5 &lt; 5</code></item><item value=\"3\" correct=\"false\"><code>5 != 5</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>5 &lt;= 5</code>.</p></body></html>"
