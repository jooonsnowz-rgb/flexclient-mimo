            "interactiveContent": "<!DOCTYPE html ><html><body><p>Confronta <code>copy</code> con <code>submission</code> usando l'operatore di disuguaglianza.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"copy = \" /><text value=\"&quot;results.xls&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"submission  = \" /><text value=\"&quot;sales.xls&quot;\" class=\"string\" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"print(copy != submission)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"60\" endIndex=\"61\" /><option startIndex=\"61\" endIndex=\"62\" /><option correct=\"false\"><content><text value=\"&lt;\" /></content></option><option correct=\"false\"><content><text value=\"=\" /></content></option></options></interaction></interactions><output><content><text value=\"True\" /></content></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>!</code>, seguito da <code>=</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Confronta <code>copy</code> con <code>submission</code> in modo che il codice mostri <code>True</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"copy = \" /><text value=\"&quot;results.xls&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"submission  = \" /><text value=\"&quot;sales.xls&quot;\" class=\"string\" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"print(copy != submission)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"60\" endIndex=\"62\" /><option startIndex=\"63\" endIndex=\"73\" /><option correct=\"false\"><content><text value=\"==\" /></content></option><option correct=\"false\"><content><text value=\"=\" /></content></option><option correct=\"false\"><content><text value=\"copy\" /></content></option></options></interaction></interactions><output><content><text value=\"True\" /></content></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>!=</code>, seguito da <code>submission</code>.</p></body></html>",
