            "hardModeContent": "<!DOCTYPE html ><html><body><p>Quale condizione verifica se <code>attempts</code> ha il valore <code>3</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>attempts == 3</code></item><item value=\"2\" correct=\"false\"><code>attempts = 3</code></item><item value=\"3\" correct=\"false\"><code>attempts != 3</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>attempts == 3</code>.</p></body></html>"
