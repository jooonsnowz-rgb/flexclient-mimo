          {
            "title": "Example: All in one",
            "id": 74835,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Assembla il ciclo for per stampare nella console i numeri da <code>1</code> a <code>4</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"1\" class=\"number\" /><text value=\"; i &lt; \" /><text value=\"5\" class=\"number\" /><text value=\"; i++) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(i);\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"16\" endIndex=\"21\" /><option startIndex=\"31\" endIndex=\"45\" /><option correct=\"false\"><content><text value=\"i &gt; 5\" /></content></option><option correct=\"false\"><content><text value=\"i &lt; 4\" /></content></option></options></interaction></interactions><output><content><text value=\"1\" /><text type=\"break\" /><text value=\"2\" /><text type=\"break\" /><text value=\"3\" /><text type=\"break\" /><text value=\"4\" /></content></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>i &lt; 5</code>, seguito da <code>console.log(i)</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Completa il ciclo per visualizzare da <code>1</code> a <code>4</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"1\" class=\"number\" /><text value=\"; i &lt; \" /><text value=\"5\" class=\"number\" /><text value=\"; i++) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(i);\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"13\" endIndex=\"14\" /><option startIndex=\"20\" endIndex=\"21\" /><option startIndex=\"23\" endIndex=\"26\" /><option startIndex=\"31\" endIndex=\"45\" /><option correct=\"false\"><content><text value=\"0\" /></content></option><option correct=\"false\"><content><text value=\"4\" /></content></option><option correct=\"false\"><content><text value=\"i--\" /></content></option><option correct=\"false\"><content><text value=\"console.log(1)\" /></content></option></options></interaction></interactions><output><content><text value=\"1\" /><text type=\"break\" /><text value=\"2\" /><text type=\"break\" /><text value=\"3\" /><text type=\"break\" /><text value=\"4\" /></content></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>1</code>, seguito da <code>5</code>, <code>i++</code> e infine <code>console.log(i)</code>.</p></body></html>",
            "hardModeSelected": true
