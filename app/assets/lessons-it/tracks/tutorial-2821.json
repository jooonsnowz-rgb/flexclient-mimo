            "interactiveContent": "<!DOCTYPE html ><html><body><p>Perché il link non funziona?</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Example link\" /><text value=\"&lt;/\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text value=\" \" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"a\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Click here\" /><text value=\"&lt;/\" /><text value=\"a\" class=\"name\" /><text value=\"&gt;\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Perché non ha l'attributo <code>href</code></item><item value=\"2\" correct=\"false\">Perché non contiene testo tra <code>&lt;a&gt;</code> e <code>&lt;/a&gt;</code></item></selection><p visible-if=\"wrong\">Perché non ha l'attributo <code>href</code>.</p></body></html>"
