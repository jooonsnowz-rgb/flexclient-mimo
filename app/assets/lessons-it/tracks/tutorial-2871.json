            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Assicurati che <code>\"Loop finished!\"</code> venga stampato quando il ciclo è terminato.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"count = \" /><text value=\"0\" class=\"number\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" count &lt; \" /><text value=\"5\" class=\"number\" /><text value=\":\" /><text type=\"break\" /><text value=\"  print(count)\" /><text type=\"break\" /><text value=\"  count = count + \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text value=\"else\" class=\"keyword\" /><text value=\":\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"&quot;Loop finished!&quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"62\" endIndex=\"66\" /><option correct=\"false\"><content><text value=\"continue\" /></content></option><option correct=\"false\"><content><text value=\"break\" /></content></option></options></interaction></interactions><output><content><text value=\"0\" /><text type=\"break\" /><text value=\"1\" /><text type=\"break\" /><text value=\"2\" /><text type=\"break\" /><text value=\"3\" /><text type=\"break\" /><text value=\"4\" /><text type=\"break\" /><text value=\"Loop finished!\" /></content></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>else</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Completa il ciclo in modo che stampi da <code>0</code> a <code>4</code>, seguito da <code>Loop finished!</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"count = \" /><text value=\"0\" class=\"number\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" count &lt; \" /><text value=\"5\" class=\"number\" /><text value=\":\" /><text type=\"break\" /><text value=\"  print(count)\" /><text type=\"break\" /><text value=\"  count = count + \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text value=\"else\" class=\"keyword\" /><text value=\":\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"&quot;Loop finished!&quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"24\" endIndex=\"25\" /><option startIndex=\"62\" endIndex=\"66\" /><option correct=\"false\"><content><text value=\"4\" /></content></option><option correct=\"false\"><content><text value=\"break\" /></content></option><option correct=\"false\"><content><text value=\"continue\" /></content></option></options></interaction></interactions><output><content><text value=\"0\" /><text type=\"break\" /><text value=\"1\" /><text type=\"break\" /><text value=\"2\" /><text type=\"break\" /><text value=\"3\" /><text type=\"break\" /><text value=\"4\" /><text type=\"break\" /><text value=\"Loop finished!\" /></content></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>5</code>, seguito da <code>else</code>.</p></body></html>",
            "hardModeSelected": true
