            "id": 127137,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Crea la variabile <code>result</code> e memorizza al suo interno il valore restituito dalla funzione.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"func\" class=\"keyword\" /><text value=\" \" /><text value=\"signUp\" class=\"title\" /><text value=\"(user: String)\" class=\"params\" /><text value=\" -&gt; \" /><text value=\"String\" class=\"type\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"let\" class=\"keyword\" /><text value=\" status = user + \" /><text value=\"&quot; Signed up&quot;\" class=\"string\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" status\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"let\" class=\"keyword\" /><text value=\" result = signUp(user: \" /><text value=\"&quot;Desmond&quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"90\" endIndex=\"93\" /><option startIndex=\"94\" endIndex=\"100\" /><option startIndex=\"116\" endIndex=\"125\" /></options></interaction></interactions></code><p visible-if=\"wrong\">Assicurati di scegliere <code>let</code>, seguito da <code>result</code> e infine <code>\"Desmond\"</code>.</p></body></html>"
          }
