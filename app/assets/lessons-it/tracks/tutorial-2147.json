            "id": 120840,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Abbiamo imparato a selezionare dati specifici da una tabella. In alcuni casi, potremmo dover aggiungere dati a una tabella.</p><p>Ad esempio, supponi di ricevere un nuovo ordine per il tuo negozio di articoli da regalo.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE orders( &#xA; name varchar(255), &#xA; id int, &#xA; price int &#xA;); &#xA; &#xA;INSERT INTO orders(name, id, price) &#xA;VALUES(&quot;Chocolate box&quot;, 1235, 14); &#xA; &#xA;INSERT INTO orders(name, id, price) &#xA;VALUES(&quot;Bath bombs&quot;, 2337, 9); &#xA; &#xA;INSERT INTO orders(name, id, price) &#xA;VALUES(&quot;Flower hamper&quot;, 7483, 21);\"><tables><table name=\"orders\"><row><header content=\"name\" /><header content=\"id\" /><header content=\"price\" /></row><row><data content=\"Chocolate box\" /><data content=\"1235\" /><data content=\"14\" /></row><row><data content=\"Bath bombs\" /><data content=\"2337\" /><data content=\"9\" /></row><row><data content=\"Flower hamper\" /><data content=\"7483\" /><data content=\"21\" /></row></table></tables></database></body></html>"
          },
