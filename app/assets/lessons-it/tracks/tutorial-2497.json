            "interactiveContent": "<!DOCTYPE html ><html><body><p>Qual è il valore di questa costante?</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" name = \" /><text value=\"&quot;Karin&quot;\" class=\"string\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>\"Karin\"</code></item><item value=\"2\" correct=\"false\"><code>name</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>\"Karin\"</code>.</p></body></html>"
