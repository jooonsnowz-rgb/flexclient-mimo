          {
            "title": "Doesn't satisfy a condition",
            "id": 91448,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>A volte vogliamo selezionare dati che <em>non</em> soddisfano una condizione, come tutti gli studenti che <em>non</em> sono al primo anno.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA;name varchar(255),&#xA;year int,&#xA;major varchar(255)&#xA;);&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Ava Smith', 1, 'Biology');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Luis Garcia', 1, 'Physics');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Lin Wong', 3, 'Biology');\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" &lt;&gt; \" /><text value=\"1\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"29\" endIndex=\"38\" /><option startIndex=\"23\" endIndex=\"28\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>WHERE</code>, seguito da <code>year &lt;&gt; 1</code>.</p></body></html>"
          },
          {
            "title": "All years",
            "id": 91450,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Come prima, iniziamo selezionando tutti gli elementi con <code>*</code>. In questo modo otterremo studenti di tutti gli anni.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA;name varchar(255),&#xA;year int,&#xA;major varchar(255)&#xA;);&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Ava Smith', 1, 'Biology');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Luis Garcia', 1, 'Physics');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Lin Wong', 3, 'Biology');\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"7\" endIndex=\"8\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>*</code>.</p></body></html>"
          },
          {
            "title": "The inequality operator",
            "id": 91451,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Per verificare se il valore di una colonna <em>non</em> è uguale a un altro, usiamo l'operatore di disuguaglianza <code>&lt;&gt;</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA;name varchar(255),&#xA;year int,&#xA;major varchar(255)&#xA;);&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Ava Smith', 1, 'Biology');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Luis Garcia', 1, 'Physics');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Lin Wong', 3, 'Biology');\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" &lt;&gt; \" /><text value=\"1\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"34\" endIndex=\"35\" /><option startIndex=\"35\" endIndex=\"36\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>&lt;</code>, seguito da <code>&gt;</code>.</p></body></html>"
          },
          {
            "title": "The inequality operator 2",
            "id": 91452,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Poiché <code>year &lt;&gt; 1</code> esclude gli elementi degli studenti con <code>1</code> nella colonna <code>year</code>, otteniamo solo una studentessa al terzo anno.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA;name varchar(255),&#xA;year int,&#xA;major varchar(255)&#xA;);&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Ava Smith', 1, 'Biology');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Luis Garcia', 1, 'Physics');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Lin Wong', 3, 'Biology');\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" &lt;&gt; \" /><text value=\"1\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"29\" endIndex=\"38\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>year &lt;&gt; 1</code>.</p></body></html>"
          },
          {
            "title": "Inequality with text values",
            "id": 91453,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Possiamo anche usare l'operatore di disuguaglianza con valori testuali, ad esempio per ottenere tutti gli studenti che non frequentano il corso di laurea in <code>'Biology'</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA;name varchar(255),&#xA;year int,&#xA;major varchar(255)&#xA;);&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Ava Smith', 1, 'Biology');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Luis Garcia', 1, 'Physics');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Lin Wong', 3, 'Biology');\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" major &lt;&gt; \" /><text value=\"'Biology'\" class=\"string\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"38\" endIndex=\"47\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>'Biology'</code>.</p></body></html>"
          },
          {
            "title": "Question: Doesn't satisfy a condition",
            "id": 91744,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quando è utile il simbolo di disuguaglianza?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Quando vogliamo ottenere tutti gli elementi che non soddisfano un criterio</item><item value=\"2\" correct=\"false\">Quando vogliamo ottenere tutti gli elementi che soddisfano un criterio</item></selection><p visible-if=\"wrong\">Quando vogliamo ottenere tutti gli elementi che non soddisfano un criterio.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Un elenco di aziende deve escludere tutte quelle con esattamente tre anni di attività. Quale confronto va inserito nel filtro?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Usare la disuguaglianza per mantenere i valori diversi da 3.</item><item value=\"2\" correct=\"false\">Usare l'uguaglianza per mantenere solo i valori uguali a 3.</item><item value=\"3\" correct=\"false\">Usare la disuguaglianza per mantenere i valori maggiori di 3.</item></selection><p visible-if=\"wrong\">Usare la disuguaglianza per mantenere i valori diversi da 3.</p></body></html>"
          },
          {
            "title": "Question: All years",
            "id": 91745,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Che cosa c'è che non va in questa query?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"FROM companies\" /><text type=\"break\" /><text value=\"WHERE years_active &lt;&gt; 3;\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Prima dovrebbe selezionare gli elementi prima di filtrarli</item><item value=\"2\" correct=\"false\">Non c'è nulla di sbagliato nella query</item></selection><p visible-if=\"wrong\">Prima dovrebbe selezionare gli elementi prima di filtrarli.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>La query filtra le aziende i cui anni di attività non sono 3. Cosa deve precedere <code>FROM</code> affinché la query sia completa?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"FROM companies\" /><text type=\"break\" /><text value=\"WHERE years_active &lt;&gt; 3;\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Una clausola SELECT che sceglie cosa restituire.</item><item value=\"2\" correct=\"false\">Una clausola ORDER BY che ordina le righe.</item><item value=\"3\" correct=\"false\">Una clausola VALUES che crea nuove righe.</item></selection><p visible-if=\"wrong\">Una clausola SELECT che sceglie cosa restituire.</p></body></html>"
          },
          {
            "title": "Question: The inequality operator",
            "id": 91746,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quale operatore usiamo per verificare se due valori <em>non</em> sono uguali?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>&lt;&gt;</code></item><item value=\"2\" correct=\"false\"><code>=</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>&lt;&gt;</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>L'operatore di disuguaglianza verifica se due valori non sono uguali.</p><p>Ti servono le righe il cui valore <code>years_active</code> è qualsiasi valore tranne <code>3</code>. Quale operatore esprime questa condizione?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>&lt;&gt;</code></item><item value=\"2\" correct=\"false\"><code>=</code></item><item value=\"3\" correct=\"false\"><code>&gt;</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>&lt;&gt;</code>.</p></body></html>"
          },
          {
            "title": "Question: The inequality operator 2",
            "id": 91747,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quale elemento mancherà dalla tabella dei risultati?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE companies (&#xA;name varchar(255),&#xA;years_active int&#xA;);&#xA;&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Rocket Delivery', 3);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Teachya', 1);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Hyped', 8);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Thread Co.', 1);\"><tables><table name=\"companies\"><row><header content=\"name\" /><header content=\"years_active\" /></row><row><data content=\"Rocket Delivery\" /><data content=\"3\" /></row><row><data content=\"Teachya\" /><data content=\"1\" /></row><row><data content=\"Hyped\" /><data content=\"8\" /></row><row><data content=\"Thread Co.\" /><data content=\"1\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" companies\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" years_active &lt;&gt; \" /><text value=\"8\" class=\"number\" /><text value=\";\" /></content><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"years_active\" /></row><row><data content=\"Rocket Delivery\" /><data content=\"3\" /></row><row><data content=\"Teachya\" /><data content=\"1\" /></row><row><data content=\"Thread Co.\" /><data content=\"1\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>Hyped</code>, <code>8</code></item><item value=\"2\" correct=\"false\"><code>Rocket Delivery</code>, <code>3</code></item></selection><p visible-if=\"wrong\"><code>Hyped</code>, <code>8</code>.</p></body></html>"
          },
          {
            "title": "Question: Inequality with text values",
            "id": 91748,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Con quali tipi di valori possiamo usare l'operatore di disuguaglianza <code>&lt;&gt;</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Di qualsiasi tipo, come testo e numeri</item><item value=\"2\" correct=\"false\">Solo numeri</item></selection><p visible-if=\"wrong\">Di qualsiasi tipo, come testo e numeri.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>L'operatore di disuguaglianza <code>&lt;&gt;</code> funziona con valori come testo e numeri.</p><p>Quale filtro può usare correttamente <code>&lt;&gt;</code> per escludere un valore esatto?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Escludere il valore testuale <code>'closed'</code> da una colonna status.</item><item value=\"2\" correct=\"false\">Trasformare una colonna numerica in testo.</item><item value=\"3\" correct=\"false\">Sommare due valori numerici.</item></selection><p visible-if=\"wrong\">Escludere il valore testuale <code>'closed'</code> da una colonna status.</p></body></html>"
          },
          {
            "title": "Example: Doesn't satisfy a condition",
            "id": 91749,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Scrivi una condizione per selezionare tutti gli elementi <code>companies</code> con <code>years_active</code> diverso da <code>3</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE companies (&#xA;name varchar(255),&#xA;years_active int&#xA;);&#xA;&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Rocket Delivery', 3);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Teachya', 1);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Hyped', 8);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Thread Co.', 1);\"><tables><table name=\"companies\"><row><header content=\"name\" /><header content=\"years_active\" /></row><row><data content=\"Rocket Delivery\" /><data content=\"3\" /></row><row><data content=\"Teachya\" /><data content=\"1\" /></row><row><data content=\"Hyped\" /><data content=\"8\" /></row><row><data content=\"Thread Co.\" /><data content=\"1\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" companies\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" years_active &lt;&gt; \" /><text value=\"3\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"24\" endIndex=\"29\" /><option correct=\"false\"><content><text value=\"years_active = 3\" /></content></option><option startIndex=\"30\" endIndex=\"47\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"years_active\" /></row><row><data content=\"Teachya\" /><data content=\"1\" /></row><row><data content=\"Hyped\" /><data content=\"8\" /></row><row><data content=\"Thread Co.\" /><data content=\"1\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>WHERE</code>, seguito da <code>years_active &lt;&gt; 3</code>.</p></body></html>"
          },
          {
            "title": "Example: The inequality operator",
            "id": 91751,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Seleziona tutti gli elementi dalla tabella <code>companies</code>, prima di filtrarli.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE companies (&#xA;name varchar(255),&#xA;years_active int&#xA;);&#xA;&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Rocket Delivery', 3);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Teachya', 1);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Hyped', 8);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Thread Co.', 1);\"><tables><table name=\"companies\"><row><header content=\"name\" /><header content=\"years_active\" /></row><row><data content=\"Rocket Delivery\" /><data content=\"3\" /></row><row><data content=\"Teachya\" /><data content=\"1\" /></row><row><data content=\"Hyped\" /><data content=\"8\" /></row><row><data content=\"Thread Co.\" /><data content=\"1\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" companies;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"8\" /><option startIndex=\"9\" endIndex=\"13\" /><option startIndex=\"14\" endIndex=\"23\" /><option correct=\"false\"><content><text value=\"name\" /></content></option><option startIndex=\"23\" endIndex=\"24\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"years_active\" /></row><row><data content=\"Rocket Delivery\" /><data content=\"3\" /></row><row><data content=\"Teachya\" /><data content=\"1\" /></row><row><data content=\"Hyped\" /><data content=\"8\" /></row><row><data content=\"Thread Co.\" /><data content=\"1\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>SELECT</code>, seguito da <code>*</code> e poi <code>FROM</code>, <code>companies</code>, <code>;</code>.</p></body></html>"
          },
          {
            "title": "Example: The inequality operator 2",
            "id": 91752,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Scrivi <code>years_active</code>, l'operatore di disuguaglianza <code>&lt;&gt;</code> e <code>1</code> per filtrare le aziende che non sono state attive per un anno.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE companies (&#xA;name varchar(255),&#xA;years_active int&#xA;);&#xA;&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Rocket Delivery', 3);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Teachya', 1);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Hyped', 8);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Thread Co.', 1);\"><tables><table name=\"companies\"><row><header content=\"name\" /><header content=\"years_active\" /></row><row><data content=\"Rocket Delivery\" /><data content=\"3\" /></row><row><data content=\"Teachya\" /><data content=\"1\" /></row><row><data content=\"Hyped\" /><data content=\"8\" /></row><row><data content=\"Thread Co.\" /><data content=\"1\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" companies\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" years_active &lt;&gt; \" /><text value=\"1\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"30\" endIndex=\"47\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"years_active\" /></row><row><data content=\"Rocket Delivery\" /><data content=\"3\" /></row><row><data content=\"Hyped\" /><data content=\"8\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>years_active &lt;&gt; 1</code>.</p></body></html>"
          },
          {
            "title": "Example: Inequality with text values",
            "id": 91753,
            "contentType": "interactive",
