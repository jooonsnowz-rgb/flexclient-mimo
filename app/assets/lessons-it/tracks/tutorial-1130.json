            "id": 77642,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Le classi CSS multiple ci permettono di creare combinazioni di stili diversi nel nostro HTML. Aggiungi anche la classe <code>bold</code> al terzo paragrafo.</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;!doctype html&gt;\" class=\"meta\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;\" /><text value=\"head\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"link\" class=\"name\" /><text value=\" \" /><text value=\"rel\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;stylesheet&quot;\" class=\"string\" /><text value=\" \" /><text value=\"href\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;style.css&quot;\" class=\"string\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;/\" /><text value=\"head\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\" \" /><text value=\"class\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;bold&quot;\" class=\"string\" /><text value=\"&gt;\" /><text value=\"Font Styles\" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\" \" /><text value=\"class\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;color italic bold&quot;\" class=\"string\" /><text value=\"&gt;\" /><text value=\"Color, italic, and bold\" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\" \" /><text value=\"class\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;color bold&quot;\" class=\"string\" /><text value=\"&gt;\" /><text value=\"Color\" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\" \" /><text value=\"class\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;italic&quot;\" class=\"string\" /><text value=\"&gt;\" /><text value=\"Italic\" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;/\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;/\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"202\" endIndex=\"206\" /></interactions></code><code version=\"2\" codelang=\"css\" name=\"style.css\" visible-if=\"always\"><content><text value=\".color\" class=\"selector-class\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"color\" class=\"attribute\" /><text value=\": brown;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\".italic\" class=\"selector-class\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"font-style\" class=\"attribute\" /><text value=\": italic;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\".bold\" class=\"selector-class\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"font-weight\" class=\"attribute\" /><text value=\": bold;\" /><text type=\"break\" /><text value=\"}\" /