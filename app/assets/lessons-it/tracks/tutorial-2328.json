            "interactiveContent": "<!DOCTYPE html ><html><body><p>Cosa viene visualizzato nella console?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"match_scores = [\" /><text value=\"1\" class=\"number\" /><text value=\", \" /><text value=\"0\" class=\"number\" /><text value=\", \" /><text value=\"3\" class=\"number\" /><text value=\", \" /><text value=\"1\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text value=\"print(max(match_scores))\" /></content><output><content><text value=\"3\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>3</code></item><item value=\"2\" correct=\"false\"><code>0</code></item><item value=\"3\" correct=\"false\"><code>max(match_scores)</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>3</code>.</p></body></html>",
