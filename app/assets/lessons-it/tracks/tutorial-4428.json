    "title": "Condizionali annidati",
    "descriptionContent": "Impara a nidificare altri blocchi di codice, come le istruzioni condizionali, all'interno delle funzioni.",
    "shortDescriptionContent": "",
    "showInTrack": true,
    "iconBanner": null,
