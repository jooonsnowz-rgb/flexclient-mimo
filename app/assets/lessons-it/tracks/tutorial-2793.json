            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quali tipi possiamo usare per creare un array misto in TypeScript?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Tutti i tipi</item><item value=\"2\" correct=\"false\">Al massimo due diversi</item></selection><p visible-if=\"wrong\">Tutti i tipi.</p></body></html>"
