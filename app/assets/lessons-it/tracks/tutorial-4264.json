            "id": 145321,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Verifica se <code>5</code> è maggiore di <code>4</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"===\" /></content></option><option startIndex=\"12\" endIndex=\"13\" /><option startIndex=\"14\" endIndex=\"15\" /><option startIndex=\"16\" endIndex=\"17\" /></options></interaction></interactions><content><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"5\" class=\"number\" /><text value=\" &gt; \" /><text value=\"4\" class=\"number\" /><text value=\");\" /></content></code><p visible-if=\"wrong\">Assicurati di scegliere <code>5</code>, seguito da <code>&gt;</code> e infine <code>4</code>.</p></body></html>"
          },
          {
