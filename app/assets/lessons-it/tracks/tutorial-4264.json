            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quale operatore verifica se un valore è minore o uguale a un altro valore?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\"><code>&lt;=</code></item><item correct=\"false\" value=\"2\"><code>&gt;=</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>&lt;=</code>.</p></body></html>"
