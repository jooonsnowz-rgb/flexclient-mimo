            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Puoi rendere generica una funzione in TypeScript?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Sì, sia gli argomenti sia il tipo restituito possono essere generici</item><item value=\"2\" correct=\"false\">Solo gli argomenti delle funzioni possono essere generici</item><item value=\"3\" correct=\"false\">Solo il tipo restituito dalla funzione può essere generico</item></selection><p visible-if=\"wrong\">Sì, sia gli argomenti sia il tipo restituito possono essere generici.</p></body></html>"
