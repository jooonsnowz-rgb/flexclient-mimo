          {
            "title": "Example: Square brackets",
            "id": 79845,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Assegna alla variabile <code>siblings</code> una lista contenente <code>\"Luz\"</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"siblings = [\" /><text value=\"&quot;Luz&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text value=\"print(siblings)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"11\" endIndex=\"12\" /><option startIndex=\"12\" endIndex=\"17\" /><option startIndex=\"17\" endIndex=\"18\" /></options></interaction></interactions><output><content><text value=\"['Luz']\" /></content></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>[</code>, seguito da <code>\"Luz\"</code> e infine <code>]</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Assegna alla variabile <code>siblings</code> una lista contenente <code>\"Luz\"</code>, in modo che il codice stampi <code>['Luz']</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"siblings = [\" /><text value=\"&quot;Luz&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text value=\"print(siblings)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"11\" endIndex=\"12\" /><option startIndex=\"12\" endIndex=\"17\" /><option startIndex=\"17\" endIndex=\"18\" /><option correct=\"false\"><content><text value=\"{\" /></content></option><option correct=\"false\"><content><text value=\"}\" /></content></option><option correct=\"false\"><content><text value=\"Luz\" /></content></option></options></interaction></interactions><output><content><text value=\"['Luz']\" /></content></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>[</code>, seguito da <code>\"Luz\"</code> e infine <code>]</code>.</p></body></html>"
