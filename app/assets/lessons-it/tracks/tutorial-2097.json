        "title": "AGGIORNA",
        "type": "practiceLevel1",
        "lessons": [
          {
            "title": "Intro",
            "id": 118687,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>A volte dobbiamo aggiornare le voci esistenti di una tabella, ad esempio quando un ospite deve spostare di 30 minuti la sua prenotazione per la cena.</p><p>Vediamo come possiamo farlo in SQLite!</p></body></html>"
          },
          {
            "title": "Intro II",
            "id": 118688,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Non vogliamo semplicemente fare <code>INSERT</code> di una nuova voce nella tabella, altrimenti avremo prenotazioni duplicate con lo stesso nome. Potrebbe diventare confusionario!</p><p>Eliminare e reinserire una voce non è elegante neanche questo. Invece, possiamo usare la sintassi <code>UPDATE</code> di SQL.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE `Reservations` (&#xA; `id` INTEGER NOT NULL,&#xA; `name` TEXT NOT NULL,&#xA; `phonenumber` TEXT NOT NULL,&#xA; `time` TEXT NOT NULL,&#xA; `partysize` INTEGER NOT NULL,&#xA; PRIMARY KEY (`id`)&#xA;);&#xA;&#xA;&#xA;INSERT INTO `Reservations` (`id`, `name`, `phonenumber`, `time`, `partysize`) VALUES ('1', 'Powers', '+16352637463', '18:00',4);&#xA;&#xA;INSERT INTO `Reservations` (`id`, `name`, `phonenumber`, `time`, `partysize`) VALUES ('2', 'Miranda', '+17487652839', '19:00',5);&#xA;&#xA;INSERT INTO `Reservations` (`id`, `name`, `phonenumber`, `time`, `partysize`) VALUES ('3', 'Smith', '+17648373572', '18:30',3);&#xA;\"><tables><table name=\"Reservations\"><row><header content=\"id\" /><header content=\"name\" /><header content=\"phonenumber\" /><header content=\"time\" /><header content=\"partysize\" /></row><row><data content=\"1\" /><data content=\"Powers\" /><data content=\"+16352637463\" /><data content=\"18:00\" /><data content=\"4\" /></row><row><data content=\"2\" /><data content=\"Miranda\" /><data content=\"+17487652839\" /><data content=\"19:00\" /><data content=\"5\" /></row><row><data content=\"3\" /><data content=\"Smith\" /><data content=\"+17648373572\" /><data content=\"18:30\" /><data content=\"3\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" Reservations \" /><text value=\"SET\" class=\"keyword\" /><text value=\" \" /><text value=\"time\" class=\"built_in\" /><text value=\" = \" /><text value=\"'19:00'\" class=\"string\" /><text value=\" \" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" = \" /><text value=\"'Smith'\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" Reservations;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"id\" /><header content=\"name\" /><header content=\"phonenumber\" /><header content=\"time\" /><header content=\"partysize\" /></row><row><data content=\"1\" /><data content=\"Powers\" /><data content=\"+16352637463\" /><data content=\"18:00\" /><data content=\"4\" /></row><row><data content=\"2\" /><data content=\"Miranda\" /><data content=\"+17487652839\" /><data content=\"19:00\" /><data content=\"5\" /></row><row><data content=\"3\" /><data content=\"Smith\" /><data content=\"+17648373572\" /><data content=\"19:00\" /><data content=\"3\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>UPDATE</code>.</p></body></html>"
          },
          {
            "title": "Limitations",
            "id": 118690,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>UPDATE</code> non può essere usato per inserire nuove voci in una tabella. Può essere usato solo per modificare voci esistenti.</p><p>Ad esempio, l'esecuzione dell'istruzione <code>UPDATE</code> qui sotto non modificherà alcun dato, poiché la tabella non contiene ancora una riga con un <code>id</code> pari a 4.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE `Reservations` (&#xA; `id` INTEGER NOT NULL,&#xA; `name` TEXT NOT NULL,&#xA; `phonenumber` TEXT NOT NULL,&#xA; `time` TEXT NOT NULL,&#xA; `partysize` INTEGER NOT NULL,&#xA; PRIMARY KEY (`id`)&#xA;);&#xA;&#xA;&#xA;INSERT INTO `Reservations` (`id`, `name`, `phonenumber`, `time`, `partysize`) VALUES ('1', 'Powers', '+16352637463', '18:00',4);&#xA;&#xA;INSERT INTO `Reservations` (`id`, `name`, `phonenumber`, `time`, `partysize`) VALUES ('2', 'Miranda', '+17487652839', '19:00',5);&#xA;&#xA;INSERT INTO `Reservations` (`id`, `name`, `phonenumber`, `time`, `partysize`) VALUES ('3', 'Smith', '+17648373572', '18:30',3);&#xA;\"><tables><table name=\"Reservations\"><row><header content=\"id\" /><header content=\"name\" /><header content=\"phonenumber\" /><header content=\"time\" /><header content=\"partysize\" /></row><row><data content=\"1\" /><data content=\"Powers\" /><data content=\"+16352637463\" /><data content=\"18:00\" /><data content=\"4\" /></row><row><data content=\"2\" /><data content=\"Miranda\" /><data content=\"+17487652839\" /><data content=\"19:00\" /><data content=\"5\" /></row><row><data content=\"3\" /><data content=\"Smith\" /><data content=\"+17648373572\" /><data content=\"18:30\" /><data content=\"3\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" Reservations \" /><text value=\"SET\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" = \" /><text value=\"'Kelly'\" class=\"string\" /><text value=\" \" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"id\" class=\"keyword\" /><text value=\" = \" /><text value=\"4\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" Reservations;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"39\" endIndex=\"44\" /><option startIndex=\"45\" endIndex=\"47\" /><option startIndex=\"48\" endIndex=\"49\" /><option startIndex=\"50\" endIndex=\"51\" /><option startIndex=\"51\" endIndex=\"52\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"id\" /><header content=\"name\" /><header content=\"phonenumber\" /><header content=\"time\" /><header content=\"partysize\" /></row><row><data content=\"1\" /><data content=\"Powers\" /><data content=\"+16352637463\" /><data content=\"18:00\" /><data content=\"4\" /></row><row><data content=\"2\" /><data content=\"Miranda\" /><data content=\"+17487652839\" /><data content=\"19:00\" /><data content=\"5\" /></row><row><data content=\"3\" /><data content=\"Smith\" /><data content=\"+17648373572\" /><data content=\"18:30\" /><data content=\"3\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>WHERE</code>, seguito da <code>id</code> e poi <code>=</code>, <code>4</code>, <code>;</code>.</p></body></html>"
          },
          {
            "title": "Syntax",
            "id": 118691,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Un'istruzione <code>UPDATE</code> inizia sempre con la parola chiave <code>UPDATE</code> seguita dal nome della tabella.</p><p>Poi, il nome della tabella è seguito dalla parola chiave <code>SET</code> e da un'espressione che imposta una colonna su un valore specificato. Vediamo che aspetto ha!</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE `Directory` (&#xA; `floor` INTEGER NOT NULL,&#xA; `company` TEXT NOT NULL,&#xA; PRIMARY KEY (`floor`)&#xA;);&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (1, 'Lobby');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (2, 'Perkins Legal');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (3, '(Vacant)');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (4, 'Bright Whites Dental');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (5, 'Whiz Kid IT Support');\"><tables><table name=\"Directory\"><row><header content=\"floor\" /><header content=\"company\" /></row><row><data content=\"1\" /><data content=\"Lobby\" /></row><row><data content=\"2\" /><data content=\"Perkins Legal\" /></row><row><data content=\"3\" /><data content=\"(Vacant)\" /></row><row><data content=\"4\" /><data content=\"Bright Whites Dental\" /></row><row><data content=\"5\" /><data content=\"Whiz Kid IT Support\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" \" /><text value=\"Directory\" class=\"keyword\" /><text value=\" \" /><text value=\"SET\" class=\"keyword\" /><text value=\" company = \" /><text value=\"'Smith Tax &amp; Audit'\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" \" /><text value=\"Directory\" class=\"keyword\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"floor\" /><header content=\"company\" /></row><row><data content=\"1\" /><data content=\"Smith Tax &amp; Audit\" /></row><row><data content=\"2\" /><data content=\"Smith Tax &amp; Audit\" /></row><row><data content=\"3\" /><data content=\"Smith Tax &amp; Audit\" /></row><row><data content=\"4\" /><data content=\"Smith Tax &amp; Audit\" /></row><row><data content=\"5\" /><data content=\"Smith Tax &amp; Audit\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>UPDATE</code>.</p></body></html>"
          },
          {
            "title": "One Row",
            "id": 118694,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Come probabilmente hai notato, <code>UPDATE</code> può essere usato per aggiornare il valore di una colonna per ogni riga, ma nella maggior parte dei casi vogliamo modificare una riga specifica.</p><p>Possiamo farlo includendo una clausola <code>WHERE</code> alla fine della nostra istruzione <code>UPDATE</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE `Directory` (&#xA; `floor` INTEGER NOT NULL,&#xA; `company` TEXT NOT NULL,&#xA; PRIMARY KEY (`floor`)&#xA;);&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (1, 'Lobby');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (2, 'Perkins Legal');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (3, '(Vacant)');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (4, 'Bright Whites Dental');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (5, 'Whiz Kid IT Support');\"><tables><table name=\"Directory\"><row><header content=\"floor\" /><header content=\"company\" /></row><row><data content=\"1\" /><data content=\"Lobby\" /></row><row><data content=\"2\" /><data content=\"Perkins Legal\" /></row><row><data content=\"3\" /><data content=\"(Vacant)\" /></row><row><data content=\"4\" /><data content=\"Bright Whites Dental\" /></row><row><data content=\"5\" /><data content=\"Whiz Kid IT Support\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" \" /><text value=\"Directory\" class=\"keyword\" /><text value=\" \" /><text type=\"break\" /><text value=\"SET\" class=\"keyword\" /><text value=\" company = \" /><text value=\"'Smith Tax &amp; Audit'\" class=\"string\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"floor\" class=\"keyword\" /><text value=\" = \" /><text value=\"3\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" \" /><text value=\"Directory\" class=\"keyword\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"52\" endIndex=\"57\" /><option startIndex=\"58\" endIndex=\"63\" /><option startIndex=\"64\" endIndex=\"65\" /><option startIndex=\"66\" endIndex=\"67\" /><option startIndex=\"67\" endIndex=\"68\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"floor\" /><header content=\"company\" /></row><row><data content=\"1\" /><data content=\"Lobby\" /></row><row><data content=\"2\" /><data content=\"Perkins Legal\" /></row><row><data content=\"3\" /><data content=\"Smith Tax &amp; Audit\" /></row><row><data content=\"4\" /><data content=\"Bright Whites Dental\" /></row><row><data content=\"5\" /><data content=\"Whiz Kid IT Support\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>WHERE</code>, seguito da <code>floor</code> e poi <code>=</code>, <code>3</code>, <code>;</code>.</p></body></html>"
          },
          {
            "title": "Multiple Rows",
            "id": 118695,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Aggiungere una condizione alla clausola <code>WHERE</code> della nostra istruzione <code>UPDATE</code> ci permette di aggiornare contemporaneamente più righe che soddisfano la nostra condizione.</p><p>Ad esempio, immagina di voler valorizzare la colonna <code>mealservice</code> con <code>True</code> per tutti i voli di almeno 6 ore.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE `Flights` (&#xA; `number` TEXT NOT NULL,&#xA; `type` TEXT NOT NULL,&#xA; `origin` TEXT NOT NULL,&#xA; `destination` TEXT NOT NULL,&#xA; `duration` REAL NOT NULL,&#xA; `mealservice` INTEGER,&#xA; PRIMARY KEY (`number`)&#xA;);&#xA;&#xA;INSERT INTO `Flights` (`number`, `type`, `origin`, `destination`, `duration`) VALUES ('PA84', 'International', 'Paris', 'London', 1.2);&#xA;&#xA;INSERT INTO `Flights` (`number`, `type`, `origin`, `destination`, `duration`) VALUES ('PA56', 'Domestic', 'New York', 'Los Angeles', 5.5);&#xA;&#xA;INSERT INTO `Flights` (`number`, `type`, `origin`, `destination`, `duration`) VALUES ('PA67', 'International', 'New York', 'London', 7);&#xA;&#xA;INSERT INTO `Flights` (`number`, `type`, `origin`, `destination`, `duration`) VALUES ('PA76', 'Domestic', 'Honolulu', 'Boston', 9.5);\"><tables><table name=\"Flights\"><row><header content=\"number\" /><header content=\"type\" /><header content=\"origin\" /><header content=\"destination\" /><header content=\"duration\" /><header content=\"mealservice\" /></row><row><data content=\"PA84\" /><data content=\"International\" /><data content=\"Paris\" /><data content=\"London\" /><data content=\"1.2\" /><data content=\"\" /></row><row><data content=\"PA56\" /><data content=\"Domestic\" /><data content=\"New York\" /><data content=\"Los Angeles\" /><data content=\"5.5\" /><data content=\"\" /></row><row><data content=\"PA67\" /><data content=\"International\" /><data content=\"New York\" /><data content=\"London\" /><data content=\"7.0\" /><data content=\"\" /></row><row><data content=\"PA76\" /><data content=\"Domestic\" /><data content=\"Honolulu\" /><data content=\"Boston\" /><data content=\"9.5\" /><data content=\"\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" Flights \" /><text type=\"break\" /><text value=\"SET\" class=\"keyword\" /><text value=\" mealservice = \" /><text value=\"True\" class=\"literal\" /><text value=\" \" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"duration\" class=\"keyword\" /><text value=\" &gt;= \" /><text value=\"6\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" Flights;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"40\" endIndex=\"45\" /><option startIndex=\"46\" endIndex=\"54\" /><option startIndex=\"55\" endIndex=\"57\" /><option startIndex=\"58\" endIndex=\"59\" /><option startIndex=\"59\" endIndex=\"60\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"number\" /><header content=\"type\" /><header content=\"origin\" /><header content=\"destination\" /><header content=\"duration\" /><header content=\"mealservice\" /></row><row><data content=\"PA84\" /><data content=\"International\" /><data content=\"Paris\" /><data content=\"London\" /><data content=\"1.2\" /><data content=\"\" /></row><row><data content=\"PA56\" /><data content=\"Domestic\" /><data content=\"New York\" /><data content=\"Los Angeles\" /><data content=\"5.5\" /><data content=\"\" /></row><row><data content=\"PA67\" /><data content=\"International\" /><data content=\"New York\" /><data content=\"London\" /><data content=\"7.0\" /><data content=\"1\" /></row><row><data content=\"PA76\" /><data content=\"Domestic\" /><data content=\"Honolulu\" /><data content=\"Boston\" /><data content=\"9.5\" /><data content=\"1\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>WHERE</code>, seguito da <code>duration</code> e poi <code>&gt;=</code>, <code>6</code>, <code>;</code>.</p></body></html>"
          },
          {
            "title": "Question: Intro II",
            "id": 118697,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Qual è la soluzione più elegante per modificare una voce esistente della tabella?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Utilizzare un'istruzione <code>UPDATE</code></item><item value=\"2\" correct=\"false\">Utilizzando un'istruzione <code>DELETE</code> seguita da un'istruzione <code>INSERT</code></item></selection><p visible-if=\"wrong\">Utilizzare un'istruzione <code>UPDATE</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Un utente cambia il proprio indirizzo email, ma la riga esistente nella tabella e gli altri valori devono rimanere. Quale soluzione è adatta?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Utilizzare un'istruzione <code>UPDATE</code></item><item value=\"2\" correct=\"false\">Utilizzando un'istruzione <code>DELETE</code> seguita da un'istruzione <code>INSERT</code></item><item value=\"3\" correct=\"false\">Usare un'istruzione <code>INSERT</code> con lo stesso ID utente</item></selection><p visible-if=\"wrong\">Utilizzare un'istruzione <code>UPDATE</code>.</p></body></html>"
          },
          {
            "title": "Question: Limitations",
            "id": 118698,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>È possibile usare <code>UPDATE</code> per inserire nuove voci in una tabella?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">No, <code>UPDATE</code> può essere usato solo per modificare voci esistenti</item><item value=\"2\" correct=\"false\">Sì, SQLite creerà automaticamente una nuova voce</item></selection><p visible-if=\"wrong\">No, <code>UPDATE</code> può essere usato solo per modificare voci esistenti.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Un <code>UPDATE</code> riguarda l'ID utente <code>42</code>, ma questo ID non è presente nella tabella. L'istruzione aggiunge l'utente <code>42</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">No, <code>UPDATE</code> può modificare solo una voce esistente corrispondente</item><item value=\"2\" correct=\"false\">Sì, SQLite crea l'utente <code>42</code> usando i valori modificati</item><item value=\"3\" correct=\"false\">Sì, ma solo se l'ID utente <code>42</code> è il prossimo ID disponibile</item></selection><p visible-if=\"wrong\">No, <code>UPDATE</code> può modificare solo una voce esistente corrispondente.</p></body></html>"
          },
          {
            "title": "Question: Syntax",
            "id": 118699,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Con quali parole chiave inizia la sintassi di base di un'istruzione <code>UPDATE</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>UPDATE</code> seguito dal nome della tabella da modificare</item><item value=\"2\" correct=\"false\"><code>UPDATE</code> seguito dal nome della colonna da modificare</item></selection><p visible-if=\"wrong\"><code>UPDATE</code> seguito dal nome della tabella da modificare.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Devi modificare la colonna <code>email</code> nella tabella <code>users</code>. Quale apertura identifica correttamente la tabella da aggiornare?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>UPDATE users</code></item><item value=\"2\" correct=\"false\"><code>UPDATE email</code></item><item value=\"3\" correct=\"false\"><code>UPDATE users.email</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>UPDATE users</code>.</p></body></html>"
          },
          {
            "title": "Question: One Row",
            "id": 118700,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Che cosa devi includere se vuoi modificare solo una riga specifica di dati?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Una clausola <code>WHERE</code></item><item value=\"2\" correct=\"false\">Il nome della colonna e il nuovo valore</item></selection><p visible-if=\"wrong\">Una clausola <code>WHERE</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Vuoi modificare il punteggio solo nella riga il cui <code>id</code> è <code>7</code>. Cosa deve includere l'<code>UPDATE</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Una clausola <code>WHERE id = 7</code></item><item value=\"2\" correct=\"false\">Solo la colonna score e il suo nuovo valore</item><item value=\"3\" correct=\"false\">Una clausola <code>ON id = 7</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere Una clausola <code>WHERE id = 7</code>.</p></body></html>"
          },
          {
            "title": "Question: Multiple Rows",
            "id": 118701,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quali righe modificherà questa istruzione <code>UPDATE</code>?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE `Songs` (&#xA; `songname` TEXT NOT NULL,&#xA; `artist` TEXT NOT NULL,&#xA; `streams` INTEGER NOT NULL,&#xA; `certifications` TEXT&#xA;);&#xA;&#xA;INSERT INTO `Songs` (`songname`, `artist`, `streams`) VALUES ('Paradise', 'The Jets', 120);&#xA;&#xA;INSERT INTO `Songs` (`songname`, `artist`, `streams`) VALUES ('My Way', 'Stevie J', 100);&#xA;&#xA;INSERT INTO `Songs` (`songname`, `artist`, `streams`) VALUES ('Purple Sunrise', 'Harry', 90);&#xA;&#xA;INSERT INTO `Songs` (`songname`, `artist`, `streams`) VALUES ('California Highway', 'Joan &amp; Jerry', 85);&#xA;&#xA;INSERT INTO `Songs` (`songname`, `artist`, `streams`) VALUES ('My Sister Meg', 'Couches', 70);\"><tables><table name=\"Songs\"><row><header content=\"songname\" /><header content=\"artist\" /><header content=\"streams\" /><header content=\"certifications\" /></row><row><data content=\"Paradise\" /><data content=\"The Jets\" /><data content=\"120\" /><data content=\"\" /></row><row><data content=\"My Way\" /><data content=\"Stevie J\" /><data content=\"100\" /><data content=\"\" /></row><row><data content=\"Purple Sunrise\" /><data content=\"Harry\" /><data content=\"90\" /><data content=\"\" /></row><row><data content=\"California Highway\" /><data content=\"Joan &amp; Jerry\" /><data content=\"85\" /><data content=\"\" /></row><row><data content=\"My Sister Meg\" /><data content=\"Couches\" /><data content=\"70\" /><data content=\"\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" Songs \" /><text type=\"break\" /><text value=\"SET\" class=\"keyword\" /><text value=\" certifications = \" /><text value=\"'Platinum'\" class=\"string\" /><text value=\" \" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" streams &gt;= \" /><text value=\"100\" class=\"number\" /><text value=\";\" /></content><output><table name=\"Result\"><row><data content=\"No result!\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Le prime due righe</item><item value=\"2\" correct=\"false\">Solo la prima riga</item></selection><p visible-if=\"wrong\">Le prime due righe.</p></body></html>"
          },
          {
            "title": "Example: Limitations",
            "id": 118704,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Scrivi la parola chiave corretta dell'istruzione per modificare il valore di <code>streams</code> per <code>California Highway</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE `Songs` (&#xA; `songname` TEXT NOT NULL,&#xA; `artist` TEXT NOT NULL,&#xA; `streams` INTEGER NOT NULL,&#xA; `certifications` TEXT&#xA;);&#xA;&#xA;INSERT INTO `Songs` (`songname`, `artist`, `streams`) VALUES ('Paradise', 'The Jets', 120);&#xA;&#xA;INSERT INTO `Songs` (`songname`, `artist`, `streams`) VALUES ('My Way', 'Stevie J', 100);&#xA;&#xA;INSERT INTO `Songs` (`songname`, `artist`, `streams`) VALUES ('Purple Sunrise', 'Harry', 90);&#xA;&#xA;INSERT INTO `Songs` (`songname`, `artist`, `streams`) VALUES ('California Highway', 'Joan &amp; Jerry', 85);&#xA;&#xA;INSERT INTO `Songs` (`songname`, `artist`, `streams`) VALUES ('My Sister Meg', 'Couches', 70);\"><tables><table name=\"Songs\"><row><header content=\"songname\" /><header content=\"artist\" /><header content=\"streams\" /><header content=\"certifications\" /></row><row><data content=\"Paradise\" /><data content=\"The Jets\" /><data content=\"120\" /><data content=\"\" /></row><row><data content=\"My Way\" /><data content=\"Stevie J\" /><data content=\"100\" /><data content=\"\" /></row><row><data content=\"Purple Sunrise\" /><data content=\"Harry\" /><data content=\"90\" /><data content=\"\" /></row><row><data content=\"California Highway\" /><data content=\"Joan &amp; Jerry\" /><data content=\"85\" /><data content=\"\" /></row><row><data content=\"My Sister Meg\" /><data content=\"Couches\" /><data content=\"70\" /><data content=\"\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" SONGS \" /><text value=\"SET\" class=\"keyword\" /><text value=\" streams = \" /><text value=\"88\" class=\"number\" /><text value=\" \" 