            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Come facciamo a sapere quando un ciclo while si fermerà?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Controllando la sua condizione</item><item value=\"2\" correct=\"false\">Controllando la sua parola chiave</item></selection><p visible-if=\"wrong\">Controllando la sua condizione.</p></body></html>"
          },
