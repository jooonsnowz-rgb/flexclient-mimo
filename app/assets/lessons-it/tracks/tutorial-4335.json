            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Come si chiamano le parentesi graffe <code>{ }</code> e il codice al loro interno?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"while\" class=\"keyword\" /><text value=\" (\" /><text value=\"false\" class=\"literal\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Spawn enemy&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Un blocco di codice</item><item value=\"2\" correct=\"false\">Una condizione</item></selection><p visible-if=\"wrong\">Un blocco di codice.</p></body></html>"
          },
          {
