            "interactiveContent": "<!DOCTYPE html ><html><body><p>Come chiamiamo un ciclo che si ripete per sempre?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Un loop infinito</item><item value=\"2\" correct=\"false\">Un ciclo while</item></selection><p visible-if=\"wrong\">Un loop infinito.</p></body></html>"
          },
          {
