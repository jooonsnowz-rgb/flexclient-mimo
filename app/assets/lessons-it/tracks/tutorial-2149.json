nt=\"123\" /></row><row><data content=\"Kiana\" /><data content=\"839\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" sqlite_schema;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"14\" endIndex=\"20\" /><option startIndex=\"20\" endIndex=\"21\" /><option startIndex=\"21\" endIndex=\"27\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"type\" /><header content=\"name\" /><header content=\"tbl_name\" /><header content=\"rootpage\" /><header content=\"sql\" /></row><row><data content=\"table\" /><data content=\"past_events\" /><data content=\"past_events\" /><data content=\"2\" /><data content=\"CREATE TABLE past_events(&#xA;    name varchar(255),&#xA;    entry int,&#xA;    attendees int&#xA;)\" /></row><row><data content=\"table\" /><data content=\"events\" /><data content=\"events\" /><data content=\"3\" /><data content=\"CREATE TABLE events(&#xA;    name varchar(255),&#xA;    registered int&#xA;)\" /></row><row><data content=\"table\" /><data content=\"crew\" /><data content=\"crew\" /><data content=\"4\" /><data content=\"CREATE TABLE crew(&#xA; name varchar(255),&#xA; id int&#xA;)\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>sqlite</code>, seguito da <code>_</code> e infine <code>schema</code>.</p></body></html>"
