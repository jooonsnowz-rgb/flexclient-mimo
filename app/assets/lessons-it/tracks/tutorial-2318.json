            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Di che tipo è il valore della condizione di un'istruzione if?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Boolean</item><item value=\"2\" correct=\"false\">String</item><item value=\"3\" correct=\"false\">Numero</item><item value=\"4\" correct=\"false\">Qualsiasi tipo</item></selection><p visible-if=\"wrong\">Assicurati di scegliere Boolean.</p></body></html>"
