            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Imposta correttamente il parametro della funzione <code>duplicate</code>.</p><code version=\"2\" codelang=\"typescript\" name=\"script.ts\" visible-if=\"always\"><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"duplicate\" class=\"title\" /><text value=\"(\" /><text value=\"input: \" /><text value=\"number\" class=\"built_in\" /><text value=\"): \" /><text value=\"number\" class=\"title\" /><text value=\" \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" input * \" /><text value=\"2\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(duplicate(\" /><text value=\"25\" class=\"number\" /><text value=\"));\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"19\" endIndex=\"24\" /><option startIndex=\"24\" endIndex=\"25\" /><option startIndex=\"26\" endIndex=\"32\" /><option correct=\"false\"><content><text value=\"string\" /></content></option></options></interaction></interactions><output><content><text value=\"50\" /></content></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>input</code>, seguito da <code>:</code> e infine <code>number</code>.</p></body></html>"
          },
