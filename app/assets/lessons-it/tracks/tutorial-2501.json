            "interactiveContent": "<!DOCTYPE html ><html><body><p>Aggiungi l'operatore che rende il confronto <code>false</code>.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"10\" class=\"number\" /><text value=\" != \" /><text value=\"10\" class=\"number\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"9\" endIndex=\"11\" /><option correct=\"false\"><content><text value=\"==\" /></content></option></options></interaction></interactions><output><content><text value=\"false\" /></content></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>!=</code>.</p></body></html>"
