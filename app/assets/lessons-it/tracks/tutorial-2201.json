            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Cosa succede a una pagina web se non includiamo un link a un particolare file CSS?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Gli stili nel file non verranno applicati alla pagina web</item><item value=\"2\" correct=\"false\">Verrà visualizzato un errore nella pagina web</item><item value=\"2\" correct=\"false\">Gli stili nel file vengono applicati parzialmente alla pagina web</item></selection><p visible-if=\"wrong\">Gli stili nel file non verranno applicati alla pagina web.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Un file CSS contiene regole per una pagina, ma il codice HTML non lo collega mai. Che cosa succede?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Gli stili nel file non verranno applicati alla pagina web</item><item value=\"2\" correct=\"false\">Il browser smette di mostrare la pagina web</item><item value=\"3\" correct=\"false\">Viene applicato solo il primo stile del file</item></selection><p visible-if=\"wrong\">Gli stili nel file non verranno applicati alla pagina web.</p></body></html>"
