            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Che cosa fa <code>!==</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Controlla se una stringa non è uguale a un'altra stringa</item><item value=\"2\" correct=\"false\">Controlla se una stringa è uguale a un'altra stringa</item><item value=\"2\" correct=\"false\">Verifica se una stringa è minore di un'altra stringa</item></selection><p visible-if=\"wrong\">Controlla se una stringa non è uguale a un'altra stringa.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>In <code>name !== \"Nina\"</code>, <code>name</code> contiene <code>\"Mika\"</code>. Cosa verifica <code>!==</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Controlla se una stringa non è uguale a un'altra stringa</item><item value=\"2\" correct=\"false\">Controlla se una stringa è uguale a un'altra stringa</item><item value=\"3\" correct=\"false\">Verifica se una stringa è minore di un'altra stringa</item><item value=\"4\" correct=\"false\">Assegna <code>\"Nina\"</code> a <code>name</code></item></selection><p visible-if=\"wrong\">Controlla se una stringa non è uguale a un'altra stringa.</p></body></html>"
