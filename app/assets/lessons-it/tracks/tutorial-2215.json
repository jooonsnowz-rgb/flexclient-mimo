            "interactiveContent": "<!DOCTYPE html ><html><body><p>Verifica che <code>\"Apple\"</code> non sia uguale a <code>\"Nokia\"</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Apple&quot;\" class=\"string\" /><text value=\" !== \" /><text value=\"&quot;Nokia&quot;\" class=\"string\" /><text value=\");\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"20\" endIndex=\"23\" /></interactions><output><content><text value=\"true\" /></content></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>!==</code>.</p></body></html>"
