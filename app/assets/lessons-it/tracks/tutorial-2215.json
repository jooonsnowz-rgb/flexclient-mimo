            "interactiveContent": "<!DOCTYPE html ><html><body><p>Che cosa visualizza questo codice nella console?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" mainSubject = \" /><text value=\"43\" class=\"number\" /><text value=\"; \" /><text type=\"break\" /><text value=\"let\" class=\"keyword\" /><text value=\" extraCurricular = \" /><text value=\"12\" class=\"number\" /><text value=\"; \" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" result = (mainSubject &gt; \" /><text value=\"35\" class=\"number\" /><text value=\") &amp;&amp; (extraCurricular &gt; \" /><text value=\"40\" class=\"number\" /><text value=\"); \" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(result);\" /></content><output><content><text value=\"false\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"false\"><code>true</code></item><item value=\"2\" correct=\"true\"><code>false</code></item><item value=\"3\" correct=\"false\">Errore</item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>false</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>mainSubject &gt; 35</code> è vero, ma <code>extraCurricular &gt; 40</code> è falso. Cosa visualizza la loro espressione <code>&amp;&amp;</code>?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" mainSubject = \" /><text value=\"43\" class=\"number\" /><text value=\"; \" /><text type=\"break\" /><text value=\"let\" class=\"keyword\" /><text value=\" extraCurricular = \" /><text value=\"12\" class=\"number\" /><text value=\"; \" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" result = (mainSubject &gt; \" /><text value=\"35\" class=\"number\" /><text value=\") &amp;&amp; (extraCurricular &gt; \" /><text value=\"40\" class=\"number\" /><text value=\"); \" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(result);\" /></content><output><content><text value=\"false\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"false\"><code>true</code></item><item value=\"2\" correct=\"true\"><code>false</code></item><item value=\"3\" correct=\"false\">Errore</item><item value=\"4\" correct=\"false\"><code>43</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>false</code>.</p></body></html>"
