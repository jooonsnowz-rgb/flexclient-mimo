            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quali sono due parametri comuni che ha <code>setInterval()</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Una funzione di callback e un ritardo</item><item value=\"2\" correct=\"false\"><code>setInterval()</code> accetta solo una funzione callback come parametro</item></selection><p visible-if=\"wrong\">Una funzione di callback e un ritardo.</p></body></html>"
