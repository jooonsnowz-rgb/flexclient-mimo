          {
            "title": "Choose the sentinel",
            "id": 152121,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Una quantità non valida significa che l'ordine non può continuare. Quale valore restituito rende esplicito questo fallimento senza inventare una quantità?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>return None</code></item><item value=\"2\" correct=\"false\"><code>return 0</code></item><item value=\"3\" correct=\"false\"><code>return 1</code></item></selection><p visible-if=\"wrong\"><code>return None</code>.</p></body></html>",
            "hardModeSelected": true
