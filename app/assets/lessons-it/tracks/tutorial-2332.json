          {
            "title": "Question: Whitespace",
            "id": 82837,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Qual è il separatore predefinito quando si usa <code>split()</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Uno spazio bianco</item><item value=\"2\" correct=\"false\">Un punto</item><item value=\"3\" correct=\"false\">Un trattino</item></selection><p visible-if=\"wrong\">Uno spazio bianco.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Cosa restituisce <code>\"red.blue green\".split()</code> quando non viene fornito alcun separatore?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>['red.blue', 'green']</code></item><item value=\"2\" correct=\"false\"><code>['red', 'blue green']</code></item><item value=\"3\" correct=\"false\"><code>['red', 'blue', 'green']</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>['red.blue', 'green']</code>.</p></body></html>",
            "hardModeSelected": true
