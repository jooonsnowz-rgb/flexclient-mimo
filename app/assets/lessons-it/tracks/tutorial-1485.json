        "lessons": [
          {
            "title": "Temporary",
            "id": 96466,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>L'aliasing non cambia il nome nella tabella originale. Gli alias come <code>user</code> sono nomi temporanei all'interno della tabella dei risultati.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE contacts (&#xA; first_name varchar(255),&#xA; last_name varchar(255),&#xA; email varchar(255)&#xA;);&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Sam', 'Smith', 'sam17@mail.com');&#xA;&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Remy', 'Allard', 'rem@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Luis', 'Martinez', 'luis_99@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Kim', 'Zhong', 'kim.z@mail.com');&#xA;\"><tables><table name=\"contacts\"><row><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"Sam\" /><data content=\"Smith\" /><data content=\"sam17@mail.com\" /></row><row><data content=\"Remy\" /><data content=\"Allard\" /><data content=\"rem@mail.com\" /></row><row><data content=\"Luis\" /><data content=\"Martinez\" /><data content=\"luis_99@mail.com\" /></row><row><data content=\"Kim\" /><data content=\"Zhong\" /><data content=\"kim.z@mail.com\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" first_name \" /><text value=\"AS\" class=\"keyword\" /><text value=\" \" /><text value=\"user\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" contacts;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"17\" /><option startIndex=\"18\" endIndex=\"20\" /><option startIndex=\"21\" endIndex=\"25\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"user\" /></row><row><data content=\"Sam\" /></row><row><data content=\"Remy\" /></row><row><data content=\"Luis\" /></row><row><data content=\"Kim\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>SELECT</code>, seguito da <code>first_name</code> e poi <code>AS</code>, <code>user</code>.</p></body></html>"
          },
          {
            "title": "As many as we want",
            "id": 96467,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Possiamo anche usare alias quando selezioniamo più colonne. Seleziona anche la colonna <code>email</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE contacts (&#xA; first_name varchar(255),&#xA; last_name varchar(255),&#xA; email varchar(255)&#xA;);&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Sam', 'Smith', 'sam17@mail.com');&#xA;&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Remy', 'Allard', 'rem@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Luis', 'Martinez', 'luis_99@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Kim', 'Zhong', 'kim.z@mail.com');&#xA;\"><tables><table name=\"contacts\"><row><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"Sam\" /><data content=\"Smith\" /><data content=\"sam17@mail.com\" /></row><row><data content=\"Remy\" /><data content=\"Allard\" /><data content=\"rem@mail.com\" /></row><row><data content=\"Luis\" /><data content=\"Martinez\" /><data content=\"luis_99@mail.com\" /></row><row><data content=\"Kim\" /><data content=\"Zhong\" /><data content=\"kim.z@mail.com\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" first_name \" /><text value=\"AS\" class=\"keyword\" /><text value=\" \" /><text value=\"user\" class=\"keyword\" /><text value=\", email\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" contacts;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"25\" endIndex=\"26\" /><option startIndex=\"27\" endIndex=\"32\" /><option correct=\"false\"><content><text value=\";\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"user\" /><header content=\"email\" /></row><row><data content=\"Sam\" /><data content=\"sam17@mail.com\" /></row><row><data content=\"Remy\" /><data content=\"rem@mail.com\" /></row><row><data content=\"Luis\" /><data content=\"luis_99@mail.com\" /></row><row><data content=\"Kim\" /><data content=\"kim.z@mail.com\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>,</code>, seguito da <code>email</code>.</p></body></html>"
          },
          {
            "title": "As many as we want 2",
            "id": 96468,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quando selezioni più colonne, puoi fornire un alias per ciascuna. Assegna a <code>email</code> l'alias <code>contact</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE contacts (&#xA; first_name varchar(255),&#xA; last_name varchar(255),&#xA; email varchar(255)&#xA;);&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Sam', 'Smith', 'sam17@mail.com');&#xA;&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Remy', 'Allard', 'rem@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Luis', 'Martinez', 'luis_99@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Kim', 'Zhong', 'kim.z@mail.com');&#xA;\"><tables><table name=\"contacts\"><row><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"Sam\" /><data content=\"Smith\" /><data content=\"sam17@mail.com\" /></row><row><data content=\"Remy\" /><data content=\"Allard\" /><data content=\"rem@mail.com\" /></row><row><data content=\"Luis\" /><data content=\"Martinez\" /><data content=\"luis_99@mail.com\" /></row><row><data content=\"Kim\" /><data content=\"Zhong\" /><data content=\"kim.z@mail.com\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" first_name \" /><text value=\"AS\" class=\"keyword\" /><text value=\" \" /><text value=\"user\" class=\"keyword\" /><text value=\", \" /><text type=\"break\" /><text value=\"email \" /><text value=\"AS\" class=\"keyword\" /><text value=\" contact\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" contacts;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"34\" endIndex=\"36\" /><option startIndex=\"37\" endIndex=\"44\" /><option correct=\"false\"><content><text value=\"email\" /></content></option><option correct=\"false\"><content><text value=\"address\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"user\" /><header content=\"contact\" /></row><row><data content=\"Sam\" /><data content=\"sam17@mail.com\" /></row><row><data content=\"Remy\" /><data content=\"rem@mail.com\" /></row><row><data content=\"Luis\" /><data content=\"luis_99@mail.com\" /></row><row><data content=\"Kim\" /><data content=\"kim.z@mail.com\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>AS</code>, seguito da <code>contact</code>.</p></body></html>"
          },
          {
            "title": "Question: Temporary",
            "id": 96792,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Cosa intendiamo quando diciamo che gli alias sono nomi temporanei?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Un alias rinomina semplicemente una colonna nella tabella dei risultati di una determinata query</item><item value=\"2\" correct=\"false\">Un alias, una volta usato, si applica a tutte le tabelle dei risultati</item></selection><p visible-if=\"wrong\">Un alias rinomina semplicemente una colonna nella tabella dei risultati di una determinata query.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Una query usa <code>price AS cost</code>. Una query successiva seleziona <code>price</code> senza alias. Quale intestazione usa il risultato successivo?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>price</code>, perché <code>cost</code> si applicava solo al primo risultato</item><item value=\"2\" correct=\"false\"><code>cost</code>, perché il primo alias si applica ai risultati successivi</item><item value=\"3\" correct=\"false\">Sia <code>price</code> sia <code>cost</code>, perché gli alias creano un'intestazione aggiuntiva</item></selection><p visible-if=\"wrong\"><code>price</code>, perché <code>cost</code> si applicava solo al primo risultato.</p></body></html>"
          },
          {
            "title": "Question: As many as we want",
            "id": 96793,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quanti alias possiamo fornire in una query?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Uno per ogni colonna selezionata</item><item value=\"2\" correct=\"false\">Solo uno, per la prima colonna che selezioniamo</item></selection><p visible-if=\"wrong\">Uno per ogni colonna selezionata.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Una query seleziona <code>name</code> e <code>price</code>. Vuoi le intestazioni <code>product</code> e <code>cost</code> nel risultato. Come devi assegnare gli alias?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Usare <code>name AS product</code> e <code>price AS cost</code></item><item value=\"2\" correct=\"false\">Usare un solo alias dopo <code>price</code>; rinomina entrambe le colonne selezionate</item><item value=\"3\" correct=\"false\">Assegnare alla tabella l'alias <code>product</code>; modifica entrambe le intestazioni dei risultati</item></selection><p visible-if=\"wrong\">Usare <code>name AS product</code> e <code>price AS cost</code>.</p></body></html>"
          },
          {
            "title": "Example: As many as we want",
            "id": 96796,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Seleziona la colonna <code>name</code> con un alias, quindi la colonna <code>score</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; score int&#xA;);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Jean Miller', 5);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Emma Brown', 8);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Reese Jones', 2);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Kim Lee', 9);&#xA;\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"score\" /></row><row><data content=\"Jean Miller\" /><data content=\"5\" /></row><row><data content=\"Emma Brown\" /><data content=\"8\" /></row><row><data content=\"Reese Jones\" /><data content=\"2\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" student, score\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" score = \" /><text value=\"9\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"22\" /><option startIndex=\"22\" endIndex=\"23\" /><option startIndex=\"24\" endIndex=\"29\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"student\" /><header content=\"score\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>SELECT</code>, seguito da <code>name AS student</code> e poi <code>,</code>, <code>score</code>.</p></body></html>"
          },
          {
            "title": "Example: As many as we want 2",
            "id": 96797,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Seleziona la colonna <code>score</code> e rinominala in <code>max_score</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; score int&#xA;);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Jean Miller', 5);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Emma Brown', 8);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Reese Jones', 2);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Kim Lee', 9);&#xA;\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"score\" /></row><row><data content=\"Jean Miller\" /><data content=\"5\" /></row><row><data content=\"Emma Brown\" /><data content=\"8\" /></row><row><data content=\"Reese Jones\" /><data content=\"2\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" student, score \" /><text value=\"AS\" class=\"keyword\" /><text value=\" max_score\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" score = \" /><text value=\"9\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"24\" endIndex=\"29\" /><option startIndex=\"30\" endIndex=\"32\" /><option startIndex=\"33\" endIndex=\"42\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"student\" /><header content=\"max_score\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>score</code>, seguito da <code>AS</code> e infine <code>max_score</code>.</p></body></html>"
