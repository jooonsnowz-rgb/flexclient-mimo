        "type": "practiceLevel1",
        "lessons": [
          {
            "title": "Intro",
            "id": 96461,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>I nomi delle tabelle o delle colonne possono diventare piuttosto lunghi, come <code>first_name</code> e <code>last_name</code> in questo caso.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE contacts (&#xA; first_name varchar(255),&#xA; last_name varchar(255),&#xA; email varchar(255)&#xA;);&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Sam', 'Smith', 'sam17@mail.com');&#xA;&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Remy', 'Allard', 'rem@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Luis', 'Martinez', 'luis_99@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Kim', 'Zhong', 'kim.z@mail.com');&#xA;\"><tables><table name=\"contacts\"><row><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"Sam\" /><data content=\"Smith\" /><data content=\"sam17@mail.com\" /></row><row><data content=\"Remy\" /><data content=\"Allard\" /><data content=\"rem@mail.com\" /></row><row><data content=\"Luis\" /><data content=\"Martinez\" /><data content=\"luis_99@mail.com\" /></row><row><data content=\"Kim\" /><data content=\"Zhong\" /><data content=\"kim.z@mail.com\" /></row></table></tables></database></body></html>"
          },
          {
            "title": "Intro 2",
            "id": 96462,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Per semplificare nomi come <code>first_name</code> o per dare alle colonne un significato diverso all'interno di una query, usiamo gli <strong>alias</strong>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE contacts (&#xA; first_name varchar(255),&#xA; last_name varchar(255),&#xA; email varchar(255)&#xA;);&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Sam', 'Smith', 'sam17@mail.com');&#xA;&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Remy', 'Allard', 'rem@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Luis', 'Martinez', 'luis_99@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Kim', 'Zhong', 'kim.z@mail.com');&#xA;\"><tables><table name=\"contacts\"><row><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"Sam\" /><data content=\"Smith\" /><data content=\"sam17@mail.com\" /></row><row><data content=\"Remy\" /><data content=\"Allard\" /><data content=\"rem@mail.com\" /></row><row><data content=\"Luis\" /><data content=\"Martinez\" /><data content=\"luis_99@mail.com\" /></row><row><data content=\"Kim\" /><data content=\"Zhong\" /><data content=\"kim.z@mail.com\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" first_name\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" contacts;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"17\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"first_name\" /></row><row><data content=\"Sam\" /></row><row><data content=\"Remy\" /></row><row><data content=\"Luis\" /></row><row><data content=\"Kim\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>SELECT</code>, seguito da <code>first_name</code>.</p></body></html>"
          },
          {
            "title": "Aliasing",
            "id": 96463,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Assegnando un <strong>alias</strong> a una colonna, le assegniamo un nome temporaneo. Qui, stiamo rinominando <code>first_name</code> in <code>user</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE contacts (&#xA; first_name varchar(255),&#xA; last_name varchar(255),&#xA; email varchar(255)&#xA;);&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Sam', 'Smith', 'sam17@mail.com');&#xA;&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Remy', 'Allard', 'rem@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Luis', 'Martinez', 'luis_99@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Kim', 'Zhong', 'kim.z@mail.com');&#xA;\"><tables><table name=\"contacts\"><row><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"Sam\" /><data content=\"Smith\" /><data content=\"sam17@mail.com\" /></row><row><data content=\"Remy\" /><data content=\"Allard\" /><data content=\"rem@mail.com\" /></row><row><data content=\"Luis\" /><data content=\"Martinez\" /><data content=\"luis_99@mail.com\" /></row><row><data content=\"Kim\" /><data content=\"Zhong\" /><data content=\"kim.z@mail.com\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" first_name \" /><text value=\"AS\" class=\"keyword\" /><text value=\" \" /><text value=\"user\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" contacts;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"18\" endIndex=\"25\" /><option correct=\"false\"><content><text value=\"AS person\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"user\" /></row><row><data content=\"Sam\" /></row><row><data content=\"Remy\" /></row><row><data content=\"Luis\" /></row><row><data content=\"Kim\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>AS user</code>.</p></body></html>"
          },
          {
            "title": "AS",
            "id": 96465,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quando usi un alias, inizi selezionando la colonna come al solito. Poi, usi <code>AS</code> con un alias, come <code>user</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE contacts (&#xA; first_name varchar(255),&#xA; last_name varchar(255),&#xA; email varchar(255)&#xA;);&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Sam', 'Smith', 'sam17@mail.com');&#xA;&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Remy', 'Allard', 'rem@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Luis', 'Martinez', 'luis_99@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Kim', 'Zhong', 'kim.z@mail.com');&#xA;\"><tables><table name=\"contacts\"><row><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"Sam\" /><data content=\"Smith\" /><data content=\"sam17@mail.com\" /></row><row><data content=\"Remy\" /><data content=\"Allard\" /><data content=\"rem@mail.com\" /></row><row><data content=\"Luis\" /><data content=\"Martinez\" /><data content=\"luis_99@mail.com\" /></row><row><data content=\"Kim\" /><data content=\"Zhong\" /><data content=\"kim.z@mail.com\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" first_name \" /><text value=\"AS\" class=\"keyword\" /><text value=\" \" /><text value=\"user\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" contacts;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"18\" endIndex=\"25\" /></interactions><output><table name=\"Result\"><row><header content=\"user\" /></row><row><data content=\"Sam\" /></row><row><data content=\"Remy\" /></row><row><data content=\"Luis\" /></row><row><data content=\"Kim\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>AS user</code>.</p></body></html>"
          },
          {
            "title": "Only within the query",
            "id": 96464,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quando assegni un alias a una colonna, il suo nome cambia nella tabella dei risultati. Controlla la colonna <code>user</code> nei nostri risultati.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE contacts (&#xA; first_name varchar(255),&#xA; last_name varchar(255),&#xA; email varchar(255)&#xA;);&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Sam', 'Smith', 'sam17@mail.com');&#xA;&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Remy', 'Allard', 'rem@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Luis', 'Martinez', 'luis_99@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Kim', 'Zhong', 'kim.z@mail.com');&#xA;\"><tables><table name=\"contacts\"><row><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"Sam\" /><data content=\"Smith\" /><data content=\"sam17@mail.com\" /></row><row><data content=\"Remy\" /><data content=\"Allard\" /><data content=\"rem@mail.com\" /></row><row><data content=\"Luis\" /><data content=\"Martinez\" /><data content=\"luis_99@mail.com\" /></row><row><data content=\"Kim\" /><data content=\"Zhong\" /><data content=\"kim.z@mail.com\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" first_name \" /><text value=\"AS\" class=\"keyword\" /><text value=\" \" /><text value=\"user\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" contacts;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"21\" endIndex=\"25\" /></interactions><output><table name=\"Result\"><row><header content=\"user\" /></row><row><data content=\"Sam\" /></row><row><data content=\"Remy\" /></row><row><data content=\"Luis\" /></row><row><data content=\"Kim\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>user</code>.</p></body></html>"
          },
          {
            "title": "Question: Aliasing",
            "id": 96784,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Che cosa fa l'aliasing?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">L'aliasing assegna temporaneamente a una colonna un nome, l'alias</item><item value=\"2\" correct=\"false\">La creazione di alias seleziona solo il primo valore in una colonna</item></selection><p visible-if=\"wrong\">L'aliasing assegna temporaneamente a una colonna un nome, l'alias.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Esegui <code>SELECT price AS cost FROM products;</code>. Quale intestazione appare nella tabella dei risultati?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>cost</code></item><item value=\"2\" correct=\"false\"><code>price</code>, perché gli alias etichettano solo i valori</item><item value=\"3\" correct=\"false\"><code>products</code>, perché il nome della tabella diventa l'intestazione</item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>cost</code>.</p></body></html>"
          },
          {
            "title": "Question: AS",
            "id": 96785,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quale parola chiave usiamo quando creiamo un alias?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>AS</code></item><item value=\"2\" correct=\"false\"><code>FROM</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>AS</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Usiamo <code>AS</code> per creare un alias. Vuoi selezionare <code>price</code> e mostrarlo sotto l'intestazione <code>cost</code>. Quale frammento posiziona correttamente la parola chiave?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>price AS cost</code></item><item value=\"2\" correct=\"false\"><code>price FROM cost</code></item><item value=\"3\" correct=\"false\"><code>cost AS price</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>price AS cost</code>.</p></body></html>"
          },
          {
            "title": "Question: Only within the query",
            "id": 96786,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>L'aliasing rinomina la colonna nella tabella originale?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">No, l'alias rinomina la colonna solo nella tabella dei risultati</item><item value=\"2\" correct=\"false\">Sì, l'alias rinomina la colonna nella tabella originale </item></selection><p visible-if=\"wrong\">No, l'alias rinomina la colonna solo nella tabella dei risultati.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Dopo <code>SELECT price AS cost FROM products;</code>, esegui <code>SELECT price FROM products;</code>. Quale nome di colonna funziona ancora?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>price</code>, perché l'alias non ha modificato la tabella originale</item><item value=\"2\" correct=\"false\"><code>cost</code>, perché la prima query ha rinominato la colonna in modo permanente</item><item value=\"3\" correct=\"false\">Entrambi i nomi, perché un alias aggiunge una seconda colonna alla tabella</item></selection><p visible-if=\"wrong\"><code>price</code>, perché l'alias non ha modificato la tabella originale.</p></body></html>"
          },
          {
            "title": "Example: Aliasing",
            "id": 96789,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Seleziona i valori di <code>score</code> maggiori di <code>7</code> con l'alias <code>highest_score</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; score int&#xA;);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Jean Miller', 5);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Emma Brown', 8);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Reese Jones', 2);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Kim Lee', 9);&#xA;\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"score\" /></row><row><data content=\"Jean Miller\" /><data content=\"5\" /></row><row><data content=\"Emma Brown\" /><data content=\"8\" /></row><row><data content=\"Reese Jones\" /><data content=\"2\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" score \" /><text value=\"AS\" class=\"keyword\" /><text value=\" highest_score\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" score &gt; \" /><text value=\"7\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"12\" /><option startIndex=\"13\" endIndex=\"29\" /><option correct=\"false\"><content><text value=\"AS score\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"highest_score\" /></row><row><data content=\"8\" /></row><row><data content=\"9\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>SELECT score</code>, seguito da <code>AS highest_score</code>.</p></body></html>"
          },
          {
            "title": "Example: AS",
            "id": 96790,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Scrivi <code>AS</code> per fornire un alias alla colonna del risultato.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; score int&#xA;);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Jean Miller', 5);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Emma Brown', 8);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Reese Jones', 2);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Kim Lee', 9);&#xA;\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"score\" /></row><row><data content=\"Jean Miller\" /><data content=\"5\" /></row><row><data content=\"Emma Brown\" /><data content=\"8\" /></row><row><data content=\"Reese Jones\" /><data content=\"2\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" score \" /><text value=\"AS\" class=\"keyword\" /><text value=\" highest_score\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" score &gt; \" /><text value=\"7\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"13\" endIndex=\"15\" /></interactions><output><table name=\"Result\"><row><header content=\"highest_score\" /></row><row><data content=\"8\" /></row><row><data content=\"9\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>AS</code>.</p></body></html>"
          },
          {
            "title": "Example: Only within the query",
            "id": 96791,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Seleziona la colonna <code>name</code> e rinominala in <code>team_leader</code> nella tabella dei risultati.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; score int&#xA;);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Jean Miller', 5);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Emma Brown', 8);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Reese Jones', 2);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Kim Lee', 9);&#xA;\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"score\" /></row><row><data content=\"Jean Miller\" /><data content=\"5\" /></row><row><data content=\"Emma Brown\" /><data content=\"8\" /></row><row><data content=\"Reese Jones\" /><data content=\"2\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" team_leader\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" = \" /><text value=\"'Kim Lee'\" class=\"string\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"11\" /><option startIndex=\"12\" endIndex=\"14\" /><option startIndex=\"15\" endIndex=\"26\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"team_leader\" /></row><row><data content=\"Kim Lee\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>SELECT</code>, seguito da <code>name</code> e poi <code>AS</code>, <code>team_leader</code>.</p></body></html>"
          }
        ]
