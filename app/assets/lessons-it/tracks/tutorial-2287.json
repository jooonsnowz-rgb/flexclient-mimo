          {
            "title": "Example: Aliasing",
            "id": 129097,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Seleziona il valore <code>name</code> del gioco più vecchio con l'alias <code>oldest</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" oldest\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" = \" /><text value=\"1983\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"11\" /><option startIndex=\"12\" endIndex=\"14\" /><option startIndex=\"15\" endIndex=\"21\" /><option correct=\"false\"><content><text value=\"release\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"oldest\" /></row><row><data content=\"Mario Bros.\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>SELECT</code>, seguito da <code>name</code> e poi <code>AS</code>, <code>oldest</code>.</p></body></html>"
          },
          {
            "title": "Question: The inequality operator 2",
            "id": 91829,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quale query seleziona gli elementi in cui la proprietà <code>destination</code> non è <code>'Rome'</code>?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" flights\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" destination = \" /><text value=\"'Rome'\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" flights\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" destination &lt;&gt; \" /><text value=\"'Rome'\" class=\"string\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">La seconda, perché usa l'operatore di disuguaglianza <code>&lt;&gt;</code></item><item value=\"2\" correct=\"false\">La prima, perché usa l'operatore di uguaglianza <code>=</code></item><item value=\"3\" correct=\"false\">Entrambi</item></selection><p visible-if=\"wrong\">La seconda, perché usa l'operatore di disuguaglianza <code>&lt;&gt;</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>In SQL, <code>&lt;&gt;</code> verifica che due valori siano diversi.</p><p>La destinazione di un volo è <code>'Paris'</code>. Quale query include il volo?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" flights\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" destination = \" /><text value=\"'Rome'\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" flights\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" destination &lt;&gt; \" /><text value=\"'Rome'\" class=\"string\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Solo la seconda query.</item><item value=\"2\" correct=\"false\">Solo la prima query.</item><item value=\"3\" correct=\"false\">Entrambe le query.</item><item value=\"4\" correct=\"false\">Nessuna delle due query.</item></selection><p visible-if=\"wrong\">Solo la seconda query.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example: The inequality operator 2",
            "id": 91827,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Scrivi una condizione per selezionare tutti gli elementi <code>flights</code> in cui <code>daily</code> non è <code>1</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE flights (&#xA;destination varchar(255),&#xA;daily int&#xA;);&#xA;&#xA;INSERT INTO flights (destination, daily)&#xA;VALUES ('New York', 1);&#xA;INSERT INTO flights (destination, daily)&#xA;VALUES ('Paris', 3);&#xA;INSERT INTO flights (destination, daily)&#xA;VALUES ('Hong Kong', 1);&#xA;INSERT INTO flights (destination, daily)&#xA;VALUES ('Rome', 3);\"><tables><table name=\"flights\"><row><header content=\"destination\" /><header content=\"daily\" /></row><row><data content=\"New York\" /><data content=\"1\" /></row><row><data content=\"Paris\" /><data content=\"3\" /></row><row><data content=\"Hong Kong\" /><data content=\"1\" /></row><row><data content=\"Rome\" /><data content=\"3\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" flights\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" daily &lt;&gt; \" /><text value=\"1\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"28\" endIndex=\"38\" /></interactions><output><table name=\"Result\"><row><header content=\"destination\" /><header content=\"daily\" /></row><row><data content=\"Paris\" /><data content=\"3\" /></row><row><data content=\"Rome\" /><data content=\"3\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>daily &lt;&gt; 1</code>.</p></body></html>"
          },
          {
            "title": "Example: AS",
            "id": 129098,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Seleziona il <code>name</code> del gioco più recente con un alias, usando <code>SELECT name</code>, <code>AS</code> e l'alias <code>newest</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" newest\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" = \" /><text value=\"2013\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"0\" endIndex=\"21\" /></interactions><output><table name=\"Result\"><row><header content=\"newest\" /></row><row><data content=\"Super Mario 3D World\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>SELECT name AS newest</code>.</p></body></html>"
          },
          {
            "title": "Question: Only within the query",
            "id": 129096,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Come viene chiamata la colonna <code>name</code> nella tabella <em>original</em> dopo aver eseguito questa query?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" newest\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" = \" /><text value=\"2013\" class=\"number\" /><text value=\";\" /></content><output><table name=\"Result\"><row><data content=\"No result!\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>name</code>, perché un alias non modifica la tabella originale</item><item value=\"2\" correct=\"false\"><code>newest</code>, dato che gli abbiamo assegnato un alias</item><item value=\"3\" correct=\"false\"><code>name</code>, perché manca la parola chiave <code>AS</code></item></selection><p visible-if=\"wrong\"><code>name</code>, perché un alias non modifica la tabella originale.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Un alias modifica l'etichetta della colonna restituita, non la tabella originale.</p><p>Rimuovi <code>AS newest</code>. Come si chiamano ora la colonna restituita e quella della tabella originale?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" newest\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" = \" /><text value=\"2013\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Entrambe si chiamano name.</item><item value=\"2\" correct=\"false\">Entrambe si chiamano newest.</item><item value=\"3\" correct=\"false\">Il risultato usa name, la tabella usa newest.</item><item value=\"4\" correct=\"false\">Il risultato usa newest, la tabella usa name.</item></selection><p visible-if=\"wrong\">Entrambe si chiamano name.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example: As many as we want",
            "id": 129099,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Scrivi una virgola <code>,</code> e poi seleziona anche la colonna <code>release</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" newest, \" /><text value=\"release\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" = \" /><text value=\"2013\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"21\" endIndex=\"30\" /></interactions><output><table name=\"Result\"><row><header content=\"newest\" /><header content=\"release\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>, release</code>.</p></body></html>"
          },
          {
            "title": "Example: As many as we want 2",
            "id": 129100,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Seleziona la colonna <code>release</code> e rinominala in <code>year</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" newest, \" /><text value=\"release\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" = \" /><text value=\"2013\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"23\" endIndex=\"30\" /><option startIndex=\"31\" endIndex=\"33\" /><option startIndex=\"34\" endIndex=\"38\" /><option correct=\"false\"><content><text value=\"release_year\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"newest\" /><header content=\"year\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>release</code>, seguito da <code>AS</code> e infine <code>year</code>.</p></body></html>"
          },
          {
            "title": "Question: Inequality with text values",
            "id": 91828,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Che cosa c'è che non va in questa query?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" daily\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" flights\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" destination &lt;&gt; \" /><text value=\"'Paris'\" class=\"string\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Non c'è nulla di sbagliato nella query</item><item value=\"2\" correct=\"false\">Non possiamo usare <code>&lt;&gt;</code> con valori di testo come <code>'Paris'</code></item><item value=\"3\" correct=\"false\">Dobbiamo sempre selezionare tutte le colonne con <code>*</code></item></selection><p visible-if=\"wrong\">Non c'è nulla di sbagliato nella query.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Un volo va a <code>'Paris'</code> con <code>daily = 2</code>, un altro va a <code>'Rome'</code> con <code>daily = 3</code>.</p><p>Cosa restituisce questa query dalle due righe?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" daily\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" flights\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" destination &lt;&gt; \" /><text value=\"'Paris'\" class=\"string\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Solo il valore daily 3.</item><item value=\"2\" correct=\"false\">Solo la destinazione Rome.</item><item value=\"3\" correct=\"false\">I valori daily 2 e 3.</item><item value=\"4\" correct=\"false\">Solo il valore daily 2.</item></selection><p visible-if=\"wrong\">Solo il valore daily 3.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Inequality with text values",
            "id": 91833,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Scrivi <code>WHERE</code> e una condizione che verifichi se la proprietà <code>destination</code> non è uguale a <code>'Paris'</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE flights (&#xA;destination varchar(255),&#xA;daily int&#xA;);&#xA;&#xA;INSERT INTO flights (destination, daily)&#xA;VALUES ('New York', 1);&#xA;INSERT INTO flights (destination, daily)&#xA;VALUES ('Paris', 3);&#xA;INSERT INTO flights (destination, daily)&#xA;VALUES ('Hong Kong', 1);&#xA;INSERT INTO flights (destination, daily)&#xA;VALUES ('Rome', 3);\"><tables><table name=\"flights\"><row><header content=\"destination\" /><header content=\"daily\" /></row><row><data content=\"New York\" /><data content=\"1\" /></row><row><data content=\"Paris\" /><data content=\"3\" /></row><row><data content=\"Hong Kong\" /><data content=\"1\" /></row><row><data content=\"Rome\" /><data content=\"3\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" flights\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" destination &lt;&gt; \" /><text value=\"'Paris'\" class=\"string\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"22\" endIndex=\"50\" /></interactions><output><table name=\"Result\"><row><header content=\"destination\" /><header content=\"daily\" /></row><row><data content=\"New York\" /><data content=\"1\" /></row><row><data content=\"Hong Kong\" /><data content=\"1\" /></row><row><data content=\"Rome\" /><data content=\"3\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>WHERE destination &lt;&gt; 'Paris'</code>.</p></body></html>"
          },
          {
            "title": "Question: Greater than operator",
            "id": 91838,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quale query seleziona gli elementi in cui <code>games_won</code> è maggiore di <code>1000</code>?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" chess_players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" games_won &lt; \" /><text value=\"1000\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" chess_players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" games_won &gt; \" /><text value=\"1000\" class=\"number\" /><text value=\";\" /><text type=\"break\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Il secondo</item><item value=\"2\" correct=\"false\">Il primo</item><item value=\"3\" correct=\"false\">Entrambi</item></selection><p visible-if=\"wrong\">Il secondo.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>In SQL, <code>&lt;</code> significa minore di e <code>&gt;</code> maggiore di.</p><p>Un giocatore ha esattamente <code>1000</code> vittorie. Quale query restituisce il giocatore?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" chess_players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" games_won &lt; \" /><text value=\"1000\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" chess_players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" games_won &gt; \" /><text value=\"1000\" class=\"number\" /><text value=\";\" /><text type=\"break\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Nessuna delle due query.</item><item value=\"2\" correct=\"false\">Solo la prima query.</item><item value=\"3\" correct=\"false\">Solo la seconda query.</item><item value=\"4\" correct=\"false\">Entrambe le query.</item></selection><p visible-if=\"wrong\">Nessuna delle due query.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example: Less than operator",
            "id": 91836,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Scrivi <code>WHERE</code>, seguito da una condizione che verifica se <code>games_won</code> è minore di <code>1000</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE chess_players (&#xA;name varchar(255),&#xA;games_won int&#xA;);&#xA;&#xA;INSERT INTO chess_players (name, games_won)&#xA;VALUES ('Carlsen', 1162);&#xA;INSERT INTO chess_players (name, games_won)&#xA;VALUES ('Kasparov', 1370);&#xA;INSERT INTO chess_players (name, games_won)&#xA;VALUES ('Polgár', 692);&#xA;INSERT INTO chess_players (name, games_won)&#xA;VALUES ('Fischer', 546);\"><tables><table name=\"chess_players\"><row><header content=\"name\" /><header content=\"games_won\" /></row><row><data content=\"Carlsen\" /><data content=\"1162\" /></row><row><data content=\"Kasparov\" /><data content=\"1370\" /></row><row><data content=\"Polgár\" /><data content=\"692\" /></row><row><data content=\"Fischer\" /><data content=\"546\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" chess_players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" games_won &lt; \" /><text value=\"1000\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"28\" endIndex=\"50\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"games_won\" /></row><row><data content=\"Polgár\" /><data content=\"692\" /></row><row><data content=\"Fischer\" /><data content=\"546\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>WHERE games_won &lt; 1000</code>.</p></body></html>"
          },
          {
            "title": "Question: The <= operator",
            "id": 91835,
