            "id": 52870,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Anche se l'array <code>tasks</code> è vuoto, <code>tasks.length</code> ci restituisce il numero di elementi che contiene.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" tasks = [];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(tasks.length);\" /></content><output><content><text value=\"0\" /></content></output></code></body></html>",
