            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Completa il ciclo for codificando <code>minutesWorked</code>.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" minutesWorked = [\" /><text value=\"123\" class=\"number\" /><text value=\", \" /><text value=\"100\" class=\"number\" /><text value=\", \" /><text value=\"99\" class=\"number\" /><text value=\", \" /><text value=\"67\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"for\" class=\"keyword\" /><text value=\" minutes \" /><text value=\"in\" class=\"keyword\" /><text value=\" minutesWorked {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"print\" class=\"built_in\" /><text value=\"(minutes - \" /><text value=\"60\" class=\"number\" /><text value=\")\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"55\" endIndex=\"68\" /></interactions><output><content><text value=\"63\" /><text type=\"break\" /><text value=\"40\" /><text type=\"break\" /><text value=\"39\" /><text type=\"break\" /><text value=\"7\" /></content></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>minutesWorked</code>.</p></body></html>"
