            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Che cosa visualizza questo codice nella console?</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"var\" class=\"keyword\" /><text value=\" firstName = \" /><text value=\"&quot;Lori&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"firstName = \" /><text value=\"&quot;Joe&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(firstName)\" /></content><output><content><text value=\"Joe\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>Joe</code></item><item value=\"2\" correct=\"false\"><code>Lori</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>Joe</code>.</p></body></html>"
