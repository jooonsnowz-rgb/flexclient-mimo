            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Che cosa c'è che non va in questo codice?</p><code name=\"main.swift\" version=\"2\" codelang=\"swift\"><content><text value=\"firstName = \" /><text value=\"&quot;Lori&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"firstName = \" /><text value=\"&quot;Joe&quot;\" class=\"string\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Nella prima riga manca la parola chiave <code>var</code></item><item value=\"2\" correct=\"false\">Niente</item></selection><p visible-if=\"wrong\">Nella prima riga manca la parola chiave <code>var</code>.</p></body></html>"
