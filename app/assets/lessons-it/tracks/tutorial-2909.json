            "interactiveContent": "<!DOCTYPE html ><html><body><p>Aggiungi un parametro di query chiamato <code>name</code> all'URL.</p><code version=\"2\" codelang=\"bash\" name=\"script.sh\" visible-if=\"always\"><content><text value=\"localhost:3000/greet?name=Maria\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"20\" endIndex=\"21\" /><option startIndex=\"21\" endIndex=\"25\" /><option startIndex=\"25\" endIndex=\"26\" /><option startIndex=\"26\" endIndex=\"31\" /></options></interaction></interactions></code><p visible-if=\"wrong\">Assicurati di scegliere <code>?</code>, seguito da <code>name</code> e poi <code>=</code>, <code>Maria</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Aggiungi un parametro di query chiamato <code>name</code> all'URL.</p><code version=\"2\" codelang=\"bash\" name=\"script.sh\" visible-if=\"always\"><content><text value=\"localhost:3000/greet?name=Maria\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"20\" endIndex=\"21\" /><option startIndex=\"21\" endIndex=\"25\" /><option startIndex=\"25\" endIndex=\"26\" /><option startIndex=\"26\" endIndex=\"31\" /><option correct=\"false\"><content><text value=\"3000\" /></content></option><option correct=\"false\"><content><text value=\"localhost\" /></content></option><option correct=\"false\"><content><text value=\"greet\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Assicurati di scegliere <code>?</code>, seguito da <code>name</code>, <code>=</code> e infine <code>Maria</code>.</p></body></html>"
