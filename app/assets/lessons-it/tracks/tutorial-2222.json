            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Che cosa visualizza questo codice?</p><code version=\"2\" codelang=\"css\" name=\"style.css\" visible-if=\"always\"><content><text value=\"button\" class=\"selector-tag\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"position\" class=\"attribute\" /><text value=\": absolute;\" /><text type=\"break\" /><text value=\" \" /><text value=\"left\" class=\"attribute\" /><text value=\": \" /><text value=\"10px\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Un pulsante a <code>10px</code> dal lato sinistro della pagina web</item><item value=\"2\" correct=\"false\">Un pulsante nella sua posizione originale</item><item value=\"3\" correct=\"false\">Un pulsante a <code>10px</code> dal lato destro della pagina web</item></selection><p visible-if=\"wrong\">Un pulsante a <code>10px</code> dal lato sinistro della pagina web.</p></body></html>",
