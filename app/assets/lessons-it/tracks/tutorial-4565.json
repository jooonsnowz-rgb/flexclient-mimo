reak\" /><text value=\"&lt;/\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /></content></code><p visible-if=\"wrong\">Assicurati di scegliere <code>&lt;p&gt;</code>, seguito da <code>&lt;/p&gt;</code>.</p></body></html>"
          },
          {
            "title": "Lesson #3",
            "id": 150190,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>L'elemento <code>p</code> è generico e non ha alcun significato specifico.</p><p>Impariamo alcuni elementi semantici che hanno un significato più specifico.</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"253\" endIndex=\"256\" /><option startIndex=\"256\" endIndex=\"258\" /><option startIndex=\"258\" endIndex=\"262\" /></options></interaction></interactions><content><text value=\"&lt;!DOCTYPE html&gt;\" class=\"meta\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Level Complete!\" /><text value=\"&lt;/\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text value=\"You defeated the boss and earned 1200 points.\" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Next round starts at 5:00 PM and the speed boost lasts 2m 30s.\" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Save point location:\" /><text type=\"break\" /><text value=\"    100 Main St.\" /><text type=\"break\" /><text value=\"    Austin, TX 78741\" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break