            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quale istruzione ordina i valori in una lista?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>sort()</code></item><item value=\"2\" correct=\"false\"><code>max()</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>sort()</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>I valori in <code>scores</code> non sono ordinati. Quale istruzione ordina la lista?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>scores.sort()</code></item><item value=\"2\" correct=\"false\"><code>max(scores)</code></item><item value=\"3\" correct=\"false\"><code>scores.append()</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>scores.sort()</code>.</p></body></html>"
