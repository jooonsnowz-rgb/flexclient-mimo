          {
            "title": "Closing tag",
            "id": 58994,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Aggiungi il tag di chiusura mancante.</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Welcome\" /><text value=\"&lt;/\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"11\" endIndex=\"16\" /><option correct=\"false\"><content><text value=\"&lt;\\h1&gt;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Assicurati di scegliere <code>&lt;/h1&gt;</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Usa tag di apertura e chiusura corrispondenti per inserire <code>Welcome</code> in un'intestazione <code>h1</code>.</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Welcome\" /><text value=\"&lt;/\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"4\" /><option startIndex=\"11\" endIndex=\"16\" /><option correct=\"false\"><content><text value=\"&lt;h2&gt;\" /></content></option><option correct=\"false\"><content><text value=\"&lt;\\h1&gt;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Assicurati di scegliere <code>&lt;h1&gt;</code>, seguito da <code>&lt;/h1&gt;</code>.</p></body></html>",
            "hardModeSelected": true
