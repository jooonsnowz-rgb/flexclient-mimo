            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Visualizza la variabile <code>color</code> di <code>pikachu</code> nella console scrivendo <code>pikachu.color</code>.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"Pokemon\" class=\"title\" /><text value=\" \" /><text value=\"{\" /><text type=\"break\" /><text value=\"  \" /><text value=\"let\" class=\"keyword\" /><text value=\" name = \" /><text value=\"&quot;pikachu&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"  \" /><text value=\"let\" class=\"keyword\" /><text value=\" color = \" /><text value=\"&quot;yellow&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"  \" /><text type=\"break\" /><text value=\"  \" /><text value=\"func\" class=\"keyword\" /><text value=\" \" /><text value=\"introduce\" class=\"title\" /><text value=\"()\" class=\"params\" /><text value=\" {\" /><text type=\"break\" /><text value=\"    \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Hi!&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"    \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;I am \\(self.name)&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"  }\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"let\" class=\"keyword\" /><text value=\" pikachu = \" /><text value=\"Pokemon\" class=\"type\" /><text value=\"()\" /><text type=\"break\" /><text value=\"pikachu.introduce()\" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(pikachu.color)\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"191\" endIndex=\"204\" /></interactions><output><content><text value=\"Hi!\" /><text type=\"break\" /><text value=\"I am pikachu\" /><text type=\"break\" /><text value=\"yellow\" /></content></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>pikachu.color</code>.</p></body></html>"
