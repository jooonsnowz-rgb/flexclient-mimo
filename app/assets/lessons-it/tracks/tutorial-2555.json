            "id": 127139,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Segna il codice che appartiene a queste funzioni.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"func\" class=\"keyword\" /><text value=\" \" /><text value=\"increaseBrightness\" class=\"title\" /><text value=\"()\" class=\"params\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Brightness up&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"func\" class=\"keyword\" /><text value=\" \" /><text value=\"decreaseBrightness\" class=\"title\" /><text value=\"()\" class=\"params\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Brightness down&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"increaseBrightness()\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"26\" endIndex=\"27\" /><option startIndex=\"52\" endIndex=\"53\" /><option startIndex=\"81\" endIndex=\"82\" /><option startIndex=\"109\" endIndex=\"110\" /><option correct=\"false\"><content><text value=\"func\" /></content></option></options></interaction></interactions><output><content><text value=\"Brightness up\" /></content></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>{</code>, seguito da <code>}</code> e poi <code>{</code>, <code>}</code>.</p></body></html>"
          },
