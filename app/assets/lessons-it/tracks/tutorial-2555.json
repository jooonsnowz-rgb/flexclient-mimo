            "id": 127152,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Restituisci la variabile da questa funzione.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\" \" /><text value=\"func\" class=\"keyword\" /><text value=\" \" /><text value=\"getBrightness\" class=\"title\" /><text value=\"()\" class=\"params\" /><text value=\" -&gt; \" /><text value=\"Int\" class=\"type\" /><text value=\" {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"let\" class=\"keyword\" /><text value=\" brightness = \" /><text value=\"67\" class=\"number\" /><text type=\"break\" /><text value=\"  \" /><text value=\"return\" class=\"keyword\" /><text value=\" brightness\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(getBrightness())\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"62\" endIndex=\"72\" /></interactions><output><content><text value=\"67\" /></content></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>brightness</code>.</p></body></html>"
