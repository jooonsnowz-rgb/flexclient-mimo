            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Aggiorna il secondo elemento con <code>\"Lee\"</code>.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"var\" class=\"keyword\" /><text value=\" missedCalls = [\" /><text value=\"&quot;Lou&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Zoe&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text value=\"missedCalls[\" /><text value=\"1\" class=\"number\" /><text value=\"] = \" /><text value=\"&quot;Lee&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(missedCalls)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"missedCalls[2]\" /></content></option><option correct=\"false\"><content><text value=\"&quot;Robert&quot;\" /></content></option><option startIndex=\"33\" endIndex=\"47\" /><option startIndex=\"48\" endIndex=\"49\" /><option startIndex=\"50\" endIndex=\"55\" /></options></interaction></interactions><output><content><text value=\"[&quot;Lou&quot;, &quot;Lee&quot;]\" /></content></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>missedCalls[1]</code>, seguito da <code>=</code> e infine <code>\"Lee\"</code>.</p></body></html>"
