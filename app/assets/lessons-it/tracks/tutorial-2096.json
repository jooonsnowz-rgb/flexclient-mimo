          {
            "title": "Recap: LEFT JOIN",
            "id": 118628,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Riepiloghiamo alcuni dei join che abbiamo imparato finora: LEFT JOIN e RIGHT JOIN.</p><p>LEFT JOIN seleziona tutte le righe dalla tabella a sinistra e le righe corrispondenti dalla tabella a destra.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE user ( &#xA;    id int, &#xA;    username varchar(50), &#xA;    followers int, &#xA;    following int &#xA;); &#xA; &#xA;CREATE TABLE blocked ( &#xA;    id int, &#xA;    reason varchar(50) &#xA;); &#xA; &#xA;INSERT INTO user(id, username, followers, following) &#xA;VALUES(123, &quot;John123&quot;, 123, 123); &#xA; &#xA;INSERT INTO user(id, username, followers, following) &#xA;VALUES(412, &quot;Stella24&quot;, 5120, 12); &#xA; &#xA;INSERT INTO user(id, username, followers, following) &#xA;VALUES(111, &quot;Starseed101&quot;, 223000, 5); &#xA; &#xA;INSERT INTO user(id, username, followers, following) &#xA;VALUES(378, &quot;AmGaming247&quot;, 599, 1023); &#xA; &#xA;INSERT INTO blocked(id, reason) &#xA;VALUES(111, &quot;Spamming&quot;); &#xA; &#xA;INSERT INTO blocked(id, reason) &#xA;VALUES(378, &quot;Misconduct&quot;); &#xA; &#xA;INSERT INTO blocked(id, reason) &#xA;VALUES(910, &quot;None&quot;);\"><tables><table name=\"user\"><row><header content=\"id\" /><header content=\"username\" /><header content=\"followers\" /><header content=\"following\" /></row><row><data content=\"123\" /><data content=\"John123\" /><data content=\"123\" /><data content=\"123\" /></row><row><data content=\"412\" /><data content=\"Stella24\" /><data content=\"5120\" /><data content=\"12\" /></row><row><data content=\"111\" /><data content=\"Starseed101\" /><data content=\"223000\" /><data content=\"5\" /></row><row><data content=\"378\" /><data content=\"AmGaming247\" /><data content=\"599\" /><data content=\"1023\" /></row></table><table name=\"blocked\"><row><header content=\"id\" /><header content=\"reason\" /></row><row><data content=\"111\" /><data content=\"Spamming\" /></row><row><data content=\"378\" /><data content=\"Misconduct\" /></row><row><data content=\"910\" /><data content=\"None\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" \" /><text value=\"user\" class=\"keyword\" /><text value=\" \" /><text type=\"break\" /><text value=\"LEFT\" class=\"keyword\" /><text value=\" \" /><text value=\"JOIN\" class=\"keyword\" /><text value=\" blocked \" /><text type=\"break\" /><text value=\"ON\" class=\"keyword\" /><text value=\" user.id = blocked.id;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"20\" endIndex=\"24\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"id\" /><header content=\"username\" /><header content=\"followers\" /><header content=\"following\" /><header content=\"id\" /><header content=\"reason\" /></row><row><data content=\"123\" /><data content=\"John123\" /><data content=\"123\" /><data content=\"123\" /><data content=\"\" /><data content=\"\" /></row><row><data content=\"412\" /><data content=\"Stella24\" /><data content=\"5120\" /><data content=\"12\" /><data content=\"\" /><data content=\"\" /></row><row><data content=\"111\" /><data content=\"Starseed101\" /><data content=\"223000\" /><data content=\"5\" /><data content=\"111\" /><data content=\"Spamming\" /></row><row><data content=\"378\" /><data content=\"AmGaming247\" /><data content=\"599\" /><data content=\"1023\" /><data content=\"378\" /><data content=\"Misconduct\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>LEFT</code>.</p></body></html>"
          },
          {
            "title": "Recap: RIGHT JOIN",
            "id": 118629,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>RIGHT JOIN seleziona tutte le righe dalla tabella destra e le righe corrispondenti dalla tabella sinistra.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE user ( &#xA;    id int, &#xA;    username varchar(50), &#xA;    followers int, &#xA;    following int &#xA;); &#xA; &#xA;CREATE TABLE blocked ( &#xA;    id int, &#xA;    reason varchar(50) &#xA;); &#xA; &#xA;INSERT INTO user(id, username, followers, following) &#xA;VALUES(123, &quot;John123&quot;, 123, 123); &#xA; &#xA;INSERT INTO user(id, username, followers, following) &#xA;VALUES(412, &quot;Stella24&quot;, 5120, 12); &#xA; &#xA;INSERT INTO user(id, username, followers, following) &#xA;VALUES(111, &quot;Starseed101&quot;, 223000, 5); &#xA; &#xA;INSERT INTO user(id, username, followers, following) &#xA;VALUES(378, &quot;AmGaming247&quot;, 599, 1023); &#xA; &#xA;INSERT INTO blocked(id, reason) &#xA;VALUES(111, &quot;Spamming&quot;); &#xA; &#xA;INSERT INTO blocked(id, reason) &#xA;VALUES(378, &quot;Misconduct&quot;); &#xA; &#xA;INSERT INTO blocked(id, reason) &#xA;VALUES(910, &quot;None&quot;);\"><tables><table name=\"user\"><row><header content=\"id\" /><header content=\"username\" /><header content=\"followers\" /><header content=\"following\" /></row><row><data content=\"123\" /><data content=\"John123\" /><data content=\"123\" /><data content=\"123\" /></row><row><data content=\"412\" /><data content=\"Stella24\" /><data content=\"5120\" /><data content=\"12\" /></row><row><data content=\"111\" /><data content=\"Starseed101\" /><data content=\"223000\" /><data content=\"5\" /></row><row><data content=\"378\" /><data content=\"AmGaming247\" /><data content=\"599\" /><data content=\"1023\" /></row></table><table name=\"blocked\"><row><header content=\"id\" /><header content=\"reason\" /></row><row><data content=\"111\" /><data content=\"Spamming\" /></row><row><data content=\"378\" /><data content=\"Misconduct\" /></row><row><data content=\"910\" /><data content=\"None\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" blocked \" /><text type=\"break\" /><text value=\"RIGHT\" class=\"keyword\" /><text value=\" \" /><text value=\"JOIN\" class=\"keyword\" /><text value=\" \" /><text value=\"user\" class=\"keyword\" /><text value=\" \" /><text type=\"break\" /><text value=\"ON\" class=\"keyword\" /><text value=\" user.id = blocked.id;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"23\" endIndex=\"28\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"id\" /><header content=\"reason\" /><header content=\"id\" /><header content=\"username\" /><header content=\"followers\" /><header content=\"following\" /></row><row><data content=\"111\" /><data content=\"Spamming\" /><data content=\"111\" /><data content=\"Starseed101\" /><data content=\"223000\" /><data content=\"5\" /></row><row><data content=\"378\" /><data content=\"Misconduct\" /><data content=\"378\" /><data content=\"AmGaming247\" /><data content=\"599\" /><data content=\"1023\" /></row><row><data content=\"\" /><data content=\"\" /><data content=\"123\" /><data content=\"John123\" /><data content=\"123\" /><data content=\"123\" /></row><row><data content=\"\" /><data content=\"\" /><data content=\"412\" /><data content=\"Stella24\" /><data content=\"5120\" /><data content=\"12\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>RIGHT</code>.</p></body></html>"
          },
          {
            "title": "FULL OUTER JOIN",
            "id": 118630,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>FULL OUTER JOIN</code> è una combinazione dei join LEFT e RIGHT.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE user ( &#xA;    id int, &#xA;    username varchar(50), &#xA;    followers int, &#xA;    following int &#xA;); &#xA; &#xA;CREATE TABLE blocked ( &#xA;    id int, &#xA;    reason varchar(50) &#xA;); &#xA; &#xA;INSERT INTO user(id, username, followers, following) &#xA;VALUES(123, &quot;John123&quot;, 123, 123); &#xA; &#xA;INSERT INTO user(id, username, followers, following) &#xA;VALUES(412, &quot;Stella24&quot;, 5120, 12); &#xA; &#xA;INSERT INTO user(id, username, followers, following) &#xA;VALUES(111, &quot;Starseed101&quot;, 223000, 5); &#xA; &#xA;INSERT INTO user(id, username, followers, following) &#xA;VALUES(378, &quot;AmGaming247&quot;, 599, 1023); &#xA; &#xA;INSERT INTO blocked(id, reason) &#xA;VALUES(111, &quot;Spamming&quot;); &#xA; &#xA;INSERT INTO blocked(id, reason) &#xA;VALUES(378, &quot;Misconduct&quot;); &#xA; &#xA;INSERT INTO blocked(id, reason) &#xA;VALUES(910, &quot;None&quot;);\"><tables><table name=\"user\"><row><header content=\"id\" /><header content=\"username\" /><header content=\"followers\" /><header content=\"following\" /></row><row><data content=\"123\" /><data content=\"John123\" /><data content=\"123\" /><data content=\"123\" /></row><row><data content=\"412\" /><data content=\"Stella24\" /><data content=\"5120\" /><data content=\"12\" /></row><row><data content=\"111\" /><data content=\"Starseed101\" /><data content=\"223000\" /><data content=\"5\" /></row><row><data content=\"378\" /><data content=\"AmGaming247\" /><data content=\"599\" /><data content=\"1023\" /></row></table><table name=\"blocked\"><row><header content=\"id\" /><header content=\"reason\" /></row><row><data content=\"111\" /><data content=\"Spamming\" /></row><row><data content=\"378\" /><data content=\"Misconduct\" /></row><row><data content=\"910\" /><data content=\"None\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" \" /><text value=\"user\" class=\"keyword\" /><text value=\" \" /><text type=\"break\" /><text value=\"FULL\" class=\"keyword\" /><text value=\" \" /><text value=\"OUTER\" class=\"keyword\" /><text value=\" \" /><text value=\"JOIN\" class=\"keyword\" /><text value=\" blocked \" /><text type=\"break\" /><text value=\"ON\" class=\"keyword\" /><text value=\" blocked.id = user.id;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"20\" endIndex=\"24\" /><option startIndex=\"25\" endIndex=\"30\" /><option startIndex=\"31\" endIndex=\"35\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"id\" /><header content=\"username\" /><header content=\"followers\" /><header content=\"following\" /><header content=\"id\" /><header content=\"reason\" /></row><row><data content=\"123\" /><data content=\"John123\" /><data content=\"123\" /><data content=\"123\" /><data content=\"\" /><data content=\"\" /></row><row><data content=\"412\" /><data content=\"Stella24\" /><data content=\"5120\" /><data content=\"12\" /><data content=\"\" /><data content=\"\" /></row><row><data content=\"111\" /><data content=\"Starseed101\" /><data content=\"223000\" /><data content=\"5\" /><data content=\"111\" /><data content=\"Spamming\" /></row><row><data content=\"378\" /><data content=\"AmGaming247\" /><data content=\"599\" /><data content=\"1023\" /><data content=\"378\" /><data content=\"Misconduct\" /></row><row><data content=\"\" /><data content=\"\" /><data content=\"\" /><data content=\"\" /><data content=\"910\" /><data content=\"None\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>FULL</code>, seguito da <code>OUTER</code> e infine <code>JOIN</code>.</p></body></html>"
          },
          {
            "title": "FULL OUTER JOIN 2",
            "id": 118631,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>FULL OUTER JOIN</code> restituisce una tabella con tutte le righe delle tabelle a sinistra e a destra, incluse quelle che corrispondono e quelle che non corrispondono.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE user ( &#xA;    id int, &#xA;    username varchar(50), &#xA;    followers int, &#xA;    following int &#xA;); &#xA; &#xA;CREATE TABLE blocked ( &#xA;    id int, &#xA;    reason varchar(50) &#xA;); &#xA; &#xA;INSERT INTO user(id, username, followers, following) &#xA;VALUES(123, &quot;John123&quot;, 123, 123); &#xA; &#xA;INSERT INTO user(id, username, followers, following) &#xA;VALUES(412, &quot;Stella24&quot;, 5120, 12); &#xA; &#xA;INSERT INTO user(id, username, followers, following) &#xA;VALUES(111, &quot;Starseed101&quot;, 223000, 5); &#xA; &#xA;INSERT INTO user(id, username, followers, following) &#xA;VALUES(378, &quot;AmGaming247&quot;, 599, 1023); &#xA; &#xA;INSERT INTO blocked(id, reason) &#xA;VALUES(111, &quot;Spamming&quot;); &#xA; &#xA;INSERT INTO blocked(id, reason) &#xA;VALUES(378, &quot;Misconduct&quot;); &#xA; &#xA;INSERT INTO blocked(id, reason) &#xA;VALUES(910, &quot;None&quot;);\"><tables><table name=\"user\"><row><header content=\"id\" /><header content=\"username\" /><header content=\"followers\" /><header content=\"following\" /></row><row><data content=\"123\" /><data content=\"John123\" /><data content=\"123\" /><data content=\"123\" /></row><row><data content=\"412\" /><data content=\"Stella24\" /><data content=\"5120\" /><data content=\"12\" /></row><row><data content=\"111\" /><data content=\"Starseed101\" /><data content=\"223000\" /><data content=\"5\" /></row><row><data content=\"378\" /><data content=\"AmGaming247\" /><data content=\"599\" /><data content=\"1023\" /></row></table><table name=\"blocked\"><row><header content=\"id\" /><header content=\"reason\" /></row><row><data content=\"111\" /><data content=\"Spamming\" /></row><row><data content=\"378\" /><data content=\"Misconduct\" /></row><row><data content=\"910\" /><data content=\"None\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" \" /><text value=\"user\" class=\"keyword\" /><text value=\" \" /><text type=\"break\" /><text value=\"FULL\" class=\"keyword\" /><text value=\" \" /><text value=\"OUTER\" class=\"keyword\" /><text value=\" \" /><text value=\"JOIN\" class=\"keyword\" /><text value=\" blocked \" /><text type=\"break\" /><text value=\"ON\" class=\"keyword\" /><text value=\" user.id = blocked.id;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"20\" endIndex=\"35\" /></interactions><output><table name=\"Result\"><row><header content=\"id\" /><header content=\"username\" /><header content=\"followers\" /><header content=\"following\" /><header content=\"id\" /><header content=\"reason\" /></row><row><data content=\"123\" /><data content=\"John123\" /><data content=\"123\" /><data content=\"123\" /><data content=\"\" /><data content=\"\" /></row><row><data content=\"412\" /><data content=\"Stella24\" /><data content=\"5120\" /><data content=\"12\" /><data content=\"\" /><data content=\"\" /></row><row><data content=\"111\" /><data content=\"Starseed101\" /><data content=\"223000\" /><data content=\"5\" /><data content=\"111\" /><data content=\"Spamming\" /></row><row><data content=\"378\" /><data content=\"AmGaming247\" /><data content=\"599\" /><data content=\"1023\" /><data content=\"378\" /><data content=\"Misconduct\" /></row><row><data content=\"\" /><data content=\"\" /><data content=\"\" /><data content=\"\" /><data content=\"910\" /><data content=\"None\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>FULL OUTER JOIN</code>.</p></body></html>"
          },
          {
            "title": "Left and right tables",
            "id": 118632,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Indipendentemente da quale tabella chiamiamo sinistra o destra, la tabella dei risultati rimane la stessa. Cambia solo l'ordine delle colonne.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE user ( &#xA;    id int, &#xA;    username varchar(50), &#xA;    followers int, &#xA;    following int &#xA;); &#xA; &#xA;CREATE TABLE blocked ( &#xA;    id int, &#xA;    reason varchar(50) &#xA;); &#xA; &#xA;INSERT INTO user(id, username, followers, following) &#xA;VALUES(123, &quot;John123&quot;, 123, 123); &#xA; &#xA;INSERT INTO user(id, username, followers, following) &#xA;VALUES(412, &quot;Stella24&quot;, 5120, 12); &#xA; &#xA;INSERT INTO user(id, username, followers, following) &#xA;VALUES(111, &quot;Starseed101&quot;, 223000, 5); &#xA; &#xA;INSERT INTO user(id, username, followers, following) &#xA;VALUES(378, &quot;AmGaming247&quot;, 599, 1023); &#xA; &#xA;INSERT INTO blocked(id, reason) &#xA;VALUES(111, &quot;Spamming&quot;); &#xA; &#xA;INSERT INTO blocked(id, reason) &#xA;VALUES(378, &quot;Misconduct&quot;); &#xA; &#xA;INSERT INTO blocked(id, reason) &#xA;VALUES(910, &quot;None&quot;);\"><tables><table name=\"user\"><row><header content=\"id\" /><header content=\"username\" /><header content=\"followers\" /><header content=\"following\" /></row><row><data content=\"123\" /><data content=\"John123\" /><data content=\"123\" /><data content=\"123\" /></row><row><data content=\"412\" /><data content=\"Stella24\" /><data content=\"5120\" /><data content=\"12\" /></row><row><data content=\"111\" /><data content=\"Starseed101\" /><data content=\"223000\" /><data content=\"5\" /></row><row><data content=\"378\" /><data content=\"AmGaming247\" /><data content=\"599\" /><data content=\"1023\" /></row></table><table name=\"blocked\"><row><header content=\"id\" /><header content=\"reason\" /></row><row><data content=\"111\" /><data content=\"Spamming\" /></row><row><data content=\"378\" /><data content=\"Misconduct\" /></row><row><data content=\"910\" /><data content=\"None\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" blocked \" /><text type=\"break\" /><text value=\"FULL\" class=\"keyword\" /><text value=\" \" /><text value=\"OUTER\" class=\"keyword\" /><text value=\" \" /><text value=\"JOIN\" class=\"keyword\" /><text value=\" \" /><text value=\"user\" class=\"keyword\" /><text value=\" \" /><text type=\"break\" /><text value=\"ON\" class=\"keyword\" /><text value=\" user.id = blocked.id;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"39\" endIndex=\"43\" /></interactions><output><table name=\"Result\"><row><header content=\"id\" /><header content=\"reason\" /><header content=\"id\" /><header content=\"username\" /><header content=\"followers\" /><header content=\"following\" /></row><row><data content=\"111\" /><data content=\"Spamming\" /><data content=\"111\" /><data content=\"Starseed101\" /><data content=\"223000\" /><data content=\"5\" /></row><row><data content=\"378\" /><data content=\"Misconduct\" /><data content=\"378\" /><data content=\"AmGaming247\" /><data content=\"599\" /><data content=\"1023\" /></row><row><data content=\"910\" /><data content=\"None\" /><data content=\"\" /><data content=\"\" /><data content=\"\" /><data content=\"\" /></row><row><data content=\"\" /><data content=\"\" /><data content=\"123\" /><data content=\"John123\" /><data content=\"123\" /><data content=\"123\" /></row><row><data content=\"\" /><data content=\"\" /><data content=\"412\" /><data content=\"Stella24\" /><data content=\"5120\" /><data content=\"12\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>user</code>.</p></body></html>"
          },
          {
            "title": "Question 1",
            "id": 118634,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Indovina il join: la tabella dei risultati mostra solo le righe corrispondenti della tabella a sinistra e tutte le righe della tabella a destra.</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"false\"><code>LEFT JOIN</code></item><item value=\"2\" correct=\"true\"><code>RIGHT JOIN</code></item></selection><p visible-if=\"wrong\"><code>RIGHT JOIN</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Il risultato mantiene ogni riga della tabella di destra, incluse quelle senza corrispondenza a sinistra. Quale join l'ha prodotto?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>RIGHT JOIN</code></item><item value=\"2\" correct=\"false\"><code>LEFT JOIN</code></item><item value=\"3\" correct=\"false\"><code>INNER JOIN</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>RIGHT JOIN</code>.</p></body></html>"
          },
          {
            "title": "Question 2",
            "id": 118635,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Seleziona l'affermazione vera per un <code>FULL OUTER JOIN</code>.</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>FULL OUTER JOIN</code> è una combinazione di join sinistri e destri</item><item value=\"2\" correct=\"false\"><code>FULL OUTER JOIN</code> mostra solo le righe corrispondenti</item></selection><p visible-if=\"wrong\"><code>FULL OUTER JOIN</code> è una combinazione di join sinistri e destri.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Due tabelle hanno alcune righe non corrispondenti. Quale join mantiene le corrispondenze e le righe non corrispondenti di entrambe le tabelle?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>FULL OUTER JOIN</code></item><item value=\"2\" correct=\"false\"><code>INNER JOIN</code></item><item value=\"3\" correct=\"false\">Solo <code>LEFT JOIN</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>FULL OUTER JOIN</code>.</p></body></html>"
          },
          {
            "title": "Question 3",
            "id": 118636,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Che cosa fa un <code>FULL OUTER JOIN</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Restituisce una tabella con righe corrispondenti e non corrispondenti</item><item value=\"2\" correct=\"false\">Restituisce una tabella con le righe corrispondenti</item></selection><p visible-if=\"wrong\">Restituisce una tabella con righe corrispondenti e non corrispondenti.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Una query deve mantenere le righe corrispondenti e quelle senza corrispondenza di entrambe le tabelle. Che cosa usa?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Un <code>FULL OUTER JOIN</code></item><item value=\"2\" correct=\"false\">Un <code>INNER JOIN</code></item><item value=\"3\" correct=\"false\">Una join che restituisce solo le righe della tabella di sinistra</item></selection><p visible-if=\"wrong\">Assicurati di scegliere Un <code>FULL OUTER JOIN</code>.</p></body></html>"
          },
          {
            "title": "Question 4",
            "id": 118638,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>In che modo un <code>INNER JOIN</code> è diverso da un <code>FULL OUTER JOIN</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>INNER JOIN</code> mostra solo le righe corrispondenti di entrambe le tabelle</item><item value=\"2\" correct=\"false\"><code>INNER JOIN</code> mostra sia le righe corrispondenti sia quelle non corrispondenti</item></selection><p visible-if=\"wrong\"><code>INNER JOIN</code> mostra solo le righe corrispondenti di entrambe le tabelle.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Una riga non ha corrispondenze nell'altra tabella. Quale affermazione confronta correttamente <code>INNER JOIN</code> e <code>FULL OUTER JOIN</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">La inner join la omette, mentre la full outer join la mantiene</item><item value=\"2\" correct=\"false\">Entrambe le join la mantengono</item><item value=\"3\" correct=\"false\">Solo la inner join la mantiene</item></selection><p visible-if=\"wrong\">La inner join la omette, mentre la full outer join la mantiene.</p></body></html>"
          },
          {
            "title": " Example 1",
            "id": 118642,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Completa gli spazi vuoti con un join che produca una tabella dei risultati che sia una combinazione dei join sinistro e destro.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE booking_requests( &#xA; client_name varchar(255), &#xA; client_destination varchar(255) &#xA;); &#xA; &#xA;CREATE TABLE hotels( &#xA; name varchar(255), &#xA; location varchar(255) &#xA;); &#xA; &#xA;INSERT INTO hotels(name, location) &#xA;VALUES(&quot;Hotel Myx&quot;, &quot;Paris&quot;); &#xA; &#xA;INSERT INTO hotels(name, location) &#xA;VALUES(&quot;Backpackers Hotel&quot;, &quot;Chicago&quot;); &#xA; &#xA;INSERT INTO hotels(name, location) &#xA;VALUES(&quot;Hotel Paradise&quot;, &quot;Istanbul&quot;); &#xA; &#xA;INSERT INTO booking_requests(client_name, client_destination) &#xA;VALUES(&quot;Dan&quot;, &quot;Paris&quot;); &#xA; &#xA;INSERT INTO booking_requests(client_name, client_destination) &#xA;VALUES(&quot;Samira&quot;, &quot;Chicago&quot;); &#xA; &#xA;INSERT INTO booking_requests(client_name, client_destination) &#xA;VALUES(&quot;Misha&quot;, &quot;Paris&quot;); &#xA; &#xA;INSERT INTO booking_requests(client_name, client_destination) &#xA;VALUES(&quot;Alice&quot;, &quot;Hong Kong&quot;);\"><tables><table name=\"booking_requests\"><row><header content=\"client_name\" /><header content=\"client_destination\" /></row><row><data content=\"Dan\" /><data content=\"Paris\" /></row><row><data content=\"Samira\" /><data content=\"Chicago\" /></row><row><data content=\"Misha\" /><data content=\"Paris\" /></row><row><data content=\"Alice\" /><data content=\"Hong Kong\" /></row></table><table name=\"hotels\"><row><header content=\"name\" /><header content=\"location\" /></row><row><data content=\"Hotel Myx\" /><data content=\"Paris\" /></row><row><data content=\"Backpackers Hotel\" /><data content=\"Chicago\" /></row><row><data content=\"Hotel Paradise\" /><data content=\"Istanbul\" /></row></table></tables></datab