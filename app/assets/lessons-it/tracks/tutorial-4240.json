            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>A cosa servono i link?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Collega le pagine dei giochi ad altre pagine e siti web</item><item value=\"2\" correct=\"false\">Aumenta la salute del giocatore</item></selection><p visible-if=\"wrong\">Collega le pagine dei giochi ad altre pagine e siti web.</p></body></html>"
