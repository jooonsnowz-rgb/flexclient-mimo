content=\"title\" /><header content=\"director_id\" /><header content=\"director_id\" /><header content=\"name\" /></row><row><data content=\"The Pianist\" /><data content=\"2\" /><data content=\"2\" /><data content=\"Polanski\" /></row><row><data content=\"Macbeth\" /><data content=\"2\" /><data content=\"2\" /><data content=\"Polanski\" /></row><row><data content=\"Somewhere\" /><data content=\"1\" /><data content=\"1\" /><data content=\"Coppola\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>3, Kurosawa</code> da <code>director</code>, perché non ha alcuna voce corrispondente in <code>movie</code></item><item value=\"2\" correct=\"false\"><code>2, Polanski</code> da <code>director</code>, perché ha due voci corrispondenti in <code>movie</code></item><item value=\"3\" correct=\"false\"><code>Somewhere, 1</code> da <code>movies</code>, perché non ha un regista corrispondente</item></selection><p visible-if=\"wrong\"><code>3, Kurosawa</code> da <code>director</code>, perché non ha alcuna voce corrispondente in <code>movie</code>.</p></body></html>"
