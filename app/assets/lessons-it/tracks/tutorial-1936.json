          {
            "title": "Intro",
            "id": 113835,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Abbiamo usato le sottoquery per selezionare una riga e una colonna. Come questa sottoquery che seleziona il <code>total</code> dell'ordine più alto.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE orders (&#xA;  customer_id int(11),&#xA;  orderDate varchar(50),&#xA;  total int(11) &#xA;);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (1,'1/20/2022',300.43);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (3,'1/01/2022',101.23);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (7,'1/02/2022',25.03);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (7,'2/02/2022',525.03);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (8,'1/01/2022',101.23);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (9,'1/02/2022',25.03);\"><tables><table name=\"orders\"><row><header content=\"customer_id\" /><header content=\"orderDate\" /><header content=\"total\" /></row><row><data content=\"1\" /><data content=\"1/20/2022\" /><data content=\"300.43\" /></row><row><data content=\"3\" /><data content=\"1/01/2022\" /><data content=\"101.23\" /></row><row><data content=\"7\" /><data content=\"1/02/2022\" /><data content=\"25.03\" /></row><row><data content=\"7\" /><data content=\"2/02/2022\" /><data content=\"525.03\" /></row><row><data content=\"8\" /><data content=\"1/01/2022\" /><data content=\"101.23\" /></row><row><data content=\"9\" /><data content=\"1/02/2022\" /><data content=\"25.03\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" customer_id \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" orders\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" total = \" /><text type=\"break\" /><text value=\"(\" /><text type=\"break\" /><text value=\" \" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"MAX\" class=\"keyword\" /><text value=\"(total) \" /><text type=\"break\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" orders\" /><text type=\"break\" /><text value=\");\" /><text type=\"break\" /><text type=\"break\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"50\" endIndex=\"56\" /><option startIndex=\"57\" endIndex=\"67\" /><option startIndex=\"70\" endIndex=\"74\" /><option startIndex=\"75\" endIndex=\"81\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"customer_id\" /></row><row><data content=\"7\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>SELECT</code>, seguito da <code>MAX(total)</code> e poi <code>FROM</code>, <code>orders</code>.</p></body></html>"
          },
          {
            "title": "Subquery",
            "id": 113837,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Come le query, anche le sottoquery possono restituire diverse righe. Ecco un'anteprima.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE customers (&#xA;  id int(11),&#xA;  first_name varchar(50),&#xA;  last_name varchar(50),&#xA;  email varchar(50)&#xA;);&#xA;&#xA;&#xA;CREATE TABLE orders (&#xA;  customer_id int(11),&#xA;  orderDate varchar(50),&#xA;  total int(11) &#xA;);&#xA;&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (1,'1/20/2022',300.43);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (3,'1/01/2022',101.23);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (7,'1/02/2022',25.03);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (7,'2/02/2022',525.03);&#xA;&#xA;&#xA;&#xA;&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (1,'James','Butt','jbutt@gmail.com');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (2,'Josephine','Darakjy','josephine_darakjy@darakjy.org');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (4,'Lenna','Paprocki','lpaprocki@hotmail.com');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (5,'Artie','Foller','donette.foller@cox.net');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (6,'Artie','Morasca','simona@morasca.com');&#xA;&#xA;&#xA;\"><tables><table name=\"customers\"><row><header content=\"id\" /><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"1\" /><data content=\"James\" /><data content=\"Butt\" /><data content=\"jbutt@gmail.com\" /></row><row><data content=\"2\" /><data content=\"Josephine\" /><data content=\"Darakjy\" /><data content=\"josephine_darakjy@darakjy.org\" /></row><row><data content=\"4\" /><data content=\"Lenna\" /><data content=\"Paprocki\" /><data content=\"lpaprocki@hotmail.com\" /></row><row><data content=\"5\" /><data content=\"Artie\" /><data content=\"Foller\" /><data content=\"donette.foller@cox.net\" /></row><row><data content=\"6\" /><data content=\"Artie\" /><data content=\"Morasca\" /><data content=\"simona@morasca.com\" /></row></table><table name=\"orders\"><row><header content=\"customer_id\" /><header content=\"orderDate\" /><header content=\"total\" /></row><row><data content=\"1\" /><data content=\"1/20/2022\" /><data content=\"300.43\" /></row><row><data content=\"3\" /><data content=\"1/01/2022\" /><data content=\"101.23\" /></row><row><data content=\"7\" /><data content=\"1/02/2022\" /><data content=\"25.03\" /></row><row><data content=\"7\" /><data content=\"2/02/2022\" /><data content=\"525.03\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" first_name, last_name\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" customers\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" customers.id \" /><text value=\"IN\" class=\"keyword\" /><text value=\" \" /><text type=\"break\" /><text value=\"(\" /><text type=\"break\" /><text value=\" \" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" customer_id \" /><text type=\"break\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" orders\" /><text type=\"break\" /><text value=\");\" /><text type=\"break\" /><text type=\"break\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"70\" endIndex=\"88\" /><option startIndex=\"91\" endIndex=\"102\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"first_name\" /><header content=\"last_name\" /></row><row><data content=\"James\" /><data content=\"Butt\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>SELECT customer_id</code>, seguito da <code>FROM orders</code>.</p></body></html>"
          },
          {
            "title": "Subquery 2",
            "id": 113840,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Questa query mostra i clienti che hanno effettuato ordini, selezionando solo quelli il cui ID compare nella tabella <code>orders</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE customers (&#xA;  id int(11),&#xA;  first_name varchar(50),&#xA;  last_name varchar(50),&#xA;  email varchar(50)&#xA;);&#xA;&#xA;&#xA;CREATE TABLE orders (&#xA;  customer_id int(11),&#xA;  orderDate varchar(50),&#xA;  total int(11) &#xA;);&#xA;&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (1,'1/20/2022',300.43);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (3,'1/01/2022',101.23);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (7,'1/02/2022',25.03);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (7,'2/02/2022',525.03);&#xA;&#xA;&#xA;&#xA;&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (1,'James','Butt','jbutt@gmail.com');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (2,'Josephine','Darakjy','josephine_darakjy@darakjy.org');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (4,'Lenna','Paprocki','lpaprocki@hotmail.com');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (5,'Artie','Foller','donette.foller@cox.net');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (6,'Artie','Morasca','simona@morasca.com');&#xA;&#xA;&#xA;\"><tables><table name=\"customers\"><row><header content=\"id\" /><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"1\" /><data content=\"James\" /><data content=\"Butt\" /><data content=\"jbutt@gmail.com\" /></row><row><data content=\"2\" /><data content=\"Josephine\" /><data content=\"Darakjy\" /><data content=\"josephine_darakjy@darakjy.org\" /></row><row><data content=\"4\" /><data content=\"Lenna\" /><data content=\"Paprocki\" /><data content=\"lpaprocki@hotmail.com\" /></row><row><data content=\"5\" /><data content=\"Artie\" /><data content=\"Foller\" /><data content=\"donette.foller@cox.net\" /></row><row><data content=\"6\" /><data content=\"Artie\" /><data content=\"Morasca\" /><data content=\"simona@morasca.com\" /></row></table><table name=\"orders\"><row><header content=\"customer_id\" /><header content=\"orderDate\" /><header content=\"total\" /></row><row><data content=\"1\" /><data content=\"1/20/2022\" /><data content=\"300.43\" /></row><row><data content=\"3\" /><data content=\"1/01/2022\" /><data content=\"101.23\" /></row><row><data content=\"7\" /><data content=\"1/02/2022\" /><data content=\"25.03\" /></row><row><data content=\"7\" /><data content=\"2/02/2022\" /><data content=\"525.03\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" first_name, last_name\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" customers\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" customers.id \" /><text value=\"IN\" class=\"keyword\" /><text value=\" \" /><text type=\"break\" /><text value=\"(\" /><text type=\"break\" /><text value=\" \" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" customer_id \" /><text type=\"break\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" orders\" /><text type=\"break\" /><text value=\");\" /><text type=\"break\" /><text type=\"break\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"50\" endIndex=\"65\" /><option startIndex=\"96\" endIndex=\"102\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"first_name\" /><header content=\"last_name\" /></row><row><data content=\"James\" /><data content=\"Butt\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>customers.id IN</code>, seguito da <code>orders</code>.</p></body></html>"
          },
          {
            "title": "Subquery 3",
            "id": 113841,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Per trovare i clienti il cui ID compare negli ordini, dobbiamo scrivere una query che selezioni tutti i valori di <code>customer_id</code> in <code>orders</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE customers (&#xA;  id int(11),&#xA;  first_name varchar(50),&#xA;  last_name varchar(50),&#xA;  email varchar(50)&#xA;);&#xA;&#xA;&#xA;CREATE TABLE orders (&#xA;  customer_id int(11),&#xA;  orderDate varchar(50),&#xA;  total int(11) &#xA;);&#xA;&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (1,'1/20/2022',300.43);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (3,'1/01/2022',101.23);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (7,'1/02/2022',25.03);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (7,'2/02/2022',525.03);&#xA;&#xA;&#xA;&#xA;&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (1,'James','Butt','jbutt@gmail.com');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (2,'Josephine','Darakjy','josephine_darakjy@darakjy.org');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (4,'Lenna','Paprocki','lpaprocki@hotmail.com');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (5,'Artie','Foller','donette.foller@cox.net');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (6,'Artie','Morasca','simona@morasca.com');&#xA;&#xA;&#xA;\"><tables><table name=\"customers\"><row><header content=\"id\" /><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"1\" /><data content=\"James\" /><data content=\"Butt\" /><data content=\"jbutt@gmail.com\" /></row><row><data content=\"2\" /><data content=\"Josephine\" /><data content=\"Darakjy\" /><data content=\"josephine_darakjy@darakjy.org\" /></row><row><data content=\"4\" /><data content=\"Lenna\" /><data content=\"Paprocki\" /><data content=\"lpaprocki@hotmail.com\" /></row><row><data content=\"5\" /><data content=\"Artie\" /><data content=\"Foller\" /><data content=\"donette.foller@cox.net\" /></row><row><data content=\"6\" /><data content=\"Artie\" /><data content=\"Morasca\" /><data content=\"simona@morasca.com\" /></row></table><table name=\"orders\"><row><header content=\"customer_id\" /><header content=\"orderDate\" /><header content=\"total\" /></row><row><data content=\"1\" /><data content=\"1/20/2022\" /><data content=\"300.43\" /></row><row><data content=\"3\" /><data content=\"1/01/2022\" /><data content=\"101.23\" /></row><row><data content=\"7\" /><data content=\"1/02/2022\" /><data content=\"25.03\" /></row><row><data content=\"7\" /><data content=\"2/02/2022\" /><data content=\"525.03\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" customer_id \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" orders;\" /><text type=\"break\" /><text type=\"break\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"18\" /><option startIndex=\"20\" endIndex=\"24\" /><option startIndex=\"25\" endIndex=\"31\" /><option startIndex=\"31\" endIndex=\"32\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"customer_id\" /></row><row><data content=\"1\" /></row><row><data content=\"3\" /></row><row><data content=\"7\" /></row><row><data content=\"7\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>SELECT</code>, seguito da <code>customer_id</code> e poi <code>FROM</code>, <code>orders</code>, <code>;</code>.</p></body></html>"
          },
          {
            "title": "Subquery 4",
            "id": 113842,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Nota che questa query non restituisce più un valore, ma un elenco di valori <code>customer_id</code>. Questa sarà la nostra sottoquery.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE customers (&#xA;  id int(11),&#xA;  first_name varchar(50),&#xA;  last_name varchar(50),&#xA;  email varchar(50)&#xA;);&#xA;&#xA;&#xA;CREATE TABLE orders (&#xA;  customer_id int(11),&#xA;  orderDate varchar(50),&#xA;  total int(11) &#xA;);&#xA;&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (1,'1/20/2022',300.43);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (3,'1/01/2022',101.23);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (7,'1/02/2022',25.03);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (7,'2/02/2022',525.03);&#xA;&#xA;&#xA;&#xA;&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (1,'James','Butt','jbutt@gmail.com');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (2,'Josephine','Darakjy','josephine_darakjy@darakjy.org');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (4,'Lenna','Paprocki','lpaprocki@hotmail.com');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (5,'Artie','Foller','donette.foller@cox.net');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (6,'Artie','Morasca','simona@morasca.com');&#xA;&#xA;&#xA;\"><tables><table name=\"customers\"><row><header content=\"id\" /><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"1\" /><data content=\"James\" /><data content=\"Butt\" /><data content=\"jbutt@gmail.com\" /></row><row><data content=\"2\" /><data content=\"Josephine\" /><data content=\"Darakjy\" /><data content=\"josephine_darakjy@darakjy.org\" /></row><row><data content=\"4\" /><data content=\"Lenna\" /><data content=\"Paprocki\" /><data content=\"lpaprocki@hotmail.com\" /></row><row><data content=\"5\" /><data content=\"Artie\" /><data content=\"Foller\" /><data content=\"donette.foller@cox.net\" /></row><row><data content=\"6\" /><data content=\"Artie\" /><data content=\"Morasca\" /><data content=\"simona@morasca.com\" /></row></table><table name=\"orders\"><row><header content=\"customer_id\" /><header content=\"orderDate\" /><header content=\"total\" /></row><row><data content=\"1\" /><data content=\"1/20/2022\" /><data content=\"300.43\" /></row><row><data content=\"3\" /><data content=\"1/01/2022\" /><data content=\"101.23\" /></row><row><data content=\"7\" /><data content=\"1/02/2022\" /><data content=\"25.03\" /></row><row><data content=\"7\" /><data content=\"2/02/2022\" /><data content=\"525.03\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" customer_id \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" orders;\" /><text type=\"break\" /><text type=\"break\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"7\" endIndex=\"18\" /></interactions><output><table name=\"Result\"><row><header content=\"customer_id\" /></row><row><data content=\"1\" /></row><row><data content=\"3\" /></row><row><data content=\"7\" /></row><row><data content=\"7\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>customer_id</code>.</p></body></html>"
          },
          {
            "title": "Subquery IN",
            "id": 113843,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Usiamo <code>IN</code> per selezionare i clienti con un ID presente nell'elenco di ID restituito dalla nostra sottoquery.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE customers (&#xA;  id int(11),&#xA;  first_name varchar(50),&#xA;  last_name varchar(50),&#xA;  email varchar(50)&#xA;);&#xA;&#xA;&#xA;CREATE TABLE orders (&#xA;  customer_id int(11),&#xA;  orderDate varchar(50),&#xA;  total int(11) &#xA;);&#xA;&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (1,'1/20/2022',300.43);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (3,'1/01/2022',101.23);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (7,'1/02/2022',25.03);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (7,'2/02/2022',525.03);&#xA;&#xA;&#xA;&#xA;&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (1,'James','Butt','jbutt@gmail.com');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (2,'Josephine','Darakjy','josephine_darakjy@darakjy.org');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (4,'Lenna','Paprocki','lpaprocki@hotmail.com');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (5,'Artie','Foller','donette.foller@cox.net');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (6,'Artie','Morasca','simona@morasca.com');&#xA;&#xA;&#xA;\"><tables><table name=\"customers\"><row><header content=\"id\" /><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"1\" /><data content=\"James\" /><data content=\"Butt\" /><data content=\"jbutt@gmail.com\" /></row><row><data content=\"2\" /><data content=\"Josephine\" /><data content=\"Darakjy\" /><data content=\"josephine_darakjy@darakjy.org\" /></row><row><data content=\"4\" /><data content=\"Lenna\" /><data content=\"Paprocki\" /><data content=\"lpaprocki@hotmail.com\" /></row><row><data content=\"5\" /><data content=\"Artie\" /><data content=\"Foller\" /><data content=\"donette.foller@cox.net\" /></row><row><data content=\"6\" /><data content=\"Artie\" /><data content=\"Morasca\" /><data content=\"simona@morasca.com\" /></row></table><table name=\"orders\"><row><header content=\"customer_id\" /><header content=\"orderDate\" /><header content=\"total\" /></row><row><data content=\"1\" /><data content=\"1/20/2022\" /><data content=\"300.43\" /></row><row><data content=\"3\" /><data content=\"1/01/2022\" /><data content=\"101.23\" /></row><row><data content=\"7\" /><data content=\"1/02/2022\" /><data content=\"25.03\" /></row><row><data content=\"7\" /><data content=\"2/02/2022\" /><data content=\"525.03\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" first_name, last_name\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" customers\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" customers.id \" /><text value=\"IN\" class=\"keyword\" /><text value=\" \" /><text type=\"break\" /><text value=\"(\" /><text type=\"break\" /><text value=\" \" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" customer_id \" /><text type=\"break\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" orders\" /><text type=\"break\" /><text value=\");\" /><text type=\"break\" /><text type=\"break\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"63\" endIndex=\"65\" /></interactions><output><table name=\"Result\"><row><header content=\"first_name\" /><header content=\"last_name\" /></row><row><data content=\"James\" /><data content=\"Butt\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>IN</code>.</p></body></html>"
          },
          {
            "title": "Subquery",
            "id": 113844,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Selezionando solo i clienti con un <code>customer_id</code> presente nella tabella degli ordini, otteniamo solo i clienti che hanno effettuato un ordine.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE customers (&#xA;  id int(11),&#xA;  first_name varchar(50),&#xA;  last_name varchar(50),&#xA;  email varchar(50)&#xA;);&#xA;&#xA;&#xA;CREATE TABLE orders (&#xA;  customer_id int(11),&#xA;  orderDate varchar(50),&#xA;  total int(11) &#xA;);&#xA;&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (1,'1/20/2022',300.43);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (3,'1/01/2022',101.23);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (7,'1/02/2022',25.03);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (7,'2/02/2022',525.03);&#xA;&#xA;&#xA;&#xA;&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (1,'James','Butt','jbutt@gmail.com');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (2,'Josephine','Darakjy','josephine_darakjy@darakjy.org');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (4,'Lenna','Paprocki','lpaprocki@hotmail.com');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (5,'Artie','Foller','donette.foller@cox.net');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (6,'Artie','Morasca','simona@morasca.com');&#xA;&#xA;&#xA;\"><tables><table name=\"customers\"><row><header content=\"id\" /><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"1\" /><data content=\"James\" /><data content=\"Butt\" /><data content=\"jbutt@gmail.com\" /></row><row><data content=\"2\" /><data content=\"Josephine\" /><data content=\"Darakjy\" /><data content=\"josephine_darakjy@darakjy.org\" /></row><row><data content=\"4\" /><data content=\"Lenna\" /><data content=\"Paprocki\" /><data content=\"lpaprocki@hotmail.com\" /></row><row><data content=\"5\" /><data content=\"Artie\" /><data content=\"Foller\" /><data content=\"donette.foller@cox.net\" /></row><row><data content=\"6\" /><data content=\"Artie\" /><data content=\"Morasca\" /><data content=\"simona@morasca.com\" /></row></table><table name=\"orders\"><row><header content=\"customer_id\" /><header content=\"orderDate\" /><header content=\"total\" /></row><row><data content=\"1\" /><data content=\"1/20/2022\" /><data content=\"300.43\" /></row><row><data content=\"3\" /><data content=\"1/01/2022\" /><data content=\"101.23\" /></row><row><data content=\"7\" /><data content=\"1/02/2022\" /><data content=\"25.03\" /></row><row><data content=\"7\" /><data content=\"2/02/2022\" /><data content=\"525.03\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" first_name, last_name\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" customers\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" customers.id \" /><text value=\"IN\" class=\"keyword\" /><text value=\" \" /><text type=\"break\" /><text value=\"(\" /><text type=\"break\" /><text value=\" \" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" customer_id \" /><text type=\"break\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" orders\" /><text type=\"break\" /><text value=\");\" /><text type=\"break\" /><text type=\"break\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"70\" endIndex=\"88\" /></interactions><output><table name=\"Result\"><row><header content=\"first_name\" /><header content=\"last_name\" /></row><row><data content=\"James\" /><data content=\"Butt\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>SELECT customer_id</code>.</p></body></html>"
          },
          {
            "title": "Multiple results",
            "id": 113834,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>È importante ricordare che <code>IN</code> funziona con le liste. La sottoquery può quindi restituire più righe, ma <em>solo</em> una colonna.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE customers (&#xA;  id int(11),&#xA;  first_name varchar(50),&#xA;  last_name varchar(50),&#xA;  email varchar(50)&#xA;);&#xA;&#xA;&#xA;CREATE TABLE orders (&#xA;  customer_id int(11),&#xA;  orderDate varchar(50),&#xA;  total int(11) &#xA;);&#xA;&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (1,'1/20/2022',300.43);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (3,'1/01/2022',101.23);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (7,'1/02/2022',25.03);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (7,'2/02/2022',525.03);&#xA;&#xA;&#xA;&#xA;&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (1,'James','Butt','jbutt@gmail.com');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (2,'Josephine','Darakjy','josephine_darakjy@darakjy.org');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (4,'Lenna','Paprocki','lpaprocki@hotmail.com');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (5,'Artie','Foller','donette.foller@cox.net');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (6,'Artie','Morasca','simona@morasca.com');&#xA;&#xA;&#xA;\"><tables><table name=\"customers\"><row><header content=\"id\" /><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"1\" /><data content=\"James\" /><data content=\"Butt\" /><data content=\"jbutt@gmail.com\" /></row><row><data content=\"2\" /><data content=\"Josephine\" /><data content=\"Darakjy\" /><data content=\"josephine_darakjy@darakjy.org\" /></row><row><data content=\"4\" /><data content=\"Lenna\" /><data content=\"Paprocki\" /><data content=\"lpaprocki@hotmail.com\" /></row><row><data content=\"5\" /><data content=\"Artie\" /><data content=\"Foller\" /><data content=\"donette.foller@cox.net\" /></row><row><data content=\"6\" /><data content=\"Artie\" /><data content=\"Morasca\" /><data content=\"simona@morasca.com\" /></row></table><table name=\"orders\"><row><header content=\"customer_id\" /><header content=\"orderDate\" /><header content=\"total\" /></row><row><data content=\"1\" /><data content=\"1/20/2022\" /><data content=\"300.43\" /></row><row><data content=\"3\" /><data content=\"1/01/2022\" /><data content=\"101.23\" /></row><row><data content=\"7\" /><data content=\"1/02/2022\" /><data content=\"25.03\" /></row><row><data content=\"7\" /><data content=\"2/02/2022\" /><data content=\"525.03\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" first_name, last_name\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" customers\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" customers.id \" /><text value=\"IN\" class=\"keyword\" /><text value=\" \" /><text type=\"break\" /><text value=\"(\" /><text type=\"break\" /><text value=\" \" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" customer_id \" /><text type=\"break\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" orders\" /><text type=\"break\" /><text value=\");\" /><text type=\"break\" /><text type=\"break\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"70\" endIndex=\"76\" /><option startIndex=\"77\" endIndex=\"88\" /><option startIndex=\"91\" endIndex=\"95\" /><option startIndex=\"96\" endIndex=\"102\" /><option startIndex=\"67\" endIndex=\"68\" /><option startIndex=\"103\" endIndex=\"104\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"first_name\" /><header content=\"last_name\" /></row><row><data content=\"James\" /><data content=\"Butt\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>(</code>, seguito da <code>SELECT</code> e poi <code>customer_id</code>, <code>FROM</code>, <code>orders</code>, <code>)</code>.</p></body></html>"
          },
          {
            "title": "Question: Subquery",
            "id": 113828,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quanti risultati può avere una sottoquery quando si usa <code>IN</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Zero o più</item><item value=\"2\" correct=\"false\">Solo uno</item></selection><p visible-if=\"wrong\">Zero o più.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Una subquery trova diversi ID reparto corrispondenti. Quale filtro può usare tutti gli ID restituiti?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>IN</code>, perché può confrontare zero o più valori restituiti</item><item value=\"2\" correct=\"false\"><code>=</code>, perché una subquery deve restituire esattamente un valore</item><item value=\"3\" correct=\"false\">Nessuno dei due operatori, perché una subquery non può restituire più righe</item></selection><p visible-if=\"wrong\"><code>IN</code>, perché può confrontare zero o più valori restituiti.</p></body></html>"
          },
          {
            "title": "Question: Subquery 2",
            "id": 113829,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Possiamo usare sottoquery che restituiscono più colonne nel filtro di una query con <code>IN</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">No, la sottoquery dovrebbe restituire valori appartenenti a una sola colonna</item><item value=\"2\" correct=\"false\">Sì, possiamo usare qualsiasi tipo di sottoquery</item></selection><p visible-if=\"wrong\">No, la sottoquery dovrebbe restituire valori appartenenti a una sola colonna.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Un filtro usa <code>IN</code> con una subquery che seleziona <code>id</code> e <code>name</code>. Che cosa deve cambiare?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Selezionare una sola colonna, come <code>id</code></item><item value=\"2\" correct=\"false\">Mantenere entrambe le colonne perché <code>IN</code> accetta una riga completa</item><item value=\"3\" correct=\"false\">Limitare la subquery a una riga mantenendo entrambe le colonne</item></selection><p visible-if=\"wrong\">Selezionare una sola colonna, come <code>id</code>.</p></body></html>"
          },
          {
            "title": "Question: Subquery IN",
            "id": 114319,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Che cosa seleziona questa query?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE student (&#xA; id varchar(255),&#xA; name varchar(255)&#xA;);&#xA;&#xA;INSERT INTO student (id, name)&#xA;VALUES ('0147', 'Lisa Jones');&#xA;INSERT INTO student (id, name)&#xA;VALUES ('1008', 'Luz Garcia');&#xA;INSERT INTO student (id, name)&#xA;VALUES ('0267', 'Lin Wong');&#xA;&#xA;&#xA;&#xA;CREATE TABLE enrolled (&#xA; id varchar(255),&#xA; class varchar(255)&#xA;);&#xA;&#xA;INSERT INTO enrolled (id, class)&#xA;VALUES ('0147', 'Math');&#xA;INSERT INTO enrolled (id, class)&#xA;VALUES ('1008', 'Physics');&#xA;&#xA;\"><tables><table name=\"student\"><row><header content=\"id\" /><header content=\"name\" /></row><row><data content=\"0147\" /><data content=\"Lisa Jones\" /></row><row><data content=\"1008\" /><data content=\"Luz Garcia\" /></row><row><data content=\"0267\" /><data content=\"Lin Wong\" /></row></table><table name=\"enrolled\"><row><header content=\"id\" /><header content=\"class\" /></row><row><data content=\"0147\" /><data content=\"Math\" /></row><row><data content=\"1008\" /><data content=\"Physics\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" student\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"id\" class=\"keyword\" /><text value=\" \" /><text value=\"NOT\" class=\"keyword\" /><text value=\" \" /><text value=\"IN\" class=\"keyword\" /><text type=\"break\" /><text value=\"(\" /><text type=\"break\" /><text value=\" \" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"id\" class=\"keyword\" /><text value=\" \" /><text type=\"break\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" enrolled\" /><text type=\"break\" /><text value=\");\" /></content><output><table name=\"Result\"><row><header content=\"id\" /><header content=\"name\" /></row><row><data content=\"0267\" /><data content=\"Lin Wong\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Gli studenti che non sono iscritti a un corso</item><item value=\"2\" correct=\"false\">Gli studenti iscritti a un corso</item><item value=\"3\" correct=\"false\">Tutte le classi esistenti</item></selection><p visible-if=\"wrong\">Gli studenti che non sono iscritti a un corso.</p></body></html>"
          },
          {
            "title": "Question: Multiple Results",
            "id": 114318,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Che cosa seleziona questa query?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE points(&#xA; name varchar(255),&#xA; alias varchar(255),&#xA; score int&#xA;);&#xA;&#xA;CREATE TABLE prizes(&#xA; score int,&#xA; prize varchar(255)&#xA;);&#xA;&#xA;INSERT INTO points(name, alias, score)&#xA;VALUES('Lucy', 'gaminglucy', 5);&#xA;&#xA;INSERT INTO points(name, alias, score)&#xA;VALUES('Henry', 'hengames', 3);&#xA;&#xA;INSERT INTO points(name, alias, score)&#xA;VALUES('Selene', 'selovesgames', 4);&#xA;&#xA;INSERT INTO points(name, alias, score)&#xA;VALUES('Anonymous', 'heretowin', 8);&#xA;&#xA;INSERT INTO prizes(score, prize)&#xA;VALUES(5, 'Pen');&#xA;&#xA;INSERT INTO prizes(score, prize)&#xA;VALUES(6, 'Badge');&#xA;&#xA;INSERT INTO prizes(score, prize)&#xA;VALUES(7, 'Trinket');&#xA;&#xA;INSERT INTO prizes(score, prize)&#xA;VALUES(8, 'Watch');&#xA;&#xA;INSERT INTO prizes(score, prize)&#xA;VALUES(8, 'Bag');\"><tables><table name=\"points\"><row><header content=\"name\" /><header content=\"alias\" /><header content=\"score\" /></row><row><data content=\"Lucy\" /><data content=\"gaminglucy\" /><data content=\"5\" /></row><row><data content=\"Henry\" /><data content=\"hengames\" /><data content=\"3\" /></row><row><data content=\"Selene\" /><data content=\"selovesgames\" /><data content=\"4\" /></row><row><data content=\"Anonymous\" /><data content=\"heretowin\" /><data content=\"8\" /></row></table><table name=\"prizes\"><row><header content=\"score\" /><header content=\"prize\" /></row><row><data content=\"5\" /><data content=\"Pen\" /></row><row><data content=\"6\" /><data content=\"Badge\" /></row><row><data content=\"7\" /><data content=\"Trinket\" /></row><row><data content=\"8\" /><data content=\"Watch\" /></row><row><data content=\"8\" /><data content=\"Bag\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" points \" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" score \" /><text value=\"IN\" class=\"keyword\" /><text type=\"break\" /><text value=\"(\" /><text type=\"break\" /><text value=\" \" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" score\" /><text type=\"break\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" prizes\" /><text type=\"break\" /><text value=\" \" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" prize = \" /><text value=\"'Pen'\" class=\"string\" /><text value=\" \" /><text value=\"OR\" class=\"keyword\" /><text value=\" prize = \" /><text value=\"'Watch'\" class=\"string\" /><text type=\"break\" /><text value=\");\" /></content><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"alias\" /><header content=\"score\" /></row><row><data content=\"Lucy\" /><data content=\"gaminglucy\" /><data content=\"5\" /></row><row><data content=\"Anonymous\" /><data content=\"heretowin\" /><data content=\"8\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Le persone che hanno vinto una penna o un orologio</item><item value=\"2\" correct=\"false\">Le persone che non vinceranno una penna o un orologio</item><item value=\"3\" correct=\"false\">Le persone che hanno vinto un premio</item></selection><p visible-if=\"wrong\">Le persone che hanno vinto una penna o un orologio.</p></body></html>"
          },
          {
