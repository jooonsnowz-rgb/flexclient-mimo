            "id": 113833,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Trova i dipendenti che si trovano in un dipartimento con un budget superiore a 2000.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE departments (&#xA; id int,&#xA; department_name VARCHAR (30) NOT NULL,&#xA; budget INT&#xA;);&#xA;&#xA;CREATE TABLE employees (&#xA; employee_id INT (11) ,&#xA; name VARCHAR (100) DEFAULT NULL,&#xA; department_id INT (11) DEFAULT NULL&#xA;);&#xA;INSERT INTO employees(employee_id,name,department_id) &#xA;VALUES (100,'Steven King',9),&#xA; (101,'Neena Kochhar',9),&#xA; (102,'Lex De Haan',1),&#xA; (103,'Alexander Hunold',2),&#xA; (104,'Bruce Ernst',6);&#xA;&#xA;&#xA;&#xA;INSERT INTO departments(id,department_name,budget) VALUES &#xA;(1,'Administration',4033),&#xA;(2,'Marketing',223), &#xA;(3,'Purchasing',7678), &#xA;(4,'Human Resources',2342);&#xA;&#xA;\"><tables><table name=\"departments\"><row><header content=\"id\" /><header content=\"department_name\" /><header content=\"budget\" /></row><row><data content=\"1\" /><data content=\"Administration\" /><data content=\"4033\" /></row><row><data content=\"2\" /><data content=\"Marketing\" /><data content=\"223\" /></row><row><data content=\"3\" /><data content=\"Purchasing\" /><data content=\"7678\" /></row><row><data content=\"4\" /><data content=\"Human Resources\" /><data content=\"2342\" /></row></table><table name=\"employees\"><row><header content=\"employee_id\" /><header content=\"name\" /><header content=\"department_id\" /></row><row><data content=\"100\" /><data content=\"Steven King\" /><data content=\"9\" /></row><row><data content=\"101\" /><data content=\"Neena Kochhar\" /><data content=\"9\" /></row><row><data content=\"102\" /><data content=\"Lex De Haan\" /><data content=\"1\" /></row><row><data content=\"103\" /><data content=\"Alexander Hunold\" /><data content=\"2\" /></row><row><data content=\"104\" /><data content=\"Bruce Ernst\" /><data content=\"6\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" employees\" /><text type=\"break\" /><text value=\"where\" class=\"keyword\" /><text value=\" department_id \" /><text value=\"IN\" class=\"keyword\" /><text value=\" \" /><text type=\"break\" /><text value=\"(\" /><text type=\"break\" /><text value=\" \" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"id\" class=\"keyword\" /><text type=\"break\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" departments\" /><text type=\"break\" /><text value=\" \" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" budget &gt; \" /><text value=\"2000\" class=\"number\" /><text type=\"break\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"48\" endIndex=\"49\" /><option startIndex=\"58\" endIndex=\"60\" /><option startIndex=\"67\" endIndex=\"78\" /><option startIndex=\"86\" endIndex=\"92\" /><option startIndex=\"100\" endIndex=\"101\" /><option startIndex=\"95\" endIndex=\"99\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"employee_id\" /><header content=\"name\" /><header content=\"department_id\" /></row><row><data content=\"102\" /><data content=\"Lex De Haan\" /><data content=\"1\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>(</code>, seguito da <code>id</code> e poi <code>departments</code>, <code>budget</code>, <code>2000</code>, <code>)</code>.</p></body></html>"
