            "id": 62862,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Salva il risultato di <code>points &gt;= 10</code> nella variabile <code>levelTwo</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" points = \" /><text value=\"12\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" levelTwo = points &gt;= \" /><text value=\"10\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Level 2: &quot;\" class=\"string\" /><text value=\" + levelTwo);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"34\" endIndex=\"35\" /><option startIndex=\"43\" endIndex=\"45\" /><option correct=\"false\"><content><text value=\"&lt;=\" /></content></option></options></interaction></interactions><output><content><text value=\"Level 2: true\" /></content></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>=</code>, seguito da <code>&gt;=</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Memorizza se <code>points</code> ha raggiunto il livello 2, poi registra il messaggio.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" points = \" /><text value=\"12\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" levelTwo = points &gt;= \" /><text value=\"10\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Level 2: &quot;\" class=\"string\" /><text value=\" + levelTwo);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"25\" endIndex=\"33\" /><option startIndex=\"34\" endIndex=\"35\" /><option startIndex=\"36\" endIndex=\"42\" /><option startIndex=\"43\" endIndex=\"45\" /><option correct=\"false\"><content><text value=\"===\" /></content></option><option correct=\"false\"><content><text value=\"&lt;=\" /></content></option><option correct=\"false\"><content><text value=\"&gt;\" /></content></option><option correct=\"false\"><content><text value=\"&lt;\" /></content></option></options></interaction></interactions><output><content><text value=\"Level 2: true\" /></content></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>levelTwo</code>, seguito da <code>=</code>, <code>points</code> e infine <code>&gt;=</code>.</p></body></html>"
          },
