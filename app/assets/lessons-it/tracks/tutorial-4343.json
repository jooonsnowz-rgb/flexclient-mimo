            "id": 146816,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Che cosa visualizza questo codice nella console?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"let\" class=\"keyword\" /><text value=\" enemiesDefeated = \" /><text value=\"0\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" (enemiesDefeated &lt; \" /><text value=\"3\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\" enemiesDefeated++;\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(enemiesDefeated);\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">I numeri da <code>1</code> a <code>3</code></item><item value=\"2\" correct=\"false\">I numeri da <code>0</code> a <code>3</code></item><item value=\"3\" correct=\"false\">I numeri da <code>1</code> a <code>4</code></item></selection><p visible-if=\"wrong\">I numeri da <code>1</code> a <code>3</code>.</p></body></html>"
          },
          {
