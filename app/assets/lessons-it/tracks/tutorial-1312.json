            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Accedi alla variabile globale <code>rent</code> all'interno della funzione.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"rent = \" /><text value=\"1000\" class=\"number\" /><text type=\"break\" /><text type=\"break\" /><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"calculate_spendings\" class=\"title\" /><text value=\"(groceries)\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"f&quot;Total \" /><text value=\"{rent + groceries}\" class=\"subst\" /><text value=\"&quot;\" /><text value=\")\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(\" /><text value=\"f&quot;Rent \" /><text value=\"{rent}\" class=\"subst\" /><text value=\"&quot;\" /><text value=\")\" /><text type=\"break\" /><text value=\"calculate_spendings(\" /><text value=\"300\" class=\"number\" /><text value=\")\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"66\" endIndex=\"70\" /></interactions><output><content><text value=\"Rent 1000\" /><text type=\"break\" /><text value=\"Total 1300\" /></content></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>rent</code>.</p></body></html>"
