            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quale modificatore useresti per assicurarti che una proprietà non possa essere modificata dopo l'inizializzazione?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">readonly</item><item value=\"2\" correct=\"false\">facoltativo</item><item value=\"3\" correct=\"false\">public</item><item value=\"4\" correct=\"false\">private</item></selection><p visible-if=\"wrong\">Assicurati di scegliere readonly.</p></body></html>"
