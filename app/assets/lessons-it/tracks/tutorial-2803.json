            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Le interfacce in TypeScript possono includere metodi?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Sì, le interfacce in TypeScript possono includere metodi</item><item value=\"2\" correct=\"false\">No, in TypeScript le interfacce servono solo per le proprietà</item><item value=\"3\" correct=\"false\">No, le interfacce possono includere solo costanti</item><item value=\"4\" correct=\"false\">No, le interfacce vengono usate solo per definire i tipi delle funzioni</item></selection><p visible-if=\"wrong\">Sì, le interfacce in TypeScript possono includere metodi.</p></body></html>"
