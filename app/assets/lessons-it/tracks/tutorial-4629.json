            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Che cosa sta succedendo qui?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"requests.put(course_url, json=course_data)\" /><text type=\"break\" /><text value=\"requests.delete(lesson_url)\" /></content></code><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Il codice sostituisce un record completo del corso e poi rimuove una vecchia lezione</item><item value=\"2\" correct=\"false\">Il codice sostituisce un record completo del corso</item><item value=\"3\" correct=\"false\">Il codice rimuove una vecchia lezione</item></selection><p visible-if=\"wrong\">Il codice sostituisce un record completo del corso e poi rimuove una vecchia lezione.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Che cosa sta succedendo qui?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"requests.put(course_url, json=course_data)\" /><text type=\"break\" /><text value=\"requests.delete(lesson_url)\" /></content></code><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Il codice sostituisce un record completo del corso e poi rimuove una vecchia lezione</item><item value=\"2\" correct=\"false\">Il codice sostituisce un record completo del corso</item><item value=\"3\" correct=\"false\">Il codice rimuove una vecchia lezione</item><item value=\"4\" correct=\"false\">Il codice modifica parzialmente il corso ma lascia intatte tutte le lezioni</item></selection><p visible-if=\"wrong\">Il codice sostituisce un record completo del corso e poi rimuove una vecchia lezione.</p></body></html>"
