            "id": 89455,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Come possiamo riutilizzare un set?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Lo salviamo in una variabile</item><item value=\"2\" correct=\"false\">Non possiamo riutilizzarlo, possiamo solo visualizzarlo</item></selection><p visible-if=\"wrong\">Lo salviamo in una variabile.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Salviamo un set in una variabile quando vogliamo riutilizzarlo.</p><p>Quale riga memorizza un set in <code>colors</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>colors = {\"red\", \"blue\"}</code></item><item value=\"2\" correct=\"false\"><code>print({\"red\", \"blue\"})</code></item><item value=\"3\" correct=\"false\"><code>colors == {\"red\", \"blue\"}</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>colors = {\"red\", \"blue\"}</code>.</p></body></html>"
          },
