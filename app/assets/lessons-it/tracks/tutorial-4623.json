            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>La prima operazione converte <code>\"free\"</code> in un numero. Quale gestore corrisponde a questo errore?</p><code version=\"2\" codelang=\"python\" name=\"order.py\" visible-if=\"always\"><content><text value=\"price_text = \" /><text value=\"&quot;free&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"order = {\" /><text value=\"&quot;quantity&quot;\" class=\"string\" /><text value=\": \" /><text value=\"2\" class=\"number\" /><text value=\"}\" /><text type=\"break\" /><text value=\"total = \" /><text value=\"20\" class=\"number\" /><text type=\"break\" /><text value=\"price = float(price_text)\" /><text type=\"break\" /><text value=\"quantity = order[\" /><text value=\"&quot;quantity&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text value=\"share = total / quantity\" /></content></code><selection iscode=\"true\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>except ValueError:</code></item><item value=\"2\" correct=\"false\"><code>except KeyError:</code></item><item value=\"3\" correct=\"false\"><code>except ZeroDivisionError:</code></item><item value=\"4\" correct=\"false\"><code>except TypeError:</code></item></selection><p visible-if=\"wrong\"><code>except ValueError:</code>.</p></body></html>"
          },
