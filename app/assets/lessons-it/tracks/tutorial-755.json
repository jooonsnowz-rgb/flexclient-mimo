            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Come chiamiamo il segno <code>!</code> davanti a <code>true</code> o <code>false</code>? </p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">Il simbolo <code>!</code> è l'operatore di negazione</item><item correct=\"false\" value=\"2\">Il segno <code>!</code> è l'operatore di addizione</item></selection><p visible-if=\"wrong\">Il simbolo <code>!</code> è l'operatore di negazione.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Quale operatore useresti per cambiare un valore booleano nel suo opposto?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">L'operatore di negazione, <code>!</code></item><item value=\"2\" correct=\"false\">L'operatore di addizione, <code>+</code></item><item value=\"3\" correct=\"false\">L'operatore di assegnazione, <code>=</code></item></selection><p visible-if=\"wrong\">L'operatore di negazione, <code>!</code></p></body></html>"
