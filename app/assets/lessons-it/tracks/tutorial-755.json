            "hardModeContent": "<!DOCTYPE html ><html><body><p>Memorizza che le notifiche sono attivate, poi visualizza lo stato opposto nella console.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" \" /><text value=\"notificationsEnabled\" /><text value=\" \" /><text value=\"=\" /><text value=\" \" /><text value=\"true\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".\" /><text value=\"log\" /><text value=\"(\" /><text value=\"!\" /><text value=\"notificationsEnabled\" /><text value=\")\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"6\" endIndex=\"26\" /><option startIndex=\"47\" endIndex=\"48\" /><option startIndex=\"48\" endIndex=\"68\" /><option correct=\"false\"><content><text value=\"!false\" /></content></option><option correct=\"false\"><content><text value=\"false\" /></content></option><option correct=\"false\"><content><text value=\"notificationsDisabled\" /></content></option></options></interaction></interactions><output><content><text value=\"false\" /></content></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>notificationsEnabled</code>, seguito da <code>!</code> e infine <code>notificationsEnabled</code>.</p></body></html>"
