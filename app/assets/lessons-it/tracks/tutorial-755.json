            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Cosa fa l'operatore <code>!</code>?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">Trasforma i valori <code>true</code> o <code>false</code> nel loro opposto</item><item correct=\"false\" value=\"2\">Controlla se i valori sono uguali</item></selection><p visible-if=\"wrong\">Trasforma i valori <code>true</code> o <code>false</code> nel loro opposto.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Un'impostazione ha attualmente il valore <code>true</code>. Che cosa fa l'inserimento di <code>!</code> prima del valore?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Cambia il valore in <code>false</code>.</item><item value=\"2\" correct=\"false\">Verifica se il valore è uguale a <code>false</code>.</item><item value=\"3\" correct=\"false\">Trasforma il valore nella stringa <code>\"true\"</code>.</item></selection><p visible-if=\"wrong\">Cambia il valore in <code>false</code>.</p></body></html>",
