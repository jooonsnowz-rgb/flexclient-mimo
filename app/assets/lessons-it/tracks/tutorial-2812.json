            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Puoi istanziare direttamente una classe astratta in TypeScript?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">No, non puoi istanziare direttamente una classe astratta in TypeScript</item><item value=\"2\" correct=\"false\">Sì, puoi istanziare direttamente una classe astratta in TypeScript</item><item value=\"3\" correct=\"false\">Solo se la classe astratta non ha metodi astratti</item><item value=\"4\" correct=\"false\">Sì, ma solo all'interno dello stesso modulo</item></selection><p visible-if=\"wrong\">No, non puoi istanziare direttamente una classe astratta in TypeScript.</p></body></html>"
