            "interactiveContent": "<!DOCTYPE html ><html><body><p>Che cosa visualizza questo codice nella console?</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" temperature = \" /><text value=\"5\" class=\"number\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" temperature &lt; \" /><text value=\"0\" class=\"number\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Brr...&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"} \" /><text value=\"else\" class=\"keyword\" /><text value=\" \" /><text value=\"if\" class=\"keyword\" /><text value=\" temperature == \" /><text value=\"0\" class=\"number\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;It's freezing!&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"} \" /><text value=\"else\" class=\"keyword\" /><text value=\" \" /><text value=\"if\" class=\"keyword\" /><text value=\" temperature &lt; \" /><text value=\"10\" class=\"number\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;It's cold out.&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"}\" /></content><output><content><text value=\"It's cold out.\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>It's cold out.</code></item><item value=\"2\" correct=\"false\"><code>It's freezing!</code></item><item value=\"3\" correct=\"false\"><code>Brr...</code></item></selection><p visible-if=\"wrong\"><code>It's cold out.</code>.</p></body></html>"
