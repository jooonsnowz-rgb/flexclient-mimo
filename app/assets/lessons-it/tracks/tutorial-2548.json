            "interactiveContent": "<!DOCTYPE html ><html><body><p>Come accediamo a un elemento di questo array?</p><code name=\"main.swift\" version=\"2\" codelang=\"swift\"><content><text value=\"let\" class=\"keyword\" /><text value=\" cars = [\" /><text value=\"&quot;Fiat&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Tesla&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Saab&quot;\" class=\"string\" /><text value=\"]\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>cars[1]</code></item><item value=\"2\" correct=\"false\"><code>cars[\"Tesla\"]</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>cars[1]</code>.</p></body></html>"
