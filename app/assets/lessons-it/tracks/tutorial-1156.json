          {
            "title": "Example: Index",
            "id": 79560,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Assicurati che <code>\"cat\"</code> si trovi all'indice <code>0</code> e che <code>\"dog\"</code> si trovi all'indice <code>1</code>, scrivendo prima <code>\"cat\"</code> e poi <code>\"dog\"</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"animals = [\" /><text value=\"&quot;cat&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;dog&quot;\" class=\"string\" /><text value=\"]\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"11\" endIndex=\"16\" /><option startIndex=\"18\" endIndex=\"23\" /><option correct=\"false\"><content><text value=\"animals\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Assicurati di scegliere <code>\"cat\"</code>, seguito da <code>\"dog\"</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Inserisci <code>\"dog\"</code> all'indice <code>1</code> e <code>\"cat\"</code> all'indice <code>0</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"animals = [\" /><text value=\"&quot;cat&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;dog&quot;\" class=\"string\" /><text value=\"]\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"11\" endIndex=\"16\" /><option startIndex=\"18\" endIndex=\"23\" /><option correct=\"false\"><content><text value=\"animals\" /></content></option><option correct=\"false\"><content><text value=\"cat\" /></content></option><option correct=\"false\"><content><text value=\"dog\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Assicurati di scegliere <code>\"cat\"</code>, seguito da <code>\"dog\"</code>.</p></body></html>",
