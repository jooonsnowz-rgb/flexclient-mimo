            "id": 127036,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quale metodo usiamo per aggiungere un valore a un array?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>.append()</code></item><item value=\"2\" correct=\"false\"><code>.removeLast()</code></item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>.append()</code>.</p></body></html>"
          },
