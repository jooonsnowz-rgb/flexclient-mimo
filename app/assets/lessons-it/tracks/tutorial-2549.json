            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quanti valori possiamo aggiungere a un array usando <code>.append()</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"false\">Quanti ne vogliamo</item><item value=\"2\" correct=\"true\">Un solo valore alla volta</item></selection><p visible-if=\"wrong\">Un solo valore alla volta.</p></body></html>"
