          {
            "title": "Example: Condition",
            "id": 93291,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Scrivi <code>WHERE</code> seguito dal nome di una colonna, per ottenere solo i giochi pubblicati tra il 2000 e il 2020.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"2000\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"2020\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"27\" endIndex=\"40\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>WHERE release</code>.</p></body></html>"
          },
          {
            "title": "Question: Defining a range",
            "id": 93288,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Che cosa seleziona questa query?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" score \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"0\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"50\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Elementi <code>players</code> con un <code>score</code> compreso tra 0 e 50</item><item value=\"2\" correct=\"false\">elementi <code>players</code> con uno <code>score</code> maggiore di 50</item><item value=\"3\" correct=\"false\">  Elementi di <code>players</code> con un punteggio pari a 50</item></selection><p visible-if=\"wrong\">Elementi <code>players</code> con un <code>score</code> compreso tra 0 e 50.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>I giocatori hanno punteggi di <code>0</code>, <code>25</code>, <code>50</code> e <code>51</code>. Quali punteggi seleziona la query mostrata?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" score \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"0\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"50\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>0</code>, <code>25</code> e <code>50</code></item><item value=\"2\" correct=\"false\">Solo <code>25</code>, perché entrambi gli estremi sono esclusi</item><item value=\"3\" correct=\"false\">Solo <code>0</code> e <code>50</code>, perché corrispondono solo gli estremi</item><item value=\"4\" correct=\"false\">Solo <code>51</code>, perché <code>BETWEEN</code> significa maggiore del valore superiore</item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>0</code>, <code>25</code> e <code>50</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example: The keyword BETWEEN",
            "id": 93292,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Completa il codice della condizione, in modo che nella tabella dei risultati compaiano solo i giochi pubblicati tra il 1990 e il 2000.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"1990\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"2000\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"41\" endIndex=\"62\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>BETWEEN 1990 AND 2000</code>.</p></body></html>"
          },
          {
            "title": "Question: Border inclusive",
            "id": 93289,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Questa query selezionerà gli elementi con un punteggio uguale a <code>70</code> o a <code>100</code>?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" score \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"70\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"100\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Sì, perché gli intervalli includono i loro limiti</item><item value=\"2\" correct=\"false\">No, perché gli intervalli <em>non</em> includono i loro estremi</item><item value=\"3\" correct=\"false\">Sì, selezionerà <em>solo</em> gli elementi con uno <code>score</code> uguale a <code>70</code> o <code>100</code>, niente nel mezzo</item></selection><p visible-if=\"wrong\">Sì, perché gli intervalli includono i loro limiti.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Dati i punteggi <code>69</code>, <code>70</code>, <code>85</code>, <code>100</code> e <code>101</code>, quali seleziona la query?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" score \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"70\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"100\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>70</code>, <code>85</code> e <code>100</code></item><item value=\"2\" correct=\"false\">Solo <code>85</code>, perché gli estremi sono esclusi</item><item value=\"3\" correct=\"false\">Solo <code>70</code> e <code>100</code>, perché <code>BETWEEN</code> elenca due opzioni esatte</item><item value=\"4\" correct=\"false\"><code>85</code>, <code>100</code> e <code>101</code>, perché si applica solo il limite inferiore</item></selection><p visible-if=\"wrong\">Assicurati di scegliere <code>70</code>, <code>85</code> e <code>100</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example: Border inclusive",
            "id": 93294,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Scrivi una condizione in modo che nella tabella dei risultati vengano mostrati i giochi pubblicati tra il 1995 e il 2007, inclusi questi anni.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"1995\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"2007\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"27\" endIndex=\"40\" /><option startIndex=\"41\" endIndex=\"48\" /><option startIndex=\"49\" endIndex=\"53\" /><option startIndex=\"54\" endIndex=\"57\" /><option startIndex=\"58\" endIndex=\"62\" /><option correct=\"false\"><content><text value=\"1996\" /></content></option><option correct=\"false\"><content><text value=\"2008\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di scegliere <code>WHERE release</code>, seguito da <code>BETWEEN</code> e poi <code>1995</code>, <code>AND</code>, <code>2007</code>.</p></body></html>"
          },
          {
            "title": "Question: A pattern is a text",
            "id": 93785,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Perché racchiudiamo i pattern tra virgolette semplici?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Poiché i pattern sono anch'essi valori di testo</item><item value=\"2\" correct=\"false\">Non racchiudiamo i pattern tra apici semplici</item><item value=\"3\" correct=\"false\">Non racchiudiamo l'intero pattern tra apici singoli, ma solo il carattere jolly <code>%</code></item></selection><p visible-if=\"wrong\">Poiché i pattern sono anch'essi valori di testo.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>I pattern sono valori di testo. Racchiudi l'intero pattern tra virgolette semplici.</p><p>Hai scritto <code>A'%'</code>. Quale modifica rende l'intero pattern <code>A%</code> un unico valore di testo?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Sposta la virgoletta di apertura prima di <code>A</code></item><item value=\"2\" correct=\"false\">Rimuovi entrambe le virgolette</item><item value=\"3\" correct=\"false\">Metti invece le virgolette attorno al nome della colonna</item><item value=\"4\" correct=\"false\">Sposta la virgoletta di chiusura prima di <code>%</code></item></selection><p visible-if=\"wrong\">Sposta la virgoletta di apertura prima di <code>A</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Question: Zero or more symbols",
            "id": 93786,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Cosa corrisponderà al pattern in questa query?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE users (&#xA;name varchar(255),&#xA;email varchar(255)&#xA;&#xA;);&#xA;&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Tara', 'tara.smith@gmail.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Ben', 'ben.turner@rdelivery.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Joan', 'joan.j@threadandco.uk');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Kim', 'kim.s.lee@gmail.uk');\"><tables><table name=\"users\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Tara\" /><data content=\"tara.smith@gmail.com\" /></row><row><data content=\"Ben\" /><data content=\"ben.turner@rdelivery.com\" /></row><row><data content=\"Joan\" /><data content=\"joan.j@threadandco.uk\" /></row><row><data content=\"Kim\" /><data content=\"kim.s.lee@gmail.uk\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" \" /><text value=\"users\" class=\"keyword\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" email \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'ben%'\" class=\"string\" /><text value=\";\" /></content><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Ben\" /><data content=\"ben.turner@rdelivery.com\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Valori che iniziano con il testo <code>'ben'</code></item><item value=\"2\" correct=\"false\">Valori che terminano con il testo <code>'ben'</code></item><item value=\"3\" correct=\"false\">Valori che contengono il testo <code>'ben'</code></item></selection><p visible-if=\"wrong\">Valori che iniziano con il testo <code>'ben'</code>.</p></body></html>"
          },
          {
            "title": "Example: Start with",
            "id": 93790,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Scrivi un pattern per trovare valori <code>email</code> che iniziano con <code>'kim'</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE users (&#xA;name varchar(255),&#xA;email varchar(255)&#xA;&#xA;);&#xA;&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Tara', 'tara.smith@gmail.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Ben', 'ben.turner@rdelivery.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Joan', 'joan.j@threadandco.uk');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Kim', 'kim.s.lee@gmail.uk');\"><tables><table name=\"users\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Tara\" /><data content=\"tara.smith@gmail.com\" /></row><row><data content=\"Ben\" /><data content=\"ben.turner@rdelivery.com\" /></row><row><data content=\"Joan\" /><data content=\"joan.j@threadandco.uk\" /></row><row><data content=\"Kim\" /><data content=\"kim.s.lee@gmail.uk\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" \" /><text value=\"users\" class=\"keyword\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" email \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'kim%'\" class=\"string\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"38\" endIndex=\"44\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Kim\" /><data content=\"kim.s.lee@gmail.uk\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>'kim%'</code>.</p></body></html>"
          },
          {
            "title": "Example: End with",
            "id": 93791,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Codifica un pattern che corrisponda ai valori di <code>email</code> che terminano con <code>'.uk'</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE users (&#xA;name varchar(255),&#xA;email varchar(255)&#xA;&#xA;);&#xA;&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Tara', 'tara.smith@gmail.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Ben', 'ben.turner@rdelivery.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Joan', 'joan.j@threadandco.uk');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Kim', 'kim.s.lee@gmail.uk');\"><tables><table name=\"users\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Tara\" /><data content=\"tara.smith@gmail.com\" /></row><row><data content=\"Ben\" /><data content=\"ben.turner@rdelivery.com\" /></row><row><data content=\"Joan\" /><data content=\"joan.j@threadandco.uk\" /></row><row><data content=\"Kim\" /><data content=\"kim.s.lee@gmail.uk\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" \" /><text value=\"users\" class=\"keyword\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" email \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'%.uk'\" class=\"string\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"38\" endIndex=\"44\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Joan\" /><data content=\"joan.j@threadandco.uk\" /></row><row><data content=\"Kim\" /><data content=\"kim.s.lee@gmail.uk\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>'%.uk'</code>.</p></body></html>"
          },
          {
            "title": "Example: Containing",
            "id": 93792,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Usa due caratteri jolly e <code>LIKE</code> per scrivere una condizione che verifichi se il valore nella colonna <code>email</code> contiene <code>'gmail'</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE users (&#xA;name varchar(255),&#xA;email varchar(255)&#xA;&#xA;);&#xA;&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Tara', 'tara.smith@gmail.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Ben', 'ben.turner@rdelivery.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Joan', 'joan.j@threadandco.uk');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Kim', 'kim.s.lee@gmail.uk');\"><tables><table name=\"users\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Tara\" /><data content=\"tara.smith@gmail.com\" /></row><row><data content=\"Ben\" /><data content=\"ben.turner@rdelivery.com\" /></row><row><data content=\"Joan\" /><data content=\"joan.j@threadandco.uk\" /></row><row><data content=\"Kim\" /><data content=\"kim.s.lee@gmail.uk\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" \" /><text value=\"users\" class=\"keyword\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" email \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'%gmail%'\" class=\"string\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"27\" endIndex=\"47\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Tara\" /><data content=\"tara.smith@gmail.com\" /></row><row><data content=\"Kim\" /><data content=\"kim.s.lee@gmail.uk\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>email LIKE '%gmail%'</code>.</p></body></html>"
          },
          {
            "title": "Example: IN keyword",
            "id": 93813,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Inserisci la parola chiave mancante per selezionare solo gli elementi con un valore di <code>type</code> pari a <code>'basic'</code> o <code>'pro'</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE membership (&#xA; name varchar(255),&#xA; type varchar(255),&#xA; months_active int&#xA;);&#xA;&#xA;INSERT INTO membership (name, type, months_active)&#xA;VALUES ('Sam', 'free', 2);&#xA;&#xA;INSERT INTO membership (name, type, months_active)&#xA;VALUES ('Remy', 'pro', 1);&#xA;&#xA;INSERT INTO membership (name, type, months_active)&#xA;VALUES ('Luis', 'basic', 12);&#xA;&#xA;INSERT INTO membership (name, type, months_active)&#xA;VALUES ('Kim', 'pro', 7);&#xA;\"><tables><table name=\"membership\"><row><header content=\"name\" /><header content=\"type\" /><header content=\"months_active\" /></row><row><data content=\"Sam\" /><data content=\"free\" /><data content=\"2\" /></row><row><data content=\"Remy\" /><data content=\"pro\" /><data content=\"1\" /></row><row><data content=\"Luis\" /><data content=\"basic\" /><data content=\"12\" /></row><row><data content=\"Kim\" /><data content=\"pro\" /><data content=\"7\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" membership\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"type\" class=\"keyword\" /><text value=\" \" /><text value=\"IN\" class=\"keyword\" /><text value=\" (\" /><text value=\"'basic'\" class=\"string\" /><text value=\", \" /><text value=\"'pro'\" class=\"string\" /><text value=\");\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"37\" endIndex=\"39\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"type\" /><header content=\"months_active\" /></row><row><data content=\"Remy\" /><data content=\"pro\" /><data content=\"1\" /></row><row><data content=\"Luis\" /><data content=\"basic\" /><data content=\"12\" /></row><row><data content=\"Kim\" /><data content=\"pro\" /><data content=\"7\" /></row></table></output></code><p visible-if=\"wrong\">Assicurati di digitare <code>IN</code>.</p></body></html>"
          },
          {
            "title": "Question: Comma",
            "id": 93810,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Come separiamo diverse opzioni?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Con una virgola <code>,</code></item><item value=\"2\" correct=\"false\">Con un punto e virgola <code>;</code></item><item value=\"3\" correct=\"false\">Non è necessario separarli</item></selection><p visible-if=\"wrong\">Con una virgola <code>,</code>.</p></body></html>",
