            "id": 72692,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Come si chiamano le parentesi graffe <code>{ }</code> e il codice al loro interno?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"while\" class=\"keyword\" /><text value=\" (\" /><text value=\"false\" class=\"literal\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Echo&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Un blocco di codice</item><item value=\"2\" correct=\"false\">Una condizione</item></selection><p visible-if=\"wrong\">Un blocco di codice.</p></body></html>",
