            "interactiveContent": "<!DOCTYPE html ><html><body><p>Che cos'è la console?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">Un'area che visualizza l'output</item><item correct=\"false\" value=\"2\">L'area in cui scriviamo il codice</item></selection><p visible-if=\"wrong\">Un'area che visualizza l'output.</p></body></html>"
