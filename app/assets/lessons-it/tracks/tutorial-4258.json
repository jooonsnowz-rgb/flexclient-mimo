            "interactiveContent": "<!DOCTYPE html ><html><body><p>Usa lo standard <code>snake_case</code> maiuscolo per dichiarare questa variabile <code>const</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"final_boss_name\" /></content></option><option correct=\"false\"><content><text value=\"FINALBOSSNAME\" /></content></option><option startIndex=\"6\" endIndex=\"21\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" FINAL_BOSS_NAME = \" /><text value=\"&quot;Hydra&quot;\" class=\"string\" /><text value=\";\" /></content></code><p visible-if=\"wrong\">Assicurati di scegliere <code>FINAL_BOSS_NAME</code>.</p></body></html>"
