            "id": 145157,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Che cosa fa l'istruzione speciale <code>console.log()</code>?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">Visualizza un valore nella console</item><item correct=\"false\" value=\"2\">Crea una variabile</item></selection><p visible-if=\"wrong\">Visualizza un valore nella console.</p></body></html>"
