            "interactiveContent": "<!DOCTYPE html ><html><body><p>What is the default width of a flex item?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"false\">The width of its parent</item><item value=\"2\" correct=\"true\">The width of its content</item><item value=\"3\" correct=\"false\">The width of the browser window</item></selection><p visible-if=\"wrong\">The width of its content.</p></body></html>"
