            "title": "Lesson #10",
            "id": 148139,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Finish the code below with the correct input.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"&quot;3&quot;,\" /></content></option><option correct=\"false\"><content><text value=\"&quot;5&quot;\" /></content></option><option startIndex=\"85\" endIndex=\"87\" /><option startIndex=\"88\" endIndex=\"89\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"sumNumbers\" class=\"title\" /><text value=\"(\" /><text value=\"numbers\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(numbers[\" /><text value=\"0\" class=\"number\" /><text value=\"] + numbers[\" /><text value=\"1\" class=\"number\" /><text value=\"]);\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" arr = [\" /><text value=\"3\" class=\"number\" /><text value=\", \" /><text value=\"5\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"sumNumbers(arr);\" /></content></code><p visible-if=\"wrong\">Make sure to pick <code>3,</code>, followed by <code>5</code>.</p></body></html>"
