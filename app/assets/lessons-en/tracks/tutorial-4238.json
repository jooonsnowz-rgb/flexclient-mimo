            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Why is the line break tag an empty tag?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">Because it has no closing tag</item><item correct=\"false\" value=\"2\">Because it has no effect on the structure of a webpage</item><item correct=\"false\" value=\"2\">Because it has no opening tag</item></selection><p visible-if=\"wrong\">Because it has no closing tag.</p></body></html>"
