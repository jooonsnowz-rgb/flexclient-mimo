            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Code the opening tag that defines text as important.</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"/\" /></content></option><option startIndex=\"41\" endIndex=\"42\" /><option startIndex=\"42\" endIndex=\"48\" /><option startIndex=\"48\" endIndex=\"49\" /></options></interaction></interactions><content><text value=\"&lt;\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Potion Shop\" /><text value=\"&lt;/\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text value=\" Limited offer - \" /><text value=\"&lt;\" /><text value=\"strong\" class=\"name\" /><text value=\"&gt;\" /><text value=\"only 50 gold\" /><text value=\"&lt;/\" /><text value=\"strong\" class=\"name\" /><text value=\"&gt;\" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /></content></code><p visible-if=\"wrong\">Make sure to pick <code>&lt;</code>, followed by <code>strong</code>, and finally <code>&gt;</code>.</p></body></html>"
          },
