          },
          {
            "title": "Lesson #6",
            "id": 144715,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>What's wrong with these emphasis tags?</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><content><text value=\"&lt;/\" /><text value=\"em\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Critical Hit!\" /><text value=\"&lt;/\" /><text value=\"em\" class=\"name\" /><text value=\"&gt;\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">There's a <code>/</code> sign in the opening tag</item><item value=\"2\" correct=\"false\">There's no closing tag</item><item value=\"3\" correct=\"false\">There's no content inside them</item></selection><p visible-if=\"wrong\">There's a <code>/</code> sign in the opening tag.</p></body></html>"
