            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Check if <code>5</code> is greater than <code>4</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"5\" class=\"number\" /><text value=\" &gt; \" /><text value=\"4\" class=\"number\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"12\" endIndex=\"13\" /><option startIndex=\"14\" endIndex=\"15\" /><option startIndex=\"16\" endIndex=\"17\" /><option correct=\"false\"><content><text value=\"===\" /></content></option></options></interaction></interactions><output><content><text value=\"true\" /></content></output></code><p visible-if=\"wrong\">Make sure to pick <code>5</code>, followed by <code>&gt;</code>, and finally <code>4</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Check whether <code>5</code> is greater than <code>4</code>, keeping <code>5</code> on the left.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"5\" class=\"number\" /><text value=\" &gt; \" /><text value=\"4\" class=\"number\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"12\" endIndex=\"13\" /><option startIndex=\"14\" endIndex=\"15\" /><option startIndex=\"16\" endIndex=\"17\" /><option correct=\"false\"><content><text value=\"&lt;\" /></content></option><option correct=\"false\"><content><text value=\"===\" /></content></option><option correct=\"false\"><content><text value=\"=\" /></content></option></options></interaction></interactions><output><content><text value=\"true\" /></content></output></code><p visible-if=\"wrong\">Make sure to pick <code>5</code>, followed by <code>&gt;</code>, and finally <code>4</code>.</p></body></html>",
            "hardModeSelected": true
