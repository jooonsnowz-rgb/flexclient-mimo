            "id": 145324,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Display <code>false</code> in the console by typing the <code>&gt;</code> operator.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"16\" endIndex=\"17\" isDefault=\"true\" /></interactions><content><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"100\" class=\"number\" /><text value=\" &gt; \" /><text value=\"200\" class=\"number\" /><text value=\");\" /></content></code><p visible-if=\"wrong\">Make sure to type <code>&gt;</code>.</p></body></html>"
