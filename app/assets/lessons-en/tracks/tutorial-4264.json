            "id": 145337,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Check if <code>60</code> is greater than or equal to <code>50</code> with the greater-than-or-equal-to operator, <code>&gt;=</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"15\" endIndex=\"17\" isDefault=\"true\" /></interactions><content><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"60\" class=\"number\" /><text value=\" &gt;= \" /><text value=\"50\" class=\"number\" /><text value=\");\" /></content></code><p visible-if=\"wrong\">Make sure to type <code>&gt;=</code>.</p></body></html>"
