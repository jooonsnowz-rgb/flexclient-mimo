            "interactiveContent": "<!DOCTYPE html ><html><body><p>Avoid processing spam.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"emails = [\" /><text value=\"&quot;spam&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;important&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;spam&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;newsletter&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"for\" class=\"keyword\" /><text value=\" email \" /><text value=\"in\" class=\"keyword\" /><text value=\" emails:\" /><text type=\"break\" /><text value=\"  \" /><text value=\"if\" class=\"keyword\" /><text value=\" email == \" /><text value=\"&quot;spam&quot;\" class=\"string\" /><text value=\":\" /><text type=\"break\" /><text value=\"    \" /><text value=\"continue\" class=\"keyword\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"f&quot;Processing: \" /><text value=\"{email}\" class=\"subst\" /><text value=\"&quot;\" /><text value=\")\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"101\" endIndex=\"109\" /></interactions><output><content><text value=\"Processing: important\" /><text type=\"break\" /><text value=\"Processing: newsletter\" /></content></output></code><p visible-if=\"wrong\">Make sure to type <code>continue</code>.</p></body></html>"
