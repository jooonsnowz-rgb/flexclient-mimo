            "id": 152122,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Invalid discount text means no discount applies. Complete the valid default.</p><code version=\"2\" codelang=\"python\" name=\"discount.py\" visible-if=\"always\"><content><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"read_discount\" class=\"title\" /><text value=\"(value)\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\"  \" /><text value=\"try\" class=\"keyword\" /><text value=\":\" /><text type=\"break\" /><text value=\"    \" /><text value=\"return\" class=\"keyword\" /><text value=\" int(value)\" /><text type=\"break\" /><text value=\"  \" /><text value=\"except\" class=\"keyword\" /><text value=\" ValueError:\" /><text type=\"break\" /><text value=\"    \" /><text value=\"return\" class=\"keyword\" /><text value=\" \" /><text value=\"0\" class=\"number\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"87\" endIndex=\"88\" /><option correct=\"false\"><content><text value=\"None\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Make sure to pick <code>0</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Invalid discount text means no discount applies. Complete the valid default.</p><code version=\"2\" codelang=\"python\" name=\"discount.py\" visible-if=\"always\"><content><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"read_discount\" class=\"title\" /><text value=\"(value)\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\"  \" /><text value=\"try\" class=\"keyword\" /><text value=\":\" /><text type=\"break\" /><text value=\"    \" /><text value=\"return\" class=\"keyword\" /><text value=\" int(value)\" /><text type=\"break\" /><text value=\"  \" /><text value=\"except\" class=\"keyword\" /><text value=\" ValueError:\" /><text type=\"break\" /><text value=\"    \" /><text value=\"return\" class=\"keyword\" /><text value=\" \" /><text value=\"0\" class=\"number\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"64\" endIndex=\"74\" /><option startIndex=\"87\" endIndex=\"88\" /><option correct=\"false\"><content><text value=\"TypeError\" /></content></option><option correct=\"false\"><content><text value=\"None\" /></content></option><option correct=\"false\"><content><text value=\"1\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Make sure to pick <code>ValueError</code>, followed by <code>0</code>.</p></body></html>",
