            "title": "Lesson #8",
            "id": 144899,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>To italicize the text of an element, we use the <code>font-style</code> property and set the value to <code>italic</code>.</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><content><text value=\"&lt;!doctype html&gt;\" class=\"meta\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;\" /><text value=\"head\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"link\" class=\"name\" /><text value=\" \" /><text value=\"rel\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;stylesheet&quot;\" class=\"string\" /><text value=\" \" /><text value=\"href\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;style.css&quot;\" class=\"string\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;/\" /><text value=\"head\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text value=\"HP: 100\" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;/\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;/\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /></content></code><code name=\"style.css\" version=\"2\" codelang=\"css\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"50\" endIndex=\"60\" /><option startIndex=\"60\" endIndex=\"61\" /><option startIndex=\"62\" endIndex=\"68\" /><option startIndex=\"68\" endIndex=\"69\" /></opti