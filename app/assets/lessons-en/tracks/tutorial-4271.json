        "lessons": [
          {
            "title": "Lesson #1",
            "id": 145499,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>To make smarter decisions in our games, we need <code>if</code> statements that rely on smarter conditions like in the mini game HUD below.</p><webview version=\"2\" content=\"&lt;!doctype html&gt;&#xA;&lt;html&gt;&#xA; &lt;head&gt;&#xA;  &lt;style&gt;&#xA;   body {&#xA;    text-align: center;&#xA;    font-size: 20px;&#xA;    margin: 0 auto;&#xA;    height: 400px;&#xA;    font-family: Arial, sans-serif;&#xA;   }&#xA;   button {&#xA;    width: 200px;&#xA;    height: 30px;&#xA;    font-size: 20px;&#xA;    border-radius: 5px;&#xA;    margin: 0 auto;&#xA;    display: block;&#xA;    background-color: #1f6feb;&#xA;    color: white;&#xA;    outline: none;&#xA;    border: none;&#xA;   }&#xA;   .radioDiv {&#xA;    margin: 0 auto;&#xA;    width: auto;&#xA;    text-align: left;&#xA;    display: table;&#xA;   }&#xA;   .panel {&#xA;    border: 1px solid #f0f5fd;&#xA;    border-radius: 20px;&#xA;    padding-top: 10px;&#xA;    padding-bottom: 20px;&#xA;    padding-left: 10px;&#xA;    padding-right: 10px;&#xA;    width: 320px;&#xA;    height: 220px;&#xA;    background-color: #d9e8fb;&#xA;    margin: 0 auto;&#xA;   }&#xA;   .hud {&#xA;    font-size: 16px;&#xA;    margin-bottom: 10px;&#xA;   }&#xA;  &lt;/style&gt;&#xA; &lt;/head&gt;&#xA; &lt;body id=&quot;main&quot;&gt;&#xA;  &lt;h1&gt;Loot Chest&lt;/h1&gt;&#xA;  &lt;div class=&quot;panel&quot;&gt;&#xA;   &lt;div class=&quot;hud&quot;&gt;Player HP: &lt;strong&gt;5&lt;/strong&gt; | Score: &lt;strong&gt;120&lt;/strong&gt;&lt;/div&gt;&#xA;   &lt;h3&gt;Pick the key to open the chest:&lt;/h3&gt;&#xA;   &lt;div class=&quot;radioDiv&quot;&gt;&#xA;    &lt;input type=&quot;radio&quot; name=&quot;key&quot; value=&quot;gold&quot;&gt; Gold Key&lt;br&gt;&#xA;    &lt;input type=&quot;radio&quot; name=&quot;key&quot; value=&quot;wood&quot;&gt;&#xA;    Wooden Key&lt;br&gt;&lt;br&gt;&#xA;   &lt;/div&gt;&#xA;   &lt;button onClick=&quot;check()&quot;&gt;Use Key&lt;/button&gt;&#xA;  &lt;/div&gt;&#xA;  &lt;script&gt;&#xA;   function check() {&#xA;    const feedback = document.getElementById(&quot;feedback&quot;);&#xA;    const radios = document.getElementsByName(&quot;key&quot;);&#xA;    const body = document.getElementById(&quot;main&quot;);&#xA;    if (feedback !== null) {&#xA;     body.removeChild(feedback);&#xA;    }&#xA;    for (let i = 0, length = radios.length; i &lt; length; i++) {&#xA;     const paragraph = document.createElement(&quot;p&quot;);&#xA;     paragraph.id = &quot;feedback&quot;;&#xA;     if (radios[i].checked) {&#xA;      if (radios[i].value === &quot;gold&quot;) {&#xA;       paragraph.innerHTML = &quot;Chest opened! +50 score&quot;;&#xA;       paragraph.style.color = &quot;#2ea043&quot;;&#xA;      } else {&#xA;       paragraph.innerHTML = &quot;Key broke! -1 HP&quot;;&#xA;       paragraph.style.color = &quot;#d1242f&quot;;&#xA;      }&#xA;      body.appendChild(paragraph);&#xA;      break;&#xA;     }&#xA;    }&#xA;   }&#xA;  &lt;/script&gt;&#xA; &lt;/body&gt;&#xA;&lt;/html&gt;\" /></body></html>"
          },
          {
            "title": "Lesson #2",
            "id": 145500,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>This HUD displays <code>Chest opened!</code> if the player uses the correct key and <code>Key broke!</code> if the player uses the wrong one.</p><webview version=\"2\" content=\"&lt;!doctype html&gt;&#xA;&lt;html&gt;&#xA; &lt;head&gt;&#xA;  &lt;style&gt;&#xA;   body {&#xA;    text-align: center;&#xA;    font-size: 20px;&#xA;    margin: 0 auto;&#xA;    height: 400px;&#xA;    font-family: Arial, sans-serif;&#xA;   }&#xA;   button {&#xA;    width: 200px;&#xA;    height: 30px;&#xA;    font-size: 20px;&#xA;    border-radius: 5px;&#xA;    margin: 0 auto;&#xA;    display: block;&#xA;    background-color: #1f6feb;&#xA;    color: white;&#xA;    outline: none;&#xA;    border: none;&#xA;   }&#xA;   .radioDiv {&#xA;    margin: 0 auto;&#xA;    width: auto;&#xA;    text-align: left;&#xA;    display: table;&#xA;   }&#xA;   .panel {&#xA;    border: 1px solid #f0f5fd;&#xA;    border-radius: 20px;&#xA;    padding-top: 10px;&#xA;    padding-bottom: 20px;&#xA;    padding-left: 10px;&#xA;    padding-right: 10px;&#xA;    width: 320px;&#xA;    height: 220px;&#xA;    background-color: #d9e8fb;&#xA;    margin: 0 auto;&#xA;   }&#xA;   .hud {&#xA;    font-size: 16px;&#xA;    margin-bottom: 10px;&#xA;   }&#xA;  &lt;/style&gt;&#xA; &lt;/head&gt;&#xA; &lt;body id=&quot;main&quot;&gt;&#xA;  &lt;h1&gt;Loot Chest&lt;/h1&gt;&#xA;  &lt;div class=&quot;panel&quot;&gt;&#xA;   &lt;div class=&quot;hud&quot;&gt;Player HP: &lt;strong&gt;5&lt;/strong&gt; | Score: &lt;strong&gt;120&lt;/strong&gt;&lt;/div&gt;&#xA;   &lt;h3&gt;Pick the key to open the chest:&lt;/h3&gt;&#xA;   &lt;div class=&quot;radioDiv&quot;&gt;&#xA;    &lt;input type=&quot;radio&quot; name=&quot;key&quot; value=&quot;gold&quot;&gt; Gold Key&lt;br&gt;&#xA;    &lt;input type=&quot;radio&quot; name=&quot;key&quot; value=&quot;wood&quot;&gt;&#xA;    Wooden Key&lt;br&gt;&lt;br&gt;&#xA;   &lt;/div&gt;&#xA;   &lt;button onClick=&quot;check()&quot;&gt;Use Key&lt;/button&gt;&#xA;  &lt;/div&gt;&#xA;  &lt;script&gt;&#xA;   function check() {&#xA;    const feedback = document.getElementById(&quot;feedback&quot;);&#xA;    const radios = document.getElementsByName(&quot;key&quot;);&#xA;    const body = document.getElementById(&quot;main&quot;);&#xA;    if (feedback !== null) {&#xA;     body.removeChild(feedback);&#xA;    }&#xA;    for (let i = 0, length = radios.length; i &lt; length; i++) {&#xA;     const paragraph = document.createElement(&quot;p&quot;);&#xA;     paragraph.id = &quot;feedback&quot;;&#xA;     if (radios[i].checked) {&#xA;      if (radios[i].value === &quot;gold&quot;) {&#xA;       paragraph.innerHTML = &quot;Chest opened! +50 score&quot;;&#xA;       paragraph.style.color = &quot;#2ea043&quot;;&#xA;      } else {&#xA;       paragraph.innerHTML = &quot;Key broke! -1 HP&quot;;&#xA;       paragraph.style.color = &quot;#d1242f&quot;;&#xA;      }&#xA;      body.appendChild(paragraph);&#xA;      break;&#xA;     }&#xA;    }&#xA;   }&#xA;  &lt;/script&gt;&#xA; &lt;/body&gt;&#xA;&lt;/html&gt;\" /></body></html>"
          },
          {
            "title": "Lesson #3",
            "id": 145501,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>A game like that uses the <code>===</code> operator to check if a player's <code>key</code> choice is correct.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"26\" endIndex=\"29\" isDefault=\"true\" /></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" key = \" /><text value=\"&quot;Gold&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" (key === \" /><text value=\"&quot;Gold&quot;\" class=\"string\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(key + \" /><text value=\"&quot; key opened the chest!&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Make sure to type <code>===</code>.</p></body></html>"
          },
          {
            "title": "Lesson #4",
            "id": 145502,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>What if the player picks the wrong key? We can use <code>!==</code> to check if <code>key</code> is not equal to <code>\"Gold\"</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"key === &quot;Gold&quot;\" /></content></option><option startIndex=\"22\" endIndex=\"36\" /></options></interaction></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" key = \" /><text value=\"&quot;Wood&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" (key !== \" /><text value=\"&quot;Gold&quot;\" class=\"string\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(key + \" /><text value=\"&quot; key failed!&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Make sure to pick <code>key !== \"Gold\"</code>.</p></body></html>"
          },
          {
            "title": "Lesson #5",
            "id": 145503,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>if</code> statements work with all comparison operators we've explored so far. Like checking if <code>score</code> is greater than or equal to <code>1000</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"&lt;=\" /></content></option><option startIndex=\"22\" endIndex=\"27\" /><option startIndex=\"28\" endIndex=\"30\" /><option startIndex=\"31\" endIndex=\"35\" /></options></interaction></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" score = \" /><text value=\"1250\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" (score &gt;= \" /><text value=\"1000\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;New level unlocked&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Make sure to pick <code>score</code>, followed by <code>&gt;=</code>, and finally <code>1000</code>.</p></body></html>"
          },
          {
            "title": "Lesson #6",
            "id": 145504,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>if</code> statements also can use <code>===</code> to compare variables like <code>gamePaused</code> to boolean values.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"!==\" /></content></option><option startIndex=\"27\" endIndex=\"37\" /><option startIndex=\"38\" endIndex=\"41\" /></options></interaction></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" gamePaused = \" /><text value=\"true\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" (gamePaused === \" /><text value=\"true\" class=\"literal\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Pause menu open&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Make sure to pick <code>gamePaused</code>, followed by <code>===</code>.</p></body></html>"
          },
          {
            "title": "Lesson #7",
            "id": 145505,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>To use the result of a comparison multiple times, we can store it in a variable like <code>isAlive</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"46\" endIndex=\"53\" isDefault=\"true\" /></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" health = \" /><text value=\"1\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"let\" class=\"keyword\" /><text value=\" isAlive = health &gt; \" /><text value=\"0\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" (isAlive) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(isAlive);\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Make sure to type <code>isAlive</code>.</p></body></html>"
          },
          {
            "title": "Lesson #8",
            "id": 145506,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Why do we use comparisons with <code>if</code> statements?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">To make smarter decisions about running or skipping code</item><item value=\"2\" correct=\"false\">To always run the if-statement block</item></selection><p visible-if=\"wrong\">To make smarter decisions about running or skipping code.</p></body></html>"
          },
          {
            "title": "Lesson #9",
            "id": 145507,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>What do we use comparisons with <code>===</code> for?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Skipping or running code depending on whether two values are the same</item><item value=\"2\" correct=\"false\">Always running code since a comparison with <code>===</code> always returns <code>true</code></item></selection><p visible-if=\"wrong\">Skipping or running code depending on whether two values are the same.</p></body></html>"
          },
          {
            "title": "Lesson #10",
            "id": 145508,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Which operator runs an if statement's code block when two values are different?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>!==</code></item><item value=\"2\" correct=\"false\"><code>===</code></item></selection><p visible-if=\"wrong\">Make sure to pick <code>!==</code>.</p></body></html>"
          },
          {
            "title": "Lesson #11",
            "id": 145509,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Which operators can we use to make comparisons for if statement conditions?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>&gt;=</code>, <code>&lt;=</code>, <code>&gt;</code>, <code>&lt;</code>, <code>===</code>, and <code>!==</code></item><item value=\"2\" correct=\"false\">Only <code>===</code> and <code>!==</code></item></selection><p visible-if=\"wrong\"><code>&gt;=</code>, <code>&lt;=</code>, <code>&gt;</code>, <code>&lt;</code>, <code>===</code>, and <code>!==</code>.</p></body></html>"
          },
          {
            "title": "Lesson #12",
            "id": 145510,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Which types can we compare using <code>===</code> in conditions?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Numbers, strings, and booleans</item><item value=\"2\" correct=\"false\">Only numbers and strings</item></selection><p visible-if=\"wrong\">Numbers, strings, and booleans.</p></body></html>"
          },
          {
            "title": "Lesson #13",
            "id": 145511,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>How can we avoid rewriting the same comparison multiple times?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">We can save its result in a variable and reuse the variable</item><item value=\"2\" correct=\"false\">We can't avoid it since comparisons can't be saved for later</item></selection><p visible-if=\"wrong\">We can save its result in a variable and reuse the variable.</p></body></html>"
          },
          {
            "title": "Lesson #14",
            "id": 145512,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Code a condition that runs the code if <code>coins</code> is greater than or equal to <code>300</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"item === 300\" /></content></option><option startIndex=\"51\" endIndex=\"63\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" item = \" /><text value=\"&quot;Health Potion&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"let\" class=\"keyword\" /><text value=\" coins = \" /><text value=\"345\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" (coins &gt;= \" /><text value=\"300\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;You can buy: &quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(item);\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Make sure to pick <code>coins &gt;= 300</code>.</p></body></html>"
          },
          {
            "title": "Lesson #15",
            "id": 145513,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Code a condition to equip a shield if the player's <code>classType</code> equals <code>\"tank\"</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"!==\" /></content></option><option startIndex=\"99\" endIndex=\"108\" /><option startIndex=\"109\" endIndex=\"112\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" classType = \" /><text value=\"&quot;tank&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" tankShield = \" /><text value=\"&quot;Iron Shield&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" defaultItem = \" /><text value=\"&quot;Cloth Armor&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" (classType === \" /><text value=\"&quot;tank&quot;\" class=\"string\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Equip: &quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(tankShield);\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Make sure to pick <code>classType</code>, followed by <code>===</code>.</p></body></html>"
          },
          {
            "title": "Lesson #16",
            "id": 145514,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Use <code>!==</code> as a condition to run the code block if <code>gameState</code> isn't <code>\"GAME_OVER\"</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"31\" endIndex=\"44\" isDefault=\"true\" /></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" gameState = \" /><text value=\"&quot;PLAYING&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" (gameState !== \" /><text value=\"&quot;GAME_OVER&quot;\" class=\"string\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Continue the game loop&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Make sure to type <code>gameState !==</code>.</p></body></html>"
          },
          {
            "title": "Lesson #17",
            "id": 145515,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Use <code>&gt;</code> to write a condition that checks if the player's <code>health</code> is greater than <code>0</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"42\" endIndex=\"52\" isDefault=\"true\" /></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" health = \" /><text value=\"20\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"let\" class=\"keyword\" /><text value=\" canMove = \" /><text value=\"false\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" (health &gt; \" /><text value=\"0\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\" canMove = \" /><text value=\"true\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(canMove);}\" /></content></code><p visible-if=\"wrong\">Make sure to type <code>health &gt; 0</code>.</p></body></html>"
          },
          {
            "title": "Lesson #18",
            "id": 145516,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Store the equality comparison between <code>inventoryFull</code> and <code>true</code> inside <code>showAlert</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"inventoryFull !== true\" /></content></option><option correct=\"false\"><content><text value=\"true\" /></content></option><option startIndex=\"44\" endIndex=\"66\" /></options></interaction></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" inventoryFull = \" /><text value=\"true\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" showAlert = inventoryFull === \" /><text value=\"true\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" (showAlert) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Inventory full.&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;You can't pick up more items&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Make sure to pick <code>inventoryFull === true</code>.</p></body></html>"
          },
          {
            "title": "Lesson #19",
            "id": 145517,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Use <code>===</code> to code a condition that makes the text display if <code>bossSpawned</code> is <code>true</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"27\" endIndex=\"47\" isDefault=\"true\" /></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" bossSpawned = \" /><text value=\"true\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\"(bossSpawned === \" /><text value=\"true\" class=\"literal\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Boss fight started!&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Make sure to type <code>bossSpawned === true</code>.</p></body></html>"
          }
        ]
      }
    ]
  }
}