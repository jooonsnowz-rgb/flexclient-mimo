            "interactiveContent": "<!DOCTYPE html ><html><body><p>Write code to ensure that the <code>reject</code> function will always execute.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"resolve\" /></content></option><option correct=\"false\"><content><text value=\"forest\" /></content></option><option startIndex=\"286\" endIndex=\"295\" /><option startIndex=\"295\" endIndex=\"296\" /><option startIndex=\"296\" endIndex=\"300\" /><option startIndex=\"300\" endIndex=\"301\" /><option startIndex=\"301\" endIndex=\"308\" /><option startIndex=\"397\" endIndex=\"403\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" levelData = {\" /><text type=\"break\" /><text value=\" \" /><text value=\"forest\" class=\"attr\" /><text value=\": {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"enemies\" class=\"attr\" /><text value=\": \" /><text value=\"20\" class=\"number\" /><text value=\",\" /><text type=\"break\" /><text value=\"  \" /><text value=\"powerUps\" class=\"attr\" /><text value=\": [\" /><text value=\"&quot;health&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;shield&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;speed&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text value=\" },\" /><text type=\"break\" /><text value=\" \" /><text value=\"desert\" class=\"attr\" /><text value=\": {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"enemies\" class=\"attr\" /><text value=\": \" /><text value=\"13\" class=\"number\" /><text value=\",\" /><text type=\"break\" /><text value=\"  \" /><text value=\"powerUps\" class=\"attr\" /><text value=\": [\" /><text value=\"&quot;ammo&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;health&quot;\" class=\"string\" /><text 