            "interactiveContent": "<!DOCTYPE html ><html><body><p>Write code to print a message indicating the purchase is incomplete if the purchase has failed.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"successValue\" /></content></option><option correct=\"false\"><content><text value=\"then\" /></content></option><option correct=\"false\"><content><text value=\"resolve\" /></content></option><option correct=\"false\"><content><text value=\"reject\" /></content></option><option startIndex=\"317\" endIndex=\"330\" /><option startIndex=\"425\" endIndex=\"430\" /><option startIndex=\"469\" endIndex=\"481\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" inventory = {\" /><text type=\"break\" /><text value=\" \" /><text value=\"potions\" class=\"attr\" /><text value=\": \" /><text value=\"10\" class=\"number\" /><text value=\",\" /><text type=\"break\" /><text value=\" \" /><text value=\"arrows\" class=\"attr\" /><text value=\": \" /><text value=\"17\" class=\"number\" /><text value=\",\" /><text type=\"break\" /><text value=\" \" /><text value=\"bombs\" class=\"attr\" /><text value=\": \" /><text value=\"0\" class=\"number\" /><text type=\"break\" /><text value=\"};\" /><text type=\"break\" /><text value=\"let\" class=\"keyword\" /><text value=\" purchase = \" /><text value=\"false\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"buyBombs\" class=\"title\" /><text value=\"(\" /><text value=\"\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" \" /><text value=\"new\" class=\"keyword\" /><text value=\" \" /><text value=\"Promise\" class=\"b