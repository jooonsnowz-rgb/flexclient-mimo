            "interactiveContent": "<!DOCTYPE html ><html><body><p>Complete the <code>if</code> condition to ensure the promise resolves.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"reject\" /></content></option><option correct=\"false\"><content><text value=\"boss\" /></content></option><option startIndex=\"288\" endIndex=\"304\" /><option startIndex=\"304\" endIndex=\"312\" /><option startIndex=\"323\" endIndex=\"330\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" levelData = {\" /><text type=\"break\" /><text value=\" \" /><text value=\"forest\" class=\"attr\" /><text value=\": {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"enemies\" class=\"attr\" /><text value=\": \" /><text value=\"20\" class=\"number\" /><text value=\",\" /><text type=\"break\" /><text value=\"  \" /><text value=\"powerUps\" class=\"attr\" /><text value=\": [\" /><text value=\"&quot;health&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;shield&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;speed&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text value=\" },\" /><text type=\"break\" /><text value=\" \" /><text value=\"desert\" class=\"attr\" /><text value=\": {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"enemies\" class=\"attr\" /><text value=\": \" /><text value=\"13\" class=\"number\" /><text value=\",\" /><text type=\"break\" /><text value=\"  \" /><text value=\"powerUps\" class=\"attr\" /><text value=\": [\" /><text value=\"&quot;ammo&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;health&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;map&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text value=\" },\" /><text type=\"break\