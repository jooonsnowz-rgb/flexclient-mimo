            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Do we need to install packages such as math or random that are part of the Python standard library?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">No, all our Python code has access to those modules</item><item value=\"2\" correct=\"false\">Yes, all modules need to be installed first</item></selection><p visible-if=\"wrong\">No, all our Python code has access to those modules.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Do we need to install packages such as math or random that are part of the Python standard library?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">No, all our Python code has access to those modules</item><item value=\"2\" correct=\"false\">Yes, pip must install <code>math</code> and <code>random</code> into each project</item></selection><p visible-if=\"wrong\">No, all our Python code has access to those modules.</p></body></html>"
