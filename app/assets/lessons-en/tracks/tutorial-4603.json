            "interactiveContent": "<!DOCTYPE html ><html><body><p>Complete the installation of the third-party package <code>tabulate</code>.</p><code version=\"2\" codelang=\"bash\" name=\"script.sh\" visible-if=\"always\"><content><text value=\"pip install data_tools\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"3\" /><option startIndex=\"4\" endIndex=\"11\" /><option startIndex=\"12\" endIndex=\"22\" /><option correct=\"false\"><content><text value=\"random\" /></content></option><option correct=\"false\"><content><text value=\"math\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Make sure to pick <code>pip</code>, followed by <code>install</code>, and finally <code>data_tools</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Complete the installation of the third-party package <code>tabulate</code>.</p><code version=\"2\" codelang=\"bash\" name=\"script.sh\" visible-if=\"always\"><content><text value=\"pip install data_tools\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"4\" endIndex=\"11\" /><option startIndex=\"12\" endIndex=\"22\" /><option correct=\"false\"><content><text value=\"module\" /></content></option><option correct=\"false\"><content><text value=\"main\" /></content></option><option correct=\"false\"><content><text value=\"export\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Make sure to pick <code>install</code>, followed by <code>data_tools</code>.</p></body></html>"
