            "interactiveContent": "<!DOCTYPE html ><html><body><p>Display only <code>\"Checking Score\"</code> in the console by placing it outside the <code>if</code> statement.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"hasFailed\" class=\"title\" /><text value=\"(\" /><text value=\"score\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Checking Score&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" \" /><text value=\"if\" class=\"keyword\" /><text value=\" (score &lt;= \" /><text value=\"50\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Failed&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"hasFailed(\" /><text value=\"80\" class=\"number\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"41\" endIndex=\"57\" /><option startIndex=\"94\" endIndex=\"102\" /></options></interaction></interactions><output><content><text value=\"Checking Score\" /></content></output></code><p visible-if=\"wrong\">Make sure to pick <code>\"Checking Score\"</code>, followed by <code>\"Failed\"</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Fail scores at or below <code>50</code>. Compare <code>score</code> on the left with that limit on the right.</p><p>Check the number <code>80</code>, so the function displays only <code>Checking Score</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"hasFailed\" class=\"title\" /><text value=\"(\" /><text value=\"score\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Checking Score&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" \" /><text value=\"if\" class=\"keyword\" /><text value=\" (score &lt;= \" /><text value=\"50\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Failed&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"hasFailed(\" /><text value=\"80\" class=\"number\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"65\" endIndex=\"70\" /><option startIndex=\"71\" endIndex=\"73\" /><option startIndex=\"74\" endIndex=\"76\" /><option startIndex=\"41\" endIndex=\"57\" /><option startIndex=\"121\" endIndex=\"123\" /><option correct=\"false\"><content><text value=\"&gt;=\" /></content></option><option correct=\"false\"><content><text value=\"&quot;Failed&quot;\" /></content></option><option correct=\"false\"><content><text value=\"false\" /></content></option><option correct=\"false\"><content><text value=\"console.log(score);\" /></content></option></options></interaction></interactions><output><content><text value=\"Checking Score\" /></content></output></code><p visible-if=\"wrong\">Make sure to pick <code>\"Checking Score\"</code>, followed by <code>score</code>, <code>&lt;=</code>, <code>50</code>, and finally <code>80</code>.</p></body></html>",
            "hardModeSelected": true
