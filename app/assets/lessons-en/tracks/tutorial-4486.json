            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Which elements must we identify when we want to remove one element from inside another?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">The parent element and the child element</item><item value=\"2\" correct=\"false\">Only the child element</item></selection><p visible-if=\"wrong\">The parent element and the child element.</p></body></html>"
