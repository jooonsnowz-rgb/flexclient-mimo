            "id": 149026,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Which instruction accesses the parent of the <code>li</code> element?</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><content><text value=\"&lt;!doctype html&gt;\" class=\"meta\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"ol\" class=\"name\" /><text value=\" \" /><text value=\"id\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;inventory&quot;\" class=\"string\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"   \" /><text value=\"&lt;\" /><text value=\"li\" class=\"name\" /><text value=\" \" /><text value=\"id\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;potion&quot;\" class=\"string\" /><text value=\"&gt;\" /><text value=\"Potion\" /><text value=\"&lt;/\" /><text value=\"li\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;/\" /><text value=\"ol\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;/\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;/\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>document.getElementById(\"inventory\")</code></item><item value=\"2\" correct=\"false\"><code>document.getElementById(\"potion\")</code></item></selection><p visible-if=\"wrong\">Make sure to pick <code>document.getElementById(\"inventory\")</code>.</p></body></html>"
          },
