            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Check if <code>my_answer</code> is equal to <code>solution</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"my_answer = \" /><text value=\"&quot;act&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"solution  = \" /><text value=\"&quot;ace&quot;\" class=\"string\" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"print(my_answer == solution)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"54\" endIndex=\"56\" /><option correct=\"false\"><content><text value=\"=\" /></content></option></options></interaction></interactions><output><content><text value=\"False\" /></content></output></code><p visible-if=\"wrong\">Make sure to pick <code>==</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>The words <code>\"act\"</code> and <code>\"ace\"</code> are almost the same, but not equal.</p><p>Compare <code>my_answer</code> with <code>solution</code> so the code prints <code>False</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"my_answer = \" /><text value=\"&quot;act&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"solution  = \" /><text value=\"&quot;ace&quot;\" class=\"string\" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"print(my_answer == solution)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"54\" endIndex=\"56\" /><option correct=\"false\"><content><text value=\"=\" /></content></option><option correct=\"false\"><content><text value=\"!=\" /></content></option></options></interaction></interactions><output><content><text value=\"False\" /></content></output></code><p visible-if=\"wrong\">Make sure to pick <code>==</code>.</p></body></html>",
            "hardModeSelected": true
