            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Which URL targets the product with ID <code>9</code> using a route parameter?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>https://api.example.com/products/9</code></item><item value=\"2\" correct=\"false\"><code>https://api.example.com/products?id=9</code></item><item value=\"3\" correct=\"false\"><code>https://api.example.com/9/products</code></item></selection><p visible-if=\"wrong\">Make sure to pick <code>https://api.example.com/products/9</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Which URL targets the product with ID <code>9</code> using a route parameter?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>https://api.example.com/products/9</code></item><item value=\"2\" correct=\"false\"><code>https://api.example.com/products?id=9</code></item><item value=\"3\" correct=\"false\"><code>https://api.example.com/9/products</code></item><item value=\"4\" correct=\"false\"><code>https://api.example.com/products/id/9</code></item></selection><p visible-if=\"wrong\"><code>https://api.example.com/products/9</code>.</p></body></html>"
