            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Use <code>thing_id</code> as the route parameter in the thing URL.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"thing_id = \" /><text value=\"12\" class=\"number\" /><text type=\"break\" /><text value=\"url = \" /><text value=\"f&quot;https://things.mimo.dev/api/things/\" /><text value=\"{thing_id}\" class=\"subst\" /><text value=\"&quot;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"57\" endIndex=\"67\" /><option correct=\"false\"><content><text value=\"?id=thing_id\" /></content></option><option correct=\"false\"><content><text value=\"{12}\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Make sure to pick <code>{thing_id}</code>.</p></body></html>",
            "hardModeSelected": true
