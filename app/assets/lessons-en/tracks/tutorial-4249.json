            "id": 144942,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Which selector do we use to select all <code>player</code> HUD labels on a given game screen?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">The <code>label</code> tag selector</item><item value=\"2\" correct=\"false\">The <code>hud</code> tag selector</item><item value=\"2\" correct=\"false\">The <code>.label</code> class selector</item></selection><p visible-if=\"wrong\">The <code>label</code> tag selector.</p></body></html>"
