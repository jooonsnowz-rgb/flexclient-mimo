            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>What is a game rule?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">A condition and the actions that happen when it's true</item><item value=\"2\" correct=\"false\">The game window, the player, and the enemies we want to add</item><item value=\"3\" correct=\"false\">One variable assignment</item></selection><p visible-if=\"wrong\">A condition and the actions that happen when it's true.</p></body></html>"
