            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>How do we change how many points the player gains from a coin?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">With the <code>scoreValue</code> property</item><item value=\"2\" correct=\"false\">With the <code>spriteName</code> property</item><item value=\"3\" correct=\"false\">With the <code>fontWeight</code> property</item></selection><p visible-if=\"wrong\">With the <code>scoreValue</code> property.</p></body></html>"
