            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>What happens to a game UI screen if we don't include a link to a particular CSS file?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">The styles in the file won't apply to the screen</item><item value=\"2\" correct=\"false\">We'll get an error on the screen</item><item value=\"2\" correct=\"false\">The styles in the file are partially applied to the screen</item></selection><p visible-if=\"wrong\">The styles in the file won't apply to the screen.</p></body></html>"
