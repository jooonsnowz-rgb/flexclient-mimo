            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Which property does the <code>idle</code> value belong to?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>animation-state</code></item><item value=\"2\" correct=\"false\"><code>sprite-sheet</code></item><item value=\"3\" correct=\"false\"><code>movement-speed</code></item></selection><p visible-if=\"wrong\">Make sure to pick <code>animation-state</code>.</p></body></html>"
