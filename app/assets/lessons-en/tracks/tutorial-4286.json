            "id": 145839,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>What would we use to group the elements in each of the two sections below?</p><webview version=\"2\" content=\"&lt;!DOCTYPE html&gt;&#xA;&lt;html lang=&quot;en&quot;&gt;&#xA;&lt;head&gt;&#xA;    &lt;meta charset=&quot;UTF-8&quot;&gt;&#xA;    &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;&#xA;    &lt;title&gt;Game UI Layout&lt;/title&gt;&#xA;    &lt;style&gt;&#xA;        body {&#xA;            font-family: Arial, sans-serif;&#xA;            display: flex;&#xA;            justify-content: center;&#xA;            align-items: center;&#xA;            margin: 24px;&#xA;            background-color: #0f172a;&#xA;            color: #e2e8f0;&#xA;        }&#xA;        .container {&#xA;            width: 90%;&#xA;            display: flex;&#xA;            flex-direction: column;&#xA;            align-items: center;&#xA;            gap: 18px;&#xA;        }&#xA;        .hud {&#xA;            display: flex;&#xA;            justify-content: center;&#xA;            gap: 20px;&#xA;            flex-wrap: wrap;&#xA;        }&#xA;        .panel {&#xA;            background-color: #111827;&#xA;            border-radius: 10px;&#xA;            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.4);&#xA;            padding: 16px;&#xA;            width: 140px;&#xA;            display: flex;&#xA;            flex-direction: column;&#xA;            align-items: center;&#xA;            gap: 10px;&#xA;            border: 1px solid rgba(255,255,255,0.08);&#xA;        }&#xA;        .icon {&#xA;            width: 100%;&#xA;            height: 90px;&#xA;            background-color: #22c55e;&#xA;            border-radius: 10px;&#xA;        }&#xA;        .bar {&#xA;            width: 90%;&#xA;            height: 18px;&#xA;            background-color: rgba(226,232,240,0.18);&#xA;            border-radius: 6px;&#xA;        }&#xA;    &lt;/style&gt;&#xA;&lt;/head&gt;&#xA;&lt;body&gt;&#xA;    &lt;div class=&quot;container&quot;&gt;&#xA;        &lt;div class=&quot;hud&quot;&gt;&#xA;            &lt;div class=&quot;panel&quot;&gt;&#xA;                &lt;div class=&quot;icon&quot;&gt;&lt;/div&gt;&#xA;                &lt;div class=&quot;bar&quot;&gt;&lt;/div&gt;&#xA;                &lt;div class=&quot;bar&quot; style=&quot;width: 70%;&quot;&gt;&lt;/div&gt;&#xA;            &lt;/div&gt;&#xA;            &lt;div class=&quot;panel&quot;&gt;&#xA;                &lt;div class=&quot;icon&quot; style=&quot;background-color: #3b82f6;&quot;&gt;&lt;/div&gt;&#xA;                &lt;div class=&quot;bar&quot;&gt;&lt;/div&gt;&#xA;                &lt;div class=&quot;bar&quot; style=&quot;width: 70%;&quot;&gt;&lt;/div&gt;&#xA;            &lt;/div&gt;&#xA;        &lt;/div&gt;&#xA;    &lt;/div&gt;&#xA;&lt;/body&gt;&#xA;&lt;/html&gt;\" /><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">A <code>div</code> element</item><item value=\"2\" correct=\"false\">A <code>body</code> element</item><item value=\"3\" correct=\"false\">An <code>img</code> element</item><item value=\"4\" correct=\"false\">A <code>p</code> element</item></selection><p visible-if=\"wrong\">A <code>div</code> element.</p></body></html>"
