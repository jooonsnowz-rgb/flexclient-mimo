            "executableContent": {
              "instructions": "Place emphasis on the text of the link",
              "preselectedFileIndex": 0,
              "hasVisualOutput": true,
              "files": [
                {
                  "name": "index.html",
                  "codeLanguage": "html",
                  "content": "<!doctype html>\n<html>\n <body>\n  <h3>Indie Game Spotlight</h3>\n  <p><a href=\"https://www.celestegame.com\">Celeste\n    game site</a></p>\n </body>\n</html>",
                  "solvedContent": "<!doctype html>\n<html>\n <body>\n  <h3>Indie Game Spotlight</h3>\n  <p><a href=\"https://www.celestegame.com\"><em>Celeste\n     game site</em></a></p>\n </body>\n</html>"
