            "id": 146826,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>What does this code display in the console?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" timer = \" /><text value=\"5\" class=\"number\" /><text value=\"; timer &gt;= \" /><text value=\"0\" class=\"number\" /><text value=\"; timer--) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(timer);\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"false\">The numbers counting up from <code>0</code> to <code>5</code></item><item value=\"2\" correct=\"false\">The numbers counting down from <code>5</code> to <code>1</code></item><item value=\"3\" correct=\"true\">The numbers counting down from <code>5</code> to <code>0</code></item></selection><p visible-if=\"wrong\">The numbers counting down from <code>5</code> to <code>0</code>.</p></body></html>"
          },
