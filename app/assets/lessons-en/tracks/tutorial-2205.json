            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Use the special sign to negate the value.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" isConnected = !\" /><text value=\"true\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"20\" endIndex=\"21\" /><option correct=\"false\"><content><text value=\"&quot;\" /></content></option><option correct=\"false\"><content><text value=\";\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Make sure to pick <code>!</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Negate <code>true</code> to make <code>isConnected</code> false.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" isConnected = !\" /><text value=\"true\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"20\" endIndex=\"21\" /><option correct=\"false\"><content><text value=\"!!\" /></content></option><option correct=\"false\"><content><text value=\"-\" /></content></option><option correct=\"false\"><content><text value=\"not\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Make sure to pick <code>!</code>.</p></body></html>",
            "hardModeSelected": true
