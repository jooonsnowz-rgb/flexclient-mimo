            "id": 59686,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Display the string value in the console.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" ingredients = \" /><text value=\"&quot;Sugar, spice, and everything nice&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(ingredients);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"57\" endIndex=\"68\" /><option startIndex=\"68\" endIndex=\"69\" /><option startIndex=\"69\" endIndex=\"80\" /><option startIndex=\"80\" endIndex=\"81\" /><option correct=\"false\"><content><text value=\"display\" /></content></option></options></interaction></interactions><output><content><text value=\"Sugar, spice, and everything nice\" /></content></output></code><p visible-if=\"wrong\">Make sure to pick <code>console.log</code> followed by <code>(</code> and then <code>ingredients</code>, <code>)</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Print the stored ingredient list, not the variable name as text.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" ingredients = \" /><text value=\"&quot;Sugar, spice, and everything nice&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(ingredients);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"57\" endIndex=\"68\" /><option startIndex=\"68\" endIndex=\"69\" /><option startIndex=\"69\" endIndex=\"80\" /><option startIndex=\"80\" endIndex=\"81\" /><option correct=\"false\"><content><text value=\"display\" /></content></option><option correct=\"false\"><content><text value=\"console\" /></content></option><option correct=\"false\"><content><text value=\"&quot;ingredients&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"Sugar, spice, and everything nice\" /></content></output></code><p visible-if=\"wrong\">Make sure to pick <code>console.log</code>, followed by <code>(</code>, <code>ingredients</code>, and finally <code>)</code>.</p></body></html>",
            "hardModeSelected": true
