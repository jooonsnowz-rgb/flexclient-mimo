            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>What are grouping selectors for?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Styling multiple elements with the same rule</item><item value=\"2\" correct=\"false\">Styling a specific element with a rule</item></selection><p visible-if=\"wrong\">Styling multiple elements with the same rule.</p></body></html>"
