            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>How do we create a grouping selector?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">By adding multiple selectors separated by a comma</item><item value=\"2\" correct=\"false\">By adding multiple selectors separated by a space</item></selection><p visible-if=\"wrong\">By adding multiple selectors separated by a comma.</p></body></html>"
