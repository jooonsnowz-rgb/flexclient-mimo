          {
            "title": "Lesson #3",
            "id": 146334,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>p, button</code> is called a <strong>grouping selector</strong> since it groups different elements under one rule.</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><content><text value=\"&lt;!doctype html&gt;\" class=\"meta\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;\" /><text value=\"head\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"link\" class=\"name\" /><text value=\" \" /><text value=\"rel\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;stylesheet&quot;\" class=\"string\" /><text value=\" \" /><text value=\"href\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;style.css&quot;\" class=\"string\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;/\" /><text value=\"head\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"h2\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Dungeon Dash\" /><text value=\"&lt;/\" /><text value=\"h2\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Score: 0\" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"button\" class=\"name\" /><text value=\" \" /><text value=\"class\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;start&quot;\" class=\"string\" /><text value=\"&gt;\" /><text value=\"START GAME\" /><text value=\"&lt;/\" /><text value=\"button\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;/\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;/\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /></content></code><code name=\"style.css\" version=\"2\" codelang=\"css\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"button\" /></content></option><option startIndex=\"0\" endIndex=\"9\" /></options></interaction></interactions><content><text value=\"p\" class=\"selector-tag\" /><text value=\", \" /><text value=\"button\" class=\"selector-tag\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"font-family\" class=\"attribute\" /><text value=\": Courier New;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\".start\" class=\"selector-class\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"font-size\" class=\"attribute\" /><text value=\": \" /><text value=\"30px\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Make sure to pick <code>p, button</code>.</p></body></html>"
