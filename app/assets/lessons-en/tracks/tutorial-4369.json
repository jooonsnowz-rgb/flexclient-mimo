            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>What property can we use to control the overflow of flex items?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>flex-wrap</code></item><item value=\"2\" correct=\"false\"><code>flex-direction</code></item><item value=\"3\" correct=\"false\"><code>align-items</code></item></selection><p visible-if=\"wrong\">Make sure to pick <code>flex-wrap</code>.</p></body></html>"
