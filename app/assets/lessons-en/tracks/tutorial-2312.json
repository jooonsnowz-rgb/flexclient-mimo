            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Why is <code>first name</code> not a valid variable name?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">Because it contains a space between <code>first</code> and <code>name</code></item><item correct=\"false\" value=\"2\">Because both words need to be capitalized</item><item correct=\"false\" value=\"2\">Because it's not descriptive</item></selection><p visible-if=\"wrong\">Because it contains a space between <code>first</code> and <code>name</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>You write <code>first name = \"Ada\"</code> for a person's first name. Why isn't <code>first name</code> a valid variable name?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Because it uses a space between <code>first</code> and <code>name</code></item><item value=\"2\" correct=\"false\">Because the first word needs a capital letter</item><item value=\"3\" correct=\"false\">Because the name is too descriptive</item></selection><p visible-if=\"wrong\">Because it uses a space between <code>first</code> and <code>name</code>.</p></body></html>"
          },
