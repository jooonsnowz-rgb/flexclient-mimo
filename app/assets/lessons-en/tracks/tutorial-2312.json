            "id": 76089,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>How often can we change the value of a variable?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">As often as we want</item><item correct=\"false\" value=\"2\">Only once</item><item correct=\"false\" value=\"2\">Never</item></selection><p visible-if=\"wrong\">As often as we want.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>A program runs <code>points = 4</code> and later runs <code>points = 8</code>. What is true about <code>points</code>?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">It now stores <code>8</code></item><item value=\"2\" correct=\"false\">It still stores only <code>4</code></item><item value=\"3\" correct=\"false\">Python won't let the value change</item></selection><p visible-if=\"wrong\">Make sure to pick It now stores <code>8</code>.</p></body></html>"
