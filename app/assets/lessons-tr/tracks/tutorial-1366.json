            "id": 89421,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>set()</code> talimatını kullanarak <code>drinks_list</code> içindeki tekrarları kaldır.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"drinks_list = [\" /><text value=\"&quot;matcha&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;chai&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;espresso&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;americano&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;chai&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;matcha&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text value=\"print(set(drinks_list))\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"82\" endIndex=\"85\" /><option startIndex=\"85\" endIndex=\"86\" /><option startIndex=\"86\" endIndex=\"97\" /><option startIndex=\"97\" endIndex=\"98\" /></options></interaction></interactions><output><content><text value=\"{'chai', 'americano', 'espresso', 'matcha'}\" /></content></output></code><p visible-if=\"wrong\">Önce <code>set</code>, ardından <code>(</code> ve sonra <code>drinks_list</code>, <code>)</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Listeyi dönüştürerek <code>drinks_list</code> içindeki her içeceği yalnızca bir kez göster.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"drinks_list = [\" /><text value=\"&quot;matcha&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;chai&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;espresso&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;americano&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;chai&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;matcha&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text value=\"print(set(drinks_list))\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"82\" endIndex=\"85\" /><option startIndex=\"85\" endIndex=\"86\" /><option startIndex=\"86\" endIndex=\"97\" /><option startIndex=\"97\" endIndex=\"98\" /><option correct=\"false\"><content><text value=\"list\" /></content></option><option correct=\"false\"><content><text value=\"tuple\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Önce <code>set</code>, ardından <code>(</code>, <code>drinks_list</code> ve son olarak <code>)</code> öğelerini seçtiğinden emin ol.</p></body></html>",
