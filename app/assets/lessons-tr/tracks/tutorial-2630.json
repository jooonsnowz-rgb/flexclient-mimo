            "contentType": "executableFiles",
            "images": [],
            "executableContent": {
              "instructions": "Her metin öğesinin renginin içeriğini yansıtmasını sağlayacak bir dizi CSS kuralı yaz.\n\n1. `blue` CSS sınıfı için `color` özelliğini `blue` olarak ayarlayan bir kural yaz.\n2. `purple` CSS sınıfı için `color` özelliğini `purple` olarak ayarlayan bir kural yaz.\n3. `red` CSS sınıfı için `color` özelliğini `red` olarak ayarlayan bir kural yaz.",
              "preselectedFileIndex": 1,
              "hasVisualOutput": true,
              "files": [
                {
                  "name": "index.html",
                  "codeLanguage": "html",
                  "content": "<!doctype html>\n<html>\n  <head>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    <p class=\"blue\">This text is blue.</p>\n    <p class=\"purple\">This text is purple.</p>\n    <p class=\"red\">This text is red.</p>\n  </body>\n</html>",
                  "solvedContent": null
                },
                {
                  "name": "style.css",
                  "codeLanguage": "css",
                  "content": "",
                  "solvedContent": ".blue {\n  color: blue;\n}\n\n.purple {\n  color: purple;\n}\n\n.red {\n  color: red;\n}"
                }
              ],
              "hints": []
            }
          }
        ]
      },
