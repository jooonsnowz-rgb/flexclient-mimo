            "id": 73691,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>\"cat\"</code> yazarak ardından <code>\"dog\"</code> yaz ve <code>\"cat\"</code> öğesinin <code>0</code> dizininde, <code>\"dog\"</code> öğesinin ise <code>1</code> dizininde olduğundan emin ol.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" animals = [\" /><text value=\"&quot;cat&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;dog&quot;\" class=\"string\" /><text value=\"];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(animals);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"17\" endIndex=\"22\" /><option startIndex=\"24\" endIndex=\"29\" /><option correct=\"false\"><content><text value=\"&quot;parrot&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"[ 'cat', 'dog' ]\" /></content></output></code><p visible-if=\"wrong\">Önce <code>\"cat\"</code>, ardından <code>\"dog\"</code> öğelerini seçtiğinden emin ol.</p></body></html>",
