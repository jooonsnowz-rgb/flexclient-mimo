            "id": 103696,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Konsolda <code>30</code> görüntülenecek doğru fonksiyon çağrısını yaz.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getArea = \" /><text value=\"(\" /><text value=\"length, width = \" /><text value=\"3\" class=\"number\" /><text value=\") =&gt;\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" length * width;\" /><text type=\"break\" /><text value=\"};\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getArea(\" /><text value=\"10\" class=\"number\" /><text value=\"));\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"80\" endIndex=\"87\" /><option startIndex=\"87\" endIndex=\"88\" /><option startIndex=\"88\" endIndex=\"90\" /><option startIndex=\"90\" endIndex=\"91\" /><option correct=\"false\"><content><text value=\",\" /></content></option><option correct=\"false\"><content><text value=\"30\" /></content></option></options></interaction></interactions><output><content><text value=\"30\" /></content></output></code><p visible-if=\"wrong\">Önce <code>getArea</code>, ardından <code>(</code> ve sonra <code>10</code>, <code>)</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Varsayılan <code>3</code> genişliğini kullan ve <code>30</code> görüntülemek için yalnızca gereken uzunluğu geçir.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getArea = \" /><text value=\"(\" /><text value=\"length, width = \" /><text value=\"3\" class=\"number\" /><text value=\") =&gt;\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" length * width;\" /><text type=\"break\" /><text value=\"};\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getArea(\" /><text value=\"10\" class=\"number\" /><text value=\"));\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"17\" endIndex=\"23\" /><option startIndex=\"25\" endIndex=\"34\" /><option startIndex=\"80\" endIndex=\"87\" /><option startIndex=\"88\" endIndex=\"90\" /><option correct=\"false\"><content><text value=\"width\" /></content></option><option correct=\"false\"><content><text value=\"getArea(30)\" /></content></option><option correct=\"false\"><content><text value=\"3\" /></content></option><option correct=\"false\"><content><text value=\"length, width\" /></content></option></options></interaction></interactions><output><content><text value=\"30\" /></content></output></code><p visible-if=\"wrong\">Önce <code>length</code>, ardından <code>width = 3</code>, <code>getArea</code> ve son olarak <code>10</code> öğelerini seçtiğinden emin ol.</p></body></html>",
