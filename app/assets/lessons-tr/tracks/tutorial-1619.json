            "interactiveContent": "<!DOCTYPE html ><html><body><p>Ok fonksiyonunu tamamla.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getPrice = \" /><text value=\"discount\" class=\"params\" /><text value=\" =&gt;\" /><text value=\" \" /><text value=\"100\" class=\"number\" /><text value=\" - discount;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getPrice(\" /><text value=\"10\" class=\"number\" /><text value=\"));\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"15\" endIndex=\"16\" /><option startIndex=\"17\" endIndex=\"25\" /><option startIndex=\"26\" endIndex=\"28\" /><option correct=\"false\"><content><text value=\"(\" /></content></option><option correct=\"false\"><content><text value=\"}\" /></content></option></options></interaction></interactions><output><content><text value=\"90\" /></content></output></code><p visible-if=\"wrong\">Önce <code>=</code>, ardından <code>discount</code> ve son olarak <code>=&gt;</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Tek parametreli bir ok fonksiyonunda parantez gerekmez. <code>10</code> indiriminin <code>90</code> görüntülemesini sağlayacak şekilde fonksiyonu tamamla.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getPrice = \" /><text value=\"discount\" class=\"params\" /><text value=\" =&gt;\" /><text value=\" \" /><text value=\"100\" class=\"number\" /><text value=\" - discount;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getPrice(\" /><text value=\"10\" class=\"number\" /><text value=\"));\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"6\" endIndex=\"14\" /><option startIndex=\"15\" endIndex=\"16\" /><option startIndex=\"17\" endIndex=\"25\" /><option startIndex=\"26\" endIndex=\"28\" /><option correct=\"false\"><content><text value=\"function\" /></content></option><option correct=\"false\"><content><text value=\"(\" /></content></option><option correct=\"false\"><content><text value=\"price\" /></content></option><option correct=\"false\"><content><text value=\"discount()\" /></content></option></options></interaction></interactions><output><content><text value=\"90\" /></content></output></code><p visible-if=\"wrong\">Önce <code>getPrice</code>, ardından <code>=</code>, <code>discount</code> ve son olarak <code>=&gt;</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeSelected": true
