            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>min()</code> ve liste adını parantezler arasına yazarak bir ölçüm aralığındaki en küçük kirlilik indeksini görüntüle.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"pollution_indices = [\" /><text value=\"5\" class=\"number\" /><text value=\", \" /><text value=\"3\" class=\"number\" /><text value=\", \" /><text value=\"1\" class=\"number\" /><text value=\", \" /><text value=\"7\" class=\"number\" /><text value=\", \" /><text value=\"10\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text value=\"print(min(pollution_indices))\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"43\" endIndex=\"46\" /><option startIndex=\"46\" endIndex=\"47\" /><option startIndex=\"47\" endIndex=\"64\" /><option startIndex=\"64\" endIndex=\"65\" /><option correct=\"false\"><content><text value=\"()\" /></content></option></options></interaction></interactions><output><content><text value=\"1\" /></content></output></code><p visible-if=\"wrong\">Önce <code>min</code>, ardından <code>(</code> ve sonra <code>pollution_indices</code>, <code>)</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>pollution_indices</code> listesi beş ölçüm içeriyor. En küçük değer olan <code>1</code>'i yazdır.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"pollution_indices = [\" /><text value=\"5\" class=\"number\" /><text value=\", \" /><text value=\"3\" class=\"number\" /><text value=\", \" /><text value=\"1\" class=\"number\" /><text value=\", \" /><text value=\"7\" class=\"number\" /><text value=\", \" /><text value=\"10\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text value=\"print(min(pollution_indices))\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"43\" endIndex=\"46\" /><option startIndex=\"46\" endIndex=\"47\" /><option startIndex=\"47\" endIndex=\"64\" /><option startIndex=\"64\" endIndex=\"65\" /><option correct=\"false\"><content><text value=\"max\" /></content></option><option correct=\"false\"><content><text value=\"sum\" /></content></option><option correct=\"false\"><content><text value=\"len\" /></content></option></options></interaction></interactions><output><content><text value=\"1\" /></content></output></code><p visible-if=\"wrong\">Önce <code>min</code>, ardından <code>(</code>, <code>pollution_indices</code> ve son olarak <code>)</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeSelected": true
          },
