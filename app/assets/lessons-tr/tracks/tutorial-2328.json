          {
            "title": "Example: Method call",
            "id": 82864,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bir görüntüleme ifadesi kodla ve <code>points</code> listelerinin toplamını görüntüle.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"points = [\" /><text value=\"12\" class=\"number\" /><text value=\", \" /><text value=\"6\" class=\"number\" /><text value=\", \" /><text value=\"7\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text value=\"print(sum(points))\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"20\" endIndex=\"25\" /><option startIndex=\"37\" endIndex=\"38\" /><option startIndex=\"25\" endIndex=\"26\" /><option startIndex=\"30\" endIndex=\"36\" /><option correct=\"false\"><content><text value=\"sum\" /></content></option></options></interaction></interactions><output><content><text value=\"25\" /></content></output></code><p visible-if=\"wrong\">Önce <code>print</code>, ardından <code>(</code> ve sonra <code>points</code>, <code>)</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>points</code> listesinin toplamı olan <code>25</code>'i görüntüle. Toplama fonksiyonunu görüntüleme çağrısının içine yerleştir.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"points = [\" /><text value=\"12\" class=\"number\" /><text value=\", \" /><text value=\"6\" class=\"number\" /><text value=\", \" /><text value=\"7\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text value=\"print(sum(points))\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"20\" endIndex=\"25\" /><option startIndex=\"26\" endIndex=\"29\" /><option startIndex=\"29\" endIndex=\"30\" /><option startIndex=\"30\" endIndex=\"36\" /><option correct=\"false\"><content><text value=\"max\" /></content></option><option correct=\"false\"><content><text value=\"len\" /></content></option><option correct=\"false\"><content><text value=\"[\" /></content></option></options></interaction></interactions><output><content><text value=\"25\" /></content></output></code><p visible-if=\"wrong\">Önce <code>print</code>, ardından <code>sum</code>, <code>(</code> ve son olarak <code>points</code> öğelerini seçtiğinden emin ol.</p></body></html>"
