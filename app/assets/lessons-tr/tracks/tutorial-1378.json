          {
            "title": "Constructor",
            "id": 89362,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Sonra, burada <code>color</code> ile yaptığımız gibi, örneği oluştururken ayarlamak istediğimiz özel değerler için parametreleri ekleriz.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"Virtual_Pet\" class=\"title\" /><text value=\":\" /><text type=\"break\" /><text value=\"  \" /><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"__init__\" class=\"title\" /><text value=\"(self, color)\" class=\"params\" /><text value=\":\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"40\" endIndex=\"45\" /><option correct=\"false\"><content><text value=\"self\" /></content></option><option startIndex=\"34\" endIndex=\"39\" /></options></interaction></interactions></code><p visible-if=\"wrong\">Önce <code>self,</code>, ardından <code>color</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeSelected": true
