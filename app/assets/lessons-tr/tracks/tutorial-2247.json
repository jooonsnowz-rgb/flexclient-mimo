          {
            "title": "Question: Calling the function",
            "id": 74488,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bir fonksiyonu çağırdığımızda ne olur?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Fonksiyonun içindeki kod çalışır</item><item value=\"2\" correct=\"false\">Fonksiyonun içindeki tüm kod bir değişkende depolanır</item><item value=\"3\" correct=\"false\">Fonksiyonun içinde bir while döngüsü oluşturulur</item></selection><p visible-if=\"wrong\">Fonksiyonun içindeki kod çalışır.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>showMenu</code> üç <code>console.log</code> ifadesi içeriyor. Program <code>showMenu()</code> fonksiyonunu çalıştırdığında ne olur?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Bu üç ifade programın o noktasında çalışır.</item><item value=\"2\" correct=\"false\">İfadeler yeni bir değişkende saklanır.</item><item value=\"3\" correct=\"false\">JavaScript ifadelerin etrafında bir döngü oluşturur.</item></selection><p visible-if=\"wrong\">Bu üç ifade programın o noktasında çalışır.</p></body></html>"
