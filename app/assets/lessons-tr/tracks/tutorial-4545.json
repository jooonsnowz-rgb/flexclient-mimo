            "interactiveContent": "<!DOCTYPE html ><html><body><p>Diğer sınıfların miras aldığı sınıfa ne ad veririz?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Üst sınıf</item><item value=\"2\" correct=\"false\">Genel sınıf</item></selection><p visible-if=\"wrong\">Üst sınıf.</p></body></html>"
          },
