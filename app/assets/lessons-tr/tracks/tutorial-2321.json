            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu kod konsolda ne görüntüler?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"for\" class=\"keyword\" /><text value=\" i \" /><text value=\"in\" class=\"keyword\" /><text value=\" range(\" /><text value=\"3\" class=\"number\" /><text value=\"):\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"&quot;Polly wants a cracker!&quot;\" class=\"string\" /><text value=\")\" /></content><output><content><text value=\"Polly wants a cracker!\" /><text type=\"break\" /><text value=\"Polly wants a cracker!\" /><text type=\"break\" /><text value=\"Polly wants a cracker!\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>Polly wants a cracker!</code> üç kez</item><item value=\"2\" correct=\"false\"><code>1</code> ile <code>3</code> arasındaki sayılar</item><item value=\"3\" correct=\"false\"><code>0</code> ile <code>3</code> arasındaki sayılar</item></selection><p visible-if=\"wrong\"><code>Polly wants a cracker!</code> üç kez.</p></body></html>",
