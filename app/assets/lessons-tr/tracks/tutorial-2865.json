            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Döngü akışını kontrol etmek, yinelemeleri atlamak, döngüden erken çıkmak veya döngüden sonra kod çalıştırmak için <code>continue</code>, <code>break</code> ve <code>else</code> kullanmayı keşfedelim.</p></body></html>",
            "hardModeSelected": true
