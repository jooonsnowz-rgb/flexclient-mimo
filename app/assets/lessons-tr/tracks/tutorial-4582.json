            "id": 151448,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Artık program <code>name</code> değişkenini kullanabilir.</p><p>Eksik satıra <code>name</code> ekle, ardından programı çalıştır.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"name = \" /><text value=\"&quot;Virginia&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"print(\" /><text value=\"&quot;Hello,&quot;\" class=\"string\" /><text value=\", name)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"34\" endIndex=\"38\" /><option correct=\"false\"><content><text value=\"&quot;Virginia&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"Hello, Virginia\" /></content></output></code><p visible-if=\"wrong\"><code>name</code> öğesini seçtiğinden emin ol.</p></body></html>"
