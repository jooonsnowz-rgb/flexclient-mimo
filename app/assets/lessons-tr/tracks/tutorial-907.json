            "id": 58836,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bir görseli görüntülemek için bir görsel etiketi <code>src</code> özniteliğine ihtiyaç duyar. <code>src</code>, kaynak anlamına gelir.</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"h3\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Drawing of \" /><text value=\"&lt;\" /><text value=\"em\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Earthrise\" /><text value=\"&lt;/\" /><text value=\"em\" class=\"name\" /><text value=\"&gt;\" /><text value=\" \" /><text value=\"&lt;/\" /><text value=\"h3\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"img\" class=\"name\" /><text value=\" \" /><text value=\"src\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;https://mimo.app/i/earth.png&quot;\" class=\"string\" /><text value=\"&gt;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"45\" endIndex=\"48\" /><option correct=\"false\"><content><text value=\"source\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\"><code>src</code> öğesini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Bir görseli görüntülemek için bir görsel etiketi <code>src</code> özniteliğine ihtiyaç duyar. <code>src</code>, kaynak anlamına gelir.</p><p><code>https://mimo.app/i/earth.png</code> adresindeki görseli gösterecek şekilde etiketi tamamla.</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"h3\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Drawing of \" /><text value=\"&lt;\" /><text value=\"em\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Earthrise\" /><text value=\"&lt;/\" /><text value=\"em\" class=\"name\" /><text value=\"&gt;\" /><text value=\" \" /><text value=\"&lt;/\" /><text value=\"h3\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"img\" class=\"name\" /><text value=\" \" /><text value=\"src\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;https://mimo.app/i/earth.png&quot;\" class=\"string\" /><text value=\"&gt;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"45\" endIndex=\"48\" /><option startIndex=\"48\" endIndex=\"49\" /><option startIndex=\"49\" endIndex=\"79\" /><option correct=\"false\"><content><text value=\"source\" /></content></option><option correct=\"false\"><content><text value=\"href\" /></content></option><option correct=\"false\"><content><text value=\"&quot;https://mimo.app/i/moon.png&quot;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Önce <code>src</code>, ardından <code>=</code> ve son olarak <code>\"https://mimo.app/i/earth.png\"</code> öğelerini seçtiğinden emin ol.</p></body></html>"
