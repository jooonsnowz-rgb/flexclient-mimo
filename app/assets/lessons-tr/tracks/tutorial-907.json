            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>&lt;img&gt;</code> etiketini boş yapan nedir?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Kapanış etiketi yoktur</item><item value=\"2\" correct=\"false\">Hiçbir özniteliği yoktur</item><item value=\"4\" correct=\"false\">Açılış etiketinde <code>/</code> yoktur</item></selection><p visible-if=\"wrong\">Kapanış etiketi yoktur.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>&lt;img src=\"photo.png\"&gt;</code> yazıyorsun. Bu etiketi hâlâ boş bir etiket yapan nedir?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Kapanış etiketi yoktur</item><item value=\"2\" correct=\"false\">Bir özniteliği olması</item><item value=\"3\" correct=\"false\">Tırnak işaretleri içinde bir dosya adı olması</item></selection><p visible-if=\"wrong\">Kapanış etiketi yoktur öğesini seçtiğinden emin ol.</p></body></html>"
