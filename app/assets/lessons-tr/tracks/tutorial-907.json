            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>&lt;br&gt;</code> gibi, <code>&lt;img&gt;</code> bir <strong>boş etikettir</strong>. Yani kapanış etiketi yoktur.</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"h3\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Drawing of \" /><text value=\"&lt;\" /><text value=\"em\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Earthrise\" /><text value=\"&lt;/\" /><text value=\"em\" class=\"name\" /><text value=\"&gt;\" /><text value=\" \" /><text value=\"&lt;/\" /><text value=\"h3\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"img\" class=\"name\" /><text value=\"&gt;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"40\" endIndex=\"41\" /><option startIndex=\"41\" endIndex=\"44\" /><option startIndex=\"44\" endIndex=\"45\" /><option correct=\"false\"><content><text value=\"&lt;img&gt;&lt;/img&gt;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Önce <code>&lt;</code>, ardından <code>img</code> ve son olarak <code>&gt;</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>&lt;br&gt;</code> gibi <code>&lt;img&gt;</code> de boş etikettir ve kapanış etiketi yoktur. Görsel etiketini bir araya getir.</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"h3\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Drawing of \" /><text value=\"&lt;\" /><text value=\"em\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Earthrise\" /><text value=\"&lt;/\" /><text value=\"em\" class=\"name\" /><text value=\"&gt;\" /><text value=\" \" /><text value=\"&lt;/\" /><text value=\"h3\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"img\" class=\"name\" /><text value=\"&gt;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"40\" endIndex=\"41\" /><option startIndex=\"41\" endIndex=\"44\" /><option startIndex=\"44\" endIndex=\"45\" /><option correct=\"false\"><content><text value=\"&lt;/img&gt;\" /></content></option><option correct=\"false\"><content><text value=\"br\" /></content></option><option correct=\"false\"><content><text value=\"&lt;img&gt;&lt;/img&gt;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Önce <code>&lt;</code>, ardından <code>img</code> ve son olarak <code>&gt;</code> öğelerini seçtiğinden emin ol.</p></body></html>",
