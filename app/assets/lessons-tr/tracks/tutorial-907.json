            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>img</code> etiketi için hangi özniteliği ayarlamamız gerekiyor?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>src</code> özniteliği</item><item value=\"2\" correct=\"false\"><code>href</code> özniteliği</item></selection><p visible-if=\"wrong\"><code>src</code> özniteliği.</p></body></html>",
