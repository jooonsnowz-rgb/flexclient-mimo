          {
            "title": "Example: Condition",
            "id": 93291,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Yalnızca 2000 ile 2020 arasında yayımlanan oyunları almak için <code>WHERE</code>'i bir sütun adıyla birlikte yaz.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"2000\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"2020\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"27\" endIndex=\"40\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></output></code><p visible-if=\"wrong\"><code>WHERE release</code> ifadesini yazdığından emin ol.</p></body></html>"
          },
          {
            "title": "Question: Defining a range",
            "id": 93288,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu sorgu neyi seçer?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" score \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"0\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"50\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">0 ile 50 arasında <code>score</code> değerine sahip <code>players</code> öğeleri</item><item value=\"2\" correct=\"false\"><code>score</code> değeri 50'den büyük olan <code>players</code> öğeleri</item><item value=\"3\" correct=\"false\">Skoru 50'ye eşit olan <code>players</code> öğeleri</item></selection><p visible-if=\"wrong\">0 ile 50 arasında <code>score</code> değerine sahip <code>players</code> öğeleri.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Oyuncuların <code>0</code>, <code>25</code>, <code>50</code> ve <code>51</code> puanları var. Gösterilen sorgu hangi puanları seçer?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" score \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"0\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"50\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>0</code>, <code>25</code> ve <code>50</code></item><item value=\"2\" correct=\"false\">Yalnızca <code>25</code>, çünkü iki sınır da dahil değildir</item><item value=\"3\" correct=\"false\">Yalnızca <code>0</code> ve <code>50</code>, çünkü yalnızca sınırlar eşleşir</item><item value=\"4\" correct=\"false\">Yalnızca <code>51</code>, çünkü <code>BETWEEN</code> üst değerden büyük anlamına gelir</item></selection><p visible-if=\"wrong\"><code>0</code>, <code>25</code> ve <code>50</code> öğesini seçtiğinden emin ol.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example: The keyword BETWEEN",
            "id": 93292,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Koşulu tamamlayarak sonuç tablosunda yalnızca 1990 ile 2000 arasında yayımlanan oyunların görünmesini sağla.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"1990\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"2000\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"41\" endIndex=\"62\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row></table></output></code><p visible-if=\"wrong\"><code>BETWEEN 1990 AND 2000</code> ifadesini yazdığından emin ol.</p></body></html>"
          },
          {
            "title": "Question: Border inclusive",
            "id": 93289,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu sorgu puanı <code>70</code>'e veya <code>100</code>'e eşit olan öğeleri seçer mi?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" score \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"70\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"100\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Evet, çünkü aralıklar sınırlarını da içerir</item><item value=\"2\" correct=\"false\">Hayır, çünkü aralıklar sınırlarını <em>içermez</em></item><item value=\"3\" correct=\"false\">Evet, <em>yalnızca</em><code>score</code> değeri <code>70</code> veya <code>100</code>'e eşit olan öğeleri seçer; aradaki hiçbir şeyi seçmez</item></selection><p visible-if=\"wrong\">Evet, çünkü aralıklar sınırlarını da içerir.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>69</code>, <code>70</code>, <code>85</code>, <code>100</code> ve <code>101</code> puanlarından hangilerini sorgu seçer?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" score \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"70\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"100\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>70</code>, <code>85</code> ve <code>100</code></item><item value=\"2\" correct=\"false\">Yalnızca <code>85</code>, çünkü sınırlar dahil değildir</item><item value=\"3\" correct=\"false\">Yalnızca <code>70</code> ve <code>100</code>, çünkü <code>BETWEEN</code> iki kesin seçeneği listeler</item><item value=\"4\" correct=\"false\"><code>85</code>, <code>100</code> ve <code>101</code>, çünkü yalnızca alt sınır geçerlidir</item></selection><p visible-if=\"wrong\"><code>70</code>, <code>85</code> ve <code>100</code> öğesini seçtiğinden emin ol.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example: Border inclusive",
            "id": 93294,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>1995 ile 2007 arasında yayımlanan oyunların, bu yıllar da dahil olmak üzere, sonuç tablosunda gösterilmesi için bir koşul kodla.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"1995\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"2007\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"27\" endIndex=\"40\" /><option startIndex=\"41\" endIndex=\"48\" /><option startIndex=\"49\" endIndex=\"53\" /><option startIndex=\"54\" endIndex=\"57\" /><option startIndex=\"58\" endIndex=\"62\" /><option correct=\"false\"><content><text value=\"1996\" /></content></option><option correct=\"false\"><content><text value=\"2008\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row></table></output></code><p visible-if=\"wrong\">Önce <code>WHERE release</code>, ardından <code>BETWEEN</code> ve sonra <code>1995</code>, <code>AND</code>, <code>2007</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "Question: A pattern is a text",
            "id": 93785,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Desenleri neden tek tırnakla çevreleriz?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Desenler de metin değerleri olduğu için</item><item value=\"2\" correct=\"false\">Desenleri tek tırnaklarla çevrelemeyiz</item><item value=\"3\" correct=\"false\">Desenin tamamını tek tırnakla çevrelemeyiz; yalnızca joker karakteri <code>%</code> çevreleriz.</item></selection><p visible-if=\"wrong\">Desenler de metin değerleri olduğu için.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Desenler metin değerleridir. Desenin tamamını tek tırnak içine al.</p><p><code>A'%'</code> yazdın. Hangi düzenleme, tüm <code>A%</code> desenini tek bir metin değeri yapar?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Açılış tırnağını <code>A</code> öncesine taşı</item><item value=\"2\" correct=\"false\">İki tırnağı da kaldır</item><item value=\"3\" correct=\"false\">Bunun yerine tırnakları sütun adının çevresine koy</item><item value=\"4\" correct=\"false\">Kapanış tırnağını <code>%</code> öncesine taşı</item></selection><p visible-if=\"wrong\">Açılış tırnağını <code>A</code> öncesine taşı.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Question: Zero or more symbols",
            "id": 93786,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu sorgudaki desen neyle eşleşir?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE users (&#xA;name varchar(255),&#xA;email varchar(255)&#xA;&#xA;);&#xA;&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Tara', 'tara.smith@gmail.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Ben', 'ben.turner@rdelivery.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Joan', 'joan.j@threadandco.uk');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Kim', 'kim.s.lee@gmail.uk');\"><tables><table name=\"users\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Tara\" /><data content=\"tara.smith@gmail.com\" /></row><row><data content=\"Ben\" /><data content=\"ben.turner@rdelivery.com\" /></row><row><data content=\"Joan\" /><data content=\"joan.j@threadandco.uk\" /></row><row><data content=\"Kim\" /><data content=\"kim.s.lee@gmail.uk\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" \" /><text value=\"users\" class=\"keyword\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" email \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'ben%'\" class=\"string\" /><text value=\";\" /></content><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Ben\" /><data content=\"ben.turner@rdelivery.com\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>'ben'</code> metniyle başlayan değerler</item><item value=\"2\" correct=\"false\"><code>'ben'</code> metniyle biten değerler</item><item value=\"3\" correct=\"false\"><code>'ben'</code> metnini içeren değerler</item></selection><p visible-if=\"wrong\"><code>'ben'</code> metniyle başlayan değerler.</p></body></html>"
          },
          {
            "title": "Example: Start with",
            "id": 93790,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>'kim'</code> ile başlayan <code>email</code> değerleriyle eşleşecek bir desen kodla.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE users (&#xA;name varchar(255),&#xA;email varchar(255)&#xA;&#xA;);&#xA;&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Tara', 'tara.smith@gmail.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Ben', 'ben.turner@rdelivery.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Joan', 'joan.j@threadandco.uk');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Kim', 'kim.s.lee@gmail.uk');\"><tables><table name=\"users\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Tara\" /><data content=\"tara.smith@gmail.com\" /></row><row><data content=\"Ben\" /><data content=\"ben.turner@rdelivery.com\" /></row><row><data content=\"Joan\" /><data content=\"joan.j@threadandco.uk\" /></row><row><data content=\"Kim\" /><data content=\"kim.s.lee@gmail.uk\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" \" /><text value=\"users\" class=\"keyword\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" email \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'kim%'\" class=\"string\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"38\" endIndex=\"44\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Kim\" /><data content=\"kim.s.lee@gmail.uk\" /></row></table></output></code><p visible-if=\"wrong\"><code>'kim%'</code> ifadesini yazdığından emin ol.</p></body></html>"
          },
          {
            "title": "Example: End with",
            "id": 93791,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Sonu <code>'.uk'</code> ile biten <code>email</code> değerleriyle eşleşen bir desen kodla.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE users (&#xA;name varchar(255),&#xA;email varchar(255)&#xA;&#xA;);&#xA;&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Tara', 'tara.smith@gmail.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Ben', 'ben.turner@rdelivery.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Joan', 'joan.j@threadandco.uk');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Kim', 'kim.s.lee@gmail.uk');\"><tables><table name=\"users\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Tara\" /><data content=\"tara.smith@gmail.com\" /></row><row><data content=\"Ben\" /><data content=\"ben.turner@rdelivery.com\" /></row><row><data content=\"Joan\" /><data content=\"joan.j@threadandco.uk\" /></row><row><data content=\"Kim\" /><data content=\"kim.s.lee@gmail.uk\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" \" /><text value=\"users\" class=\"keyword\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" email \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'%.uk'\" class=\"string\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"38\" endIndex=\"44\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Joan\" /><data content=\"joan.j@threadandco.uk\" /></row><row><data content=\"Kim\" /><data content=\"kim.s.lee@gmail.uk\" /></row></table></output></code><p visible-if=\"wrong\"><code>'%.uk'</code> ifadesini yazdığından emin ol.</p></body></html>"
          },
          {
            "title": "Example: Containing",
            "id": 93792,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>İki joker karakter ve <code>LIKE</code> kullanarak <code>email</code> sütunundaki değerin <code>'gmail'</code> içerip içermediğini kontrol eden bir koşul yaz.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE users (&#xA;name varchar(255),&#xA;email varchar(255)&#xA;&#xA;);&#xA;&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Tara', 'tara.smith@gmail.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Ben', 'ben.turner@rdelivery.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Joan', 'joan.j@threadandco.uk');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Kim', 'kim.s.lee@gmail.uk');\"><tables><table name=\"users\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Tara\" /><data content=\"tara.smith@gmail.com\" /></row><row><data content=\"Ben\" /><data content=\"ben.turner@rdelivery.com\" /></row><row><data content=\"Joan\" /><data content=\"joan.j@threadandco.uk\" /></row><row><data content=\"Kim\" /><data content=\"kim.s.lee@gmail.uk\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" \" /><text value=\"users\" class=\"keyword\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" email \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'%gmail%'\" class=\"string\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"27\" endIndex=\"47\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Tara\" /><data content=\"tara.smith@gmail.com\" /></row><row><data content=\"Kim\" /><data content=\"kim.s.lee@gmail.uk\" /></row></table></output></code><p visible-if=\"wrong\"><code>email LIKE '%gmail%'</code> ifadesini yazdığından emin ol.</p></body></html>"
          },
          {
            "title": "Example: IN keyword",
            "id": 93813,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>type</code> değeri yalnızca <code>'basic'</code> veya <code>'pro'</code> olan öğeleri seçmek için eksik anahtar kelimeyi yaz.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE membership (&#xA; name varchar(255),&#xA; type varchar(255),&#xA; months_active int&#xA;);&#xA;&#xA;INSERT INTO membership (name, type, months_active)&#xA;VALUES ('Sam', 'free', 2);&#xA;&#xA;INSERT INTO membership (name, type, months_active)&#xA;VALUES ('Remy', 'pro', 1);&#xA;&#xA;INSERT INTO membership (name, type, months_active)&#xA;VALUES ('Luis', 'basic', 12);&#xA;&#xA;INSERT INTO membership (name, type, months_active)&#xA;VALUES ('Kim', 'pro', 7);&#xA;\"><tables><table name=\"membership\"><row><header content=\"name\" /><header content=\"type\" /><header content=\"months_active\" /></row><row><data content=\"Sam\" /><data content=\"free\" /><data content=\"2\" /></row><row><data content=\"Remy\" /><data content=\"pro\" /><data content=\"1\" /></row><row><data content=\"Luis\" /><data content=\"basic\" /><data content=\"12\" /></row><row><data content=\"Kim\" /><data content=\"pro\" /><data content=\"7\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" membership\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"type\" class=\"keyword\" /><text value=\" \" /><text value=\"IN\" class=\"keyword\" /><text value=\" (\" /><text value=\"'basic'\" class=\"string\" /><text value=\", \" /><text value=\"'pro'\" class=\"string\" /><text value=\");\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"37\" endIndex=\"39\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><head