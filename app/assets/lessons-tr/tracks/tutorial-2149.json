            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Veritabanındaki tablo listesi nerede depolanır?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">şema</item><item value=\"2\" correct=\"false\">sorgu</item></selection><p visible-if=\"wrong\">şema öğesini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Bir <code>payments</code> tablosu ekleyip veritabanındaki tablo listesini inceliyorsun. Bu liste nerede tutulur?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Schema içinde</item><item value=\"2\" correct=\"false\"><code>payments</code> tablosunu oluşturan sorguda</item><item value=\"3\" correct=\"false\"><code>payments</code> tablosunun ilk satırında</item></selection><p visible-if=\"wrong\">Schema içinde öğesini seçtiğinden emin ol.</p></body></html>"
