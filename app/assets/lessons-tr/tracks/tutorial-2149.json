sha\" /><data content=\"342\" /></row><row><data content=\"Matt\" /><data content=\"123\" /></row><row><data content=\"Kiana\" /><data content=\"839\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"DROP\" class=\"keyword\" /><text value=\" \" /><text value=\"TABLE\" class=\"keyword\" /><text value=\" past_events; \" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" sqlite_schema \" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"type\" class=\"keyword\" /><text value=\" = \" /><text value=\"&quot;table&quot;\" class=\"string\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"4\" /><option startIndex=\"5\" endIndex=\"10\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /></row><row><data content=\"events\" /></row><row><data content=\"crew\" /></row></table></output></code><p visible-if=\"wrong\">Önce <code>DROP</code>, ardından <code>TABLE</code> öğelerini seçtiğinden emin ol.</p></body></html>"
