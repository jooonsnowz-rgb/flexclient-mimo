            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>wishlist</code> kümesine bir değer ekle; böylece küme değişmeden kalır.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"wishlist = {\" /><text value=\"&quot;earpods&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;notebook&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;handgloves&quot;\" class=\"string\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"wishlist.add(\" /><text value=\"&quot;notebook&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"63\" endIndex=\"73\" /><option correct=\"false\"><content><text value=\"&quot;watch&quot;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\"><code>\"notebook\"</code> öğesini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>wishlist</code> setine, boyutu <code>3</code> olarak kalacak bir değer ekle.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"wishlist\" /><text value=\" \" /><text value=\"=\" /><text value=\" \" /><text value=\"{\" /><text value=\"&quot;earpods&quot;\" class=\"string\" /><text value=\",\" /><text value=\" \" /><text value=\"&quot;notebook&quot;\" class=\"string\" /><text value=\",\" /><text value=\" \" /><text value=\"&quot;handgloves&quot;\" class=\"string\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"wishlist\" /><text value=\".\" /><text value=\"add\" /><text value=\"(\" /><text value=\"&quot;notebook&quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"63\" endIndex=\"73\" /><option correct=\"false\"><content><text value=\"&quot;watch&quot;\" /></content></option><option correct=\"false\"><content><text value=\"&quot;charger&quot;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\"><code>\"notebook\"</code> öğesini seçtiğinden emin ol.</p></body></html>",
