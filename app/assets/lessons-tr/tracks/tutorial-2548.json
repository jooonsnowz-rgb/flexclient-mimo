          {
            "title": "Intro 1",
            "id": 127010,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bir dizinin depolayabileceği değerleri ve bunları nasıl güncelleyebileceğimizi daha derinlemesine inceleyelim. Örneğin bir hava durumu uygulaması sıcaklıkları nasıl takip edebilir?</p><webview version=\"2\" visible-if=\"always\" content=\"&lt;!DOCTYPE html&gt;&#xA;&lt;html lang=&quot;en&quot;&gt;&#xA;&lt;head&gt;&#xA;    &lt;meta charset=&quot;UTF-8&quot;&gt;&#xA;    &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;&#xA;    &lt;title&gt;Weather App&lt;/title&gt;&#xA;    &lt;style&gt;&#xA;        body {&#xA;            font-family: Arial, sans-serif;&#xA;            display: flex;&#xA;            justify-content: center;&#xA;            align-items: center;&#xA;            margin: 24px auto;&#xA;            background: url('background-image.jpg') no-repeat center center;&#xA;            background-size: cover;&#xA;            color: #fff;&#xA;        }&#xA;        .weather-container {&#xA;            background-color: #1e90ff;&#xA;            border-radius: 10px;&#xA;            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);&#xA;            padding: 20px;&#xA;            width: 300px;&#xA;            text-align: center;&#xA;        }&#xA;        .weather-header {&#xA;            font-size: 24px;&#xA;            margin-bottom: 20px;&#xA;        }&#xA;        .weather-days {&#xA;            display: flex;&#xA;            justify-content: space-around;&#xA;            margin-bottom: 20px;&#xA;        }&#xA;        .weather-day {&#xA;            cursor: pointer;&#xA;            padding: 10px;&#xA;            background-color: rgba(255, 255, 255, 0.2);&#xA;        }&#xA;        .weather-day.active {&#xA;            background-color: rgba(255, 255, 255, 0.4);&#xA;        }&#xA;        .weather-forecast {&#xA;            font-size: 16px;&#xA;        }&#xA;        .weather-forecast .time {&#xA;            display: flex;&#xA;            justify-content: space-between;&#xA;            margin-bottom: 10px;&#xA;        }&#xA;        .weather-forecast .time div {&#xA;            flex: 1;&#xA;            text-align: center;&#xA;        }&#xA;    &lt;/style&gt;&#xA;&lt;/head&gt;&#xA;&lt;body&gt;&#xA;    &lt;div class=&quot;weather-container&quot;&gt;&#xA;        &lt;div class=&quot;weather-header&quot;&gt;New York&lt;/div&gt;&#xA;        &lt;div class=&quot;weather-days&quot;&gt;&#xA;            &lt;div class=&quot;weather-day active&quot; data-day=&quot;1&quot;&gt;🌞 Fri, June 1&lt;/div&gt;&#xA;            &lt;div class=&quot;weather-day&quot; data-day=&quot;2&quot;&gt;🌧️ Sat, June 2&lt;/div&gt;&#xA;            &lt;div class=&quot;weather-day&quot; data-day=&quot;3&quot;&gt;⛅ Sun, June 3&lt;/div&gt;&#xA;        &lt;/div&gt;&#xA;        &lt;div class=&quot;weather-forecast&quot;&gt;&#xA;            &lt;div class=&quot;time&quot; data-day=&quot;1&quot;&gt;&#xA;                &lt;div&gt;17°&lt;br&gt;9:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;20°&lt;br&gt;12:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;26°&lt;br&gt;15:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;24°&lt;br&gt;18:00 🌤️&lt;/div&gt;&#xA;                &lt;div&gt;20°&lt;br&gt;21:00 🌙&lt;/div&gt;&#xA;                &lt;div&gt;16°&lt;br&gt;00:00 🌙&lt;/div&gt;&#xA;            &lt;/div&gt;&#xA;            &lt;div class=&quot;time&quot; data-day=&quot;2&quot; style=&quot;display: none;&quot;&gt;&#xA;                &lt;div&gt;18°&lt;br&gt;9:00 ☁️&lt;/div&gt;&#xA;                &lt;div&gt;22°&lt;br&gt;12:00 🌧️&lt;/div&gt;&#xA;                &lt;div&gt;27°&lt;br&gt;15:00 🌧️&lt;/div&gt;&#xA;                &lt;div&gt;25°&lt;br&gt;18:00 ☁️&lt;/div&gt;&#xA;                &lt;div&gt;21°&lt;br&gt;21:00 🌙&lt;/div&gt;&#xA;                &lt;div&gt;17°&lt;br&gt;00:00 🌙&lt;/div&gt;&#xA;            &lt;/div&gt;&#xA;            &lt;div class=&quot;time&quot; data-day=&quot;3&quot; style=&quot;display: none;&quot;&gt;&#xA;                &lt;div&gt;19°&lt;br&gt;9:00 ⛅&lt;/div&gt;&#xA;                &lt;div&gt;23°&lt;br&gt;12:00 ⛅&lt;/div&gt;&#xA;                &lt;div&gt;28°&lt;br&gt;15:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;26°&lt;br&gt;18:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;22°&lt;br&gt;21:00 🌙&lt;/div&gt;&#xA;                &lt;div&gt;18°&lt;br&gt;00:00 🌙&lt;/div&gt;&#xA;            &lt;/div&gt;&#xA;        &lt;/div&gt;&#xA;    &lt;/div&gt;&#xA;&#xA;    &lt;script&gt;&#xA;        document.addEventListener('DOMContentLoaded', function() {&#xA;            const days = document.querySelectorAll('.weather-day');&#xA;            const forecasts = document.querySelectorAll('.weather-forecast .time');&#xA;&#xA;            days.forEach(day =&gt; {&#xA;                day.addEventListener('click', function() {&#xA;                    days.forEach(d =&gt; d.classList.remove('active'));&#xA;                    this.classList.add('active');&#xA;&#xA;                    const day = this.getAttribute('data-day');&#xA;                    forecasts.forEach(forecast =&gt; {&#xA;                        if (forecast.getAttribute('data-day') === day) {&#xA;                            forecast.style.display = 'flex';&#xA;                        } else {&#xA;                            forecast.style.display = 'none';&#xA;                        }&#xA;                    });&#xA;                });&#xA;            });&#xA;        });&#xA;    &lt;/script&gt;&#xA;&lt;/body&gt;&#xA;&lt;/html&gt;\" /></body></html>"
          },
          {
            "title": "Intro 2",
            "id": 127011,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bir dizi, farklı sıcaklık değerlerini depolayabilir ve gün boyunca hava istasyonlarından yeni veriler geldikçe güncellenebilir.</p><webview version=\"2\" visible-if=\"always\" content=\"&lt;!DOCTYPE html&gt;&#xA;&lt;html lang=&quot;en&quot;&gt;&#xA;&lt;head&gt;&#xA;    &lt;meta charset=&quot;UTF-8&quot;&gt;&#xA;    &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;&#xA;    &lt;title&gt;Weather App&lt;/title&gt;&#xA;    &lt;style&gt;&#xA;        body {&#xA;            font-family: Arial, sans-serif;&#xA;            display: flex;&#xA;            justify-content: center;&#xA;            align-items: center;&#xA;            margin: 24px auto;&#xA;            background: url('background-image.jpg') no-repeat center center;&#xA;            background-size: cover;&#xA;            color: #fff;&#xA;        }&#xA;        .weather-container {&#xA;            background-color: #1e90ff;&#xA;            border-radius: 10px;&#xA;            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);&#xA;            padding: 20px;&#xA;            width: 300px;&#xA;            text-align: center;&#xA;        }&#xA;        .weather-header {&#xA;            font-size: 24px;&#xA;            margin-bottom: 20px;&#xA;        }&#xA;        .weather-days {&#xA;            display: flex;&#xA;            justify-content: space-around;&#xA;            margin-bottom: 20px;&#xA;        }&#xA;        .weather-day {&#xA;            cursor: pointer;&#xA;            padding: 10px;&#xA;            background-color: rgba(255, 255, 255, 0.2);&#xA;        }&#xA;        .weather-day.active {&#xA;            background-color: rgba(255, 255, 255, 0.4);&#xA;        }&#xA;        .weather-forecast {&#xA;            font-size: 16px;&#xA;        }&#xA;        .weather-forecast .time {&#xA;            display: flex;&#xA;            justify-content: space-between;&#xA;            margin-bottom: 10px;&#xA;        }&#xA;        .weather-forecast .time div {&#xA;            flex: 1;&#xA;            text-align: center;&#xA;        }&#xA;    &lt;/style&gt;&#xA;&lt;/head&gt;&#xA;&lt;body&gt;&#xA;    &lt;div class=&quot;weather-container&quot;&gt;&#xA;        &lt;div class=&quot;weather-header&quot;&gt;New York&lt;/div&gt;&#xA;        &lt;div class=&quot;weather-days&quot;&gt;&#xA;            &lt;div class=&quot;weather-day active&quot; data-day=&quot;1&quot;&gt;🌞 Fri, June 1&lt;/div&gt;&#xA;            &lt;div class=&quot;weather-day&quot; data-day=&quot;2&quot;&gt;🌧️ Sat, June 2&lt;/div&gt;&#xA;            &lt;div class=&quot;weather-day&quot; data-day=&quot;3&quot;&gt;⛅ Sun, June 3&lt;/div&gt;&#xA;        &lt;/div&gt;&#xA;        &lt;div class=&quot;weather-forecast&quot;&gt;&#xA;            &lt;div class=&quot;time&quot; data-day=&quot;1&quot;&gt;&#xA;                &lt;div&gt;17°&lt;br&gt;9:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;20°&lt;br&gt;12:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;26°&lt;br&gt;15:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;24°&lt;br&gt;18:00 🌤️&lt;/div&gt;&#xA;                &lt;div&gt;20°&lt;br&gt;21:00 🌙&lt;/div&gt;&#xA;                &lt;div&gt;16°&lt;br&gt;00:00 🌙&lt;/div&gt;&#xA;            &lt;/div&gt;&#xA;            &lt;div class=&quot;time&quot; data-day=&quot;2&quot; style=&quot;display: none;&quot;&gt;&#xA;                &lt;div&gt;18°&lt;br&gt;9:00 ☁️&lt;/div&gt;&#xA;                &lt;div&gt;22°&lt;br&gt;12:00 🌧️&lt;/div&gt;&#xA;                &lt;div&gt;27°&lt;br&gt;15:00 🌧️&lt;/div&gt;&#xA;                &lt;div&gt;25°&lt;br&gt;18:00 ☁️&lt;/div&gt;&#xA;                &lt;div&gt;21°&lt;br&gt;21:00 🌙&lt;/div&gt;&#xA;                &lt;div&gt;17°&lt;br&gt;00:00 🌙&lt;/div&gt;&#xA;            &lt;/div&gt;&#xA;            &lt;div class=&quot;time&quot; data-day=&quot;3&quot; style=&quot;display: none;&quot;&gt;&#xA;                &lt;div&gt;19°&lt;br&gt;9:00 ⛅&lt;/div&gt;&#xA;                &lt;div&gt;23°&lt;br&gt;12:00 ⛅&lt;/div&gt;&#xA;                &lt;div&gt;28°&lt;br&gt;15:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;26°&lt;br&gt;18:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;22°&lt;br&gt;21:00 🌙&lt;/div&gt;&#xA;                &lt;div&gt;18°&lt;br&gt;00:00 🌙&lt;/div&gt;&#xA;            &lt;/div&gt;&#xA;        &lt;/div&gt;&#xA;    &lt;/div&gt;&#xA;&#xA;    &lt;script&gt;&#xA;        document.addEventListener('DOMContentLoaded', function() {&#xA;            const days = document.querySelectorAll('.weather-day');&#xA;            const forecasts = document.querySelectorAll('.weather-forecast .time');&#xA;&#xA;            days.forEach(day =&gt; {&#xA;                day.addEventListener('click', function() {&#xA;                    days.forEach(d =&gt; d.classList.remove('active'));&#xA;                    this.classList.add('active');&#xA;&#xA;                    const day = this.getAttribute('data-day');&#xA;                    forecasts.forEach(forecast =&gt; {&#xA;                        if (forecast.getAttribute('data-day') === day) {&#xA;                            forecast.style.display = 'flex';&#xA;                        } else {&#xA;                            forecast.style.display = 'none';&#xA;                        }&#xA;                    });&#xA;                });&#xA;            });&#xA;        });&#xA;    &lt;/script&gt;&#xA;&lt;/body&gt;&#xA;&lt;/html&gt;\" /></body></html>"
          },
