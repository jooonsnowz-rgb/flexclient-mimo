            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bir dizinin bir oyunda (bir seviyedeki düşmanlar gibi) tutabileceği maksimum değer sayısı nedir?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">İstediğimiz kadar</item><item value=\"2\" correct=\"false\">1</item><item value=\"4\" correct=\"false\">10</item></selection><p visible-if=\"wrong\">İstediğimiz kadar.</p></body></html>"
          },
          {
