            "id": 147951,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Öğe nedir?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Bir dizideki değer</item><item value=\"2\" correct=\"false\">Bir dizi</item><item value=\"3\" correct=\"false\">Bir dizinin koşulu</item></selection><p visible-if=\"wrong\">Bir dizideki değer.</p></body></html>"
          },
          {
            "title": "Lesson #3",
            "id": 147952,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>\"Collect 10 coins\"</code> değerine sahip bir diziyi <code>questLog</code> değişkenine ata.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\",\" /></content></option><option correct=\"false\"><content><text value=\"&quot;Defeat the dragon&quot;\" /></content></option><option startIndex=\"17\" endIndex=\"18\" /><option startIndex=\"18\" endIndex=\"36\" /><option startIndex=\"36\" endIndex=\"37\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" questLog = [\" /><text value=\"&quot;Collect 10 coins&quot;\" class=\"string\" /><text value=\"];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Quest Log:&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(questLog);\" /></content></code><p visible-if=\"wrong\">Önce <code>[</code>, ardından <code>\"Collect 10 coins\"</code> ve son olarak <code>]</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "Lesson #4",
            "id": 147953,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>\"forest\"</code> ve <code>\"dungeon\"</code> değerlerini depolayan bir dizi oluştur.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"(\" /></content></option><option correct=\"false\"><content><text value=\")\" /></content></option><option correct=\"false\"><content><text value=\"{\" /></content></option><option correct=\"false\"><content><text value=\"}\" /></content></option><option startIndex=\"15\" endIndex=\"16\" /><option startIndex=\"35\" endIndex=\"36\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" levels = [\" /><text value=\"&quot;forest&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;dungeon&quot;\" class=\"string\" /><text value=\"];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(levels);\" /></content></code><p visible-if=\"wrong\">Önce <code>[</code>, ardından <code>]</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          },
