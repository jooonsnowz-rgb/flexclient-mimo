            "interactiveContent": "<!DOCTYPE html ><html><body><p>Listeleri yönetmeyi ve içlerindeki verileri nasıl güncelleyeceğini, örneğin sıcaklık verilerinin gün boyunca nasıl değişebileceğini daha ayrıntılı inceleyelim.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"temperatures = [\" /><text value=\"17\" class=\"number\" /><text value=\", \" /><text value=\"20\" class=\"number\" /><text value=\", \" /><text value=\"26\" class=\"number\" /><text value=\", \" /><text value=\"24\" class=\"number\" /><text value=\"]\" /></content></code></body></html>",
