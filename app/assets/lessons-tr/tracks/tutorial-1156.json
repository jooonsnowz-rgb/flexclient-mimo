            "id": 79570,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bir listedeki bir öğenin konumuna ne ad veririz?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Öğenin dizini</item><item value=\"2\" correct=\"false\">Öğenin numarası</item></selection><p visible-if=\"wrong\">Öğenin dizini.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Bir listedeki öğenin konumuna indeks denir.</p><p><code>colors[1]</code> ifadesindeki <code>1</code> neyi temsil eder?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Erişilecek öğenin indeksini</item><item value=\"2\" correct=\"false\">Listede depolanan değeri</item><item value=\"3\" correct=\"false\">Listedeki toplam öğe sayısını</item></selection><p visible-if=\"wrong\">Erişilecek öğenin indeksini.</p></body></html>"
