            "hardModeContent": "<!DOCTYPE html ><html><body><p>Bir <code>GET</code> yanıtı için yalnızca standart başarı durumunu kabul et.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"if\" class=\"keyword\" /><text value=\" response.status_code == \" /><text value=\"200\" class=\"number\" /><text value=\":\" /><text type=\"break\" /><text value=\" print(\" /><text value=\"&quot;Success&quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"24\" endIndex=\"26\" /><option startIndex=\"27\" endIndex=\"30\" /><option correct=\"false\"><content><text value=\"!=\" /></content></option><option correct=\"false\"><content><text value=\"404\" /></content></option><option correct=\"false\"><content><text value=\"500\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Önce <code>==</code>, ardından <code>200</code> öğelerini seçtiğinden emin ol.</p></body></html>",
