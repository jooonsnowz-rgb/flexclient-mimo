            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu kod konsolda ne görüntüler?</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" username = \" /><text value=\"&quot;snoopdogg&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Username: &quot;\" class=\"string\" /><text value=\" + username)\" /></content><output><content><text value=\"Username: snoopdogg\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>Username: snoopdogg</code></item><item value=\"2\" correct=\"false\"><code>snoopdogg</code></item></selection><p visible-if=\"wrong\"><code>Username: snoopdogg</code>.</p></body></html>"
