            "executableContent": {
              "instructions": "Bir sudoku bulmacası oluşturarak CSS Grid becerilerimizi geliştirelim.\n\nIzgara kapsayıcısını, ızgara öğelerini ve birkaç stili içeren aşağıdaki şablon kodu kullanacağız. Doğru sınıfları ekleyerek başlayacağız.\n\n1. Üst `div` öğesinin sınıfını `\"grid-container\"` olarak ayarla.",
              "preselectedFileIndex": 0,
              "hasVisualOutput": true,
              "files": [
                {
                  "name": "index.html",
                  "codeLanguage": "html",
                  "content": "<!doctype html>\n<html>\n  <head>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n  <body>\n    <h2>Sudoku Puzzle</h2>\n    <div>\n      <div class=\"grid-item\">1</div>\n      <div class=\"grid-item\"></div>\n      <div class=\"grid-item\"></div>\n      <div class=\"grid-item\">3</div>\n      <div class=\"grid-item\">2</div>\n      <div class=\"grid-item\"></div>\n      <div class=\"grid-item\"></div>\n      <div class=\"grid-item\"></div>\n      <div class=\"grid-item\">1</div>\n    </div>\n  </body>\n</html>",
                  "solvedContent": "<!doctype html>\n<html>\n  <head>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n  <body>\n    <h2>Sudoku Puzzle</h2>\n    <div class=\"grid-container\">\n      <div class=\"grid-item\">1</div>\n      <div class=\"grid-item\"></div>\n      <div class=\"grid-item\"></div>\n      <div class=\"grid-item\">3</div>\n      <div class=\"grid-item\">2</div>\n      <div class=\"grid-item\"></div>\n      <div class=\"grid-item\"></div>\n      <div class=\"grid-item\"></div>\n      <div class=\"grid-item\">1</div>\n    </div>\n  </body>\n</html>"
