          {
            "title": "Question 2",
            "id": 81306,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu kod konsolda ne görüntüler?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"student_grades = [\" /><text value=\"&quot;A&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;A-&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;C&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"for\" class=\"keyword\" /><text value=\" grade \" /><text value=\"in\" class=\"keyword\" /><text value=\" student_grades:\" /><text type=\"break\" /><text value=\"  print(grade)\" /></content><output><content><text value=\"A\" /><text type=\"break\" /><text value=\"A-\" /><text type=\"break\" /><text value=\"C\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>\"A\"</code>, ardından <code>\"A-\"</code> ve son olarak <code>\"C\"</code></item><item value=\"2\" correct=\"false\">Bu kod konsolda hiçbir şey görüntülemeyecek</item></selection><p visible-if=\"wrong\"><code>\"A\"</code>, ardından <code>\"A-\"</code> ve son olarak <code>\"C\"</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>print(grade)</code> yerine <code>print(student_grades[1])</code> yazarsan döngü ne gösterir?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"student_grades = [\" /><text value=\"&quot;A&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;A-&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;C&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"for\" class=\"keyword\" /><text value=\" grade \" /><text value=\"in\" class=\"keyword\" /><text value=\" student_grades:\" /><text type=\"break\" /><text value=\"  print(grade)\" /></content><output><content><text value=\"A\" /><text type=\"break\" /><text value=\"A-\" /><text type=\"break\" /><text value=\"C\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Üç ayrı satırda A-</item><item value=\"2\" correct=\"false\">Ayrı satırlarda A, ardından A-, ardından C</item><item value=\"3\" correct=\"false\">Yalnızca bir kez A-</item></selection><p visible-if=\"wrong\">Üç ayrı satırda A- öğesini seçtiğinden emin ol.</p></body></html>",
            "hardModeSelected": true
