            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>NOT BETWEEN 1 AND 3</code> kodunu yazmak, <code>year</code> değeri <code>1</code>'den küçük veya <code>3</code>'ten büyük olan öğeleri verir.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; year int,&#xA; major varchar(255)&#xA;);&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Ava Smith', 1, 'Biology');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Luis Garcia', 1, 'Physics');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Lin Wong', 3, 'Biology');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Sam Mitchell', 2, 'History');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Nora Hansen', 4, 'Biology');\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row><row><data content=\"Sam Mitchell\" /><data content=\"2\" /><data content=\"History\" /></row><row><data content=\"Nora Hansen\" /><data content=\"4\" /><data content=\"Biology\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" \" /><text value=\"NOT\" class=\"keyword\" /><text value=\" \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"1\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"3\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"34\" endIndex=\"37\" /><option startIndex=\"38\" endIndex=\"45\" /><option startIndex=\"46\" endIndex=\"47\" /><option startIndex=\"48\" endIndex=\"51\" /><option startIndex=\"52\" endIndex=\"53\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Nora Hansen\" /><data content=\"4\" /><data content=\"Biology\" /></row></table></output></code><p visible-if=\"wrong\">Önce <code>NOT</code>, ardından <code>BETWEEN</code> ve sonra <code>1</code>, <code>AND</code>, <code>3</code> öğelerini seçtiğinden emin ol.</p></body></html>"
