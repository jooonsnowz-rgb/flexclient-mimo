            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bir koşulu sağlamayan öğeleri elde etmek için sütun adının ve koşulun operatörünün arasına <code>NOT</code> yazarız.<br /></p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; year int,&#xA; major varchar(255)&#xA;);&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Ava Smith', 1, 'Biology');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Luis Garcia', 1, 'Physics');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Lin Wong', 3, 'Biology');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Sam Mitchell', 2, 'History');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Nora Hansen', 4, 'Biology');\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row><row><data content=\"Sam Mitchell\" /><data content=\"2\" /><data content=\"History\" /></row><row><data content=\"Nora Hansen\" /><data content=\"4\" /><data content=\"Biology\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"NOT\" class=\"keyword\" /><text value=\" \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'a%'\" class=\"string\" /><text value=\" ;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"34\" endIndex=\"37\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row><row><data content=\"Sam Mitchell\" /><data content=\"2\" /><data content=\"History\" /></row><row><data content=\"Nora Hansen\" /><data content=\"4\" /><data content=\"Biology\" /></row></table></output></code><p visible-if=\"wrong\"><code>NOT</code> ifadesini yazdığından emin ol.</p></body></html>"
          },
          {
            "title": "NOT LIKE",
            "id": 94558,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>NOT</code>'u çoğunlukla <code>IN</code>, <code>BETWEEN</code> ve <code>LIKE</code> gibi koşullarla kullanırız. Burada, <code>name</code> değeri <code>a</code> içermeyen öğeleri alıyoruz.<br /></p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; year int,&#xA; major varchar(255)&#xA;);&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Ava Smith', 1, 'Biology');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Luis Garcia', 1, 'Physics');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Lin Wong', 3, 'Biology');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Sam Mitchell', 2, 'History');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Nora Hansen', 4, 'Biology');\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row><row><data content=\"Sam Mitchell\" /><data content=\"2\" /><data content=\"History\" /></row><row><data content=\"Nora Hansen\" /><data content=\"4\" /><data content=\"Biology\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"NOT\" class=\"keyword\" /><text value=\" \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'%a%'\" class=\"string\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"34\" endIndex=\"42\" /><option correct=\"false\"><content><text value=\"BETWEEN\" /></content></option><option startIndex=\"43\" endIndex=\"48\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></output></code><p visible-if=\"wrong\">Önce <code>NOT LIKE</code>, ardından <code>'%a%'</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "NOT IN",
            "id": 94559,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>NOT IN ('History', 'Physics')</code> kodlaması bize <code>major</code> değeri <code>'History'</code> veya <code>'Physics'</code> olmayan tüm öğeleri verir.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; year int,&#xA; major varchar(255)&#xA;);&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Ava Smith', 1, 'Biology');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Luis Garcia', 1, 'Physics');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Lin Wong', 3, 'Biology');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Sam Mitchell', 2, 'History');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Nora Hansen', 4, 'Biology');\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row><row><data content=\"Sam Mitchell\" /><data content=\"2\" /><data content=\"History\" /></row><row><data content=\"Nora Hansen\" /><data content=\"4\" /><data content=\"Biology\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" major \" /><text value=\"NOT\" class=\"keyword\" /><text value=\" \" /><text value=\"IN\" class=\"keyword\" /><text value=\" (\" /><text value=\"'History'\" class=\"string\" /><text value=\", \" /><text value=\"'Physics'\" class=\"string\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"35\" endIndex=\"41\" /><option startIndex=\"42\" endIndex=\"64\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row><row><data content=\"Nora Hansen\" /><data content=\"4\" /><data content=\"Biology\" /></row></table></output></code><p visible-if=\"wrong\">Önce <code>NOT IN</code>, ardından <code>('History', 'Physics')</code> öğelerini seçtiğinden emin ol.</p></body></html>"
