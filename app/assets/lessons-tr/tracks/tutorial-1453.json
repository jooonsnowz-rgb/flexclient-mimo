            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>WHERE</code> yan tümcesinde <code>NOT</code> anahtar sözcüğünü ne zaman kullanırız?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Bir koşulu karşılamayan öğeleri seçmek istediğimizde</item><item value=\"2\" correct=\"false\">Bir koşulu karşılayan öğeleri seçmek istediğimizde</item></selection><p visible-if=\"wrong\">Bir koşulu karşılamayan öğeleri seçmek istediğimizde.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Filtren <code>year = 1970</code> koşulunu <code>NOT</code> ile tersine çeviriyor. <code>1970</code> ve <code>1980</code> yıllarından öğeler var.</p><p>Hangi öğeler kalır?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Yalnızca 1980 yılından öğeler</item><item value=\"2\" correct=\"false\">Yalnızca 1970 yılından öğeler</item><item value=\"3\" correct=\"false\">Her iki yıldan da öğeler</item></selection><p visible-if=\"wrong\">Yalnızca 1980 yılından öğeler.</p></body></html>",
            "hardModeSelected": true
