            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>return</code> ifadesini eklemezsek fonksiyon bunun yerine <code>undefined</code> değerini döndürür.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"111\" endIndex=\"117\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"playerStatus\" class=\"title\" /><text value=\"(\" /><text value=\"hp\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" status = \" /><text value=\"&quot;Player HP: &quot;\" class=\"string\" /><text value=\" + hp;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" result = playerStatus(\" /><text value=\"29\" class=\"number\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(result);\" /></content></code><p visible-if=\"wrong\"><code>result</code> öğesini seçtiğinden emin ol.</p></body></html>"
