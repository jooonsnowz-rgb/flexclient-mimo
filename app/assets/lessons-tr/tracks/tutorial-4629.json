            "title": "Choose a Request Method",
            "id": 152192,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bir istemci, <code>/users/8</code> adresindeki profilin tamamen yerine geçecek yeni bir profil gönderiyor. Bu eyleme hangi HTTP metodu uyar?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>PUT</code></item><item value=\"2\" correct=\"false\"><code>PATCH</code></item><item value=\"3\" correct=\"false\"><code>POST</code></item></selection><p visible-if=\"wrong\"><code>PUT</code> öğesini seçtiğinden emin ol.</p></body></html>",
            "hardModeSelected": true
