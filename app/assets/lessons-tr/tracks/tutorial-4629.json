            "interactiveContent": "<!DOCTYPE html ><html><body><p>Yanıtı JSON olarak ayrıştıran metodu tamamla.</p><code version=\"2\" codelang=\"python\" name=\"response.py\" visible-if=\"always\"><content><text value=\"data = response.json()\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"16\" endIndex=\"20\" /><option correct=\"false\"><content><text value=\"text\" /></content></option><option correct=\"false\"><content><text value=\"status_code\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\"><code>json</code> öğesini seçtiğinden emin ol.</p></body></html>",
            "hardModeSelected": true
