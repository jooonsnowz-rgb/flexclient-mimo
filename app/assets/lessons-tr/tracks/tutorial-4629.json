            "interactiveContent": "<!DOCTYPE html ><html><body><p>Burada ne oluyor?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"requests.put(course_url, json=course_data)\" /><text type=\"break\" /><text value=\"requests.delete(lesson_url)\" /></content></code><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Kod, eksiksiz bir kurs kaydını değiştirir ve ardından eski bir dersi kaldırır</item><item value=\"2\" correct=\"false\">Kod, eksiksiz bir kurs kaydını değiştirir</item><item value=\"3\" correct=\"false\">Kod, eski bir dersi kaldırır</item></selection><p visible-if=\"wrong\">Kod, eksiksiz bir kurs kaydını değiştirir ve ardından eski bir dersi kaldırır.</p></body></html>",
