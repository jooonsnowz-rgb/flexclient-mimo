            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>replayTimes</code> değeri <code>300</code>'e eşit veya büyükse kodu çalıştıran bir koşul kodla.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" song = \" /><text value=\"&quot;Don't stop me now&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"let\" class=\"keyword\" /><text value=\" replayTimes = \" /><text value=\"345\" class=\"number\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" replayTimes &gt;= \" /><text value=\"300\" class=\"number\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Your top song this week: &quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(song)\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"56\" endIndex=\"74\" /><option correct=\"false\"><content><text value=\"song == 300\" /></content></option></options></interaction></interactions><output><content><text value=\"Your top song this week: \" /><text type=\"break\" /><text value=\"Don't stop me now\" /></content></output></code><p visible-if=\"wrong\"><code>replayTimes &gt;= 300</code> öğesini seçtiğinden emin ol.</p></body></html>"
