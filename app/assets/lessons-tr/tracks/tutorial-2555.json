            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu fonksiyondaki parametre nedir?</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"func\" class=\"keyword\" /><text value=\" \" /><text value=\"addUser\" class=\"title\" /><text value=\"(user: String)\" class=\"params\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"let\" class=\"keyword\" /><text value=\" text = \" /><text value=\"&quot;Added: &quot;\" class=\"string\" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(text + user)\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>user</code></item><item value=\"2\" correct=\"false\"><code>text</code></item><item value=\"3\" correct=\"false\">Parametre yok</item></selection><p visible-if=\"wrong\"><code>user</code> öğesini seçtiğinden emin ol.</p></body></html>"
