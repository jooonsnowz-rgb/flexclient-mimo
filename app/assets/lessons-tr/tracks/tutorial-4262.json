          {
            "title": "Lesson #13",
            "id": 145265,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Console'da <code>true</code> değerinin göründüğünden emin olabilir misin?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"!true\" /></content></option><option correct=\"false\"><content><text value=\"false\" /></content></option><option startIndex=\"127\" endIndex=\"135\" /></options></interaction></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" isPaused = \" /><text value=\"false\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Paused:&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(isPaused);\" /><text type=\"break\" /><text type=\"break\" /><text value=\"isPaused = !\" /><text value=\"false\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Paused:&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(isPaused);\" /></content></code><p visible-if=\"wrong\"><code>isPaused</code> öğesini seçtiğinden emin ol.</p></body></html>"
          },
