            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>orders</code> tablosunda <code>customer_id</code> değeri bulunan müşterileri seçerek yalnızca sipariş veren müşterileri elde ederiz.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE customers (&#xA;  id int(11),&#xA;  first_name varchar(50),&#xA;  last_name varchar(50),&#xA;  email varchar(50)&#xA;);&#xA;&#xA;&#xA;CREATE TABLE orders (&#xA;  customer_id int(11),&#xA;  orderDate varchar(50),&#xA;  total int(11) &#xA;);&#xA;&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (1,'1/20/2022',300.43);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (3,'1/01/2022',101.23);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (7,'1/02/2022',25.03);&#xA;INSERT INTO orders(`customer_id`,`orderDate`,`total`) VALUES (7,'2/02/2022',525.03);&#xA;&#xA;&#xA;&#xA;&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (1,'James','Butt','jbutt@gmail.com');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (2,'Josephine','Darakjy','josephine_darakjy@darakjy.org');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (4,'Lenna','Paprocki','lpaprocki@hotmail.com');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (5,'Artie','Foller','donette.foller@cox.net');&#xA;INSERT INTO customers(`id`,`first_name`,`last_name`,`email`) VALUES (6,'Artie','Morasca','simona@morasca.com');&#xA;&#xA;&#xA;\"><tables><table name=\"customers\"><row><header content=\"id\" /><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"1\" /><data content=\"James\" /><data content=\"Butt\" /><data content=\"jbutt@gmail.com\" /></row><row><data content=\"2\" /><data content=\"Josephine\" /><data content=\"Darakjy\" /><data content=\"josephine_darakjy@darakjy.org\" /></row><row><data content=\"4\" /><data content=\"Lenna\" /><data content=\"Paprocki\" /><data content=\"lpaprocki@hotmail.com\" /></row><row><data content=\"5\" /><data content=\"Artie\" /><data content=\"Foller\" /><data content=\"donette.foller@cox.net\" /></row><row><data content=\"6\" /><data content=\"Artie\" /><data content=\"Morasca\" /><data content=\"simona@morasca.com\" /></row></table><table name=\"orders\"><row><header content=\"customer_id\" /><header content=\"orderDate\" /><header content=\"total\" /></row><row><data content=\"1\" /><data content=\"1/20/2022\" /><data content=\"300.43\" /></row><row><data content=\"3\" /><data content=\"1/01/2022\" /><data content=\"101.23\" /></row><row><data content=\"7\" /><data content=\"1/02/2022\" /><data content=\"25.03\" /></row><row><data content=\"7\" /><data content=\"2/02/2022\" /><data content=\"525.03\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" first_name, last_name\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" customers\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" customers.id \" /><text value=\"IN\" class=\"keyword\" /><text value=\" \" /><text type=\"break\" /><text value=\"(\" /><text type=\"break\" /><text value=\" \" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" customer_id \" /><text type=\"break\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" orders\" /><text type=\"break\" /><text value=\");\" /><text type=\"break\" /><text type=\"break\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"70\" endIndex=\"88\" /></interactions><output><table name=\"Result\"><row><header content=\"first_name\" /><header content=\"last_name\" /></row><row><data content=\"James\" /><data content=\"Butt\" /></row></table></output></code><p visible-if=\"wrong\"><code>SELECT customer_id</code> i