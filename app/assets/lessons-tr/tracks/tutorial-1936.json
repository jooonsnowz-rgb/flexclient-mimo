            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu sorgu neyi seçer?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE points(&#xA; name varchar(255),&#xA; alias varchar(255),&#xA; score int&#xA;);&#xA;&#xA;CREATE TABLE prizes(&#xA; score int,&#xA; prize varchar(255)&#xA;);&#xA;&#xA;INSERT INTO points(name, alias, score)&#xA;VALUES('Lucy', 'gaminglucy', 5);&#xA;&#xA;INSERT INTO points(name, alias, score)&#xA;VALUES('Henry', 'hengames', 3);&#xA;&#xA;INSERT INTO points(name, alias, score)&#xA;VALUES('Selene', 'selovesgames', 4);&#xA;&#xA;INSERT INTO points(name, alias, score)&#xA;VALUES('Anonymous', 'heretowin', 8);&#xA;&#xA;INSERT INTO prizes(score, prize)&#xA;VALUES(5, 'Pen');&#xA;&#xA;INSERT INTO prizes(score, prize)&#xA;VALUES(6, 'Badge');&#xA;&#xA;INSERT INTO prizes(score, prize)&#xA;VALUES(7, 'Trinket');&#xA;&#xA;INSERT INTO prizes(score, prize)&#xA;VALUES(8, 'Watch');&#xA;&#xA;INSERT INTO prizes(score, prize)&#xA;VALUES(8, 'Bag');\"><tables><table name=\"points\"><row><header content=\"name\" /><header content=\"alias\" /><header content=\"score\" /></row><row><data content=\"Lucy\" /><data content=\"gaminglucy\" /><data content=\"5\" /></row><row><data content=\"Henry\" /><data content=\"hengames\" /><data content=\"3\" /></row><row><data content=\"Selene\" /><data content=\"selovesgames\" /><data content=\"4\" /></row><row><data content=\"Anonymous\" /><data content=\"heretowin\" /><data content=\"8\" /></row></table><table name=\"prizes\"><row><header content=\"score\" /><header content=\"prize\" /></row><row><data content=\"5\" /><data content=\"Pen\" /></row><row><data content=\"6\" /><data content=\"Badge\" /></row><row><data content=\"7\" /><data content=\"Trinket\" /></row><row><data content=\"8\" /><data content=\"Watch\" /></row><row><data content=\"8\" /><data content=\"Bag\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELEC