            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>scores</code> içindeki her <code>score</code> üzerinde döngü oluşturarak ve yalnızca <code>score</code> 20'den büyükse onu kopyalayarak <code>high_scores</code> listesini oluşturduk.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"scores = [\" /><text value=\"12\" class=\"number\" /><text value=\", \" /><text value=\"47\" class=\"number\" /><text value=\", \" /><text value=\"30\" class=\"number\" /><text value=\", \" /><text value=\"29\" class=\"number\" /><text value=\", \" /><text value=\"19\" class=\"number\" /><text value=\", \" /><text value=\"35\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"high_scores = [score \" /><text value=\"for\" class=\"keyword\" /><text value=\" score \" /><text value=\"in\" class=\"keyword\" /><text value=\" scores \" /><text value=\"if\" class=\"keyword\" /><text value=\" score &gt; \" /><text value=\"20\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(high_scores)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"35\" endIndex=\"46\" /><option startIndex=\"79\" endIndex=\"89\" /></options></interaction></interactions><output><content><text value=\"[47, 30, 29, 35]\" /></content></output></code><p visible-if=\"wrong\">Önce <code>high_scores</code>, ardından <code>score &gt; 20</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>scores</code> içindeki her <code>score</code> üzerinde döngü oluştur ve <code>score</code> değerini yalnızca <code>20</code>'den büyükse kopyala.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"scores = [\" /><text value=\"12\" class=\"number\" /><text value=\", \" /><text value=\"47\" class=\"number\" /><text value=\", \" /><text value=\"30\" class=\"number\" /><text value=\", \" /><text value=\"29\" class=\"number\" /><text value=\", \" /><text value=\"19\" class=\"number\" /><text value=\", \" /><text value=\"35\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"high_scores = [score \" /><text value=\"for\" class=\"keyword\" /><text value=\" score \" /><text value=\"in\" class=\"keyword\" /><text value=\" scores \" /><text value=\"if\" class=\"keyword\" /><text value=\" score &gt; \" /><text value=\"20\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(high_scores)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"50\" endIndex=\"55\" /><option startIndex=\"79\" endIndex=\"89\" /><option correct=\"false\"><content><text value=\"scores\" /></content></option><option correct=\"false\"><content><text value=\"score &gt; 29\" /></content></option></options></interaction></interactions><output><content><text value=\"[47, 30, 29, 35]\" /></content></output></code><p visible-if=\"wrong\">Önce <code>score</code>, ardından <code>score &gt; 20</code> öğelerini seçtiğinden emin ol.</p></body></html>",
