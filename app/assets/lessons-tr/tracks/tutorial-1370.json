            "id": 89684,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>websites</code> içindeki her <code>website</code> üzerinde yinelemek için bir <code>for</code> döngüsü kodla.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"websites = [\" /><text value=\"&quot;nytimes.com&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;lemonde.fr&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;economist.com&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"french = [website \" /><text value=\"for\" class=\"keyword\" /><text value=\" website \" /><text value=\"in\" class=\"keyword\" /><text value=\" websites \" /><text value=\"if\" class=\"keyword\" /><text value=\" website.count(\" /><text value=\"&quot;.fr&quot;\" class=\"string\" /><text value=\") &gt; \" /><text value=\"0\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(french)\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"77\" endIndex=\"100\" /></interactions><output><content><text value=\"['lemonde.fr']\" /></content></output></code><p visible-if=\"wrong\"><code>for website in websites</code> ifadesini yazdığından emin ol.</p></body></html>"
