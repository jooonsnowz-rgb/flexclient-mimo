            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Döngü her tekrarlandığında sayaç değişkeninin azaldığından emin ol.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"i++\" /></content></option><option correct=\"false\"><content><text value=\"i += 1\" /></content></option><option startIndex=\"25\" endIndex=\"28\" /></options></interaction></interactions><content><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"30\" class=\"number\" /><text value=\"; i &gt; \" /><text value=\"25\" class=\"number\" /><text value=\"; i--) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Level starts in:&quot;\" class=\"string\" /><text value=\", i);\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\"><code>i--</code> öğesini seçtiğinden emin ol.</p></body></html>"
          },
