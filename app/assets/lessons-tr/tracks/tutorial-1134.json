            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu kod konsolda ne görüntüler?  </p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"speed = \" /><text value=\"100\" class=\"number\" /><text type=\"break\" /><text value=\"speed = speed + \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(speed)\" /></content><output><content><text value=\"101\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>101</code></item><item value=\"2\" correct=\"false\"><code>100</code></item></selection><p visible-if=\"wrong\"><code>101</code> öğesini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>İkinci satır, konsolun <code>101</code> görüntülemesini nasıl sağlar?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"speed = \" /><text value=\"100\" class=\"number\" /><text type=\"break\" /><text value=\"speed = speed + \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(speed)\" /></content><output><content><text value=\"101\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>100</code> değerini okur, <code>1</code> ekler, ardından <code>101</code> değerini <code>speed</code> değişkeninde depolar.</item><item value=\"2\" correct=\"false\"><code>100</code> ve <code>1</code> rakamlarını birleştirip <code>1001</code> değerini depolar.</item><item value=\"3\" correct=\"false\"><code>101</code> değerini hesaplar ama <code>speed</code> değişkeninde <code>100</code> değerini bırakır.</item></selection><p visible-if=\"wrong\"><code>100</code> değerini okur, <code>1</code> ekler, ardından <code>101</code> değerini <code>speed</code> değişkeninde depolar.</p></body></html>"
