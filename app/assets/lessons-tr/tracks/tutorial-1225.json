            "id": 82582,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Genellikle hafta sonundaki satış değeri gibi tek bir veri kümesinde birleştirmemiz gereken farklı veri kümeleriyle karşılaşırız.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"sales_sat = [\" /><text value=\"50\" class=\"number\" /><text value=\", \" /><text value=\"3\" class=\"number\" /><text value=\", \" /><text value=\"20\" class=\"number\" /><text value=\", \" /><text value=\"22\" class=\"number\" /><text value=\", \" /><text value=\"5\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text value=\"sales_sun = [\" /><text value=\"60\" class=\"number\" /><text value=\", \" /><text value=\"10\" class=\"number\" /><text value=\", \" /><text value=\"9\" class=\"number\" /><text value=\", \" /><text value=\"11\" class=\"number\" /><text value=\", \" /><text value=\"40\" class=\"number\" /><text value=\"]\" /></content></code></body></html>",
            "hardModeSelected": true
