            "id": 82674,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bir bitkinin büyüme hızını depolayan iki listeyi birleştirmek için <code>+</code> kodunu yaz.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"growth_rate_1 = [\" /><text value=\"0.5\" class=\"number\" /><text value=\", \" /><text value=\"0.7\" class=\"number\" /><text value=\", \" /><text value=\"0.8\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text value=\"growth_rate_2 = [\" /><text value=\"0.8\" class=\"number\" /><text value=\", \" /><text value=\"0.6\" class=\"number\" /><text value=\", \" /><text value=\"0.6\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(growth_rate_1 + growth_rate_2)\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"85\" endIndex=\"86\" /></interactions><output><content><text value=\"[0.5, 0.7, 0.8, 0.8, 0.6, 0.6]\" /></content></output></code><p visible-if=\"wrong\"><code>+</code> ifadesini yazdığından emin ol.</p></body></html>"
