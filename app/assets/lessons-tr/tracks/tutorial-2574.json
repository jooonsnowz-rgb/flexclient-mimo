            "title": "Example 2",
            "id": 127505,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>name</code> değişkenini görüntüleyen görüntüleme ifadesini, <code>name</code> kodunu yazarak tamamla.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"Pokemon\" class=\"title\" /><text value=\" \" /><text value=\"{\" /><text type=\"break\" /><text value=\"  \" /><text value=\"let\" class=\"keyword\" /><text value=\" name = \" /><text value=\"&quot;pikachu&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"  \" /><text value=\"func\" class=\"keyword\" /><text value=\" \" /><text value=\"introduce\" class=\"title\" /><text value=\"()\" class=\"params\" /><text value=\" {\" /><text type=\"break\" /><text value=\"    \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Hi!&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"    \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;I am &quot;\" class=\"string\" /><text value=\" + name)\" /><text type=\"break\" /><text value=\"  }\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"98\" endIndex=\"102\" /></interactions></code><p visible-if=\"wrong\"><code>name</code> ifadesini yazdığından emin ol.</p></body></html>"
          },
