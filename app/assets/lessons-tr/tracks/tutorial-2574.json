            "title": "Example 1",
            "id": 127504,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pokemon sınıfının içinde <code>introduce</code> adlı bir sınıf metodu tanımla.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"Pokemon\" class=\"title\" /><text value=\" \" /><text value=\"{\" /><text type=\"break\" /><text value=\"  \" /><text value=\"let\" class=\"keyword\" /><text value=\" name = \" /><text value=\"&quot;pikachu&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"  \" /><text value=\"func\" class=\"keyword\" /><text value=\" \" /><text value=\"introduce\" class=\"title\" /><text value=\"()\" class=\"params\" /><text value=\" {\" /><text type=\"break\" /><text value=\"    \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Hi!&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"  }\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"42\" endIndex=\"46\" /><option startIndex=\"47\" endIndex=\"56\" /><option startIndex=\"56\" endIndex=\"58\" /><option startIndex=\"59\" endIndex=\"60\" /><option startIndex=\"80\" endIndex=\"81\" /></options></interaction></interactions></code><p visible-if=\"wrong\">Önce <code>func</code>, ardından <code>introduce</code> ve sonra <code>()</code>, <code>{</code>, <code>}</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          },
