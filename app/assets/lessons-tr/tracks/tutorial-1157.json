            "id": 79677,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bir listedeki değerleri nasıl ekleyip kaldıracağını öğrenelim. Bu uygulamada olduğu gibi, kullanıcıların puan verilerini yönetmek için bir liste kullanılıyor.</p><webview version=\"2\" visible-if=\"always\" content=\"&lt;!DOCTYPE html&gt;&#xA;&lt;html lang=&quot;en&quot;&gt;&#xA;&lt;head&gt;&#xA;    &lt;meta charset=&quot;UTF-8&quot;&gt;&#xA;    &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;&#xA;    &lt;title&gt;Leaderboard&lt;/title&gt;&#xA;    &lt;link rel=&quot;stylesheet&quot; href=&quot;https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css&quot;&gt;&#xA;    &lt;style&gt;&#xA;        body {&#xA;            font-family: Arial, sans-serif;&#xA;        }&#xA;        .leaderboard {&#xA;            width: 300px;&#xA;            border: 1px solid #ccc;&#xA;            border-radius: 5px;&#xA;            overflow: hidden;&#xA;            margin: 20px auto;&#xA;        }&#xA;        .leaderboard-header {&#xA;            background-color: #2b5188;&#xA;            color: white;&#xA;            padding: 10px;&#xA;            font-size: 16px;&#xA;            display: flex;&#xA;            justify-content: space-between;&#xA;            align-items: center;&#xA;        }&#xA;        .leaderboard-header .trophy {&#xA;            margin-left: 10px;&#xA;        }&#xA;        .leaderboard-list {&#xA;            list-style: none;&#xA;            margin: 0;&#xA;            padding: 0;&#xA;        }&#xA;        .leaderboard-list li {&#xA;            padding: 10px;&#xA;            display: flex;&#xA;            justify-content: space-between;&#xA;            align-items: center;&#xA;            border-bottom: 1px solid #f0f0f0;&#xA;        }&#xA;        .leaderboard-list li:nth-child(odd) {&#xA;            background-color: #f9f9f9;&#xA;        }&#xA;        .leaderboard-list li:last-child {&#xA;            border-bottom: none;&#xA;        }&#xA;        .position {&#xA;            font-size: 14px;&#xA;            color: #555;&#xA;        }&#xA;        .score {&#xA;            font-size: 14px;&#xA;            color: #333;&#xA;        }&#xA;    &lt;/style&gt;&#xA;&lt;/head&gt;&#xA;&lt;body&gt;&#xA;    &lt;div class=&quot;leaderboard&quot;&gt;&#xA;        &lt;div class=&quot;leaderboard-header&quot;&gt;&#xA;            &lt;span&gt;ROUNDS WON&lt;/span&gt;&#xA;            &lt;span class=&quot;trophy&quot;&gt;4 &lt;i class=&quot;fas fa-trophy&quot; style=&quot;color: gold;&quot;&gt;&lt;/i&gt;&lt;/span&gt;&#xA;        &lt;/div&gt;&#xA;        &lt;ul class=&quot;leaderboard-list&quot;&gt;&#xA;            &lt;li&gt;&lt;span class=&quot;position&quot;&gt;4.&lt;/span&gt; &lt;span class=&quot;score&quot;&gt;20&lt;/span&gt;&lt;/li&gt;&#xA;            &lt;li&gt;&lt;span class=&quot;position&quot;&gt;3.&lt;/span&gt; &lt;span class=&quot;score&quot;&gt;25&lt;/span&gt;&lt;/li&gt;&#xA;            &lt;li&gt;&lt;span class=&quot;position&quot;&gt;2.&lt;/span&gt; &lt;span class=&quot;score&quot;&gt;23&lt;/span&gt;&lt;/li&gt;&#xA;            &lt;li&gt;&lt;span class=&quot;position&quot;&gt;1.&lt;/span&gt; &lt;span class=&quot;score&quot;&gt;24&lt;/span&gt;&lt;/li&gt;&#xA;        &lt;/ul&gt;&#xA;    &lt;/div&gt;&#xA;&lt;/body&gt;&#xA;&lt;/html&gt;\" /></body></html>",
