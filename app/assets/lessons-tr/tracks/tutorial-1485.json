            "id": 96461,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tablo veya sütun adları, buradaki <code>first_name</code> ve <code>last_name</code> gibi oldukça uzun olabilir.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE contacts (&#xA; first_name varchar(255),&#xA; last_name varchar(255),&#xA; email varchar(255)&#xA;);&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Sam', 'Smith', 'sam17@mail.com');&#xA;&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Remy', 'Allard', 'rem@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Luis', 'Martinez', 'luis_99@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Kim', 'Zhong', 'kim.z@mail.com');&#xA;\"><tables><table name=\"contacts\"><row><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"Sam\" /><data content=\"Smith\" /><data content=\"sam17@mail.com\" /></row><row><data content=\"Remy\" /><data content=\"Allard\" /><data content=\"rem@mail.com\" /></row><row><data content=\"Luis\" /><data content=\"Martinez\" /><data content=\"luis_99@mail.com\" /></row><row><data content=\"Kim\" /><data content=\"Zhong\" /><data content=\"kim.z@mail.com\" /></row></table></tables></database></body></html>"
          },
          {
            "title": "Intro 2",
            "id": 96462,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>first_name</code> gibi adları basitleştirmek veya bir sorgu içindeki sütunlara farklı bir anlam vermek için <strong>takma ad kullanma</strong> yöntemini kullanırız.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE contacts (&#xA; first_name varchar(255),&#xA; last_name varchar(255),&#xA; email varchar(255)&#xA;);&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Sam', 'Smith', 'sam17@mail.com');&#xA;&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Remy', 'Allard', 'rem@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Luis', 'Martinez', 'luis_99@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Kim', 'Zhong', 'kim.z@mail.com');&#xA;\"><tables><table name=\"contacts\"><row><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"Sam\" /><data content=\"Smith\" /><data content=\"sam17@mail.com\" /></row><row><data content=\"Remy\" /><data content=\"Allard\" /><data content=\"rem@mail.com\" /></row><row><data content=\"Luis\" /><data content=\"Martinez\" /><data content=\"luis_99@mail.com\" /></row><row><data content=\"Kim\" /><data content=\"Zhong\" /><data content=\"kim.z@mail.com\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" first_name\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" contacts;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"17\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"first_name\" /></row><row><data content=\"Sam\" /></row><row><data content=\"Remy\" /></row><row><data content=\"Luis\" /></row><row><data content=\"Kim\" /></row></table></output></code><p visible-if=\"wrong\">Önce <code>SELECT</code>, ardından <code>first_name</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "Aliasing",
            "id": 96463,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bir sütuna <strong>takma ad</strong> vererek ona geçici bir ad atarız. Burada <code>first_name</code> sütununu <code>user</code> olarak yeniden adlandırıyoruz.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE contacts (&#xA; first_name varchar(255),&#xA; last_name varchar(255),&#xA; email varchar(255)&#xA;);&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Sam', 'Smith', 'sam17@mail.com');&#xA;&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Remy', 'Allard', 'rem@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Luis', 'Martinez', 'luis_99@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Kim', 'Zhong', 'kim.z@mail.com');&#xA;\"><tables><table name=\"contacts\"><row><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"Sam\" /><data content=\"Smith\" /><data content=\"sam17@mail.com\" /></row><row><data content=\"Remy\" /><data content=\"Allard\" /><data content=\"rem@mail.com\" /></row><row><data content=\"Luis\" /><data content=\"Martinez\" /><data content=\"luis_99@mail.com\" /></row><row><data content=\"Kim\" /><data content=\"Zhong\" /><data content=\"kim.z@mail.com\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" first_name \" /><text value=\"AS\" class=\"keyword\" /><text value=\" \" /><text value=\"user\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" contacts;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"18\" endIndex=\"25\" /><option correct=\"false\"><content><text value=\"AS person\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"user\" /></row><row><data content=\"Sam\" /></row><row><data content=\"Remy\" /></row><row><data content=\"Luis\" /></row><row><data content=\"Kim\" /></row></table></output></code><p visible-if=\"wrong\"><code>AS user</code> öğesini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "AS",
            "id": 96465,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Takma ad verirken, önce her zamanki gibi sütunu seçeriz. Ardından <code>AS</code> kullanarak <code>user</code> gibi bir takma ad veririz.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE contacts (&#xA; first_name varchar(255),&#xA; last_name varchar(255),&#xA; email varchar(255)&#xA;);&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Sam', 'Smith', 'sam17@mail.com');&#xA;&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Remy', 'Allard', 'rem@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Luis', 'Martinez', 'luis_99@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Kim', 'Zhong', 'kim.z@mail.com');&#xA;\"><tables><table name=\"contacts\"><row><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"Sam\" /><data content=\"Smith\" /><data content=\"sam17@mail.com\" /></row><row><data content=\"Remy\" /><data content=\"Allard\" /><data content=\"rem@mail.com\" /></row><row><data content=\"Luis\" /><data content=\"Martinez\" /><data content=\"luis_99@mail.com\" /></row><row><data content=\"Kim\" /><data content=\"Zhong\" /><data content=\"kim.z@mail.com\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" first_name \" /><text value=\"AS\" class=\"keyword\" /><text value=\" \" /><text value=\"user\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" contacts;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"18\" endIndex=\"25\" /></interactions><output><table name=\"Result\"><row><header content=\"user\" /></row><row><data content=\"Sam\" /></row><row><data content=\"Remy\" /></row><row><data content=\"Luis\" /></row><row><data content=\"Kim\" /></row></table></output></code><p visible-if=\"wrong\"><code>AS user</code> ifadesini yazdığından emin ol.</p></body></html>"
          },
          {
            "title": "Only within the query",
            "id": 96464,
