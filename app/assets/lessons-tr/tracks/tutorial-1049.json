            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>attributes</code> ne işe yarar?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Etiketler hakkında ek bilgi sağlamak</item><item value=\"2\" correct=\"false\">Tüm etiketleri bağlantılara dönüştürmek</item></selection><p visible-if=\"wrong\">Etiketler hakkında ek bilgi sağlamak.</p></body></html>",
