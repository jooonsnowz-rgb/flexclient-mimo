          {
            "title": "HTML element",
            "id": 133492,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>İlk olarak <code>html</code> etiketlerine ihtiyacımız var. Bu etiketlerin arasında henüz içerik olmadığı için hiçbir şey görüntülenmeyecek.</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;/\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"14\" /></options></interaction></interactions></code><p visible-if=\"wrong\">Önce <code>&lt;html&gt;</code>, ardından <code>&lt;/html&gt;</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          },
