          {
            "title": "Question: Counter variable",
            "id": 74825,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu koddaki sayaç değişkeninin adı nedir?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Fastest runners:&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" index = \" /><text value=\"1\" class=\"number\" /><text value=\"; index &lt; \" /><text value=\"4\" class=\"number\" /><text value=\"; index++) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(index + \" /><text value=\"&quot;.&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content><output><content><text value=\"Fastest runners:\" /><text type=\"break\" /><text value=\"1.\" /><text type=\"break\" /><text value=\"2.\" /><text type=\"break\" /><text value=\"3.\" /></content></output></code><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>index</code></item><item value=\"2\" correct=\"false\"><code>i</code></item><item value=\"3\" correct=\"false\"><code>Fastest runners:</code></item></selection><p visible-if=\"wrong\"><code>index</code> öğesini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Bu koddaki sayaç değişkeninin adı nedir?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Fastest runners:&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" index = \" /><text value=\"1\" class=\"number\" /><text value=\"; index &lt; \" /><text value=\"4\" class=\"number\" /><text value=\"; index++) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(index + \" /><text value=\"&quot;.&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content><output><content><text value=\"Fastest runners:\" /><text type=\"break\" /><text value=\"1.\" /><text type=\"break\" /><text value=\"2.\" /><text type=\"break\" /><text value=\"3.\" /></content></output></code><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>index</code></item><item value=\"2\" correct=\"false\"><code>i</code></item><item value=\"3\" correct=\"false\"><code>Fastest runners:</code></item><item value=\"4\" correct=\"false\"><code>counter</code></item></selection><p visible-if=\"wrong\"><code>index</code> öğesini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "Example: All in one",
            "id": 74835,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>1'den <code>4</code>'e kadar olan sayıları konsola yazdırmak için for döngüsünü oluştur.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"1\" class=\"number\" /><text value=\"; i &lt; \" /><text value=\"5\" class=\"number\" /><text value=\"; i++) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(i);\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"16\" endIndex=\"21\" /><option startIndex=\"31\" endIndex=\"45\" /><option correct=\"false\"><content><text value=\"i &gt; 5\" /></content></option><option correct=\"false\"><content><text value=\"i &lt; 4\" /></content></option></options></interaction></interactions><output><content><text value=\"1\" /><text type=\"break\" /><text value=\"2\" /><text type=\"break\" /><text value=\"3\" /><text type=\"break\" /><text value=\"4\" /></content></output></code><p visible-if=\"wrong\">Önce <code>i &lt; 5</code>, ardından <code>console.log(i)</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Döngüyü <code>1</code>'den <code>4</code>'e kadar olan sayıları gösterecek şekilde tamamla.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"1\" class=\"number\" /><text value=\"; i &lt; \" /><text value=\"5\" class=\"number\" /><text value=\"; i++) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(i);\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"13\" endIndex=\"14\" /><option startIndex=\"20\" endIndex=\"21\" /><option startIndex=\"23\" endIndex=\"26\" /><option startIndex=\"31\" endIndex=\"45\" /><option correct=\"false\"><content><text value=\"0\" /></content></option><option correct=\"false\"><content><text value=\"4\" /></content></option><option correct=\"false\"><content><text value=\"i--\" /></content></option><option correct=\"false\"><content><text value=\"console.log(1)\" /></content></option></options></interaction></interactions><output><content><text value=\"1\" /><text type=\"break\" /><text value=\"2\" /><text type=\"break\" /><text value=\"3\" /><text type=\"break\" /><text value=\"4\" /></content></output></code><p visible-if=\"wrong\">Önce <code>1</code>, ardından <code>5</code>, <code>i++</code> ve son olarak <code>console.log(i)</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeSelected": true
          },
