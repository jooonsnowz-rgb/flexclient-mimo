            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bir listenin öğelerini toplamamızı hangi kod sağlar?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>sum()</code></item><item value=\"2\" correct=\"false\"><code>+</code></item><item value=\"3\" correct=\"false\">Böyle bir kod yok</item><item value=\"4\" correct=\"false\"><code>add()</code></item></selection><p visible-if=\"wrong\"><code>sum()</code> öğesini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "Example: Method call",
            "id": 82933,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>published</code> içindeki yayımlanmış makalelerin toplamını görüntüle.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"published = [\" /><text value=\"102\" class=\"number\" /><text value=\", \" /><text value=\"200\" class=\"number\" /><text value=\", \" /><text value=\"90\" class=\"number\" /><text value=\", \" /><text value=\"111\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text value=\"print(sum(published))\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"32\" endIndex=\"53\" /></interactions><output><content><text value=\"503\" /></content></output></code><p visible-if=\"wrong\"><code>print(sum(published))</code> ifadesini yazdığından emin ol.</p></body></html>"
          },
          {
