            "id": 82966,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Listeleri, <code>customers</code> öğeleri önce görünecek şekilde birleştir.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"customers = [\" /><text value=\"&quot;Jess&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Mike&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Lynn&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text value=\"order_numbers = [\" /><text value=\"3\" class=\"number\" /><text value=\", \" /><text value=\"1\" class=\"number\" /><text value=\", \" /><text value=\"2\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"orders = customers + order_numbers\" /><text type=\"break\" /><text value=\"print(orders)\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"73\" endIndex=\"98\" /></interactions><output><content><text value=\"['Jess', 'Mike', 'Lynn', 3, 1, 2]\" /></content></output></code><p visible-if=\"wrong\"><code>customers + order_numbers</code> ifadesini yazdığından emin ol.</p></body></html>"
          },
