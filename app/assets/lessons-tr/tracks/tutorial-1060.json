            "id": 71879,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>wallet</code> değişkeninin değerini bir artır.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" wallet = \" /><text value=\"13\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"wallet++;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(wallet);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"17\" endIndex=\"23\" /><option startIndex=\"23\" endIndex=\"24\" /><option startIndex=\"24\" endIndex=\"25\" /><option correct=\"false\"><content><text value=\"wallet + 2\" /></content></option></options></interaction></interactions><output><content><text value=\"14\" /></content></output></code><p visible-if=\"wrong\">Önce <code>wallet</code>, ardından <code>+</code> ve son olarak <code>+</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>wallet</code> değerini bir artır. Artırma operatörünü değişken adından sonra yaz.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" wallet = \" /><text value=\"13\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"wallet++;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(wallet);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"17\" endIndex=\"23\" /><option startIndex=\"23\" endIndex=\"24\" /><option startIndex=\"24\" endIndex=\"25\" /><option correct=\"false\"><content><text value=\"-\" /></content></option><option correct=\"false\"><content><text value=\"=\" /></content></option><option correct=\"false\"><content><text value=\"13\" /></content></option></options></interaction></interactions><output><content><text value=\"14\" /></content></output></code><p visible-if=\"wrong\">Önce <code>wallet</code>, ardından <code>+</code> ve son olarak <code>+</code> öğelerini seçtiğinden emin ol.</p></body></html>",
