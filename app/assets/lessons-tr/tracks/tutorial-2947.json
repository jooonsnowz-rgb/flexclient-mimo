            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>\"/friends\"</code>'dan <code>\"/homies\"</code>'e yönlendir.</p><code version=\"2\" codelang=\"javascript\" name=\"app.js\" visible-if=\"always\"><content><text value=\"app.get(\" /><text value=\"&quot;/friends&quot;\" class=\"string\" /><text value=\", \" /><text value=\"function\" class=\"keyword\" /><text value=\"(\" /><text value=\"req, res\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" res.redirect(\" /><text value=\"302\" class=\"number\" /><text value=\", \" /><text value=\"&quot;/homies&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"});\" /><text type=\"break\" /><text type=\"break\" /><text value=\"app.get(\" /><text value=\"&quot;/homies&quot;\" class=\"string\" /><text value=\", \" /><text value=\"function\" class=\"keyword\" /><text value=\"(\" /><text value=\"req, res\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" res.status(\" /><text value=\"200\" class=\"number\" /><text value=\").send(\" /><text value=\"&quot;What's up?&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"});\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"8\" endIndex=\"18\" /><option startIndex=\"85\" endIndex=\"94\" /><option startIndex=\"60\" endIndex=\"69\" /><option correct=\"false\"><content><text value=\"&quot;/friends&quot;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Önce <code>\"/friends\"</code>, ardından <code>\"/homies\"</code> ve son olarak <code>\"/homies\"</code> öğelerini seçtiğinden emin ol.</p></body></html>",
