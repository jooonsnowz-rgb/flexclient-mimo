            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>\"/store\"</code> adresinden <code>\"/shop\"</code> adresine geçici bir yönlendirme oluştur.</p><code version=\"2\" codelang=\"javascript\" name=\"app.js\" visible-if=\"always\"><content><text value=\"app.get(\" /><text value=\"&quot;/store&quot;\" class=\"string\" /><text value=\", (req, res) =&gt; {\" /><text type=\"break\" /><text value=\"  res.redirect(\" /><text value=\"302\" class=\"number\" /><text value=\", \" /><text value=\"&quot;/shop&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"});\" /><text type=\"break\" /><text type=\"break\" /><text value=\"app.get(\" /><text value=\"&quot;/shop&quot;\" class=\"string\" /><text value=\", (req, res) =&gt; {\" /><text type=\"break\" /><text value=\" res.status(\" /><text value=\"200\" class=\"number\" /><text value=\").send(\" /><text value=\"&quot;Welcome to the shop!&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"});\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"8\" endIndex=\"16\" /><option startIndex=\"49\" endIndex=\"52\" /><option startIndex=\"54\" endIndex=\"61\" /><option startIndex=\"77\" endIndex=\"84\" /><option correct=\"false\"><content><text value=\"&quot;/store&quot;\" /></content></option><option correct=\"false\"><content><text value=\"301\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Önce <code>\"/store\"</code>, ardından <code>302</code> ve sonra <code>\"/shop\"</code>, <code>\"/shop\"</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>\"/store\"</code> adresinden <code>\"/shop\"</code> adresine geçici bir yönlendirme oluştur.</p><code version=\"2\" codelang=\"javascript\" name=\"app.js\" visible-if=\"always\"><content><text value=\"app.get(\" /><text value=\"&quot;/store&quot;\" class=\"string\" /><text value=\", (req, res) =&gt; {\" /><text type=\"break\" /><text value=\"  res.redirect(\" /><text value=\"302\" class=\"number\" /><text value=\", \" /><text value=\"&quot;/shop&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"});\" /><text type=\"break\" /><text type=\"break\" /><text value=\"app.get(\" /><text value=\"&quot;/shop&quot;\" class=\"string\" /><text value=\", (req, res) =&gt; {\" /><text type=\"break\" /><text value=\" res.status(\" /><text value=\"200\" class=\"number\" /><text value=\").send(\" /><text value=\"&quot;Welcome to the shop!&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"});\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"8\" endIndex=\"16\" /><option startIndex=\"49\" endIndex=\"52\" /><option startIndex=\"54\" endIndex=\"61\" /><option startIndex=\"77\" endIndex=\"84\" /><option correct=\"false\"><content><text value=\"&quot;/shops&quot;\" /></content></option><option correct=\"false\"><content><text value=\"301\" /></content></option><option correct=\"false\"><content><text value=\"&quot;/cart&quot;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Önce <code>\"/store\"</code>, ardından <code>302</code>, <code>\"/shop\"</code> ve son olarak <code>\"/shop\"</code> öğelerini seçtiğinden emin ol.</p></body></html>"
