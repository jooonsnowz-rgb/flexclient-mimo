            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu kodda yanlış olan ne?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"frequent_values = {\" /><text value=\"34\" class=\"number\" /><text value=\" \" /><text value=\"20\" class=\"number\" /><text value=\" \" /><text value=\"17\" class=\"number\" /><text value=\" \" /><text value=\"17.5\" class=\"number\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Küme değerlerini birbirinden ayıran virgüller olmalı</item><item value=\"2\" correct=\"false\">Kümeler <code>17.5</code> gibi kayan noktalı değerlere sahip olamaz</item><item value=\"3\" correct=\"false\">Kodda yanlış olan hiçbir şey yok</item></selection><p visible-if=\"wrong\">Küme değerlerini birbirinden ayıran virgüller olmalı.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Hangi değişiklik, değerleri değiştirmeden amaçlanan seti oluşturur?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"frequent_values = {\" /><text value=\"34\" class=\"number\" /><text value=\" \" /><text value=\"20\" class=\"number\" /><text value=\" \" /><text value=\"17\" class=\"number\" /><text value=\" \" /><text value=\"17.5\" class=\"number\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>frequent_values = {34, 20, 17, 17.5}</code></item><item value=\"2\" correct=\"false\"><code>frequent_values = [34, 20, 17, 17.5]</code></item><item value=\"3\" correct=\"false\"><code>frequent_values = {34 20 17}</code></item></selection><p visible-if=\"wrong\"><code>frequent_values = {34, 20, 17, 17.5}</code>.</p></body></html>"
