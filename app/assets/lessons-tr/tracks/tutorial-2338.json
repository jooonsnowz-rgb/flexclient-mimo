          {
            "title": "Example: For loop",
            "id": 89842,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>for döngüsünün içinde, her bir malzemenin önüne <code>\"Add \"</code> ekleyerek görüntülemek için bir f-string kullan.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"ingredients = {\" /><text value=\"&quot;cacao&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;sugar&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;butter&quot;\" class=\"string\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"for\" class=\"keyword\" /><text value=\" ingredient \" /><text value=\"in\" class=\"keyword\" /><text value=\" ingredients:\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"f&quot;Add \" /><text value=\"{ingredient}\" class=\"subst\" /><text value=\"&quot;\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"85\" endIndex=\"88\" /><option startIndex=\"89\" endIndex=\"90\" /><option startIndex=\"90\" endIndex=\"100\" /><option startIndex=\"100\" endIndex=\"101\" /><option correct=\"false\"><content><text value=\"ingredients\" /></content></option></options></interaction></interactions><output><content><text value=\"Add sugar\" /><text type=\"break\" /><text value=\"Add butter\" /><text type=\"break\" /><text value=\"Add cacao\" /></content></output></code><p visible-if=\"wrong\">Önce <code>Add</code>, ardından <code>{</code> ve sonra <code>ingredient</code>, <code>}</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeSelected": true
          },
          {
