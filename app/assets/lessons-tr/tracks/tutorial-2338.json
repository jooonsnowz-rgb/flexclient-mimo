            "interactiveContent": "<!DOCTYPE html ><html><body><p>Değişken <code>invited</code>'ın geçerli bir küme depolaması için bir değer daha kodla.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"invited = {\" /><text value=\"&quot;May&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Diya&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Erik&quot;\" class=\"string\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"26\" endIndex=\"32\" /><option correct=\"false\"><content><text value=\"&quot;May&quot;\" /></content></option><option correct=\"false\"><content><text value=\"&quot;Diya&quot;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\"><code>\"Erik\"</code> öğesini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>invited</code> üç farklı ad içersin diye üçüncü konuk olarak <code>\"Erik\"</code> değerini ekle.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"invited = {\" /><text value=\"&quot;May&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Diya&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Erik&quot;\" class=\"string\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"26\" endIndex=\"32\" /><option correct=\"false\"><content><text value=\"&quot;May&quot;\" /></content></option><option correct=\"false\"><content><text value=\"&quot;Diya&quot;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\"><code>\"Erik\"</code> öğesini seçtiğinden emin ol.</p></body></html>"
