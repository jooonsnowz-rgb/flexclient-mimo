            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>\"ann99\"</code> değerini, ardından <code>\"jess05\"</code> değerini içeren ve virgülle ayrılmış bir küme kodla.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"users = {\" /><text value=\"&quot;ann99&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;jess05&quot;\" class=\"string\" /><text value=\"}\" /><text type=\"break\" /><text value=\"print(users)\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"8\" endIndex=\"27\" /></interactions><output><content><text value=\"{'ann99', 'jess05'}\" /></content></output></code><p visible-if=\"wrong\"><code>{\"ann99\", \"jess05\"}</code> ifadesini yazdığından emin ol.</p></body></html>"
