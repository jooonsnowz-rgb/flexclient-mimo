            "id": 127480,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>print()</code> ifadesinin içinde <code>spot</code> örneğinin <code>waggingTail</code> değişkenini görüntüle.</p><code name=\"main.swift\" version=\"2\" codelang=\"swift\"><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"VirtualPet\" class=\"title\" /><text value=\" \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"let\" class=\"keyword\" /><text value=\" waggingTail = \" /><text value=\"true\" class=\"literal\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"let\" class=\"keyword\" /><text value=\" spot = \" /><text value=\"VirtualPet\" class=\"type\" /><text value=\"()\" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(spot.waggingTail)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"(\" /></content></option><option correct=\"false\"><content><text value=\")\" /></content></option><option startIndex=\"76\" endIndex=\"80\" /><option startIndex=\"80\" endIndex=\"81\" /><option startIndex=\"81\" endIndex=\"92\" /></options></interaction></interactions><output><content><text value=\"true\" /></content></output></code><p visible-if=\"wrong\">Önce <code>spot</code>, ardından <code>.</code> ve son olarak <code>waggingTail</code> öğelerini seçtiğinden emin ol.</p></body></html>"
