            "id": 149766,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>setTimeout()</code> fonksiyonunun ilk parametresi için <code>simulateBattle()</code> sonucunu yazdıran callback fonksiyonunu kodla.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"265\" endIndex=\"274\" isDefault=\"true\" /></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" score = \" /><text value=\"0\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"simulateBattle\" class=\"title\" /><text value=\"(\" /><text value=\"\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"// battle logic\" class=\"comment\" /><text type=\"break\" /><text value=\" \" /><text value=\"// updates `score` variable\" class=\"comment\" /><text type=\"break\" /><text value=\" score += \" /><text value=\"3\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"simulateBattle();\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Battle processing...&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" message = \" /><text value=\"`Score updated to \" /><text value=\"${score}\" class=\"subst\" /><text value=\"`\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"showScore\" class=\"title\" /><text value=\"(\" /><text value=\"\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(message);\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"setTimeout(showScore, \" /><text value=\"5000\" class=\"number\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;You can open your inventory while waiting.&quot;\" class=\"string\" /><text value=\");\" /></content></code><p visible-if=\"wrong\"><code>showScore</code> ifadesini yazdığından emin ol.</p></body></html>"
