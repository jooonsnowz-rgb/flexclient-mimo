            "id": 74251,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>for döngüsünün içinde, konsolda <code>\"Round \" + i</code> ifadesini görüntülemek için sayaç değişkeni <code>i</code>'yi kullan.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"1\" class=\"number\" /><text value=\"; i &lt; \" /><text value=\"5\" class=\"number\" /><text value=\"; i++) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Round &quot;\" class=\"string\" /><text value=\" + i);\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"43\" endIndex=\"51\" /><option startIndex=\"52\" endIndex=\"53\" /><option startIndex=\"54\" endIndex=\"55\" /></options></interaction></interactions><output><content><text value=\"Round 1\" /><text type=\"break\" /><text value=\"Round 2\" /><text type=\"break\" /><text value=\"Round 3\" /><text type=\"break\" /><text value=\"Round 4\" /></content></output></code><p visible-if=\"wrong\">Önce <code>\"Round \"</code>, ardından <code>+</code> ve son olarak <code>i</code> öğelerini seçtiğinden emin ol.</p></body></html>",
