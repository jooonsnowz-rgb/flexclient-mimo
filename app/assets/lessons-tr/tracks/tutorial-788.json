            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>while döngüsünü kullanarak kodu nasıl tekrarlayacağımızı biliyoruz. Tıpkı The American Flag'i görüntülemek için ifadeleri tekrarlayan bu program gibi.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" counter1 = \" /><text value=\"0\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" (counter1 &lt; \" /><text value=\"5\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;**********---------&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" counter1++;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"let\" class=\"keyword\" /><text value=\" counter2 = \" /><text value=\"0\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" (counter2 &lt; \" /><text value=\"4\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;-------------------&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" counter2++;\" /><text type=\"break\" /><text value=\"}\" /></content><output><content><text value=\"**********---------\" /><text type=\"break\" /><text value=\"**********---------\" /><text type=\"break\" /><text value=\"**********---------\" /><text type=\"break\" /><text value=\"**********---------\" /><text type=\"break\" /><text value=\"**********---------\" /><text type=\"break\" /><text value=\"-------------------\" /><text type=\"break\" /><text value=\"-------------------\" /><text type=\"break\" /><text value=\"-------------------\" /><text type=\"break\" /><text value=\"-------------------\" /></content></output></code></body></html>",
            "hardModeSelected": true
