            "hardModeContent": "<!DOCTYPE html ><html><body><p>İki döngü karşılaştırıldığında for döngüsünü çalıştırmadan önce gözden geçirmek neden daha kolaydır?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" counter = \" /><text value=\"0\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" (counter &lt; \" /><text value=\"5\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;**********---------&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" counter++;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"0\" class=\"number\" /><text value=\"; i &lt; \" /><text value=\"4\" class=\"number\" /><text value=\"; i++) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;-------------------&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content><output><content><text value=\"**********---------\" /><text type=\"break\" /><text value=\"**********---------\" /><text type=\"break\" /><text value=\"**********---------\" /><text type=\"break\" /><text value=\"**********---------\" /><text type=\"break\" /><text value=\"**********---------\" /><text type=\"break\" /><text value=\"-------------------\" /><text type=\"break\" /><text value=\"-------------------\" /><text type=\"break\" /><text value=\"-------------------\" /><text type=\"break\" /><text value=\"-------------------\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Başlangıcı, koşulu ve güncellemesi başlıkta birlikte görünür.</item><item value=\"2\" correct=\"false\">Asla sonsuza kadar tekrarlanamaz.</item><item value=\"3\" correct=\"false\">Sayaç değerine ihtiyaç duymaz.</item></selection><p visible-if=\"wrong\">Başlangıcı, koşulu ve güncellemesi başlıkta birlikte görünür.</p></body></html>"
