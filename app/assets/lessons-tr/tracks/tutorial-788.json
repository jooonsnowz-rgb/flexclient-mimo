            "id": 74252,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Parantezlerin içinde sayaç değişkenini ve koşulu oluştur.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"50\" class=\"number\" /><text value=\"; i &lt; \" /><text value=\"55\" class=\"number\" /><text value=\"; i++) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(i);\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"5\" endIndex=\"15\" /><option startIndex=\"15\" endIndex=\"16\" /><option startIndex=\"17\" endIndex=\"23\" /><option startIndex=\"23\" endIndex=\"24\" /></options></interaction></interactions><output><content><text value=\"50\" /><text type=\"break\" /><text value=\"51\" /><text type=\"break\" /><text value=\"52\" /><text type=\"break\" /><text value=\"53\" /><text type=\"break\" /><text value=\"54\" /></content></output></code><p visible-if=\"wrong\">Önce <code>let i = 50</code>, ardından <code>;</code> ve sonra <code>i &lt; 55</code>, <code>;</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>50</code>'den <code>54</code>'e kadar her sayıyı görüntüleyecek döngüyü ayarla.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"50\" class=\"number\" /><text value=\"; i &lt; \" /><text value=\"55\" class=\"number\" /><text value=\"; i++) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(i);\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"5\" endIndex=\"8\" /><option startIndex=\"9\" endIndex=\"10\" /><option startIndex=\"13\" endIndex=\"15\" /><option startIndex=\"17\" endIndex=\"18\" /><option startIndex=\"19\" endIndex=\"20\" /><option startIndex=\"21\" endIndex=\"23\" /><option correct=\"false\"><content><text value=\"&lt;=\" /></content></option><option correct=\"false\"><content><text value=\"56\" /></content></option><option correct=\"false\"><content><text value=\"51\" /></content></option></options></interaction></interactions><output><content><text value=\"50\" /><text type=\"break\" /><text value=\"51\" /><text type=\"break\" /><text value=\"52\" /><text type=\"break\" /><text value=\"53\" /><text type=\"break\" /><text value=\"54\" /></content></output></code><p visible-if=\"wrong\">Önce <code>let</code>, ardından <code>i</code>, <code>50</code>, <code>i</code>, <code>&lt;</code> ve son olarak <code>55</code> öğelerini seçtiğinden emin ol.</p></body></html>",
