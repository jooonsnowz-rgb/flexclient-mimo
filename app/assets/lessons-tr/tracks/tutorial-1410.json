            "id": 91760,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>pollution_index</code> değerinin <code>100</code>'den küçük olduğu öğeleri seçen bir koşul kodla.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE pollution (&#xA;city varchar(255),&#xA;pollution_index int&#xA;);&#xA;&#xA;INSERT INTO pollution (city, pollution_index)&#xA;VALUES ('Delhi', 168);&#xA;INSERT INTO pollution (city, pollution_index)&#xA;VALUES ('Milano', 122);&#xA;INSERT INTO pollution (city, pollution_index)&#xA;VALUES ('Shanghai', 74);&#xA;INSERT INTO pollution (city, pollution_index)&#xA;VALUES ('Tokyo', 21);\"><tables><table name=\"pollution\"><row><header content=\"city\" /><header content=\"pollution_index\" /></row><row><data content=\"Delhi\" /><data content=\"168\" /></row><row><data content=\"Milano\" /><data content=\"122\" /></row><row><data content=\"Shanghai\" /><data content=\"74\" /></row><row><data content=\"Tokyo\" /><data content=\"21\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" pollution\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" pollution_index &lt; \" /><text value=\"100\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"24\" endIndex=\"29\" /><option startIndex=\"30\" endIndex=\"45\" /><option startIndex=\"46\" endIndex=\"47\" /><option startIndex=\"48\" endIndex=\"51\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"city\" /><header content=\"pollution_index\" /></row><row><data content=\"Shanghai\" /><data content=\"74\" /></row><row><data content=\"Tokyo\" /><data content=\"21\" /></row></table></output></code><p visible-if=\"wrong\">Önce <code>WHERE</code>, ardından <code>pollution_index</code> ve sonra <code>&lt;</code>, <code>100</code> öğelerini seçtiğinden emin ol.</p></body></html>"
