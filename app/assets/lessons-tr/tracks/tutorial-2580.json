          {
            "title": "Example: Condition",
            "id": 127598,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Koşulu <code>number &lt; 3</code> olarak ayarlayarak <code>1</code> ile <code>3</code> arasındaki sayıları görüntüle.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"var\" class=\"keyword\" /><text value=\" number = \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" number &lt; \" /><text value=\"3\" class=\"number\" /><text value=\" {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"print\" class=\"built_in\" /><text value=\"(number)\" /><text type=\"break\" /><text value=\"  number += \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"29\" endIndex=\"30\" /><option correct=\"false\"><content><text value=\"&gt;\" /></content></option></options></interaction></interactions><output><content><text value=\"1\" /><text type=\"break\" /><text value=\"2\" /><text type=\"break\" /><text value=\"3\" /></content></output></code><p visible-if=\"wrong\"><code>&lt;</code> öğesini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "Example: Incrementing",
            "id": 127599,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>for</code> döngüsünün kod bloğunda, <code>+=</code> operatörünü kullanarak <code>line</code> değişkenine <code>~</code> ekle.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;*&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text type=\"break\" /><text value=\"var\" class=\"keyword\" /><text value=\" line = \" /><text value=\"&quot;&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"for\" class=\"keyword\" /><text value=\" i \" /><text value=\"in\" class=\"keyword\" /><text value=\" \" /><text value=\"1\" class=\"number\" /><text value=\"...\" /><text value=\"4\" class=\"number\" /><text value=\" {\" /><text type=\"break\" /><text value=\"  line += \" /><text value=\"&quot;~&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"  \" /><text value=\"print\" class=\"built_in\" /><text value=\"(line)\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"51\" endIndex=\"53\" /></interactions><output><content><text value=\"*\" /><text type=\"break\" /><text value=\"~\" /><text type=\"break\" /><text value=\"~~\" /><text type=\"break\" /><text value=\"~~~\" /><text type=\"break\" /><text value=\"~~~~\" /></content></output></code><p visible-if=\"wrong\"><code>+=</code> ifadesini yazdığından emin ol.</p></body></html>"
          },
