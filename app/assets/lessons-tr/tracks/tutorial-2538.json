l&lt;/li&gt;&#xA;      &lt;li&gt;&lt;i class=&quot;fas fa-basketball-ball&quot;&gt;&lt;/i&gt; Basketball&lt;/li&gt;&#xA;      &lt;li&gt;&lt;i class=&quot;fas fa-baseball-ball&quot;&gt;&lt;/i&gt; Baseball&lt;/li&gt;&#xA;      &lt;li&gt;&lt;i class=&quot;fas fa-volleyball-ball&quot;&gt;&lt;/i&gt; Volleyball&lt;/li&gt;&#xA;    &lt;/ul&gt;&#xA;    &lt;script src=&quot;script.js&quot;&gt;&lt;/script&gt;&#xA;  &lt;/body&gt;&#xA;&lt;/html&gt;\" /></body></html>"
