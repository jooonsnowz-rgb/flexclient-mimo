></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"49\" endIndex=\"74\" /></interactions><output><table name=\"Result\"><row><header content=\"title\" /><header content=\"director_id\" /><header content=\"id\" /><header content=\"name\" /></row><row><data content=\"The Pianist\" /><data content=\"2\" /><data content=\"2\" /><data content=\"Polanski\" /></row><row><data content=\"Macbeth\" /><data content=\"2\" /><data content=\"2\" /><data content=\"Polanski\" /></row><row><data content=\"Somewhere\" /><data content=\"1\" /><data content=\"1\" /><data content=\"Coppola\" /></row></table></output></code><p visible-if=\"wrong\"><code>director_id = director.id</code> ifadesini yazdığından emin ol.</p></body></html>"
