            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>.reduce()</code> fonksiyonunun çalışması için gereken minimum parametre sayısı nedir?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">2</item><item value=\"2\" correct=\"false\">3</item><item value=\"3\" correct=\"false\">1</item></selection><p visible-if=\"wrong\">2 öğesini seçtiğinden emin ol.</p></body></html>"
