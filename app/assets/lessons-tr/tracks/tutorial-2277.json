            "interactiveContent": "<!DOCTYPE html ><html><body><p>Hesaba vergiler de dahil olmalı, bu yüzden <code>mod.js</code> dosyasına hesaba <code>5</code> vergi ekleyen bir fonksiyon ekleyelim.</p><code version=\"2\" codelang=\"javascript\" name=\"mod.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" bill = \" /><text value=\"40\" class=\"number\" /><text value=\"; \" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" total = \" /><text value=\"(\" /><text value=\"bill\" class=\"params\" /><text value=\") =&gt;\" /><text value=\" { \" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" bill + \" /><text value=\"5\" class=\"number\" /><text value=\"; \" /><text type=\"break\" /><text value=\"}; \" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"export\" class=\"keyword\" /><text value=\" \" /><text value=\"default\" class=\"keyword\" /><text value=\" bill;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"48\" endIndex=\"54\" /><option startIndex=\"55\" endIndex=\"59\" /><option startIndex=\"60\" endIndex=\"61\" /><option startIndex=\"62\" endIndex=\"63\" /><option startIndex=\"63\" endIndex=\"64\" /><option correct=\"false\"><content><text value=\"-\" /></content></option><option correct=\"false\"><content><text value=\"console\" /></content></option></options></interaction></interactions><output><content><text value=\"40\" /></content></output></code><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"import\" class=\"keyword\" /><text value=\" bill \" /><text value=\"from\" class=\"keyword\" /><text value=\" \" /><text value=\"&quot;./mod.js&quot;\" class=\"string\" /><text value=\"; \" /><text type=\"break\" /><text value=\" \" /><text type=\"br