            "hardModeContent": "<!DOCTYPE html ><html><body><p>Modül hem <code>bill</code> hem de <code>total</code> değerini kullanıma açmalıdır. Adlandırılmış dışa aktarma söz dizimini kullan.</p><code version=\"2\" codelang=\"javascript\" name=\"mod.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" bill = \" /><text value=\"40\" class=\"number\" /><text value=\"; \" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" total = \" /><text value=\"(\" /><text value=\"bill\" class=\"params\" /><text value=\") =&gt;\" /><text value=\" { \" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" bill + \" /><text value=\"5\" class=\"number\" /><text value=\"; \" /><text type=\"break\" /><text value=\"}; \" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"export\" class=\"keyword\" /><text value=\" {bill, total};\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"72\" endIndex=\"78\" /><option startIndex=\"79\" endIndex=\"80\" /><option startIndex=\"91\" endIndex=\"92\" /><option correct=\"false\"><content><text value=\"[\" /></content></option><option correct=\"false\"><content><text value=\"]\" /></content></option><option correct=\"false\"><content><text value=\"default\" /></content></option></options></interaction></interactions></code><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"import\" class=\"keyword\" /><text value=\" \" /><text value=\"{\" /><text value=\"bill\" /><text value=\"}\" /><text value=\" \" /><text value=\"from\" class=\"keyword\" /><text value=\" \" /><text value=\"&quot;./mod.js&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".\" /><