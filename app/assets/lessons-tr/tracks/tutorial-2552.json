            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu fonksiyona camel case biçiminde bir ad ver.</p><code name=\"main.swift\" version=\"2\" codelang=\"swift\"><content><text value=\"func\" class=\"keyword\" /><text value=\" \" /><text value=\"nightRoutine\" class=\"title\" /><text value=\"()\" class=\"params\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Lights off&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Alarm set&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"nightRoutine()\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"nightroutine\" /></content></option><option startIndex=\"5\" endIndex=\"17\" /></options></interaction></interactions><output><content><text value=\"Lights off\" /><text type=\"break\" /><text value=\"Alarm set\" /></content></output></code><p visible-if=\"wrong\"><code>nightRoutine</code> öğesini seçtiğinden emin ol.</p></body></html>"
