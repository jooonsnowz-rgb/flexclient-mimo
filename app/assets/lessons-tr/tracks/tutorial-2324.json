            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>.pop()</code> ne yapar?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Bir listedeki son değeri kaldırır</item><item value=\"2\" correct=\"false\">Bir listeye değer ekler</item><item value=\"3\" correct=\"false\">Bir listeden rastgele bir değeri kaldırır</item></selection><p visible-if=\"wrong\">Bir listedeki son değeri kaldırır.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Liste <code>colors = [\"red\", \"blue\"]</code> ile başlıyor. <code>colors.pop()</code> sonrasında <code>colors</code> içinde ne depolanır?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>[\"red\"]</code></item><item value=\"2\" correct=\"false\"><code>[\"blue\"]</code></item><item value=\"3\" correct=\"false\"><code>[\"red\", \"blue\"]</code></item></selection><p visible-if=\"wrong\"><code>[\"red\"]</code> öğesini seçtiğinden emin ol.</p></body></html>"
