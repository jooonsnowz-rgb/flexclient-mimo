            "interactiveContent": "<!DOCTYPE html ><html><body><p>İndeksler nedir?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Listelerdeki öğelerin numaralandırılmış konumları</item><item value=\"2\" correct=\"false\">Listelerdeki öğelerin değerleri</item><item value=\"3\" correct=\"false\">Listelerdeki öğeler</item></selection><p visible-if=\"wrong\">Listelerdeki öğelerin numaralandırılmış konumları.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>İndeksler, bir listedeki öğelerin numaralandırılmış konumlarıdır.</p><p>Bir puan listesi <code>[90, 85, 78]</code> öğelerini tutuyor. Bu listede <code>85</code> nedir?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Bir indekste depolanan değer</item><item value=\"2\" correct=\"false\">İndeksin kendisi</item><item value=\"3\" correct=\"false\">Listedeki öğe sayısı</item></selection><p visible-if=\"wrong\">Bir indekste depolanan değer.</p></body></html>",
            "hardModeSelected": true
