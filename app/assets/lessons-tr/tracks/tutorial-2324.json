          {
            "title": "Example: Multiple values",
            "id": 80452,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Listeye başka bir dize eklemek için virgül kullan.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"players = [\" /><text value=\"&quot;Federer&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Murray&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text value=\"print(\" /><text value=\"&quot;Players for the match:&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"print(players)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"22\" endIndex=\"30\" /><option correct=\"false\"><content><text value=\"50\" /></content></option><option correct=\"false\"><content><text value=\"True\" /></content></option><option startIndex=\"20\" endIndex=\"21\" /></options></interaction></interactions><output><content><text value=\"Players for the match:\" /><text type=\"break\" /><text value=\"['Federer', 'Murray']\" /></content></output></code><p visible-if=\"wrong\">Önce <code>,</code>, ardından <code>\"Murray\"</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Listenin <code>['Federer', 'Murray']</code> yazdırması için ikinci oyuncu olan <code>\"Murray\"</code> değerini listede depola.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"players = [\" /><text value=\"&quot;Federer&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Murray&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text value=\"print(\" /><text value=\"&quot;Players for the match:&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"print(players)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"20\" endIndex=\"21\" /><option startIndex=\"22\" endIndex=\"30\" /><option correct=\"false\"><content><text value=\"50\" /></content></option><option correct=\"false\"><content><text value=\"True\" /></content></option><option correct=\"false\"><content><text value=\"+\" /></content></option></options></interaction></interactions><output><content><text value=\"Players for the match:\" /><text type=\"break\" /><text value=\"['Federer', 'Murray']\" /></content></output></code><p visible-if=\"wrong\">Önce <code>,</code>, ardından <code>\"Murray\"</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          },
