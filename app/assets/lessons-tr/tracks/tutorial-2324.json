            "id": 79514,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu listede erişebileceğimiz son indeks hangisi?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"color_scheme = [\" /><text value=\"&quot;lightBlue&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;orange&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;gray&quot;\" class=\"string\" /><text value=\"]\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>2</code></item><item value=\"2\" correct=\"false\"><code>3</code></item><item value=\"3\" correct=\"false\"><code>4</code></item></selection><p visible-if=\"wrong\"><code>2</code> öğesini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Hangi ifade bu listeden <code>\"gray\"</code> değerini alır?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"color_scheme = [\" /><text value=\"&quot;lightBlue&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;orange&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;gray&quot;\" class=\"string\" /><text value=\"]\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>color_scheme[2]</code></item><item value=\"2\" correct=\"false\"><code>color_scheme[3]</code></item><item value=\"3\" correct=\"false\"><code>color_scheme[\"gray\"]</code></item></selection><p visible-if=\"wrong\"><code>color_scheme[2]</code> öğesini seçtiğinden emin ol.</p></body></html>",
