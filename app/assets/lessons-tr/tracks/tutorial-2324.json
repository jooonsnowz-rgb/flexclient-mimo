          {
            "title": "Example: insert",
            "id": 79604,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu listenin başına <code>\"windy\"</code> eklemek için <code>insert()</code> metodunu kullan.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"forecast = [\" /><text value=\"&quot;sunny&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;cloudy&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text value=\"forecast.insert(\" /><text value=\"0\" class=\"number\" /><text value=\",\" /><text value=\"&quot;windy&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(forecast)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"40\" endIndex=\"46\" /><option startIndex=\"47\" endIndex=\"48\" /><option startIndex=\"48\" endIndex=\"49\" /><option startIndex=\"49\" endIndex=\"56\" /><option correct=\"false\"><content><text value=\"1\" /></content></option></options></interaction></interactions><output><content><text value=\"['windy', 'sunny', 'cloudy']\" /></content></output></code><p visible-if=\"wrong\">Önce <code>insert</code>, ardından <code>0</code> ve sonra <code>,</code>, <code>\"windy\"</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Listenin <code>['windy', 'sunny', 'cloudy']</code> yazdırması için başına <code>\"windy\"</code> ekle.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"forecast = [\" /><text value=\"&quot;sunny&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;cloudy&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text value=\"forecast.insert(\" /><text value=\"0\" class=\"number\" /><text value=\",\" /><text value=\"&quot;windy&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(forecast)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"40\" endIndex=\"46\" /><option startIndex=\"47\" endIndex=\"48\" /><option startIndex=\"48\" endIndex=\"49\" /><option startIndex=\"49\" endIndex=\"56\" /><option correct=\"false\"><content><text value=\"append\" /></content></option><option correct=\"false\"><content><text value=\"1\" /></content></option><option correct=\"false\"><content><text value=\"&quot;sunny&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"['windy', 'sunny', 'cloudy']\" /></content></output></code><p visible-if=\"wrong\">Önce <code>insert</code>, ardından <code>0</code>, <code>,</code> ve son olarak <code>\"windy\"</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeSelected": true
