            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>quiz_answers</code> listesindeki son değeri kaldır.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"quiz_answers = [\" /><text value=\"False\" class=\"literal\" /><text value=\", \" /><text value=\"False\" class=\"literal\" /><text value=\", \" /><text value=\"True\" class=\"literal\" /><text value=\", \" /><text value=\"False\" class=\"literal\" /><text value=\"]\" /><text type=\"break\" /><text value=\"quiz_answers.pop()\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(quiz_answers)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"56\" endIndex=\"61\" /><option correct=\"false\"><content><text value=\"append()\" /></content></option><option correct=\"false\"><content><text value=\"insert()\" /></content></option></options></interaction></interactions><output><content><text value=\"[False, False, True]\" /></content></output></code><p visible-if=\"wrong\"><code>pop()</code> öğesini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Listenin <code>[False, False, True]</code> yazdırması için <code>quiz_answers</code> listesindeki son değeri kaldır.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"quiz_answers = [\" /><text value=\"False\" class=\"literal\" /><text value=\", \" /><text value=\"False\" class=\"literal\" /><text value=\", \" /><text value=\"True\" class=\"literal\" /><text value=\", \" /><text value=\"False\" class=\"literal\" /><text value=\"]\" /><text type=\"break\" /><text value=\"quiz_answers.pop()\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(quiz_answers)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"56\" endIndex=\"61\" /><option correct=\"false\"><content><text value=\"append()\" /></content></option><option correct=\"false\"><content><text value=\"insert()\" /></content></option><option correct=\"false\"><content><text value=\"pop(0)\" /></content></option></options></interaction></interactions><output><content><text value=\"[False, False, True]\" /></content></output></code><p visible-if=\"wrong\"><code>pop()</code> öğesini seçtiğinden emin ol.</p></body></html>",
