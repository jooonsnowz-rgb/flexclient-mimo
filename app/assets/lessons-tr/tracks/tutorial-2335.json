            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu kodda yanlış olan ne?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"say\" class=\"title\" /><text value=\" \" /><text value=\"greeting\" class=\"title\" /><text value=\"()\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"&quot;Hi there!&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Fonksiyon adında boşluk var</item><item value=\"2\" correct=\"false\">Fonksiyonun adı açıklayıcı değil</item><item value=\"3\" correct=\"false\">Fonksiyonun içinde değişken yok</item></selection><p visible-if=\"wrong\">Fonksiyon adında boşluk var.</p></body></html>",
