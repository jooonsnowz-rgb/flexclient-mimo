            "hardModeContent": "<!DOCTYPE html ><html><body><p>Fonksiyonun string'i döndürmesi için girintili satırın yerine hangi satır yazılmalıdır?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"wrong_answer\" class=\"title\" /><text value=\"()\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\" \" /><text value=\"&quot;That's incorrect!&quot;\" class=\"string\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>return \"That's incorrect!\"</code></item><item value=\"2\" correct=\"false\"><code>\"That's incorrect!\" return</code></item><item value=\"3\" correct=\"false\"><code>print(\"That's incorrect!\")</code></item></selection><p visible-if=\"wrong\"><code>return \"That's incorrect!\"</code>.</p></body></html>"
