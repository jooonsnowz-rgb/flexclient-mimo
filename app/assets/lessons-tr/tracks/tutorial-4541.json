xt type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" pickup1 = \" /><text value=\"new\" class=\"keyword\" /><text value=\" Pickup(\" /><text value=\"&quot;GoldCoin&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" pickup2 = \" /><text value=\"new\" class=\"keyword\" /><text value=\" Pickup(\" /><text value=\"&quot;Gem&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"pickup1.points = \" /><text value=\"10\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"pickup2.points = \" /><text value=\"50\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"pickup1.collect();\" /><text type=\"break\" /><text value=\"pickup2.collect();\" /></content></code><p visible-if=\"wrong\">Önce <code>.collect();</code>, ardından <code>.collect();</code> öğelerini seçtiğinden emin ol.</p></body></html>"
