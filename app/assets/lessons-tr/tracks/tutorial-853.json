          {
            "title": "Question: Class Keyword",
            "id": 56059,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bir sınıf oluştururken hangi adlandırma kuralı önemlidir?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Sınıf adları büyük harfle başlar</item><item value=\"2\" correct=\"false\">Bir sınıf adına gerek yok</item></selection><p visible-if=\"wrong\">Sınıf adları büyük harfle başlar.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>class book {}</code> yazıyorsun. Hangi değişiklik sınıf adı kuralına uyar?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">book yerine Book yaz.</item><item value=\"2\" correct=\"false\">class yerine Class yaz.</item><item value=\"3\" correct=\"false\">book adını kaldır.</item></selection><p visible-if=\"wrong\">book yerine Book yaz.</p></body></html>",
            "hardModeSelected": true
