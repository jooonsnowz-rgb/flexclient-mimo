            "id": 56131,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bir sınıfın <code>color</code> özelliği var. Sınıfın içindeyken bu özelliğe nasıl erişiriz?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>this.color</code> ile</item><item value=\"2\" correct=\"false\"><code>this(color)</code> ile</item></selection><p visible-if=\"wrong\"><code>this.color</code> ile.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>this.color = color</code> sonrasında <code>color</code> parametresini değiştiriyorsun. Nesnede saklanan değeri hangi ifade okur?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>this.color</code> ile</item><item value=\"2\" correct=\"false\"><code>this(color)</code> ile</item><item value=\"3\" correct=\"false\"><code>color</code> ile</item></selection><p visible-if=\"wrong\"><code>this.color</code> ile öğesini seçtiğinden emin ol.</p></body></html>",
            "hardModeSelected": true
