          {
            "title": "Lesson #2 - Copy - Copy - Copy",
            "id": 132659,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>İki sorgu parametresi içerecek şekilde URL'yi tamamla.</p><code version=\"2\" codelang=\"bash\" name=\"script.sh\" visible-if=\"always\"><content><text value=\"http://localhost:3000/product?category=electronics&amp;brand=Samsung\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"29\" endIndex=\"30\" /><option startIndex=\"50\" endIndex=\"51\" /><option correct=\"false\"><content><text value=\"|\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Önce <code>?</code>, ardından <code>&amp;</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Sırasıyla <code>category</code> olarak <code>electronics</code>, <code>brand</code> olarak <code>Samsung</code> gönder.</p><code version=\"2\" codelang=\"bash\" name=\"script.sh\" visible-if=\"always\"><content><text value=\"http://localhost:3000/product?category=electronics&amp;brand=Samsung\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"29\" endIndex=\"30\" /><option startIndex=\"30\" endIndex=\"38\" /><option startIndex=\"50\" endIndex=\"51\" /><option startIndex=\"51\" endIndex=\"56\" /><option correct=\"false\"><content><text value=\"/\" /></content></option><option correct=\"false\"><content><text value=\"=\" /></content></option><option correct=\"false\"><content><text value=\"|\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Önce <code>?</code>, ardından <code>category</code>, <code>&amp;</code> ve son olarak <code>brand</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Question: req.hostname",
            "id": 121778,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>path</code> adlı sorgu parametresine nasıl erişirsin?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"false\"><code>req.hostname</code></item><item value=\"3\" correct=\"true\"><code>req.query.path</code></item><item value=\"4\" correct=\"false\"><code>req.host</code></item><item value=\"4\" correct=\"false\"><code>req.route</code></item></selection><p visible-if=\"wrong\"><code>req.query.path</code> öğesini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Rotan <code>/files/:path</code>. <code>/files/docs?path=images</code> isteğini gönderiyorsun.</p><p><code>req.query.path</code> hangi değeri içerir?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>images</code></item><item value=\"2\" correct=\"false\"><code>docs</code></item><item value=\"3\" correct=\"false\"><code>path</code></item><item value=\"4\" correct=\"false\"><code>undefined</code></item></selection><p visible-if=\"wrong\"><code>images</code> öğesini seçtiğinden emin ol.</p></body></html>",
