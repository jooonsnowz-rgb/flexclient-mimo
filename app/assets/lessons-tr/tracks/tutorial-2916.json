            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>name adlı rota parametresine nasıl erişirsin?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"false\"><code>req.method</code></item><item value=\"2\" correct=\"true\"><code>req.params.name</code></item><item value=\"3\" correct=\"false\"><code>req.route</code></item><item value=\"4\" correct=\"false\"><code>req.path</code></item></selection><p visible-if=\"wrong\"><code>req.params.name</code> öğesini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Rotan <code>/users/:name</code>. <code>/users/Maria?name=Lin</code> isteğini gönderiyorsun.</p><p><code>req.params.name</code> hangi değeri içerir?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>Maria</code></item><item value=\"2\" correct=\"false\"><code>Lin</code></item><item value=\"3\" correct=\"false\"><code>/users/Maria</code></item><item value=\"4\" correct=\"false\"><code>undefined</code></item></selection><p visible-if=\"wrong\"><code>Maria</code> öğesini seçtiğinden emin ol.</p></body></html>",
            "hardModeSelected": true
