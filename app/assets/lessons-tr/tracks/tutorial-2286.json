          {
            "title": "Example: Commas",
            "id": 91167,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tüm sporcuları ve yarışı tamamlamalarının ne kadar sürdüğünü gösteren bir tablo elde etmek için <code>athlete</code> ve <code>time</code> ifadelerini virgülle <code>,</code> ayırarak kodla.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE race (&#xA; athlete varchar(255),&#xA; country varchar(255),&#xA; time varchar(255)&#xA;);&#xA;&#xA;INSERT INTO race (athlete, country, time)&#xA;VALUES ('Vivian Cheruiyot', 'Kenya', '14:26');&#xA;&#xA;INSERT INTO race (athlete, country, time)&#xA;VALUES ('Hellen Onsando Obiri', 'Kenya', '14:29');&#xA;&#xA;INSERT INTO race (athlete, country, time)&#xA;VALUES ('Almaz Ayana', 'Ethiopia', '14:33');&#xA;\"><tables><table name=\"race\"><row><header content=\"athlete\" /><header content=\"country\" /><header content=\"time\" /></row><row><data content=\"Vivian Cheruiyot\" /><data content=\"Kenya\" /><data content=\"14:26\" /></row><row><data content=\"Hellen Onsando Obiri\" /><data content=\"Kenya\" /><data content=\"14:29\" /></row><row><data content=\"Almaz Ayana\" /><data content=\"Ethiopia\" /><data content=\"14:33\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" athlete, \" /><text value=\"time\" class=\"built_in\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" race;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"7\" endIndex=\"20\" /></interactions><output><table name=\"Result\"><row><header content=\"athlete\" /><header content=\"time\" /></row><row><data content=\"Vivian Cheruiyot\" /><data content=\"14:26\" /></row><row><data content=\"Hellen Onsando Obiri\" /><data content=\"14:29\" /></row><row><data content=\"Almaz Ayana\" /><data content=\"14:33\" /></row></table></output></code><p visible-if=\"wrong\"><code>athlete, time</code> ifadesini yazdığından emin ol.</p></body></html>"
          },
          {
            "title": "Question: Selecting with duplicates",
            "id": 91172,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu sorgunun sonucunda kaç tane <code>Wii</code> değeri olacak?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE games (&#xA; game varchar(255),&#xA; platform varchar(255),&#xA; year int&#xA;);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('Super Mario', 'NES', 1985);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('Mario Kart', 'Wii', 2008);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('Just Dance', 'Wii', 2009);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('FIFA 16', 'PS4', 2015);&#xA;\"><tables><table name=\"games\"><row><header content=\"game\" /><header content=\"platform\" /><header content=\"year\" /></row><row><data content=\"Super Mario\" /><data content=\"NES\" /><data content=\"1985\" /></row><row><data content=\"Mario Kart\" /><data content=\"Wii\" /><data content=\"2008\" /></row><row><data content=\"Just Dance\" /><data content=\"Wii\" /><data content=\"2009\" /></row><row><data content=\"FIFA 16\" /><data content=\"PS4\" /><data content=\"2015\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" platform\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" games;\" /></content><output><table name=\"Result\"><row><header content=\"platform\" /></row><row><data content=\"NES\" /></row><row><data content=\"Wii\" /></row><row><data content=\"Wii\" /></row><row><data content=\"PS4\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">İki, çünkü <code>platform</code> sütununda iki <code>Wii</code> değeri var</item><item value=\"2\" correct=\"false\">Yalnızca bir tane, çünkü yinelenenler seçilmez</item><item value=\"3\" correct=\"false\"><code>Wii</code> değeri yok</item></selection><p visible-if=\"wrong\">İki, çünkü <code>platform</code> sütununda iki <code>Wii</code> değeri var.</p></body></html>"
          },
          {
            "title": "Example: Select all columns",
            "id": 91164,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>cereals</code> tablosundaki tüm sütunları seçen bir sorgu kodla.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE cereals (&#xA;name varchar(255),&#xA;fiber int,&#xA;sugar int&#xA;);&#xA;&#xA;INSERT INTO cereals (name, fiber, sugar)&#xA;VALUES ('Cheerios', 2, 1);&#xA;&#xA;INSERT INTO cereals (name, fiber, sugar)&#xA;VALUES ('Lucky Charms', 0, 12);&#xA;&#xA;INSERT INTO cereals (name, fiber, sugar)&#xA;VALUES ('Cocoa Puffs', 0, 13);&#xA;&#xA;INSERT INTO cereals (name, fiber, sugar)&#xA;VALUES ('100% Bran', 10, 6);&#xA;\"><tables><table name=\"cereals\"><row><header content=\"name\" /><header content=\"fiber\" /><header content=\"sugar\" /></row><row><data content=\"Cheerios\" /><data content=\"2\" /><data content=\"1\" /></row><row><data content=\"Lucky Charms\" /><data content=\"0\" /><data content=\"12\" /></row><row><data content=\"Cocoa Puffs\" /><data content=\"0\" /><data content=\"13\" /></row><row><data content=\"100% Bran\" /><data content=\"10\" /><data content=\"6\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" cereals;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"8\" /><option startIndex=\"9\" endIndex=\"13\" /><option startIndex=\"14\" endIndex=\"21\" /><option startIndex=\"21\" endIndex=\"22\" /><option correct=\"false\"><content><text value=\".\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"fiber\" /><header content=\"sugar\" /></row><row><data content=\"Cheerios\" /><data content=\"2\" /><data content=\"1\" /></row><row><data content=\"Lucky Charms\" /><data content=\"0\" /><data content=\"12\" /></row><row><data content=\"Cocoa Puffs\" /><data content=\"0\" /><data content=\"13\" /></row><row><data content=\"100% Bran\" /><data content=\"10\" /><data content=\"6\" /></row></table></output></code><p visible-if=\"wrong\">Önce <code>SELECT</code>, ardından <code>*</code> ve sonra <code>FROM</code>, <code>cereals</code>, <code>;</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "Question: Select *",
            "id": 91165,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu iki sorgu arasındaki fark nedir?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE race (&#xA; athlete varchar(255),&#xA; country varchar(255),&#xA; time varchar(255)&#xA;);&#xA;&#xA;INSERT INTO race (athlete, country, time)&#xA;VALUES ('Vivian Cheruiyot', 'Kenya', '14:26');&#xA;&#xA;INSERT INTO race (athlete, country, time)&#xA;VALUES ('Hellen Onsando Obiri', 'Kenya', '14:29');&#xA;&#xA;INSERT INTO race (athlete, country, time)&#xA;VALUES ('Almaz Ayana', 'Ethiopia', '14:33');&#xA;\"><tables><table name=\"race\"><row><header content=\"athlete\" /><header content=\"country\" /><header content=\"time\" /></row><row><data content=\"Vivian Cheruiyot\" /><data content=\"Kenya\" /><data content=\"14:26\" /></row><row><data content=\"Hellen Onsando Obiri\" /><data content=\"Kenya\" /><data content=\"14:29\" /></row><row><data content=\"Almaz Ayana\" /><data content=\"Ethiopia\" /><data content=\"14:33\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" race;\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" athlete, country, \" /><text value=\"time\" class=\"built_in\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" race;\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Hiçbir fark yok; her iki sorgu da <code>race</code> tablosundaki tüm sütunları seçer.</item><item value=\"2\" correct=\"false\">İlk sorgu hiçbir şey seçmezken ikinci sorgu tüm sütunları seçer</item><item value=\"3\" correct=\"false\">İlk sorguda bir <code>SELECT</code> ifadesi eksik</item></selection><p visible-if=\"wrong\">Hiçbir fark yok; her iki sorgu da <code>race</code> tablosundaki tüm sütunları seçer..</p></body></html>"
          },
          {
            "title": "Example: Distinct",
            "id": 91174,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Yalnızca benzersiz <code>platform</code> değerlerini seçmek için <code>SELECT</code> yazıp ardından <code>DISTINCT</code> ve <code>platform</code> sütununu ekle.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE games (&#xA; game varchar(255),&#xA; platform varchar(255),&#xA; year int&#xA;);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('Super Mario', 'NES', 1985);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('Mario Kart', 'Wii', 2008);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('Just Dance', 'Wii', 2009);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('FIFA 16', 'PS4', 2015);&#xA;\"><tables><table name=\"games\"><row><header content=\"game\" /><header content=\"platform\" /><header content=\"year\" /></row><row><data content=\"Super Mario\" /><data content=\"NES\" /><data content=\"1985\" /></row><row><data content=\"Mario Kart\" /><data content=\"Wii\" /><data content=\"2008\" /></row><row><data content=\"Just Dance\" /><data content=\"Wii\" /><data content=\"2009\" /></row><row><data content=\"FIFA 16\" /><data content=\"PS4\" /><data content=\"2015\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"DISTINCT\" class=\"keyword\" /><text value=\" platform\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" games;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"0\" endIndex=\"24\" /></interactions><output><table name=\"Result\"><row><header content=\"platform\" /></row><row><data content=\"NES\" /></row><row><data content=\"Wii\" /></row><row><data content=\"PS4\" /></row></table></output></code><p visible-if=\"wrong\"><code>SELECT DISTINCT platform</code> ifadesini yazdığından emin ol.</p></body></html>"
          },
          {
            "title": "Question: Ascending by default ",
            "id": 91780,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Öğeleri <code>score</code> değerlerine göre artan sırada sıralayan sorgu hangisidir?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" score;\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" score \" /><text value=\"ASC\" class=\"keyword\" /><text value=\";\" /><text type=\"break\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Her ikisi</item><item value=\"2\" correct=\"false\">İlki</item><item value=\"3\" correct=\"false\">İkincisi</item></selection><p visible-if=\"wrong\">Her ikisi.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Öğrencilerin puanları <code>90</code>, <code>40</code> ve <code>70</code>. Gösterilen hangi sorgu bunları <code>40</code>, <code>70</code>, <code>90</code> sırasında döndürür?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" score;\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" score \" /><text value=\"ASC\" class=\"keyword\" /><text value=\";\" /><text type=\"break\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Her ikisi</item><item value=\"2\" correct=\"false\">İlki</item><item value=\"3\" correct=\"false\">İkincisi</item><item value=\"4\" correct=\"false\">Hiçbiri, çünkü artan sıralama her zaman <code>ASCENDING</code> gerektirir</item></selection><p visible-if=\"wrong\">Her ikisi öğesini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "Example: Order by ",
            "id": 91776,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>ORDER BY score</code> kullanarak <code>students</code> tablosundaki öğeleri <code>score</code> değerlerine göre yeniden sırala.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; score int&#xA;);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Jean Miller', 5);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Emma Brown', 8);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Reese Jones', 2);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Kim Lee', 9);&#xA;\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"score\" /></row><row><data content=\"Jean Miller\" /><data content=\"5\" /></row><row><data content=\"Emma Brown\" /><data content=\"8\" /></row><row><data content=\"Reese Jones\" /><data content=\"2\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" score;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"23\" endIndex=\"37\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"score\" /></row><row><data content=\"Reese Jones\" /><data content=\"2\" /></row><row><data content=\"Jean Miller\" /><data content=\"5\" /></row><row><data content=\"Emma Brown\" /><data content=\"8\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row></table></output></code><p visible-if=\"wrong\"><code>ORDER BY score</code> ifadesini yazdığından emin ol.</p></body></html>"
          },
          {
            "title": "Question: Alphabetical order",
            "id": 91778,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bir metin özelliğine göre sıralama yaptığımızda hangi değerler önce gelir?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Alfabenin başlarında yer alan harfleri içeren değerler önce gelir</item><item value=\"2\" correct=\"false\">Bilemeyiz; metin özelliklerine göre sıralama rastgele sonuçlar verir.</item><item value=\"3\" correct=\"false\">Metin özelliklerine göre sıralama yapamayız</item></selection><p visible-if=\"wrong\">Alfabenin başlarında yer alan harfleri içeren değerler önce gelir.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Bir metin özelliği <code>\"Zoe\"</code>, <code>\"Ava\"</code> ve <code>\"Mia\"</code> içeriyor. Artan sırada hangi değer önce gelir?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">İlk harfi alfabede daha önce olduğu için <code>\"Ava\"</code></item><item value=\"2\" correct=\"false\">Metin değerleri alfabenin sonundan itibaren sıralandığı için <code>\"Zoe\"</code></item><item value=\"3\" correct=\"false\">Ortadaki değer ilk sırada kaldığı için <code>\"Mia\"</code></item><item value=\"4\" correct=\"false\">Hiçbiri, çünkü metin özellikleri sıralanamaz</item></selection><p visible-if=\"wrong\">İlk harfi alfabede daha önce olduğu için <code>\"Ava\"</code>.</p></body></html>"
          },
          {
            "title": "Question: Descending order",
            "id": 91781,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu sorgu öğeleri nasıl sıralar?<br /></p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" score \" /><text value=\"DESC\" class=\"keyword\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Azalan sırada</item><item value=\"2\" correct=\"false\">Artan sırada</item><item value=\"3\" correct=\"false\">Aynı sıra; çünkü <code>DESC</code> geçerli bir anahtar kelime değildir</item></selection><p visible-if=\"wrong\">Azalan sırada.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Öğrencilerin puanları <code>42</code>, <code>95</code> ve <code>70</code>. Sorgu bunları hangi sırada döndürür?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" score \" /><text value=\"DESC\" class=\"keyword\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>95</code>, <code>70</code>, <code>42</code></item><item value=\"2\" correct=\"false\"><code>42</code>, <code>70</code>, <code>95</code></item><item value=\"3\" correct=\"false\"><code>DESC</code> saklanan sırayı koruduğu için <code>42</code>, <code>95</code>, <code>70</code></item><item value=\"4\" correct=\"false\">Hiçbir satır, çünkü <code>DESC</code> daha düşük puanları filtreler</item></selection><p visible-if=\"wrong\"><code>95</code>, <code>70</code>, <code>42</code> öğesini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "Example: Descending order",
            "id": 91784,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>name</code> değeri <code>Reese Jones</code> olan öğenin ilk sırada gelmesini sağlayacak bir anahtar kodla.<br /></p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; score int&#xA;);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Jean Miller', 5);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Emma Brown', 8);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Reese Jones', 2);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Kim Lee', 9);&#xA;\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"score\" /></row><row><data content=\"Jean Miller\" /><data content=\"5\" /></row><row><data content=\"Emma Brown\" /><data content=\"8\" /></row><row><data content=\"Reese Jones\" /><data content=\"2\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"DESC\" class=\"keyword\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"37\" endIndex=\"41\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"score\" /></row><row><data content=\"Reese Jones\" /><data content=\"2\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row><row><data content=\"Jean Miller\" /><data content=\"5\" /></row><row><data content=\"Emma Brown\" /><data content=\"8\" /></row></table></output></code><p visible-if=\"wrong\"><code>DESC</code> ifadesini yazdığından emin ol.</p></body></html>"
          },
          {
            "title": "Question: The `=` operator 2",
            "id": 91793,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu sorgu ne tür öğeleri filtreliyor?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" books\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" title = \" /><text value=\"'The Prince'\" class=\"string\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>title</code> özelliği <code>'The Prince'</code> değerine eşit olan kitap öğeleri</item><item value=\"2\" correct=\"false\"><code>title</code> özelliği <code>'The Prince'</code> değerinden farklı olan kitap öğeleri</item><item value=\"3\" correct=\"false\">Tüm özellikleri <code>'The Prince'</code> değerine eşit olan kitap öğeleri</item></selection><p visible-if=\"wrong\"><code>title</code> özelliği <code>'The Prince'</code> değerine eşit olan kitap öğeleri.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Tabloda <code>'The Prince'</code> başlıklı iki kitap ve <code>'The Little Prince'</code> başlıklı bir kitap var. Sorgu hangi satırları döndürür?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" books\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" title = \" /><text value=\"'The Prince'\" class=\"string\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>title</code> değeri <code>'The Prince'</code> olan iki satırı da</item><item value=\"2\" correct=\"false\">Yalnızca <code>'The Little Prince'</code> başlıklı satırı</item><item value=\"3\" correct=\"false\"><code>SELECT *</code> filtreyi yok saydığı için üç satırın tümünü</item><item value=\"4\" correct=\"false\"><code>WHERE</code> bir eşleşmeden sonra durduğu için yalnızca ilk eşleşen satırı</item></selection><p visible-if=\"wrong\"><code>title</code> değeri <code>'The Prince'</code> olan iki satırı da.</p></body></html>"
          },
          {
            "title": "Example: WHERE",
            "id": 91791,
