            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Fonksiyonun içinde kullanmak üzere sabiti oluştur.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"25\" endIndex=\"30\" /><option startIndex=\"31\" endIndex=\"37\" /><option startIndex=\"38\" endIndex=\"39\" /><option startIndex=\"40\" endIndex=\"43\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"showHealth\" class=\"title\" /><text value=\"(\" /><text value=\"\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" health = \" /><text value=\"100\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Player Health: &quot;\" class=\"string\" /><text value=\" + health);\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"showHealth();\" /></content></code><p visible-if=\"wrong\">Önce <code>const</code>, ardından <code>health</code> ve sonra <code>=</code>, <code>100</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          },
          {
