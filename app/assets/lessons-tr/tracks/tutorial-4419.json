            "id": 148006,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Görüntüleme ifadesini tamamla.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"78\" endIndex=\"85\" /><option startIndex=\"85\" endIndex=\"86\" /><option startIndex=\"86\" endIndex=\"89\" /><option startIndex=\"102\" endIndex=\"108\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"gameState\" class=\"title\" /><text value=\"(\" /><text value=\"\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" playing = \" /><text value=\"&quot;Playing&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" paused = \" /><text value=\"&quot;Paused&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;State: &quot;\" class=\"string\" /><text value=\" + paused);\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"gameState();\" /></content></code><p visible-if=\"wrong\">Önce <code>console</code>, ardından <code>.</code> ve sonra <code>log</code>, <code>paused</code> öğelerini seçtiğinden emin ol.</p></body></html>"
