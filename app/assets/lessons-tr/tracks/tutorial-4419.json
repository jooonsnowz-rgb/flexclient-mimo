            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bir fonksiyona değer geçirmek için önce fonksiyonun parantezlerinin içine <strong>parametre</strong> adı verilen bir değişken ekleriz. Burada <code>item</code> değerini geçireceğiz.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"pickUp\" /></content></option><option correct=\"false\"><content><text value=\"function\" /></content></option><option startIndex=\"16\" endIndex=\"20\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"pickUp\" class=\"title\" /><text value=\"(\" /><text value=\"item\" class=\"params\" /><text value=\") \" /><text value=\"{}\" /></content></code><p visible-if=\"wrong\"><code>item</code> öğesini seçtiğinden emin ol.</p></body></html>"
          },
