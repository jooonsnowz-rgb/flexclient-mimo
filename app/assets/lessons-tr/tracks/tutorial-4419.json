            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>state</code> parametresini fonksiyona ekle.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"19\" endIndex=\"24\" isDefault=\"true\" /></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"gameState\" class=\"title\" /><text value=\"(\" /><text value=\"state\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;State: &quot;\" class=\"string\" /><text value=\" + state);\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"gameState(\" /><text value=\"&quot;Playing&quot;\" class=\"string\" /><text value=\");}\" /></content></code><p visible-if=\"wrong\"><code>state</code> ifadesini yazdığından emin ol.</p></body></html>"
