            "interactiveContent": "<!DOCTYPE html ><html><body><p>Ne olduğunu görmek için <code>AnimatedSprite</code> örneğinin <code>draw()</code> metodunu çağır.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"200\" endIndex=\"215\" isDefault=\"true\" /></interactions><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"Sprite\" class=\"title\" /><text value=\" \" /><text value=\"{\" /><text type=\"break\" /><text value=\" draw() {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Drawing sprite.&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"AnimatedSprite\" class=\"title\" /><text value=\" \" /><text value=\"extends\" class=\"keyword\" /><text value=\" \" /><text value=\"Sprite\" class=\"title\" /><text value=\" \" /><text value=\"{\" /><text type=\"break\" /><text value=\" draw() {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Playing animation frames.&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" mySprite = \" /><text value=\"new\" class=\"keyword\" /><text value=\" AnimatedSprite();\" /><text type=\"break\" /><text value=\"mySprite.draw();\" /><text type=\"break\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\"><code>mySprite.draw()</code> ifadesini yazdığından emin ol.</p></body></html>"
