          {
            "title": "Lesson #10",
            "id": 150042,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>Bat</code> sınıfındaki metot, <code>Enemy</code> sınıfının metodunu geçersiz kılıyor mu?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"Enemy\" class=\"title\" /><text value=\" \" /><text value=\"{\" /><text type=\"break\" /><text value=\" attack(target) {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Hit &quot;\" class=\"string\" /><text value=\" + target);\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"Bat\" class=\"title\" /><text value=\" \" /><text value=\"extends\" class=\"keyword\" /><text value=\" \" /><text value=\"Enemy\" class=\"title\" /><text value=\" \" /><text value=\"{\" /><text type=\"break\" /><text value=\" bite(target) {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"if\" class=\"keyword\" /><text value=\" (target === \" /><text value=\"&quot;player&quot;\" class=\"string\" /><text value=\") {\" /><text type=\"break\" /><text value=\"   \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Hit &quot;\" class=\"string\" /><text value=\" + target);\" /><text type=\"break\" /><text value=\"  }\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Hayır, farklı bir adı var</item><item value=\"2\" correct=\"false\">Evet, aynı parametreye sahip</item></selection><p visible-if=\"wrong\">Hayır, farklı bir adı var.</p></body></html>"
