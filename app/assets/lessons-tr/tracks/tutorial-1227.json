            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bazen yepyeni bir dize oluşturmadan bir dizenin içindeki verileri güncellememiz gerekir. Örneğin, günlük öğle yemeği spesiyalini güncellemek gibi.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"special = \" /><text value=\"&quot;Today's special is pasta&quot;\" class=\"string\" /></content></code></body></html>",
            "hardModeSelected": true
