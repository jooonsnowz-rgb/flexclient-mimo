          {
            "title": "Example: Aliasing",
            "id": 97087,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Projenin <code>hours</code> değerlerini topla, ardından sonuç sütununa <code>duration</code> takma adını ver.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE project_time (&#xA; employee varchar(255),&#xA; hours int&#xA;);&#xA;&#xA;INSERT INTO project_time(employee, hours)&#xA;VALUES ('Mike', 8);&#xA;&#xA;INSERT INTO project_time(employee, hours)&#xA;VALUES ('Mona', 20);&#xA;&#xA;INSERT INTO project_time(employee, hours)&#xA;VALUES ('Mary', 12);&#xA;\"><tables><table name=\"project_time\"><row><header content=\"employee\" /><header content=\"hours\" /></row><row><data content=\"Mike\" /><data content=\"8\" /></row><row><data content=\"Mona\" /><data content=\"20\" /></row><row><data content=\"Mary\" /><data content=\"12\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"SUM\" class=\"keyword\" /><text value=\"(\" /><text value=\"hours\" class=\"keyword\" /><text value=\") \" /><text value=\"AS\" class=\"keyword\" /><text value=\" \" /><text value=\"duration\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" project_time;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"7\" endIndex=\"29\" /></interactions><output><table name=\"Result\"><row><header content=\"duration\" /></row><row><data content=\"40\" /></row></table></output></code><p visible-if=\"wrong\"><code>SUM(hours) AS duration</code> ifadesini yazdığından emin ol.</p></body></html>"
          },
          {
            "title": "Question: Query explanation",
            "id": 100541,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu sorgu ne yapar?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE wishlist (&#xA; item varchar(255),&#xA; price numeric(2,1),&#xA; category varchar(255)&#xA;);&#xA;&#xA;INSERT INTO wishlist (item, price, category)&#xA;VALUES ('headphones', 250, 'electronics');&#xA;&#xA;INSERT INTO wishlist (item, price, category)&#xA;VALUES ('pencils', 37, 'stationery');&#xA;&#xA;INSERT INTO wishlist (item, price, category)&#xA;VALUES ('phone charger', 110, 'electronics');&#xA;&#xA;INSERT INTO wishlist (item, price, category)&#xA;VALUES ('daily planner', 29, 'stationery');&#xA;&#xA;\"><tables><table name=\"wishlist\"><row><header content=\"item\" /><header content=\"price\" /><header content=\"category\" /></row><row><data content=\"headphones\" /><data content=\"250\" /><data content=\"electronics\" /></row><row><data content=\"pencils\" /><data content=\"37\" /><data content=\"stationery\" /></row><row><data content=\"phone charger\" /><data content=\"110\" /><data content=\"electronics\" /></row><row><data content=\"daily planner\" /><data content=\"29\" /><data content=\"stationery\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"category\" class=\"keyword\" /><text value=\", \" /><text value=\"SUM\" class=\"keyword\" /><text value=\"(price)\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" wishlist\" /><text type=\"break\" /><text value=\"GROUP\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" \" /><text value=\"category\" class=\"keyword\" /><text value=\";\" /></content><output><table name=\"Result\"><row><header content=\"category\" /><header content=\"SUM(price)\" /></row><row><data content=\"electronics\" /><data content=\"360\" /></row><row><data content=\"stationery\" /><data content=\"66\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>wishlist</code> öğelerini <code>category</code>'ye göre gruplandırır ve her kategorideki fiyatları toplar</item><item value=\"2\" correct=\"false\"><code>price</code>'a göre <code>wishlist</code> öğelerini gruplandırır </item><item value=\"3\" correct=\"false\">Tüm <code>price</code> değerlerini tek bir sonuçta toplar</item></selection><p visible-if=\"wrong\"><code>wishlist</code> öğelerini <code>category</code>'ye göre gruplandırır ve her kategorideki fiyatları toplar.</p></body></html>"
          },
          {
