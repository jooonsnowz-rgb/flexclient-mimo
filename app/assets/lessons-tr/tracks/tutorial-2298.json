            "interactiveContent": "<!DOCTYPE html ><html><body><p>Proje <code>hours</code> değerlerini topla.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE project_time (&#xA; employee varchar(255),&#xA; hours int&#xA;);&#xA;&#xA;INSERT INTO project_time(employee, hours)&#xA;VALUES ('Mike', 8);&#xA;&#xA;INSERT INTO project_time(employee, hours)&#xA;VALUES ('Mona', 20);&#xA;&#xA;INSERT INTO project_time(employee, hours)&#xA;VALUES ('Mary', 12);&#xA;\"><tables><table name=\"project_time\"><row><header content=\"employee\" /><header content=\"hours\" /></row><row><data content=\"Mike\" /><data content=\"8\" /></row><row><data content=\"Mona\" /><data content=\"20\" /></row><row><data content=\"Mary\" /><data content=\"12\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"SUM\" class=\"keyword\" /><text value=\"(\" /><text value=\"hours\" class=\"keyword\" /><text value=\")\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" project_time;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"7\" endIndex=\"17\" /></interactions><output><table name=\"Result\"><row><header content=\"SUM(hours)\" /></row><row><data content=\"40\" /></row></table></output></code><p visible-if=\"wrong\"><code>SUM(hours)</code> ifadesini yazdığından emin ol.</p></body></html>"
