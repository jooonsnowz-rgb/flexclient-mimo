ext value=\" \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'e%'\" class=\"string\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"58\" endIndex=\"64\" /><option startIndex=\"65\" endIndex=\"73\" /><option startIndex=\"74\" endIndex=\"78\" /><option startIndex=\"79\" endIndex=\"83\" /><option correct=\"false\"><content><text value=\"=\" /></content></option><option correct=\"false\"><content><text value=\"'e'\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"category\" /><header content=\"COUNT(*)\" /></row><row><data content=\"electronics\" /><data content=\"2\" /></row></table></output></code><p visible-if=\"wrong\">Önce <code>HAVING</code>, ardından <code>category</code> ve sonra <code>LIKE</code>, <code>'e%'</code> öğelerini seçtiğinden emin ol.</p></body></html>"
