            "title": "Question: MAX",
            "id": 96941,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu sorgunun sonucu nedir?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE coffee (&#xA; type varchar(255),&#xA; price numeric(3,2)&#xA;);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('espresso', 3);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('macchiato', 5);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('americano', 4.5);&#xA;&#xA;\"><tables><table name=\"coffee\"><row><header content=\"type\" /><header content=\"price\" /></row><row><data content=\"espresso\" /><data content=\"3\" /></row><row><data content=\"macchiato\" /><data content=\"5\" /></row><row><data content=\"americano\" /><data content=\"4.5\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"MAX\" class=\"keyword\" /><text value=\"(price)\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" coffee;\" /></content><output><table name=\"Result\"><row><header content=\"MAX(price)\" /></row><row><data content=\"5\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>5</code></item><item value=\"2\" correct=\"false\"><code>3</code></item><item value=\"3\" correct=\"false\"><code>4.5</code></item></selection><p visible-if=\"wrong\"><code>5</code> öğesini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "Example: MIN",
            "id": 96942,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>MIN</code> ile en küçük <code>price</code> değerini seç.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE coffee (&#xA; type varchar(255),&#xA; price numeric(3,2)&#xA;);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('espresso', 3);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('macchiato', 5);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('americano', 4.5);&#xA;&#xA;\"><tables><table name=\"coffee\"><row><header content=\"type\" /><header content=\"price\" /></row><row><data content=\"espresso\" /><data content=\"3\" /></row><row><data content=\"macchiato\" /><data content=\"5\" /></row><row><data content=\"americano\" /><data content=\"4.5\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"MIN\" class=\"keyword\" /><text value=\"(price)\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" coffee;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"0\" endIndex=\"17\" /></interactions><output><table name=\"Result\"><row><header content=\"MIN(price)\" /></row><row><data content=\"3\" /></row></table></output></code><p visible-if=\"wrong\"><code>SELECT MIN(price)</code> ifadesini yazdığından emin ol.</p></body></html>"
          },
          {
            "title": "Example: AVG",
            "id": 96946,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>AVG</code> ile ortalama <code>price</code> değerini seç.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE coffee (&#xA; type varchar(255),&#xA; price numeric(3,2)&#xA;);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('espresso', 3);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('macchiato', 5);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('americano', 4.5);&#xA;&#xA;\"><tables><table name=\"coffee\"><row><header content=\"type\" /><header content=\"price\" /></row><row><data content=\"espresso\" /><data content=\"3\" /></row><row><data content=\"macchiato\" /><data content=\"5\" /></row><row><data content=\"americano\" /><data content=\"4.5\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"AVG\" class=\"keyword\" /><text value=\"(price)\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" coffee;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"0\" endIndex=\"17\" /></interactions><output><table name=\"Result\"><row><header content=\"AVG(price)\" /></row><row><data content=\"4.16666666666667\" /></row></table></output></code><p visible-if=\"wrong\"><code>SELECT AVG(price)</code> ifadesini yazdığından emin ol.</p></body></html>"
          },
          {
            "title": "Question: Aliasing",
            "id": 96944,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Sonuç tablosunda hangi sütun adını göreceğiz?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE coffee (&#xA; type varchar(255),&#xA; price numeric(3,2)&#xA;);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('espresso', 3);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('macchiato', 5);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('americano', 4.5);&#xA;&#xA;\"><tables><table name=\"coffee\"><row><header content=\"type\" /><header content=\"price\" /></row><row><data content=\"espresso\" /><data content=\"3\" /></row><row><data content=\"macchiato\" /><data content=\"5\" /></row><row><data content=\"americano\" /><data content=\"4.5\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"MIN\" class=\"keyword\" /><text value=\"(price) \" /><text value=\"AS\" class=\"keyword\" /><text value=\" cheapest\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" coffee;\" /></content><output><table name=\"Result\"><row><header content=\"cheapest\" /></row><row><data content=\"3\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>cheapest</code></item><item value=\"2\" correct=\"false\"><code>price</code></item><item value=\"3\" correct=\"false\"><code>3</code></item></selection><p visible-if=\"wrong\"><code>cheapest</code> öğesini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "Example: Aliasing",
            "id": 96947,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>AS</code> kullanarak ortalama <code>price</code> değerini <code>average_price</code> takma adı altında seç.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE coffee (&#xA; type varchar(255),&#xA; price numeric(3,2)&#xA;);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('espresso', 3);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('macchiato', 5);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('americano', 4.5);&#xA;&#xA;\"><tables><table name=\"coffee\"><row><header content=\"type\" /><header content=\"price\" /></row><row><data content=\"espresso\" /><data content=\"3\" /></row><row><data content=\"macchiato\" /><data content=\"5\" /></row><row><data content=\"americano\" /><data content=\"4.5\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"AVG\" class=\"keyword\" /><text value=\"(price) \" /><text value=\"AS\" class=\"keyword\" /><text value=\" average_price\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" coffee;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"7\" endIndex=\"34\" /></interactions><output><table name=\"Result\"><row><header content=\"average_price\" /></row><row><data content=\"4.16666666666667\" /></row></table></output></code><p visible-if=\"wrong\"><code>AVG(price) AS average_price</code> ifadesini yazdığından emin ol.</p></body></html>"
          },
