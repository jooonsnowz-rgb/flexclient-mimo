            "title": "Question: COUNT (*)",
            "id": 97079,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu sorgunun sonucu nedir?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE project_time (&#xA; employee varchar(255),&#xA; hours int&#xA;);&#xA;&#xA;INSERT INTO project_time(employee, hours)&#xA;VALUES ('Mike', 8);&#xA;&#xA;INSERT INTO project_time(employee, hours)&#xA;VALUES ('Mona', 20);&#xA;&#xA;INSERT INTO project_time(employee, hours)&#xA;VALUES ('Mary', 12);&#xA;\"><tables><table name=\"project_time\"><row><header content=\"employee\" /><header content=\"hours\" /></row><row><data content=\"Mike\" /><data content=\"8\" /></row><row><data content=\"Mona\" /><data content=\"20\" /></row><row><data content=\"Mary\" /><data content=\"12\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"COUNT\" class=\"keyword\" /><text value=\"(*)\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" project_time;\" /></content><output><table name=\"Result\"><row><header content=\"COUNT(*)\" /></row><row><data content=\"3\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>3</code> çünkü üç satırımız var</item><item value=\"2\" correct=\"false\"><code>6</code> çünkü her biri üç satırdan oluşan iki sütunumuz var</item><item value=\"3\" correct=\"false\"><code>2</code> çünkü iki sütunumuz var</item></selection><p visible-if=\"wrong\"><code>3</code> çünkü üç satırımız var.</p></body></html>"
          },
