          {
            "title": "Example: Count by column 2",
            "id": 97083,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>employee</code> sütunundaki değerleri say.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE project_time (&#xA; employee varchar(255),&#xA; hours int&#xA;);&#xA;&#xA;INSERT INTO project_time(employee, hours)&#xA;VALUES ('Mike', 8);&#xA;&#xA;INSERT INTO project_time(employee, hours)&#xA;VALUES (NULL, 20);&#xA;&#xA;INSERT INTO project_time(employee, hours)&#xA;VALUES ('Mary', 12);&#xA;\"><tables><table name=\"project_time\"><row><header content=\"employee\" /><header content=\"hours\" /></row><row><data content=\"Mike\" /><data content=\"8\" /></row><row><data content=\"\" /><data content=\"20\" /></row><row><data content=\"Mary\" /><data content=\"12\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"COUNT\" class=\"keyword\" /><text value=\"(employee) \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" project_time;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"7\" endIndex=\"12\" /><option startIndex=\"12\" endIndex=\"13\" /><option startIndex=\"13\" endIndex=\"21\" /><option startIndex=\"21\" endIndex=\"22\" /><option correct=\"false\"><content><text value=\".\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"COUNT(employee)\" /></row><row><data content=\"2\" /></row></table></output></code><p visible-if=\"wrong\">Önce <code>COUNT</code>, ardından <code>(</code> ve sonra <code>employee</code>, <code>)</code> öğelerini seçtiğinden emin ol.</p></body></html>"
