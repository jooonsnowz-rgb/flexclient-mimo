          {
            "title": "Example: Subquery",
            "id": 113137,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>En yeni oyunun <code>name</code> değerini seç.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" = \" /><text type=\"break\" /><text value=\"(\" /><text type=\"break\" /><text value=\" \" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"MAX\" class=\"keyword\" /><text value=\"(\" /><text value=\"release\" class=\"keyword\" /><text value=\") \" /><text type=\"break\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"MIN\" /></content></option><option startIndex=\"76\" endIndex=\"87\" /><option startIndex=\"7\" endIndex=\"11\" /><option startIndex=\"17\" endIndex=\"28\" /><option startIndex=\"56\" endIndex=\"68\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /></row><row><data content=\"Super Mario 3D World\" /></row></table></output></code><p visible-if=\"wrong\">Önce <code>name</code>, ardından <code>mario_games</code> ve sonra <code>MAX(release)</code>, <code>mario_games</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "Example: Subquery",
            "id": 113138,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>En eski oyunun <code>name</code> değerini, en erken <code>release</code> tarihini bulmak için <code>MIN</code> kullanan bir alt sorguyla seç.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" = \" /><text type=\"break\" /><text value=\"(\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"MIN\" class=\"keyword\" /><text value=\"(\" /><text value=\"release\" class=\"keyword\" /><text value=\") \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games);\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"47\" endIndex=\"83\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /></row><row><data content=\"Mario Bros.\" /></row></table></output></code><p visible-if=\"wrong\"><code>SELECT MIN(release) FROM mario_games</code> ifadesini yazdığından emin ol.</p></body></html>"
          },
          {
            "title": "Question: Only within the query",
            "id": 113136,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu sorgu ne arıyor?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" &gt; \" /><text type=\"break\" /><text value=\"(\" /><text type=\"break\" /><text value=\" \" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"AVG\" class=\"keyword\" /><text value=\"(\" /><text value=\"release\" class=\"keyword\" /><text value=\") \" /><text type=\"break\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\");\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Ortalama çıkış yılından sonra yayımlanan tüm oyunların adı</item><item value=\"2\" correct=\"false\">Tüm oyunların ortalama çıkış yılı</item><item value=\"3\" correct=\"false\">Ortalama çıkış yılından önce yayımlanan tüm oyunların adı</item></selection><p visible-if=\"wrong\">Ortalama çıkış yılından sonra yayımlanan tüm oyunların adı.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Alt sorgunun ortalama çıkış yılı olarak <code>2005</code> döndürdüğünü varsay. Dış sorgu hangi oyunları döndürebilir?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" &gt; \" /><text type=\"break\" /><text value=\"(\" /><text type=\"break\" /><text value=\" \" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"AVG\" class=\"keyword\" /><text value=\"(\" /><text value=\"release\" class=\"keyword\" /><text value=\") \" /><text type=\"break\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\");\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>2005</code> sonrasında çıkan oyunları</item><item value=\"2\" correct=\"false\"><code>2005</code> yılını içeren tek bir satırı</item><item value=\"3\" correct=\"false\"><code>2005</code> öncesinde çıkan oyunları</item></selection><p visible-if=\"wrong\"><code>2005</code> sonrasında çıkan oyunları.</p></body></html>"
          },
          {
            "title": "Question: Another table",
            "id": 114257,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Farklı bir tablo üzerinde alt sorgu yazarken neyi farklı yapmalıyız?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Hiçbir şey, her iki alt sorgu da aynı anahtar kelimeleri kullanır ve aynı kurallara sahiptir</item><item value=\"2\" correct=\"false\">Başka bir tablodaki alt sorgu, sütunlar için takma adlar kullanmalıdır</item><item value=\"3\" correct=\"false\">Aynı tablodaki alt sorgu birden çok sütun döndürmelidir</item></selection><p visible-if=\"wrong\">Hiçbir şey, her iki alt sorgu da aynı anahtar kelimeleri kullanır ve aynı kurallara sahiptir.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Dış sorgu siparişleri, alt sorgu ise müşteri kimliklerini okuyor. Yalnızca tablolar farklı olduğu için hangi ek söz dizimi gerekir?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Hiçbiri; alt sorgu aynı SQL kurallarına uyar</item><item value=\"2\" correct=\"false\">Alt sorgudaki her sütun için bir takma ad</item><item value=\"3\" correct=\"false\">Alt sorgunun içinde bir <code>JOIN</code></item></selection><p visible-if=\"wrong\">Hiçbiri; alt sorgu aynı SQL kurallarına uyar.</p></body></html>"
          },
          {
            "title": "Example: Another table",
            "id": 114258,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>snack</code> içindeki öğeler, ortak bir <code>ID</code> aracılığıyla <code>macros</code> içindeki besin bilgileriyle ilişkilendirilmiştir. Bir elmanın makro besin bilgilerini bul.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE snack (&#xA; id varchar(255),&#xA; name varchar(255), &#xA; type varchar(255)&#xA;);&#xA;&#xA;INSERT INTO snack (id, name, type)&#xA;VALUES ('001', 'apple', 'vegan');&#xA;INSERT INTO snack (id, name, type)&#xA;VALUES ('133', 'Cheerios', 'vegan');&#xA;INSERT INTO snack (id, name, type)&#xA;VALUES ('455', 'chocolate', 'vegetarian');&#xA;INSERT INTO snack (id, name, type)&#xA;VALUES ('060', 'cashews', 'vegan');&#xA;&#xA;&#xA;&#xA;&#xA;CREATE TABLE macros (&#xA; id varchar(255),&#xA; carbs_g numeric,&#xA; protein_g numeric,&#xA; fat_g numeric&#xA;);&#xA;&#xA;INSERT INTO macros (id, carbs_g, protein_g, fat_g)&#xA;VALUES ('001', 14, 0.2, 0.2 );&#xA;INSERT INTO macros (id, carbs_g, protein_g, fat_g)&#xA;VALUES ('455', 2, 15, 12 );&#xA;INSERT INTO macros (id, carbs_g, protein_g, fat_g)&#xA;VALUES ('111', 0, 25, 7);&#xA;\"><tables><table name=\"snack\"><row><header content=\"id\" /><header content=\"name\" /><header content=\"type\" /></row><row><data content=\"001\" /><data content=\"apple\" /><data content=\"vegan\" /></row><row><data content=\"133\" /><data content=\"Cheerios\" /><data content=\"vegan\" /></row><row><data content=\"455\" /><data content=\"chocolate\" /><data content=\"vegetarian\" /></row><row><data content=\"060\" /><data content=\"cashews\" /><data content=\"vegan\" /></row></table><table name=\"macros\"><row><header content=\"id\" /><header content=\"carbs_g\" /><header content=\"protein_g\" /><header content=\"fat_g\" /></row><row><data content=\"001\" /><data content=\"14\" /><data content=\"0.2\" /><data content=\"0.2\" /></row><row><data content=\"455\" /><data content=\"2\" /><data content=\"15\" /><data content=\"12\" /></row><row><data content=\"111\" /><data content=\"0\" /><data content=\"25\" /><data content=\"7\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" carbs_g, protein_g, fat_g\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" macros\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"id\" class=\"keyword\" /><text value=\" = \" /><text type=\"break\" /><text value=\"(\" /><text type=\"break\" /><text value=\" \" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"id\" class=\"keyword\" /><text type=\"break\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" snack\" /><text type=\"break\" /><text value=\" \" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" = \" /><text value=\"'apple'\" class=\"string\" /><text type=\"break\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"76\" endIndex=\"81\" /><option startIndex=\"83\" endIndex=\"88\" /><option startIndex=\"89\" endIndex=\"93\" /><option startIndex=\"94\" endIndex=\"95\" /><option startIndex=\"96\" endIndex=\"103\" /><option correct=\"false\"><content><text value=\"*\" /></content></option><option startIndex=\"67\" endIndex=\"69\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"carbs_g\" /><header content=\"protein_g\" /><header content=\"fat_g\" /></row><row><data content=\"14\" /><data content=\"0.2\" /><data content=\"0.2\" /></row></table></output></code><p visible-if=\"wrong\">Önce <code>id</code>, ardından <code>snack</code> ve sonra <code>WHERE</code>, <code>name</code>, <code>=</code>, <code>'apple'</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "Example: IN budget greater",
            "id": 113299,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bütçesi 1800'den büyük olan departmanlardaki tüm çalışanları seç.</p><database visible-if=\"always\" bootstrapScript=\"&#xA;&#xA;CREATE TABLE employees (&#xA; employee_id INT (11),&#xA; first_name VARCHAR (20) DEFAULT NULL,&#xA; last_name VARCHAR (25) NOT NULL,&#xA; department_id INT (11) DEFAULT NULL&#xA;&#xA;);&#xA;CREATE TABLE departments (&#xA; department_id INT (11),&#xA; department_name VARCHAR (30) NOT NULL,&#xA; budget INT (11) DEFAULT NULL&#xA;);&#xA;INSERT INTO departments(department_id,department_name,budget) VALUES (1,'Administration',1700);&#xA;INSERT INTO departments(department_id,department_name,budget) VALUES (2,'Marketing',1800);&#xA;INSERT INTO departments(department_id,department_name,budget) VALUES (3,'Purchasing',1700);&#xA;INSERT INTO departments(department_id,department_name,budget) VALUES (4,'Human Resources',2400);&#xA;INSERT INTO departments(department_id,department_name,budget) VALUES (5,'Shipping',1500);&#xA;&#xA;&#xA;INSERT INTO employees(employee_id,first_name,last_name,department_id) VALUES (100,'Steven','King',4);&#xA;INSERT INTO employees(employee_id,first_name,last_name,department_id) VALUES (101,'Neena','Kochhar',9);&#xA;INSERT INTO employees(employee_id,first_name,last_name,department_id) VALUES (102,'Lex','De Haan',9);&#xA;INSERT INTO employees(employee_id,first_name,last_name,department_id) VALUES (103,'Alexander','Hunold',6);&#xA;INSERT INTO employees(employee_id,first_name,last_name,department_id) VALUES (104,'Bruce','Ernst',6);&#xA;\"><tables><table name=\"employees\"><row><header content=\"employee_id\" /><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"department_id\" /></row><row><data content=\"100\" /><data content=\"Steven\" /><data content=\"King\" /><data content=\"4\" /></row><row><data content=\"101\" /><data content=\"Neena\" /><data content=\"Kochhar\" /><data content=\"9\" /></row><row><data content=\"102\" /><data content=\"Lex\" /><data content=\"De Haan\" /><data content=\"9\" /></row><row><data content=\"103\" /><data content=\"Alexander\" /><data content=\"Hunold\" /><data content=\"6\" /></row><row><data content=\"104\" /><data content=\"Bruce\" /><data content=\"Ernst\" /><data content=\"6\" /></row></table><table name=\"departments\"><row><header content=\"department_id\" /><header content=\"department_name\" /><header content=\"budget\" /></row><row><data content=\"1\" /><data content=\"Administration\" /><data content=\"1700\" /></row><row><data content=\"2\" /><data content=\"Marketing\" /><data content=\"1800\" /></row><row><data content=\"3\" /><data content=\"Purchasing\" /><data content=\"1700\" /></row><row><data content=\"4\" /><data content=\"Human Resources\" /><data content=\"2400\" /></row><row><data content=\"5\" /><data content=\"Shipping\" /><data content=\"1500\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text type=\"break\" /><text value=\"employees\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text type=\"break\" /><text value=\"department_id \" /><text value=\"IN\" class=\"keyword\" /><text value=\" \" /><text type=\"break\" /><text value=\"( \" /><text type=\"break\" /><text value=\" \" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" department_id \" /><text type=\"break\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" departments \" /><text type=\"break\" /><text value=\" \" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" budget &gt; \" /><text value=\"1800\" class=\"number\" /><text type=\"break\" /><text value=\");\" /><text type=\"break\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"60\" endIndex=\"73\" /><option startIndex=\"81\" endIndex=\"92\" /><option startIndex=\"101\" endIndex=\"107\" /><option startIndex=\"108\" endIndex=\"109\" /><option startIndex=\"110\" endIndex=\"114\" /><option correct=\"false\"><content><text value=\"NOT\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"employee_id\" /><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"department_id\" /></row><row><data content=\"100\" /><data content=\"Steven\" /><data content=\"King\" /><data content=\"4\" /></row></table></output></code><p visible-if=\"wrong\">Önce <code>department_id</code>, ardından <code>departments</code> ve sonra <code>budget</code>, <code>&gt;</code>, <code>1800</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "Question: whats wrong",
            "id": 113298,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu sorguda sorun nedir?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" employees\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" department_id = (\" /><text type=\"break\" /><text value=\" \" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" department_id\" /><text type=\"break\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" departments\" /><text type=\"break\" /><text value=\" \" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" budget &gt; \" /><text value=\"2000\" class=\"number\" /><text type=\"break\" /><text value=\");\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Çok satırlı bir alt sorguyla <code>=</code> kullanır</item><item value=\"2\" correct=\"false\">Alt sorgular <code>WHERE</code> kullanamaz</item><item value=\"3\" correct=\"false\">Alt sorgu birden çok sütun döndürüyor</item></selection><p visible-if=\"wrong\">Çok satırlı bir alt sorguyla <code>=</code> kullanır.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Alt sorgu, bütçesi <code>2000</code> üzerinde olan birden fazla <code>department_id</code> değeri döndürebilir. Hangi düzenleme dış koşulu düzeltir?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" employees\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" department_id = (\" /><text type=\"break\" /><text value=\" \" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" department_id\" /><text type=\"break\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" departments\" /><text type=\"break\" /><text value=\" \" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" budget &gt; \" /><text value=\"2000\" class=\"number\" /><text type=\"break\" /><text value=\");\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>=</code> yerine <code>IN</code> kullanmak</item><item value=\"2\" correct=\"false\">Alt sorgunun <code>WHERE</code> yan tümcesini kaldırmak</item><item value=\"3\" correct=\"false\">Alt sorguyu <code>SELECT *</code> olarak değiştirmek</item></selection><p visible-if=\"wrong\"><code>=</code> yerine <code>IN</code> kullanmak öğesini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "Example: IN department name",
            "id": 113300,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pazarlama veya Satış departmanında çalışan tüm çalışanları seç.</p><database visible-if=\"always\" bootstrapScript=\"&#xA;&#xA;CREATE TABLE employees (&#xA; employee_id INT (11),&#xA; first_name VARCHAR (20) DEFAULT NULL,&#xA; last_name VARCHAR (25) NOT NULL,&#xA; department_id INT (11) DEFAULT NULL&#xA;&#xA;);&#xA;CREATE TABLE departments (&#xA; department_id INT (11),&#xA; department_name VARCHAR (30) NOT NULL,&#xA; budget INT (11) DEFAULT NULL&#xA;);&#xA;INSERT INTO departments(department_id,department_name,budget) VALUES (1,'Administration',1700);&#xA;INSERT INTO departments(department_id,department_name,budget) VALUES (2,'Marketing',1800);&#xA;INSERT INTO departments(department_id,department_name,budget) VALUES (3,'Purchasing',1700);&#xA;INSERT INTO departments(department_id,department_name,budget) VALUES (4,'Human Resources',2400);&#xA;INSERT INTO departments(department_id,department_name,budget) VALUES (5,'Sales',1500);&#xA;&#xA;&#xA;INSERT INTO employees(employee_id,first_name,last_name,department_id) VALUES (100,'Steven','King',2);&#xA;INSERT INTO employees(employee_id,first_name,last_name,department_id) VALUES (101,'Neena','Kochhar',9);&#xA;INSERT INTO employees(employee_id,first_name,last_name,department_id) VALUES (102,'Lex','De Haan',9);&#xA;INSERT INTO employees(employee_id,first_name,last_name,department_id) VALUES (103,'Alexander','Hunold',5);&#xA;INSERT INTO employees(employee_id,first_name,last_name,department_id) VALUES (104,'Bruce','Ernst',6);&#xA;\"><tables><table name=\"employees\"><row><header content=\"employee_id\" /><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"department_id\" /></row><row><data content=\"100\" /><data content=\"Steven\" /><data content=\"King\" /><data content=\"2\" /></row><row><data content=\"101\" /><data content=\"Neena\" /><data content=\"Kochhar\" /><data content=\"9\" /></row><row><data content=\"102\" /><data content=\"Lex\" /><data content=\"De Haan\" /><data content=\"9\" /></row><row><data content=\"103\" /><data content=\"Alexander\" /><data content=\"Hunold\" /><data content=\"5\" /></row><row><data content=\"104\" /><data content=\"Bruce\" /><data content=\"Ernst\" /><data content=\"6\" /></row></table><table name=\"departments\"><row><header content=\"department_id\" /><header content=\"department_name\" /><header content=\"budget\" /></row><row><data content=\"1\" /><data content=\"Administration\" /><data content=\"1700\" /></row><row><data content=\"2\" /><data content=\"Marketing\" /><data content=\"1800\" /></row><row><data content=\"3\" /><data content=\"Purchasing\" /><data content=\"1700\" /></row><row><data content=\"4\" /><data content=\"Human Resources\" /><data content=\"2400\" /></row><row><data content=\"5\" /><data content=\"Sales\" /><data content=\"1500\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text type=\"break\" /><text value=\"employees\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text type=\"break\" /><text value=\"department_id \" /><text value=\"IN\" class=\"keyword\" /><text value=\" \" /><text type=\"break\" /><text value=\"( \" /><text type=\"break\" /><text value=\" \" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" department_id \" /><text type=\"break\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" departments \" /><text type=\"break\" /><text value=\" \" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" department_name = \" /><text value=\"'Marketing'\" class=\"string\" /><text value=\" \" /><text type=\"break\" /><text value=\" \" /><text value=\"OR\" class=\"keyword\" /><text value=\" department_name = \" /><text value=\"'Sales'\" class=\"string\" /><text type=\"break\" /><text value=\");\" /><text type=\"break\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"133\" endIndex=\"161\" /></interactions><output><table name=\"Result\"><row><header content=\"employee_id\" /><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"department_id\" /></row><row><data content=\"100\" /><data content=\"Steven\" /><data content=\"King\" /><data content=\"2\" /></row><row><data content=\"103\" /><data content=\"Alexander\" /><data content=\"Hunold\" /><data content=\"5\" /></row></table></output></code><p visible-if=\"wrong\"><code>OR department_name = 'Sales'</code> ifadesini yazdığından emin ol.</p></body></html>"
