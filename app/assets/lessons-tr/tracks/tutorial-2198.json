            "id": 71600,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu <code>img</code> öğesinde sorun ne?</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"a\" class=\"name\" /><text value=\" \" /><text value=\"src\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;https://mimo.app/snapcat.png&quot;\" class=\"string\" /><text value=\"&gt;\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Etiket adı <code>a</code> etiketi değil, <code>img</code> olmalı</item><item value=\"2\" correct=\"false\">Hiçbir şey</item><item value=\"3\" correct=\"false\"><code>img</code> öğesinde kapanış etiketi eksik</item><item value=\"3\" correct=\"false\">Görüntüye erişmek için bir URL eksik</item></selection><p visible-if=\"wrong\">Etiket adı <code>a</code> etiketi değil, <code>img</code> olmalı.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Bu kodun sayfada bir görsel göstermesini istiyorsun. Ne değişmeli?</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"a\" class=\"name\" /><text value=\" \" /><text value=\"src\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;https://mimo.app/snapcat.png&quot;\" class=\"string\" /><text value=\"&gt;\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Etiket adı <code>a</code> etiketi değil, <code>img</code> olmalı</item><item value=\"2\" correct=\"false\"><code>src</code> özniteliği <code>href</code> olarak değiştirilmeli</item><item value=\"3\" correct=\"false\">Görsel dosyası adresi açılış ve kapanış etiketlerinin arasına yerleştirilmeli</item><item value=\"4\" correct=\"false\">Öğede URL'den sonra bağlantı metni bulunmalı</item></selection><p visible-if=\"wrong\">Etiket adı <code>a</code> etiketi değil, <code>img</code> olmalı.</p></body></html>",
            "hardModeSelected": true
