            "id": 77842,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu kod konsolda ne görüntüler?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"choice = \" /><text value=\"&quot;eclair&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" choice == \" /><text value=\"&quot;crème brûlée&quot;\" class=\"string\" /><text value=\": \" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"&quot;You have chosen ... wisely&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"else\" class=\"keyword\" /><text value=\":\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"&quot;You have chosen ... poorly&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text type=\"break\" /></content><output><content><text value=\"You have chosen ... poorly\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>You have chosen ... poorly</code></item><item value=\"2\" correct=\"false\"><code>You have chosen ... wisely</code></item><item value=\"3\" correct=\"false\">Hiçbir şey </item></selection><p visible-if=\"wrong\"><code>You have chosen ... poorly</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Bu kodun <code>You have chosen ... wisely</code> yazdırması için hangi değişiklik yapılmalı?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"choice = \" /><text value=\"&quot;eclair&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" choice == \" /><text value=\"&quot;crème brûlée&quot;\" class=\"string\" /><text value=\": \" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"&quot;You have chosen ... wisely&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"else\" class=\"keyword\" /><text value=\":\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"&quot;You have chosen ... poorly&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text type=\"break\" /></content><output><content><text value=\"You have chosen ... poorly\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>choice</code> değerini <code>\"crème brûlée\"</code> yapmak</item><item value=\"2\" correct=\"false\"><code>choice</code> değerini <code>\"crème\"</code> yapmak</item><item value=\"3\" correct=\"false\"><code>if</code> satırında <code>==</code> işaretini <code>=</code> ile değiştirmek</item></selection><p visible-if=\"wrong\"><code>choice</code> değerini <code>\"crème brûlée\"</code> yapmak.</p></body></html>"
