            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dönüştürme istisnasını <code>error</code> değişkeninde yakala.</p><code version=\"2\" codelang=\"python\" name=\"price.py\" visible-if=\"always\"><content><text value=\"price_text = \" /><text value=\"&quot;free&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"try\" class=\"keyword\" /><text value=\":\" /><text type=\"break\" /><text value=\"  price = float(price_text)\" /><text type=\"break\" /><text value=\"except\" class=\"keyword\" /><text value=\" ValueError \" /><text value=\"as\" class=\"keyword\" /><text value=\" error:\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"&quot;Price failed&quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"71\" endIndex=\"79\" /><option correct=\"false\"><content><text value=\"as message\" /></content></option><option correct=\"false\"><content><text value=\"as details\" /></content></option></options></interaction></interactions><output><content><text value=\"Price failed\" /></content></output></code><p visible-if=\"wrong\"><code>as error</code> öğesini seçtiğinden emin ol.</p></body></html>",
