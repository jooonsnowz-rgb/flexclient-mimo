            "hardModeContent": "<!DOCTYPE html ><html><body><p>Tamsayıya dönüştürülemeyen metin için işleyiciyi tamamla.</p><code version=\"2\" codelang=\"python\" name=\"entry.py\" visible-if=\"always\"><content><text value=\"entry = \" /><text value=\"&quot;none&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"try\" class=\"keyword\" /><text value=\":\" /><text type=\"break\" /><text value=\"  amount = int(entry)\" /><text type=\"break\" /><text value=\"except\" class=\"keyword\" /><text value=\" ValueError:\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"&quot;Enter a number&quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"31\" endIndex=\"34\" /><option startIndex=\"49\" endIndex=\"59\" /><option correct=\"false\"><content><text value=\"str\" /></content></option><option correct=\"false\"><content><text value=\"TypeError\" /></content></option><option correct=\"false\"><content><text value=\"KeyError\" /></content></option></options></interaction></interactions><output><content><text value=\"Enter a number\" /></content></output></code><p visible-if=\"wrong\">Önce <code>int</code>, ardından <code>ValueError</code> öğelerini seçtiğinden emin ol.</p></body></html>",
