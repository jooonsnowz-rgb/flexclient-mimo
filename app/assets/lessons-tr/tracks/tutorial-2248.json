            "interactiveContent": "<!DOCTYPE html ><html><body><p>Aşağıdaki kodu doğru girdiyi ekleyerek tamamla.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"sumNumbers\" class=\"title\" /><text value=\"(\" /><text value=\"numbers\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(numbers[\" /><text value=\"0\" class=\"number\" /><text value=\"] + numbers[\" /><text value=\"1\" class=\"number\" /><text value=\"]);\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" arr = [\" /><text value=\"3\" class=\"number\" /><text value=\", \" /><text value=\"5\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"sumNumbers(arr);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"85\" endIndex=\"87\" /><option startIndex=\"88\" endIndex=\"89\" /><option correct=\"false\"><content><text value=\"&quot;3&quot;,\" /></content></option><option correct=\"false\"><content><text value=\"&quot;5&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"8\" /></content></output></code><p visible-if=\"wrong\">Önce <code>3,</code>, ardından <code>5</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Fonksiyon <code>arr</code> dizisindeki ilk iki değeri toplar. Diziyi, konsola <code>8</code> yazdırmasını sağlayacak sayısal değerlerle tamamla.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"sumNumbers\" class=\"title\" /><text value=\"(\" /><text value=\"numbers\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(numbers[\" /><text value=\"0\" class=\"number\" /><text value=\"] + numbers[\" /><text value=\"1\" class=\"number\" /><text value=\"]);\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" arr = [\" /><text value=\"3\" class=\"number\" /><text value=\", \" /><text value=\"5\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"sumNumbers(arr);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"85\" endIndex=\"87\" /><option startIndex=\"88\" endIndex=\"89\" /><option correct=\"false\"><content><text value=\"&quot;3&quot;,\" /></content></option><option correct=\"false\"><content><text value=\"&quot;5&quot;\" /></content></option><option correct=\"false\"><content><text value=\"8\" /></content></option></options></interaction></interactions><output><content><text value=\"8\" /></content></output></code><p visible-if=\"wrong\">Önce <code>3,</code>, ardından <code>5</code> öğelerini seçtiğinden emin ol.</p></body></html>",
