            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>true</code> veya <code>false</code> önündeki <code>!</code> işaretine ne ad veririz? </p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\"><code>!</code> işareti olumsuzlama operatörüdür</item><item correct=\"false\" value=\"2\"><code>!</code> işareti toplama operatörüdür</item></selection><p visible-if=\"wrong\"><code>!</code> işareti olumsuzlama operatörüdür.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Bir Boolean değeri karşıtına dönüştürmek için hangi operatörü kullanırsın?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Olumsuzlama operatörü <code>!</code></item><item value=\"2\" correct=\"false\">Toplama operatörü <code>+</code></item><item value=\"3\" correct=\"false\">Atama operatörü <code>=</code></item></selection><p visible-if=\"wrong\">Olumsuzlama operatörü <code>!</code></p></body></html>"
