            "interactiveContent": "<!DOCTYPE html ><html><body><p>Konsolda <code>false</code> görüntüle.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\"><content><text value=\"console\" class=\"built_in\" /><text value=\".log(!\" /><text value=\"true\" class=\"literal\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"12\" endIndex=\"17\" /><option correct=\"false\"><content><text value=\"!false\" /></content></option></options></interaction></interactions><output><content><text value=\"false\" /></content></output></code><p visible-if=\"wrong\"><code>!true</code> öğesini seçtiğinden emin ol.</p></body></html>",
