          {
            "title": "Question 1",
            "id": 62211,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>!</code> operatörü ne yapar?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\"><code>true</code> veya <code>false</code> değerlerini karşıtlarına dönüştürür</item><item correct=\"false\" value=\"2\">Değerlerin eşit olup olmadığını kontrol eder</item></selection><p visible-if=\"wrong\"><code>true</code> veya <code>false</code> değerlerini karşıtlarına dönüştürür.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Bir ayarın mevcut değeri <code>true</code>. Bu değerin önüne <code>!</code> koymak ne yapar?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Değeri <code>false</code> olarak değiştirir.</item><item value=\"2\" correct=\"false\">Değerin <code>false</code> değerine eşit olup olmadığını kontrol eder.</item><item value=\"3\" correct=\"false\">Değeri <code>\"true\"</code> dizesine dönüştürür.</item></selection><p visible-if=\"wrong\">Değeri <code>false</code> olarak değiştirir.</p></body></html>",
