            "id": 62205,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Değişkeni oluşturarak ve içine <code>false</code> depolayarak çerezleri engelle.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" allowCookies = \" /><text value=\"false\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"6\" endIndex=\"18\" /><option startIndex=\"21\" endIndex=\"26\" /><option correct=\"false\"><content><text value=\"&quot;false&quot;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Önce <code>allowCookies</code>, ardından <code>false</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Çerezlere izin verilmeyecek şekilde <code>allowCookies</code> değişkenini tanımla.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" \" /><text value=\"allowCookies\" /><text value=\" \" /><text value=\"=\" /><text value=\" \" /><text value=\"false\" class=\"literal\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"5\" /><option startIndex=\"6\" endIndex=\"18\" /><option startIndex=\"21\" endIndex=\"26\" /><option correct=\"false\"><content><text value=\"let\" /></content></option><option correct=\"false\"><content><text value=\"true\" /></content></option><option correct=\"false\"><content><text value=\"&quot;false&quot;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Önce <code>const</code>, ardından <code>allowCookies</code> ve son olarak <code>false</code> öğelerini seçtiğinden emin ol.</p></body></html>"
