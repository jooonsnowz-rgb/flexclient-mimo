          {
            "title": "Lesson #15",
            "id": 147891,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>\"Key\"</code> içeren bir diziyi <code>items</code> değişkenine ata.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"{\" /></content></option><option correct=\"false\"><content><text value=\"}\" /></content></option><option startIndex=\"14\" endIndex=\"15\" /><option startIndex=\"15\" endIndex=\"20\" /><option startIndex=\"20\" endIndex=\"21\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" items = [\" /><text value=\"&quot;Key&quot;\" class=\"string\" /><text value=\"];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(items);\" /></content></code><p visible-if=\"wrong\">Önce <code>[</code>, ardından <code>\"Key\"</code> ve son olarak <code>]</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          },
          {
