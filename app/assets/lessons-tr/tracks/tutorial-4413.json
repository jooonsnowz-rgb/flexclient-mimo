            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bir dizide saklayabileceğimiz değerlerin sayısı kaçtır?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">İstediğimiz kadar</item><item value=\"2\" correct=\"false\">3</item></selection><p visible-if=\"wrong\">İstediğimiz kadar.</p></body></html>"
