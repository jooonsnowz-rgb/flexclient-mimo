            "id": 147892,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>projectiles</code> adlı değişkene boş bir dizi ata.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"[&quot;Arrow&quot;]\" /></content></option><option startIndex=\"20\" endIndex=\"22\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" projectiles = [];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(projectiles);\" /></content></code><p visible-if=\"wrong\"><code>[]</code> öğesini seçtiğinden emin ol.</p></body></html>"
          },
          {
