          {
            "title": "Defining a range",
            "id": 91470,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>AND</code> anahtar sözcüğüyle ayırarak aralığın başlangıcını, örneğin <code>9</code>'u, ve aralığın sonunu, örneğin <code>10</code>'u belirleriz.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE movies (&#xA;title varchar(255),&#xA;rating numeric (1,1)&#xA;);&#xA;&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Godfather', 9.2);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Matrix', 8.7);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('La Strada', 8);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Dark Knight', 9);\"><tables><table name=\"movies\"><row><header content=\"title\" /><header content=\"rating\" /></row><row><data content=\"The Godfather\" /><data content=\"9.2\" /></row><row><data content=\"The Matrix\" /><data content=\"8.7\" /></row><row><data content=\"La Strada\" /><data content=\"8\" /></row><row><data content=\"The Dark Knight\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" movies\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" rating \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"9\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"10\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"42\" endIndex=\"43\" /><option startIndex=\"44\" endIndex=\"47\" /><option startIndex=\"48\" endIndex=\"50\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"title\" /><header content=\"rating\" /></row><row><data content=\"The Godfather\" /><data content=\"9.2\" /></row><row><data content=\"The Dark Knight\" /><data content=\"9\" /></row></table></output></code><p visible-if=\"wrong\">Önce <code>9</code>, ardından <code>AND</code> ve son olarak <code>10</code> öğelerini seçtiğinden emin ol.</p></body></html>"
