            "id": 82619,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Sıralanmış listede hangi liste öğesi önce gelir?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"temperatures = [\" /><text value=\"5\" class=\"number\" /><text value=\", \" /><text value=\"-5\" class=\"number\" /><text value=\", \" /><text value=\"-2\" class=\"number\" /><text value=\", \" /><text value=\"3\" class=\"number\" /><text value=\", \" /><text value=\"1\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text value=\"temperatures.sort()\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(temperatures)\" /></content><output><content><text value=\"[-5, -2, 1, 3, 5]\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>-5</code></item><item value=\"2\" correct=\"false\"><code>-2</code></item></selection><p visible-if=\"wrong\"><code>-5</code> öğesini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Sıralanmış listede <code>-5</code> neden <code>-2</code>'den önce gelir?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"temperatures = [\" /><text value=\"5\" class=\"number\" /><text value=\", \" /><text value=\"-5\" class=\"number\" /><text value=\", \" /><text value=\"-2\" class=\"number\" /><text value=\", \" /><text value=\"3\" class=\"number\" /><text value=\", \" /><text value=\"1\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text value=\"temperatures.sort()\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(temperatures)\" /></content><output><content><text value=\"[-5, -2, 1, 3, 5]\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>-5</code>, sayısal olarak <code>-2</code>'den küçüktür.</item><item value=\"2\" correct=\"false\">Negatif sayılar azalan sırada sıralanır.</item><item value=\"3\" correct=\"false\">Basamağı daha küçük olan değer her zaman önce gelir.</item></selection><p visible-if=\"wrong\"><code>-5</code>, sayısal olarak <code>-2</code>'den küçüktür.</p></body></html>",
            "hardModeSelected": true
