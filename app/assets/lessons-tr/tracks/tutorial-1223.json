            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu, konsolda ne görüntüler?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"friend_requests = [\" /><text value=\"3\" class=\"number\" /><text value=\", \" /><text value=\"1\" class=\"number\" /><text value=\", \" /><text value=\"2\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text value=\"friend_requests.sort()\" /><text type=\"break\" /><text value=\"print(friend_requests)\" /></content><output><content><text value=\"[1, 2, 3]\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>[1, 2, 3]</code></item><item value=\"2\" correct=\"false\"><code>[3, 1, 2]</code></item></selection><p visible-if=\"wrong\"><code>[1, 2, 3]</code>.</p></body></html>",
