            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>likes</code>'a konsolda <code>5</code> görüntülenecek bir değer ver.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" number = \" /><text value=\"5\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"let\" class=\"keyword\" /><text value=\" likes = number;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(likes);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"30\" endIndex=\"36\" /><option correct=\"false\"><content><text value=\"6\" /></content></option><option correct=\"false\"><content><text value=\"7\" /></content></option></options></interaction></interactions><output><content><text value=\"5\" /></content></output></code><p visible-if=\"wrong\"><code>number</code> öğesini seçtiğinden emin ol.</p></body></html>",
