            "id": 74264,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>for döngüsünün çalışması için counter değişkenini oluştur.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"5\" class=\"number\" /><text value=\"; i &gt; \" /><text value=\"0\" class=\"number\" /><text value=\"; i--) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(i);\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"13\" endIndex=\"14\" /><option correct=\"false\"><content><text value=\"-5\" /></content></option></options></interaction></interactions><output><content><text value=\"5\" /><text type=\"break\" /><text value=\"4\" /><text type=\"break\" /><text value=\"3\" /><text type=\"break\" /><text value=\"2\" /><text type=\"break\" /><text value=\"1\" /></content></output></code><p visible-if=\"wrong\"><code>5</code> öğesini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>for döngüsünün çalışması için counter değişkenini oluştur.</p><p>İlk görüntülenen sayının <code>5</code> olmasını sağlayan değerden döngüyü başlat.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"5\" class=\"number\" /><text value=\"; i &gt; \" /><text value=\"0\" class=\"number\" /><text value=\"; i--) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(i);\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"9\" endIndex=\"10\" /><option startIndex=\"13\" endIndex=\"14\" /><option startIndex=\"16\" endIndex=\"17\" /><option correct=\"false\"><content><text value=\"-5\" /></content></option><option correct=\"false\"><content><text value=\"0\" /></content></option><option correct=\"false\"><content><text value=\"6\" /></content></option></options></interaction></interactions><output><content><text value=\"5\" /><text type=\"break\" /><text value=\"4\" /><text type=\"break\" /><text value=\"3\" /><text type=\"break\" /><text value=\"2\" /><text type=\"break\" /><text value=\"1\" /></content></output></code><p visible-if=\"wrong\">Önce <code>i</code>, ardından <code>5</code> ve son olarak <code>i</code> öğelerini seçtiğinden emin ol.</p></body></html>",
