          {
            "title": "Question: Braces",
            "id": 74213,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>{</code> ve <code>}</code> ayraçları ne işe yarar?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Fonksiyona ait kod bloğunu belirtirler</item><item value=\"2\" correct=\"false\">Fonksiyonun hangi kodu atlaması gerektiğini belirtirler</item></selection><p visible-if=\"wrong\">Fonksiyona ait kod bloğunu belirtirler.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>function greetUser() { }</code> içinde süslü parantezler neyi gösterir?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Fonksiyona ait kod bloğunu</item><item value=\"2\" correct=\"false\">Fonksiyonun aldığı değerleri</item><item value=\"3\" correct=\"false\">Fonksiyonu çağırmak için kullanılan adı</item></selection><p visible-if=\"wrong\">Fonksiyona ait kod bloğunu.</p></body></html>"
