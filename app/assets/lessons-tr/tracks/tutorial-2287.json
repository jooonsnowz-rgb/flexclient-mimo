            "title": "Example: Aliasing",
            "id": 129097,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>oldest</code> takma adı altındaki en eski oyunun <code>name</code> değerini seç.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" oldest\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" = \" /><text value=\"1983\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"11\" /><option startIndex=\"12\" endIndex=\"14\" /><option startIndex=\"15\" endIndex=\"21\" /><option correct=\"false\"><content><text value=\"release\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"oldest\" /></row><row><data content=\"Mario Bros.\" /></row></table></output></code><p visible-if=\"wrong\">Önce <code>SELECT</code>, ardından <code>name</code> ve sonra <code>AS</code>, <code>oldest</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "Question: The inequality operator 2",
            "id": 91829,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>destination</code> özelliğinin <code>'Rome'</code> olmadığı öğeleri hangi sorgu seçer?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" flights\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" destination = \" /><text value=\"'Rome'\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" flights\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" destination &lt;&gt; \" /><text value=\"'Rome'\" class=\"string\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">İkincisi, eşitsizlik operatörü <code>&lt;&gt;</code> kullandığı için</item><item value=\"2\" correct=\"false\">İlki, eşitlik operatörünü <code>=</code> kullandığı için</item><item value=\"3\" correct=\"false\">İkisi de</item></selection><p visible-if=\"wrong\">İkincisi, eşitsizlik operatörü <code>&lt;&gt;</code> kullandığı için.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>SQL'de <code>&lt;&gt;</code>, iki değerin farklı olup olmadığını kontrol eder.</p><p>Bir uçuşun varış noktası <code>'Paris'</code>. Hangi sorgu bu uçuşu sonuca dahil eder?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" flights\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" destination = \" /><text value=\"'Rome'\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" flights\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" destination &lt;&gt; \" /><text value=\"'Rome'\" class=\"string\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Yalnızca ikinci sorgu.</item><item value=\"2\" correct=\"false\">Yalnızca ilk sorgu.</item><item value=\"3\" correct=\"false\">Her iki sorgu da.</item><item value=\"4\" correct=\"false\">Hiçbiri.</item></selection><p visible-if=\"wrong\">Yalnızca ikinci sorgu.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example: The inequality operator 2",
            "id": 91827,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>daily</code> değerinin <code>1</code> olmadığı tüm <code>flights</code> öğelerini seçmek için bir koşul kodla.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE flights (&#xA;destination varchar(255),&#xA;daily int&#xA;);&#xA;&#xA;INSERT INTO flights (destination, daily)&#xA;VALUES ('New York', 1);&#xA;INSERT INTO flights (destination, daily)&#xA;VALUES ('Paris', 3);&#xA;INSERT INTO flights (destination, daily)&#xA;VALUES ('Hong Kong', 1);&#xA;INSERT INTO flights (destination, daily)&#xA;VALUES ('Rome', 3);\"><tables><table name=\"flights\"><row><header content=\"destination\" /><header content=\"daily\" /></row><row><data content=\"New York\" /><data content=\"1\" /></row><row><data content=\"Paris\" /><data content=\"3\" /></row><row><data content=\"Hong Kong\" /><data content=\"1\" /></row><row><data content=\"Rome\" /><data content=\"3\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" flights\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" daily &lt;&gt; \" /><text value=\"1\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"28\" endIndex=\"38\" /></interactions><output><table name=\"Result\"><row><header content=\"destination\" /><header content=\"daily\" /></row><row><data content=\"Paris\" /><data content=\"3\" /></row><row><data content=\"Rome\" /><data content=\"3\" /></row></table></output></code><p visible-if=\"wrong\"><code>daily &lt;&gt; 1</code> ifadesini yazdığından emin ol.</p></body></html>"
          },
          {
            "title": "Example: AS",
            "id": 129098,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>SELECT name</code>, <code>AS</code> ve <code>newest</code> takma adını kullanarak en yeni oyunun <code>name</code> değerini bir takma ad altında seç.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" newest\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" = \" /><text value=\"2013\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"0\" endIndex=\"21\" /></interactions><output><table name=\"Result\"><row><header content=\"newest\" /></row><row><data content=\"Super Mario 3D World\" /></row></table></output></code><p visible-if=\"wrong\"><code>SELECT name AS newest</code> ifadesini yazdığından emin ol.</p></body></html>"
          },
          {
            "title": "Question: Only within the query",
            "id": 129096,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu sorguyu çalıştırdıktan sonra <em>original</em> tablosundaki <code>name</code> sütununun adı ne olur?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" newest\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" = \" /><text value=\"2013\" class=\"number\" /><text value=\";\" /></content><output><table name=\"Result\"><row><data content=\"No result!\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>name</code>, çünkü bir takma ad özgün tabloyu değiştirmez</item><item value=\"2\" correct=\"false\"><code>newest</code>, ona takma ad verdiğimiz için</item><item value=\"3\" correct=\"false\"><code>name</code>, <code>AS</code> anahtar sözcüğü eksik olduğu için</item></selection><p visible-if=\"wrong\"><code>name</code>, çünkü bir takma ad özgün tabloyu değiştirmez.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Takma ad, özgün tabloyu değil döndürülen sütun etiketini değiştirir.</p><p><code>AS newest</code> ifadesini kaldırıyorsun. Döndürülen sütunun ve özgün tablo sütununun adları şimdi nedir?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" newest\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" = \" /><text value=\"2013\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">İkisinin adı da name.</item><item value=\"2\" correct=\"false\">İkisinin adı da newest.</item><item value=\"3\" correct=\"false\">Sonuç name, tablo newest kullanır.</item><item value=\"4\" correct=\"false\">Sonuç newest, tablo name kullanır.</item></selection><p visible-if=\"wrong\">İkisinin adı da name.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example: As many as we want",
            "id": 129099,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>,</code> kodla ve ardından <code>release</code> sütununu da seç.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" newest, \" /><text value=\"release\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" = \" /><text value=\"2013\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"21\" endIndex=\"30\" /></interactions><output><table name=\"Result\"><row><header content=\"newest\" /><header content=\"release\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></output></code><p visible-if=\"wrong\"><code>, release</code> ifadesini yazdığından emin ol.</p></body></html>"
          },
          {
            "title": "Example: As many as we want 2",
            "id": 129100,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>release</code> sütununu seç ve adını <code>year</code> olarak değiştir.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" newest, \" /><text value=\"release\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" = \" /><text value=\"2013\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"23\" endIndex=\"30\" /><option startIndex=\"31\" endIndex=\"33\" /><option startIndex=\"34\" endIndex=\"38\" /><option correct=\"false\"><content><text value=\"release_year\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"newest\" /><header content=\"year\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></output></code><p visible-if=\"wrong\">Önce <code>release</code>, ardından <code>AS</code> ve son olarak <code>year</code> öğelerini seçtiğinden emin ol.</p></body></html>"
