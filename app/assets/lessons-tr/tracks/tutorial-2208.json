        "lessons": [
          {
            "title": "Code: Input layout",
            "id": 70919,
            "contentType": "executableFiles",
            "images": [],
            "executableContent": {
              "instructions": "İlk `br` öğesinin altında, web sayfasında tarih girmek için ikinci bir `input` öğesi görüntüle.",
              "preselectedFileIndex": 0,
              "hasVisualOutput": true,
              "files": [
                {
                  "name": "index.html",
                  "codeLanguage": "html",
                  "content": "<!doctype html>\n<html>\n <body>\n  <p>By signing this, you agree to our Terms of Service</p>\n  <input placeholder=\"Electronic signature\">\n  <br>\n </body>\n</html>",
                  "solvedContent": "<!doctype html>\n<html>\n <body>\n  <p>By signing this, you agree to our Terms of Service</p>\n  <input placeholder=\"Electronic signature\">\n  <br>\n  <input type=\"date\">\n </body>\n</html>"
                }
              ],
              "hints": []
            }
          },
          {
            "title": "Code: Input layout",
            "id": 70927,
            "contentType": "executableFiles",
            "images": [],
            "executableContent": {
              "instructions": "`button` etiketi satır içi blok bir öğedir. Bunu göz önünde bulundurarak `button` öğesinin web sayfasında `input` öğesinin altında görüntülenmesini sağla.",
              "preselectedFileIndex": 0,
              "hasVisualOutput": true,
              "files": [
                {
                  "name": "index.html",
                  "codeLanguage": "html",
                  "content": "<!doctype html>\n<html>\n <body>\n  <input placeholder=\"Say something...\">\n  <button>Post</button>\n </body>\n</html>",
                  "solvedContent": "<!doctype html>\n<html>\n <body>\n  <input placeholder=\"Say something...\">\n  <br>\n  <button>Post</button>\n </body>\n</html>"
                }
              ],
              "hints": []
            }
          },
          {
            "title": "Code: Different types of input",
