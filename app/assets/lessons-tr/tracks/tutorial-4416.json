            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bir dizide kaç öğe olursa olsun, <code>length</code> onları bizim için sayar.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"const\" class=\"keyword\" /><text value=\" enemies = [\" /><text value=\"&quot;slime&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;bat&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;goblin&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;skeleton&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;orc&quot;\" class=\"string\" /><text value=\"];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(enemies.length);\" /></content></code></body></html>"
