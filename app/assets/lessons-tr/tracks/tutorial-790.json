            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Görüntüleme ifadesini tamamla.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"userStatus\" class=\"title\" /><text value=\"(\" /><text value=\"\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" active = \" /><text value=\"&quot;Active&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" inactive = \" /><text value=\"&quot;Inactive&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Bob: &quot;\" class=\"string\" /><text value=\" + inactive);\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"userStatus();\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"81\" endIndex=\"88\" /><option startIndex=\"88\" endIndex=\"89\" /><option startIndex=\"89\" endIndex=\"92\" /><option startIndex=\"103\" endIndex=\"111\" /></options></interaction></interactions><output><content><text value=\"Bob: Inactive\" /></content></output></code><p visible-if=\"wrong\">Önce <code>console</code>, ardından <code>.</code> ve sonra <code>log</code>, <code>inactive</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Görüntüleme ifadesini, <code>userStatus</code> etkin değeri değil <code>\"Bob: Inactive\"</code> yazdıracak şekilde tamamla.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"userStatus\" class=\"title\" /><text value=\"(\" /><text value=\"\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" active = \" /><text value=\"&quot;Active&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" inactive = \" /><text value=\"&quot;Inactive&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Bob: &quot;\" class=\"string\" /><text value=\" + inactive);\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"userStatus();\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"81\" endIndex=\"88\" /><option startIndex=\"88\" endIndex=\"89\" /><option startIndex=\"89\" endIndex=\"92\" /><option startIndex=\"103\" endIndex=\"111\" /><option correct=\"false\"><content><text value=\"active\" /></content></option><option correct=\"false\"><content><text value=\"&quot;inactive&quot;\" /></content></option><option correct=\"false\"><content><text value=\"+\" /></content></option></options></interaction></interactions><output><content><text value=\"Bob: Inactive\" /></content></output></code><p visible-if=\"wrong\">Önce <code>console</code>, ardından <code>.</code>, <code>log</code> ve son olarak <code>inactive</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeSelected": true
