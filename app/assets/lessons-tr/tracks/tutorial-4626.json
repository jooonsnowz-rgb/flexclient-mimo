            "id": 152240,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Birden fazla sorgu parametresini birleştirmek için <code>&amp;</code> kullanırsak API bunları desteklediği sürece hepsi sorguda kullanılır.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"url = \" /><text value=\"&quot;https://mimo.org/courses?language=python&amp;level=beginner&quot;\" class=\"string\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"47\" endIndex=\"48\" /><option correct=\"false\"><content><text value=\"?\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\"><code>&amp;</code> öğesini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Birden fazla sorgu parametresini birleştirmek için <code>&amp;</code> kullanırsak API bunları desteklediği sürece hepsi sorguda kullanılır.</p><p><code>language</code> önce, <code>level</code> sonra olacak şekilde başlangıç seviyesindeki Python kurslarını iste.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"url = \" /><text value=\"&quot;https://mimo.org/courses?language=python&amp;level=beginner&quot;\" class=\"string\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"31\" endIndex=\"32\" /><option startIndex=\"41\" endIndex=\"47\" /><option startIndex=\"47\" endIndex=\"48\" /><option startIndex=\"54\" endIndex=\"62\" /><option correct=\"false\"><content><text value=\"/\" /></content></option><option correct=\"false\"><content><text value=\"advanced\" /></content></option><option correct=\"false\"><content><text value=\"javascript\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Önce <code>?</code>, ardından <code>python</code>, <code>&amp;</code> ve son olarak <code>beginner</code> öğelerini seçtiğinden emin ol.</p></body></html>",
