            "id": 115089,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>prices</code> dizisindeki her değere %10 ekleyen bir ok fonksiyonu yaz.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" prices = [\" /><text value=\"1.99\" class=\"number\" /><text value=\", \" /><text value=\"2.49\" class=\"number\" /><text value=\", \" /><text value=\"0.99\" class=\"number\" /><text value=\", \" /><text value=\"4.99\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" taxed = prices.map(\" /><text value=\"price\" class=\"params\" /><text value=\" =&gt;\" /><text value=\" price * \" /><text value=\"1.1\" class=\"number\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(taxed);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"55\" endIndex=\"61\" /><option startIndex=\"62\" endIndex=\"65\" /><option startIndex=\"66\" endIndex=\"71\" /><option startIndex=\"72\" endIndex=\"73\" /><option startIndex=\"73\" endIndex=\"74\" /><option startIndex=\"75\" endIndex=\"86\" /><option correct=\"false\"><content><text value=\"&lt;\" /></content></option><option correct=\"false\"><content><text value=\"==\" /></content></option></options></interaction></interactions><output><content><text value=\"[ 2.189, 2.7390000000000003, 1.089, 5.489000000000001 ]\" /></content></output></code><p visible-if=\"wrong\">Önce <code>prices</code>, ardından <code>map</code> ve sonra <code>price</code>, <code>=</code>, <code>&gt;</code>, <code>price * 1.1</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>prices</code> dizisindeki her değere %10 ekleyen bir ok fonksiyonu yaz.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" prices = [\" /><text value=\"1.99\" class=\"number\" /><text value=\", \" /><text value=\"2.49\" class=\"number\" /><text value=\", \" /><text value=\"0.99\" class=\"number\" /><text value=\", \" /><text value=\"4.99\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" taxed = prices.map(\" /><text value=\"price\" class=\"params\" /><text value=\" =&gt;\" /><text value=\" price * \" /><text value=\"1.1\" class=\"number\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(taxed);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"55\" endIndex=\"61\" /><option startIndex=\"62\" endIndex=\"65\" /><option startIndex=\"66\" endIndex=\"71\" /><option startIndex=\"72\" endIndex=\"73\" /><option startIndex=\"73\" endIndex=\"74\" /><option startIndex=\"75\" endIndex=\"86\" /><option correct=\"false\"><content><text value=\"price * 0.1\" /></content></option><option correct=\"false\"><content><text value=\"price + 0.1\" /></content></option><option correct=\"false\"><content><text value=\"price * 0.9\" /></content></option></options></interaction></interactions><output><content><text value=\"[ 2.189, 2.7390000000000003, 1.089, 5.489000000000001 ]\" /></content></output></code><p visible-if=\"wrong\">Önce <code>prices</code>, ardından <code>map</code>, <code>price</code>, <code>=</code>, <code>&gt;</code> ve son olarak <code>price * 1.1</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeSelected": true
