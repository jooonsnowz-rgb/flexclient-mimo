            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>numbers</code> dizisinde <code>.map()</code> fonksiyonunu çağırma söz dizimini tamamla.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" numbers = [\" /><text value=\"10\" class=\"number\" /><text value=\", \" /><text value=\"31\" class=\"number\" /><text value=\", \" /><text value=\"42\" class=\"number\" /><text value=\", \" /><text value=\"73\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" evens = numbers.map(\" /><text value=\"element\" class=\"params\" /><text value=\" =&gt;\" /><text value=\" (element % \" /><text value=\"2\" class=\"number\" /><text value=\" == \" /><text value=\"0\" class=\"number\" /><text value=\"));\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(evens);\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"48\" endIndex=\"59\" /></interactions><output><content><text value=\"[ true, false, true, false ]\" /></content></output></code><p visible-if=\"wrong\"><code>numbers.map</code> ifadesini yazdığından emin ol.</p></body></html>"
