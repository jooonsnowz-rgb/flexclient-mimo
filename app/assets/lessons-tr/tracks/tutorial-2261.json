            "id": 115319,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Parametreleri incele ve söz dizimini, <code>top3</code> ilk üç <code>finishers</code> öğesini depolayacak şekilde tamamla.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" finishers = [\" /><text value=\"&quot;Sarah&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Sally&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Jake&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Alex&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Tori&quot;\" class=\"string\" /><text value=\"];\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" top3 = finishers.filter(\" /><text value=\"function\" class=\"keyword\" /><text value=\"(\" /><text value=\"name, index\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" index &lt; \" /><text value=\"3\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"});\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(top3);\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"124\" endIndex=\"129\" /></interactions><output><content><text value=\"[ 'Sarah', 'Sally', 'Jake' ]\" /></content></output></code><p visible-if=\"wrong\"><code>index</code> ifadesini yazdığından emin ol.</p></body></html>"
