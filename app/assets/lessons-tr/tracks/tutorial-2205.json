            "id": 59771,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>total</code>'ı <code>score</code> eksi <code>penalty</code> sonucuna ayarla.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" score = \" /><text value=\"1084\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" penalty = \" /><text value=\"500\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" total = score - penalty;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(total);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"56\" endIndex=\"61\" /><option startIndex=\"64\" endIndex=\"71\" /><option startIndex=\"62\" endIndex=\"63\" /><option correct=\"false\"><content><text value=\"+\" /></content></option></options></interaction></interactions><output><content><text value=\"584\" /></content></output></code><p visible-if=\"wrong\">Önce <code>score</code>, ardından <code>-</code> ve son olarak <code>penalty</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>total</code> değişkeninin kalan <code>584</code> puanı saklaması için <code>score</code> ve <code>penalty</code> kullan.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" score = \" /><text value=\"1084\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" penalty = \" /><text value=\"500\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" total = score - penalty;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(total);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"56\" endIndex=\"61\" /><option startIndex=\"64\" endIndex=\"71\" /><option startIndex=\"62\" endIndex=\"63\" /><option correct=\"false\"><content><text value=\"+\" /></content></option><option correct=\"false\"><content><text value=\"=\" /></content></option><option correct=\"false\"><content><text value=\"total\" /></content></option></options></interaction></interactions><output><content><text value=\"584\" /></content></output></code><p visible-if=\"wrong\">Önce <code>score</code>, ardından <code>-</code> ve son olarak <code>penalty</code> öğelerini seçtiğinden emin ol.</p></body></html>",
