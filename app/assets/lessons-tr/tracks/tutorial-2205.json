            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>total</code> değerini konsolda görüntüle.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" score = \" /><text value=\"1084\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" bonus = \" /><text value=\"500\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" total = score + bonus;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(total);\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"81\" endIndex=\"86\" /></interactions><output><content><text value=\"1584\" /></content></output></code><p visible-if=\"wrong\"><code>total</code> ifadesini yazdığından emin ol.</p></body></html>"
