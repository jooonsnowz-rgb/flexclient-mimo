            "interactiveContent": "<!DOCTYPE html ><html><body><p>Sorgu parametrelerini tanımlayarak sözlüğü tamamla.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"import\" class=\"keyword\" /><text value=\" requests\" /><text type=\"break\" /><text type=\"break\" /><text value=\"params = {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&quot;popularity&quot;\" class=\"string\" /><text value=\": \" /><text value=\"&quot;high&quot;\" class=\"string\" /><text value=\",\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&quot;limit&quot;\" class=\"string\" /><text value=\": \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"response = requests.get(\" /><text value=\"&quot;https://mimo.org/api/languages&quot;\" class=\"string\" /><text value=\", params=params)\" /><text type=\"break\" /><text value=\"print(response.json())\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"30\" endIndex=\"51\" /><option startIndex=\"54\" endIndex=\"64\" /><option startIndex=\"26\" endIndex=\"27\" /><option startIndex=\"65\" endIndex=\"66\" /><option correct=\"false\"><content><text value=\"[\" /></content></option><option correct=\"false\"><content><text value=\"]\" /></content></option></options></interaction></interactions><output><content><text value=\"{\" /><text type=\"break\" /><text value=\"    &quot;languages&quot;: [\" /><text type=\"break\" /><text value=\"        {\" /><text type=\"break\" /><text value=\"            &quot;name&quot;: &quot;Python&quot;,\" /><text type=\"break\" /><text value=\"            &quot;type&quot;: &quot;interpreted&quot;,\" /><text type=\"break\" /><text value=\"            &quot;popularity&quot;: &quot;high&quot;,\" /><text type=\"break\" /><text value=\"            &quot;creator&quot;: &quot;Guido van Rossum&quo