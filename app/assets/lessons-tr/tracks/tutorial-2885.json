            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>headers</code>'ı doğru şekilde ayarladığından emin ol.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"import\" class=\"keyword\" /><text value=\" requests\" /><text type=\"break\" /><text type=\"break\" /><text value=\"headers = {\" /><text value=\"&quot;api-key&quot;\" class=\"string\" /><text value=\": \" /><text value=\"&quot;MY_SECRET_KEY&quot;\" class=\"string\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"requests.delete(\" /><text value=\"&quot;http://mimo.org/api/remove_item&quot;\" class=\"string\" /><text value=\", headers=headers)\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"108\" endIndex=\"123\" /></interactions></code><p visible-if=\"wrong\"><code>headers=headers</code> ifadesini yazdığından emin ol.</p></body></html>"
