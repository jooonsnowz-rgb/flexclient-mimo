            "interactiveContent": "<!DOCTYPE html ><html><body><p>localhost üzerindeki <code>/menu</code> uç noktasını çağırmak için <code>fetch</code> kullan.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"fetch(\" /><text value=\"&quot;http://localhost:3000/menu&quot;\" class=\"string\" /><text value=\").then(\" /><text value=\"(\" /><text value=\"response\" class=\"params\" /><text value=\") =&gt;\" /><text value=\" { \" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;API Request successfully sent!&quot;\" class=\"string\" /><text value=\"); \" /><text type=\"break\" /><text value=\"});\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"5\" /><option startIndex=\"6\" endIndex=\"34\" /><option correct=\"false\"><content><text value=\"get\" /></content></option><option correct=\"false\"><content><text value=\"app\" /></content></option><option correct=\"false\"><content><text value=\".\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Önce <code>fetch</code>, ardından <code>\"http://localhost:3000/menu\"</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>3000</code> numaralı bağlantı noktasındaki yerel sunucudan menüyü istemek için <code>fetch</code> kullan.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"fetch(\" /><text value=\"&quot;http://localhost:3000/menu&quot;\" class=\"string\" /><text value=\").then(\" /><text value=\"(\" /><text value=\"response\" class=\"params\" /><text value=\") =&gt;\" /><text value=\" { \" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;API Request successfully sent!&quot;\" class=\"string\" /><text value=\"); \" /><text type=\"break\" /><text value=\"});\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"5\" /><option startIndex=\"6\" endIndex=\"34\" /><option correct=\"false\"><content><text value=\"get\" /></content></option><option correct=\"false\"><content><text value=\"app\" /></content></option><option correct=\"false\"><content><text value=\".\" /></content></option><option correct=\"false\"><content><text value=\"&quot;/menu&quot;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Önce <code>fetch</code>, ardından <code>\"http://localhost:3000/menu\"</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeSelected": true
