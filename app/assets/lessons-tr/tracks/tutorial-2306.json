            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>GET</code> isteğini <code>https://localhost:3000/menu</code> adresine yaz.</p><code version=\"2\" codelang=\"bash\" name=\"script.sh\" visible-if=\"always\"><content><text value=\"GET https://localhost:3000/menu HTTP/3\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"3\" /><option correct=\"false\"><content><text value=\"ROUTE\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\"><code>GET</code> öğesini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Sunucu verilerini değiştirmeden <code>https://localhost:3000/menu</code> adresinden menüyü iste. Veri almaya yönelik HTTP metodunu kullan.</p><code version=\"2\" codelang=\"bash\" name=\"script.sh\" visible-if=\"always\"><content><text value=\"GET https://localhost:3000/menu HTTP/3\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"3\" /><option correct=\"false\"><content><text value=\"ROUTE\" /></content></option><option correct=\"false\"><content><text value=\"POST\" /></content></option><option correct=\"false\"><content><text value=\"FETCH\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\"><code>GET</code> öğesini seçtiğinden emin ol.</p></body></html>",
            "hardModeSelected": true
