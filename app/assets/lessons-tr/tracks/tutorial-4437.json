            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dizi değerlerine erişebilmesi için satır içi fonksiyona uygun parametreyi ekle.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"79\" endIndex=\"86\" isDefault=\"true\" /></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" pickups = [\" /><text value=\"&quot;coin&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;gem&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;heart&quot;\" class=\"string\" /><text value=\"];\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" lengths = pickups.map(\" /><text value=\"function\" class=\"keyword\" /><text value=\"(\" /><text value=\"element\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(element);\" /><text type=\"break\" /><text value=\"});}\" /></content></code><p visible-if=\"wrong\"><code>element</code> ifadesini yazdığından emin ol.</p></body></html>"
