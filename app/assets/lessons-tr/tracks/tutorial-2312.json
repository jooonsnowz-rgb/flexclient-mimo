            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dize değerini konsolda görüntüle.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"age_group = \" /><text value=\"&quot;25-34 years old&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"print(age_group)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"36\" endIndex=\"45\" /><option correct=\"false\"><content><text value=\"print\" /></content></option></options></interaction></interactions><output><content><text value=\"25-34 years old\" /></content></output></code><p visible-if=\"wrong\"><code>age_group</code> öğesini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Konsolda <code>25-34 years old</code> gösterilmesi için değişkeni yazdır.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"age_group = \" /><text value=\"&quot;25-34 years old&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"print(age_group)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"36\" endIndex=\"45\" /><option correct=\"false\"><content><text value=\"&quot;25-34 years old&quot;\" /></content></option><option correct=\"false\"><content><text value=\"&quot;age_group&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"25-34 years old\" /></content></output></code><p visible-if=\"wrong\"><code>age_group</code> öğesini seçtiğinden emin ol.</p></body></html>"
