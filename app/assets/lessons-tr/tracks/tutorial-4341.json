            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Son olarak, sayaç değişkenini <code>i++</code> ile artırırız.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"23\" endIndex=\"26\" isDefault=\"true\" /></interactions><content><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"1\" class=\"number\" /><text value=\"; i &lt; \" /><text value=\"5\" class=\"number\" /><text value=\"; i++) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Frame &quot;\" class=\"string\" /><text value=\" + i);\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\"><code>i++</code> ifadesini yazdığından emin ol.</p></body></html>"
