            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>score</code> değişkenini ifadeye ekle.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"&quot;score&quot;\" /></content></option><option startIndex=\"32\" endIndex=\"37\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" score = \" /><text value=\"&quot;14&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(score + \" /><text value=\"&quot; points&quot;\" class=\"string\" /><text value=\");\" /></content></code><p visible-if=\"wrong\"><code>score</code> öğesini seçtiğinden emin ol.</p></body></html>"
