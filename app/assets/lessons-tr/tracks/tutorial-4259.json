            "id": 145170,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu kod konsolda ne görüntüler?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"let\" class=\"keyword\" /><text value=\" playerName = \" /><text value=\"&quot;Lori&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"playerName = \" /><text value=\"&quot;Joe&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(playerName);\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>Joe</code></item><item value=\"2\" correct=\"false\"><code>Lori</code></item></selection><p visible-if=\"wrong\"><code>Joe</code> öğesini seçtiğinden emin ol.</p></body></html>"
          },
