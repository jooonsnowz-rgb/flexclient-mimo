            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>playerHealth</code> değişkenindeki değeri <code>100</code> olarak değiştir.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"let playerHealth\" /></content></option><option startIndex=\"22\" endIndex=\"34\" /></options></interaction></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" playerHealth = \" /><text value=\"0\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"playerHealth = \" /><text value=\"100\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(playerHealth);\" /></content></code><p visible-if=\"wrong\"><code>playerHealth</code> öğesini seçtiğinden emin ol.</p></body></html>"
          },
          {
