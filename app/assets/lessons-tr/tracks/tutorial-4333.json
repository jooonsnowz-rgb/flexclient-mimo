            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu kod konsolda ne görüntüler?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"let\" class=\"keyword\" /><text value=\" enemySpeed = \" /><text value=\"100\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"enemySpeed = enemySpeed;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(enemySpeed);\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>100</code></item><item value=\"2\" correct=\"false\"><code>5</code></item></selection><p visible-if=\"wrong\"><code>100</code> öğesini seçtiğinden emin ol.</p></body></html>"
          },
