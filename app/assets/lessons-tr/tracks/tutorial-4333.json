            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>characterName</code> kodunu kullanarak konsolda <code>Pixel Knight</code> görüntüle.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"45\" endIndex=\"58\" isDefault=\"true\" /></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" characterName = \" /><text value=\"&quot;Pixel&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"characterName = characterName + \" /><text value=\"&quot; Knight&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(characterName);}\" /></content></code><p visible-if=\"wrong\"><code>characterName</code> ifadesini yazdığından emin ol.</p></body></html>"
