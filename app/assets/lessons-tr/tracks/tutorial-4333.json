            "title": "Lesson #13",
            "id": 146652,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>coins</code>'e, konsolda <code>5</code> görüntülenecek şekilde bir değer ver.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"6\" /></content></option><option correct=\"false\"><content><text value=\"7\" /></content></option><option startIndex=\"30\" endIndex=\"36\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" number = \" /><text value=\"5\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"let\" class=\"keyword\" /><text value=\" coins = number;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(coins);\" /></content></code><p visible-if=\"wrong\"><code>number</code> öğesini seçtiğinden emin ol.</p></body></html>"
          },
