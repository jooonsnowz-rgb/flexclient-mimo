            "id": 146651,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>15</code> değerini <code>score</code> değişkenine ata.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"===\" /></content></option><option startIndex=\"12\" endIndex=\"13\" /><option startIndex=\"14\" endIndex=\"16\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" score = \" /><text value=\"15\" class=\"number\" /><text value=\";\" /></content></code><p visible-if=\"wrong\">Önce <code>=</code>, ardından <code>15</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          },
