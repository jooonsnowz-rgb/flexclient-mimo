            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>if deyimi koşulları için karşılaştırma yapmak üzere hangi operatörleri kullanabiliriz?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>&gt;=</code>, <code>&lt;=</code>, <code>&gt;</code> ve <code>&lt;</code></item><item value=\"2\" correct=\"false\"><code>=</code> ve <code>&amp;&amp;</code></item><item value=\"3\" correct=\"false\">Hiçbiri</item></selection><p visible-if=\"wrong\"><code>&gt;=</code>, <code>&lt;=</code>, <code>&gt;</code> ve <code>&lt;</code>.</p></body></html>"
