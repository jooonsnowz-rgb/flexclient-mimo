            "id": 145568,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>enemyCount</code> 3'ten küçük bir değere sahip olduğunda ne olur?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"let\" class=\"keyword\" /><text value=\" enemyCount;\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" (enemyCount &gt;= \" /><text value=\"3\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Boss fight unlocked&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"} \" /><text value=\"else\" class=\"keyword\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Keep exploring&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>else</code> ifadesinin kod bloğu çalışır</item><item value=\"2\" correct=\"false\"><code>if</code> ifadesinin kod bloğu çalışır</item><item value=\"3\" correct=\"false\">Ne <code>if</code> kod bloğu ne de <code>else</code> ifadesinin kod bloğu çalışır</item></selection><p visible-if=\"wrong\"><code>else</code> ifadesinin kod bloğu çalışır.</p></body></html>"
          },
