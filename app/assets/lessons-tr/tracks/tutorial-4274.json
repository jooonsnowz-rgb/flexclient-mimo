            "interactiveContent": "<!DOCTYPE html ><html><body><p>Görüntüleme ifadesini atlayan değişkeni kodla.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"53\" endIndex=\"59\" isDefault=\"true\" /></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" hasKey = \" /><text value=\"false\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" doorUnlocked = \" /><text value=\"true\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" (hasKey) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;You open the treasure door!&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\"><code>hasKey</code> ifadesini yazdığından emin ol.</p></body></html>"
