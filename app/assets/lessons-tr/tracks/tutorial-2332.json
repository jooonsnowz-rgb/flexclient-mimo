            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>split()</code> ne yapar?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Bir dizeyi listeye böler</item><item value=\"2\" correct=\"false\">Bir dizeyi birleştirir</item><item value=\"3\" correct=\"false\">Bir dizenin bir bölümünü değiştirir</item></selection><p visible-if=\"wrong\">Bir dizeyi listeye böler.</p></body></html>",
