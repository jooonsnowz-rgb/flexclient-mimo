          {
            "title": "Example: Replace",
            "id": 82806,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>release_date</code> değişkenini güncelle.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"release_date = \" /><text value=\"&quot;Release date: 24th July&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"updated = release_date.replace(\" /><text value=\"&quot;24th July&quot;\" class=\"string\" /><text value=\",\" /><text value=\"&quot;31st August&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(updated)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"52\" endIndex=\"64\" /><option startIndex=\"65\" endIndex=\"72\" /><option correct=\"false\"><content><text value=\"count\" /></content></option><option correct=\"false\"><content><text value=\"split\" /></content></option></options></interaction></interactions><output><content><text value=\"Release date: 31st August\" /></content></output></code><p visible-if=\"wrong\">Önce <code>release_date</code>, ardından <code>replace</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Konsolda <code>Release date: 31st August</code> görünmesi için eski tarihi yenisiyle değiştir.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"release_date = \" /><text value=\"&quot;Release date: 24th July&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"updated = release_date.replace(\" /><text value=\"&quot;24th July&quot;\" class=\"string\" /><text value=\",\" /><text value=\"&quot;31st August&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(updated)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"52\" endIndex=\"64\" /><option startIndex=\"65\" endIndex=\"72\" /><option startIndex=\"73\" endIndex=\"84\" /><option correct=\"false\"><content><text value=\"count\" /></content></option><option correct=\"false\"><content><text value=\"split\" /></content></option><option correct=\"false\"><content><text value=\"&quot;31st August&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"Release date: 31st August\" /></content></output></code><p visible-if=\"wrong\">Önce <code>release_date</code>, ardından <code>replace</code> ve son olarak <code>\"24th July\"</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Question: Displaying",
            "id": 82802,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>replace()</code> tarafından verilen sonucu özgün değişkene yeniden atadığımızda ne olur?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Değişken güncellenmiş değeri içerir ve onu normal şekilde kullanabiliriz</item><item value=\"2\" correct=\"false\">Kodumuzda bir hataya neden olur</item><item value=\"3\" correct=\"false\">Orijinal değişkenin içindeki değer güncellenmeyecek </item></selection><p visible-if=\"wrong\">Değişken güncellenmiş değeri içerir ve onu normal şekilde kullanabiliriz.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Bir program <code>title</code> içinde <code>draft report</code> depoluyor, ardından <code>title.replace(\"draft\", \"final\")</code> sonucunu yeniden <code>title</code>'a atıyor. <code>title</code> şimdi ne içerir?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>final report</code></item><item value=\"2\" correct=\"false\"><code>draft report</code></item><item value=\"3\" correct=\"false\">title zaten bir değere sahip olduğu için hata</item></selection><p visible-if=\"wrong\"><code>final report</code> öğesini seçtiğinden emin ol.</p></body></html>"
          },
