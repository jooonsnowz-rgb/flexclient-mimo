            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>split()</code> kullanılırken varsayılan ayırıcı nedir?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Bir boşluk karakteri</item><item value=\"2\" correct=\"false\">Nokta</item><item value=\"3\" correct=\"false\">Bir tire</item></selection><p visible-if=\"wrong\">Bir boşluk karakteri.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Ayırıcı verilmediğinde <code>\"red.blue green\".split()</code> ne döndürür?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>['red.blue', 'green']</code></item><item value=\"2\" correct=\"false\"><code>['red', 'blue green']</code></item><item value=\"3\" correct=\"false\"><code>['red', 'blue', 'green']</code></item></selection><p visible-if=\"wrong\"><code>['red.blue', 'green']</code> öğesini seçtiğinden emin ol.</p></body></html>",
