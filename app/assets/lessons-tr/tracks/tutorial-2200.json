          {
            "title": "Code 1",
            "id": 71201,
            "contentType": "executableFiles",
            "images": [],
            "executableContent": {
              "instructions": "`a` öğesinin kapanış etiketini ekle, böylece yalnızca `Do you ever have deja vu` bağlantılı metin olsun.",
              "preselectedFileIndex": 0,
              "hasVisualOutput": true,
              "files": [
                {
                  "name": "index.html",
                  "codeLanguage": "html",
                  "content": "<!doctype html>\n<html>\n <body>\n  <h4>Groundhog Day Quotes:</h4>\n  <p>\n   <a href=\"https://letmegooglethat.com/?q=Groundhog+Day+Quotes\">Do you ever have\n    deja vu Mrs. Lancaster?\n  </p>\n </body>\n</html>",
                  "solvedContent": "<!doctype html>\n<html>\n <body>\n  <h4>Groundhog Day Quotes:</h4>\n  <p>\n   <a href=\"https://letmegooglethat.com/?q=Groundhog+Day+Quotes\">Do you ever have\n    deja vu</a> Mrs. Lancaster?\n  </p>\n </body>\n</html>"
                }
              ],
              "hints": []
            }
          },
          {
            "title": "Code 2",
            "id": 71230,
            "contentType": "executableFiles",
            "images": [],
            "executableContent": {
              "instructions": "Açılış bağlantı etiketinin içine eksik öznitelik adını ekle. Ardından `https://` sonrasına favori web siteni ekle.",
              "preselectedFileIndex": 0,
              "hasVisualOutput": true,
              "files": [
                {
                  "name": "index.html",
                  "codeLanguage": "html",
                  "content": "<!doctype html>\n<html>\n <body>\n  <h3>Things I think people would find interesting</h3>\n  <a=\"https://\">My favorite website</a>\n </body>\n</html>",
                  "solvedContent": "<!doctype html>\n<html>\n <body>\n  <h3>Things I think people would find interesting</h3>\n  <a href=\"https://facebook.com\">My favorite website</a>\n </body>\n</html>"
                }
              ],
              "hints": []
            }
          },
          {
            "title": "Code 3",
            "id": 71167,
            "contentType": "executableFiles",
            "images": [],
            "executableContent": {
              "instructions": "Açılış bağlantı etiketinin içine `href` öznitelik adını ekle. İstersen bağlantıyı, seni bir sosyal medya hesabına götürecek şekilde değiştir.",
              "preselectedFileIndex": 0,
              "hasVisualOutput": true,
              "files": [
                {
                  "name": "index.html",
                  "codeLanguage": "html",
                  "content": "<!doctype html>\n<html>\n <body>\n  <h3>You can learn more about me here:</h3>\n  <a=\"https://www.facebook.com/mimo\">About Us</a>\n </body>\n</html>",
                  "solvedContent": "<!doctype html>\n<html>\n <body>\n  <h3>You can learn more about me here:</h3>\n  <a href=\"https://www.facebook.com/mimo\">About Us</a>\n </body>\n</html>"
