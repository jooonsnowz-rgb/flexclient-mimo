            "contentType": "executableFiles",
            "images": [],
            "executableContent": {
              "instructions": "Bağlantının ardından bir satır sonu `<br>` ekle. Ardından `src` değeri `/img/coupe.png` olarak ayarlanmış bir `img` öğesi ekle.",
              "preselectedFileIndex": 0,
              "hasVisualOutput": true,
              "files": [
                {
                  "name": "index.html",
                  "codeLanguage": "html",
                  "content": "<!doctype html>\n<html>\n <body>\n  <a href=\"\">My Avatar on Instapolaroid</a>\n </body>\n</html>",
                  "solvedContent": "<!doctype html>\n<html>\n <body>\n  <a href=\"\">My Avatar on Instapolaroid</a>\n  <br>\n  <img src=\"/img/coupe.png\">\n </body>\n</html>"
                }
              ],
              "hints": []
            }
          },
          {
            "title": "Code 2",
            "id": 59026,
            "contentType": "executableFiles",
            "images": [],
            "executableContent": {
