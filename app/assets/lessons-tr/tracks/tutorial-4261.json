            "id": 145248,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>equal</code>'ın <code>true</code> olmasını istiyorsak <code>playerScore</code>'un değeri ne olmalı?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"const\" class=\"keyword\" /><text value=\" playerScore = ? ;\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" highScore = \" /><text value=\"80\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" equal = playerScore === highScore;\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>80</code></item><item value=\"2\" correct=\"false\"><code>true</code></item></selection><p visible-if=\"wrong\"><code>80</code> öğesini seçtiğinden emin ol.</p></body></html>"
