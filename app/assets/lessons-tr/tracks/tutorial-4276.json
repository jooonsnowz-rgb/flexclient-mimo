            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu fonksiyona camel case biçiminde bir ad ver.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"startlevel\" /></content></option><option startIndex=\"9\" endIndex=\"19\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"startLevel\" class=\"title\" /><text value=\"(\" /><text value=\"\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Level starting&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Spawning player&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"startLevel();\" /></content></code><p visible-if=\"wrong\"><code>startLevel</code> öğesini seçtiğinden emin ol.</p></body></html>"
          },
          {
