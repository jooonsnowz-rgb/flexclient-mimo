            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bir enum'da türleri karıştırabilir miyiz?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Evet</item><item value=\"2\" correct=\"false\">Hayır</item></selection><p visible-if=\"wrong\">Evet öğesini seçtiğinden emin ol.</p></body></html>"
