            "id": 130972,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Konsola ne yazdırılacak?</p><code version=\"2\" codelang=\"typescript\" name=\"script.ts\" visible-if=\"always\"><content><text value=\"enum\" class=\"keyword\" /><text value=\" Directions {\" /><text type=\"break\" /><text value=\" Up = \" /><text value=\"50\" class=\"number\" /><text value=\",\" /><text type=\"break\" /><text value=\" Down,\" /><text type=\"break\" /><text value=\" Left,\" /><text type=\"break\" /><text value=\" Right\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(Directions.Left);\" /></content><output><content><text value=\"52\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">52</item><item value=\"2\" correct=\"false\">50</item><item value=\"3\" correct=\"false\">51</item></selection><p visible-if=\"wrong\">52 öğesini seçtiğinden emin ol.</p></body></html>"
