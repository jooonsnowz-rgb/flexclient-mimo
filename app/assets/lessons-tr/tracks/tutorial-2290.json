            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>toys</code> tablosundaki tüm değerleri sil.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE toys( &#xA;    name varchar(255), &#xA;    price int &#xA;); &#xA; &#xA;INSERT INTO toys(name, price) &#xA;VALUES(&quot;Teddy bear&quot;, 14); &#xA; &#xA;INSERT INTO toys(name, price) &#xA;VALUES(&quot;Remote controlled car&quot;, 12); &#xA; &#xA;INSERT INTO toys(name, price) &#xA;VALUES(&quot;Clay mix&quot;, 9);\"><tables><table name=\"toys\"><row><header content=\"name\" /><header content=\"price\" /></row><row><data content=\"Teddy bear\" /><data content=\"14\" /></row><row><data content=\"Remote controlled car\" /><data content=\"12\" /></row><row><data content=\"Clay mix\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"DELETE\" class=\"keyword\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" toys; \" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" toys;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"12\" endIndex=\"16\" /></interactions><output><table name=\"Result\"><row><data content=\"No result!\" /></row></table></output></code><p visible-if=\"wrong\"><code>toys</code> ifadesini yazdığından emin ol.</p></body></html>"
