            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Verilen kodda sorun nedir?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE toys( &#xA;    name varchar(255), &#xA;    price int &#xA;); &#xA; &#xA;INSERT INTO toys(name, price) &#xA;VALUES(&quot;Teddy bear&quot;, 14); &#xA; &#xA;INSERT INTO toys(name, price) &#xA;VALUES(&quot;Remote controlled car&quot;, 12);\"><tables><table name=\"toys\"><row><header content=\"name\" /><header content=\"price\" /></row><row><data content=\"Teddy bear\" /><data content=\"14\" /></row><row><data content=\"Remote controlled car\" /><data content=\"12\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"INSERT\" class=\"keyword\" /><text value=\" \" /><text value=\"INTO\" class=\"keyword\" /><text value=\" toys(\" /><text value=\"name\" class=\"keyword\" /><text value=\", price, \" /><text value=\"store\" class=\"keyword\" /><text value=\") \" /><text type=\"break\" /><text value=\"VALUES\" class=\"keyword\" /><text value=\"(\" /><text value=\"&quot;Beyblade&quot;\" class=\"string\" /><text value=\", \" /><text value=\"13\" class=\"number\" /><text value=\"); \" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" toys;\" /></content><output><table name=\"Result\"><row><data content=\"No result!\" /></row></table></output></code><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">store adında bir sütun yok</item><item value=\"2\" correct=\"false\"><code>VALUES</code> satırı önce gelmelidir</item><item value=\"3\" correct=\"false\"><code>INSERT</code>, <code>INSERT INTO</code> değil</item></selection><p visible-if=\"wrong\">store adında bir sütun yok.</p></body></html>"
