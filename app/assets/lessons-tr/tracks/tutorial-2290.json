          {
            "title": "Question: Limitations",
            "id": 118710,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Mevcut bir satırla eşleşmeyen bir <code>WHERE</code> yan tümcesiyle <code>UPDATE</code> çağırırsan ne olur?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Hiçbir şey değişmeyecek</item><item value=\"2\" correct=\"false\">SQLite bir sonraki en yakın satırı günceller</item><item value=\"3\" correct=\"false\">SQLite, sağlanan verilerle otomatik olarak yeni bir satır oluşturur</item></selection><p visible-if=\"wrong\">Hiçbir şey değişmeyecek.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>UPDATE</code>, <code>WHERE</code> koşuluyla eşleşen mevcut satırları değiştirir.</p><p>Tablonda <code>1</code> ve <code>2</code> kimlikleri var. Filtreyi <code>id = 1</code> yerine <code>id = 99</code> yapıyorsun.</p><p>Güncellenen satırların sayısı nasıl değişir?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Bir satırdan sıfır satıra düşer.</item><item value=\"2\" correct=\"false\">Bir satırdan iki satıra çıkar.</item><item value=\"3\" correct=\"false\">UPDATE, ID 99'u oluşturduğu için bir satır olarak kalır.</item></selection><p visible-if=\"wrong\">Bir satırdan sıfır satıra düşer.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Question: One Row",
            "id": 118712,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Aşağıdaki <code>UPDATE</code> ifadesi hangi satırı değiştirir?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE Reservations (&#xA; id INTEGER NOT NULL,&#xA; name TEXT NOT NULL,&#xA; phonenumber TEXT NOT NULL,&#xA; time TEXT NOT NULL,&#xA; partysize INTEGER NOT NULL,&#xA; PRIMARY KEY (id)&#xA;);&#xA;&#xA;&#xA;INSERT INTO Reservations (id, name, phonenumber, time, partysize) VALUES ('1', 'Powers', '+16352637463', '18:00',4);&#xA;&#xA;INSERT INTO Reservations (id, name, phonenumber, time, partysize) VALUES ('2', 'Miranda', '+17487652839', '19:00',5);&#xA;&#xA;INSERT INTO Reservations (id, name, phonenumber, time, partysize) VALUES ('3', 'Smith', '+17648373572', '18:30',3);&#xA;\"><tables><table name=\"Reservations\"><row><header content=\"id\" /><header content=\"name\" /><header content=\"phonenumber\" /><header content=\"time\" /><header content=\"partysize\" /></row><row><data content=\"1\" /><data content=\"Powers\" /><data content=\"+16352637463\" /><data content=\"18:00\" /><data content=\"4\" /></row><row><data content=\"2\" /><data content=\"Miranda\" /><data content=\"+17487652839\" /><data content=\"19:00\" /><data content=\"5\" /></row><row><data content=\"3\" /><data content=\"Smith\" /><data content=\"+17648373572\" /><data content=\"18:30\" /><data content=\"3\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" Reservations \" /><text value=\"SET\" class=\"keyword\" /><text value=\" \" /><text value=\"time\" class=\"built_in\" /><text value=\" = \" /><text value=\"'18:30'\" class=\"string\" /><text value=\" \" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" = \" /><text value=\"'Powers'\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" Reservations;\" /></content><output><table name=\"Result\"><row><header content=\"id\" /><header content=\"name\" /><header content=\"phonenumber\" /><header content=\"time\" /><header content=\"partysize\" /></row><row><data content=\"1\" /><data content=\"Powers\" /><data content=\"+16352637463\" /><data content=\"18:30\" /><data content=\"4\" /></row><row><data content=\"2\" /><data content=\"Miranda\" /><data content=\"+17487652839\" /><data content=\"19:00\" /><data content=\"5\" /></row><row><data content=\"3\" /><data content=\"Smith\" /><data content=\"+17648373572\" /><data content=\"18:30\" /><data content=\"3\" /></row></table></output></code><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Powers' Rezervi</item><item value=\"2\" correct=\"false\">Miranda'nın Rezervasyonu</item><item value=\"3\" correct=\"false\">Smith'lerin Rezervasyonu</item></selection><p visible-if=\"wrong\">Powers' Rezervi.</p></body></html>"
          },
          {
            "title": "Example: Syntax",
            "id": 118716,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Her satırdaki <code>certifications</code> sütununu <code>'Silver'</code> olarak değiştirmek için <code>UPDATE</code> ifadesini tamamla.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE Songs (&#xA; songname TEXT NOT NULL,&#xA; artist TEXT NOT NULL,&#xA; streams INTEGER NOT NULL,&#xA; certifications TEXT&#xA;);&#xA;&#xA;INSERT INTO Songs (songname, artist, streams) VALUES ('Paradise', 'The Jets', 120);&#xA;&#xA;INSERT INTO Songs (songname, artist, streams) VALUES ('My Way', 'Stevie J', 100);&#xA;&#xA;INSERT INTO Songs (songname, artist, streams) VALUES ('Purple Sunrise', 'Harry', 90);&#xA;&#xA;INSERT INTO Songs (songname, artist, streams) VALUES ('California Highway', 'Joan &amp; Jerry', 85);&#xA;&#xA;INSERT INTO Songs (songname, artist, streams) VALUES ('My Sister Meg', 'Couches', 70);\"><tables><table name=\"Songs\"><row><header content=\"songname\" /><header content=\"artist\" /><header content=\"streams\" /><header content=\"certifications\" /></row><row><data content=\"Paradise\" /><data content=\"The Jets\" /><data content=\"120\" /><data content=\"\" /></row><row><data content=\"My Way\" /><data content=\"Stevie J\" /><data content=\"100\" /><data content=\"\" /></row><row><data content=\"Purple Sunrise\" /><data content=\"Harry\" /><data content=\"90\" /><data content=\"\" /></row><row><data content=\"California Highway\" /><data content=\"Joan &amp; Jerry\" /><data content=\"85\" /><data content=\"\" /></row><row><data content=\"My Sister Meg\" /><data content=\"Couches\" /><data content=\"70\" /><data content=\"\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" Songs \" /><text value=\"SET\" class=\"keyword\" /><text value=\" certifications = \" /><text value=\"'Silver'\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" Songs;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"13\" endIndex=\"16\" /><option startIndex=\"17\" endIndex=\"31\" /><option startIndex=\"32\" endIndex=\"33\" /><option startIndex=\"34\" endIndex=\"42\" /><option startIndex=\"42\" endIndex=\"43\" /><option correct=\"false\"><content><text value=\"streams\" /></content></option><option correct=\"false\"><content><text value=\"'Platinum'\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"songname\" /><header content=\"artist\" /><header content=\"streams\" /><header content=\"certifications\" /></row><row><data content=\"Paradise\" /><data content=\"The Jets\" /><data content=\"120\" /><data content=\"Silver\" /></row><row><data content=\"My Way\" /><data content=\"Stevie J\" /><data content=\"100\" /><data content=\"Silver\" /></row><row><data content=\"Purple Sunrise\" /><data content=\"Harry\" /><data content=\"90\" /><data content=\"Silver\" /></row><row><data content=\"California Highway\" /><data content=\"Joan &amp; Jerry\" /><data content=\"85\" /><data content=\"Silver\" /></row><row><data content=\"My Sister Meg\" /><data content=\"Couches\" /><data content=\"70\" /><data content=\"Silver\" /></row></table></output></code><p visible-if=\"wrong\">Önce <code>SET</code>, ardından <code>certifications</code> ve sonra <code>=</code>, <code>'Silver'</code>, <code>;</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "Example: One Row",
            "id": 118717,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Paradise'in <code>streams</code> sayısını 130'a yükseltmek için bir <code>UPDATE</code> ifadesi yaz.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE Songs (&#xA; songname TEXT NOT NULL,&#xA; artist TEXT NOT NULL,&#xA; streams INTEGER NOT NULL,&#xA; certifications TEXT&#xA;);&#xA;&#xA;INSERT INTO Songs (songname, artist, streams) VALUES ('Paradise', 'The Jets', 120);&#xA;&#xA;INSERT INTO Songs (songname, artist, streams) VALUES ('My Way', 'Stevie J', 100);&#xA;&#xA;INSERT INTO Songs (songname, artist, streams) VALUES ('Purple Sunrise', 'Harry', 90);&#xA;&#xA;INSERT INTO Songs (songname, artist, streams) VALUES ('California Highway', 'Joan &amp; Jerry', 85);&#xA;&#xA;INSERT INTO Songs (songname, artist, streams) VALUES ('My Sister Meg', 'Couches', 70);\"><tables><table name=\"Songs\"><row><header content=\"songname\" /><header content=\"artist\" /><header content=\"streams\" /><header content=\"certifications\" /></row><row><data content=\"Paradise\" /><data content=\"The Jets\" /><data content=\"120\" /><data content=\"\" /></row><row><data content=\"My Way\" /><data content=\"Stevie J\" /><data content=\"100\" /><data content=\"\" /></row><row><data content=\"Purple Sunrise\" /><data content=\"Harry\" /><data content=\"90\" /><data content=\"\" /></row><row><data content=\"California Highway\" /><data content=\"Joan &amp; Jerry\" /><data content=\"85\" /><data content=\"\" /></row><row><data content=\"My Sister Meg\" /><data content=\"Couches\" /><data content=\"70\" /><data content=\"\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" Songs \" /><text value=\"SET\" class=\"keyword\" /><text value=\" streams = \" /><text value=\"130\" class=\"number\" /><text value=\" \" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" songname = \" /><text value=\"'Paradise'\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" Songs;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"12\" /><option startIndex=\"13\" endIndex=\"16\" /><option startIndex=\"17\" endIndex=\"30\" /><option startIndex=\"31\" endIndex=\"36\" /><option startIndex=\"37\" endIndex=\"45\" /><option startIndex=\"46\" endIndex=\"47\" /><option startIndex=\"48\" endIndex=\"58\" /><option startIndex=\"58\" endIndex=\"59\" /><option correct=\"false\"><content><text value=\"artist\" /></content></option><option correct=\"false\"><content><text value=\"'Stevie J'\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"songname\" /><header content=\"artist\" /><header content=\"streams\" /><header content=\"certifications\" /></row><row><data content=\"Paradise\" /><data content=\"The Jets\" /><data content=\"130\" /><data content=\"\" /></row><row><data content=\"My Way\" /><data content=\"Stevie J\" /><data content=\"100\" /><data content=\"\" /></row><row><data content=\"Purple Sunrise\" /><data content=\"Harry\" /><data content=\"90\" /><data content=\"\" /></row><row><data content=\"California Highway\" /><data content=\"Joan &amp; Jerry\" /><data content=\"85\" /><data content=\"\" /></row><row><data content=\"My Sister Meg\" /><data content=\"Couches\" /><data content=\"70\" /><data content=\"\" /></row></table></output></code><p visible-if=\"wrong\">Önce <code>UPDATE</code>, ardından <code>Songs</code> ve sonra <code>SET</code>, <code>streams = 130</code>, <code>WHERE</code>, <code>songname</code>, <code>=</code>, <code>'Paradise'</code>, <code>;</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "Example: Multiple Rows",
            "id": 118718,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Numarası <code>PA76</code> ve <code>PA67</code> olan uçuşlar için <code>mealservice</code> değerini <code>1</code> olarak ayarlayan bir <code>UPDATE</code> ifadesi kodla.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE Flights (&#xA; number TEXT NOT NULL,&#xA; type TEXT NOT NULL,&#xA; origin TEXT NOT NULL,&#xA; destination TEXT NOT NULL,&#xA; duration REAL NOT NULL,&#xA; mealservice INTEGER,&#xA; PRIMARY KEY (number)&#xA;);&#xA;&#xA;INSERT INTO Flights (number, type, origin, destination, duration) VALUES ('PA84', 'International', 'Paris', 'London', 1.2);&#xA;&#xA;INSERT INTO Flights (number, type, origin, destination, duration) VALUES ('PA56', 'Domestic', 'New York', 'Los Angeles', 5.5);&#xA;&#xA;INSERT INTO Flights (number, type, origin, destination, duration) VALUES ('PA67', 'International', 'New York', 'London', 7);&#xA;&#xA;INSERT INTO Flights (number, type, origin, destination, duration) VALUES ('PA76', 'Domestic', 'Honolulu', 'Boston', 9.5);\"><tables><table name=\"Flights\"><row><header content=\"number\" /><header content=\"type\" /><header content=\"origin\" /><header content=\"destination\" /><header content=\"duration\" /><header content=\"mealservice\" /></row><row><data content=\"PA84\" /><data content=\"International\" /><data content=\"Paris\" /><data content=\"London\" /><data content=\"1.2\" /><data content=\"\" /></row><row><data content=\"PA56\" /><data content=\"Domestic\" /><data content=\"New York\" /><data content=\"Los Angeles\" /><data content=\"5.5\" /><data content=\"\" /></row><row><data content=\"PA67\" /><data content=\"International\" /><data content=\"New York\" /><data content=\"London\" /><data content=\"7.0\" /><data content=\"\" /></row><row><data content=\"PA76\" /><data content=\"Domestic\" /><data content=\"Honolulu\" /><data content=\"Boston\" /><data content=\"9.5\" /><data content=\"\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" Flights \" /><text value=\"SET\" class=\"keyword\" /><text value=\" mealservice = \" /><text value=\"1\" class=\"number\" /><text value=\" \" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"number\" class=\"built_in\" /><text value=\" = \" /><text value=\"'PA76'\" class=\"string\" /><text value=\" \" /><text value=\"OR\" class=\"keyword\" /><text value=\" \" /><text value=\"number\" class=\"built_in\" /><text value=\" = \" /><text value=\"'PA67'\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" Flights;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"35\" endIndex=\"40\" /><option startIndex=\"41\" endIndex=\"47\" /><option startIndex=\"48\" endIndex=\"49\" /><option startIndex=\"57\" endIndex=\"59\" /><option startIndex=\"60\" endIndex=\"66\" /><option startIndex=\"67\" endIndex=\"68\" /><option startIndex=\"69\" endIndex=\"75\" /><option correct=\"false\"><content><text value=\"'PA56'\" /></content></option><option correct=\"false\"><content><text value=\"destination\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"number\" /><header content=\"type\" /><header content=\"origin\" /><header content=\"destination\" /><header content=\"duration\" /><header content=\"mealservice\" /></row><row><data content=\"PA84\" /><data content=\"International\" /><data content=\"Paris\" /><data content=\"London\" /><data content=\"1.2\" /><data content=\"\" /></row><row><data content=\"PA56\" /><data content=\"Domestic\" /><data content=\"New York\" /><data content=\"Los Angeles\" /><data content=\"5.5\" /><data content=\"\" /></row><row><data content=\"PA67\" /><data content=\"International\" /><data content=\"New York\" /><data content=\"London\" /><data content=\"7.0\" /><data content=\"1\" /></row><row><data content=\"PA76\" /><data content=\"Domestic\" /><data content=\"Honolulu\" /><data content=\"Boston\" /><data content=\"9.5\" /><data content=\"1\" /></row></table></output></code><p visible-if=\"wrong\">Önce <code>WHERE</code>, ardından <code>number</code> ve sonra <code>=</code>, <code>OR</code>, <code>number</code>, <code>=</code>, <code>'PA67'</code> öğelerini seçtiğinden emin ol.</p></body></html>"
