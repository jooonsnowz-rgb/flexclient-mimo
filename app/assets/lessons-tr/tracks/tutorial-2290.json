          {
            "title": "Example: Column Definition",
            "id": 120034,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>Tickets</code> tablosu için sütun tanımlama sözdizimini kodla.</p><p>Tabloda iki sütun olmalı: <code>qty</code> adlı bir <code>INTEGER</code> sütunu ve <code>name</code> adlı bir <code>TEXT</code> sütunu.</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"CREATE\" class=\"keyword\" /><text value=\" \" /><text value=\"TABLE\" class=\"keyword\" /><text value=\" Tickets (\" /><text type=\"break\" /><text value=\" qty \" /><text value=\"INTEGER\" class=\"built_in\" /><text value=\",\" /><text type=\"break\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"TEXT\" class=\"built_in\" /><text type=\"break\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"24\" endIndex=\"27\" /><option startIndex=\"28\" endIndex=\"35\" /><option startIndex=\"38\" endIndex=\"42\" /><option startIndex=\"43\" endIndex=\"47\" /><option correct=\"false\"><content><text value=\"REAL\" /></content></option><option correct=\"false\"><content><text value=\"NULL\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><data content=\"No result!\" /></row></table></output></code><p visible-if=\"wrong\">Önce <code>qty</code>, ardından <code>INTEGER</code> ve sonra <code>name</code>, <code>TEXT</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>Tickets</code> tablosunu önce tam sayı <code>qty</code>, sonra metin <code>name</code> ile oluştur.</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"CREATE\" class=\"keyword\" /><text value=\" \" /><text value=\"TABLE\" class=\"keyword\" /><text value=\" Tickets (\" /><text type=\"break\" /><text value=\" qty \" /><text value=\"INTEGER\" class=\"built_in\" /><text value=\",\" /><text type=\"break\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"TEXT\" class=\"built_in\" /><text type=\"break\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"24\" endIndex=\"27\" /><option startIndex=\"28\" endIndex=\"35\" /><option startIndex=\"38\" endIndex=\"42\" /><option startIndex=\"43\" endIndex=\"47\" /><option correct=\"false\"><content><text value=\"price\" /></content></option><option correct=\"false\"><content><text value=\"REAL\" /></content></option><option correct=\"false\"><content><text value=\"BOOLEAN\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Önce <code>qty</code>, ardından <code>INTEGER</code>, <code>name</code> ve son olarak <code>TEXT</code> öğelerini seçtiğinden emin ol.</p></body></html>",
