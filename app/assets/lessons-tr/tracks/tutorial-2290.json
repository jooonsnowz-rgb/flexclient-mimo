            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>toys</code> tablosuna yeni bir satır ekle.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE toys( &#xA;    name varchar(255), &#xA;    price int &#xA;); &#xA; &#xA;INSERT INTO toys(name, price) &#xA;VALUES(&quot;Teddy bear&quot;, 14); &#xA; &#xA;INSERT INTO toys(name, price) &#xA;VALUES(&quot;Remote controlled car&quot;, 12);\"><tables><table name=\"toys\"><row><header content=\"name\" /><header content=\"price\" /></row><row><data content=\"Teddy bear\" /><data content=\"14\" /></row><row><data content=\"Remote controlled car\" /><data content=\"12\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"INSERT\" class=\"keyword\" /><text value=\" \" /><text value=\"INTO\" class=\"keyword\" /><text value=\" toys(\" /><text value=\"name\" class=\"keyword\" /><text value=\", price) \" /><text type=\"break\" /><text value=\"VALUES\" class=\"keyword\" /><text value=\"(\" /><text value=\"&quot;Clay mix&quot;\" class=\"string\" /><text value=\", \" /><text value=\"9\" class=\"number\" /><text value=\"); \" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" toys;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"11\" /><option correct=\"false\"><content><text value=\"SELECT\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"price\" /></row><row><data content=\"Teddy bear\" /><data content=\"14\" /></row><row><data content=\"Remote controlled car\" /><data content=\"12\" /></row><row><data content=\"Clay mix\" /><data content=\"9\" /></row></table></output></code>