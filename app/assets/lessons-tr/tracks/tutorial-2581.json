          {
            "title": "Example 1",
            "id": 127612,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>for döngüsünün içine bir <code>print()</code> ifadesi ekle ve <code>item</code> öğesini görüntüle.</p><code name=\"main.swift\" version=\"2\" codelang=\"swift\"><content><text value=\"let\" class=\"keyword\" /><text value=\" items = [\" /><text value=\"&quot;milk&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;tomato&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;apple&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"for\" class=\"keyword\" /><text value=\" item \" /><text value=\"in\" class=\"keyword\" /><text value=\" items {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"print\" class=\"built_in\" /><text value=\"(item)\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"items:\" /></content></option><option startIndex=\"63\" endIndex=\"68\" /><option startIndex=\"68\" endIndex=\"69\" /><option startIndex=\"69\" endIndex=\"73\" /><option startIndex=\"73\" endIndex=\"74\" /></options></interaction></interactions><output><content><text value=\"milk\" /><text type=\"break\" /><text value=\"tomato\" /><text type=\"break\" /><text value=\"apple\" /></content></output></code><p visible-if=\"wrong\">Önce <code>print</code>, ardından <code>(</code> ve sonra <code>item</code>, <code>)</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          },
