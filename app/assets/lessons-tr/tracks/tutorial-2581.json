            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bir dizi üzerinde nasıl döngü kurarız?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">for döngüsüyle</item><item value=\"2\" correct=\"false\"><code>print()</code> ifadesiyle</item></selection><p visible-if=\"wrong\">for döngüsüyle.</p></body></html>"
          },
