            "interactiveContent": "<!DOCTYPE html ><html><body><p>Döngüyü tamamlamak için <code>for</code> kodunu yaz.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" dataPoints = [\" /><text value=\"99\" class=\"number\" /><text value=\", \" /><text value=\"99\" class=\"number\" /><text value=\", \" /><text value=\"99\" class=\"number\" /><text value=\", \" /><text value=\"99\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"for\" class=\"keyword\" /><text value=\" data \" /><text value=\"in\" class=\"keyword\" /><text value=\" dataPoints {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"print\" class=\"built_in\" /><text value=\"(data + \" /><text value=\"1\" class=\"number\" /><text value=\")\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"35\" endIndex=\"38\" /></interactions><output><content><text value=\"100\" /><text type=\"break\" /><text value=\"100\" /><text type=\"break\" /><text value=\"100\" /><text type=\"break\" /><text value=\"100\" /></content></output></code><p visible-if=\"wrong\"><code>for</code> ifadesini yazdığından emin ol.</p></body></html>"
