            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu kodda yanlış olan ne?</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" singers = [\" /><text value=\"&quot;Bowie&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Freddie&quot;\" class=\"string\" /><text value=\"] \" /><text type=\"break\" /><text type=\"break\" /><text value=\"in\" class=\"keyword\" /><text value=\" singer \" /><text value=\"for\" class=\"keyword\" /><text value=\" singers {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"print\" class=\"built_in\" /><text value=\"(singer)\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">for-in döngüsü yanlış yazılmış </item><item value=\"2\" correct=\"false\">Bu kodda yanlış olan hiçbir şey yok</item></selection><p visible-if=\"wrong\">for-in döngüsü yanlış yazılmış .</p></body></html>"
