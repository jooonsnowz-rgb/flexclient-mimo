            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu kod konsolda ne görüntüler?</p><code name=\"main.swift\" version=\"2\" codelang=\"swift\"><content><text value=\"let\" class=\"keyword\" /><text value=\" consoles = [\" /><text value=\"&quot;Playstation&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Xbox&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"for\" class=\"keyword\" /><text value=\" console \" /><text value=\"in\" class=\"keyword\" /><text value=\" consoles {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"print\" class=\"built_in\" /><text value=\"(console)\" /><text type=\"break\" /><text value=\"}\" /></content><output><content><text value=\"Playstation\" /><text type=\"break\" /><text value=\"Xbox\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>\"Playstation\"</code> ve <code>\"Xbox\"</code></item><item value=\"2\" correct=\"false\"> Konsolda hiçbir şey görüntülenmiyor</item></selection><p visible-if=\"wrong\"><code>\"Playstation\"</code> ve <code>\"Xbox\"</code>.</p></body></html>"
