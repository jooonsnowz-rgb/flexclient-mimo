            "title": "Question 2",
            "id": 127609,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu kod konsolda ne görüntüler?</p><code name=\"main.swift\" version=\"2\" codelang=\"swift\"><content><text value=\"let\" class=\"keyword\" /><text value=\" studentGrades = [\" /><text value=\"&quot;A&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;A-&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;C&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"for\" class=\"keyword\" /><text value=\" grade \" /><text value=\"in\" class=\"keyword\" /><text value=\" studentGrades {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"print\" class=\"built_in\" /><text value=\"(grade)\" /><text type=\"break\" /><text value=\"}\" /></content><output><content><text value=\"A\" /><text type=\"break\" /><text value=\"A-\" /><text type=\"break\" /><text value=\"C\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>\"A\"</code>, ardından <code>\"A-\"</code> ve son olarak <code>\"C\"</code></item><item value=\"2\" correct=\"false\">Bu kod konsolda hiçbir şey görüntülemeyecek</item></selection><p visible-if=\"wrong\"><code>\"A\"</code>, ardından <code>\"A-\"</code> ve son olarak <code>\"C\"</code>.</p></body></html>"
          },
