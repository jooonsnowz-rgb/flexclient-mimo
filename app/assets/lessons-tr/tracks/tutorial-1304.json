            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>Purple Haze</code>'in en son görüntülenmesini sağlayacak değerleri aktar.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"show_queue\" class=\"title\" /><text value=\"(current, up_next)\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"&quot;now playing: &quot;\" class=\"string\" /><text value=\" + current)\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"&quot;up next: &quot;\" class=\"string\" /><text value=\" + up_next)\" /><text type=\"break\" /><text type=\"break\" /><text value=\"show_queue(\" /><text value=\"&quot;Hey Joe&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Purple Haze&quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"112\" endIndex=\"121\" /><option startIndex=\"123\" endIndex=\"136\" /></options></interaction></interactions><output><content><text value=\"now playing: Hey Joe\" /><text type=\"break\" /><text value=\"up next: Purple Haze\" /></content></output></code><p visible-if=\"wrong\">Önce <code>\"Hey Joe\"</code>, ardından <code>\"Purple Haze\"</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>Purple Haze</code>, <code>now playing: Hey Joe</code> satırından sonra en son görüntülenecek şekilde iki şarkıyı aktar.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"show_queue\" class=\"title\" /><text value=\"(current, up_next)\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"&quot;now playing: &quot;\" class=\"string\" /><text value=\" + current)\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"&quot;up next: &quot;\" class=\"string\" /><text value=\" + up_next)\" /><text type=\"break\" /><text type=\"break\" /><text value=\"show_queue(\" /><text value=\"&quot;Hey Joe&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Purple Haze&quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"112\" endIndex=\"121\" /><option startIndex=\"123\" endIndex=\"136\" /><option correct=\"false\"><content><text value=\"&quot;Foxy Lady&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"now playing: Hey Joe\" /><text type=\"break\" /><text value=\"up next: Purple Haze\" /></content></output></code><p visible-if=\"wrong\">Önce <code>\"Hey Joe\"</code>, ardından <code>\"Purple Haze\"</code> öğelerini seçtiğinden emin ol.</p></body></html>"
