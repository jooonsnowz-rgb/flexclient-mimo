            "id": 130733,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bir fonksiyonun hem isteğe bağlı hem de varsayılan parametreleri olabilir mi?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Evet</item><item value=\"2\" correct=\"false\">Hayır</item></selection><p visible-if=\"wrong\">Evet öğesini seçtiğinden emin ol.</p></body></html>"
