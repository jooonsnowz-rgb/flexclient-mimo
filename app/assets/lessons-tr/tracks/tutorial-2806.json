          {
            "title": "Lesson #11",
            "id": 131059,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>İsteğe bağlı parametre için bir değer sağladığından emin ol.</p><code version=\"2\" codelang=\"typescript\" name=\"script.ts\" visible-if=\"always\"><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"calculateTotal\" class=\"title\" /><text value=\"(\" /><text value=\"price: \" /><text value=\"number\" class=\"built_in\" /><text value=\", discount?: \" /><text value=\"number\" class=\"built_in\" /><text value=\"): \" /><text value=\"number\" class=\"title\" /><text value=\" \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"if\" class=\"keyword\" /><text value=\" (discount !== \" /><text value=\"undefined\" class=\"literal\" /><text value=\") {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"return\" class=\"keyword\" /><text value=\" price - (price * discount / \" /><text value=\"100\" class=\"number\" /><text value=\");\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" price;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(calculateTotal(\" /><text value=\"100\" class=\"number\" /><text value=\", \" /><text value=\"10\" class=\"number\" /><text value=\"));\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"175\" endIndex=\"198\" /><option correct=\"false\"><content><text value=\"calculateTotal(100)\" /></content></option></options></interaction></interactions><output><content><text value=\"90\" /></content></output></code><p visible-if=\"wrong\"><code>calculateTotal(100, 10)</code> öğesini seçtiğinden emin ol.</p></body></html>"
          },
          {
