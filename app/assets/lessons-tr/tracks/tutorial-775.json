            "interactiveContent": "<!DOCTYPE html ><html><body><p>Uzunluğunun <code>0</code> olduğunu görmek için <code>tasks</code> değişkenine boş bir dizi ata.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" tasks = [];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(tasks.length);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"14\" endIndex=\"15\" /><option startIndex=\"15\" endIndex=\"16\" /><option correct=\"false\"><content><text value=\"{\" /></content></option><option correct=\"false\"><content><text value=\"}\" /></content></option></options></interaction></interactions><output><content><text value=\"0\" /></content></output></code><p /><p visible-if=\"wrong\">Önce <code>[</code>, ardından <code>]</code> öğelerini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Uzunluğunun <code>0</code> olması için <code>tasks</code> değişkeninde boş bir dizi sakla.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" tasks = [];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(tasks.length);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"14\" endIndex=\"15\" /><option startIndex=\"15\" endIndex=\"16\" /><option startIndex=\"36\" endIndex=\"42\" /><option correct=\"false\"><content><text value=\"{\" /></content></option><option correct=\"false\"><content><text value=\"}\" /></content></option><option correct=\"false\"><content><text value=\"size\" /></content></option></options></interaction></interactions><output><content><text value=\"0\" /></content></output></code><p visible-if=\"wrong\">Önce <code>[</code>, ardından <code>]</code> ve son olarak <code>length</code> öğelerini seçtiğinden emin ol.</p></body></html>",
