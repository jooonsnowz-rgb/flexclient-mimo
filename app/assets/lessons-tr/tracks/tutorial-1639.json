          {
            "title": "Example: Literal string",
            "id": 105022,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Film başlığını <code>Brave</code> bir dize sabiti olarak ekle.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" movie = \" /><text value=\"`Brave`\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(movie);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"12\" endIndex=\"19\" /><option correct=\"false\"><content><text value=\"´Brave´\" /></content></option></options></interaction></interactions><output><content><text value=\"Brave\" /></content></output></code><p visible-if=\"wrong\"><code>`Brave`</code> öğesini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>Brave</code> değerini şablon literal kullanarak <code>movie</code> adlı bir sabitte sakla.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" \" /><text value=\"movie\" /><text value=\" \" /><text value=\"=\" /><text value=\" \" /><text value=\"`Brave`\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".\" /><text value=\"log\" /><text value=\"(\" /><text value=\"movie\" /><text value=\")\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"5\" /><option startIndex=\"6\" endIndex=\"11\" /><option startIndex=\"14\" endIndex=\"21\" /><option correct=\"false\"><content><text value=\"let\" /></content></option><option correct=\"false\"><content><text value=\"film\" /></content></option><option correct=\"false\"><content><text value=\"&quot;Brave&quot;\" /></content></option><option correct=\"false\"><content><text value=\"'Brave'\" /></content></option></options></interaction></interactions><output><content><text value=\"Brave\" /></content></output></code><p visible-if=\"wrong\">Önce <code>const</code>, ardından <code>movie</code> ve son olarak <code>`Brave`</code> öğelerini seçtiğinden emin ol.</p></body></html>",
