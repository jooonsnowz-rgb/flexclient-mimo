            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>Player</code> için bir sınıf oluştur.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"Class\" /></content></option><option startIndex=\"0\" endIndex=\"5\" /><option startIndex=\"6\" endIndex=\"12\" /></options></interaction></interactions><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"Player\" class=\"title\" /><text value=\" \" /><text value=\"{}\" /></content></code><p visible-if=\"wrong\">Önce <code>class</code>, ardından <code>Player</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "Lesson #13",
            "id": 149896,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>Player</code> sınıfına bir <code>constructor</code> ekle.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"16\" endIndex=\"27\" /><option startIndex=\"27\" endIndex=\"28\" /><option startIndex=\"28\" endIndex=\"29\" /><option startIndex=\"30\" endIndex=\"31\" /><option startIndex=\"31\" endIndex=\"32\" /></options></interaction></interactions><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"Player\" class=\"title\" /><text value=\" \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"constructor\" class=\"keyword\" /><text value=\"() {}\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Önce <code>constructor</code>, ardından <code>(</code> ve sonra <code>)</code>, <code>{</code>, <code>}</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "Lesson #14",
            "id": 149897,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>Player</code> sınıfına birkaç parametre ekle.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"28\" endIndex=\"33\" /><option startIndex=\"34\" endIndex=\"40\" /></options></interaction></interactions><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"Player\" class=\"title\" /><text value=\" \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"constructor\" class=\"keyword\" /><text value=\"(name, health) {}\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Önce <code>name,</code>, ardından <code>health</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          }
