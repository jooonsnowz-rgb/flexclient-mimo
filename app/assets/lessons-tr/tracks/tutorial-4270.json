            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu kod konsolda ne görüntüler?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"if\" class=\"keyword\" /><text value=\" (\" /><text value=\"true\" class=\"literal\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;3 2 1 GO&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>3 2 1 GO</code></item><item value=\"2\" correct=\"false\">Süslü parantezler arasındaki kod atlandığı için hiçbir şey</item></selection><p visible-if=\"wrong\"><code>3 2 1 GO</code>.</p></body></html>"
          },
