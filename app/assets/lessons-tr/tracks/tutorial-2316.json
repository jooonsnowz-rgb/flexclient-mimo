            "id": 75858,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bir koşulun <code>True</code> veya <code>False</code> olmasına bağlı olarak kodu çalıştıran ya da atlayan ifadeleri nasıl adlandırırız?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">If ifadeleri</item><item value=\"2\" correct=\"false\">Else ifadeleri</item><item value=\"3\" correct=\"false\">For döngüleri</item></selection><p visible-if=\"wrong\">If ifadeleri.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>is_member</code>, <code>False</code> saklıyor. <code>if is_member:</code> girintili karşılama mesajına ne yapar?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Karşılama mesajını atlar.</item><item value=\"2\" correct=\"false\">is_member mevcut olduğu için karşılama mesajını yazdırır.</item><item value=\"3\" correct=\"false\">Karşılama mesajı yerine False yazdırır.</item></selection><p visible-if=\"wrong\">Karşılama mesajını atlar.</p></body></html>",
            "hardModeSelected": true
