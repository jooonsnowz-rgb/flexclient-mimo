          {
            "title": "Question: Condition",
            "id": 76566,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu kod ne görüntüler?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"weather = \" /><text value=\"&quot;rainy&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"color_code = \" /><text value=\"&quot;yellow&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" weather == \" /><text value=\"&quot;rainy&quot;\" class=\"string\" /><text value=\":\" /><text type=\"break\" /><text value=\"  color_code = \" /><text value=\"&quot;blue&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(color_code)\" /></content><output><content><text value=\"blue\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>blue</code></item><item value=\"2\" correct=\"false\"><code>yellow</code></item><item value=\"3\" correct=\"false\"><code>color_code</code></item></selection><p visible-if=\"wrong\"><code>blue</code> öğesini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Bu kod neden <code>yellow</code> yerine <code>blue</code> görüntüler?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"weather = \" /><text value=\"&quot;rainy&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"color_code = \" /><text value=\"&quot;yellow&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" weather == \" /><text value=\"&quot;rainy&quot;\" class=\"string\" /><text value=\":\" /><text type=\"break\" /><text value=\"  color_code = \" /><text value=\"&quot;blue&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(color_code)\" /></content><output><content><text value=\"blue\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Koşul <code>True</code> olduğu için <code>color_code</code> yazdırılmadan önce değişir.</item><item value=\"2\" correct=\"false\">Koşul <code>False</code> olduğu için <code>color_code</code> ilk değerini korur.</item><item value=\"3\" correct=\"false\"><code>print()</code> geçerli değer yerine değişken adını görüntüler.</item></selection><p visible-if=\"wrong\">Koşul <code>True</code> olduğu için <code>color_code</code> yazdırılmadan önce değişir.</p></body></html>"
          },
