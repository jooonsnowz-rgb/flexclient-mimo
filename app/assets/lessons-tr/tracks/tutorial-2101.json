            "title": "Intro 2",
            "id": 118765,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>ALTER TABLE</code>'ı bir tabloyu doğrudan değiştirmek için kullanabiliriz. <code>discount</code> adlı bir sütun eklemek için görselleştirmede <code>Use ALTER</code>'a dokun!</p><webview version=\"2\" visible-if=\"always\" content=\"&lt;!doctype html&gt; &#xA;&lt;html&gt; &#xA; &lt;head&gt; &#xA;  &lt;meta charset=&quot;utf-8&quot;&gt; &#xA;  &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width&quot;&gt; &#xA;  &lt;style&gt; &#xA;   @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@500&amp;display=swap'); &#xA; &#xA;   html, &#xA;   body { &#xA;    min-height: 100%; &#xA;    width: 100%; &#xA;    font-family: 'Montserrat', sans-serif; &#xA;   } &#xA;    &#xA;   table { &#xA;    border-collapse: collapse; &#xA;    width: 40%; &#xA;    background-color: rgb(244 248 254); &#xA;   } &#xA;    &#xA;   td, &#xA;   th { &#xA;    border: 1px solid rgb(217 232 251); &#xA;    padding: 8px; &#xA;    font-size: 10px; &#xA;   } &#xA;    &#xA;   th { &#xA;    background-color: #eeeeee; &#xA;    text-align: left; &#xA;   } &#xA;    &#xA;   caption { &#xA;    font-size: 10px; &#xA;    color: rgb(50 185 100); &#xA;    padding: 8px; &#xA;    text-align: left; &#xA;    border-bottom: 2px solid rgb(50 185 100); &#xA;   } &#xA;    &#xA;   button { &#xA;    font-family: 'Poppins', sans-serif; &#xA;    padding: 8px; &#xA;    background-color: rgb(217 232 251); &#xA;    border: none; &#xA;    margin: 5px; &#xA;   } &#xA;  &lt;/style&gt; &#xA; &lt;/head&gt; &#xA; &lt;body&gt; &#xA;  &lt;table&gt; &#xA;   &lt;caption&gt;orders&lt;/caption&gt; &#xA;   &lt;tr&gt; &#xA;    &lt;th&gt;order_no&lt;/th&gt; &#xA;    &lt;th&gt;order_status&lt;/th&gt; &#xA;    &lt;th&gt;place_of_order&lt;/th&gt; &#xA;   &lt;/tr&gt; &#xA;   &lt;tr&gt; &#xA;    &lt;td&gt;101&lt;/td&gt; &#xA;    &lt;td&gt;Delivered&lt;/td&gt; &#xA;    &lt;td&gt;Amazon&lt;/td&gt; &#xA;   &lt;/tr&gt; &#xA;   &lt;tr&gt; &#xA;    &lt;td&gt;512&lt;/td&gt; &#xA;    &lt;td&gt;Delivered&lt;/td&gt; &#xA;    &lt;td&gt;Amazon&lt;/td&gt; &#xA;   &lt;/tr&gt; &#xA;   &lt;tr&gt; &#xA;    &lt;td&gt;432&lt;/td&gt; &#xA;    &lt;td&gt;Shipped&lt;/td&gt; &#xA;    &lt;td&gt;Redbubble&lt;/td&gt; &#xA;   &lt;/tr&gt; &#xA;   &lt;tr&gt; &#xA;    &lt;td&gt;984&lt;/td&gt; &#xA;    &lt;td&gt;Processing&lt;/td&gt; &#xA;    &lt;td&gt;Store&lt;/td&gt; &#xA;   &lt;/tr&gt; &#xA;   &lt;tr&gt; &#xA;    &lt;td&gt;566&lt;/td&gt; &#xA;    &lt;td&gt;Delivered&lt;/td&gt; &#xA;    &lt;td&gt;Store&lt;/td&gt; &#xA;   &lt;/tr&gt; &#xA;   &lt;button&gt;Use ALTER&lt;/button&gt; &#xA;  &lt;/table&gt; &#xA;  &lt;script&gt; &#xA;   const addColumn = () =&gt; { &#xA;    [...document.querySelectorAll('table tr')].forEach((row, i) =&gt; { &#xA;     const input = document.createElement(&quot;div&quot;) &#xA;     const cell = document.createElement(i ? &quot;td&quot; : &quot;th&quot;) &#xA;     cell.appendChild(input) &#xA;     row.appendChild(cell) &#xA;     let ths = document.querySelectorAll(&quot;th&quot;).length &#xA;     document.querySelectorAll(&quot;th&quot;)[ths - 1].innerHTML = &#xA;      &quot;discount&quot; &#xA;    }); &#xA;    document.querySelector('button').disabled = true; &#xA;   } &#xA;   document.querySelector('button').onclick = addColumn; &#xA;  &lt;/script&gt; &#xA; &lt;/body&gt; &#xA;&lt;/html&gt;\" /></body></html>"
          },
          {
            "title": "ALTER TABLE",
            "id": 118766,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>ALTER TABLE</code> 2 parçalı bir komuttur. İlk bölüm için <code>ALTER TABLE</code> yazıp tablo adını ekle.</p><p>Ortaya çıkan tabloyu görebilmek için bir <code>SELECT</code> ifadesi eklediğimizi unutma.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE orders( &#xA; order_no int, &#xA; order_status varchar(255), &#xA; order_amt int, &#xA; customer_id int, &#xA; place_of_order varchar(255) &#xA;); &#xA; &#xA;INSERT INTO orders(order_no, order_status, order_amt, customer_id, place_of_order) &#xA;VALUES(101, &quot;Delivered&quot;, 550, 3001, &quot;Amazon&quot;); &#xA; &#xA;INSERT INTO orders(order_no, order_status, order_amt, customer_id, place_of_order) &#xA;VALUES(512, &quot;Delivered&quot;, 113, 3001, &quot;Amazon&quot;); &#xA; &#xA;INSERT INTO orders(order_no, order_status, order_amt, customer_id, place_of_order) &#xA;VALUES(984, &quot;Processing&quot;, 54, 3012, &quot;Store&quot;); &#xA; &#xA;INSERT INTO orders(order_no, order_status, order_amt, customer_id, place_of_order) &#xA;VALUES(566, &quot;Delivered&quot;, 850, 3120, &quot;Store&quot;); &#xA; &#xA;INSERT INTO orders(order_no, order_status, order_amt, customer_id, place_of_order) &#xA;VALUES(432, &quot;Shipped&quot;, 99, 3003, &quot;Amazon&quot;);\"><tables><table name=\"orders\"><row><header content=\"order_no\" /><header content=\"order_status\" /><header content=\"order_amt\" /><header content=\"customer_id\" /><header content=\"place_of_order\" /></row><row><data content=\"101\" /><data content=\"Delivered\" /><data content=\"550\" /><data content=\"3001\" /><data content=\"Amazon\" /></row><row><data content=\"512\" /><data content=\"Delivered\" /><data content=\"113\" /><data content=\"3001\" /><data content=\"Amazon\" /></row><row><data content=\"984\" /><data content=\"Processing\" /><data content=\"54\" /><data content=\"3012\" /><data content=\"Store\" /></row><row><data content=\"566\" /><data content=\"Delivered\" /><data content=\"850\" /><data content=\"3120\" /><data content=\"Store\" /></row><row><data content=\"432\" /><data content=\"Shipped\" /><data content=\"99\" /><data content=\"3003\" /><data content=\"Amazon\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"ALTER\" class=\"keyword\" /><text value=\" \" /><text value=\"TABLE\" class=\"keyword\" /><text value=\" orders \" /><text type=\"break\" /><text value=\"ADD\" class=\"keyword\" /><text value=\" discount \" /><text value=\"int\" class=\"built_in\" /><text value=\"; \" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" orders;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"5\" /><option startIndex=\"6\" endIndex=\"11\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"order_no\" /><header content=\"order_status\" /><header content=\"order_amt\" /><header content=\"customer_id\" /><header content=\"place_of_order\" /><header content=\"discount\" /></row><row><data content=\"101\" /><data content=\"Delivered\" /><data content=\"550\" /><data content=\"3001\" /><data content=\"Amazon\" /><data content=\"\" /></row><row><data content=\"512\" /><data content=\"Delivered\" /><data content=\"113\" /><data content=\"3001\" /><data content=\"Amazon\" /><data content=\"\" /></row><row><data content=\"984\" /><data content=\"Processing\" /><data content=\"54\" /><data content=\"3012\" /><data content=\"Store\" /><data content=\"\" /></row><row><data content=\"566\" /><data content=\"Delivered\" /><data content=\"850\" /><data content=\"3120\" /><data content=\"Store\" /><data content=\"\" /></row><row><data content=\"432\" /><data content=\"Shipped\" /><data content=\"99\" /><data content=\"3003\" /><data content=\"Amazon\" /><data content=\"\" /></row></table></output></code><p visible-if=\"wrong\">Önce <code>ALTER</code>, ardından <code>TABLE</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "ADD",
            "id": 118767,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>ADD</code> anahtar sözcüğünü, yeni sütunun adı olan <code>discount</code>'ı ve veri türü olan <code>int</code>'i kullanarak yeni sütunlar ekleyebiliriz. <code>ADD</code>'in veri olmadan bir sütun eklediğini unutma!</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE orders( &#xA; order_no int, &#xA; order_status varchar(255), &#xA; order_amt int, &#xA; customer_id int, &#xA; place_of_order varchar(255) &#xA;); &#xA; &#xA;INSERT INTO orders(order_no, order_status, order_amt, customer_id, place_of_order) &#xA;VALUES(101, &quot;Delivered&quot;, 550, 3001, &quot;Amazon&quot;); &#xA; &#xA;INSERT INTO orders(order_no, order_status, order_amt, customer_id, place_of_order) &#xA;VALUES(512, &quot;Delivered&quot;, 113, 3001, &quot;Amazon&quot;); &#xA; &#xA;INSERT INTO orders(order_no, order_status, order_amt, customer_id, place_of_order) &#xA;VALUES(984, &quot;Processing&quot;, 54, 3012, &quot;Store&quot;); &#xA; &#xA;INSERT INTO orders(order_no, order_status, order_amt, customer_id, place_of_order) &#xA;VALUES(566, &quot;Delivered&quot;, 850, 3120, &quot;Store&quot;); &#xA; &#xA;INSERT INTO orders(order_no, order_status, order_amt, customer_id, place_of_order) &#xA;VALUES(432, &quot;Shipped&quot;, 99, 3003, &quot;Amazon&quot;);\"><tables><table name=\"orders\"><row><header content=\"order_no\" /><header content=\"order_status\" /><header content=\"order_amt\" /><header content=\"customer_id\" /><header content=\"place_of_order\" /></row><row><data content=\"101\" /><data content=\"Delivered\" /><data content=\"550\" /><data content=\"3001\" /><data content=\"Amazon\" /></row><row><data content=\"512\" /><data content=\"Delivered\" /><data content=\"113\" /><data content=\"3001\" /><data content=\"Amazon\" /></row><row><data content=\"984\" /><data content=\"Processing\" /><data content=\"54\" /><data content=\"3012\" /><data content=\"Store\" /></row><row><data content=\"566\" /><data content=\"Delivered\" /><data content=\"850\" /><data content=\"3120\" /><data content=\"Store\" /></row><row><data content=\"432\" /><data content=\"Shipped\" /><data content=\"99\" /><data content=\"3003\" /><data content=\"Amazon\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"ALTER\" class=\"keyword\" /><text value=\" \" /><text value=\"TABLE\" class=\"keyword\" /><text value=\" orders \" /><text type=\"break\" /><text value=\"ADD\" class=\"keyword\" /><text value=\" discount \" /><text value=\"int\" class=\"built_in\" /><text value=\"; \" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" orders;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"20\" endIndex=\"23\" /><option startIndex=\"24\" endIndex=\"32\" /><option startIndex=\"33\" endIndex=\"36\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"order_no\" /><header content=\"order_status\" /><header content=\"order_amt\" /><header content=\"customer_id\" /><header content=\"place_of_order\" /><header content=\"discount\" /></row><row><data content=\"101\" /><data content=\"Delivered\" /><data content=\"550\" /><data content=\"3001\" /><data content=\"Amazon\" /><data content=\"\" /></row><row><data content=\"512\" /><data content=\"Delivered\" /><data content=\"113\" /><data content=\"3001\" /><data content=\"Amazon\" /><data content=\"\" /></row><row><data content=\"984\" /><data content=\"Processing\" /><data content=\"54\" /><data content=\"3012\" /><data content=\"Store\" /><data content=\"\" /></row><row><data content=\"566\" /><data content=\"Delivered\" /><data content=\"850\" /><data content=\"3120\" /><data content=\"Store\" /><data content=\"\" /></row><row><data content=\"432\" /><data content=\"Shipped\" /><data content=\"99\" /><data content=\"3003\" /><data content=\"Amazon\" /><data content=\"\" /></row></table></output></code><p visible-if=\"wrong\">Önce <code>ADD</code>, ardından <code>discount</code> ve son olarak <code>int</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "DROP COLUMN",
            "id": 118768,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>DROP COLUMN</code> komutunun ardından kaldırılacak sütunun adı olan <code>place_of_order</code> adını yazarak mevcut sütunları da silebiliriz.</p><p>Her zaman önce <code>ALTER TABLE</code> kullanmayı unutma!</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE orders( &#xA; order_no int, &#xA; order_status varchar(255), &#xA; order_amt int, &#xA; customer_id int, &#xA; place_of_order varchar(255) &#xA;); &#xA; &#xA;INSERT INTO orders(order_no, order_status, order_amt, customer_id, place_of_order) &#xA;VALUES(101, &quot;Delivered&quot;, 550, 3001, &quot;Amazon&quot;); &#xA; &#xA;INSERT INTO orders(order_no, order_status, order_amt, customer_id, place_of_order) &#xA;VALUES(512, &quot;Delivered&quot;, 113, 3001, &quot;Amazon&quot;); &#xA; &#xA;INSERT INTO orders(order_no, order_status, order_amt, customer_id, place_of_order) &#xA;VALUES(984, &quot;Processing&quot;, 54, 3012, &quot;Store&quot;); &#xA; &#xA;INSERT INTO orders(order_no, order_status, order_amt, customer_id, place_of_order) &#xA;VALUES(566, &quot;Delivered&quot;, 850, 3120, &quot;Store&quot;); &#xA; &#xA;INSERT INTO orders(order_no, order_status, order_amt, customer_id, place_of_order) &#xA;VALUES(432, &quot;Shipped&quot;, 99, 3003, &quot;Amazon&quot;); &#xA; &#xA;ALTER TABLE orders &#xA;ADD discount int;\"><tables><table name=\"orders\"><row><header content=\"order_no\" /><header content=\"order_status\" /><header content=\"order_amt\" /><header content=\"customer_id\" /><header content=\"place_of_order\" /><header content=\"discount\" /></row><row><data content=\"101\" /><data content=\"Delivered\" /><data content=\"550\" /><data content=\"3001\" /><data content=\"Amazon\" /><data content=\"\" /></row><row><data content=\"512\" /><data content=\"Delivered\" /><data content=\"113\" /><data content=\"3001\" /><data content=\"Amazon\" /><data content=\"\" /></row><row><data content=\"984\" /><data content=\"Processing\" /><data content=\"54\" /><data content=\"3012\" /><data content=\"Store\" /><data content=\"\" /></row><row><data content=\"566\" /><data content=\"Delivered\" /><data content=\"850\" /><data content=\"3120\" /><data content=\"Store\" /><data content=\"\" /></row><row><data content=\"432\" /><data content=\"Shipped\" /><data content=\"99\" /><data content=\"3003\" /><data content=\"Amazon\" /><data content=\"\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"ALTER\" class=\"keyword\" /><text value=\" \" /><text value=\"TABLE\" class=\"keyword\" /><text value=\" orders \" /><text type=\"break\" /><text value=\"DROP\" class=\"keyword\" /><text value=\" \" /><text value=\"COLUMN\" class=\"keyword\" /><text value=\" place_of_order; \" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" orders;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"20\" endIndex=\"24\" /><option startIndex=\"25\" endIndex=\"31\" /><option startIndex=\"32\" endIndex=\"46\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"order_no\" /><header content=\"order_status\" /><header content=\"order_amt\" /><header content=\"customer_id\" /><header content=\"discount\" /></row><row><data content=\"101\" /><data content=\"Delivered\" /><data content=\"550\" /><data content=\"3001\" /><data content=\"\" /></row><row><data content=\"512\" /><data content=\"Delivered\" /><data content=\"113\" /><data content=\"3001\" /><data content=\"\" /></row><row><data content=\"984\" /><data content=\"Processing\" /><data content=\"54\" /><data content=\"3012\" /><data content=\"\" /></row><row><data content=\"566\" /><data content=\"Delivered\" /><data content=\"850\" /><data content=\"3120\" /><data content=\"\" /></row><row><data content=\"432\" /><data content=\"Shipped\" /><data content=\"99\" /><data content=\"3003\" /><data content=\"\" /></row></table></output></code><p visible-if=\"wrong\">Önce <code>DROP</code>, ardından <code>COLUMN</code> ve son olarak <code>place_of_order</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "RENAME",
            "id": 118771,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>RENAME TO</code> komutuyla bir sütunun adını değiştirebilirsin. <code>RENAME</code>'den sonra sütunun mevcut adını, <code>TO</code>'dan sonra ise yeni adını ekle.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE orders( &#xA; order_no int, &#xA; order_status varchar(255), &#xA; order_amt int, &#xA; customer_id int, &#xA; place_of_order varchar(255) &#xA;); &#xA; &#xA;INSERT INTO orders(order_no, order_status, order_amt, customer_id, place_of_order) &#xA;VALUES(101, &quot;Delivered&quot;, 550, 3001, &quot;Amazon&quot;); &#xA; &#xA;INSERT INTO orders(order_no, order_status, order_amt, customer_id, place_of_order) &#xA;VALUES(512, &quot;Delivered&quot;, 113, 3001, &quot;Amazon&quot;); &#xA; &#xA;INSERT INTO orders(order_no, order_status, order_amt, customer_id, place_of_order) &#xA;VALUES(984, &quot;Processing&quot;, 54, 3012, &quot;Store&quot;); &#xA; &#xA;INSERT INTO orders(order_no, order_status, order_amt, customer_id, place_of_order) &#xA;VALUES(566, &quot;Delivered&quot;, 850, 3120, &quot;Store&quot;); &#xA; &#xA;INSERT INTO orders(order_no, order_status, order_amt, customer_id, place_of_order) &#xA;VALUES(432, &quot;Shipped&quot;, 99, 3003, &quot;Amazon&quot;); &#xA; &#xA;ALTER TABLE orders &#xA;ADD discount int; &#xA; &#xA;ALTER TABLE orders &#xA;DROP COLUMN place_of_order;\"><tables><table name=\"orders\"><row><header content=\"order_no\" /><header content=\"order_status\" /><header content=\"order_amt\" /><header content=\"customer_id\" /><header content=\"discount\" /></row><row><data content=\"101\" /><data content=\"Delivered\" /><data content=\"550\" /><data content=\"3001\" /><data content=\"\" /></row><row><data content=\"512\" /><data content=\"Delivered\" /><data content=\"113\" /><data content=\"3001\" /><data content=\"\" /></row><row><data content=\"984\" /><data content=\"Processing\" /><data content=\"54\" /><data content=\"3012\" /><data content=\"\" /></row