            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bir <code>POST</code> uç noktası oluştur.</p><code version=\"2\" codelang=\"javascript\" name=\"app.js\" visible-if=\"always\"><content><text value=\"app.post(\" /><text value=\"&quot;/users&quot;\" class=\"string\" /><text value=\", (req, res) =&gt; {\" /><text type=\"break\" /><text type=\"break\" /><text value=\"});\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"4\" endIndex=\"8\" /></interactions></code><p visible-if=\"wrong\"><code>post</code> ifadesini yazdığından emin ol.</p></body></html>"
