            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Programlar, aşağıdaki uygulamadaki tekrarlanan öğeler gibi her türden şeyi oluşturmak için aynı kod satırlarını tekrar tekrar kullanır.</p><webview version=\"2\" visible-if=\"always\" content=\"&lt;!DOCTYPE html&gt;&#xA;&lt;html&gt;&#xA;  &lt;head&gt;&#xA;    &lt;title&gt;Pick your sport&lt;/title&gt;&#xA;    &lt;link rel=&quot;stylesheet&quot; href=&quot;https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css&quot; /&gt;&#xA;    &lt;style&gt;&#xA;      body {&#xA;        font-family: Arial, sans-serif;&#xA;        background: #f0f2f5;&#xA;        display: flex;&#xA;        flex-direction: column;&#xA;        align-items: center;&#xA;        margin: 0;&#xA;      }&#xA;&#xA;      h1 {&#xA;        background-color: #004d99;&#xA;        color: white;&#xA;        padding: 20px;&#xA;        border-radius: 10px;&#xA;        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);&#xA;      }&#xA;&#xA;      .icon-list {&#xA;        background: white;&#xA;        list-style-type: none;&#xA;        padding: 20px;&#xA;        border-radius: 10px;&#xA;        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);&#xA;        width: 300px;&#xA;      }&#xA;&#xA;      .icon-list li {&#xA;        display: flex;&#xA;        align-items: center;&#xA;        margin: 10px 0;&#xA;        font-size: 22px;&#xA;        font-weight: bold;&#xA;        background-color: #e0f7fa;&#xA;        padding: 10px;&#xA;        border-radius: 5px;&#xA;        transition: background-color 0.3s;&#xA;      }&#xA;&#xA;      .icon-list li:hover {&#xA;        background-color: #b2ebf2;&#xA;      }&#xA;&#xA;      .icon-list li i {&#xA;        margin-right: 15px;&#xA;        color: #004d99;&#xA;        font-size: 30px;&#xA;      }&#xA;    &lt;/style&gt;&#xA;  &lt;/head&gt;&#xA;  &lt;body&gt;&#xA;    &lt;h1&gt;Sports&lt;/h1&gt;&#xA;    &lt;ul class=&quot;icon-list&quot;&gt;&#xA;      &lt;li&gt;&lt;i class=&quot;fas fa-football-ball&quot;&gt;&lt;/i&gt