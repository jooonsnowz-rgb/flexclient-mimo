            "id": 145438,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bir sayı içeren bir <code>const</code> değişkeni oluştur.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"&quot;2&quot;\" /></content></option><option correct=\"false\"><content><text value=\"var\" /></content></option><option startIndex=\"0\" endIndex=\"5\" /><option startIndex=\"6\" endIndex=\"11\" /><option startIndex=\"12\" endIndex=\"13\" /><option startIndex=\"14\" endIndex=\"15\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" coins = \" /><text value=\"2\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(coins);\" /></content></code><p visible-if=\"wrong\">Önce <code>const</code>, ardından <code>coins</code> ve sonra <code>=</code>, <code>2</code> öğelerini seçtiğinden emin ol.</p></body></html>"
