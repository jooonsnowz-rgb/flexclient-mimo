            "id": 145434,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Konsolda <code>false</code> görüntüleyen bir karşılaştırma operatörü kullanarak <code>enemyType</code> ile <code>expected</code> değerlerini karşılaştır.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"=\" /></content></option><option correct=\"false\"><content><text value=\"!==\" /></content></option><option startIndex=\"73\" endIndex=\"76\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" enemyType = \" /><text value=\"&quot;orc&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" expected = \" /><text value=\"&quot;slime&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(enemyType === expected);\" /></content></code><p visible-if=\"wrong\"><code>===</code> öğesini seçtiğinden emin ol.</p></body></html>"
          },
          {
