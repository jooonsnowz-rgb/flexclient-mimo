            "id": 150068,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>Mage</code> sınıfındaki metodun <code>Hero</code> sınıfındaki metodu geçersiz kılması için bir metot adı ve parametre kodla.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"108\" endIndex=\"126\" isDefault=\"true\" /></interactions><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"Hero\" class=\"title\" /><text value=\" \" /><text value=\"{\" /><text type=\"break\" /><text value=\" takeDamage(amount) {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(amount + \" /><text value=\"&quot; damage taken&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"Mage\" class=\"title\" /><text value=\" \" /><text value=\"extends\" class=\"keyword\" /><text value=\" \" /><text value=\"Hero\" class=\"title\" /><text value=\" \" /><text value=\"{\" /><text type=\"break\" /><text value=\" takeDamage(amount) {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"if\" class=\"keyword\" /><text value=\" (amount &gt; \" /><text value=\"0\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\"   \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;magic shield reduces &quot;\" class=\"string\" /><text value=\" + amount + \" /><text value=\"&quot; damage&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"  }\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\"><code>takeDamage(amount)</code> ifadesini yazdığından emin ol.</p></body></html>"
