            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>Player</code> sınıfının üst sınıfı olan <code>GameObject</code>'in özelliklerini miras aldığından emin ol.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"Enemy\" /></content></option><option startIndex=\"107\" endIndex=\"112\" /><option startIndex=\"113\" endIndex=\"119\" /><option startIndex=\"120\" endIndex=\"127\" /><option startIndex=\"128\" endIndex=\"138\" /></options></interaction></interactions><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"GameObject\" class=\"title\" /><text value=\" \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"constructor\" class=\"keyword\" /><text value=\"(x, y) {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"this\" class=\"keyword\" /><text value=\".x = x;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"this\" class=\"keyword\" /><text value=\".y = y;\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"Enemy\" class=\"title\" /><text value=\" \" /><text value=\"extends\" class=\"keyword\" /><text value=\" \" /><text value=\"GameObject\" class=\"title\" /><text value=\" \" /><text value=\"{}\" /><text type=\"break\" /><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"Player\" class=\"title\" /><text value=\" \" /><text value=\"extends\" class=\"keyword\" /><text value=\" \" /><text value=\"GameObject\" class=\"title\" /><text value=\" \" /><text value=\"{}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" enemy1 = \" /><text value=\"new\" class=\"keyword\" /><text value=\" Enemy(\" /><text value=\"3\" class=\"number\" /><text va