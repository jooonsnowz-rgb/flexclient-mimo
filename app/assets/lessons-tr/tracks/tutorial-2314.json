            "interactiveContent": "<!DOCTYPE html ><html><body><p>Konsolda ne görüntülenir?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"print(type(\" /><text value=\"False\" class=\"literal\" /><text value=\"))\" /></content><output><content><text value=\"&lt;class 'bool'&gt;\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>&lt;class 'bool'&gt;</code></item><item value=\"2\" correct=\"false\"><code>&lt;class 'int'&gt;</code></item><item value=\"3\" correct=\"false\"><code>&lt;class 'str'&gt;</code></item></selection><p visible-if=\"wrong\"><code>&lt;class 'bool'&gt;</code>.</p></body></html>",
