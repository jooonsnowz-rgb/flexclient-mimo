            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Diğer öğelerin etrafına bir <code>&lt;div&gt;</code> öğesi eklediğimizde, skor etiketi etrafındaki HUD paneli gibi diğer kutuların etrafına daha büyük bir kutu koyarız.</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"33\" endIndex=\"38\" /><option startIndex=\"60\" endIndex=\"66\" /></options></interaction></interactions><content><text value=\"&lt;!doctype html&gt;\" class=\"meta\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"div\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"   \" /><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Score: 0\" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;/\" /><text value=\"div\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;/\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;/\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /></content></code><p visible-if=\"wrong\">Önce <code>&lt;div&gt;</code>, ardından <code>&lt;/div&gt;</code> öğelerini seçtiğinden emin ol.</p></body></html>"
