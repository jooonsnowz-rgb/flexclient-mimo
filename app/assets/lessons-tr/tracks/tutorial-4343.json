            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu kod konsolda ne görüntüler?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"let\" class=\"keyword\" /><text value=\" enemiesDefeated = \" /><text value=\"0\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" (enemiesDefeated &lt; \" /><text value=\"3\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\" enemiesDefeated++;\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(enemiesDefeated);\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>1</code> ile <code>3</code> arasındaki sayılar</item><item value=\"2\" correct=\"false\"><code>0</code> ile <code>3</code> arasındaki sayılar</item><item value=\"3\" correct=\"false\"><code>1</code>'den <code>4</code>'e kadar olan sayılar</item></selection><p visible-if=\"wrong\"><code>1</code> ile <code>3</code> arasındaki sayılar.</p></body></html>"
          },
