            "interactiveContent": "<!DOCTYPE html ><html><body><p>Sayaç değişkenini oluştur.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"var\" class=\"keyword\" /><text value=\" listNumber = \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" listNumber &lt; \" /><text value=\"11\" class=\"number\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;\\(listNumber). Camera&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\" listNumber += \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"3\" /><option startIndex=\"4\" endIndex=\"14\" /><option startIndex=\"15\" endIndex=\"16\" /><option startIndex=\"17\" endIndex=\"18\" /></options></interaction></interactions><output><content><text value=\"1. Camera\" /><text type=\"break\" /><text value=\"2. Camera\" /><text type=\"break\" /><text value=\"3. Camera\" /><text type=\"break\" /><text value=\"4. Camera\" /><text type=\"break\" /><text value=\"5. Camera\" /><text type=\"break\" /><text value=\"6. Camera\" /><text type=\"break\" /><text value=\"7. Camera\" /><text type=\"break\" /><text value=\"8. Camera\" /><text type=\"break\" /><text value=\"9. Camera\" /><text type=\"break\" /><text value=\"10. Camera\" /></content></output></code><p visible-if=\"wrong\">Önce <code>var</code>, ardından <code>listNumber</code> ve sonra <code>=</code>, <code>1</code> öğelerini seçtiğinden emin ol.</p></body></html>"
