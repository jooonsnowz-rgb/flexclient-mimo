            "id": 62187,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bu kod konsolda ne görüntüler?</p><code version=\"2\" name=\"script.js\" visible-if=\"always\" codelang=\"javascript\"><content><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"5\" class=\"number\" /><text value=\" + \" /><text value=\"13\" class=\"number\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"5\" class=\"number\" /><text value=\" === \" /><text value=\"13\" class=\"number\" /><text value=\");\" /></content><output><content><text value=\"18\" /><text type=\"break\" /><text value=\"false\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>18</code> ve ardından <code>false</code></item><item value=\"2\" correct=\"false\"><code>18</code> ve ardından <code>513</code></item></selection><p visible-if=\"wrong\"><code>18</code> ve ardından <code>false</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>İkinci satırda <code>===</code> yerine <code>+</code> yazıyorsun. İki satır şimdi ne gösterir?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"5\" class=\"number\" /><text value=\" + \" /><text value=\"13\" class=\"number\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"5\" class=\"number\" /><text value=\" === \" /><text value=\"13\" class=\"number\" /><text value=\");\" /></content><output><content><text value=\"18\" /><text type=\"break\" /><text value=\"false\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">18 ve ardından 18</item><item value=\"2\" correct=\"false\">18 ve ardından false</item><item value=\"3\" correct=\"false\">false ve ardından 18</item></selection><p visible-if=\"wrong\">18 ve ardından 18 öğesini seçtiğinden emin ol.</p></body></html>",
