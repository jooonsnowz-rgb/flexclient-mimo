            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Eşitlik karşılaştırma operatörünü ekle.</p><code version=\"2\" name=\"script.js\" visible-if=\"always\" codelang=\"javascript\"><content><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"99\" class=\"number\" /><text value=\" === \" /><text value=\"100\" class=\"number\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"15\" endIndex=\"18\" /><option correct=\"false\"><content><text value=\"=\" /></content></option></options></interaction></interactions><output><content><text value=\"false\" /></content></output></code><p visible-if=\"wrong\"><code>===</code> öğesini seçtiğinden emin ol.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Konsolun <code>99</code> ve <code>100</code> için <code>false</code> yazdırmasını sağlayacak şekilde karşılaştırmayı tamamla.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"99\" class=\"number\" /><text value=\" === \" /><text value=\"100\" class=\"number\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"15\" endIndex=\"18\" /><option correct=\"false\"><content><text value=\"=\" /></content></option><option correct=\"false\"><content><text value=\"==\" /></content></option><option correct=\"false\"><content><text value=\"!==\" /></content></option></options></interaction></interactions><output><content><text value=\"false\" /></content></output></code><p visible-if=\"wrong\"><code>===</code> öğesini seçtiğinden emin ol.</p></body></html>"
