          {
            "title": "Lesson #2",
            "id": 145519,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>isRunning</code><code>true</code> ise oyun döngüsünü çalıştıran, <code>isRunning</code><code>false</code> ise duraklatan bu mini oyun gibi.</p><webview version=\"2\" content=\"&lt;!doctype html&gt;&#xA;&lt;html lang=&quot;en&quot;&gt;&#xA;  &lt;head&gt;&#xA;    &lt;meta charset=&quot;UTF-8&quot; /&gt;&#xA;    &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot; /&gt;&#xA;    &lt;title&gt;Game State Toggle&lt;/title&gt;&#xA;    &lt;style&gt;&#xA;      * {&#xA;        margin: 0;&#xA;        padding: 0;&#xA;        box-sizing: border-box;&#xA;      }&#xA;      body {&#xA;        display: flex;&#xA;        flex-direction: column;&#xA;        align-items: center;&#xA;        justify-content: center;&#xA;        height: 100vh;&#xA;        background-color: #0b1020;&#xA;        color: #d7e1ff;&#xA;        font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;&#xA;        overflow: hidden;&#xA;      }&#xA;      .world {&#xA;        width: 360px;&#xA;        height: 220px;&#xA;        border: 2px solid rgba(215, 225, 255, 0.25);&#xA;        border-radius: 12px;&#xA;        position: relative;&#xA;        background: radial-gradient(circle at 50% 120%, rgba(90, 210, 255, 0.18), rgba(0, 0, 0, 0));&#xA;        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);&#xA;        margin-bottom: 18px;&#xA;      }&#xA;      .hud {&#xA;        position: absolute;&#xA;        top: 10px;&#xA;        left: 12px;&#xA;        right: 12px;&#xA;        display: flex;&#xA;        justify-content: space-between;&#xA;        font-size: 14px;&#xA;        opacity: 0.95;&#xA;      }&#xA;      .status {&#xA;        padding: 6px 10px;&#xA;        border-radius: 999px;&#xA;        background: rgba(215, 225, 255, 0.12);&#xA;        border: 1px solid rgba(215, 225, 255, 0.18);&#xA;      }&#xA;      .player {&#xA;        position: absolute;&#xA;        left: 40px;&#xA;        bottom: 36px;&#xA;        font-size: 44px;&#xA;        filter: drop-shadow(0 6px 10px rgba(0, 0, 0, 0.45));&#xA;        transition: transform 0.25s ease, opacity 0.25s ease;&#xA;      }&#xA;      .enemy {&#xA;        position: absolute;&#xA;        right: 52px;&#xA;        bottom: 36px;&#xA;        font-size: 44px;&#xA;        filter: drop-shadow(0 6px 10px rgba(0, 0, 0, 0.45));&#xA;        opacity: 0.25;&#xA;        transition: opacity 0.25s ease;&#xA;      }&#xA;      .pausedOverlay {&#xA;        position: absolute;&#xA;        inset: 0;&#xA;        display: flex;&#xA;        align-items: center;&#xA;        justify-content: center;&#xA;        font-weight: 700;&#xA;        letter-spacing: 0.06em;&#xA;        background: rgba(0, 0, 0, 0.45);&#xA;        opacity: 0;&#xA;        pointer-events: none;&#xA;        transition: opacity 0.25s ease;&#xA;        border-radius: 12px;&#xA;      }&#xA;      .running .enemy {&#xA;        opacity: 1;&#xA;      }&#xA;      .running .player {&#xA;        transform: translateX(10px);&#xA;      }&#xA;      .paused .pausedOverlay {&#xA;        opacity: 1;&#xA;      }&#xA;      button {&#xA;        appearance: none;&#xA;        border: 1px solid rgba(215, 225, 255, 0.25);&#xA;        background: rgba(215, 225, 255, 0.08);&#xA;        color: #d7e1ff;&#xA;        padding: 10px 14px;&#xA;        border-radius: 10px;&#xA;        cursor: pointer;&#xA;        transition: transform 0.08s ease, background 0.2s ease;&#xA;      }&#xA;      button:active {&#xA;        transform: translateY(1px);&#xA;        background: rgba(215, 225, 255, 0.14);&#xA;      }&#xA;    &lt;/style&gt;&#xA;  &lt;/head&gt;&#xA;  &lt;body&gt;&#xA;    &lt;div class=&quot;world paused&quot; id=&quot;world&quot;&gt;&#xA;      &lt;div class=&quot;hud&quot;&gt;&#xA;        &lt;div class=&quot;status&quot; id=&quot;stateLabel&quot;&gt;State: Paused&lt;/div&gt;&#xA;        &lt;div class=&quot;status&quot;&gt;Score: &lt;span id=&quot;score&quot;&gt;0&lt;/span&gt;&lt;/div&gt;&#xA;      &lt;/div&gt;&#xA;      &lt;div class=&quot;player&quot;&gt;🧙&lt;/div&gt;&#xA;      &lt;div class=&quot;enemy&quot;&gt;👾&lt;/div&gt;&#xA;      &lt;div class=&quot;pausedOverlay&quot;&gt;PAUSED&lt;/div&gt;&#xA;    &lt;/div&gt;&#xA;    &lt;button onclick=&quot;toggleGame()&quot;&gt;Toggle Pause / Run&lt;/button&gt;&#xA;&#xA;    &lt;script&gt;&#xA;      let isRunning = false;&#xA;      let score = 0;&#xA;      let loopId = null;&#xA;&#xA;      function updateUI() {&#xA;        const world = document.getElementById(&quot;world&quot;);&#xA;        const label = document.getElementById(&quot;stateLabel&quot;);&#xA;        world.classList.toggle(&quot;running&quot;, isRunning);&#xA;        world.classList.toggle(&quot;paused&quot;, !isRunning);&#xA;        label.textContent = isRunning ? &quot;State: Running&quot; : &quot;State: Paused&quot;;&#xA;        document.getElementById(&quot;score&quot;).textContent = String(score);&#xA;      }&#xA;&#xA;      function gameLoop() {&#xA;        score += 1;&#xA;        updateUI();&#xA;      }&#xA;&#xA;      function toggleGame() {&#xA;        isRunning = !isRunning;&#xA;        if (isRunning) {&#xA;          loopId = setInterval(gameLoop, 250);&#xA;        } else {&#xA;          clearInterval(loopId);&#xA;          loopId = null;&#xA;        }&#xA;        updateUI();&#xA;      }&#xA;&#xA;      updateUI();&#xA;    &lt;/script&gt;&#xA;  &lt;/body&gt;&#xA;&lt;/html&gt;&#xA;\" /></body></html>"
          },
          {
            "title": "Lesson #3",
            "id": 145520,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>if</code> ifadelerinin belirli bir <code>condition</code><code>true</code> olduğunda kod çalıştırmamıza yardımcı olduğunu zaten biliyoruz.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"4\" endIndex=\"13\" /><option startIndex=\"16\" endIndex=\"20\" /></options></interaction></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" condition = \" /><text value=\"true\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" (condition) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Player attacks!&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Önce <code>condition</code>, ardından <code>true</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "Lesson #4",
            "id": 145521,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>false</code> koşulunda farklı kod çalıştırmak için <code>!condition</code> kullanan başka bir <code>if</code> ifadesi ekleyelim.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"78\" endIndex=\"88\" isDefault=\"true\" /></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" condition = \" /><text value=\"true\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" (condition) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Player attacks!&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" (!condition) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Player blocks!&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\"><code>!condition</code> ifadesini yazdığından emin ol.</p></body></html>"
          },
          {
            "title": "Lesson #5",
            "id": 145522,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>İki <code>if</code> ifadesi oluşturmak yerine, aynı sonucu elde etmek için bir <code>if</code> / <code>else</code> ifadesi kullanırız.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"(\" /></content></option><option correct=\"false\"><content><text value=\")\" /></content></option><option startIndex=\"73\" endIndex=\"77\" /><option startIndex=\"78\" endIndex=\"79\" /><option startIndex=\"109\" endIndex=\"110\" /></options></interaction></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" condition = \" /><text value=\"false\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" (condition) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Critical hit!&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"} \" /><text value=\"else\" class=\"keyword\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Normal hit.&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Önce <code>else</code>, ardından <code>{</code> ve son olarak <code>}</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "Lesson #6",
            "id": 145523,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bir <code>if</code> / <code>else</code> ifadesindeki <code>else</code> ifadesi her zaman sona gelir.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"or\" /></content></option><option startIndex=\"73\" endIndex=\"77\" /><option startIndex=\"78\" endIndex=\"79\" /><option startIndex=\"116\" endIndex=\"117\" /></options></interaction></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" condition = \" /><text value=\"false\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" (condition) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Loot dropped!&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"} \" /><text value=\"else\" class=\"keyword\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;No loot this time.&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Önce <code>else</code>, ardından <code>{</code> ve son olarak <code>}</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "Lesson #7",
            "id": 145524,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bir kullanım alanına bakalım: <code>hasKey</code><code>true</code> ise kapıyı açmak istiyoruz.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"23\" endIndex=\"29\" /><option startIndex=\"30\" endIndex=\"33\" /><option startIndex=\"34\" endIndex=\"38\" /></options></interaction></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" hasKey = \" /><text value=\"true\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" (hasKey === \" /><text value=\"true\" class=\"literal\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Door opened!&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Önce <code>hasKey</code>, ardından <code>===</code> ve son olarak <code>true</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "Lesson #8",
            "id": 145525,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>hasKey</code><code>false</code> ise kapıyı kilitli tutmak için bir <code>else</code> ifadesi ekleyebiliriz.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"13\" endIndex=\"18\" isDefault=\"true\" /></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" hasKey = \" /><text value=\"false\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" (hasKey) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Door opened!&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"} \" /><text value=\"else\" class=\"keyword\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Door locked!&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\"><code>false</code> ifadesini yazdığından emin ol.</p></body></html>"
          },
          {
            "title": "Lesson #9",
            "id": 145526,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>else</code> ifadesinin kendi koşuluna ihtiyacı yoktur. Bunun nedeni, <code>if</code> koşulunun <code>false</code> olduğu durumları ele almasıdır.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"else if\" /></content></option><option startIndex=\"17\" endIndex=\"19\" /><option startIndex=\"20\" endIndex=\"34\" /><option startIndex=\"65\" endIndex=\"69\" /></options></interaction></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" health = \" /><text value=\"99\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" (health === \" /><text value=\"1\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Last HP!&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"} \" /><text value=\"else\" class=\"keyword\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Not at 1 HP&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Önce <code>if</code>, ardından <code>(health === 1)</code> ve son olarak <code>else</code> öğelerini seçtiğinden emin ol.</p></body></html>"
          },
          {
            "title": "Lesson #10",
            "id": 145527,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>else</code> ifadesi varsayılan bir yanıt gibidir. Burada, 1'e eşit olmayan tüm can değerleri için <code>\"Not at 1 HP\"</code> ifadesini görüntüler.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"&quot;Last HP!&quot;\" /></content></option><option startIndex=\"85\" endIndex=\"98\" /></options></interaction></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" health = \" /><text value=\"99\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" (health === \" /><text value=\"1\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Last HP!&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"} \" /><text value=\"else\" class=\"keyword\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Not at 1 HP&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\"><code>\"Not at 1 HP\"</code> öğesini seçtiğinden emin ol.</p></body></html>"
          },
