            "interactiveContent": "<!DOCTYPE html ><html><body><p>Değişkeni oluştur ve olumsuzlanmış değeri içine kaydet.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"25\" endIndex=\"30\" /><option startIndex=\"31\" endIndex=\"43\" /><option startIndex=\"46\" endIndex=\"57\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" doorIsOpen = \" /><text value=\"true\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" doorIsClosed = !doorIsOpen;\" /></content></code><p visible-if=\"wrong\">Önce <code>const</code>, ardından <code>doorIsClosed</code> ve son olarak <code>!doorIsOpen</code> öğelerini seçtiğinden emin ol.</p></body></html>"
