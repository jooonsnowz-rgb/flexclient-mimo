            "id": 52874,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Ulangi for loop dua kali dengan menentukan bahwa <code>i</code> harus kurang dari <code>length</code> array.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" friends = [\" /><text value=\"&quot;Anna&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Tim&quot;\" class=\"string\" /><text value=\"];\" /><text type=\"break\" /><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"0\" class=\"number\" /><text value=\"; i &lt; friends.length; i++) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(friends[i]);\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"49\" endIndex=\"52\" /><option correct=\"false\"><content><text value=\"i &gt;\" /></content></option></options></interaction></interactions><output><content><text value=\"Anna\" /><text type=\"break\" /><text value=\"Tim\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>i &lt;</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Ulangi for loop dua kali dengan menentukan bahwa <code>i</code> harus kurang dari <code>length</code> array.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" friends = [\" /><text value=\"&quot;Anna&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Tim&quot;\" class=\"string\" /><text value=\"];\" /><text type=\"break\" /><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"0\" class=\"number\" /><text value=\"; i &lt; friends.length; i++) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(friends[i]);\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"49\" endIndex=\"50\" /><option startIndex=\"51\" endIndex=\"52\" /><option startIndex=\"53\" endIndex=\"67\" /><option correct=\"false\"><content><text value=\"&gt;\" /></content></option><option correct=\"false\"><content><text value=\"&lt;=\" /></content></option><option correct=\"false\"><content><text value=\"friends\" /></content></option></options></interaction></interactions><output><content><text value=\"Anna\" /><text type=\"break\" /><text value=\"Tim\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>i</code>, diikuti oleh <code>&lt;</code>, dan terakhir <code>friends.length</code>.</p></body></html>"
