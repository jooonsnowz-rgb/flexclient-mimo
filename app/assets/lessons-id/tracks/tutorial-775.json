            "id": 53486,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Coba sendiri: hitung elemen dalam array <code>tasks</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" tasks = [\" /><text value=\"&quot;dishes&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;windows&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;vacuum&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;dusting&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;laundry&quot;\" class=\"string\" /><text value=\"];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(tasks.length);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"81\" endIndex=\"86\" /><option startIndex=\"86\" endIndex=\"87\" /><option startIndex=\"87\" endIndex=\"93\" /><option correct=\"false\"><content><text value=\"howMany\" /></content></option></options></interaction></interactions><output><content><text value=\"5\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>tasks</code>, diikuti oleh <code>.</code>, dan terakhir <code>length</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Simpan jumlah tugas dalam <code>howMany</code>, lalu cetak jumlah tersebut.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" \" /><text value=\"tasks\" /><text value=\" \" /><text value=\"=\" /><text value=\" \" /><text value=\"[\" /><text value=\"&quot;dishes&quot;\" class=\"string\" /><text value=\",\" /><text value=\" \" /><text value=\"&quot;windows&quot;\" class=\"string\" /><text value=\",\" /><text value=\" \" /><text value=\"&quot;vacuum&quot;\" class=\"string\" /><text value=\",\" /><text type=\"break\" /><text value=\" \" /><text value=\"&quot;dusting&quot;\" class=\"string\" /><text value=\",\" /><text value=\" \" /><text value=\"&quot;laundry&quot;\" class=\"string\" /><text value=\"]\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" \" /><text value=\"howMany\" /><text value=\" \" /><text value=\"=\" /><text value=\" \" /><text value=\"tasks\" /><text value=\".\" /><text value=\"length\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".\" /><text value=\"log\" /><text value=\"(\" /><text value=\"howMany\" /><text value=\")\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"86\" endIndex=\"91\" /><option startIndex=\"92\" endIndex=\"98\" /><option startIndex=\"112\" endIndex=\"119\" /><option correct=\"false\"><content><text value=\"size\" /></content></option><option correct=\"false\"><content><text value=\"tasks[0]\" /></content></option><option correct=\"false\"><content><text value=\"&quot;howMany&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"5\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>tasks</code>, diikuti oleh <code>length</code>, dan terakhir <code>howMany</code>.</p></body></html>",
            "hardModeSelected": true
