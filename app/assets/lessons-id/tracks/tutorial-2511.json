            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Periksa apakah <code>5</code> lebih besar dari <code>4</code>.</p><code name=\"main.swift\" version=\"2\" codelang=\"swift\"><content><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"5\" class=\"number\" /><text value=\" &gt; \" /><text value=\"4\" class=\"number\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"===\" /></content></option><option startIndex=\"6\" endIndex=\"7\" /><option startIndex=\"8\" endIndex=\"9\" /><option startIndex=\"10\" endIndex=\"11\" /></options></interaction></interactions><output><content><text value=\"true\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>5</code>, diikuti oleh <code>&gt;</code>, dan terakhir <code>4</code>.</p></body></html>"
