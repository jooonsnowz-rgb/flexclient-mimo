            "id": 89792,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang salah dengan kode ini?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"class\" class=\"keyword\" /><text value=\" :\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Class tersebut belum memiliki nama</item><item value=\"2\" correct=\"false\">Tidak ada yang salah dengan kode ini</item><item value=\"3\" correct=\"false\">Tidak ada <code>:</code></item></selection><p visible-if=\"wrong\">Class tersebut belum memiliki nama.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Header pengganti mana yang memberikan nama <code>Camera</code> dengan benar pada class ini?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"class\" class=\"keyword\" /><text value=\" :\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>class Camera:</code></item><item value=\"2\" correct=\"false\"><code>Camera class:</code></item><item value=\"3\" correct=\"false\"><code>class \"Camera\":</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>class Camera:</code>.</p></body></html>",
            "hardModeSelected": true
