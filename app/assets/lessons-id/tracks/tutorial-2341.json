            "id": 89793,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Untuk apa variabel di dalam class digunakan?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Untuk menyimpan data yang terkait dengan class yang diberikan</item><item value=\"2\" correct=\"false\">Untuk menyimpan angka</item><item value=\"3\" correct=\"false\">Digunakan di luar definisi class</item></selection><p visible-if=\"wrong\">Untuk menyimpan data yang terkait dengan class yang diberikan.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Variabel di dalam class menyimpan data yang terkait dengan class tersebut.</p><p>Baris mana di dalam <code>Camera</code> yang menyimpan nama model <code>\"EOS M6\"</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>model = \"EOS M6\"</code></item><item value=\"2\" correct=\"false\"><code>model == \"EOS M6\"</code></item><item value=\"3\" correct=\"false\"><code>\"model\" = \"EOS M6\"</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>model = \"EOS M6\"</code>.</p></body></html>",
            "hardModeSelected": true
