            "id": 89791,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bagaimana cara membuat definisi class?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Menggunakan keyword <code>class</code> diikuti nama dan titik dua</item><item value=\"2\" correct=\"false\">Menggunakan keyword <code>define class</code> yang diikuti nama</item><item value=\"3\" correct=\"false\">Menggunakan keyword <code>Class</code> diikuti nama</item></selection><p visible-if=\"wrong\">Menggunakan keyword <code>class</code> diikuti nama dan titik dua.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Definisi class diawali dengan <code>class</code>, lalu namanya dan tanda titik dua.</p><p>Header mana yang mengawali class bernama <code>Camera</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>class Camera:</code></item><item value=\"2\" correct=\"false\"><code>define class Camera:</code></item><item value=\"3\" correct=\"false\"><code>class Camera()</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>class Camera:</code>.</p></body></html>",
            "hardModeSelected": true
          },
