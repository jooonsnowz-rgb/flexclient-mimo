            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tampilkan variabel <code>name</code> dari instance class <code>cat</code> menggunakan pernyataan print.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"Virtual_Pet\" class=\"title\" /><text value=\":\" /><text type=\"break\" /><text value=\"  name = \" /><text value=\"&quot;Whiskers&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"  breed = \" /><text value=\"&quot;tabby&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"  is_trained = \" /><text value=\"True\" class=\"literal\" /><text type=\"break\" /><text type=\"break\" /><text value=\"cat = Virtual_Pet()\" /><text type=\"break\" /><text value=\"print(cat.name)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"98\" endIndex=\"103\" /><option startIndex=\"103\" endIndex=\"104\" /><option startIndex=\"104\" endIndex=\"107\" /><option startIndex=\"107\" endIndex=\"108\" /><option startIndex=\"108\" endIndex=\"112\" /><option startIndex=\"112\" endIndex=\"113\" /><option correct=\"false\"><content><text value=\"[\" /></content></option><option correct=\"false\"><content><text value=\"]\" /></content></option></options></interaction></interactions><output><content><text value=\"Whiskers\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>print</code>, diikuti oleh <code>(</code>, lalu <code>cat</code>, <code>.</code>, <code>name</code>, <code>)</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Tampilkan variabel <code>name</code> dari instance class <code>cat</code> menggunakan pernyataan print.</p><p>Buat kode mencetak <code>Whiskers</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"Virtual_Pet\" class=\"title\" /><text value=\":\" /><text type=\"break\" /><text value=\"  name = \" /><text value=\"&quot;Whiskers&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"  breed = \" /><text value=\"&quot;tabby&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"  is_trained = \" /><text value=\"True\" class=\"literal\" /><text type=\"break\" /><text type=\"break\" /><text value=\"cat = Virtual_Pet()\" /><text type=\"break\" /><text value=\"print(cat.name)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"98\" endIndex=\"103\" /><option startIndex=\"103\" endIndex=\"104\" /><option startIndex=\"104\" endIndex=\"107\" /><option startIndex=\"107\" endIndex=\"108\" /><option startIndex=\"108\" endIndex=\"112\" /><option startIndex=\"112\" endIndex=\"113\" /><option correct=\"false\"><content><text value=\"breed\" /></content></option><option correct=\"false\"><content><text value=\"[\" /></content></option><option correct=\"false\"><content><text value=\"]\" /></content></option></options></interaction></interactions><output><content><text value=\"Whiskers\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>print</code>, diikuti oleh <code>(</code>, <code>cat</code>, <code>.</code>, <code>name</code>, dan terakhir <code>)</code>.</p></body></html>",
