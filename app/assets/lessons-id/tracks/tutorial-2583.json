            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa fungsi operator <code>!</code> di Swift?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">Mengubah nilai Boolean <code>true</code> atau <code>false</code> menjadi kebalikannya</item><item correct=\"false\" value=\"2\">Ini memeriksa apakah nilainya sama</item></selection><p visible-if=\"wrong\">Mengubah nilai Boolean <code>true</code> atau <code>false</code> menjadi kebalikannya.</p></body></html>"
          },
