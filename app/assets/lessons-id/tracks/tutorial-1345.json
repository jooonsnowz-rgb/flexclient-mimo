            "interactiveContent": "<!DOCTYPE html ><html><body><p>Buat tuple untuk menyimpan fakta berikut tentang suhu beku dan suhu didih air.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"water_temperatures = (\" /><text value=\"0\" class=\"number\" /><text value=\", \" /><text value=\"100\" class=\"number\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"21\" endIndex=\"29\" /><option correct=\"false\"><content><text value=\"[0, 100]\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>(0, 100)</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Air membeku pada <code>0</code> dan mendidih pada <code>100</code>. Simpan fakta tetap ini dalam tuple agar tidak dapat diubah.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"water_temperatures = (\" /><text value=\"0\" class=\"number\" /><text value=\", \" /><text value=\"100\" class=\"number\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"21\" endIndex=\"29\" /><option correct=\"false\"><content><text value=\"[0, 100]\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>(0, 100)</code>.</p></body></html>"
