          {
            "title": "Example: Aliasing",
            "id": 129097,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pilih nilai <code>name</code> untuk game tertua dengan alias <code>oldest</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" oldest\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" = \" /><text value=\"1983\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"11\" /><option startIndex=\"12\" endIndex=\"14\" /><option startIndex=\"15\" endIndex=\"21\" /><option correct=\"false\"><content><text value=\"release\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"oldest\" /></row><row><data content=\"Mario Bros.\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>SELECT</code>, diikuti oleh <code>name</code>, lalu <code>AS</code>, <code>oldest</code>.</p></body></html>"
          },
          {
            "title": "Question: The inequality operator 2",
            "id": 91829,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Query mana yang memilih item saat properti <code>destination</code> bukan <code>'Rome'</code>?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" flights\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" destination = \" /><text value=\"'Rome'\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" flights\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" destination &lt;&gt; \" /><text value=\"'Rome'\" class=\"string\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Yang kedua, karena menggunakan operator ketidaksamaan  <code>&lt;&gt;</code></item><item value=\"2\" correct=\"false\">Yang pertama, karena menggunakan operator kesetaraan  <code>=</code></item><item value=\"3\" correct=\"false\">Keduanya</item></selection><p visible-if=\"wrong\">Yang kedua, karena menggunakan operator ketidaksamaan  <code>&lt;&gt;</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Dalam SQL, <code>&lt;&gt;</code> memeriksa bahwa dua value berbeda.</p><p>Tujuan penerbangan adalah <code>'Paris'</code>. Query mana yang menyertakan penerbangan itu?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" flights\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" destination = \" /><text value=\"'Rome'\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" flights\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" destination &lt;&gt; \" /><text value=\"'Rome'\" class=\"string\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Hanya query kedua.</item><item value=\"2\" correct=\"false\">Hanya query pertama.</item><item value=\"3\" correct=\"false\">Kedua query.</item><item value=\"4\" correct=\"false\">Tidak satu pun query.</item></selection><p visible-if=\"wrong\">Hanya query kedua.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example: The inequality operator 2",
            "id": 91827,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Buat kode kondisi untuk memilih semua item <code>flights</code> yang nilai <code>daily</code>-nya bukan <code>1</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE flights (&#xA;destination varchar(255),&#xA;daily int&#xA;);&#xA;&#xA;INSERT INTO flights (destination, daily)&#xA;VALUES ('New York', 1);&#xA;INSERT INTO flights (destination, daily)&#xA;VALUES ('Paris', 3);&#xA;INSERT INTO flights (destination, daily)&#xA;VALUES ('Hong Kong', 1);&#xA;INSERT INTO flights (destination, daily)&#xA;VALUES ('Rome', 3);\"><tables><table name=\"flights\"><row><header content=\"destination\" /><header content=\"daily\" /></row><row><data content=\"New York\" /><data content=\"1\" /></row><row><data content=\"Paris\" /><data content=\"3\" /></row><row><data content=\"Hong Kong\" /><data content=\"1\" /></row><row><data content=\"Rome\" /><data content=\"3\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" flights\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" daily &lt;&gt; \" /><text value=\"1\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"28\" endIndex=\"38\" /></interactions><output><table name=\"Result\"><row><header content=\"destination\" /><header content=\"daily\" /></row><row><data content=\"Paris\" /><data content=\"3\" /></row><row><data content=\"Rome\" /><data content=\"3\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>daily &lt;&gt; 1</code>.</p></body></html>"
          },
          {
            "title": "Example: AS",
            "id": 129098,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pilih <code>name</code> game terbaru dengan alias menggunakan <code>SELECT name</code>, <code>AS</code>, dan alias <code>newest</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" newest\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" = \" /><text value=\"2013\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"0\" endIndex=\"21\" /></interactions><output><table name=\"Result\"><row><header content=\"newest\" /></row><row><data content=\"Super Mario 3D World\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>SELECT name AS newest</code>.</p></body></html>"
          },
          {
            "title": "Question: Only within the query",
            "id": 129096,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa nama kolom <code>name</code> pada tabel <em>original</em> setelah menjalankan kueri ini?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" newest\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" = \" /><text value=\"2013\" class=\"number\" /><text value=\";\" /></content><output><table name=\"Result\"><row><data content=\"No result!\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>name</code>, karena alias tidak mengubah tabel asli</item><item value=\"2\" correct=\"false\"><code>newest</code>, karena kita membuat alias untuknya</item><item value=\"3\" correct=\"false\"><code>name</code>, karena kata kunci <code>AS</code> tidak ada</item></selection><p visible-if=\"wrong\"><code>name</code>, karena alias tidak mengubah tabel asli.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Alias mengubah label kolom yang dikembalikan, bukan tabel asli.</p><p>Kamu menghapus <code>AS newest</code>. Sekarang apa nama kolom hasil dan kolom tabel asli?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" newest\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" = \" /><text value=\"2013\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Keduanya bernama name.</item><item value=\"2\" correct=\"false\">Keduanya bernama newest.</item><item value=\"3\" correct=\"false\">Hasil memakai name, tabel memakai newest.</item><item value=\"4\" correct=\"false\">Hasil memakai newest, tabel memakai name.</item></selection><p visible-if=\"wrong\">Keduanya bernama name.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example: As many as we want",
            "id": 129099,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Ketik koma <code>,</code>, lalu pilih kolom <code>release</code> juga.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" newest, \" /><text value=\"release\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" = \" /><text value=\"2013\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"21\" endIndex=\"30\" /></interactions><output><table name=\"Result\"><row><header content=\"newest\" /><header content=\"release\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>, release</code>.</p></body></html>"
          },
          {
            "title": "Example: As many as we want 2",
            "id": 129100,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pilih kolom <code>release</code> dan ganti namanya menjadi <code>year</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" newest, \" /><text value=\"release\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" = \" /><text value=\"2013\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"23\" endIndex=\"30\" /><option startIndex=\"31\" endIndex=\"33\" /><option startIndex=\"34\" endIndex=\"38\" /><option correct=\"false\"><content><text value=\"release_year\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"newest\" /><header content=\"year\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>release</code>, diikuti oleh <code>AS</code>, dan terakhir <code>year</code>.</p></body></html>"
          },
          {
            "title": "Question: Inequality with text values",
            "id": 91828,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang salah dengan query ini?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" daily\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" flights\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" destination &lt;&gt; \" /><text value=\"'Paris'\" class=\"string\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Tidak ada yang salah dengan query tersebut</item><item value=\"2\" correct=\"false\">Kita tidak bisa menggunakan <code>&lt;&gt;</code> dengan nilai teks seperti <code>'Paris'</code></item><item value=\"3\" correct=\"false\">Kita selalu harus memilih semua kolom dengan <code>*</code></item></selection><p visible-if=\"wrong\">Tidak ada yang salah dengan query tersebut.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Satu penerbangan menuju <code>'Paris'</code> dengan <code>daily = 2</code>, satu lagi menuju <code>'Rome'</code> dengan <code>daily = 3</code>.</p><p>Apa yang dikembalikan query ini dari kedua row tersebut?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" daily\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" flights\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" destination &lt;&gt; \" /><text value=\"'Paris'\" class=\"string\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Hanya value daily 3.</item><item value=\"2\" correct=\"false\">Hanya tujuan Rome.</item><item value=\"3\" correct=\"false\">Value daily 2 dan 3.</item><item value=\"4\" correct=\"false\">Hanya value daily 2.</item></selection><p visible-if=\"wrong\">Hanya value daily 3.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Inequality with text values",
            "id": 91833,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tulis <code>WHERE</code> dan kondisi yang memeriksa apakah properti <code>destination</code> tidak sama dengan <code>'Paris'</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE flights (&#xA;destination varchar(255),&#xA;daily int&#xA;);&#xA;&#xA;INSERT INTO flights (destination, daily)&#xA;VALUES ('New York', 1);&#xA;INSERT INTO flights (destination, daily)&#xA;VALUES ('Paris', 3);&#xA;INSERT INTO flights (destination, daily)&#xA;VALUES ('Hong Kong', 1);&#xA;INSERT INTO flights (destination, daily)&#xA;VALUES ('Rome', 3);\"><tables><table name=\"flights\"><row><header content=\"destination\" /><header content=\"daily\" /></row><row><data content=\"New York\" /><data content=\"1\" /></row><row><data content=\"Paris\" /><data content=\"3\" /></row><row><data content=\"Hong Kong\" /><data content=\"1\" /></row><row><data content=\"Rome\" /><data content=\"3\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" flights\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" destination &lt;&gt; \" /><text value=\"'Paris'\" class=\"string\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"22\" endIndex=\"50\" /></interactions><output><table name=\"Result\"><row><header content=\"destination\" /><header content=\"daily\" /></row><row><data content=\"New York\" /><data content=\"1\" /></row><row><data content=\"Hong Kong\" /><data content=\"1\" /></row><row><data content=\"Rome\" /><data content=\"3\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>WHERE destination &lt;&gt; 'Paris'</code>.</p></body></html>"
          },
          {
            "title": "Question: Greater than operator",
            "id": 91838,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Query mana yang memilih item dengan <code>games_won</code> lebih besar dari <code>1000</code>?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" chess_players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" games_won &lt; \" /><text value=\"1000\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" chess_players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" games_won &gt; \" /><text value=\"1000\" class=\"number\" /><text value=\";\" /><text type=\"break\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Yang kedua</item><item value=\"2\" correct=\"false\">Yang pertama</item><item value=\"3\" correct=\"false\">Keduanya</item></selection><p visible-if=\"wrong\">Yang kedua.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Dalam SQL, <code>&lt;</code> berarti kurang dari dan <code>&gt;</code> berarti lebih dari.</p><p>Seorang pemain memiliki tepat <code>1000</code> kemenangan. Query mana yang mengembalikan pemain itu?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" chess_players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" games_won &lt; \" /><text value=\"1000\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" chess_players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" games_won &gt; \" /><text value=\"1000\" class=\"number\" /><text value=\";\" /><text type=\"break\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Tidak satu pun query.</item><item value=\"2\" correct=\"false\">Hanya query pertama.</item><item value=\"3\" correct=\"false\">Hanya query kedua.</item><item value=\"4\" correct=\"false\">Kedua query.</item></selection><p visible-if=\"wrong\">Tidak satu pun query.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example: Less than operator",
            "id": 91836,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tuliskan <code>WHERE</code>, diikuti kondisi yang memeriksa apakah <code>games_won</code> kurang dari <code>1000</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE chess_players (&#xA;name varchar(255),&#xA;games_won int&#xA;);&#xA;&#xA;INSERT INTO chess_players (name, games_won)&#xA;VALUES ('Carlsen', 1162);&#xA;INSERT INTO chess_players (name, games_won)&#xA;VALUES ('Kasparov', 1370);&#xA;INSERT INTO chess_players (name, games_won)&#xA;VALUES ('Polgár', 692);&#xA;INSERT INTO chess_players (name, games_won)&#xA;VALUES ('Fischer', 546);\"><tables><table name=\"chess_players\"><row><header content=\"name\" /><header content=\"games_won\" /></row><row><data content=\"Carlsen\" /><data content=\"1162\" /></row><row><data content=\"Kasparov\" /><data content=\"1370\" /></row><row><data content=\"Polgár\" /><data content=\"692\" /></row><row><data content=\"Fischer\" /><data content=\"546\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" chess_players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" games_won &lt; \" /><text value=\"1000\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"28\" endIndex=\"50\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"games_won\" /></row><row><data content=\"Polgár\" /><data content=\"692\" /></row><row><data content=\"Fischer\" /><data content=\"546\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>WHERE games_won &lt; 1000</code>.</p></body></html>"
          },
          {
            "title": "Question: The <= operator",
            "id": 91835,
