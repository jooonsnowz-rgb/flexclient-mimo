            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kodekan tinggi sprite dengan <code>height=\"100\"</code>.</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><interactions><interaction type=\"validatedInput\" startIndex=\"51\" endIndex=\"63\" isDefault=\"true\" /></interactions><content><text value=\"&lt;\" /><text value=\"img\" class=\"name\" /><text value=\" \" /><text value=\"src\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;https://mimo.app/i/star.png&quot;\" class=\"string\" /><text value=\" \" /><text value=\"width\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;100&quot;\" class=\"string\" /><text value=\" \" /><text value=\"height\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;100&quot;\" class=\"string\" /><text value=\"&gt;\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>height=\"100\"</code>.</p></body></html>"
