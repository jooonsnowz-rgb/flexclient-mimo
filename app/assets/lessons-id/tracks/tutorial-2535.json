            "interactiveContent": "<!DOCTYPE html ><html><body><p>Mengodekan keyword untuk pernyataan <code>else if</code>.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" email = \" /><text value=\"&quot;lori@mail.com&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" email == \" /><text value=\"&quot;lori@mail.com&quot;\" class=\"string\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Welcome, Lori.&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"} \" /><text value=\"else\" class=\"keyword\" /><text value=\" \" /><text value=\"if\" class=\"keyword\" /><text value=\" email == \" /><text value=\"&quot;brad@mail.com&quot;\" class=\"string\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Hello, Brad...&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"85\" endIndex=\"92\" /></interactions><output><content><text value=\"Welcome, Lori.\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>else if</code>.</p></body></html>"
