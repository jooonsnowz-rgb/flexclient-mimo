            "id": 126819,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pilih nilai untuk <code>madMeter</code> agar blok <code>else</code> dijalankan.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" madMeter = \" /><text value=\"79\" class=\"number\" /><text type=\"break\" /><text value=\"let\" class=\"keyword\" /><text value=\" madScientist = \" /><text value=\"&quot;Dexter&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" madMeter &gt;= \" /><text value=\"134\" class=\"number\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Madness achieved!&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"} \" /><text value=\"else\" class=\"keyword\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Sorry&quot;\" class=\"string\" /><text value=\" + madScientist + \" /><text value=\"&quot;not mad enough&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"15\" endIndex=\"17\" /><option correct=\"false\"><content><text value=\"134\" /></content></option><option correct=\"false\"><content><text value=\"200\" /></content></option></options></interaction></interactions><output><content><text value=\"Sorry, Dexter, not mad enough\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>79</code>.</p></body></html>"
