            "interactiveContent": "<!DOCTYPE html ><html><body><p>Menuliskan bagian awal pernyataan if.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"if\" class=\"keyword\" /><text value=\" \" /><text value=\"true\" class=\"literal\" /><text value=\" {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Log out&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"0\" endIndex=\"2\" /></interactions><output><content><text value=\"Log out\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>if</code>.</p></body></html>"
