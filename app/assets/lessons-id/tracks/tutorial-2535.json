            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang terjadi ketika <code>commonFriends</code> memiliki nilai kurang dari 3?</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" commonFriends = ?\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" commonFriends &gt;= \" /><text value=\"3\" class=\"number\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Friend suggestions: Sue&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"} \" /><text value=\"else\" class=\"keyword\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;No new suggestions&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Blok kode pada klausa <code>else</code> dijalankan</item><item value=\"2\" correct=\"false\">Blok kode klausa <code>if</code> dijalankan</item><item value=\"3\" correct=\"false\">Baik blok kode <code>if</code> maupun blok kode klausa <code>else</code> tidak dijalankan</item></selection><p visible-if=\"wrong\">Blok kode pada klausa <code>else</code> dijalankan.</p></body></html>"
          },
