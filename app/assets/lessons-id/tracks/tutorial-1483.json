            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Operasi apa yang memilih nilai terbesar dalam kolom?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>MAX</code></item><item value=\"2\" correct=\"false\"><code>MIN</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>MAX</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Untuk menemukan skor tertinggi yang disimpan dalam satu kolom, fungsi agregat mana yang harus digunakan dalam query?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>MAX</code></item><item value=\"2\" correct=\"false\"><code>MIN</code></item><item value=\"3\" correct=\"false\"><code>AVG</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>MAX</code>.</p></body></html>"
          },
          {
            "title": "Example: MIN",
            "id": 96920,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pilih nilai <code>km</code> terkecil.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE running_distance (&#xA; user varchar(255),&#xA; km numeric(3,2)&#xA;);&#xA;&#xA;INSERT INTO running_distance (user, km)&#xA;VALUES ('andy', 5);&#xA;&#xA;INSERT INTO running_distance (user, km)&#xA;VALUES ('jen', 10.2);&#xA;&#xA;INSERT INTO running_distance (user, km)&#xA;VALUES ('mae', 8.7);&#xA;&#xA;\"><tables><table name=\"running_distance\"><row><header content=\"user\" /><header content=\"km\" /></row><row><data content=\"andy\" /><data content=\"5\" /></row><row><data content=\"jen\" /><data content=\"10.2\" /></row><row><data content=\"mae\" /><data content=\"8.7\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"MIN\" class=\"keyword\" /><text value=\"(km)\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" running_distance;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"10\" /><option startIndex=\"10\" endIndex=\"11\" /><option startIndex=\"11\" endIndex=\"13\" /><option startIndex=\"13\" endIndex=\"14\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"MIN(km)\" /></row><row><data content=\"5\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>SELECT</code>, diikuti oleh <code>MIN</code>, lalu <code>(</code>, <code>km</code>, <code>)</code>.</p></body></html>"
          },
          {
            "title": "Example: MAX",
            "id": 96922,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pilih nilai <code>km</code> terbesar dengan <code>SELECT</code> lalu <code>MAX(km)</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE running_distance (&#xA; user varchar(255),&#xA; km numeric(3,2)&#xA;);&#xA;&#xA;INSERT INTO running_distance (user, km)&#xA;VALUES ('andy', 5);&#xA;&#xA;INSERT INTO running_distance (user, km)&#xA;VALUES ('jen', 10.2);&#xA;&#xA;INSERT INTO running_distance (user, km)&#xA;VALUES ('mae', 8.7);&#xA;&#xA;\"><tables><table name=\"running_distance\"><row><header content=\"user\" /><header content=\"km\" /></row><row><data content=\"andy\" /><data content=\"5\" /></row><row><data content=\"jen\" /><data content=\"10.2\" /></row><row><data content=\"mae\" /><data content=\"8.7\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"MAX\" class=\"keyword\" /><text value=\"(km)\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" running_distance;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"0\" endIndex=\"14\" /></interactions><output><table name=\"Result\"><row><header content=\"MAX(km)\" /></row><row><data content=\"10.2\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>SELECT MAX(km)</code>.</p></body></html>"
          }
