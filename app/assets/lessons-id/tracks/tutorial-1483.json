        "type": "practiceLevel1",
        "lessons": [
          {
            "title": "Result of an operation",
            "id": 96476,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Di tabel hasil, kamu akan melihat bahwa kolom yang dipilih bukan lagi <code>price</code>, melainkan <code>MAX(price)</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE ticket (&#xA; museum varchar(255),&#xA; price numeric(2,1)&#xA;);&#xA;&#xA;INSERT INTO ticket (museum, price)&#xA;VALUES ('Louvre', 17);&#xA;&#xA;INSERT INTO ticket (museum, price)&#xA;VALUES ('Petit Palais', 0);&#xA;&#xA;INSERT INTO ticket (museum, price)&#xA;VALUES ('Centre Pompidou', 14);&#xA;&#xA;INSERT INTO ticket (museum, price)&#xA;VALUES ('Musée Rodin', 9);&#xA;&#xA;&#xA;&#xA;&#xA;\"><tables><table name=\"ticket\"><row><header content=\"museum\" /><header content=\"price\" /></row><row><data content=\"Louvre\" /><data content=\"17\" /></row><row><data content=\"Petit Palais\" /><data content=\"0\" /></row><row><data content=\"Centre Pompidou\" /><data content=\"14\" /></row><row><data content=\"Musée Rodin\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"MAX\" class=\"keyword\" /><text value=\"(price)\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" ticket;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"10\" /><option startIndex=\"10\" endIndex=\"11\" /><option startIndex=\"11\" endIndex=\"16\" /><option startIndex=\"16\" endIndex=\"17\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"MAX(price)\" /></row><row><data content=\"17\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>SELECT</code>, diikuti oleh <code>MAX</code>, lalu <code>(</code>, <code>price</code>, <code>)</code>.</p></body></html>"
          },
          {
            "title": "Result of an operation 2",
            "id": 96480,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Itu karena kita sebenarnya memilih hasil dari sebuah operasi. Anggap saja itu sebagai operasi matematika.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE ticket (&#xA; museum varchar(255),&#xA; price numeric(2,1)&#xA;);&#xA;&#xA;INSERT INTO ticket (museum, price)&#xA;VALUES ('Louvre', 17);&#xA;&#xA;INSERT INTO ticket (museum, price)&#xA;VALUES ('Petit Palais', 0);&#xA;&#xA;INSERT INTO ticket (museum, price)&#xA;VALUES ('Centre Pompidou', 14);&#xA;&#xA;INSERT INTO ticket (museum, price)&#xA;VALUES ('Musée Rodin', 9);&#xA;&#xA;&#xA;&#xA;&#xA;\"><tables><table name=\"ticket\"><row><header content=\"museum\" /><header content=\"price\" /></row><row><data content=\"Louvre\" /><data content=\"17\" /></row><row><data content=\"Petit Palais\" /><data content=\"0\" /></row><row><data content=\"Centre Pompidou\" /><data content=\"14\" /></row><row><data content=\"Musée Rodin\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"MAX\" class=\"keyword\" /><text value=\"(price)\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" ticket;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"17\" /><option startIndex=\"18\" endIndex=\"29\" /><option startIndex=\"29\" endIndex=\"30\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"MAX(price)\" /></row><row><data content=\"17\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>SELECT MAX(price)</code>, diikuti oleh <code>FROM ticket</code>, dan terakhir <code>;</code>.</p></body></html>"
          },
          {
            "title": "Aggregate functions",
            "id": 96481,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Operasi seperti <code>MIN</code> dan <code>MAX</code> disebut <strong>fungsi agregat</strong> karena mengembalikan satu hasil.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE ticket (&#xA; museum varchar(255),&#xA; price numeric(2,1)&#xA;);&#xA;&#xA;INSERT INTO ticket (museum, price)&#xA;VALUES ('Louvre', 17);&#xA;&#xA;INSERT INTO ticket (museum, price)&#xA;VALUES ('Petit Palais', 0);&#xA;&#xA;INSERT INTO ticket (museum, price)&#xA;VALUES ('Centre Pompidou', 14);&#xA;&#xA;INSERT INTO ticket (museum, price)&#xA;VALUES ('Musée Rodin', 9);&#xA;&#xA;&#xA;&#xA;&#xA;\"><tables><table name=\"ticket\"><row><header content=\"museum\" /><header content=\"price\" /></row><row><data content=\"Louvre\" /><data content=\"17\" /></row><row><data content=\"Petit Palais\" /><data content=\"0\" /></row><row><data content=\"Centre Pompidou\" /><data content=\"14\" /></row><row><data content=\"Musée Rodin\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"MIN\" class=\"keyword\" /><text value=\"(price)\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" ticket;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"7\" endIndex=\"17\" /><option correct=\"false\"><content><text value=\"price\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"MIN(price)\" /></row><row><data content=\"0\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>MIN(price)</code>.</p></body></html>"
          },
          {
            "title": "Aliasing",
            "id": 96482,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kita dapat menggunakan alias untuk mengganti nama hasilnya. Di sini, kita mengganti nama <code>MIN(price)</code> menjadi <code>cheapest</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE ticket (&#xA; museum varchar(255),&#xA; price numeric(2,1)&#xA;);&#xA;&#xA;INSERT INTO ticket (museum, price)&#xA;VALUES ('Louvre', 17);&#xA;&#xA;INSERT INTO ticket (museum, price)&#xA;VALUES ('Petit Palais', 0);&#xA;&#xA;INSERT INTO ticket (museum, price)&#xA;VALUES ('Centre Pompidou', 14);&#xA;&#xA;INSERT INTO ticket (museum, price)&#xA;VALUES ('Musée Rodin', 9);&#xA;&#xA;&#xA;&#xA;&#xA;\"><tables><table name=\"ticket\"><row><header content=\"museum\" /><header content=\"price\" /></row><row><data content=\"Louvre\" /><data content=\"17\" /></row><row><data content=\"Petit Palais\" /><data content=\"0\" /></row><row><data content=\"Centre Pompidou\" /><data content=\"14\" /></row><row><data content=\"Musée Rodin\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"MIN\" class=\"keyword\" /><text value=\"(price) \" /><text value=\"AS\" class=\"keyword\" /><text value=\" cheapest\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" ticket;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"18\" endIndex=\"20\" /><option startIndex=\"21\" endIndex=\"29\" /><option correct=\"false\"><content><text value=\"most_expensive\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"cheapest\" /></row><row><data content=\"0\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>AS</code>, diikuti oleh <code>cheapest</code>.</p></body></html>"
          },
          {
            "title": "Question: Result of an operation 2",
            "id": 96924,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Nama kolom apa yang akan ada di tabel hasil setelah menjalankan query ini?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE running_distance (&#xA; user varchar(255),&#xA; km numeric(3,2)&#xA;);&#xA;&#xA;INSERT INTO running_distance (user, km)&#xA;VALUES ('andy', 5);&#xA;&#xA;INSERT INTO running_distance (user, km)&#xA;VALUES ('jen', 10.2);&#xA;&#xA;INSERT INTO running_distance (user, km)&#xA;VALUES ('mae', 8.7);&#xA;&#xA;\"><tables><table name=\"running_distance\"><row><header content=\"user\" /><header content=\"km\" /></row><row><data content=\"andy\" /><data content=\"5\" /></row><row><data content=\"jen\" /><data content=\"10.2\" /></row><row><data content=\"mae\" /><data content=\"8.7\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"MIN\" class=\"keyword\" /><text value=\"(km)\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" running_distance;\" /></content><output><table name=\"Result\"><row><header content=\"MIN(km)\" /></row><row><data content=\"5\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>MIN(km)</code> karena kita memilih hasil dari sebuah operasi, bukan kolom</item><item value=\"2\" correct=\"false\"><code>km</code> karena kita sedang memilih kolom</item></selection><p visible-if=\"wrong\"><code>MIN(km)</code> karena kita memilih hasil dari sebuah operasi, bukan kolom.</p></body></html>"
          },
          {
            "title": "Question: Aggregate functions",
            "id": 96925,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang diberikan fungsi agregat seperti <code>MIN</code> dan <code>MAX</code> kepada kita?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Satu nilai, hasil dari suatu operasi</item><item value=\"2\" correct=\"false\">Semua nilai dalam sebuah kolom</item></selection><p visible-if=\"wrong\">Satu nilai, hasil dari suatu operasi.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Setelah menggunakan <code>MIN</code> atau <code>MAX</code> pada sebuah kolom, apa yang dikembalikan query tersebut?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Satu nilai yang dihasilkan dari nilai-nilai dalam kolom tersebut</item><item value=\"2\" correct=\"false\">Setiap nilai dalam kolom tersebut</item><item value=\"3\" correct=\"false\">Kolom baru dengan nilai-nilai yang sudah diurutkan</item></selection><p visible-if=\"wrong\">Satu nilai yang dihasilkan dari nilai-nilai dalam kolom tersebut.</p></body></html>"
          },
          {
