            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Untuk mendapatkan item yang tidak memenuhi kondisi, kita menuliskan <code>NOT</code> di antara nama kolom dan operator kondisi.<br /></p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; year int,&#xA; major varchar(255)&#xA;);&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Ava Smith', 1, 'Biology');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Luis Garcia', 1, 'Physics');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Lin Wong', 3, 'Biology');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Sam Mitchell', 2, 'History');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Nora Hansen', 4, 'Biology');\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row><row><data content=\"Sam Mitchell\" /><data content=\"2\" /><data content=\"History\" /></row><row><data content=\"Nora Hansen\" /><data content=\"4\" /><data content=\"Biology\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"NOT\" class=\"keyword\" /><text value=\" \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'a%'\" class=\"string\" /><text value=\" ;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"34\" endIndex=\"37\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row><row><data content=\"Sam Mitchell\" /><data content=\"2\" /><data content=\"History\" /></row><row><data content=\"Nora Hansen\" /><data content=\"4\" /><data content=\"Biology\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>NOT</code>.</p></body></html>"
          },
          {
            "title": "NOT LIKE",
            "id": 94558,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kita terutama menggunakan <code>NOT</code> dengan kondisi seperti <code>IN</code>, <code>BETWEEN</code>, dan <code>LIKE</code>. Di sini, kita mendapatkan item dengan <code>name</code> yang tidak mengandung <code>a</code>.<br /></p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; year int,&#xA; major varchar(255)&#xA;);&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Ava Smith', 1, 'Biology');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Luis Garcia', 1, 'Physics');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Lin Wong', 3, 'Biology');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Sam Mitchell', 2, 'History');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Nora Hansen', 4, 'Biology');\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row><row><data content=\"Sam Mitchell\" /><data content=\"2\" /><data content=\"History\" /></row><row><data content=\"Nora Hansen\" /><data content=\"4\" /><data content=\"Biology\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"NOT\" class=\"keyword\" /><text value=\" \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'%a%'\" class=\"string\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"34\" endIndex=\"42\" /><option correct=\"false\"><content><text value=\"BETWEEN\" /></content></option><option startIndex=\"43\" endIndex=\"48\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>NOT LIKE</code>, diikuti oleh <code>'%a%'</code>.</p></body></html>"
          },
          {
            "title": "NOT IN",
            "id": 94559,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Menuliskan <code>NOT IN ('History', 'Physics')</code> memberi kita semua item dengan <code>major</code> selain <code>'History'</code> atau <code>'Physics'</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; year int,&#xA; major varchar(255)&#xA;);&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Ava Smith', 1, 'Biology');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Luis Garcia', 1, 'Physics');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Lin Wong', 3, 'Biology');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Sam Mitchell', 2, 'History');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Nora Hansen', 4, 'Biology');\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row><row><data content=\"Sam Mitchell\" /><data content=\"2\" /><data content=\"History\" /></row><row><data content=\"Nora Hansen\" /><data content=\"4\" /><data content=\"Biology\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" major \" /><text value=\"NOT\" class=\"keyword\" /><text value=\" \" /><text value=\"IN\" class=\"keyword\" /><text value=\" (\" /><text value=\"'History'\" class=\"string\" /><text value=\", \" /><text value=\"'Physics'\" class=\"string\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"35\" endIndex=\"41\" /><option startIndex=\"42\" endIndex=\"64\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row><row><data content=\"Nora Hansen\" /><data content=\"4\" /><data content=\"Biology\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>NOT IN</code>, diikuti oleh <code>('History', 'Physics')</code>.</p></body></html>"
          },
          {
            "title": "NOT BETWEEN",
            "id": 94560,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Membuat kode <code>NOT BETWEEN 1 AND 3</code> memberi kita item dengan <code>year</code> kurang dari <code>1</code> atau lebih dari <code>3</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; year int,&#xA; major varchar(255)&#xA;);&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Ava Smith', 1, 'Biology');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Luis Garcia', 1, 'Physics');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Lin Wong', 3, 'Biology');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Sam Mitchell', 2, 'History');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Nora Hansen', 4, 'Biology');\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row><row><data content=\"Sam Mitchell\" /><data content=\"2\" /><data content=\"History\" /></row><row><data content=\"Nora Hansen\" /><data content=\"4\" /><data content=\"Biology\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" \" /><text value=\"NOT\" class=\"keyword\" /><text value=\" \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"1\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"3\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"34\" endIndex=\"37\" /><option startIndex=\"38\" endIndex=\"45\" /><option startIndex=\"46\" endIndex=\"47\" /><option startIndex=\"48\" endIndex=\"51\" /><option startIndex=\"52\" endIndex=\"53\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Nora Hansen\" /><data content=\"4\" /><data content=\"Biology\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>NOT</code>, diikuti oleh <code>BETWEEN</code>, lalu <code>1</code>, <code>AND</code>, <code>3</code>.</p></body></html>"
