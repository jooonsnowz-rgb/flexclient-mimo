          {
            "title": "Question: Intro",
            "id": 96009,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kapan kita menggunakan kata kunci <code>NOT</code> dalam klausa <code>WHERE</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Ketika kita ingin memilih item yang tidak memenuhi suatu kondisi</item><item value=\"2\" correct=\"false\">Saat kita ingin memilih item yang memenuhi suatu kondisi</item></selection><p visible-if=\"wrong\">Ketika kita ingin memilih item yang tidak memenuhi suatu kondisi.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Filter kamu memakai <code>NOT</code> untuk membalik <code>year = 1970</code>. Kamu memiliki item dari <code>1970</code> dan <code>1980</code>.</p><p>Item mana yang tersisa?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Hanya item dari tahun 1980</item><item value=\"2\" correct=\"false\">Hanya item dari tahun 1970</item><item value=\"3\" correct=\"false\">Item dari kedua tahun</item></selection><p visible-if=\"wrong\">Hanya item dari tahun 1980.</p></body></html>",
            "hardModeSelected": true
