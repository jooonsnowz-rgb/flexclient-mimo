            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa output dari kode ini?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getRatio = \" /><text value=\"(\" /><text value=\"nom, denom = \" /><text value=\"2\" class=\"number\" /><text value=\") =&gt;\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" nom / denom;\" /><text type=\"break\" /><text value=\"};\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getRatio(\" /><text value=\"40\" class=\"number\" /><text value=\", \" /><text value=\"4\" class=\"number\" /><text value=\"));\" /></content><output><content><text value=\"10\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>10</code></item><item value=\"2\" correct=\"false\"><code>20</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>10</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Pemanggilan meneruskan <code>4</code> untuk <code>denom</code> meskipun nilai default-nya <code>2</code>. Apa output kode tersebut?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getRatio = \" /><text value=\"(\" /><text value=\"nom, denom = \" /><text value=\"2\" class=\"number\" /><text value=\") =&gt;\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" nom / denom;\" /><text type=\"break\" /><text value=\"};\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getRatio(\" /><text value=\"40\" class=\"number\" /><text value=\", \" /><text value=\"4\" class=\"number\" /><text value=\"));\" /></content><output><content><text value=\"10\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>10</code></item><item value=\"2\" correct=\"false\"><code>20</code></item><item value=\"3\" correct=\"false\"><code>80</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>10</code>.</p></body></html>"
