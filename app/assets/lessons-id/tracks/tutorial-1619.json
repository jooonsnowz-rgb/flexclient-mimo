          {
            "title": "Example: One parameter",
            "id": 103691,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Lengkapi arrow function.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getPrice = \" /><text value=\"discount\" class=\"params\" /><text value=\" =&gt;\" /><text value=\" \" /><text value=\"100\" class=\"number\" /><text value=\" - discount;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getPrice(\" /><text value=\"10\" class=\"number\" /><text value=\"));\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"15\" endIndex=\"16\" /><option startIndex=\"17\" endIndex=\"25\" /><option startIndex=\"26\" endIndex=\"28\" /><option correct=\"false\"><content><text value=\"(\" /></content></option><option correct=\"false\"><content><text value=\"}\" /></content></option></options></interaction></interactions><output><content><text value=\"90\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>=</code>, diikuti oleh <code>discount</code>, dan terakhir <code>=&gt;</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Satu parameter arrow function tidak memerlukan tanda kurung. Lengkapi fungsi agar diskon <code>10</code> membuatnya menampilkan <code>90</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getPrice = \" /><text value=\"discount\" class=\"params\" /><text value=\" =&gt;\" /><text value=\" \" /><text value=\"100\" class=\"number\" /><text value=\" - discount;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getPrice(\" /><text value=\"10\" class=\"number\" /><text value=\"));\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"6\" endIndex=\"14\" /><option startIndex=\"15\" endIndex=\"16\" /><option startIndex=\"17\" endIndex=\"25\" /><option startIndex=\"26\" endIndex=\"28\" /><option correct=\"false\"><content><text value=\"function\" /></content></option><option correct=\"false\"><content><text value=\"(\" /></content></option><option correct=\"false\"><content><text value=\"price\" /></content></option><option correct=\"false\"><content><text value=\"discount()\" /></content></option></options></interaction></interactions><output><content><text value=\"90\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>getPrice</code>, diikuti oleh <code>=</code>, <code>discount</code>, dan terakhir <code>=&gt;</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example: Default parameter value",
            "id": 103693,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tetapkan nilai parameter default ke <code>0</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getSquare = \" /><text value=\"(\" /><text value=\"number = \" /><text value=\"0\" class=\"number\" /><text value=\") =&gt;\" /><text value=\" number * number;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getSquare(\" /><text value=\"5\" class=\"number\" /><text value=\"));\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"18\" endIndex=\"19\" /><option startIndex=\"19\" endIndex=\"25\" /><option startIndex=\"26\" endIndex=\"27\" /><option startIndex=\"28\" endIndex=\"29\" /><option startIndex=\"29\" endIndex=\"30\" /><option correct=\"false\"><content><text value=\"=&gt;\" /></content></option></options></interaction></interactions><output><content><text value=\"25\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>(</code>, diikuti oleh <code>number</code>, lalu <code>=</code>, <code>0</code>, <code>)</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Tetapkan nilai parameter default ke <code>0</code>. Pemanggilan meneruskan <code>5</code>, jadi hasilnya tetap <code>25</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getSquare = \" /><text value=\"(\" /><text value=\"number = \" /><text value=\"0\" class=\"number\" /><text value=\") =&gt;\" /><text value=\" number * number;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getSquare(\" /><text value=\"5\" class=\"number\" /><text value=\"));\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"6\" endIndex=\"15\" /><option startIndex=\"18\" endIndex=\"19\" /><option startIndex=\"19\" endIndex=\"25\" /><option startIndex=\"26\" endIndex=\"27\" /><option startIndex=\"28\" endIndex=\"29\" /><option startIndex=\"29\" endIndex=\"30\" /><option correct=\"false\"><content><text value=\"=&gt;\" /></content></option><option correct=\"false\"><content><text value=\"==\" /></content></option><option correct=\"false\"><content><text value=\"5\" /></content></option><option correct=\"false\"><content><text value=\"getSquare()\" /></content></option></options></interaction></interactions><output><content><text value=\"25\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>getSquare</code>, diikuti oleh <code>(</code>, <code>number</code>, <code>=</code>, <code>0</code>, dan terakhir <code>)</code>.</p></body></html>"
          },
          {
            "title": "Example: Multiple parameters",
            "id": 103695,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tambahkan parameter kedua, <code>width</code>, ke fungsi arrow dan atur nilai defaultnya menjadi <code>3</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getArea = \" /><text value=\"(\" /><text value=\"length, width = \" /><text value=\"3\" class=\"number\" /><text value=\") =&gt;\" /><text value=\" length * width;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getArea(\" /><text value=\"5\" class=\"number\" /><text value=\"));\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"25\" endIndex=\"34\" /></interactions><output><content><text value=\"15\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>width = 3</code>.</p></body></html>"
          },
          {
            "title": "Example: Calling an arrow function",
            "id": 103696,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tuliskan pemanggilan fungsi yang tepat untuk menampilkan <code>30</code> di konsol.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getArea = \" /><text value=\"(\" /><text value=\"length, width = \" /><text value=\"3\" class=\"number\" /><text value=\") =&gt;\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" length * width;\" /><text type=\"break\" /><text value=\"};\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getArea(\" /><text value=\"10\" class=\"number\" /><text value=\"));\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"80\" endIndex=\"87\" /><option startIndex=\"87\" endIndex=\"88\" /><option startIndex=\"88\" endIndex=\"90\" /><option startIndex=\"90\" endIndex=\"91\" /><option correct=\"false\"><content><text value=\",\" /></content></option><option correct=\"false\"><content><text value=\"30\" /></content></option></options></interaction></interactions><output><content><text value=\"30\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>getArea</code>, diikuti oleh <code>(</code>, lalu <code>10</code>, <code>)</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Gunakan lebar default <code>3</code> dan hanya teruskan panjang yang diperlukan untuk menampilkan <code>30</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getArea = \" /><text value=\"(\" /><text value=\"length, width = \" /><text value=\"3\" class=\"number\" /><text value=\") =&gt;\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" length * width;\" /><text type=\"break\" /><text value=\"};\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getArea(\" /><text value=\"10\" class=\"number\" /><text value=\"));\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"17\" endIndex=\"23\" /><option startIndex=\"25\" endIndex=\"34\" /><option startIndex=\"80\" endIndex=\"87\" /><option startIndex=\"88\" endIndex=\"90\" /><option correct=\"false\"><content><text value=\"width\" /></content></option><option correct=\"false\"><content><text value=\"getArea(30)\" /></content></option><option correct=\"false\"><content><text value=\"3\" /></content></option><option correct=\"false\"><content><text value=\"length, width\" /></content></option></options></interaction></interactions><output><content><text value=\"30\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>length</code>, diikuti oleh <code>width = 3</code>, <code>getArea</code>, dan terakhir <code>10</code>.</p></body></html>",
