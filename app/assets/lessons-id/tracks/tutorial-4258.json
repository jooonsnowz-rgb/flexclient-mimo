            "id": 145161,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tampilkan nilai <code>score</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"4200\" /></content></option><option startIndex=\"32\" endIndex=\"37\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" score = \" /><text value=\"4200\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(score);\" /></content></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>score</code>.</p></body></html>"
