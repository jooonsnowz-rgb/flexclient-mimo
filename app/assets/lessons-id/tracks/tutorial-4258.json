            "title": "Lesson #14",
            "id": 145148,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Gunakan variabel default untuk mendeklarasikan nama game.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"0\" endIndex=\"5\" isDefault=\"true\" /></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" GAME_NAME = \" /><text value=\"&quot;Dungeon Dash&quot;\" class=\"string\" /><text value=\";\" /></content></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>const</code>.</p></body></html>"
          }
