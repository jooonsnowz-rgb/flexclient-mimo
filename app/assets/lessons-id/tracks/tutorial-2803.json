            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pernyataan mana berikut tentang alias tipe yang benar?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Alias tipe adalah cara untuk memberikan nama baru pada suatu tipe</item><item value=\"2\" correct=\"false\">Alias tipe digunakan untuk mengompilasi kode TypeScript menjadi JavaScript</item><item value=\"3\" correct=\"false\">Alias tipe memungkinkan manipulasi langsung terhadap DOM</item><item value=\"4\" correct=\"false\">Alias tipe digunakan untuk menangani request HTTP di TypeScript</item></selection><p visible-if=\"wrong\">Alias tipe adalah cara untuk memberikan nama baru pada suatu tipe.</p></body></html>"
