            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa tujuan utama interface dalam TypeScript?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Untuk menentukan struktur sebuah objek</item><item value=\"2\" correct=\"false\">Untuk melakukan operasi matematika</item><item value=\"3\" correct=\"false\">Memanipulasi DOM secara langsung</item><item value=\"4\" correct=\"false\">Untuk menjalankan kode asinkron</item></selection><p visible-if=\"wrong\">Untuk menentukan struktur sebuah objek.</p></body></html>"
