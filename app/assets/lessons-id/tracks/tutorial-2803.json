            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kata kunci apa yang digunakan untuk mendefinisikan alias tipe?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>type</code></item><item value=\"2\" correct=\"false\"><code>implement</code></item><item value=\"3\" correct=\"false\"><code>interface</code></item><item value=\"4\" correct=\"false\"><code>readonly</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>type</code>.</p></body></html>"
