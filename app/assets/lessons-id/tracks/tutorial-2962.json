            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tag HTML mana yang membuat heading <strong>paling kecil</strong>?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>&lt;h6&gt;</code></item><item value=\"2\" correct=\"false\"><code>&lt;h5&gt;</code></item><item value=\"3\" correct=\"false\"><code>&lt;h1&gt;</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>&lt;h6&gt;</code>.</p></body></html>"
