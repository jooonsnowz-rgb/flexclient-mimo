            "id": 133132,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jenis tag apa ini? <code>&lt;/h1&gt;</code> .</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Tag penutup</item><item value=\"2\" correct=\"false\">Tag pembuka</item></selection><p visible-if=\"wrong\">Tag penutup.</p></body></html>"
