            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Seberapa sering kita bisa mengubah nilai variabel?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">Sesering yang kita inginkan</item><item correct=\"false\" value=\"2\">Hanya sekali</item><item correct=\"false\" value=\"2\">Tidak pernah</item></selection><p visible-if=\"wrong\">Sesering yang kita inginkan.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Sebuah program menjalankan <code>points = 4</code>, lalu menjalankan <code>points = 8</code>. Apa yang benar tentang <code>points</code>?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Sekarang variabel tersebut menyimpan <code>8</code></item><item value=\"2\" correct=\"false\">Variabel tersebut masih hanya menyimpan <code>4</code></item><item value=\"3\" correct=\"false\">Python tidak mengizinkan nilainya berubah</item></selection><p visible-if=\"wrong\">Sekarang variabel tersebut menyimpan <code>8</code>.</p></body></html>"
