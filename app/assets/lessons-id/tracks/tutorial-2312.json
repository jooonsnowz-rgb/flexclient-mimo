            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang ditampilkan kode ini di konsol?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"print(\" /><text value=\"&quot;Hair&quot;\" class=\"string\" /><text value=\" + \" /><text value=\"&quot;cut&quot;\" class=\"string\" /><text value=\")\" /></content><output><content><text value=\"Haircut\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>Haircut</code></item><item value=\"2\" correct=\"false\"><code>\"Hair + cut\"</code></item><item value=\"3\" correct=\"false\"><code>Hair + cut</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>Haircut</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Kode menggabungkan dua nilai string. Apa yang muncul di console?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"print(\" /><text value=\"&quot;Hair&quot;\" class=\"string\" /><text value=\" + \" /><text value=\"&quot;cut&quot;\" class=\"string\" /><text value=\")\" /></content><output><content><text value=\"Haircut\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>Haircut</code></item><item value=\"2\" correct=\"false\"><code>Hair cut</code></item><item value=\"3\" correct=\"false\"><code>\"Haircut\"</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>Haircut</code>.</p></body></html>",
