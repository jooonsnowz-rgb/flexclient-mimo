            "interactiveContent": "<!DOCTYPE html ><html><body><p>Manakah dari pilihan berikut yang memberikan nilai <code>False</code> pada <code>is_monday</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>is_monday = not True</code></item><item value=\"2\" correct=\"false\"><code>is_monday = \"True\"</code></item><item value=\"2\" correct=\"false\"><code>is_monday = \"not True\"</code></item></selection><p visible-if=\"wrong\"><code>is_monday = not True</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Baris mana yang memakai <code>not</code> untuk memberikan value khusus <code>False</code> pada <code>is_monday</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>is_monday = not True</code></item><item value=\"2\" correct=\"false\"><code>is_monday = True</code></item><item value=\"3\" correct=\"false\"><code>is_monday = \"not True\"</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>is_monday = not True</code>.</p></body></html>",
