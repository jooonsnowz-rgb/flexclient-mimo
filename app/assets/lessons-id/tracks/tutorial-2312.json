            "interactiveContent": "<!DOCTYPE html ><html><body><p>Untuk apa tanda <code>=</code>?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">Memberikan nilai ke sebuah variabel</item><item correct=\"false\" value=\"2\">Menambahkan nilai string secara bersamaan</item><item correct=\"false\" value=\"3\">Ini membagi sebuah angka dengan angka lainnya</item></selection><p visible-if=\"wrong\">Memberikan nilai ke sebuah variabel.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Dalam <code>score = 9</code>, apa fungsi tanda <code>=</code>?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Tanda tersebut menyimpan <code>9</code> dalam <code>score</code></item><item value=\"2\" correct=\"false\">Tanda tersebut menampilkan <code>9</code> di console</item><item value=\"3\" correct=\"false\">Tanda tersebut menggabungkan <code>score</code> dan <code>9</code></item></selection><p visible-if=\"wrong\">Tanda tersebut menyimpan <code>9</code> dalam <code>score</code>.</p></body></html>"
