            "interactiveContent": "<!DOCTYPE html ><html><body><p>Perbarui variabel <code>average_rating</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"average_rating = \" /><text value=\"25\" class=\"number\" /><text type=\"break\" /><text value=\"average_rating = \" /><text value=\"5\" class=\"number\" /><text type=\"break\" /><text value=\"print(average_rating)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"20\" endIndex=\"34\" /><option startIndex=\"35\" endIndex=\"36\" /><option startIndex=\"37\" endIndex=\"38\" /><option correct=\"false\"><content><text value=\"rating\" /></content></option></options></interaction></interactions><output><content><text value=\"5\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>average_rating</code>, diikuti oleh <code>=</code>, dan terakhir <code>5</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Ubah <code>average_rating</code> agar console mencetak <code>5</code>, bukan nilai pertamanya.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"average_rating = \" /><text value=\"25\" class=\"number\" /><text type=\"break\" /><text value=\"average_rating = \" /><text value=\"5\" class=\"number\" /><text type=\"break\" /><text value=\"print(average_rating)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"20\" endIndex=\"34\" /><option startIndex=\"35\" endIndex=\"36\" /><option startIndex=\"37\" endIndex=\"38\" /><option correct=\"false\"><content><text value=\"==\" /></content></option><option correct=\"false\"><content><text value=\"25\" /></content></option></options></interaction></interactions><output><content><text value=\"5\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>average_rating</code>, diikuti oleh <code>=</code>, dan terakhir <code>5</code>.</p></body></html>",
