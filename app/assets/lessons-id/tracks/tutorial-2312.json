            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang akan ditampilkan konsol saat kita menjalankan kode tersebut?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"average_grade = \" /><text value=\"&quot;B&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"average_grade = \" /><text value=\"&quot;A-&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"subject = \" /><text value=\"&quot;Programming&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"print(average_grade)\" /></content><output><content><text value=\"A-\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>A-</code></item><item value=\"2\" correct=\"false\"><code>Programming</code></item><item value=\"4\" correct=\"false\"><code>B</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>A-</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>average_grade</code> diberi nilai dua kali. Nilai mana yang digunakan <code>print(average_grade)</code>?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"average_grade = \" /><text value=\"&quot;B&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"average_grade = \" /><text value=\"&quot;A-&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"subject = \" /><text value=\"&quot;Programming&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"print(average_grade)\" /></content><output><content><text value=\"A-\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Nilai yang terakhir diberikan, <code>A-</code>.</item><item value=\"2\" correct=\"false\">Nilai pertama yang diberikan, <code>B</code>.</item><item value=\"3\" correct=\"false\">Nilai dalam <code>subject</code>, yaitu <code>Programming</code>.</item></selection><p visible-if=\"wrong\">Nilai yang terakhir diberikan, <code>A-</code>.</p></body></html>"
