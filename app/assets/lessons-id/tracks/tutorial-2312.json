            "hardModeContent": "<!DOCTYPE html ><html><body><p>Gunakan tanda untuk memeriksa apakah dua nilai sama. Baris mana yang memeriksa apakah <code>score</code> bernilai <code>10</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>score == 10</code></item><item value=\"2\" correct=\"false\"><code>score = 10</code></item><item value=\"3\" correct=\"false\"><code>score != 10</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>score == 10</code>.</p></body></html>"
