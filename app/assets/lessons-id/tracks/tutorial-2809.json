            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang akan dicatat ke console?</p><code version=\"2\" codelang=\"typescript\" name=\"script.ts\" visible-if=\"always\"><content><text value=\"enum\" class=\"keyword\" /><text value=\" Answer {\" /><text type=\"break\" /><text value=\" Yes = \" /><text value=\"1\" class=\"number\" /><text value=\",\" /><text type=\"break\" /><text value=\" No,\" /><text type=\"break\" /><text value=\" Maybe = \" /><text value=\"&quot;MAYBE&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(Answer.No);\" /></content><output><content><text value=\"2\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>2</code></item><item value=\"2\" correct=\"false\"><code>undefined</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>2</code>.</p></body></html>"
