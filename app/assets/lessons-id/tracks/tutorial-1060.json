            "interactiveContent": "<!DOCTYPE html ><html><body><p>Gunakan operator decrement <code>--</code> untuk mengurangi wallet sebanyak satu.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" wallet = \" /><text value=\"13\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"wallet--;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(wallet);\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"17\" endIndex=\"25\" /></interactions><output><content><text value=\"12\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>wallet--</code>.</p></body></html>"
