            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang ditampilkan kode ini di konsol?</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"func\" class=\"keyword\" /><text value=\" \" /><text value=\"displayAirDate\" class=\"title\" /><text value=\"(year: Int)\" class=\"params\" /><text value=\" -&gt; \" /><text value=\"String\" class=\"type\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" \" /><text value=\"&quot;TV show aired in: \\(year)&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"let\" class=\"keyword\" /><text value=\" text = displayAirDate(year: \" /><text value=\"1990\" class=\"number\" /><text value=\")\" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(text)\" /></content><output><content><text value=\"TV show aired in: 1990\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>Acara TV ditayangkan pada: 1990</code></item><item value=\"2\" correct=\"false\">Tidak ada yang ditampilkan di konsol</item><item value=\"3\" correct=\"false\"><code>1990</code></item></selection><p visible-if=\"wrong\"><code>Acara TV ditayangkan pada: 1990</code>.</p></body></html>"
