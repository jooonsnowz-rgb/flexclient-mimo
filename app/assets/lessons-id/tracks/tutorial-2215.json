            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang ditampilkan kode ini di konsol?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" result = \" /><text value=\"&quot;moon&quot;\" class=\"string\" /><text value=\" !== \" /><text value=\"&quot;moon&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(result);\" /></content><output><content><text value=\"false\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>false</code></item><item value=\"2\" correct=\"false\"><code>result</code></item><item value=\"3\" correct=\"false\"><code>true</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>false</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Kedua string <code>\"moon\"</code> identik. Nilai apa yang disimpan <code>!==</code> dalam <code>result</code>?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" result = \" /><text value=\"&quot;moon&quot;\" class=\"string\" /><text value=\" !== \" /><text value=\"&quot;moon&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(result);\" /></content><output><content><text value=\"false\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>false</code></item><item value=\"2\" correct=\"false\"><code>result</code></item><item value=\"3\" correct=\"false\"><code>true</code></item><item value=\"4\" correct=\"false\"><code>moon</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>false</code>.</p></body></html>"
