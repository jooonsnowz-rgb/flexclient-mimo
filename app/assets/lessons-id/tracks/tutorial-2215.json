            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Simpan hasil perbandingan di <code>pass</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" score = \" /><text value=\"32\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" minScore = \" /><text value=\"30\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" pass = score &gt;= minScore;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(pass);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"39\" endIndex=\"44\" /><option startIndex=\"45\" endIndex=\"49\" /><option startIndex=\"50\" endIndex=\"51\" /><option startIndex=\"52\" endIndex=\"69\" /><option correct=\"false\"><content><text value=\"===\" /></content></option><option correct=\"false\"><content><text value=\"&lt;=\" /></content></option></options></interaction></interactions><output><content><text value=\"true\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>const</code>, diikuti oleh <code>pass</code>, lalu <code>=</code>, <code>score &gt;= minScore</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Simpan hasil perbandingan di <code>pass</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" score = \" /><text value=\"32\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" minScore = \" /><text value=\"30\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" pass = score &gt;= minScore;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(pass);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"39\" endIndex=\"44\" /><option startIndex=\"45\" endIndex=\"49\" /><option startIndex=\"50\" endIndex=\"51\" /><option startIndex=\"52\" endIndex=\"69\" /><option correct=\"false\"><content><text value=\"===\" /></content></option><option correct=\"false\"><content><text value=\"&lt;=\" /></content></option><option correct=\"false\"><content><text value=\"==\" /></content></option><option correct=\"false\"><content><text value=\"typeof\" /></content></option></options></interaction></interactions><output><content><text value=\"true\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>const</code>, diikuti oleh <code>pass</code>, <code>=</code>, dan terakhir <code>score &gt;= minScore</code>.</p></body></html>"
