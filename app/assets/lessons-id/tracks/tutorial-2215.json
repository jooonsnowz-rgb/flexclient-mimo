            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa tipe <code>message</code>?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" isBooked = \" /><text value=\"true\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" message = \" /><text value=\"&quot;Ticket booked: &quot;\" class=\"string\" /><text value=\" + isBooked;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(message);\" /></content><output><content><text value=\"Ticket booked: true\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">String</item><item value=\"2\" correct=\"false\">Boolean</item><item value=\"3\" correct=\"false\">Angka</item></selection><p visible-if=\"wrong\">Pastikan kamu memilih String.</p></body></html>",
