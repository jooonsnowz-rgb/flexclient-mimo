            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa fungsi <code>!==</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Ini memeriksa apakah sebuah string tidak sama dengan string lainnya</item><item value=\"2\" correct=\"false\">Ini memeriksa apakah sebuah string sama dengan string lainnya</item><item value=\"2\" correct=\"false\">Ini memeriksa apakah sebuah string lebih kecil daripada string lainnya</item></selection><p visible-if=\"wrong\">Ini memeriksa apakah sebuah string tidak sama dengan string lainnya.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Dalam <code>name !== \"Nina\"</code>, <code>name</code> menyimpan <code>\"Mika\"</code>. Apa yang diperiksa <code>!==</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Ini memeriksa apakah sebuah string tidak sama dengan string lainnya</item><item value=\"2\" correct=\"false\">Ini memeriksa apakah sebuah string sama dengan string lainnya</item><item value=\"3\" correct=\"false\">Ini memeriksa apakah sebuah string lebih kecil daripada string lainnya</item><item value=\"4\" correct=\"false\">Menetapkan <code>\"Nina\"</code> ke <code>name</code></item></selection><p visible-if=\"wrong\">Ini memeriksa apakah sebuah string tidak sama dengan string lainnya.</p></body></html>"
