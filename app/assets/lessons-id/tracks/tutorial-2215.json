            "id": 62428,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang ditampilkan kode ini di konsol?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Nina&quot;\" class=\"string\" /><text value=\" === \" /><text value=\"&quot;Nina&quot;\" class=\"string\" /><text value=\");\" /></content><output><content><text value=\"true\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>true</code></item><item value=\"2\" correct=\"false\"><code>false</code></item><item value=\"3\" correct=\"false\"><code>NinaNina</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>true</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Kedua sisi <code>===</code> berisi string yang sama. Apa yang ditampilkan perbandingan tersebut?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Nina&quot;\" class=\"string\" /><text value=\" === \" /><text value=\"&quot;Nina&quot;\" class=\"string\" /><text value=\");\" /></content><output><content><text value=\"true\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>true</code></item><item value=\"2\" correct=\"false\"><code>false</code></item><item value=\"3\" correct=\"false\"><code>NinaNina</code></item><item value=\"4\" correct=\"false\"><code>Nina</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>true</code>.</p></body></html>"
          },
