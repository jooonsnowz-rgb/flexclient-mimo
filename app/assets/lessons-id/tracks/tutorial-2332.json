          {
            "title": "Example: Replace",
            "id": 82810,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Ganti semua kemunculan <code>!</code> dengan <code>?</code>. </p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"rep = \" /><text value=\"&quot;Yes!&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"rep = rep.replace(\" /><text value=\"&quot;!&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;?&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(rep)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"37\" endIndex=\"38\" /><option startIndex=\"38\" endIndex=\"39\" /><option startIndex=\"39\" endIndex=\"40\" /><option correct=\"false\"><content><text value=\"^\" /></content></option></options></interaction></interactions><output><content><text value=\"Yes?\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>\"</code>, diikuti oleh <code>?</code>, dan terakhir <code>\"</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Ubah setiap <code>!</code> menjadi <code>?</code> agar konsol menampilkan <code>Yes?</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"rep = \" /><text value=\"&quot;Yes!&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"rep = rep.replace(\" /><text value=\"&quot;!&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;?&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(rep)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"37\" endIndex=\"38\" /><option startIndex=\"38\" endIndex=\"39\" /><option startIndex=\"39\" endIndex=\"40\" /><option startIndex=\"32\" endIndex=\"35\" /><option correct=\"false\"><content><text value=\"&quot;?&quot;\" /></content></option><option correct=\"false\"><content><text value=\"^\" /></content></option><option correct=\"false\"><content><text value=\"!\" /></content></option></options></interaction></interactions><output><content><text value=\"Yes?\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>\"!\"</code>, diikuti oleh <code>\"</code>, <code>?</code>, dan terakhir <code>\"</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
