            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pisahkan string <code>signups</code> berdasarkan <code>-</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"signups = \" /><text value=\"&quot;44-22-44-11&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"signups_list = signups.split(\" /><text value=\"&quot;-&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(signups_list)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"47\" endIndex=\"48\" /><option startIndex=\"48\" endIndex=\"53\" /><option startIndex=\"54\" endIndex=\"57\" /><option correct=\"false\"><content><text value=\"&quot;&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"['44', '22', '44', '11']\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>.</code>, diikuti oleh <code>split</code>, dan terakhir <code>\"-\"</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Pisahkan <code>signups</code> pada karakter <code>-</code> agar konsol menampilkan <code>['44', '22', '44', '11']</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"signups = \" /><text value=\"&quot;44-22-44-11&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"signups_list = signups.split(\" /><text value=\"&quot;-&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(signups_list)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"47\" endIndex=\"48\" /><option startIndex=\"48\" endIndex=\"53\" /><option startIndex=\"54\" endIndex=\"57\" /><option startIndex=\"40\" endIndex=\"47\" /><option correct=\"false\"><content><text value=\"&quot;&quot;\" /></content></option><option correct=\"false\"><content><text value=\"signups_list\" /></content></option><option correct=\"false\"><content><text value=\"&quot;signups&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"['44', '22', '44', '11']\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>signups</code>, diikuti oleh <code>.</code>, <code>split</code>, dan terakhir <code>\"-\"</code>.</p></body></html>",
