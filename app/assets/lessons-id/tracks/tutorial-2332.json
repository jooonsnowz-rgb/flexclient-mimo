          {
            "title": "Question: Whitespace",
            "id": 82837,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa pemisah default saat menggunakan <code>split()</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Spasi kosong</item><item value=\"2\" correct=\"false\">Titik</item><item value=\"3\" correct=\"false\">Tanda pisah</item></selection><p visible-if=\"wrong\">Spasi kosong.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Apa yang dikembalikan oleh <code>\"red.blue green\".split()</code> ketika tidak ada pemisah yang diberikan?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>['red.blue', 'green']</code></item><item value=\"2\" correct=\"false\"><code>['red', 'blue green']</code></item><item value=\"3\" correct=\"false\"><code>['red', 'blue', 'green']</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>['red.blue', 'green']</code>.</p></body></html>",
            "hardModeSelected": true
