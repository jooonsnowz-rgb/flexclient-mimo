            "id": 79924,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bagaimana cara menamai fungsi?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Dengan menggunakan snake case</item><item value=\"2\" correct=\"false\">Dengan menyertakan spasi dalam nama fungsi</item></selection><p visible-if=\"wrong\">Dengan menggunakan snake case.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Kita menggunakan snake case untuk menamai fungsi.</p><p>Nama mana yang mengikuti gaya tersebut untuk fungsi yang menampilkan total?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>display_total</code></item><item value=\"2\" correct=\"false\"><code>display total</code></item><item value=\"3\" correct=\"false\"><code>DisplayTotal</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>display_total</code>.</p></body></html>"
