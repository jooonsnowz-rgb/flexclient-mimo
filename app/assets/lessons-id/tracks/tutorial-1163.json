            "id": 79925,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa fungsi titik dua <code>:</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Menandai awal blok kode sebuah fungsi</item><item value=\"2\" correct=\"false\">Ini menunjukkan kode yang harus dilewati fungsi</item></selection><p visible-if=\"wrong\">Menandai awal blok kode sebuah fungsi.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Titik dua <code>:</code> menandai awal blok kode fungsi.</p><p>Header mana yang memulai fungsi bernama <code>greet</code> dengan benar?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>def greet():</code></item><item value=\"2\" correct=\"false\"><code>def greet()</code></item><item value=\"3\" correct=\"false\"><code>def greet(:)</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>def greet():</code>.</p></body></html>",
            "hardModeSelected": true
