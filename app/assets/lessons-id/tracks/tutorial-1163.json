            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bagaimana kita mulai mengelompokkan kode yang saling terkait?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Dengan menambahkan keyword <code>def</code></item><item value=\"2\" correct=\"false\">Dengan menambahkan keyword <code>function</code></item></selection><p visible-if=\"wrong\">Dengan menambahkan keyword <code>def</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Kita mulai mengelompokkan kode terkait dengan menambahkan keyword <code>def</code>.</p><p>Baris mana yang memulai fungsi bernama <code>show_menu</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>def show_menu():</code></item><item value=\"2\" correct=\"false\"><code>function show_menu():</code></item><item value=\"3\" correct=\"false\"><code>def = show_menu()</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>def show_menu():</code>.</p></body></html>",
            "hardModeSelected": true
