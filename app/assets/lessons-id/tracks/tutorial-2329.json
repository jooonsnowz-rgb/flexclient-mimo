            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang dilakukan kode ini?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"flavors = [\" /><text value=\"&quot;vanilla&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;chocolate&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;strawberry&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;vanilla&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;vanilla&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"vanilla = flavors.count(\" /><text value=\"&quot;vanilla&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"print(vanilla)\" /></content><output><content><text value=\"3\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Menyimpan jumlah elemen <code>\"vanilla\"</code> dalam sebuah variabel</item><item value=\"2\" correct=\"false\">Membuat salinan <code>flavors</code> dan menyimpannya dalam sebuah variabel</item><item value=\"3\" correct=\"false\">Tidak ada, kodenya salah</item></selection><p visible-if=\"wrong\">Menyimpan jumlah elemen <code>\"vanilla\"</code> dalam sebuah variabel.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Jika satu nilai <code>\"vanilla\"</code> berubah menjadi <code>\"chocolate\"</code> sebelum penetapan, apa yang disimpan <code>vanilla</code>?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"flavors = [\" /><text value=\"&quot;vanilla&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;chocolate&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;strawberry&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;vanilla&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;vanilla&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"vanilla = flavors.count(\" /><text value=\"&quot;vanilla&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"print(vanilla)\" /></content><output><content><text value=\"3\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>2</code></item><item value=\"2\" correct=\"false\"><code>3</code>, karena variabel menyimpan jumlah awal</item><item value=\"3\" correct=\"false\">Salinan list <code>flavors</code> yang telah diperbarui</item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>2</code>.</p></body></html>"
