            "interactiveContent": "<!DOCTYPE html ><html><body><p>Manakah dari berikut ini yang merupakan tujuan <code>ALTER TABLE</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Untuk membuat perubahan pada tabel yang sudah ada</item><item value=\"2\" correct=\"false\">Untuk menetapkan kondisi dalam tabel</item></selection><p visible-if=\"wrong\">Untuk membuat perubahan pada tabel yang sudah ada.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Tabel <code>customers</code> sudah ada. Kamu perlu mengubah struktur kolomnya. Mengapa statement dimulai dengan <code>ALTER TABLE customers</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Untuk membuat perubahan struktural pada tabel <code>customers</code> yang sudah ada</item><item value=\"2\" correct=\"false\">Untuk memfilter baris <code>customers</code> yang dikembalikan query</item><item value=\"3\" correct=\"false\">Untuk memperbarui nilai yang tersimpan di setiap baris <code>customers</code></item></selection><p visible-if=\"wrong\">Untuk membuat perubahan struktural pada tabel <code>customers</code> yang sudah ada.</p></body></html>"
