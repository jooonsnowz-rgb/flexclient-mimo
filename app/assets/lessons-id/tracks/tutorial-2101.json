            "id": 118775,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bagaimana sintaks yang benar untuk mengganti nama kolom?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>RENAME columnName TO newName</code></item><item value=\"2\" correct=\"false\"><code>RENAME columnName newName</code></item></selection><p visible-if=\"wrong\"><code>RENAME columnName TO newName</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Kamu mengganti nama kolom <code>username</code> menjadi <code>handle</code>. Klausa mana yang memiliki sintaks yang benar?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>RENAME username TO handle</code></item><item value=\"2\" correct=\"false\"><code>RENAME username handle</code></item><item value=\"3\" correct=\"false\"><code>RENAME handle TO username</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>RENAME username TO handle</code>.</p></body></html>"
          },
