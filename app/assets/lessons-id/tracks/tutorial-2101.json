            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jika kamu ingin menambahkan kolom baru ke tabel yang sudah ada, mana dari berikut ini yang harus kamu gunakan?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>ADD</code></item><item value=\"2\" correct=\"false\"><code>DROP COLUMN</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>ADD</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Tabel <code>users</code> memerlukan kolom <code>age</code> baru. Klausa mana yang ditulis setelah <code>ALTER TABLE users</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>ADD age</code></item><item value=\"2\" correct=\"false\"><code>DROP COLUMN age</code></item><item value=\"3\" correct=\"false\"><code>RENAME age TO users</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>ADD age</code>.</p></body></html>"
          },
          {
