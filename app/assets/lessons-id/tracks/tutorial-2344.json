            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tambahkan ke fungsi <code>change_color</code> satu baris untuk memperbarui variabel kelas <code>color</code> menjadi <code>new_color</code> sebelum mencetak \"Color is now\".</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"Car\" class=\"title\" /><text value=\":\" /><text type=\"break\" /><text value=\"  manufacturer = \" /><text value=\"&quot;Ferrari&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"  model = \" /><text value=\"2019\" class=\"number\" /><text type=\"break\" /><text value=\"  color = \" /><text value=\"&quot;red&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"  \" /><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"print_specs\" class=\"title\" /><text value=\"(self)\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\"    print(self.manufacturer)\" /><text type=\"break\" /><text value=\"    print(self.model)\" /><text type=\"break\" /><text value=\"    print(self.color)\" /><text type=\"break\" /><text value=\"  \" /><text type=\"break\" /><text value=\"  \" /><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"change_color\" class=\"title\" /><text value=\"(self, new_color)\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\"    self.color = new_color\" /><text type=\"break\" /><text value=\"    print(\" /><text value=\"&quot;Color is now&quot;\" class=\"string\" /><text value=\", self.color)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"212\" endIndex=\"216\" /><option startIndex=\"216\" endIndex=\"217\" /><option startIndex=\"217\" endIndex=\"222\" /><option startIndex=\"223\" endIndex=\"224\" /><option startIndex=\"225\" endIndex=\"234\" /><option cor