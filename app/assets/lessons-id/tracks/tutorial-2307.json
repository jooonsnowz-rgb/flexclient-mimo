            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bagaimana format data di dalam body request POST ini?</p><code version=\"2\" codelang=\"bash\" name=\"script.sh\" visible-if=\"always\"><content><text value=\"POST https://knowitall.com/posts\" /><text type=\"break\" /><text type=\"break\" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"&quot;title&quot;\" class=\"string\" /><text value=\": \" /><text value=\"&quot;Titane&quot;\" class=\"string\" /><text value=\",\" /><text type=\"break\" /><text value=\" \" /><text value=\"&quot;content&quot;\" class=\"string\" /><text value=\": \" /><text value=\"&quot;Anyone seen it yet?&quot;\" class=\"string\" /><text value=\",\" /><text type=\"break\" /><text value=\" \" /><text value=\"&quot;user&quot;\" class=\"string\" /><text value=\": \" /><text value=\"&quot;sassy_sam&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">JSON</item><item value=\"2\" correct=\"false\">HTTP</item><item value=\"3\" correct=\"false\">Java Script</item></selection><p visible-if=\"wrong\">Pastikan kamu memilih JSON.</p></body></html>"
