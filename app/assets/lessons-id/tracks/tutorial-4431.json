        "lessons": [
          {
            "title": "Lesson #1",
            "id": 148214,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Mengapa menambahkan pernyataan <code>if</code> di dalam fungsi berguna?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Hal ini memungkinkan kita mengubah perilaku fungsi berdasarkan suatu kondisi</item><item value=\"2\" correct=\"false\">Ini sama seperti menambahkan instruksi lain di dalam fungsi</item><item value=\"3\" correct=\"false\">Ini membuat fungsi kita lebih kecil dan lebih mudah dibaca</item></selection><p visible-if=\"wrong\">Hal ini memungkinkan kita mengubah perilaku fungsi berdasarkan suatu kondisi.</p></body></html>"
          },
          {
            "title": "Lesson #2",
            "id": 148215,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Panggil fungsi dengan nilai (argumen) yang akan menampilkan <code>\"Level up!\"</code> di konsol.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"65\" /></content></option><option correct=\"false\"><content><text value=\"40\" /></content></option><option startIndex=\"127\" endIndex=\"129\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"checkXP\" class=\"title\" /><text value=\"(\" /><text value=\"xp\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"if\" class=\"keyword\" /><text value=\" (xp &lt;= \" /><text value=\"65\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Keep grinding...&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" } \" /><text value=\"else\" class=\"keyword\" /><text value=\" {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Level up!&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"checkXP(\" /><text value=\"80\" class=\"number\" /><text value=\");\" /></content></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>80</code>.</p></body></html>"
          },
          {
            "title": "Lesson #3",
            "id": 148216,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Menulis kode untuk pernyataan <code>if</code> sehingga kedua pesan dicetak ke konsol.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"false\" /></content></option><option correct=\"false\"><content><text value=\"&gt;\" /></content></option><option correct=\"false\"><content><text value=\"&lt;\" /></content></option><option startIndex=\"86\" endIndex=\"89\" /><option startIndex=\"90\" endIndex=\"94\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"isEnemySpotted\" class=\"title\" /><text value=\"(\" /><text value=\"spotted\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Scanning the area...&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" \" /><text value=\"if\" class=\"keyword\" /><text value=\" (spotted === \" /><text value=\"true\" class=\"literal\" /><text value=\") {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Enemy spotted!&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" } \" /><text type=\"break\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"isEnemySpotted(\" /><text value=\"true\" class=\"literal\" /><text value=\");\" /></content></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>===</code>, diikuti oleh <code>true</code>.</p></body></html>"
          },
          {
            "title": "Lesson #4",
            "id": 148217,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Panggil fungsi dengan argumen yang akan menghasilkan peningkatan damage sebesar 10%.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"2200\" /></content></option><option correct=\"false\"><content><text value=\"400\" /></content></option><option startIndex=\"239\" endIndex=\"242\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"boostedDamage\" class=\"title\" /><text value=\"(\" /><text value=\"damage\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"let\" class=\"keyword\" /><text value=\" boost;\" /><text type=\"break\" /><text value=\" \" /><text value=\"if\" class=\"keyword\" /><text value=\" (damage &gt; \" /><text value=\"2000\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\"  boost = damage * \" /><text value=\"0.8\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"  damage = damage - boost;\" /><text type=\"break\" /><text value=\" } \" /><text value=\"else\" class=\"keyword\" /><text value=\" \" /><text value=\"if\" class=\"keyword\" /><text value=\" (damage &gt;= \" /><text value=\"500\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\"  boost = damage * \" /><text value=\"0.1\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"  damage = damage - boost;\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(damage);\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"boostedDamage(\" /><text value=\"800\" class=\"number\" /><text value=\");\" /></content></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>800</code>.</p></body></html>"
          },
          {
            "title": "Lesson #5",
            "id": 148218,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Lengkapi pernyataan kondisional untuk menerapkan penalti stamina pada energi yang diteruskan ke <code>getAdjustedEnergy()</code> saat melebihi 2.500.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"(currentEnergy &lt; 2500)\" /></content></option><option correct=\"false\"><content><text value=\"(currentEnergy &gt; 2500)\" /></content></option><option correct=\"false\"><content><text value=\"(energy &lt; 2500)\" /></content></option><option startIndex=\"41\" endIndex=\"56\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"getAdjustedEnergy\" class=\"title\" /><text value=\"(\" /><text value=\"energy\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"if\" class=\"keyword\" /><text value=\" (energy &gt; \" /><text value=\"2500\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\"  energy = energy - (energy * \" /><text value=\"0.15\" class=\"number\" /><text value=\");\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" energy;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" currentEnergy = getAdjustedEnergy(\" /><text value=\"2800\" class=\"number\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(currentEnergy);\" /></content></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>(energy &gt; 2500)</code>.</p></body></html>"
          },
          {
            "title": "Lesson #6",
            "id": 148219,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kodekan pernyataan kondisional untuk menerapkan bonus pemula jika sesuai.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"==\" /></content></option><option correct=\"false\"><content><text value=\"(\" /></content></option><option correct=\"false\"><content><text value=\")\" /></content></option><option correct=\"false\"><content><text value=\"applyNewbieBonus\" /></content></option><option startIndex=\"40\" endIndex=\"45\" /><option startIndex=\"46\" endIndex=\"48\" /><option startIndex=\"49\" endIndex=\"51\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"applyNewbieBonus\" class=\"title\" /><text value=\"(\" /><text value=\"level\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"if\" class=\"keyword\" /><text value=\" (level &lt;= \" /><text value=\"10\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Level &quot;\" class=\"string\" /><text value=\" + level + \" /><text value=\"&quot;: newbie bonus applies!&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"applyNewbieBonus(\" /><text value=\"6\" class=\"number\" /><text value=\");\" /></content></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>level</code>, diikuti oleh <code>&lt;=</code>, dan terakhir <code>10</code>.</p></body></html>"
          },
          {
            "title": "Lesson #7",
            "id": 148220,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Susun kondisi dalam pernyataan <code>if</code> agar sesuai dengan output.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"&lt;=\" /></content></option><option correct=\"false\"><content><text value=\"===\" /></content></option><option startIndex=\"36\" endIndex=\"37\" /><option startIndex=\"37\" endIndex=\"38\" /><option startIndex=\"39\" endIndex=\"41\" /><option startIndex=\"42\" endIndex=\"43\" /><option startIndex=\"43\" endIndex=\"44\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"checkHighScore\" class=\"title\" /><text value=\"(\" /><text value=\"a, b\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"if\" class=\"keyword\" /><text value=\" (a &gt;= b) {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(a + \" /><text value=\"&quot; is greater than or equal to &quot;\" class=\"string\" /><text value=\" + b);\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"checkHighScore(\" /><text value=\"14\" class=\"number\" /><text value=\", \" /><text value=\"13\" class=\"number\" /><text value=\");\" /></content></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>(</code>, diikuti oleh <code>a</code>, lalu <code>&gt;=</code>, <code>b</code>, <code>)</code>.</p></body></html>"
          },
          {
            "title": "Lesson #8",
            "id": 148221,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kodenya pernyataan <code>if else</code> untuk melengkapi fungsi.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"if (a &gt;= b)\" /></content></option><option correct=\"false\"><content><text value=\"else if\" /></content></option><option startIndex=\"37\" endIndex=\"49\" /><option startIndex=\"88\" endIndex=\"92\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"checkHitboxOverlap\" class=\"title\" /><text value=\"(\" /><text value=\"a, b\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"if\" class=\"keyword\" /><text value=\" (a === b) {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Hitboxes match&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" } \" /><text value=\"else\" class=\"keyword\" /><text value=\" {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Hitboxes don't match&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"checkHitboxOverlap(\" /><text value=\"10\" class=\"number\" /><text value=\", \" /><text value=\"10\" class=\"number\" /><text value=\");\" /></content></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>if (a === b)</code>, diikuti oleh <code>else</code>.</p></body></html>"
          },
          {
            "title": "Lesson #9",
            "id": 148222,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tampilkan <code>Entering game...</code> di console dengan memanggil fungsi menggunakan kode akses yang benar.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"code\" /></content></option><option correct=\"false\"><content><text value=\"&quot;swordfish&quot;\" /></content></option><option startIndex=\"156\" endIndex=\"171\" /><option startIndex=\"171\" endIndex=\"172\" /><option startIndex=\"172\" endIndex=\"183\" /><option startIndex=\"183\" endIndex=\"184\" /><option startIndex=\"184\" endIndex=\"185\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"checkAccessCode\" class=\"title\" /><text value=\"(\" /><text value=\"code\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"if\" class=\"keyword\" /><text value=\" (code === \" /><text value=\"&quot;party1999&quot;\" class=\"string\" /><text value=\") {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Entering game...&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" } \" /><text value=\"else\" class=\"keyword\" /><text value=\" {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Access denied, try again.&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"checkAccessCode(\" /><text value=\"&quot;party1999&quot;\" class=\"string\" /><text value=\");\" /></content></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>checkAccessCode</code>, diikuti oleh <code>(</code>, lalu <code>\"party1999\"</code>, <code>)</code>, <code>;</code>.</p></body></html>"
          },
          {
            "title": "Lesson #10",
            "id": 148223,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa tujuan pernyataan <code>return</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Untuk mengembalikan nilai dari sebuah fungsi</item><item value=\"2\" correct=\"false\">Untuk menampilkan nilai di console</item><item value=\"3\" correct=\"false\">Memanggil fungsi yang telah didefinisikan sebelumnya</item></selection><p visible-if=\"wrong\">Untuk mengembalikan nilai dari sebuah fungsi.</p></body></html>"
          },
          {
            "title": "Lesson #11",
            "id": 148224,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jika pernyataan return ditempatkan sebelum instruksi dalam sebuah fungsi, apa yang terjadi saat fungsi tersebut dipanggil?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Instruksi setelah pernyataan return tidak dijalankan</item><item value=\"2\" correct=\"false\">Instruksi sebelum pernyataan return tidak dijalankan</item><item value=\"3\" correct=\"false\">Fungsi tersebut tidak valid dan sama sekali tidak akan dijalankan</item></selection><p visible-if=\"wrong\">Instruksi setelah pernyataan return tidak dijalankan.</p></body></html>"
          },
          {
            "title": "Lesson #12",
            "id": 148225,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pernyataan return mana yang dijalankan dalam kode ini?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"addTenToScore\" class=\"title\" /><text value=\"(\" /><text value=\"score\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" \" /><text value=\"&quot;Adding ten points to &quot;\" class=\"string\" /><text value=\" + score + \" /><text value=\"&quot;.&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" score + \" /><text value=\"10\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" result = addTenToScore(\" /><text value=\"29\" class=\"number\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(result);\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Pernyataan return pertama</item><item value=\"2\" correct=\"false\">Statement return kedua</item><item value=\"3\" correct=\"false\">Kedua pernyataan return</item></selection><p visible-if=\"wrong\">Pernyataan return pertama.</p></body></html>"
          },
          {
            "title": "Lesson #13",
            "id": 148226,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tampilkan pesan <code>Perfect run</code> dengan menempatkan pernyataan return di posisi yang tepat.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\")\" /></content></option><option startIndex=\"55\" endIndex=\"76\" /><option startIndex=\"81\" endIndex=\"108\" /><option startIndex=\"109\" endIndex=\"110\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"isPerfectRun\" class=\"title\" /><text value=\"(\" /><text value=\"health\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"if\" class=\"keyword\" /><text value=\" (health &gt;= \" /><text value=\"75\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"return\" class=\"keyword\" /><text value=\" \" /><text value=\"&quot;Perfect run&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" \" /><text value=\"&quot;Not a perfect run&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(isPerfectRun(\" /><text value=\"98\" class=\"number\" /><text value=\"));\" /></content></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>return \"Perfect run\";</code>, diikuti oleh <code>return \"Not a perfect run\";</code>, dan terakhir <code>}</code>.</p></body></html>"
          },
          {
            "title": "Lesson #14",
            "id": 148227,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jalankan pernyataan return terakhir dengan menuliskan nilai yang benar.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"300\" /></content></option><option correct=\"false\"><content><text value=\"500\" /></content></option><option startIndex=\"177\" endIndex=\"180\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"tuneGameSpeed\" class=\"title\" /><text value=\"(\" /><text value=\"speed\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"if\" class=\"keyword\" /><text value=\" (speed &lt; \" /><text value=\"375\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"return\" class=\"keyword\" /><text value=\" \" /><text value=\"&quot;Too slow&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\" } \" /><text value=\"else\" class=\"keyword\" /><text value=\" \" /><text value=\"if\" class=\"keyword\" /><text value=\" (speed &gt; \" /><text value=\"425\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"return\" class=\"keyword\" /><text value=\" \" /><text value=\"&quot;Too fast&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" \" /><text value=\"&quot;Just right&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" result = tuneGameSpeed(\" /><text value=\"400\" class=\"number\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(result);\" /></content></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>400</code>.</p></body></html>"
          }
        ]
