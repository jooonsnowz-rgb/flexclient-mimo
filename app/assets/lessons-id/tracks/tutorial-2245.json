            "interactiveContent": "<!DOCTYPE html ><html><body><p>Berapa banyak elemen yang terdapat dalam array kosong?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>0</code></item><item value=\"2\" correct=\"false\"><code>1</code></item><item value=\"3\" correct=\"false\"><code>2</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>0</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Sebuah keranjang dimulai sebagai <code>[]</code> tanpa apa pun di antara kurung siku. Berapa panjangnya?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>0</code></item><item value=\"2\" correct=\"false\"><code>1</code></item><item value=\"3\" correct=\"false\"><code>2</code></item><item value=\"4\" correct=\"false\"><code>undefined</code>, karena elemen pertama tidak ada</item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>0</code>.</p></body></html>"
