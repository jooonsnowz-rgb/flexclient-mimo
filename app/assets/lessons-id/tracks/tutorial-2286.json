          {
            "title": "Example: Commas",
            "id": 91167,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kodekan <code>athlete</code> dan <code>time</code> yang dipisahkan oleh koma <code>,</code> untuk mendapatkan tabel semua atlet dan waktu yang mereka perlukan untuk menyelesaikan perlombaan.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE race (&#xA; athlete varchar(255),&#xA; country varchar(255),&#xA; time varchar(255)&#xA;);&#xA;&#xA;INSERT INTO race (athlete, country, time)&#xA;VALUES ('Vivian Cheruiyot', 'Kenya', '14:26');&#xA;&#xA;INSERT INTO race (athlete, country, time)&#xA;VALUES ('Hellen Onsando Obiri', 'Kenya', '14:29');&#xA;&#xA;INSERT INTO race (athlete, country, time)&#xA;VALUES ('Almaz Ayana', 'Ethiopia', '14:33');&#xA;\"><tables><table name=\"race\"><row><header content=\"athlete\" /><header content=\"country\" /><header content=\"time\" /></row><row><data content=\"Vivian Cheruiyot\" /><data content=\"Kenya\" /><data content=\"14:26\" /></row><row><data content=\"Hellen Onsando Obiri\" /><data content=\"Kenya\" /><data content=\"14:29\" /></row><row><data content=\"Almaz Ayana\" /><data content=\"Ethiopia\" /><data content=\"14:33\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" athlete, \" /><text value=\"time\" class=\"built_in\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" race;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"7\" endIndex=\"20\" /></interactions><output><table name=\"Result\"><row><header content=\"athlete\" /><header content=\"time\" /></row><row><data content=\"Vivian Cheruiyot\" /><data content=\"14:26\" /></row><row><data content=\"Hellen Onsando Obiri\" /><data content=\"14:29\" /></row><row><data content=\"Almaz Ayana\" /><data content=\"14:33\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>athlete, time</code>.</p></body></html>"
          },
          {
            "title": "Question: Selecting with duplicates",
            "id": 91172,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Ada berapa banyak nilai <code>Wii</code> dalam hasil query ini?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE games (&#xA; game varchar(255),&#xA; platform varchar(255),&#xA; year int&#xA;);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('Super Mario', 'NES', 1985);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('Mario Kart', 'Wii', 2008);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('Just Dance', 'Wii', 2009);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('FIFA 16', 'PS4', 2015);&#xA;\"><tables><table name=\"games\"><row><header content=\"game\" /><header content=\"platform\" /><header content=\"year\" /></row><row><data content=\"Super Mario\" /><data content=\"NES\" /><data content=\"1985\" /></row><row><data content=\"Mario Kart\" /><data content=\"Wii\" /><data content=\"2008\" /></row><row><data content=\"Just Dance\" /><data content=\"Wii\" /><data content=\"2009\" /></row><row><data content=\"FIFA 16\" /><data content=\"PS4\" /><data content=\"2015\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" platform\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" games;\" /></content><output><table name=\"Result\"><row><header content=\"platform\" /></row><row><data content=\"NES\" /></row><row><data content=\"Wii\" /></row><row><data content=\"Wii\" /></row><row><data content=\"PS4\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Dua, karena kolom <code>platform</code> memiliki dua nilai <code>Wii</code></item><item value=\"2\" correct=\"false\">Hanya satu, karena duplikat tidak dipilih</item><item value=\"3\" correct=\"false\">Tidak ada nilai <code>Wii</code></item></selection><p visible-if=\"wrong\">Dua, karena kolom <code>platform</code> memiliki dua nilai <code>Wii</code>.</p></body></html>"
          },
          {
            "title": "Example: Select all columns",
            "id": 91164,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Buat query yang memilih semua kolom dari tabel <code>cereals</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE cereals (&#xA;name varchar(255),&#xA;fiber int,&#xA;sugar int&#xA;);&#xA;&#xA;INSERT INTO cereals (name, fiber, sugar)&#xA;VALUES ('Cheerios', 2, 1);&#xA;&#xA;INSERT INTO cereals (name, fiber, sugar)&#xA;VALUES ('Lucky Charms', 0, 12);&#xA;&#xA;INSERT INTO cereals (name, fiber, sugar)&#xA;VALUES ('Cocoa Puffs', 0, 13);&#xA;&#xA;INSERT INTO cereals (name, fiber, sugar)&#xA;VALUES ('100% Bran', 10, 6);&#xA;\"><tables><table name=\"cereals\"><row><header content=\"name\" /><header content=\"fiber\" /><header content=\"sugar\" /></row><row><data content=\"Cheerios\" /><data content=\"2\" /><data content=\"1\" /></row><row><data content=\"Lucky Charms\" /><data content=\"0\" /><data content=\"12\" /></row><row><data content=\"Cocoa Puffs\" /><data content=\"0\" /><data content=\"13\" /></row><row><data content=\"100% Bran\" /><data content=\"10\" /><data content=\"6\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" cereals;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"8\" /><option startIndex=\"9\" endIndex=\"13\" /><option startIndex=\"14\" endIndex=\"21\" /><option startIndex=\"21\" endIndex=\"22\" /><option correct=\"false\"><content><text value=\".\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"fiber\" /><header content=\"sugar\" /></row><row><data content=\"Cheerios\" /><data content=\"2\" /><data content=\"1\" /></row><row><data content=\"Lucky Charms\" /><data content=\"0\" /><data content=\"12\" /></row><row><data content=\"Cocoa Puffs\" /><data content=\"0\" /><data content=\"13\" /></row><row><data content=\"100% Bran\" /><data content=\"10\" /><data content=\"6\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>SELECT</code>, diikuti oleh <code>*</code>, lalu <code>FROM</code>, <code>cereals</code>, <code>;</code>.</p></body></html>"
          },
          {
            "title": "Question: Select *",
            "id": 91165,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa perbedaan antara kedua query ini?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE race (&#xA; athlete varchar(255),&#xA; country varchar(255),&#xA; time varchar(255)&#xA;);&#xA;&#xA;INSERT INTO race (athlete, country, time)&#xA;VALUES ('Vivian Cheruiyot', 'Kenya', '14:26');&#xA;&#xA;INSERT INTO race (athlete, country, time)&#xA;VALUES ('Hellen Onsando Obiri', 'Kenya', '14:29');&#xA;&#xA;INSERT INTO race (athlete, country, time)&#xA;VALUES ('Almaz Ayana', 'Ethiopia', '14:33');&#xA;\"><tables><table name=\"race\"><row><header content=\"athlete\" /><header content=\"country\" /><header content=\"time\" /></row><row><data content=\"Vivian Cheruiyot\" /><data content=\"Kenya\" /><data content=\"14:26\" /></row><row><data content=\"Hellen Onsando Obiri\" /><data content=\"Kenya\" /><data content=\"14:29\" /></row><row><data content=\"Almaz Ayana\" /><data content=\"Ethiopia\" /><data content=\"14:33\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" race;\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" athlete, country, \" /><text value=\"time\" class=\"built_in\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" race;\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Tidak ada perbedaan, kedua query memilih semua kolom dari tabel <code>race</code></item><item value=\"2\" correct=\"false\">Query pertama tidak memilih apa pun, sedangkan query kedua memilih semua kolom</item><item value=\"3\" correct=\"false\">Kueri pertama tidak memiliki pernyataan <code>SELECT</code></item></selection><p visible-if=\"wrong\">Tidak ada perbedaan, kedua query memilih semua kolom dari tabel <code>race</code>.</p></body></html>"
          },
          {
            "title": "Example: Distinct",
            "id": 91174,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tulis <code>SELECT</code>, diikuti <code>DISTINCT</code> dan kolom <code>platform</code>, untuk hanya memilih nilai <code>platform</code> yang unik.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE games (&#xA; game varchar(255),&#xA; platform varchar(255),&#xA; year int&#xA;);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('Super Mario', 'NES', 1985);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('Mario Kart', 'Wii', 2008);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('Just Dance', 'Wii', 2009);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('FIFA 16', 'PS4', 2015);&#xA;\"><tables><table name=\"games\"><row><header content=\"game\" /><header content=\"platform\" /><header content=\"year\" /></row><row><data content=\"Super Mario\" /><data content=\"NES\" /><data content=\"1985\" /></row><row><data content=\"Mario Kart\" /><data content=\"Wii\" /><data content=\"2008\" /></row><row><data content=\"Just Dance\" /><data content=\"Wii\" /><data content=\"2009\" /></row><row><data content=\"FIFA 16\" /><data content=\"PS4\" /><data content=\"2015\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"DISTINCT\" class=\"keyword\" /><text value=\" platform\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" games;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"0\" endIndex=\"24\" /></interactions><output><table name=\"Result\"><row><header content=\"platform\" /></row><row><data content=\"NES\" /></row><row><data content=\"Wii\" /></row><row><data content=\"PS4\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>SELECT DISTINCT platform</code>.</p></body></html>"
          },
          {
            "title": "Question: Ascending by default ",
            "id": 91780,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Query mana yang mengurutkan item secara menaik berdasarkan <code>score</code>?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" score;\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" score \" /><text value=\"ASC\" class=\"keyword\" /><text value=\";\" /><text type=\"break\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Keduanya</item><item value=\"2\" correct=\"false\">Yang pertama</item><item value=\"3\" correct=\"false\">Yang kedua</item></selection><p visible-if=\"wrong\">Pastikan kamu memilih Keduanya.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Para siswa memiliki skor <code>90</code>, <code>40</code>, dan <code>70</code>. Query yang ditampilkan mana yang mengembalikannya dalam urutan <code>40</code>, <code>70</code>, <code>90</code>?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" score;\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" score \" /><text value=\"ASC\" class=\"keyword\" /><text value=\";\" /><text type=\"break\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Keduanya</item><item value=\"2\" correct=\"false\">Yang pertama</item><item value=\"3\" correct=\"false\">Yang kedua</item><item value=\"4\" correct=\"false\">Tidak ada, karena urutan menaik selalu memerlukan <code>ASCENDING</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih Keduanya.</p></body></html>"
          },
          {
            "title": "Example: Order by ",
            "id": 91776,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Susun ulang item dalam tabel <code>students</code> berdasarkan <code>score</code> dengan <code>ORDER BY score</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; score int&#xA;);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Jean Miller', 5);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Emma Brown', 8);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Reese Jones', 2);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Kim Lee', 9);&#xA;\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"score\" /></row><row><data content=\"Jean Miller\" /><data content=\"5\" /></row><row><data content=\"Emma Brown\" /><data content=\"8\" /></row><row><data content=\"Reese Jones\" /><data content=\"2\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" score;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"23\" endIndex=\"37\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"score\" /></row><row><data content=\"Reese Jones\" /><data content=\"2\" /></row><row><data content=\"Jean Miller\" /><data content=\"5\" /></row><row><data content=\"Emma Brown\" /><data content=\"8\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>ORDER BY score</code>.</p></body></html>"
          },
          {
            "title": "Question: Alphabetical order",
            "id": 91778,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Nilai mana yang muncul lebih dulu saat kita mengurutkan berdasarkan properti teks?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Nilai dengan huruf yang berada di awal alfabet muncul terlebih dahulu</item><item value=\"2\" correct=\"false\">Kita tidak bisa tahu, pengurutan berdasarkan properti teks menghasilkan hasil acak</item><item value=\"3\" correct=\"false\">Kita tidak bisa mengurutkan berdasarkan properti teks</item></selection><p visible-if=\"wrong\">Nilai dengan huruf yang berada di awal alfabet muncul terlebih dahulu.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Sebuah properti teks berisi <code>\"Zoe\"</code>, <code>\"Ava\"</code>, dan <code>\"Mia\"</code>. Nilai mana yang muncul pertama dalam urutan menaik?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>\"Ava\"</code>, karena huruf pertamanya muncul paling awal dalam alfabet</item><item value=\"2\" correct=\"false\"><code>\"Zoe\"</code>, karena nilai teks diurutkan dari akhir alfabet</item><item value=\"3\" correct=\"false\"><code>\"Mia\"</code>, karena nilai tengah tetap berada di awal</item><item value=\"4\" correct=\"false\">Tidak ada nilai, karena properti teks tidak dapat diurutkan</item></selection><p visible-if=\"wrong\"><code>\"Ava\"</code>, karena huruf pertamanya muncul paling awal dalam alfabet.</p></body></html>"
          },
          {
            "title": "Question: Descending order",
            "id": 91781,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bagaimana query ini mengurutkan item?<br /></p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" score \" /><text value=\"DESC\" class=\"keyword\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Dalam urutan menurun</item><item value=\"2\" correct=\"false\">Dalam urutan menaik</item><item value=\"3\" correct=\"false\">Urutan yang sama, karena <code>DESC</code> bukan kata kunci yang valid</item></selection><p visible-if=\"wrong\">Dalam urutan menurun.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Para siswa memiliki skor <code>42</code>, <code>95</code>, dan <code>70</code>. Dalam urutan apa query mengembalikannya?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" score \" /><text value=\"DESC\" class=\"keyword\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>95</code>, <code>70</code>, <code>42</code></item><item value=\"2\" correct=\"false\"><code>42</code>, <code>70</code>, <code>95</code></item><item value=\"3\" correct=\"false\"><code>42</code>, <code>95</code>, <code>70</code>, karena <code>DESC</code> mempertahankan urutan penyimpanan</item><item value=\"4\" correct=\"false\">Tidak ada baris, karena <code>DESC</code> memfilter skor yang lebih rendah</item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>95</code>, <code>70</code>, <code>42</code>.</p></body></html>"
          },
          {
            "title": "Example: Descending order",
            "id": 91784,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kodekan keyword agar item dengan nilai <code>name</code><code>Reese Jones</code> berada di urutan pertama.<br /></p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; score int&#xA;);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Jean Miller', 5);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Emma Brown', 8);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Reese Jones', 2);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Kim Lee', 9);&#xA;\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"score\" /></row><row><data content=\"Jean Miller\" /><data content=\"5\" /></row><row><data content=\"Emma Brown\" /><data content=\"8\" /></row><row><data content=\"Reese Jones\" /><data content=\"2\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"DESC\" class=\"keyword\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"37\" endIndex=\"41\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"score\" /></row><row><data content=\"Reese Jones\" /><data content=\"2\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row><row><data content=\"Jean Miller\" /><data content=\"5\" /></row><row><data content=\"Emma Brown\" /><data content=\"8\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>DESC</code>.</p></body></html>"
          },
          {
            "title": "Question: The `=` operator 2",
            "id": 91793,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jenis item apa yang difilter oleh query ini?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" books\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" title = \" /><text value=\"'The Prince'\" class=\"string\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Item buku dengan properti <code>title</code> yang sama dengan <code>'The Prince'</code></item><item value=\"2\" correct=\"false\">Item buku dengan properti <code>title</code> yang berbeda dari <code>'The Prince'</code></item><item value=\"3\" correct=\"false\">Item buku dengan semua properti yang sama dengan <code>'The Prince'</code></item></selection><p visible-if=\"wrong\">Item buku dengan properti <code>title</code> yang sama dengan <code>'The Prince'</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Tabel memiliki dua buku berjudul <code>'The Prince'</code> dan satu berjudul <code>'The Little Prince'</code>. Baris mana yang dikembalikan query?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" books\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" title = \" /><text value=\"'The Prince'\" class=\"string\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Kedua baris dengan <code>title</code> yang sama dengan <code>'The Prince'</code></item><item value=\"2\" correct=\"false\">Hanya baris berjudul <code>'The Little Prince'</code></item><item value=\"3\" correct=\"false\">Ketiga baris, karena <code>SELECT *</code> mengabaikan filter</item><item value=\"4\" correct=\"false\">Hanya baris pertama yang cocok, karena <code>WHERE</code> berhenti setelah satu kecocokan</item></selection><p visible-if=\"wrong\">Kedua baris dengan <code>title</code> yang sama dengan <code>'The Prince'</code>.</p></body></html>"
          },
          {
            "title": "Example: WHERE",
            "id": 91791,
