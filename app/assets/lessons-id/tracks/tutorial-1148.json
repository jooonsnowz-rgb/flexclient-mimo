            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Untuk apa f-string digunakan?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Untuk menampilkan berbagai jenis nilai secara bersamaan dalam sebuah string</item><item value=\"2\" correct=\"false\">Untuk menampilkan nilai string secara bersamaan</item></selection><p visible-if=\"wrong\">Untuk menampilkan berbagai jenis nilai secara bersamaan dalam sebuah string.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Kamu ingin satu pesan yang berisi nama dan angka skor. Untuk apa f-string digunakan?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Untuk menampilkan berbagai jenis nilai secara bersamaan dalam sebuah string</item><item value=\"2\" correct=\"false\">Untuk menampilkan hanya nilai string secara bersamaan</item><item value=\"3\" correct=\"false\">Untuk memformat hanya angka floating-point</item></selection><p visible-if=\"wrong\">Untuk menampilkan berbagai jenis nilai secara bersamaan dalam sebuah string.</p></body></html>"
