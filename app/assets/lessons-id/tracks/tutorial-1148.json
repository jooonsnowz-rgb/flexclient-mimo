            "hardModeContent": "<!DOCTYPE html ><html><body><p>Lengkapi baris agar console menampilkan <code>4 dataset entries</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"print(\" /><text value=\"f&quot;\" /><text value=\"{\" /><text value=\"4\" class=\"number\" /><text value=\"}\" /><text value=\" dataset entries&quot;\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"6\" endIndex=\"28\" /><option correct=\"false\"><content><text value=\"&quot;4 dataset entries&quot;\" /></content></option><option correct=\"false\"><content><text value=\"&quot;{4} dataset entries&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"4 dataset entries\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>f\"{4} dataset entries\"</code>.</p></body></html>"
