            "interactiveContent": "<!DOCTYPE html ><html><body><p>Berapa banyak subclass yang bisa kamu buat dari sebuah superclass?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Sebanyak yang kamu mau</item><item value=\"2\" correct=\"false\">Maksimal sepuluh</item></selection><p visible-if=\"wrong\">Sebanyak yang kamu mau.</p></body></html>"
