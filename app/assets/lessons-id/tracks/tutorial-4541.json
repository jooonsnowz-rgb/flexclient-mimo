            "id": 149943,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jika kita mengubah properti sebuah class, apa yang akan terjadi pada semua instance yang dibuat dari class tersebut?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Semua instance akan memiliki properti yang sama seperti class yang diperbarui</item><item value=\"2\" correct=\"false\">Tidak ada</item></selection><p visible-if=\"wrong\">Semua instance akan memiliki properti yang sama seperti class yang diperbarui.</p></body></html>"
          },
