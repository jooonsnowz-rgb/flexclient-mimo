            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apakah constructor class selalu perlu memiliki properti agar kode dapat berjalan?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Tidak, constructor juga bisa kosong</item><item value=\"2\" correct=\"false\">Ya, jika tidak, kode tidak akan berjalan</item></selection><p visible-if=\"wrong\">Tidak, constructor juga bisa kosong.</p></body></html>"
          },
