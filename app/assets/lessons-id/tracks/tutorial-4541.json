            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apakah kita hanya bisa memperbarui properti class?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Tidak, kita juga dapat menambahkan dan memperbarui method</item><item value=\"2\" correct=\"false\">Ya, kita hanya bisa menambahkan dan memperbarui properti</item></selection><p visible-if=\"wrong\">Tidak, kita juga dapat menambahkan dan memperbarui method.</p></body></html>"
          },
