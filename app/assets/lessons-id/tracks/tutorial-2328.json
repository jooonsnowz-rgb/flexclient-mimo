            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang ditampilkan di console?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"monthly_balance = [\" /><text value=\"-2\" class=\"number\" /><text value=\", \" /><text value=\"-1\" class=\"number\" /><text value=\", \" /><text value=\"0\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text value=\"print(sum(monthly_balance))\" /><text type=\"break\" /></content><output><content><text value=\"-3\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>-3</code></item><item value=\"2\" correct=\"false\"><code>3</code></item><item value=\"3\" correct=\"false\"><code>sum(monthly_balance)</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>-3</code>.</p></body></html>",
