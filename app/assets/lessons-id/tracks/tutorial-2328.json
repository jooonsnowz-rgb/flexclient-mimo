            "id": 82741,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Urutkan pengukuran tinggi ini dalam urutan menaik dengan <code>.sort()</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"heights = [\" /><text value=\"166\" class=\"number\" /><text value=\", \" /><text value=\"172.6\" class=\"number\" /><text value=\", \" /><text value=\"159.4\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text value=\"heights.sort()\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(heights)\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"37\" endIndex=\"44\" /></interactions><output><content><text value=\"[159.4, 166, 172.6]\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>.sort()</code>.</p></body></html>"
