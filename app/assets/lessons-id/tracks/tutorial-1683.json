              "files": [
                {
                  "name": "index.html",
                  "codeLanguage": "html",
                  "content": "<!doctype html>\n<html>\n  <head>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n  <body>\n    <h2>Sudoku Puzzle</h2>\n    <div>\n      <div class=\"grid-item\">1</div>\n      <div class=\"grid-item\"></div>\n      <div class=\"grid-item\"></div>\n      <div class=\"grid-item\">3</div>\n      <div class=\"grid-item\">2</div>\n      <div class=\"grid-item\"></div>\n      <div class=\"grid-item\"></div>\n      <div class=\"grid-item\"></div>\n      <div class=\"grid-item\">1</div>\n    </div>\n  </body>\n</html>",
