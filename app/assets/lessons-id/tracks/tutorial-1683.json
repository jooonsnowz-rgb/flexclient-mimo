                {
                  "name": "style.css",
                  "codeLanguage": "css",
                  "content": ".grid-container {\n  display: grid;\n}\n\n.grid-item {\n  text-align: center;\n  font-weight: bold;\n  color: #2980B9;\n  background-color: #D6EAF8;\n  margin: 2px;\n}\n\nh2 {\n  color: #2980B9;\n}",
