            "title": "Example: Function name",
            "id": 127097,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Beri fungsi ini nama dalam camel case.</p><code name=\"main.swift\" version=\"2\" codelang=\"swift\"><content><text value=\"func\" class=\"keyword\" /><text value=\" \" /><text value=\"nightRoutine\" class=\"title\" /><text value=\"()\" class=\"params\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Lights off&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Alarm set&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"nightRoutine()\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"nightroutine\" /></content></option><option startIndex=\"5\" endIndex=\"17\" /></options></interaction></interactions><output><content><text value=\"Lights off\" /><text type=\"break\" /><text value=\"Alarm set\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>nightRoutine</code>.</p></body></html>"
