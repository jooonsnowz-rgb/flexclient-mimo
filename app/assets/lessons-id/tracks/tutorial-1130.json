            "interactiveContent": "<!DOCTYPE html ><html><body><p>Mengapa kita menggunakan beberapa class CSS?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Untuk menggabungkan beberapa style dalam HTML kita</item><item value=\"2\" correct=\"false\">Untuk membuat lebih banyak class CSS yang melakukan hal yang sama</item></selection><p visible-if=\"wrong\">Untuk menggabungkan beberapa style dalam HTML kita.</p></body></html>",
