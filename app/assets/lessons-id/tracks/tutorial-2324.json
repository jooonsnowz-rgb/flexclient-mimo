            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa itu indeks?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Posisi bernomor dari elemen dalam list</item><item value=\"2\" correct=\"false\">Nilai elemen dalam list</item><item value=\"3\" correct=\"false\">Elemen dalam list</item></selection><p visible-if=\"wrong\">Posisi bernomor dari elemen dalam list.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Indeks adalah posisi bernomor dari elemen dalam list.</p><p>Sebuah list skor berisi <code>[90, 85, 78]</code>. Apa itu <code>85</code> dalam list tersebut?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Nilai yang disimpan pada sebuah indeks</item><item value=\"2\" correct=\"false\">Indeks itu sendiri</item><item value=\"3\" correct=\"false\">Jumlah elemen dalam list</item></selection><p visible-if=\"wrong\">Nilai yang disimpan pada sebuah indeks.</p></body></html>",
            "hardModeSelected": true
