            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa sebutan untuk objek-objek yang membentuk scene tree sebuah game?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Node</item><item value=\"2\" correct=\"false\">Percabangan</item></selection><p visible-if=\"wrong\">Pastikan kamu memilih Node.</p></body></html>"
