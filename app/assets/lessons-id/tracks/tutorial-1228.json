            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pisahkan string <code>path</code> dengan pemisah <code>\"/\"</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"path = \" /><text value=\"&quot;mimo.org/course/python&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"path_list = path.split(\" /><text value=\"&quot;/&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(path_list)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"50\" endIndex=\"55\" /><option startIndex=\"55\" endIndex=\"56\" /><option startIndex=\"56\" endIndex=\"57\" /><option startIndex=\"57\" endIndex=\"58\" /><option startIndex=\"58\" endIndex=\"59\" /><option startIndex=\"59\" endIndex=\"60\" /></options></interaction></interactions><output><content><text value=\"['mimo.org', 'course', 'python']\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>split</code>, diikuti oleh <code>(</code>, lalu <code>\"</code>, <code>/</code>, <code>\"</code>, <code>)</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Pisahkan <code>path</code> pada karakter <code>\"/\"</code> agar konsol menampilkan <code>['mimo.org', 'course', 'python']</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"path = \" /><text value=\"&quot;mimo.org/course/python&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"path_list = path.split(\" /><text value=\"&quot;/&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(path_list)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"50\" endIndex=\"55\" /><option startIndex=\"55\" endIndex=\"56\" /><option startIndex=\"56\" endIndex=\"57\" /><option startIndex=\"57\" endIndex=\"58\" /><option startIndex=\"58\" endIndex=\"59\" /><option startIndex=\"59\" endIndex=\"60\" /><option correct=\"false\"><content><text value=\".\" /></content></option></options></interaction></interactions><output><content><text value=\"['mimo.org', 'course', 'python']\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>split</code>, diikuti oleh <code>(</code>, <code>\"</code>, <code>/</code>, <code>\"</code>, dan terakhir <code>)</code>.</p></body></html>",
