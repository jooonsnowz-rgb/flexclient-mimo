            "title": "Example: Whitespace",
            "id": 82708,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Gunakan <code>.split()</code> untuk memisahkan string <code>pollution</code> berdasarkan spasi kosong.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"pollution = \" /><text value=\"&quot;55ppm 44ppm 22ppm 66ppm&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"pollution_list = pollution.split()\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(pollution_list)\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"65\" endIndex=\"73\" /></interactions><output><content><text value=\"['55ppm', '44ppm', '22ppm', '66ppm']\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>.split()</code>.</p></body></html>"
