            "interactiveContent": "<!DOCTYPE html ><html><body><p>Berapa banyak nilai yang bisa kita simpan dalam sebuah array?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Sebanyak yang kita inginkan</item><item value=\"2\" correct=\"false\">3</item></selection><p visible-if=\"wrong\">Sebanyak yang kita inginkan.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Sebuah game terus menambahkan nama pemain ke satu array. Berapa banyak nilai yang dapat disimpan array tersebut?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Sebanyak yang kita inginkan</item><item value=\"2\" correct=\"false\">3</item><item value=\"3\" correct=\"false\">Hanya sebanyak jumlah yang ditulis saat array dibuat.</item></selection><p visible-if=\"wrong\">Sebanyak yang kita inginkan.</p></body></html>"
