            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kapan kita bisa menggunakan <code>print()</code> untuk menampilkan nilai sebuah variabel?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">Setelah kita membuat variabel</item><item correct=\"false\" value=\"2\">Sebelum kita membuat variabel</item><item correct=\"false\" value=\"2\">Sebelum atau setelah kita membuat variabel</item></selection><p visible-if=\"wrong\">Setelah kita membuat variabel.</p></body></html>"
          },
          {
