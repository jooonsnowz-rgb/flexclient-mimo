            "id": 146680,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa sebutan untuk kurung kurawal <code>{ }</code> dan kode di dalamnya?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"while\" class=\"keyword\" /><text value=\" (\" /><text value=\"false\" class=\"literal\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Spawn enemy&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Blok kode</item><item value=\"2\" correct=\"false\">Sebuah kondisi</item></selection><p visible-if=\"wrong\">Blok kode.</p></body></html>"
          },
          {
