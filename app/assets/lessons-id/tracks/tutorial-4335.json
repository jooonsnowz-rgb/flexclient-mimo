            "interactiveContent": "<!DOCTYPE html ><html><body><p>Buat loop tak terbatas dengan menetapkan kondisinya ke <code>true</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"7\" endIndex=\"11\" isDefault=\"true\" /></interactions><content><text value=\"while\" class=\"keyword\" /><text value=\" (\" /><text value=\"true\" class=\"literal\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Update,&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Render!&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>true</code>.</p></body></html>"
