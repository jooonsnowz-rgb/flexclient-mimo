            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Di dalam tanda kurung, tambahkan nilai variabel counter.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"303\" class=\"number\" /><text value=\"; i &lt; \" /><text value=\"306\" class=\"number\" /><text value=\"; i++) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(i);\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"27\" endIndex=\"30\" /><option correct=\"false\"><content><text value=\"counter++\" /></content></option><option correct=\"false\"><content><text value=\"i--\" /></content></option></options></interaction></interactions><output><content><text value=\"303\" /><text type=\"break\" /><text value=\"304\" /><text type=\"break\" /><text value=\"305\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>i++</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Tampilkan <code>303</code>, <code>304</code>, dan <code>305</code>. Letakkan operator update setelah nama counter.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"303\" class=\"number\" /><text value=\"; i &lt; \" /><text value=\"306\" class=\"number\" /><text value=\"; i++) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(i);\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"13\" endIndex=\"16\" /><option startIndex=\"22\" endIndex=\"25\" /><option startIndex=\"27\" endIndex=\"28\" /><option startIndex=\"28\" endIndex=\"30\" /><option correct=\"false\"><content><text value=\"--\" /></content></option><option correct=\"false\"><content><text value=\"304\" /></content></option><option correct=\"false\"><content><text value=\"305\" /></content></option></options></interaction></interactions><output><content><text value=\"303\" /><text type=\"break\" /><text value=\"304\" /><text type=\"break\" /><text value=\"305\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>303</code>, diikuti oleh <code>306</code>, <code>i</code>, dan terakhir <code>++</code>.</p></body></html>",
