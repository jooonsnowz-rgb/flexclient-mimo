            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang ditampilkan kode ini di konsol?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"displayLevelUnlocked\" class=\"title\" /><text value=\"(\" /><text value=\"level\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" \" /><text value=\"&quot;Level unlocked: &quot;\" class=\"string\" /><text value=\" + level;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" text = displayLevelUnlocked(\" /><text value=\"5\" class=\"number\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(text);\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>Level terbuka: 5</code></item><item value=\"2\" correct=\"false\">Tidak ada yang ditampilkan di konsol</item><item value=\"3\" correct=\"false\"><code>5</code></item></selection><p visible-if=\"wrong\"><code>Level terbuka: 5</code>.</p></body></html>"
