            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang kita tulis setelah nama objek untuk mengakses properti?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Titik <code>.</code> dan nama properti</item><item value=\"2\" correct=\"false\">Tanda tanya <code>?</code></item></selection><p visible-if=\"wrong\">Titik <code>.</code> dan nama properti.</p></body></html>"
