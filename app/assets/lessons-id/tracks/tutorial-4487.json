            "id": 149042,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Instruksi apa yang kita gunakan untuk membuat elemen baru?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>document.createElement()</code></item><item value=\"2\" correct=\"false\"><code>document.getElementById()</code></item><item value=\"3\" correct=\"false\"><code>parent.appendChild()</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>document.createElement()</code>.</p></body></html>"
