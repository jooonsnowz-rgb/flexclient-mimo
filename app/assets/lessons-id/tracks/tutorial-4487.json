            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kode mana yang bisa kita gunakan untuk mengakses node <code>body</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>document.body</code></item><item value=\"2\" correct=\"false\"><code>document.html.body</code></item><item value=\"3\" correct=\"false\"><code>document.nextElementSibling</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>document.body</code>.</p></body></html>"
