            "id": 149032,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kita merepresentasikan scene UI game sebagai tree. Bagian mana yang dianggap sebagai node?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Semua elemen UI dan teksnya</item><item value=\"2\" correct=\"false\">Hanya elemen yang tidak memiliki tag penutup</item><item value=\"3\" correct=\"false\">Hanya elemen yang memiliki elemen turunan</item></selection><p visible-if=\"wrong\">Semua elemen UI dan teksnya.</p></body></html>"
