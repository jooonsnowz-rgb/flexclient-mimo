            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kapan kita menggunakan instruksi <code>.appendChild()</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Saat kita ingin menambahkan elemen anak di dalam elemen induk</item><item value=\"2\" correct=\"false\">Ketika kita ingin membuat elemen baru</item><item value=\"3\" correct=\"false\">Saat kita ingin menghapus sebuah elemen</item></selection><p visible-if=\"wrong\">Saat kita ingin menambahkan elemen anak di dalam elemen induk.</p></body></html>"
