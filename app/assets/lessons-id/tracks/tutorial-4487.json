            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kode apa yang ditulis di antara tanda kurung <code>document.createElement()</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Jenis elemen, seperti <code>\"img\"</code> untuk elemen <code>img</code></item><item value=\"2\" correct=\"false\">Nilai ID elemen</item><item value=\"3\" correct=\"false\">Nama variabel yang menyimpan elemen</item></selection><p visible-if=\"wrong\">Jenis elemen, seperti <code>\"img\"</code> untuk elemen <code>img</code>.</p></body></html>"
