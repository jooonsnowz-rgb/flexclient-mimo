            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang direpresentasikan oleh keyword <code>document</code> dalam tree UI game?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Node elemen html root</item><item value=\"2\" correct=\"false\">Node elemen body</item><item value=\"3\" correct=\"false\">Node elemen dokumen head</item></selection><p visible-if=\"wrong\">Node elemen html root.</p></body></html>"
