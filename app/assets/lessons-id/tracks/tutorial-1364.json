            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tetapkan set yang valid ke variabel <code>cities</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"cities = {\" /><text value=\"&quot;Kyoto&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Oslo&quot;\" class=\"string\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"9\" endIndex=\"26\" /><option correct=\"false\"><content><text value=\"{&quot;Kyoto&quot;, &quot;Kyoto&quot;, &quot;Oslo&quot;}\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>{\"Kyoto\", \"Oslo\"}</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Simpan <code>\"Kyoto\"</code> dan <code>\"Oslo\"</code> dalam set bernama <code>cities</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"cities = {\" /><text value=\"&quot;Kyoto&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Oslo&quot;\" class=\"string\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"9\" endIndex=\"26\" /><option correct=\"false\"><content><text value=\"[&quot;Kyoto&quot;, &quot;Oslo&quot;]\" /></content></option><option correct=\"false\"><content><text value=\"(&quot;Kyoto&quot;, &quot;Oslo&quot;)\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>{\"Kyoto\", \"Oslo\"}</code>.</p></body></html>",
            "hardModeSelected": true
