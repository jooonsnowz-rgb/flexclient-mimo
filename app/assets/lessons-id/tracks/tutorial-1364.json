            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kita memisahkan nilai set seperti <code>\"SW1A\"</code> dan <code>\"SY3\"</code> menggunakan koma <code>,</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"postcodes = {\" /><text value=\"&quot;SW1A&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;SY3&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;B44&quot;\" class=\"string\" /><text value=\"}\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"19\" endIndex=\"20\" /></interactions></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>,</code>.</p></body></html>"
