          {
            "title": "Question: Intro",
            "id": 89451,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kapan kita menggunakan set?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Saat kita ingin memastikan kumpulan nilai kita tidak memiliki duplikat</item><item value=\"2\" correct=\"false\">Ketika kita ingin bisa memiliki duplikat dalam kumpulan nilai kita</item></selection><p visible-if=\"wrong\">Saat kita ingin memastikan kumpulan nilai kita tidak memiliki duplikat.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Kita menggunakan set saat kumpulan tidak boleh memiliki nilai duplikat.</p><p>Catatan pendaftaran harus menyimpan setiap alamat email hanya satu kali. Kumpulan mana yang sesuai?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Set</item><item value=\"2\" correct=\"false\">List yang mengizinkan alamat email berulang</item><item value=\"3\" correct=\"false\">Tuple yang mempertahankan setiap duplikat</item></selection><p visible-if=\"wrong\">Pastikan kamu memilih Set.</p></body></html>"
          },
          {
            "title": "Question: Intro 2",
            "id": 89452,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa itu set?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Kumpulan nilai yang unik</item><item value=\"2\" correct=\"false\">Kumpulan nilai yang setiap nilainya dapat muncul lebih dari sekali</item></selection><p visible-if=\"wrong\">Kumpulan nilai yang unik.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Set adalah kumpulan nilai unik.</p><p>Berapa banyak nilai unik dalam <code>{\"red\", \"blue\", \"red\"}</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Dua</item><item value=\"2\" correct=\"false\">Tiga karena kedua salinan <code>\"red\"</code> tetap ada</item><item value=\"3\" correct=\"false\">Tidak ada karena duplikat membuat set tidak valid</item></selection><p visible-if=\"wrong\">Pastikan kamu memilih Dua.</p></body></html>"
          },
          {
            "title": "Question: Curly braces",
            "id": 89453,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Berdasarkan apa kita dapat mengenali suatu set?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Kurung kurawalnya <code>{}</code></item><item value=\"2\" correct=\"false\">Tanda kurung siku <code>[]</code>-nya</item></selection><p visible-if=\"wrong\">Kurung kurawalnya <code>{}</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Literal set yang tidak kosong memakai kurung kurawal di sekitar nilai yang dipisahkan koma.</p><p>Kumpulan mana yang merupakan set?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>{\"red\", \"blue\"}</code></item><item value=\"2\" correct=\"false\"><code>[\"red\", \"blue\"]</code></item><item value=\"3\" correct=\"false\"><code>(\"red\", \"blue\")</code></item><item value=\"4\" correct=\"false\"><code>{\"red\": \"blue\"}</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>{\"red\", \"blue\"}</code>.</p></body></html>"
          },
