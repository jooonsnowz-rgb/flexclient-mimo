            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bagaimana cara memisahkan nilai di dalam set?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Menggunakan koma <code>,</code></item><item value=\"2\" correct=\"false\">Menggunakan titik koma <code>;</code></item></selection><p visible-if=\"wrong\">Menggunakan koma <code>,</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Kita menggunakan koma <code>,</code> untuk memisahkan nilai di dalam set.</p><p>Simbol mana yang harus menggantikan <code>;</code> dalam <code>{\"red\"; \"blue\"}</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Koma <code>,</code></item><item value=\"2\" correct=\"false\">Titik dua <code>:</code></item><item value=\"3\" correct=\"false\">Tidak ada simbol karena nilai set saling berdempetan</item></selection><p visible-if=\"wrong\">Pastikan kamu memilih Koma <code>,</code>.</p></body></html>",
