          {
            "title": "Example: Curly braces",
            "id": 89458,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Buat satu set angka genap yang diapit oleh kurung kurawal.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"even_nums = {\" /><text value=\"0\" class=\"number\" /><text value=\", \" /><text value=\"2\" class=\"number\" /><text value=\", \" /><text value=\"4\" class=\"number\" /><text value=\", \" /><text value=\"6\" class=\"number\" /><text value=\"}\" /><text type=\"break\" /><text value=\"print(even_nums)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"12\" endIndex=\"13\" /><option startIndex=\"13\" endIndex=\"23\" /><option startIndex=\"23\" endIndex=\"24\" /><option correct=\"false\"><content><text value=\"[\" /></content></option><option correct=\"false\"><content><text value=\"]\" /></content></option></options></interaction></interactions><output><content><text value=\"{0, 2, 4, 6}\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>{</code>, diikuti oleh <code>0, 2, 4, 6</code>, dan terakhir <code>}</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Buat set angka genap agar kode menampilkan <code>{0, 2, 4, 6}</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"even_nums = {\" /><text value=\"0\" class=\"number\" /><text value=\", \" /><text value=\"2\" class=\"number\" /><text value=\", \" /><text value=\"4\" class=\"number\" /><text value=\", \" /><text value=\"6\" class=\"number\" /><text value=\"}\" /><text type=\"break\" /><text value=\"print(even_nums)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"12\" endIndex=\"13\" /><option startIndex=\"13\" endIndex=\"23\" /><option startIndex=\"23\" endIndex=\"24\" /><option correct=\"false\"><content><text value=\"[\" /></content></option><option correct=\"false\"><content><text value=\"]\" /></content></option></options></interaction></interactions><output><content><text value=\"{0, 2, 4, 6}\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>{</code>, diikuti oleh <code>0, 2, 4, 6</code>, dan terakhir <code>}</code>.</p></body></html>"
