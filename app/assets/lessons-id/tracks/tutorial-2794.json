            "id": 130800,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pilih tipe objek yang benar agar kode dapat berfungsi.</p><code version=\"2\" codelang=\"typescript\" name=\"script.ts\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" person: {\" /><text type=\"break\" /><text value=\" name: \" /><text value=\"string\" class=\"built_in\" /><text value=\",\" /><text type=\"break\" /><text value=\" age: \" /><text value=\"number\" class=\"built_in\" /><text type=\"break\" /><text value=\"} = {\" /><text type=\"break\" /><text value=\" name: \" /><text value=\"&quot;Karen&quot;\" class=\"string\" /><text value=\",\" /><text type=\"break\" /><text value=\" age: \" /><text value=\"33\" class=\"number\" /><text type=\"break\" /><text value=\"};\" /><text type=\"break\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(person.name);\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(person.age);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"30\" endIndex=\"41\" /><option correct=\"false\"><content><text value=\"name = string\" /></content></option><option correct=\"false\"><content><text value=\"age = number\" /></content></option><option startIndex=\"15\" endIndex=\"28\" /></options></interaction></interactions><output><content><text value=\"Karen\" /><text type=\"break\" /><text value=\"33\" /><text type=\"break\" /><text value=\"\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>name: string,</code>, diikuti oleh <code>age: number</code>.</p></body></html>"
