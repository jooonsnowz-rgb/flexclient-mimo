            "interactiveContent": "<!DOCTYPE html ><html><body><p>Nilai apa yang dapat kita tetapkan ke atribut dalam objek <code>animal</code>?</p><code version=\"2\" codelang=\"typescript\" name=\"script.ts\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" animal: {\" /><text type=\"break\" /><text value=\" species: \" /><text value=\"string\" class=\"built_in\" /><text value=\" | \" /><text value=\"number\" class=\"built_in\" /><text type=\"break\" /><text value=\"};\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"false\">Hanya string</item><item value=\"2\" correct=\"true\">String atau angka</item></selection><p visible-if=\"wrong\">String atau angka.</p></body></html>"
