            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tambahkan pernyataan print ke metode <code>call</code> yang mencetak variabel <code>first</code> dan <code>last</code> milik class.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"Contact\" class=\"title\" /><text value=\":\" /><text type=\"break\" /><text value=\"  first = \" /><text value=\"&quot;Jane&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"  last = \" /><text value=\"&quot;Doe&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"  cell = \" /><text value=\"&quot;3112445656&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"  email = \" /><text value=\"&quot;jdoe@gmail.com&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"  \" /><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"get_cell\" class=\"title\" /><text value=\"(self)\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\"    print(self.cell)\" /><text type=\"break\" /><text value=\"    \" /><text type=\"break\" /><text value=\"  \" /><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"call\" class=\"title\" /><text value=\"(self)\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\"    print(\" /><text value=\"&quot;calling...&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"    print(self.first, self.last)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"197\" endIndex=\"201\" /><option startIndex=\"201\" endIndex=\"202\" /><option startIndex=\"202\" endIndex=\"207\" /><option startIndex=\"207\" endIndex=\"208\" /><option startIndex=\"214\" endIndex=\"218\" /><option correct=\"false\"><content><text value=\"def\" /></content></option><option correct=\"false\"><content><text value=\"class\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>self</code>, diikuti oleh <code>.</code>, lalu <code>first</code>, <code>,</code>, <code>last</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Dalam <code>call</code>, cetak variabel instance <code>first</code>, lalu <code>last</code>, sesuai urutan tersebut.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"Contact\" class=\"title\" /><text value=\":\" /><text type=\"break\" /><text value=\"  first = \" /><text value=\"&quot;Jane&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"  last = \" /><text value=\"&quot;Doe&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"  cell = \" /><text value=\"&quot;3112445656&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"  email = \" /><text value=\"&quot;jdoe@gmail.com&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"  \" /><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"get_cell\" class=\"title\" /><text value=\"(self)\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\"    print(self.cell)\" /><text type=\"break\" /><text value=\"    \" /><text type=\"break\" /><text value=\"  \" /><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"call\" class=\"title\" /><text value=\"(self)\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\"    print(\" /><text value=\"&quot;calling...&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"    print(self.first, self.last)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"197\" endIndex=\"201\" /><option startIndex=\"201\" endIndex=\"202\" /><option startIndex=\"202\" endIndex=\"207\" /><option startIndex=\"207\" endIndex=\"208\" /><option startIndex=\"214\" endIndex=\"218\" /><option correct=\"false\"><content><text value=\"cell\" /></content></option><option correct=\"false\"><content><text value=\"email\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>self</code>, diikuti oleh <code>.</code>, <code>first</code>, <code>,</code>, dan terakhir <code>last</code>.</p></body></html>",
