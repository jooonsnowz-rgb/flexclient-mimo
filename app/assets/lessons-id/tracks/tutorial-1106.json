            "hardModeContent": "<!DOCTYPE html ><html><body><p>Seorang pengguna tidak lagi berlangganan. Baris mana yang menyimpan keadaan tersebut?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>subscribed = False</code></item><item value=\"2\" correct=\"false\"><code>subscribed = True</code></item><item value=\"3\" correct=\"false\"><code>subscribed = \"False\"</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>subscribed = False</code>.</p></body></html>"
