            "hardModeContent": "<!DOCTYPE html ><html><body><p>Dalam penetapan ini, apa yang menunjukkan bahwa <code>False</code> bukan string?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"upload = \" /><text value=\"False\" class=\"literal\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Tidak ada tanda kutip di sekelilingnya</item><item value=\"2\" correct=\"false\">Ini disimpan di dalam variabel</item><item value=\"3\" correct=\"false\">Nilai tersebut dimulai dengan huruf kapital</item></selection><p visible-if=\"wrong\">Tidak ada tanda kutip di sekelilingnya.</p></body></html>",
