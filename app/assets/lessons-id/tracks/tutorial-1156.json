          {
            "title": "Example: Index",
            "id": 79560,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pastikan <code>\"cat\"</code> berada di indeks <code>0</code>, dan <code>\"dog\"</code> berada di indeks <code>1</code>, dengan mengodekan <code>\"cat\"</code> lalu <code>\"dog\"</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"animals = [\" /><text value=\"&quot;cat&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;dog&quot;\" class=\"string\" /><text value=\"]\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"11\" endIndex=\"16\" /><option startIndex=\"18\" endIndex=\"23\" /><option correct=\"false\"><content><text value=\"animals\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>\"cat\"</code>, diikuti oleh <code>\"dog\"</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Tempatkan <code>\"dog\"</code> di indeks <code>1</code> dan <code>\"cat\"</code> di indeks <code>0</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"animals = [\" /><text value=\"&quot;cat&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;dog&quot;\" class=\"string\" /><text value=\"]\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"11\" endIndex=\"16\" /><option startIndex=\"18\" endIndex=\"23\" /><option correct=\"false\"><content><text value=\"animals\" /></content></option><option correct=\"false\"><content><text value=\"cat\" /></content></option><option correct=\"false\"><content><text value=\"dog\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>\"cat\"</code>, diikuti oleh <code>\"dog\"</code>.</p></body></html>",
