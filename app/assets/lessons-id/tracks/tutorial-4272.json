            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa itu pernyataan <code>else</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Kondisional yang dijalankan saat kondisi pernyataan <code>if</code> bernilai <code>false</code></item><item value=\"2\" correct=\"false\">Kondisional yang dijalankan ketika kondisi pernyataan <code>if</code> bernilai <code>true</code></item></selection><p visible-if=\"wrong\">Kondisional yang dijalankan saat kondisi pernyataan <code>if</code> bernilai <code>false</code>.</p></body></html>"
