          {
            "title": "Lesson #1",
            "id": 145518,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Game yang hebat tidak hanya menentukan apa yang harus dilakukan ketika suatu kondisi bernilai <code>true</code>; game tersebut juga memiliki rencana cadangan jika kondisinya bernilai <code>false</code>.</p><webview version=\"2\" content=\"&lt;!doctype html&gt;&#xA;&lt;html lang=&quot;en&quot;&gt;&#xA;  &lt;head&gt;&#xA;    &lt;meta charset=&quot;UTF-8&quot; /&gt;&#xA;    &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot; /&gt;&#xA;    &lt;title&gt;Game State Toggle&lt;/title&gt;&#xA;    &lt;style&gt;&#xA;      * {&#xA;        margin: 0;&#xA;        padding: 0;&#xA;        box-sizing: border-box;&#xA;      }&#xA;      body {&#xA;        display: flex;&#xA;        flex-direction: column;&#xA;        align-items: center;&#xA;        justify-content: center;&#xA;        height: 100vh;&#xA;        background-color: #0b1020;&#xA;        color: #d7e1ff;&#xA;        font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;&#xA;        overflow: hidden;&#xA;      }&#xA;      .world {&#xA;        width: 360px;&#xA;        height: 220px;&#xA;        border: 2px solid rgba(215, 225, 255, 0.25);&#xA;        border-radius: 12px;&#xA;        position: relative;&#xA;        background: radial-gradient(circle at 50% 120%, rgba(90, 210, 255, 0.18), rgba(0, 0, 0, 0));&#xA;        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);&#xA;        margin-bottom: 18px;&#xA;      }&#xA;      .hud {&#xA;        position: absolute;&#xA;        top: 10px;&#xA;        left: 12px;&#xA;        right: 12px;&#xA;        display: flex;&#xA;        justify-content: space-between;&#xA;        font-size: 14px;&#xA;        opacity: 0.95;&#xA;      }&#xA;      .status {&#xA;        padding: 6px 10px;&#xA;        border-radius: 999px;&#xA;        background: rgba(215, 225, 255, 0.12);&#xA;        border: 1px solid rgba(215, 225, 255, 0.18);&#xA;      }&#xA;      .player {&#xA;        position: absolute;&#xA;        left: 40px;&#xA;        bottom: 36px;&#xA;        font-size: 44px;&#xA;        filter: drop-shadow(0 6px 10px rgba(0, 0, 0, 0.45));&#xA;        transition: transform 0.25s ease, opacity 0.25s ease;&#xA;      }&#xA;      .enemy {&#xA;        position: absolute;&#xA;        right: 52px;&#xA;        bottom: 36px;&#xA;        font-size: 44px;&#xA;        filter: drop-shadow(0 6px 10px rgba(0, 0, 0, 0.45));&#xA;        opacity: 0.25;&#xA;        transition: opacity 0.25s ease;&#xA;      }&#xA;      .pausedOverlay {&#xA;        position: absolute;&#xA;        inset: 0;&#xA;        display: flex;&#xA;        align-items: center;&#xA;        justify-content: center;&#xA;        font-weight: 700;&#xA;        letter-spacing: 0.06em;&#xA;        background: rgba(0, 0, 0, 0.45);&#xA;        opacity: 0;&#xA;        pointer-events: none;&#xA;        transition: opacity 0.25s ease;&#xA;        border-radius: 12px;&#xA;      }&#xA;      .running .enemy {&#xA;        opacity: 1;&#xA;      }&#xA;      .running .player {&#xA;        transform: translateX(10px);&#xA;      }&#xA;      .paused .pausedOverlay {&#xA;        opacity: 1;&#xA;      }&#xA;      button {&#xA;        appearance: none;&#xA;        border: 1px solid rgba(215, 225, 255, 0.25);&#xA;        background: rgba(215, 225, 255, 0.08);&#xA;        color: #d7e1ff;&#xA;        padding: 10px 14px;&#xA;        border-radius: 10px;&#xA;        cursor: pointer;&#xA;        transition: transform 0.08s ease, background 0.2s ease;&#xA;      }&#xA;      button:active {&#xA;        transform: translateY(1px);&#xA;        background: rgba(215, 225, 255, 0.14);&#xA;      }&#xA;    &lt;/style&gt;&#xA;  &lt;/head&gt;&#xA;  &lt;body&gt;&#xA;    &lt;div class=&quot;world paused&quot; id=&quot;world&quot;&gt;&#xA;      &lt;div class=&quot;hud&quot;&gt;&#xA;        &lt;div class=&quot;status&quot; id=&quot;stateLabel&quot;&gt;State: Paused&lt;/div&gt;&#xA;        &lt;div class=&quot;status&quot;&gt;Score: &lt;span id=&quot;score&quot;&gt;0&lt;/span&gt;&lt;/div&gt;&#xA;      &lt;/div&gt;&#xA;      &lt;div class=&quot;player&quot;&gt;🧙&lt;/div&gt;&#xA;      &lt;div class=&quot;enemy&quot;&gt;👾&lt;/div&gt;&#xA;      &lt;div class=&quot;pausedOverlay&quot;&gt;PAUSED&lt;/div&gt;&#xA;    &lt;/div&gt;&#xA;    &lt;button onclick=&quot;toggleGame()&quot;&gt;Toggle Pause / Run&lt;/button&gt;&#xA;&#xA;    &lt;script&gt;&#xA;      let isRunning = false;&#xA;      let score = 0;&#xA;      let loopId = null;&#xA;&#xA;      function updateUI() {&#xA;        const world = document.getElementById(&quot;world&quot;);&#xA;        const label = document.getElementById(&quot;stateLabel&quot;);&#xA;        world.classList.toggle(&quot;running&quot;, isRunning);&#xA;        world.classList.toggle(&quot;paused&quot;, !isRunning);&#xA;        label.textContent = isRunning ? &quot;State: Running&quot; : &quot;State: Paused&quot;;&#xA;        document.getElementById(&quot;score&quot;).textContent = String(score);&#xA;      }&#xA;&#xA;      function gameLoop() {&#xA;        score += 1;&#xA;        updateUI();&#xA;      }&#xA;&#xA;      function toggleGame() {&#xA;        isRunning = !isRunning;&#xA;        if (isRunning) {&#xA;          loopId = setInterval(gameLoop, 250);&#xA;        } else {&#xA;          clearInterval(loopId);&#xA;          loopId = null;&#xA;        }&#xA;        updateUI();&#xA;      }&#xA;&#xA;      updateUI();&#xA;    &lt;/script&gt;&#xA;  &lt;/body&gt;&#xA;&lt;/html&gt;&#xA;\" /></body></html>"
