            "interactiveContent": "<!DOCTYPE html ><html><body><p>Di mana letak pernyataan <code>else</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Di akhir blok kode pernyataan <code>if</code></item><item value=\"2\" correct=\"false\">Sebelum blok kode pernyataan <code>if</code></item></selection><p visible-if=\"wrong\">Di akhir blok kode pernyataan <code>if</code>.</p></body></html>"
