10px;&#xA;        box-shadow: 0 0 10px rgba(0, 0, 0, 0.35);&#xA;        flex: 1;&#xA;        color: #e5e7eb;&#xA;      }&#xA;      .info h2,&#xA;      .sign-up h2 {&#xA;        font-size: 20px;&#xA;        margin-bottom: 20px;&#xA;        color: #ffffff;&#xA;      }&#xA;      .info p,&#xA;      .sign-up p {&#xA;        margin: 10px 0;&#xA;        font-size: 16px;&#xA;      }&#xA;      .sign-up form {&#xA;        display: flex;&#xA;        flex-direction: column;&#xA;        gap: 10px;&#xA;      }&#xA;      .sign-up input[type=&quot;text&quot;],&#xA;      .sign-up input[type=&quot;password&quot;],&#xA;      .sign-up select {&#xA;        padding: 10px;&#xA;        border: 1px solid #2b3a68;&#xA;        border-radius: 5px;&#xA;        outline: none;&#xA;        background: #121a33;&#xA;        color: #e5e7eb;&#xA;      }&#xA;      .sign-up button {&#xA;        padding: 10px;&#xA;        background-color: #22c55e;&#xA;        color: white;&#xA;        border: none;&#xA;        border-radius: 5px;&#xA;        cursor: pointer;&#xA;        margin-top: 10px;&#xA;      }&#xA;      @media (max-width: 768px) {&#xA;        .content {&#xA;          flex-direction: column;&#xA;        }&#xA;        .info {&#xA;          order: -1;&#xA;        }&#xA;      }&#xA;    &lt;/style&gt;&#xA;  &lt;/head&gt;&#xA;  &lt;body&gt;&#xA;    &lt;div class=&quot;container&quot;&gt;&#xA;      &lt;div class=&quot;header&quot;&gt;&#xA;        &lt;div&gt;Pause Menu&lt;/div&gt;&#xA;        &lt;div class=&quot;login&quot;&gt;&lt;/div&gt;&#xA;      &lt;/div&gt;&#xA;      &lt;div class=&quot;content&quot;&gt;&#xA;        &lt;div class=&quot;info&quot;&gt;&#xA;          &lt;h2&gt;Controls&lt;/h2&gt;&#xA;          &lt;p&gt;Move with arrow keys&lt;/p&gt;&#xA;          &lt;p&gt;Press Space to attack&lt;/p&gt;&#xA;        &lt;/div&gt;&#xA;        &lt;div class=&quot;sign-up&quot;&gt;&#xA;          &lt;h2&gt;Save Profile&lt;/h2&gt;&#xA;          &lt;p&gt;Keep your progress.&lt;/p&gt;&#xA;          &lt;form&gt;&