            "interactiveContent": "<!DOCTYPE html ><html><body><p>Berapa kali <code>be like me</code> akan muncul di konsol?</p><code name=\"main.swift\" version=\"2\" codelang=\"swift\"><content><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Everybody wants to&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text type=\"break\" /><text value=\"for\" class=\"keyword\" /><text value=\" \" /><text value=\"_\" class=\"number\" /><text value=\" \" /><text value=\"in\" class=\"keyword\" /><text value=\" \" /><text value=\"1\" class=\"number\" /><text value=\"...\" /><text value=\"3\" class=\"number\" /><text value=\" {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;be like me&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"}\" /></content><output><content><text value=\"Everybody wants to\" /><text type=\"break\" /><text value=\"be like me\" /><text type=\"break\" /><text value=\"be like me\" /><text type=\"break\" /><text value=\"be like me\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">3</item><item value=\"2\" correct=\"false\">4</item></selection><p visible-if=\"wrong\">Pastikan kamu memilih 3.</p></body></html>"
