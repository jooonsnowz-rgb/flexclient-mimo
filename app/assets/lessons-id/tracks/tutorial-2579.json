            "interactiveContent": "<!DOCTYPE html ><html><body><p>Menyusun struktur loop <code>for</code>.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"for\" class=\"keyword\" /><text value=\" i \" /><text value=\"in\" class=\"keyword\" /><text value=\" \" /><text value=\"0\" class=\"number\" /><text value=\"...\" /><text value=\"3\" class=\"number\" /><text value=\" {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Updating accounts...&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"3\" /><option startIndex=\"4\" endIndex=\"5\" /><option startIndex=\"9\" endIndex=\"14\" /><option startIndex=\"6\" endIndex=\"8\" /></options></interaction></interactions><output><content><text value=\"Updating accounts...\" /><text type=\"break\" /><text value=\"Updating accounts...\" /><text type=\"break\" /><text value=\"Updating accounts...\" /><text type=\"break\" /><text value=\"Updating accounts...\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>for</code>, diikuti oleh <code>i</code>, lalu <code>in</code>, <code>0...3</code>.</p></body></html>"
