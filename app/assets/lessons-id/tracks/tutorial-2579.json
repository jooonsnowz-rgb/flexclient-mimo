            "id": 127585,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jenis loop apa yang dimiliki ini?</p><code name=\"main.swift\" version=\"2\" codelang=\"swift\"><content><text value=\"for\" class=\"keyword\" /><text value=\" i \" /><text value=\"in\" class=\"keyword\" /><text value=\" \" /><text value=\"0\" class=\"number\" /><text value=\"...\" /><text value=\"3\" class=\"number\" /><text value=\" {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Are you ready?&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"}\" /></content><output><content><text value=\"Are you ready?\" /><text type=\"break\" /><text value=\"Are you ready?\" /><text type=\"break\" /><text value=\"Are you ready?\" /><text type=\"break\" /><text value=\"Are you ready?\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Loop <code>for</code></item><item value=\"2\" correct=\"false\">Loop <code>while</code></item></selection><p visible-if=\"wrong\">Loop <code>for</code>.</p></body></html>"
