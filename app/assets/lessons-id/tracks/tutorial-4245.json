            "id": 144821,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Menampilkan heading yang lebih besar di atas heading yang lebih kecil.</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"&lt;html&gt;&lt;/html&gt;\" /></content></option><option startIndex=\"17\" endIndex=\"41\" /><option startIndex=\"44\" endIndex=\"64\" /></options></interaction></interactions><content><text value=\"&lt;\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Space Adventure\" /><text value=\"&lt;/\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"h6\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Press Start\" /><text value=\"&lt;/\" /><text value=\"h6\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;/\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;/\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /></content></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>&lt;h1&gt;Space Adventure&lt;/h1&gt;</code>, diikuti oleh <code>&lt;h6&gt;Press Start&lt;/h6&gt;</code>.</p></body></html>"
