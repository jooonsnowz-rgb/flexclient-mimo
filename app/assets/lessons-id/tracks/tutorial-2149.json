            "id": 121026,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tampilkan semua informasi dari skema database.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE past_events( &#xA;    name varchar(255), &#xA;    entry int, &#xA;    attendees int &#xA;); &#xA; &#xA;CREATE TABLE events( &#xA;    name varchar(255), &#xA;    registered int &#xA;); &#xA; &#xA;CREATE TABLE crew( &#xA; name varchar(255), &#xA; id int &#xA;); &#xA; &#xA;INSERT INTO crew(name, id) &#xA;VALUES(&quot;Aisha&quot;, 342); &#xA; &#xA;INSERT INTO crew(name, id) &#xA;VALUES(&quot;Matt&quot;, 123); &#xA; &#xA;INSERT INTO crew(name, id) &#xA;VALUES(&quot;Kiana&quot;, 839); &#xA; &#xA;INSERT INTO past_events(name, entry, attendees) &#xA;VALUES(&quot;Pride Party&quot;, 10, 79); &#xA; &#xA;INSERT INTO past_events(name, entry, attendees) &#xA;VALUES(&quot;Classical Day&quot;, 15, 76); &#xA; &#xA;INSERT INTO past_events(name, entry, attendees) &#xA;VALUES(&quot;Wine tasting&quot;, 8, 43); &#xA; &#xA;INSERT INTO events(name, registered) &#xA;VALUES(&quot;Fundraiser&quot;, 37); &#xA; &#xA;INSERT INTO events(name, registered) &#xA;VALUES(&quot;Game zone&quot;, 14);\"><tables><table name=\"past_events\"><row><header content=\"name\" /><header content=\"entry\" /><header content=\"attendees\" /></row><row><data content=\"Pride Party\" /><data content=\"10\" /><data content=\"79\" /></row><row><data content=\"Classical Day\" /><data content=\"15\" /><data content=\"76\" /></row><row><data content=\"Wine tasting\" /><data content=\"8\" /><data content=\"43\" /></row></table><table name=\"events\"><row><header content=\"name\" /><header content=\"registered\" /></row><row><data content=\"Fundraiser\" /><data content=\"37\" /></row><row><data content=\"Game zone\" /><data content=\"14\" /></row></table><table name=\"crew\"><row><header content=\"name\" /><header content=\"id\" /></row><row><data content=\"Aisha\" /><data content=\"342\" /></row><row><data content=\"Matt\" /><data content=\"123\" /></row><row><data content=\"Kiana\" /><data content=\"839\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" sqlite_schema;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"14\" endIndex=\"20\" /><option startIndex=\"20\" endIndex=\"21\" /><option startIndex=\"21\" endIndex=\"27\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"type\" /><header content=\"name\" /><header content=\"tbl_name\" /><header content=\"rootpage\" /><header content=\"sql\" /></row><row><data content=\"table\" /><data content=\"past_events\" /><data content=\"past_events\" /><data content=\"2\" /><data content=\"CREATE TABLE past_events(&#xA;    name varchar(255),&#xA;    entry int,&#xA;    attendees int&#xA;)\" /></row><row><data content=\"table\" /><data content=\"events\" /><data content=\"events\" /><data content=\"3\" /><data content=\"CREATE TABLE events(&#xA;    name varchar(255),&#xA;    registered int&#xA;)\" /></row><row><data content=\"table\" /><data content=\"crew\" /><data content=\"crew\" /><data content=\"4\" /><data content=\"CREATE TABLE crew(&#xA; name varchar(255),&#xA; id int&#xA;)\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>sqlite</code>, diikuti oleh <code>_</code>, dan terakhir <code>schema</code>.</p></body></html>"
