            "interactiveContent": "<!DOCTYPE html ><html><body><p>Lengkapi for loop.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"update_versions = [\" /><text value=\"1.2\" class=\"number\" /><text value=\", \" /><text value=\"3.5\" class=\"number\" /><text value=\", \" /><text value=\"2\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"for\" class=\"keyword\" /><text value=\" version \" /><text value=\"in\" class=\"keyword\" /><text value=\" update_versions:\" /><text type=\"break\" /><text value=\"  print(version + \" /><text value=\"1\" class=\"number\" /><text value=\")\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"33\" endIndex=\"36\" /></interactions><output><content><text value=\"2.2\" /><text type=\"break\" /><text value=\"4.5\" /><text type=\"break\" /><text value=\"3\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>for</code>.</p></body></html>"
