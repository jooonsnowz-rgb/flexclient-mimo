            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tampilkan panjang list ini di console.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"wall_length = [\" /><text value=\"5\" class=\"number\" /><text value=\", \" /><text value=\"7\" class=\"number\" /><text value=\", \" /><text value=\"11\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(len(wall_length))\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"26\" endIndex=\"31\" /><option startIndex=\"32\" endIndex=\"35\" /><option startIndex=\"36\" endIndex=\"47\" /><option startIndex=\"47\" endIndex=\"48\" /><option startIndex=\"35\" endIndex=\"36\" /><option correct=\"false\"><content><text value=\"{\" /></content></option><option correct=\"false\"><content><text value=\"}\" /></content></option></options></interaction></interactions><output><content><text value=\"3\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>print</code>, diikuti oleh <code>len</code>, lalu <code>(</code>, <code>wall_length</code>, <code>)</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Tampilkan jumlah item dalam <code>wall_length</code> agar console menampilkan <code>3</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"wall_length = [\" /><text value=\"5\" class=\"number\" /><text value=\", \" /><text value=\"7\" class=\"number\" /><text value=\", \" /><text value=\"11\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(len(wall_length))\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"26\" endIndex=\"31\" /><option startIndex=\"32\" endIndex=\"35\" /><option startIndex=\"36\" endIndex=\"47\" /><option startIndex=\"47\" endIndex=\"48\" /><option startIndex=\"35\" endIndex=\"36\" /><option correct=\"false\"><content><text value=\"{\" /></content></option><option correct=\"false\"><content><text value=\"}\" /></content></option><option correct=\"false\"><content><text value=\"&quot;wall_length&quot;\" /></content></option><option correct=\"false\"><content><text value=\"wall_length[0]\" /></content></option></options></interaction></interactions><output><content><text value=\"3\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>print</code>, diikuti oleh <code>len</code>, <code>(</code>, <code>wall_length</code>, dan terakhir <code>)</code>.</p></body></html>",
