            "interactiveContent": "<!DOCTYPE html ><html><body><p>Metode apa yang bisa kita gunakan untuk menghentikan eksekusi <code>setInterval()</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>clearInterval()</code></item><item value=\"2\" correct=\"false\"><code>setTimeout</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>clearInterval()</code>.</p></body></html>"
