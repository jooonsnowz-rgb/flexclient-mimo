            "interactiveContent": "<!DOCTYPE html ><html><body><p>Berapa nilai default parameter <code>delay</code> saat kita tidak memberikan nilai kepadanya?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">0 milidetik</item><item value=\"2\" correct=\"false\">1000 milidetik</item></selection><p visible-if=\"wrong\">0 milidetik.</p></body></html>"
