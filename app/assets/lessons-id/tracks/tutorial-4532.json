            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pernyataan apa yang benar mengenai method JavaScript?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">JavaScript memiliki beberapa method yang mengeksekusi kode secara asinkron</item><item value=\"2\" correct=\"false\">JavaScript hanya memiliki method yang mengeksekusi kode secara sinkron</item></selection><p visible-if=\"wrong\">JavaScript memiliki beberapa method yang mengeksekusi kode secara asinkron.</p></body></html>"
