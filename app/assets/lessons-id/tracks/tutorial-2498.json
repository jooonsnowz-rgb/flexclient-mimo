            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang ditampilkan kode ini di konsol?</p><code name=\"main.swift\" version=\"2\" codelang=\"swift\"><content><text value=\"let\" class=\"keyword\" /><text value=\" area = \" /><text value=\"&quot;3 * 5&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(area)\" /></content><output><content><text value=\"3 * 5\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>3 * 5</code></item><item value=\"2\" correct=\"false\"><code>15</code></item></selection><p visible-if=\"wrong\"><code>3 * 5</code>.</p></body></html>"
