            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tampilkan <code>Ms. Irene</code> di konsol.</p><code name=\"main.swift\" version=\"2\" codelang=\"swift\"><content><text value=\"let\" class=\"keyword\" /><text value=\" title = \" /><text value=\"&quot;Ms. &quot;\" class=\"string\" /><text type=\"break\" /><text value=\"let\" class=\"keyword\" /><text value=\" name = \" /><text value=\"&quot;Irene&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(title + name)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"45\" endIndex=\"50\" /><option startIndex=\"51\" endIndex=\"52\" /><option startIndex=\"53\" endIndex=\"57\" /></options></interaction></interactions><output><content><text value=\"Ms. Irene\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>title</code>, diikuti oleh <code>+</code>, dan terakhir <code>name</code>.</p></body></html>"
