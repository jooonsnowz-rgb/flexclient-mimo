            "id": 126303,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tampilkan <code>Posts:55</code> di console.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Posts:&quot;\" class=\"string\" /><text value=\" + \" /><text value=\"&quot;55&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"5\" /><option startIndex=\"5\" endIndex=\"6\" /><option startIndex=\"6\" endIndex=\"21\" /><option startIndex=\"21\" endIndex=\"22\" /></options></interaction></interactions><output><content><text value=\"Posts:55\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>print</code>, diikuti oleh <code>(</code>, lalu <code>\"Posts:\" + \"55\"</code>, <code>)</code>.</p></body></html>"
