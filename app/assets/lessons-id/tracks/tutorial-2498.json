          {
            "title": "Updating the temperature",
            "id": 126289,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Ubah nilai dalam variabel <code>temperature</code> menjadi <code>\"100 degrees\"</code>.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"var\" class=\"keyword\" /><text value=\" temperature = \" /><text value=\"&quot;0 degrees&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"temperature = \" /><text value=\"&quot;100 degrees&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(temperature)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"var temperature\" /></content></option><option startIndex=\"30\" endIndex=\"41\" /></options></interaction></interactions><output><content><text value=\"100 degrees\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>temperature</code>.</p></body></html>"
          },
          {
            "title": "Updating a status",
            "id": 126290,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Perbarui variabel <code>currentStatus</code> menjadi <code>\"Writing code\"</code>.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"var\" class=\"keyword\" /><text value=\" currentStatus = \" /><text value=\"&quot;Dancing&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"currentStatus = \" /><text value=\"&quot;Writing code&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(currentStatus)\" /><text type=\"break\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"30\" endIndex=\"43\" /><option startIndex=\"44\" endIndex=\"45\" /><option startIndex=\"46\" endIndex=\"60\" /><option correct=\"false\"><content><text value=\"var currentStatus\" /></content></option></options></interaction></interactions><output><content><text value=\"Writing code\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>currentStatus</code>, diikuti oleh <code>=</code>, dan terakhir <code>\"Writing code\"</code>.</p></body></html>"
          },
          {
            "title": "Updating button text",
            "id": 126291,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Perbarui variabel <code>buttonText</code> menjadi <code>\"Log in\"</code>.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"var\" class=\"keyword\" /><text value=\" buttonText = \" /><text value=\"&quot;Sign up&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"buttonText = \" /><text value=\"&quot;Log in&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(buttonText)\" /><text type=\"break\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"27\" endIndex=\"37\" /><option startIndex=\"38\" endIndex=\"39\" /><option startIndex=\"40\" endIndex=\"48\" /><option correct=\"false\"><content><text value=\"Log in\" /></content></option><option correct=\"false\"><content><text value=\"var buttonText\" /></content></option></options></interaction></interactions><output><content><text value=\"Log in\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>buttonText</code>, diikuti oleh <code>=</code>, dan terakhir <code>\"Log in\"</code>.</p></body></html>"
