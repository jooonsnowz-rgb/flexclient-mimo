            "id": 126302,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tambahkan konstanta <code>temperature</code> ke pernyataan print.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" temperature = \" /><text value=\"&quot;14&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(temperature + \" /><text value=\"&quot; degrees&quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"29\" endIndex=\"40\" /><option correct=\"false\"><content><text value=\"&quot;temperature&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"14 degrees\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>temperature</code>.</p></body></html>"
