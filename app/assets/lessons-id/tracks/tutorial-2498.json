            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kalikan variabel <code>savings</code> dengan variabel <code>interest</code>.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" savings = \" /><text value=\"100\" class=\"number\" /><text type=\"break\" /><text value=\"let\" class=\"keyword\" /><text value=\" interest = \" /><text value=\"0.04\" class=\"number\" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(savings * interest)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"52\" endIndex=\"53\" /><option startIndex=\"54\" endIndex=\"62\" /><option correct=\"false\"><content><text value=\"/\" /></content></option></options></interaction></interactions><output><content><text value=\"4.0\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>*</code>, diikuti oleh <code>interest</code>.</p></body></html>"
