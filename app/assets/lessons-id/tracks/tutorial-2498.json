            "id": 126313,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Mengapa kode ini menampilkan <code>31</code>, bukan <code>4</code>, di konsol?</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" temperature = \" /><text value=\"&quot;3&quot;\" class=\"string\" /><text value=\" + \" /><text value=\"&quot;1&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(temperature)\" /></content><output><content><text value=\"31\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Karena <code>\"3\"</code> dan <code>\"1\"</code> adalah nilai string</item><item value=\"2\" correct=\"false\">Karena ekspresi tersebut mengurangkan angka-angka</item></selection><p visible-if=\"wrong\">Karena <code>\"3\"</code> dan <code>\"1\"</code> adalah nilai string.</p></body></html>"
