            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang salah dengan kode ini?</p><code name=\"main.swift\" version=\"2\" codelang=\"swift\"><content><text value=\"firstName = \" /><text value=\"&quot;Lori&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"firstName = \" /><text value=\"&quot;Joe&quot;\" class=\"string\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Kode ini tidak menyertakan keyword <code>var</code> di baris pertama</item><item value=\"2\" correct=\"false\">Tidak ada</item></selection><p visible-if=\"wrong\">Kode ini tidak menyertakan keyword <code>var</code> di baris pertama.</p></body></html>"
