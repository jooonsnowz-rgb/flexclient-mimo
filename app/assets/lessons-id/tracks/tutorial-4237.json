            "interactiveContent": "<!DOCTYPE html ><html><body><p>Berikan penekanan pada nama senjata dengan menambahkan tag penekanan pembuka dan penutup.</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"22\" endIndex=\"26\" /><option startIndex=\"39\" endIndex=\"44\" /></options></interaction></interactions><content><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text value=\" I just looted the \" /><text value=\"&lt;\" /><text value=\"em\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Crystal Sword\" /><text value=\"&lt;/\" /><text value=\"em\" class=\"name\" /><text value=\"&gt;\" /><text value=\" from the chest.\" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /></content></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>&lt;em&gt;</code>, diikuti oleh <code>&lt;/em&gt;</code>.</p></body></html>"
