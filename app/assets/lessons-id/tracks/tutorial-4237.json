            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tambahkan line break di antara <em>PlayerOne</em> dan <em>Score: 9000</em> agar <em>PlayerOne</em> berada di satu baris dan <em>Score: 9000</em> berada di bawahnya.</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"&lt;/br&gt;\" /></content></option><option startIndex=\"14\" endIndex=\"18\" /></options></interaction></interactions><content><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text value=\" PlayerOne \" /><text value=\"&lt;\" /><text value=\"br\" class=\"name\" /><text value=\"&gt;\" /><text value=\" Score: 9000 \" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /></content></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>&lt;br&gt;</code>.</p></body></html>"
