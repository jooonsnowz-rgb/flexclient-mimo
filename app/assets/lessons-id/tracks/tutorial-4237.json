            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Untuk apa tag <code>&lt;strong&gt;</code> dan <code>&lt;/strong&gt;</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Mereka mendefinisikan teks sebagai hal penting</item><item value=\"2\" correct=\"false\">Mereka membuat teks tidak dapat dipisahkan oleh jeda baris</item></selection><p visible-if=\"wrong\">Mereka mendefinisikan teks sebagai hal penting.</p></body></html>"
