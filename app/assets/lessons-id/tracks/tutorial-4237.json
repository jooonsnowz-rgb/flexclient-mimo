            "interactiveContent": "<!DOCTYPE html ><html><body><p>Definisikan <em>GAME OVER</em> sebagai teks penting dengan menulis kode <code> &lt;/strong&gt;</code>.</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"50\" endIndex=\"59\" /></options></interaction></interactions><content><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text value=\" You took too much damage\" /><text value=\"&lt;\" /><text value=\"br\" class=\"name\" /><text value=\"&gt;\" /><text value=\"&lt;\" /><text value=\"strong\" class=\"name\" /><text value=\"&gt;\" /><text value=\" GAME OVER\" /><text value=\"&lt;/\" /><text value=\"strong\" class=\"name\" /><text value=\"&gt;\" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /></content></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>&lt;/strong&gt;</code>.</p></body></html>"
