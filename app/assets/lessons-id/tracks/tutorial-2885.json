            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa tujuan parameter kueri dalam permintaan HTTP?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Digunakan untuk mengirimkan data tambahan ke server, seperti filter atau kriteria pencarian</item><item value=\"2\" correct=\"false\">Digunakan untuk mengirim kredensial autentikasi</item><item value=\"3\" correct=\"false\">Digunakan untuk mengirim data dalam body request</item></selection><p visible-if=\"wrong\">Digunakan untuk mengirimkan data tambahan ke server, seperti filter atau kriteria pencarian.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Kamu menyertakan <code>?category=books</code> dalam request produk. Apa tujuan parameter query ini?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Meneruskan kriteria filter ke server</item><item value=\"2\" correct=\"false\">Mengautentikasi request dengan kredensial</item><item value=\"3\" correct=\"false\">Membuat produk baru dari data body request</item></selection><p visible-if=\"wrong\">Meneruskan kriteria filter ke server.</p></body></html>",
