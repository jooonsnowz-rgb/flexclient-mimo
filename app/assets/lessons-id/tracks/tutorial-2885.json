            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Metode mana dalam <code>requests</code> yang memungkinkan kamu meneruskan parameter kueri dengan mudah?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Argumen <code>params</code></item><item value=\"2\" correct=\"false\">Argumen <code>body</code></item><item value=\"3\" correct=\"false\">Argumen <code>headers</code></item></selection><p visible-if=\"wrong\">Argumen <code>params</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Kamu menyimpan parameter query dalam dictionary <code>filters</code>. Argumen mana yang meneruskannya dengan <code>requests</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>params=filters</code></item><item value=\"2\" correct=\"false\"><code>json=filters</code></item><item value=\"3\" correct=\"false\"><code>headers=filters</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>params=filters</code>.</p></body></html>",
