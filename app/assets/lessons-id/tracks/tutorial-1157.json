            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tambahkan <code>500</code> ke akhir list.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"transactions = [\" /><text value=\"100\" class=\"number\" /><text value=\", \" /><text value=\"5\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text value=\"transactions.append(\" /><text value=\"500\" class=\"number\" /><text value=\")\" /><text type=\"break\" /><text value=\"print(transactions)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"37\" endIndex=\"43\" /><option startIndex=\"43\" endIndex=\"44\" /><option startIndex=\"44\" endIndex=\"47\" /><option startIndex=\"47\" endIndex=\"48\" /></options></interaction></interactions><output><content><text value=\"[100, 5, 500]\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>append</code>, diikuti oleh <code>(</code>, lalu <code>500</code>, <code>)</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Tambahkan <code>500</code> ke akhir list agar menampilkan <code>[100, 5, 500]</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"transactions = [\" /><text value=\"100\" class=\"number\" /><text value=\", \" /><text value=\"5\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text value=\"transactions.append(\" /><text value=\"500\" class=\"number\" /><text value=\")\" /><text type=\"break\" /><text value=\"print(transactions)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"37\" endIndex=\"43\" /><option startIndex=\"43\" endIndex=\"44\" /><option startIndex=\"44\" endIndex=\"47\" /><option startIndex=\"47\" endIndex=\"48\" /><option correct=\"false\"><content><text value=\"insert\" /></content></option><option correct=\"false\"><content><text value=\"&quot;500&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"[100, 5, 500]\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>append</code>, diikuti oleh <code>(</code>, <code>500</code>, dan terakhir <code>)</code>.</p></body></html>"
