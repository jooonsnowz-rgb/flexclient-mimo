            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tambahkan <code>\"sugar\"</code> ke akhir list dengan menulis kode <code>append(\"sugar\")</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"cookies = [\" /><text value=\"&quot;flour&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;butter&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text value=\"cookies.append(\" /><text value=\"&quot;sugar&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"print(cookies)\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"38\" endIndex=\"53\" /></interactions><output><content><text value=\"['flour', 'butter', 'sugar']\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>append(\"sugar\")</code>.</p></body></html>"
          },
