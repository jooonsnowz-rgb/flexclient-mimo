            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Variabel mana yang memiliki scope global?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Variabel yang dibuat di luar blok fungsi</item><item value=\"2\" correct=\"false\">Semua variabel</item></selection><p visible-if=\"wrong\">Variabel yang dibuat di luar blok fungsi.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Variabel yang dibuat di luar blok fungsi memiliki scope global.</p><p>Baris <code>theme = \"dark\"</code> muncul sebelum definisi fungsi apa pun. Scope apa yang dimiliki <code>theme</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Scope global</item><item value=\"2\" correct=\"false\">Scope lokal</item><item value=\"3\" correct=\"false\">Scope parameter</item></selection><p visible-if=\"wrong\">Pastikan kamu memilih Scope global.</p></body></html>"
