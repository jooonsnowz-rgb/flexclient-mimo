            "id": 145573,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tampilkan pesan di console saat <code>gameMode</code> tidak sama dengan <code>\"survival\"</code> atau <code>\"hardcore\"</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"else if\" /></content></option><option correct=\"false\"><content><text value=\"(\" /></content></option><option correct=\"false\"><content><text value=\")\" /></content></option><option startIndex=\"160\" endIndex=\"164\" /><option startIndex=\"165\" endIndex=\"166\" /><option startIndex=\"205\" endIndex=\"206\" /></options></interaction></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" gameMode = \" /><text value=\"&quot;story&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" (gameMode === \" /><text value=\"&quot;survival&quot;\" class=\"string\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;No checkpoints.&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"} \" /><text value=\"else\" class=\"keyword\" /><text value=\" \" /><text value=\"if\" class=\"keyword\" /><text value=\" (gameMode === \" /><text value=\"&quot;hardcore&quot;\" class=\"string\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;One life only.&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"} \" /><text value=\"else\" class=\"keyword\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Checkpoints enabled.&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>else</code>, diikuti oleh <code>{</code>, dan terakhir <code>}</code>.</p></body></html>"
