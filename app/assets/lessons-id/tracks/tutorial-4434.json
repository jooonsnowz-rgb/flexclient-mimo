          {
            "title": "Lesson #9",
            "id": 148286,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang ditampilkan kode ini di konsol?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"const\" class=\"keyword\" /><text value=\" playerNames = [\" /><text value=\"&quot;Rin&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Kai&quot;\" class=\"string\" /><text value=\"];\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" playerScores = [\" /><text value=\"2500\" class=\"number\" /><text value=\", \" /><text value=\"3100\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text type=\"break\" /><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"displayPlayers\" class=\"title\" /><text value=\"(\" /><text value=\"playerNames, playerScores\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(playerNames);\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(playerScores);\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"displayPlayers(playerNames, playerScores);\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Ini menampilkan beberapa array</item><item value=\"2\" correct=\"false\">Ini hanya menampilkan array pertama</item></selection><p visible-if=\"wrong\">Ini menampilkan beberapa array.</p></body></html>"
          },
