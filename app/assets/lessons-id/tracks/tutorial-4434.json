            "id": 148288,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang terjadi saat kita menggunakan <code>playerNames[i]</code> di dalam perulangan <code>for</code> seperti pada fungsi di bawah ini?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"const\" class=\"keyword\" /><text value=\" playerNames = [\" /><text value=\"&quot;Rin&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Kai&quot;\" class=\"string\" /><text value=\"];\" /><text type=\"break\" /><text type=\"break\" /><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"searchPlayer\" class=\"title\" /><text value=\"(\" /><text value=\"playerNames\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"0\" class=\"number\" /><text value=\"; i &lt; playerNames.length; i++) {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(playerNames[i]);\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"searchPlayer(playerNames);\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Kita mengambil elemen array satu per satu</item><item value=\"2\" correct=\"false\">Kita mengambil semua elemen array sekaligus</item></selection><p visible-if=\"wrong\">Kita mengambil elemen array satu per satu.</p></body></html>"
          },
          {
