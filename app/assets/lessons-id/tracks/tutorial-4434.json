            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bagaimana cara mengakses elemen array dari dalam fungsi?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Kita meneruskan array ke fungsi</item><item value=\"2\" correct=\"false\">Kita memanggil array secara langsung tanpa meneruskannya ke fungsi</item></selection><p visible-if=\"wrong\">Kita meneruskan array ke fungsi.</p></body></html>"
