            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa tujuan initializer?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Untuk menginisialisasi instance objek class dengan variabel class yang unik</item><item value=\"2\" correct=\"false\">Untuk membuat method untuk objek class</item></selection><p visible-if=\"wrong\">Untuk menginisialisasi instance objek class dengan variabel class yang unik.</p></body></html>"
          },
          {
