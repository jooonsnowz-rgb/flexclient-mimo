            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang salah dengan kode ini?</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"button\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Add to Cart\" /><text value=\"&lt;/\" /><text value=\"button\" class=\"name\" /><text value=\"&gt;\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Tidak ada yang salah dengan kodenya</item><item value=\"2\" correct=\"false\">Teks di dalam elemen <code>button</code> memiliki spasi</item><item value=\"3\" correct=\"false\">Tag penutup button tidak memiliki <code>/</code></item></selection><p visible-if=\"wrong\">Tidak ada yang salah dengan kodenya.</p></body></html>",
