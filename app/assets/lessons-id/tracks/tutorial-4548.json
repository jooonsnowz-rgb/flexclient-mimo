            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Saat memanggil metode <code>super()</code>, berapa banyak parameter yang harus dimilikinya?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Jumlah parameter yang sama dengan konstruktor superclass</item><item value=\"2\" correct=\"false\">Tidak ada</item><item value=\"3\" correct=\"false\">Sebanyak yang dibutuhkan subclass</item></selection><p visible-if=\"wrong\">Jumlah parameter yang sama dengan konstruktor superclass.</p></body></html>"
