            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Buat class <code>Enemy</code> mewarisi class <code>GameObject</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"Extends\" /></content></option><option startIndex=\"73\" endIndex=\"78\" /><option startIndex=\"79\" endIndex=\"84\" /><option startIndex=\"85\" endIndex=\"92\" /><option startIndex=\"93\" endIndex=\"103\" /></options></interaction></interactions><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"GameObject\" class=\"title\" /><text value=\" \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"constructor\" class=\"keyword\" /><text value=\"(x, y) {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"this\" class=\"keyword\" /><text value=\".x = x;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"this\" class=\"keyword\" /><text value=\".y = y;\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"Enemy\" class=\"title\" /><text value=\" \" /><text value=\"extends\" class=\"keyword\" /><text value=\" \" /><text value=\"GameObject\" class=\"title\" /><text value=\" \" /><text value=\"{}\" /></content></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>class</code>, diikuti oleh <code>Enemy</code>, lalu <code>extends</code>, <code>GameObject</code>.</p></body></html>"
          },
