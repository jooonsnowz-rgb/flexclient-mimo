            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tambahkan pemanggilan <code>super</code> untuk memanggil konstruktor class <code>Sprite</code> dengan meneruskan <code>imagePath</code>. Jangan lupa titik koma <code>;</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"140\" endIndex=\"157\" isDefault=\"true\" /></interactions><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"Sprite\" class=\"title\" /><text value=\" \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"constructor\" class=\"keyword\" /><text value=\"(imagePath) {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"this\" class=\"keyword\" /><text value=\".imagePath = imagePath;\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"PlayerSprite\" class=\"title\" /><text value=\" \" /><text value=\"extends\" class=\"keyword\" /><text value=\" \" /><text value=\"Sprite\" class=\"title\" /><text value=\" \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"constructor\" class=\"keyword\" /><text value=\"(imagePath) {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"super\" class=\"keyword\" /><text value=\"(imagePath);\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>super(imagePath);</code>.</p></body></html>"
