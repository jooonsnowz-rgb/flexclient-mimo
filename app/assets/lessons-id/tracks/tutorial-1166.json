            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tambahkan parameter ke fungsi, lalu tetapkan nilai parameter dalam pemanggilan fungsi.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"double_number\" class=\"title\" /><text value=\"(number)\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\"  result = number * \" /><text value=\"2\" class=\"number\" /><text type=\"break\" /><text value=\"  print(result)\" /><text type=\"break\" /><text value=\"double_number(\" /><text value=\"5\" class=\"number\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"18\" endIndex=\"24\" /><option startIndex=\"79\" endIndex=\"80\" /></options></interaction></interactions><output><content><text value=\"10\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>number</code>, diikuti oleh <code>5</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Gunakan parameter di dalam fungsi dan teruskan nilai dalam pemanggilan agar kode menampilkan <code>10</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"double_number\" class=\"title\" /><text value=\"(number)\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\"  result = number * \" /><text value=\"2\" class=\"number\" /><text type=\"break\" /><text value=\"  print(result)\" /><text type=\"break\" /><text value=\"double_number(\" /><text value=\"5\" class=\"number\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"38\" endIndex=\"44\" /><option startIndex=\"79\" endIndex=\"80\" /><option correct=\"false\"><content><text value=\"numbers\" /></content></option><option correct=\"false\"><content><text value=\"4\" /></content></option></options></interaction></interactions><output><content><text value=\"10\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>number</code>, diikuti oleh <code>5</code>.</p></body></html>",
