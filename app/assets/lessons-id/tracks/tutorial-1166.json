          {
            "title": "Example: Pass parameters",
            "id": 80240,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tambahkan parameter <code>status</code> ke fungsi tersebut.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"user_status\" class=\"title\" /><text value=\"(status)\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"f&quot;Bob: \" /><text value=\"{status}\" class=\"subst\" /><text value=\"&quot;\" /><text value=\")\" /><text type=\"break\" /><text value=\"user_status(\" /><text value=\"&quot;Active&quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"16\" endIndex=\"22\" /></interactions><output><content><text value=\"Bob: Active\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>status</code>.</p></body></html>"
