          {
            "title": "Example: Variables in functions",
            "id": 80258,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Buat variabel untuk digunakan di dalam fungsi.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"lamp_status\" class=\"title\" /><text value=\"()\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\"  power = \" /><text value=\"True\" class=\"literal\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"f&quot;Powered On: \" /><text value=\"{power}\" class=\"subst\" /><text value=\"&quot;\" /><text value=\")\" /><text type=\"break\" /><text value=\"lamp_status()\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"21\" endIndex=\"26\" /><option startIndex=\"27\" endIndex=\"28\" /><option startIndex=\"29\" endIndex=\"33\" /></options></interaction></interactions><output><content><text value=\"Powered On: True\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>power</code>, diikuti oleh <code>=</code>, dan terakhir <code>True</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Di dalam fungsi, simpan status daya dan buat kode menampilkan <code>Powered On: True</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"lamp_status\" class=\"title\" /><text value=\"()\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\"  power = \" /><text value=\"True\" class=\"literal\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"f&quot;Powered On: \" /><text value=\"{power}\" class=\"subst\" /><text value=\"&quot;\" /><text value=\")\" /><text type=\"break\" /><text value=\"lamp_status()\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"21\" endIndex=\"26\" /><option startIndex=\"27\" endIndex=\"28\" /><option startIndex=\"29\" endIndex=\"33\" /><option correct=\"false\"><content><text value=\"==\" /></content></option><option correct=\"false\"><content><text value=\"False\" /></content></option></options></interaction></interactions><output><content><text value=\"Powered On: True\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>power</code>, diikuti oleh <code>=</code>, dan terakhir <code>True</code>.</p></body></html>"
          },
