          {
            "title": "Example 2",
            "id": 134819,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tambahkan pemisah baris pada alamat di antara <em>Mimo</em> dan <em>Vienna, Austria</em>, sehingga <em>Mimo</em> muncul di satu baris dan <em>Vienna, Austria</em> muncul di bawahnya.</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text value=\" Mimo \" /><text value=\"&lt;\" /><text value=\"br\" class=\"name\" /><text value=\"&gt;\" /><text value=\" Vienna, Austria \" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"9\" endIndex=\"13\" /><option correct=\"false\"><content><text value=\"&lt;/br&gt;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>&lt;br&gt;</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Tempatkan setiap bagian alamat pada barisnya sendiri.</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text value=\" Mimo \" /><text value=\"&lt;\" /><text value=\"br\" class=\"name\" /><text value=\"&gt;\" /><text value=\" Karlsplatz 1 \" /><text value=\"&lt;\" /><text value=\"br\" class=\"name\" /><text value=\"&gt;\" /><text value=\" Vienna, Austria \" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"9\" endIndex=\"13\" /><option startIndex=\"27\" endIndex=\"31\" /><option correct=\"false\"><content><text value=\"&lt;rb&gt;\" /></content></option><option correct=\"false\"><content><text value=\"&lt;p&gt;\" /></content></option><option correct=\"false\"><content><text value=\"&lt;/p&gt;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>&lt;br&gt;</code>, diikuti oleh <code>&lt;br&gt;</code>.</p></body></html>"
