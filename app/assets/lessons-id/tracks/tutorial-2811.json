            "id": 131136,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa itu enum dalam TypeScript?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Enum adalah cara untuk mendefinisikan sekumpulan konstanta bernama</item><item value=\"2\" correct=\"false\">Enum adalah cara untuk mendefinisikan sebuah class</item><item value=\"3\" correct=\"false\">Enum adalah cara untuk mendefinisikan interface</item></selection><p visible-if=\"wrong\">Enum adalah cara untuk mendefinisikan sekumpulan konstanta bernama.</p></body></html>"
          },
