            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tetapkan list yang berisi <code>\"Luz\"</code> ke variabel <code>siblings</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"siblings = [\" /><text value=\"&quot;Luz&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text value=\"print(siblings)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"11\" endIndex=\"12\" /><option startIndex=\"12\" endIndex=\"17\" /><option startIndex=\"17\" endIndex=\"18\" /></options></interaction></interactions><output><content><text value=\"['Luz']\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>[</code>, diikuti oleh <code>\"Luz\"</code>, dan terakhir <code>]</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Tetapkan list berisi <code>\"Luz\"</code> ke variabel <code>siblings</code> agar kode menampilkan <code>['Luz']</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"siblings = [\" /><text value=\"&quot;Luz&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text value=\"print(siblings)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"11\" endIndex=\"12\" /><option startIndex=\"12\" endIndex=\"17\" /><option startIndex=\"17\" endIndex=\"18\" /><option correct=\"false\"><content><text value=\"{\" /></content></option><option correct=\"false\"><content><text value=\"}\" /></content></option><option correct=\"false\"><content><text value=\"Luz\" /></content></option></options></interaction></interactions><output><content><text value=\"['Luz']\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>[</code>, diikuti oleh <code>\"Luz\"</code>, dan terakhir <code>]</code>.</p></body></html>"
