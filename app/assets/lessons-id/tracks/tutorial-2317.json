          {
            "title": "Question: No own condition",
            "id": 77841,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Mengapa pernyataan <code>else</code> tidak memiliki kondisinya sendiri?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Karena kondisinya merupakan kebalikan dari kondisi pernyataan <code>if</code></item><item value=\"2\" correct=\"false\">Karena selalu dijalankan, jadi tidak memerlukan kondisi</item><item value=\"3\" correct=\"false\">Pernyataan <code>else</code> memang memiliki kondisi </item></selection><p visible-if=\"wrong\">Karena kondisinya merupakan kebalikan dari kondisi pernyataan <code>if</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Program memeriksa <code>if raining</code> sebelum cabang <code>else</code> yang menyarankan kacamata hitam. Kapan cabang alternatif itu berjalan?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Saat <code>raining</code> bernilai <code>False</code></item><item value=\"2\" correct=\"false\">Saat <code>raining</code> bernilai <code>True</code></item><item value=\"3\" correct=\"false\">Setiap saat karena <code>else</code> tidak memiliki kondisi tertulis</item></selection><p visible-if=\"wrong\">Saat <code>raining</code> bernilai <code>False</code>.</p></body></html>",
            "hardModeSelected": true
