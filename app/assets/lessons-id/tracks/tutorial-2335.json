            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bagaimana kita akhirnya mengembalikan <code>None</code> dari fungsi kita?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Dengan lupa menambahkan pernyataan <code>return</code></item><item value=\"2\" correct=\"false\">Dengan tidak menyertakan pernyataan display apa pun dalam kode kita</item><item value=\"3\" correct=\"false\">Dengan memanggil fungsi menggunakan parameter</item></selection><p visible-if=\"wrong\">Dengan lupa menambahkan pernyataan <code>return</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Fungsi menampilkan <code>Hello</code>, tetapi tidak memiliki pernyataan <code>return</code>. Nilai apa yang dikembalikan pemanggilannya?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>None</code></item><item value=\"2\" correct=\"false\"><code>\"Hello\"</code></item><item value=\"3\" correct=\"false\">Parameter fungsi</item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>None</code>.</p></body></html>",
