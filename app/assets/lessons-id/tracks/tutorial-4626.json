            "hardModeContent": "<!DOCTYPE html ><html><body><p>Tanda apa yang memisahkan parameter query setelah parameter pertama?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>&amp;</code></item><item value=\"2\" correct=\"false\"><code>?</code></item><item value=\"3\" correct=\"false\"><code>,</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>&amp;</code>.</p></body></html>"
