            "id": 118705,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Buat pernyataan <code>UPDATE</code> untuk mengubah kolom <code>company</code> di setiap baris menjadi <code>(Vacant)</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE `Directory` (&#xA; `floor` INTEGER NOT NULL,&#xA; `company` TEXT NOT NULL,&#xA; PRIMARY KEY (`floor`)&#xA;);&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (1, 'Lobby');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (2, 'Perkins Legal');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (3, '(Vacant)');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (4, 'Bright Whites Dental');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (5, 'Whiz Kid IT Support');\"><tables><table name=\"Directory\"><row><header content=\"floor\" /><header content=\"company\" /></row><row><data content=\"1\" /><data content=\"Lobby\" /></row><row><data content=\"2\" /><data content=\"Perkins Legal\" /></row><row><data content=\"3\" /><data content=\"(Vacant)\" /></row><row><data content=\"4\" /><data content=\"Bright Whites Dental\" /></row><row><data content=\"5\" /><data content=\"Whiz Kid IT Support\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" \" /><text value=\"Directory\" class=\"keyword\" /><text value=\" \" /><text value=\"SET\" class=\"keyword\" /><text value=\" company = \" /><text value=\"'(Vacant)'\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" \" /><text value=\"Directory\" class=\"keyword\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"31\" endIndex=\"41\" /></interactions><output><table name=\"Result\"><row><header content=\"floor\" /><header content=\"company\" /></row><row><data content=\"1\" /><data content=\"(Vacant)\" /></row><row><data content=\"2\" /><data content=\"(Vacant)\" /></row><row><data content=\"3\" /><data content=\"(Vacant)\" /></row><row><data content=\"4\" /><data content=\"(Vacant)\" /></row><row><data content=\"5\" /><data content=\"(Vacant)\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>'(Vacant)'</code>.</p></body></html>"
          },
          {
            "title": "Example: One Row",
            "id": 118706,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tulis klausa <code>WHERE</code> pada pernyataan <code>UPDATE</code> agar mengubah <code>partysize</code> milik Smith menjadi <code>2</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE `Reservations` (&#xA; `id` INTEGER NOT NULL,&#xA; `name` TEXT NOT NULL,&#xA; `phonenumber` TEXT NOT NULL,&#xA; `time` TEXT NOT NULL,&#xA; `partysize` INTEGER NOT NULL,&#xA; PRIMARY KEY (`id`)&#xA;);&#xA;&#xA;&#xA;INSERT INTO `Reservations` (`id`, `name`, `phonenumber`, `time`, `partysize`) VALUES ('1', 'Powers', '+16352637463', '18:00',4);&#xA;&#xA;INSERT INTO `Reservations` (`id`, `name`, `phonenumber`, `time`, `partysize`) VALUES ('2', 'Miranda', '+17487652839', '19:00',5);&#xA;&#xA;INSERT INTO `Reservations` (`id`, `name`, `phonenumber`, `time`, `partysize`) VALUES ('3', 'Smith', '+17648373572', '18:30',3);&#xA;\"><tables><table name=\"Reservations\"><row><header content=\"id\" /><header content=\"name\" /><header content=\"phonenumber\" /><header content=\"time\" /><header content=\"partysize\" /></row><row><data content=\"1\" /><data content=\"Powers\" /><data content=\"+16352637463\" /><data content=\"18:00\" /><data content=\"4\" /></row><row><data content=\"2\" /><data content=\"Miranda\" /><data content=\"+17487652839\" /><data content=\"19:00\" /><data content=\"5\" /></row><row><data content=\"3\" /><data content=\"Smith\" /><data content=\"+17648373572\" /><data content=\"18:30\" /><data content=\"3\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" Reservations \" /><text value=\"SET\" class=\"keyword\" /><text value=\" partysize = \" /><text value=\"2\" class=\"number\" /><text value=\" \" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" = \" /><text value=\"'Smith'\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" Reservations;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"38\" endIndex=\"43\" /><option startIndex=\"44\" endIndex=\"48\" /><option startIndex=\"49\" endIndex=\"50\" /><option startIndex=\"51\" endIndex=\"58\" /><option correct=\"false\"><content><text value=\"'Powers'\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"id\" /><header content=\"name\" /><header content=\"phonenumber\" /><header content=\"time\" /><header content=\"partysize\" /></row><row><data content=\"1\" /><data content=\"Powers\" /><data content=\"+16352637463\" /><data content=\"18:00\" /><data content=\"4\" /></row><row><data content=\"2\" /><data content=\"Miranda\" /><data content=\"+17487652839\" /><data content=\"19:00\" /><data content=\"5\" /></row><row><data content=\"3\" /><data content=\"Smith\" /><data content=\"+17648373572\" /><data content=\"18:30\" /><data content=\"2\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>WHERE</code>, diikuti oleh <code>name</code>, lalu <code>=</code>, <code>'Smith'</code>.</p></body></html>"
          },
