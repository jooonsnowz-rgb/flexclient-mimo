      {
        "id": 13209,
        "title": "MEMPERBARUI",
        "type": "practiceLevel1",
        "lessons": [
          {
            "title": "Intro",
            "id": 118687,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Terkadang kita perlu memperbarui entri tabel yang sudah ada, seperti ketika seorang tamu perlu menggeser reservasi makan malamnya 30 menit.</p><p>Mari kita lihat cara melakukannya di SQLite!</p></body></html>"
          },
          {
            "title": "Intro II",
            "id": 118688,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kita tidak ingin sekadar melakukan <code>INSERT</code> entri tabel baru, karena jika tidak, kita akan memiliki reservasi duplikat dengan nama yang sama. Itu bisa membingungkan!</p><p>Menghapus dan memasukkan kembali sebuah entri juga tidak elegan. Sebagai gantinya, kita bisa menggunakan sintaks <code>UPDATE</code> SQL.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE `Reservations` (&#xA; `id` INTEGER NOT NULL,&#xA; `name` TEXT NOT NULL,&#xA; `phonenumber` TEXT NOT NULL,&#xA; `time` TEXT NOT NULL,&#xA; `partysize` INTEGER NOT NULL,&#xA; PRIMARY KEY (`id`)&#xA;);&#xA;&#xA;&#xA;INSERT INTO `Reservations` (`id`, `name`, `phonenumber`, `time`, `partysize`) VALUES ('1', 'Powers', '+16352637463', '18:00',4);&#xA;&#xA;INSERT INTO `Reservations` (`id`, `name`, `phonenumber`, `time`, `partysize`) VALUES ('2', 'Miranda', '+17487652839', '19:00',5);&#xA;&#xA;INSERT INTO `Reservations` (`id`, `name`, `phonenumber`, `time`, `partysize`) VALUES ('3', 'Smith', '+17648373572', '18:30',3);&#xA;\"><tables><table name=\"Reservations\"><row><header content=\"id\" /><header content=\"name\" /><header content=\"phonenumber\" /><header content=\"time\" /><header content=\"partysize\" /></row><row><data content=\"1\" /><data content=\"Powers\" /><data content=\"+16352637463\" /><data content=\"18:00\" /><data content=\"4\" /></row><row><data content=\"2\" /><data content=\"Miranda\" /><data content=\"+17487652839\" /><data content=\"19:00\" /><data content=\"5\" /></row><row><data content=\"3\" /><data content=\"Smith\" /><data content=\"+17648373572\" /><data content=\"18:30\" /><data content=\"3\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" Reservations \" /><text value=\"SET\" class=\"keyword\" /><text value=\" \" /><text value=\"time\" class=\"built_in\" /><text value=\" = \" /><text value=\"'19:00'\" class=\"string\" /><text value=\" \" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" = \" /><text value=\"'Smith'\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" Reservations;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"id\" /><header content=\"name\" /><header content=\"phonenumber\" /><header content=\"time\" /><header content=\"partysize\" /></row><row><data content=\"1\" /><data content=\"Powers\" /><data content=\"+16352637463\" /><data content=\"18:00\" /><data content=\"4\" /></row><row><data content=\"2\" /><data content=\"Miranda\" /><data content=\"+17487652839\" /><data content=\"19:00\" /><data content=\"5\" /></row><row><data content=\"3\" /><data content=\"Smith\" /><data content=\"+17648373572\" /><data content=\"19:00\" /><data content=\"3\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>UPDATE</code>.</p></body></html>"
          },
          {
            "title": "Limitations",
            "id": 118690,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>UPDATE</code> tidak dapat digunakan untuk menyisipkan entri baru ke dalam tabel. Perintah ini hanya dapat digunakan untuk mengubah entri yang sudah ada.</p><p>Misalnya, menjalankan pernyataan <code>UPDATE</code> di bawah ini tidak akan mengubah data apa pun karena tabel tersebut belum berisi baris dengan <code>id</code> bernilai 4.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE `Reservations` (&#xA; `id` INTEGER NOT NULL,&#xA; `name` TEXT NOT NULL,&#xA; `phonenumber` TEXT NOT NULL,&#xA; `time` TEXT NOT NULL,&#xA; `partysize` INTEGER NOT NULL,&#xA; PRIMARY KEY (`id`)&#xA;);&#xA;&#xA;&#xA;INSERT INTO `Reservations` (`id`, `name`, `phonenumber`, `time`, `partysize`) VALUES ('1', 'Powers', '+16352637463', '18:00',4);&#xA;&#xA;INSERT INTO `Reservations` (`id`, `name`, `phonenumber`, `time`, `partysize`) VALUES ('2', 'Miranda', '+17487652839', '19:00',5);&#xA;&#xA;INSERT INTO `Reservations` (`id`, `name`, `phonenumber`, `time`, `partysize`) VALUES ('3', 'Smith', '+17648373572', '18:30',3);&#xA;\"><tables><table name=\"Reservations\"><row><header content=\"id\" /><header content=\"name\" /><header content=\"phonenumber\" /><header content=\"time\" /><header content=\"partysize\" /></row><row><data content=\"1\" /><data content=\"Powers\" /><data content=\"+16352637463\" /><data content=\"18:00\" /><data content=\"4\" /></row><row><data content=\"2\" /><data content=\"Miranda\" /><data content=\"+17487652839\" /><data content=\"19:00\" /><data content=\"5\" /></row><row><data content=\"3\" /><data content=\"Smith\" /><data content=\"+17648373572\" /><data content=\"18:30\" /><data content=\"3\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" Reservations \" /><text value=\"SET\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" = \" /><text value=\"'Kelly'\" class=\"string\" /><text value=\" \" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"id\" class=\"keyword\" /><text value=\" = \" /><text value=\"4\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" Reservations;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"39\" endIndex=\"44\" /><option startIndex=\"45\" endIndex=\"47\" /><option startIndex=\"48\" endIndex=\"49\" /><option startIndex=\"50\" endIndex=\"51\" /><option startIndex=\"51\" endIndex=\"52\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"id\" /><header content=\"name\" /><header content=\"phonenumber\" /><header content=\"time\" /><header content=\"partysize\" /></row><row><data content=\"1\" /><data content=\"Powers\" /><data content=\"+16352637463\" /><data content=\"18:00\" /><data content=\"4\" /></row><row><data content=\"2\" /><data content=\"Miranda\" /><data content=\"+17487652839\" /><data content=\"19:00\" /><data content=\"5\" /></row><row><data content=\"3\" /><data content=\"Smith\" /><data content=\"+17648373572\" /><data content=\"18:30\" /><data content=\"3\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>WHERE</code>, diikuti oleh <code>id</code>, lalu <code>=</code>, <code>4</code>, <code>;</code>.</p></body></html>"
          },
          {
            "title": "Syntax",
            "id": 118691,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pernyataan <code>UPDATE</code> selalu dimulai dengan kata kunci <code>UPDATE</code> yang diikuti nama tabel.</p><p>Kemudian, nama tabel diikuti oleh kata kunci <code>SET</code> dan ekspresi yang menetapkan kolom ke nilai tertentu. Mari lihat seperti apa bentuknya!</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE `Directory` (&#xA; `floor` INTEGER NOT NULL,&#xA; `company` TEXT NOT NULL,&#xA; PRIMARY KEY (`floor`)&#xA;);&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (1, 'Lobby');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (2, 'Perkins Legal');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (3, '(Vacant)');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (4, 'Bright Whites Dental');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (5, 'Whiz Kid IT Support');\"><tables><table name=\"Directory\"><row><header content=\"floor\" /><header content=\"company\" /></row><row><data content=\"1\" /><data content=\"Lobby\" /></row><row><data content=\"2\" /><data content=\"Perkins Legal\" /></row><row><data content=\"3\" /><data content=\"(Vacant)\" /></row><row><data content=\"4\" /><data content=\"Bright Whites Dental\" /></row><row><data content=\"5\" /><data content=\"Whiz Kid IT Support\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" \" /><text value=\"Directory\" class=\"keyword\" /><text value=\" \" /><text value=\"SET\" class=\"keyword\" /><text value=\" company = \" /><text value=\"'Smith Tax &amp; Audit'\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" \" /><text value=\"Directory\" class=\"keyword\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"floor\" /><header content=\"company\" /></row><row><data content=\"1\" /><data content=\"Smith Tax &amp; Audit\" /></row><row><data content=\"2\" /><data content=\"Smith Tax &amp; Audit\" /></row><row><data content=\"3\" /><data content=\"Smith Tax &amp; Audit\" /></row><row><data content=\"4\" /><data content=\"Smith Tax &amp; Audit\" /></row><row><data content=\"5\" /><data content=\"Smith Tax &amp; Audit\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>UPDATE</code>.</p></body></html>"
          },
          {
            "title": "One Row",
            "id": 118694,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Seperti yang mungkin sudah kamu perhatikan, <code>UPDATE</code> dapat digunakan untuk memperbarui nilai kolom di setiap baris, tetapi biasanya kita ingin mengubah baris tertentu.</p><p>Kita bisa melakukannya dengan menyertakan klausa <code>WHERE</code> di akhir pernyataan <code>UPDATE</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE `Directory` (&#xA; `floor` INTEGER NOT NULL,&#xA; `company` TEXT NOT NULL,&#xA; PRIMARY KEY (`floor`)&#xA;);&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (1, 'Lobby');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (2, 'Perkins Legal');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (3, '(Vacant)');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (4, 'Bright Whites Dental');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (5, 'Whiz Kid IT Support');\"><tables><table name=\"Directory\"><row><header content=\"floor\" /><header content=\"company\" /></row><row><data content=\"1\" /><data content=\"Lobby\" /></row><row><data content=\"2\" /><data content=\"Perkins Legal\" /></row><row><data content=\"3\" /><data content=\"(Vacant)\" /></row><row><data content=\"4\" /><data content=\"Bright Whites Dental\" /></row><row><data content=\"5\" /><data content=\"Whiz Kid IT Support\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" \" /><text value=\"Directory\" class=\"keyword\" /><text value=\" \" /><text type=\"break\" /><text value=\"SET\" class=\"keyword\" /><text value=\" company = \" /><text value=\"'Smith Tax &amp; Audit'\" class=\"string\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"floor\" class=\"keyword\" /><text value=\" = \" /><text value=\"3\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" \" /><text value=\"Directory\" class=\"keyword\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"52\" endIndex=\"57\" /><option startIndex=\"58\" endIndex=\"63\" /><option startIndex=\"64\" endIndex=\"65\" /><option startIndex=\"66\" endIndex=\"67\" /><option startIndex=\"67\" endIndex=\"68\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"floor\" /><header content=\"company\" /></row><row><data content=\"1\" /><data content=\"Lobby\" /></row><row><data content=\"2\" /><data content=\"Perkins Legal\" /></row><row><data content=\"3\" /><data content=\"Smith Tax &amp; Audit\" /></row><row><data content=\"4\" /><data content=\"Bright Whites Dental\" /></row><row><data content=\"5\" /><data content=\"Whiz Kid IT Support\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>WHERE</code>, diikuti oleh <code>floor</code>, lalu <code>=</code>, <code>3</code>, <code>;</code>.</p></body></html>"
          },
          {
            "title": "Multiple Rows",
            "id": 118695,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Menambahkan kondisi ke klausa <code>WHERE</code> dalam pernyataan <code>UPDATE</code> memungkinkan kita memperbarui beberapa baris yang memenuhi kondisi kita sekaligus.</p><p>Misalnya, bayangkan kita ingin mengisi kolom <code>mealservice</code> dengan <code>True</code> untuk semua penerbangan yang berdurasi 6 jam atau lebih.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE `Flights` (&#xA; `number` TEXT NOT NULL,&#xA; `type` TEXT NOT NULL,&#xA; `origin` TEXT NOT NULL,&#xA; `destination` TEXT NOT NULL,&#xA; `duration` REAL NOT NULL,&#xA; `mealservice` INTEGER,&#xA; PRIMARY KEY (`number`)&#xA;);&#xA;&#xA;INSERT INTO `Flights` (`number`, `type`, `origin`, `destination`, `duration`) VALUES ('PA84', 'International', 'Paris', 'London', 1.2);&#xA;&#xA;INSERT INTO `Flights` (`number`, `type`, `origin`, `destination`, `duration`) VALUES ('PA56', 'Domestic', 'New York', 'Los Angeles', 5.5);&#xA;&#xA;INSERT INTO `Flights` (`number`, `type`, `origin`, `destination`, `duration`) VALUES ('PA67', 'International', 'New York', 'London', 7);&#xA;&#xA;INSERT INTO `Flights` (`number`, `type`, `origin`, `destination`, `duration`) VALUES ('PA76', 'Domestic', 'Honolulu', 'Boston', 9.5);\"><tables><table name=\"Flights\"><row><header content=\"number\" /><header content=\"type\" /><header content=\"origin\" /><header content=\"destination\" /><header content=\"duration\" /><header content=\"mealservice\" /></row><row><data content=\"PA84\" /><data content=\"International\" /><data content=\"Paris\" /><data content=\"London\" /><data content=\"1.2\" /><data content=\"\" /></row><row><data content=\"PA56\" /><data content=\"Domestic\" /><data content=\"New York\" /><data content=\"Los Angeles\" /><data content=\"5.5\" /><data content=\"\" /></row><row><data content=\"PA67\" /><data content=\"International\" /><data content=\"New York\" /><data content=\"London\" /><data content=\"7.0\" /><data content=\"\" /></row><row><data content=\"PA76\" /><data content=\"Domestic\" /><data content=\"Honolulu\" /><data content=\"Boston\" /><data content=\"9.5\" /><data content=\"\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" Flights \" /><text type=\"break\" /><text value=\"SET\" class=\"keyword\" /><text value=\" mealservice = \" /><text value=\"True\" class=\"literal\" /><text value=\" \" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"duration\" class=\"keyword\" /><text value=\" &gt;= \" /><text value=\"6\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" Flights;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"40\" endIndex=\"45\" /><option startIndex=\"46\" endIndex=\"54\" /><option startIndex=\"55\" endIndex=\"57\" /><option startIndex=\"58\" endIndex=\"59\" /><option startIndex=\"59\" endIndex=\"60\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"number\" /><header content=\"type\" /><header content=\"origin\" /><header content=\"destination\" /><header content=\"duration\" /><header content=\"mealservice\" /></row><row><data content=\"PA84\" /><data content=\"International\" /><data content=\"Paris\" /><data content=\"London\" /><data content=\"1.2\" /><data content=\"\" /></row><row><data content=\"PA56\" /><data content=\"Domestic\" /><data content=\"New York\" /><data content=\"Los Angeles\" /><data content=\"5.5\" /><data content=\"\" /></row><row><data content=\"PA67\" /><data content=\"International\" /><data content=\"New York\" /><data content=\"London\" /><data content=\"7.0\" /><data content=\"1\" /></row><row><data content=\"PA76\" /><data content=\"Domestic\" /><data content=\"Honolulu\" /><data content=\"Boston\" /><data content=\"9.5\" /><data content=\"1\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>WHERE</code>, diikuti oleh <code>duration</code>, lalu <code>&gt;=</code>, <code>6</code>, <code>;</code>.</p></body></html>"
          },
          {
            "title": "Question: Intro II",
            "id": 118697,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Solusi mana yang lebih elegan untuk mengubah entri tabel yang sudah ada?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Menggunakan pernyataan <code>UPDATE</code></item><item value=\"2\" correct=\"false\">Menggunakan pernyataan <code>DELETE</code> yang diikuti oleh pernyataan <code>INSERT</code></item></selection><p visible-if=\"wrong\">Menggunakan pernyataan <code>UPDATE</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Seorang pengguna mengubah alamat emailnya, tetapi baris tabel yang ada dan nilai lainnya harus dipertahankan. Solusi mana yang sesuai?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Menggunakan pernyataan <code>UPDATE</code></item><item value=\"2\" correct=\"false\">Menggunakan pernyataan <code>DELETE</code> yang diikuti oleh pernyataan <code>INSERT</code></item><item value=\"3\" correct=\"false\">Menggunakan pernyataan <code>INSERT</code> dengan ID pengguna yang sama</item></selection><p visible-if=\"wrong\">Menggunakan pernyataan <code>UPDATE</code>.</p></body></html>"
          },
          {
            "title": "Question: Limitations",
            "id": 118698,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bisakah <code>UPDATE</code> digunakan untuk memasukkan entri baru ke dalam tabel?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Tidak, <code>UPDATE</code> hanya dapat digunakan untuk memodifikasi entri yang sudah ada</item><item value=\"2\" correct=\"false\">Ya, SQLite akan otomatis membuat entri baru</item></selection><p visible-if=\"wrong\">Tidak, <code>UPDATE</code> hanya dapat digunakan untuk memodifikasi entri yang sudah ada.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Sebuah <code>UPDATE</code> menargetkan ID pengguna <code>42</code>, tetapi ID tersebut tidak ada dalam tabel. Apakah pernyataan itu menambahkan pengguna <code>42</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Tidak, <code>UPDATE</code> hanya dapat memodifikasi entri yang sudah ada dan cocok</item><item value=\"2\" correct=\"false\">Ya, SQLite membuat pengguna <code>42</code> dari nilai yang diubah</item><item value=\"3\" correct=\"false\">Ya, tetapi hanya jika ID pengguna <code>42</code> adalah ID berikutnya yang tersedia</item></selection><p visible-if=\"wrong\">Tidak, <code>UPDATE</code> hanya dapat memodifikasi entri yang sudah ada dan cocok.</p></body></html>"
          },
          {
            "title": "Question: Syntax",
            "id": 118699,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dengan kata kunci apa sintaks dasar untuk pernyataan <code>UPDATE</code> dimulai?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>UPDATE</code> diikuti nama tabel yang akan diubah</item><item value=\"2\" correct=\"false\"><code>UPDATE</code> diikuti nama kolom yang akan diubah</item></selection><p visible-if=\"wrong\"><code>UPDATE</code> diikuti nama tabel yang akan diubah.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Kamu perlu mengubah kolom <code>email</code> dalam tabel <code>users</code>. Awalan mana yang mengidentifikasi tabel yang akan diperbarui dengan benar?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>UPDATE users</code></item><item value=\"2\" correct=\"false\"><code>UPDATE email</code></item><item value=\"3\" correct=\"false\"><code>UPDATE users.email</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>UPDATE users</code>.</p></body></html>"
          },
          {
            "title": "Question: One Row",
            "id": 118700,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang harus kamu sertakan jika kamu hanya ingin mengubah baris data tertentu?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Klausa <code>WHERE</code></item><item value=\"2\" correct=\"false\">Nama kolom dan nilai baru</item></selection><p visible-if=\"wrong\">Klausa <code>WHERE</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Kamu ingin mengubah skor hanya untuk baris dengan <code>id</code> <code>7</code>. Apa yang harus disertakan dalam <code>UPDATE</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Klausa <code>WHERE id = 7</code></item><item value=\"2\" correct=\"false\">Hanya kolom skor dan nilai barunya</item><item value=\"3\" correct=\"false\">Klausa <code>ON id = 7</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih Klausa <code>WHERE id = 7</code>.</p></body></html>"
          },
          {
            "title": "Question: Multiple Rows",
            "id": 118701,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Baris mana yang akan diubah oleh pernyataan <code>UPDATE</code> ini?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE `Songs` (&#xA; `songname` TEXT NOT NULL,&#xA; `artist` TEXT NOT NULL,&#xA; `streams` INTEGER NOT NULL,&#xA; `certifications` TEXT&#xA;);&#xA;&#xA;INSERT INTO `Songs` (`songname`, `artist`, `streams`) VALUES ('Paradise', 'The Jets', 120);&#xA;&#xA;INSERT INTO `Songs` (`songname`, `artist`, `streams`) VALUES ('My Way', 'Stevie J', 100);&#xA;&#xA;INSERT INTO `Songs` (`songname`, `artist`, `streams`) VALUES ('Purple Sunrise', 'Harry', 90);&#xA;&#xA;INSERT INTO `Songs` (`songname`, `artist`, `streams`) VALUES ('California Highway', 'Joan &amp; Jerry', 85);&#xA;&#xA;INSERT INTO `Songs` (`songname`, `artist`, `streams`) VALUES ('My Sister Meg', 'Couches', 70);\"><tables><table name=\"Songs\"><row><header content=\"songname\" /><header content=\"artist\" /><header content=\"streams\" /><header content=\"certifications\" /></row><row><data content=\"Paradise\" /><data content=\"The Jets\" /><data content=\"120\" /><data content=\"\" /></row><row><data content=\"My Way\" /><data content=\"Stevie J\" /><data content=\"100\" /><data content=\"\" /></row><row><data content=\"Purple Sunrise\" /><data content=\"Harry\" /><data content=\"90\" /><data content=\"\" /></row><row><data content=\"California Highway\" /><data content=\"Joan &amp; Jerry\" /><data content=\"85\" /><data content=\"\" /></row><row><data content=\"My Sister Meg\" /><data content=\"Couches\" /><data content=\"70\" /><data content=\"\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" Songs \" /><text type=\"break\" /><text value=\"SET\" class=\"keyword\" /><text value=\" certifications = \" /><text value=\"'Platinum'\" class=\"string\" /><text value=\" \" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" streams &gt;= \" /><text value=\"100\" class=\"number\" /><text value=\";\" /></content><output><table name=\"Result\"><row><data content=\"No result!\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Dua baris pertama</item><item value=\"2\" correct=\"false\">Hanya baris pertama</item></selection><p visible-if=\"wrong\">Dua baris pertama.</p></body></html>"
          },
          {
            "title": "Example: Limitations",
            "id": 118704,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Ketikan keyword statement yang benar untuk mengubah angka <code>streams</code> untuk <code>California Highway</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE `Songs` (&#xA; `songname` TEXT NOT NULL,&#xA; `artist` TEXT NOT NULL,&#xA; `streams` INTEGER NOT NULL,&#xA; `certifications` TEXT&#xA;);&#xA;&#xA;INSERT INTO `Songs` (`songname`, `artist`, `streams`) VALUES ('Paradise', 'The Jets', 120);&#xA;&#xA;INSERT INTO `Songs` (`songname`, `artist`, `streams`) VALUES ('My Way', 'Stevie J', 100);&#xA;&#xA;INSERT INTO `Songs` (`songname`, `artist`, `streams`) VALUES ('Purple Sunrise', 'Harry', 90);&#xA;&#xA;INSERT INTO `Songs` (`songname`, `artist`, `streams`) VALUES ('California Highway', 'Joan &amp; Jerry', 85);&#xA;&#xA;INSERT INTO `Songs` (`songname`, `artist`, `streams`) VALUES ('My Sister Meg', 'Couches', 70);\"><tables><table name=\"Songs\"><row><header content=\"songname\" /><header content=\"artist\" /><header content=\"streams\" /><header content=\"certifications\" /></row><row><data content=\"Paradise\" /><data content=\"The Jets\" /><data content=\"120\" /><data content=\"\" /></row><row><data content=\"My Way\" /><data content=\"Stevie J\" /><data content=\"100\" /><data content=\"\" /></row><row><data content=\"Purple Sunrise\" /><data content=\"Harry\" /><data content=\"90\" /><data content=\"\" /></row><row><data content=\"California Highway\" /><data content=\"Joan &amp; Jerry\" /><data content=\"85\" /><data content=\"\" /></row><row><data content=\"My Sister Meg\" /><data content=\"Couches\" /><data content=\"70\" /><data content=\"\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" SONGS \" /><text value=\"SET\" class=\"keyword\" /><text value=\" streams = \" /><text value=\"88\" class=\"number\" /><text value=\" \" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" songname = \" /><text value=\"'California Highway'\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" Songs;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"0\" endIndex=\"6\" /></interactions><output><table name=\"Result\"><row><header content=\"songname\" /><header content=\"artist\" /><header content=\"streams\" /><header content=\"certifications\" /></row><row><data content=\"Paradise\" /><data content=\"The Jets\" /><data content=\"120\" /><data content=\"\" /></row><row><data content=\"My Way\" /><data content=\"Stevie J\" /><data content=\"100\" /><data content=\"\" /></row><row><data content=\"Purple Sunrise\" /><data content=\"Harry\" /><data content=\"90\" /><data content=\"\" /></row><row><data content=\"California Highway\" /><data content=\"Joan &amp; Jerry\" /><data content=\"88\" /><data content=\"\" /></row><row><data content=\"My Sister Meg\" /><data content=\"Couches\" /><data content=\"70\" /><data content=\"\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>UPDATE</code>.</p></body></html>"
