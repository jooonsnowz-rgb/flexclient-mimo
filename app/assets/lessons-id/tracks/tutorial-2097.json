            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tulis statement <code>UPDATE</code> untuk mengisi kolom <code>mealservice</code> dengan <code>true</code> untuk semua penerbangan Internasional.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE `Flights` (&#xA; `number` TEXT NOT NULL,&#xA; `type` TEXT NOT NULL,&#xA; `origin` TEXT NOT NULL,&#xA; `destination` TEXT NOT NULL,&#xA; `duration` REAL NOT NULL,&#xA; `mealservice` INTEGER,&#xA; PRIMARY KEY (`number`)&#xA;);&#xA;&#xA;INSERT INTO `Flights` (`number`, `type`, `origin`, `destination`, `duration`) VALUES ('PA84', 'International', 'Paris', 'Beijing', 9);&#xA;&#xA;INSERT INTO `Flights` (`number`, `type`, `origin`, `destination`, `duration`) VALUES ('PA56', 'Domestic', 'New York', 'Los Angeles', 5.5);&#xA;&#xA;INSERT INTO `Flights` (`number`, `type`, `origin`, `destination`, `duration`) VALUES ('PA67', 'International', 'New York', 'London', 7);&#xA;&#xA;INSERT INTO `Flights` (`number`, `type`, `origin`, `destination`, `duration`) VALUES ('PA76', 'Domestic', 'Washington, D.C.', 'Boston', 3);\"><tables><table name=\"Flights\"><row><header content=\"number\" /><header content=\"type\" /><header content=\"origin\" /><header content=\"destination\" /><header content=\"duration\" /><header content=\"mealservice\" /></row><row><data content=\"PA84\" /><data content=\"International\" /><data content=\"Paris\" /><data content=\"Beijing\" /><data content=\"9.0\" /><data content=\"\" /></row><row><data content=\"PA56\" /><data content=\"Domestic\" /><data content=\"New York\" /><data content=\"Los Angeles\" /><data content=\"5.5\" /><data content=\"\" /></row><row><data content=\"PA67\" /><data content=\"International\" /><data content=\"New York\" /><data content=\"London\" /><data content=\"7.0\" /><data content=\"\" /></row><row><data content=\"PA76\" /><data content=\"Domestic\" /><data content=\"Washington, D.C.\" /><data content=\"Boston\" /><data content=\"3.0\" /><data content=\"\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" Flights \" /><text value=\"SET\" class=\"keyword\" /><text value=\" mealservice = \" /><text value=\"1\" class=\"number\" /><text value=\" \" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"type\" class=\"keyword\" /><text value=\" = \" /><text value=\"'International'\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" Flights;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"35\" endIndex=\"40\" /><option startIndex=\"41\" endIndex=\"45\" /><option startIndex=\"46\" endIndex=\"47\" /><option startIndex=\"48\" endIndex=\"63\" /><option startIndex=\"63\" endIndex=\"64\" /><option correct=\"false\"><content><text value=\"'Domestic'\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"number\" /><header content=\"type\" /><header content=\"origin\" /><header content=\"destination\" /><header content=\"duration\" /><header content=\"mealservice\" /></row><row><data content=\"PA84\" /><data content=\"International\" /><data content=\"Paris\" /><data content=\"Beijing\" /><data content=\"9.0\" /><data content=\"1\" /></row><row><data content=\"PA56\" /><data content=\"Domestic\" /><data content=\"New York\" /><data content=\"Los Angeles\" /><data content=\"5.5\" /><data content=\"\" /></row><row><data content=\"PA67\" /><data content=\"International\" /><data content=\"New York\" /><data content=\"London\" /><data content=\"7.0\" /><data content=\"1\" /></row><row><data content=\"PA76\" /><data content=\"Domestic\" /><data content=\"Washington, D.C.\" /><data content=\"Boston\" /><data content=\"3.0\" /><data content=\"\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>WHERE</code>, diikuti oleh <code>type</code>, lalu <code>=</code>, <code>'International'</code>, <code>;</code>.</p></body></html>"
