            "id": 77302,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Simpan nilai <code>101</code> ke dalam variabel <code>result</code> dan tampilkan.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"result = \" /><text value=\"100\" class=\"number\" /><text value=\" + \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text value=\"print(result)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"9\" endIndex=\"12\" /><option startIndex=\"13\" endIndex=\"14\" /><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"17\" endIndex=\"22\" /><option correct=\"false\"><content><text value=\"&quot;print&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"101\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>result</code>, diikuti oleh <code>100</code>, lalu <code>+</code>, <code>print</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Simpan hasil penjumlahan <code>100</code> dan <code>1</code> dalam <code>result</code>, lalu tampilkan agar konsol menampilkan <code>101</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"result = \" /><text value=\"100\" class=\"number\" /><text value=\" + \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text value=\"print(result)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"9\" endIndex=\"12\" /><option startIndex=\"13\" endIndex=\"14\" /><option startIndex=\"17\" endIndex=\"22\" /><option correct=\"false\"><content><text value=\"total\" /></content></option><option correct=\"false\"><content><text value=\"101\" /></content></option><option correct=\"false\"><content><text value=\"-\" /></content></option><option correct=\"false\"><content><text value=\"&quot;print&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"101\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>result</code>, diikuti oleh <code>100</code>, <code>+</code>, dan terakhir <code>print</code>.</p></body></html>"
