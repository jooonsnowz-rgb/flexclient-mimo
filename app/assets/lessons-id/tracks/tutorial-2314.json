            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bandingkan <code>copy</code> dengan <code>submission</code> menggunakan operator ketidaksetaraan.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"copy = \" /><text value=\"&quot;results.xls&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"submission  = \" /><text value=\"&quot;sales.xls&quot;\" class=\"string\" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"print(copy != submission)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"60\" endIndex=\"61\" /><option startIndex=\"61\" endIndex=\"62\" /><option correct=\"false\"><content><text value=\"&lt;\" /></content></option><option correct=\"false\"><content><text value=\"=\" /></content></option></options></interaction></interactions><output><content><text value=\"True\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>!</code>, diikuti oleh <code>=</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Bandingkan <code>copy</code> dengan <code>submission</code> agar kode mencetak <code>True</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"copy = \" /><text value=\"&quot;results.xls&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"submission  = \" /><text value=\"&quot;sales.xls&quot;\" class=\"string\" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"print(copy != submission)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"60\" endIndex=\"62\" /><option startIndex=\"63\" endIndex=\"73\" /><option correct=\"false\"><content><text value=\"==\" /></content></option><option correct=\"false\"><content><text value=\"=\" /></content></option><option correct=\"false\"><content><text value=\"copy\" /></content></option></options></interaction></interactions><output><content><text value=\"True\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>!=</code>, diikuti oleh <code>submission</code>.</p></body></html>",
