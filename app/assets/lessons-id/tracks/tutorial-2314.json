            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang ditampilkan di console?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"print(\" /><text value=\"&quot;Nina&quot;\" class=\"string\" /><text value=\" != \" /><text value=\"&quot;Nina&quot;\" class=\"string\" /><text value=\")\" /></content><output><content><text value=\"False\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>False</code></item><item value=\"2\" correct=\"false\"><code>True</code></item><item value=\"3\" correct=\"false\"><code>NinaNina</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>False</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Mengapa perbandingan <code>!=</code> ini menampilkan <code>False</code>?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"print(\" /><text value=\"&quot;Nina&quot;\" class=\"string\" /><text value=\" != \" /><text value=\"&quot;Nina&quot;\" class=\"string\" /><text value=\")\" /></content><output><content><text value=\"False\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Kedua string memiliki nilai yang sama, yaitu <code>Nina</code>.</item><item value=\"2\" correct=\"false\"><code>!=</code> memeriksa apakah kedua string sama.</item><item value=\"3\" correct=\"false\">Nilai teks tidak dapat dibandingkan dengan <code>!=</code>.</item></selection><p visible-if=\"wrong\">Kedua string memiliki nilai yang sama, yaitu <code>Nina</code>.</p></body></html>"
