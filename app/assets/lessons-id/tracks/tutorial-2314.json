          {
            "title": "Question 2 type()",
            "id": 76694,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang akan ditampilkan di console?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"print(type(\" /><text value=\"False\" class=\"literal\" /><text value=\"))\" /></content><output><content><text value=\"&lt;class 'bool'&gt;\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>&lt;class 'bool'&gt;</code></item><item value=\"2\" correct=\"false\"><code>&lt;class 'int'&gt;</code></item><item value=\"3\" correct=\"false\"><code>&lt;class 'str'&gt;</code></item></selection><p visible-if=\"wrong\"><code>&lt;class 'bool'&gt;</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Mengapa <code>type(False)</code> menghasilkan <code>&lt;class 'bool'&gt;</code>?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"print(type(\" /><text value=\"False\" class=\"literal\" /><text value=\"))\" /></content><output><content><text value=\"&lt;class 'bool'&gt;\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>False</code> adalah nilai boolean.</item><item value=\"2\" correct=\"false\"><code>type()</code> mengubah <code>False</code> dari integer menjadi boolean.</item><item value=\"3\" correct=\"false\"><code>print()</code> mengubah nilai menjadi boolean sebelum menampilkannya.</item></selection><p visible-if=\"wrong\"><code>False</code> adalah nilai boolean.</p></body></html>",
            "hardModeSelected": true
          },
