            "interactiveContent": "<!DOCTYPE html ><html><body><p>Perbandingan mana yang menghasilkan <code>False</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>5 &lt; 5</code></item><item value=\"2\" correct=\"false\"><code>5 &lt;= 5</code></item><item value=\"3\" correct=\"false\"><code>5 == 5</code></item></selection><p visible-if=\"wrong\"><code>5 &lt; 5</code>.</p></body></html>",
