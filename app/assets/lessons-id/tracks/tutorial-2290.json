            "id": 120918,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang salah dengan kode yang diberikan?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE toys( &#xA;    name varchar(255), &#xA;    price int &#xA;); &#xA; &#xA;INSERT INTO toys(name, price) &#xA;VALUES(&quot;Teddy bear&quot;, 14); &#xA; &#xA;INSERT INTO toys(name, price) &#xA;VALUES(&quot;Remote controlled car&quot;, 12);\"><tables><table name=\"toys\"><row><header content=\"name\" /><header content=\"price\" /></row><row><data content=\"Teddy bear\" /><data content=\"14\" /></row><row><data content=\"Remote controlled car\" /><data content=\"12\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"INSERT\" class=\"keyword\" /><text value=\" \" /><text value=\"INTO\" class=\"keyword\" /><text value=\" toys(\" /><text value=\"name\" class=\"keyword\" /><text value=\", price, \" /><text value=\"store\" class=\"keyword\" /><text value=\") \" /><text type=\"break\" /><text value=\"VALUES\" class=\"keyword\" /><text value=\"(\" /><text value=\"&quot;Beyblade&quot;\" class=\"string\" /><text value=\", \" /><text value=\"13\" class=\"number\" /><text value=\"); \" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" toys;\" /></content><output><table name=\"Result\"><row><data content=\"No result!\" /></row></table></output></code><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Tidak ada kolom bernama store</item><item value=\"2\" correct=\"false\">Baris <code>VALUES</code> harus berada paling awal</item><item value=\"3\" correct=\"false\"><code>INSERT</code>, bukan <code>INSERT INTO</code></item></selection><p visible-if=\"wrong\">Tidak ada kolom bernama store.</p></body></html>"
          },
          {
            "title": "Example 1",
            "id": 120922,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Sisipkan baris baru ke dalam tabel <code>toys</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE toys( &#xA;    name varchar(255), &#xA;    price int &#xA;); &#xA; &#xA;INSERT INTO toys(name, price) &#xA;VALUES(&quot;Teddy bear&quot;, 14); &#xA; &#xA;INSERT INTO toys(name, price) &#xA;VALUES(&quot;Remote controlled car&quot;, 12);\"><tables><table name=\"toys\"><row><header content=\"name\" /><header content=\"price\" /></row><row><data content=\"Teddy bear\" /><data content=\"14\" /></row><row><data content=\"Remote controlled car\" /><data content=\"12\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"INSERT\" class=\"keyword\" /><text value=\" \" /><text value=\"INTO\" class=\"keyword\" /><text value=\" toys(\" /><text value=\"name\" class=\"keyword\" /><text value=\", price) \" /><text type=\"break\" /><text value=\"VALUES\" class=\"keyword\" /><text value=\"(\" /><text value=\"&quot;Clay mix&quot;\" class=\"string\" /><text value=\", \" /><text value=\"9\" class=\"number\" /><text value=\"); \" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" toys;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"11\" /><option correct=\"false\"><content><text value=\"SELECT\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"price\" /></row><row><data content=\"Teddy bear\" /><data content=\"14\" /></row><row><data content=\"Remote controlled car\" /><data content=\"12\" /></row><row><data content=\"Clay mix\" /><data content=\"9\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>INSERT</code>, diikuti oleh <code>INTO</code>.</p></body></html>"
          },
          {
            "title": "Question 4",
            "id": 120920,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Manakah dari kode berikut yang dapat menghapus semua nilai dari tabel yang diberikan?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE toys( &#xA;    name varchar(255), &#xA;    price int &#xA;); &#xA; &#xA;INSERT INTO toys(name, price) &#xA;VALUES(&quot;Teddy bear&quot;, 14); &#xA; &#xA;INSERT INTO toys(name, price) &#xA;VALUES(&quot;Remote controlled car&quot;, 12);\"><tables><table name=\"toys\"><row><header content=\"name\" /><header content=\"price\" /></row><row><data content=\"Teddy bear\" /><data content=\"14\" /></row><row><data content=\"Remote controlled car\" /><data content=\"12\" /></row></table></tables></database><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>DELETE FROM toys</code></item><item value=\"2\" correct=\"false\"><code>DELETE FROM toys WHERE price &lt; 10</code></item><item value=\"3\" correct=\"false\"><code>DELETE</code></item></selection><p visible-if=\"wrong\"><code>DELETE FROM toys</code>.</p></body></html>"
          },
          {
            "title": "Example 5",
            "id": 120926,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Hapus semua nilai dari tabel <code>toys</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE toys( &#xA;    name varchar(255), &#xA;    price int &#xA;); &#xA; &#xA;INSERT INTO toys(name, price) &#xA;VALUES(&quot;Teddy bear&quot;, 14); &#xA; &#xA;INSERT INTO toys(name, price) &#xA;VALUES(&quot;Remote controlled car&quot;, 12); &#xA; &#xA;INSERT INTO toys(name, price) &#xA;VALUES(&quot;Clay mix&quot;, 9);\"><tables><table name=\"toys\"><row><header content=\"name\" /><header content=\"price\" /></row><row><data content=\"Teddy bear\" /><data content=\"14\" /></row><row><data content=\"Remote controlled car\" /><data content=\"12\" /></row><row><data content=\"Clay mix\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"DELETE\" class=\"keyword\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" toys; \" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" toys;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"12\" endIndex=\"16\" /></interactions><output><table name=\"Result\"><row><data content=\"No result!\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>toys</code>.</p></body></html>"
          },
          {
            "title": "Example 3",
            "id": 120924,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Di baris baru, tambahkan nilai <code>Clay mix</code> dan <code>9</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE toys( &#xA;    name varchar(255), &#xA;    price int &#xA;); &#xA; &#xA;INSERT INTO toys(name, price) &#xA;VALUES(&quot;Teddy bear&quot;, 14); &#xA; &#xA;INSERT INTO toys(name, price) &#xA;VALUES(&quot;Remote controlled car&quot;, 12);\"><tables><table name=\"toys\"><row><header content=\"name\" /><header content=\"price\" /></row><row><data content=\"Teddy bear\" /><data content=\"14\" /></row><row><data content=\"Remote controlled car\" /><data content=\"12\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"INSERT\" class=\"keyword\" /><text value=\" \" /><text value=\"INTO\" class=\"keyword\" /><text value=\" toys(\" /><text value=\"name\" class=\"keyword\" /><text value=\", price) \" /><text type=\"break\" /><text value=\"VALUES\" class=\"keyword\" /><text value=\"(\" /><text value=\"&quot;Clay mix&quot;\" class=\"string\" /><text value=\", \" /><text value=\"9\" class=\"number\" /><text value=\"); \" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" toys;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"38\" endIndex=\"48\" /><option startIndex=\"50\" endIndex=\"51\" /><option correct=\"false\"><content><text value=\"14\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"price\" /></row><row><data content=\"Teddy bear\" /><data content=\"14\" /></row><row><data content=\"Remote controlled car\" /><data content=\"12\" /></row><row><data content=\"Clay mix\" /><data content=\"9\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>\"Clay mix\"</code>, diikuti oleh <code>9</code>.</p></body></html>"
          },
          {
            "title": "Question: Limitations",
            "id": 118710,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang terjadi jika kamu memanggil <code>UPDATE</code> dengan klausa <code>WHERE</code> yang tidak cocok dengan baris yang ada?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Tidak ada yang akan berubah</item><item value=\"2\" correct=\"false\">SQLite akan memperbarui baris terdekat berikutnya</item><item value=\"3\" correct=\"false\">SQLite akan otomatis membuat baris baru dengan data yang diberikan</item></selection><p visible-if=\"wrong\">Tidak ada yang akan berubah.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>UPDATE</code> mengubah baris yang cocok dengan kondisi <code>WHERE</code>.</p><p>Tabelmu memiliki ID <code>1</code> dan <code>2</code>. Kamu mengubah filter dari <code>id = 1</code> menjadi <code>id = 99</code>.</p><p>Bagaimana jumlah baris yang diperbarui berubah?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Dari satu baris menjadi nol baris.</item><item value=\"2\" correct=\"false\">Dari satu baris menjadi dua baris.</item><item value=\"3\" correct=\"false\">Tetap satu baris karena UPDATE membuat ID 99.</item></selection><p visible-if=\"wrong\">Dari satu baris menjadi nol baris.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Question: One Row",
            "id": 118712,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Baris mana yang akan diubah oleh pernyataan <code>UPDATE</code> berikut?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE Reservations (&#xA; id INTEGER NOT NULL,&#xA; name TEXT NOT NULL,&#xA; phonenumber TEXT NOT NULL,&#xA; time TEXT NOT NULL,&#xA; partysize INTEGER NOT NULL,&#xA; PRIMARY KEY (id)&#xA;);&#xA;&#xA;&#xA;INSERT INTO Reservations (id, name, phonenumber, time, partysize) VALUES ('1', 'Powers', '+16352637463', '18:00',4);&#xA;&#xA;INSERT INTO Reservations (id, name, phonenumber, time, partysize) VALUES ('2', 'Miranda', '+17487652839', '19:00',5);&#xA;&#xA;INSERT INTO Reservations (id, name, phonenumber, time, partysize) VALUES ('3', 'Smith', '+17648373572', '18:30',3);&#xA;\"><tables><table name=\"Reservations\"><row><header content=\"id\" /><header content=\"name\" /><header content=\"phonenumber\" /><header content=\"time\" /><header content=\"partysize\" /></row><row><data content=\"1\" /><data content=\"Powers\" /><data content=\"+16352637463\" /><data content=\"18:00\" /><data content=\"4\" /></row><row><data content=\"2\" /><data content=\"Miranda\" /><data content=\"+17487652839\" /><data content=\"19:00\" /><data content=\"5\" /></row><row><data content=\"3\" /><data content=\"Smith\" /><data content=\"+17648373572\" /><data content=\"18:30\" /><data content=\"3\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" Reservations \" /><text value=\"SET\" class=\"keyword\" /><text value=\" \" /><text value=\"time\" class=\"built_in\" /><text value=\" = \" /><text value=\"'18:30'\" class=\"string\" /><text value=\" \" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" = \" /><text value=\"'Powers'\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" Reservations;\" /></content><output><table name=\"Result\"><row><header content=\"id\" /><header content=\"name\" /><header content=\"phonenumber\" /><header content=\"time\" /><header content=\"partysize\" /></row><row><data content=\"1\" /><data content=\"Powers\" /><data content=\"+16352637463\" /><data content=\"18:30\" /><data content=\"4\" /></row><row><data content=\"2\" /><data content=\"Miranda\" /><data content=\"+17487652839\" /><data content=\"19:00\" /><data content=\"5\" /></row><row><data content=\"3\" /><data content=\"Smith\" /><data content=\"+17648373572\" /><data content=\"18:30\" /><data content=\"3\" /></row></table></output></code><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Reservasi Powers</item><item value=\"2\" correct=\"false\">Reservasi Miranda</item><item value=\"3\" correct=\"false\">Reservasi Keluarga Smith</item></selection><p visible-if=\"wrong\">Reservasi Powers.</p></body></html>"
          },
          {
            "title": "Example: Syntax",
            "id": 118716,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Lengkapi pernyataan <code>UPDATE</code> untuk mengubah kolom <code>certifications</code> di setiap baris menjadi <code>'Silver'</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE Songs (&#xA; songname TEXT NOT NULL,&#xA; artist TEXT NOT NULL,&#xA; streams INTEGER NOT NULL,&#xA; certifications TEXT&#xA;);&#xA;&#xA;INSERT INTO Songs (songname, artist, streams) VALUES ('Paradise', 'The Jets', 120);&#xA;&#xA;INSERT INTO Songs (songname, artist, streams) VALUES ('My Way', 'Stevie J', 100);&#xA;&#xA;INSERT INTO Songs (songname, artist, streams) VALUES ('Purple Sunrise', 'Harry', 90);&#xA;&#xA;INSERT INTO Songs (songname, artist, streams) VALUES ('California Highway', 'Joan &amp; Jerry', 85);&#xA;&#xA;INSERT INTO Songs (songname, artist, streams) VALUES ('My Sister Meg', 'Couches', 70);\"><tables><table name=\"Songs\"><row><header content=\"songname\" /><header content=\"artist\" /><header content=\"streams\" /><header content=\"certifications\" /></row><row><data content=\"Paradise\" /><data content=\"The Jets\" /><data content=\"120\" /><data content=\"\" /></row><row><data content=\"My Way\" /><data content=\"Stevie J\" /><data content=\"100\" /><data content=\"\" /></row><row><data content=\"Purple Sunrise\" /><data content=\"Harry\" /><data content=\"90\" /><data content=\"\" /></row><row><data content=\"California Highway\" /><data content=\"Joan &amp; Jerry\" /><data content=\"85\" /><data content=\"\" /></row><row><data content=\"My Sister Meg\" /><data content=\"Couches\" /><data content=\"70\" /><data content=\"\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" Songs \" /><text value=\"SET\" class=\"keyword\" /><text value=\" certifications = \" /><text value=\"'Silver'\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" Songs;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"13\" endIndex=\"16\" /><option startIndex=\"17\" endIndex=\"31\" /><option startIndex=\"32\" endIndex=\"33\" /><option startIndex=\"34\" endIndex=\"42\" /><option startIndex=\"42\" endIndex=\"43\" /><option correct=\"false\"><content><text value=\"streams\" /></content></option><option correct=\"false\"><content><text value=\"'Platinum'\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"songname\" /><header content=\"artist\" /><header content=\"streams\" /><header content=\"certifications\" /></row><row><data content=\"Paradise\" /><data content=\"The Jets\" /><data content=\"120\" /><data content=\"Silver\" /></row><row><data content=\"My Way\" /><data content=\"Stevie J\" /><data content=\"100\" /><data content=\"Silver\" /></row><row><data content=\"Purple Sunrise\" /><data content=\"Harry\" /><data content=\"90\" /><data content=\"Silver\" /></row><row><data content=\"California Highway\" /><data content=\"Joan &amp; Jerry\" /><data content=\"85\" /><data content=\"Silver\" /></row><row><data content=\"My Sister Meg\" /><data content=\"Couches\" /><data content=\"70\" /><data content=\"Silver\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>SET</code>, diikuti oleh <code>certifications</code>, lalu <code>=</code>, <code>'Silver'</code>, <code>;</code>.</p></body></html>"
          },
          {
            "title": "Example: One Row",
            "id": 118717,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Buat pernyataan <code>UPDATE</code> untuk meningkatkan jumlah <code>streams</code> milik Paradise menjadi 130.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE Songs (&#xA; songname TEXT NOT NULL,&#xA; artist TEXT NOT NULL,&#xA; streams INTEGER NOT NULL,&#xA; certifications TEXT&#xA;);&#xA;&#xA;INSERT INTO Songs (songname, artist, streams) VALUES ('Paradise', 'The Jets', 120);&#xA;&#xA;INSERT INTO Songs (songname, artist, streams) VALUES ('My Way', 'Stevie J', 100);&#xA;&#xA;INSERT INTO Songs (songname, artist, streams) VALUES ('Purple Sunrise', 'Harry', 90);&#xA;&#xA;INSERT INTO Songs (songname, artist, streams) VALUES ('California Highway', 'Joan &amp; Jerry', 85);&#xA;&#xA;INSERT INTO Songs (songname, artist, streams) VALUES ('My Sister Meg', 'Couches', 70);\"><tables><table name=\"Songs\"><row><header content=\"songname\" /><header content=\"artist\" /><header content=\"streams\" /><header content=\"certifications\" /></row><row><data content=\"Paradise\" /><data content=\"The Jets\" /><data content=\"120\" /><data content=\"\" /></row><row><data content=\"My Way\" /><data content=\"Stevie J\" /><data content=\"100\" /><data content=\"\" /></row><row><data content=\"Purple Sunrise\" /><data content=\"Harry\" /><data content=\"90\" /><data content=\"\" /></row><row><data content=\"California Highway\" /><data content=\"Joan &amp; Jerry\" /><data content=\"85\" /><data content=\"\" /></row><row><data content=\"My Sister Meg\" /><data content=\"Couches\" /><data content=\"70\" /><data content=\"\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" Songs \" /><text value=\"SET\" class=\"keyword\" /><text value=\" streams = \" /><text value=\"130\" class=\"number\" /><text value=\" \" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" songname = \" /><text value=\"'Paradise'\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" Songs;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"12\" /><option startIndex=\"13\" endIndex=\"16\" /><option startIndex=\"17\" endIndex=\"30\" /><option startIndex=\"31\" endIndex=\"36\" /><option startIndex=\"37\" endIndex=\"45\" /><option startIndex=\"46\" endIndex=\"47\" /><option startIndex=\"48\" endIndex=\"58\" /><option startIndex=\"58\" endIndex=\"59\" /><option correct=\"false\"><content><text value=\"artist\" /></content></option><option correct=\"false\"><content><text value=\"'Stevie J'\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"songname\" /><header content=\"artist\" /><header content=\"streams\" /><header content=\"certifications\" /></row><row><data content=\"Paradise\" /><data content=\"The Jets\" /><data content=\"130\" /><data content=\"\" /></row><row><data content=\"My Way\" /><data content=\"Stevie J\" /><data content=\"100\" /><data content=\"\" /></row><row><data content=\"Purple Sunrise\" /><data content=\"Harry\" /><data content=\"90\" /><data content=\"\" /></row><row><data content=\"California Highway\" /><data content=\"Joan &amp; Jerry\" /><data content=\"85\" /><data content=\"\" /></row><row><data content=\"My Sister Meg\" /><data content=\"Couches\" /><data content=\"70\" /><data content=\"\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>UPDATE</code>, diikuti oleh <code>Songs</code>, lalu <code>SET</code>, <code>streams = 130</code>, <code>WHERE</code>, <code>songname</code>, <code>=</code>, <code>'Paradise'</code>, <code>;</code>.</p></body></html>"
          },
          {
            "title": "Example: Multiple Rows",
            "id": 118718,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Buat kode untuk pernyataan <code>UPDATE</code> yang menetapkan <code>mealservice</code> ke <code>1</code> untuk penerbangan bernomor <code>PA76</code> dan <code>PA67</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE Flights (&#xA; number TEXT NOT NULL,&#xA; type TEXT NOT NULL,&#xA; origin TEXT NOT NULL,&#xA; destination TEXT NOT NULL,&#xA; duration REAL NOT NULL,&#xA; mealservice INTEGER,&#xA; PRIMARY KEY (number)&#xA;);&#xA;&#xA;INSERT INTO Flights (number, type, origin, destination, duration) VALUES ('PA84', 'International', 'Paris', 'London', 1.2);&#xA;&#xA;INSERT INTO Flights (number, type, origin, destination, duration) VALUES ('PA56', 'Domestic', 'New York', 'Los Angeles', 5.5);&#xA;&#xA;INSERT INTO Flights (number, type, origin, destination, duration) VALUES ('PA67', 'International', 'New York', 'London', 7);&#xA;&#xA;INSERT INTO Flights (number, type, origin, destination, duration) VALUES ('PA76', 'Domestic', 'Honolulu', 'Boston', 9.5);\"><tables><table name=\"Flights\"><row><header content=\"number\" /><header content=\"type\" /><header content=\"origin\" /><header content=\"destination\" /><header content=\"duration\" /><header content=\"mealservice\" /></row><row><data content=\"PA84\" /><data content=\"International\" /><data content=\"Paris\" /><data content=\"London\" /><data content=\"1.2\" /><data content=\"\" /></row><row><data content=\"PA56\" /><data content=\"Domestic\" /><data content=\"New York\" /><data content=\"Los Angeles\" /><data content=\"5.5\" /><data content=\"\" /></row><row><data content=\"PA67\" /><data content=\"International\" /><data content=\"New York\" /><data content=\"London\" /><data content=\"7.0\" /><data content=\"\" /></row><row><data content=\"PA76\" /><data content=\"Domestic\" /><data content=\"Honolulu\" /><data content=\"Boston\" /><data content=\"9.5\" /><data content=\"\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" Flights \" /><text value=\"SET\" class=\"keyword\" /><text value=\" mealservice = \" /><text value=\"1\" class=\"number\" /><text value=\" \" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"number\" class=\"built_in\" /><text value=\" = \" /><text value=\"'PA76'\" class=\"string\" /><text value=\" \" /><text value=\"OR\" class=\"keyword\" /><text value=\" \" /><text value=\"number\" class=\"built_in\" /><text value=\" = \" /><text value=\"'PA67'\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" Flights;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"35\" endIndex=\"40\" /><option startIndex=\"41\" endIndex=\"47\" /><option startIndex=\"48\" endIndex=\"49\" /><option startIndex=\"57\" endIndex=\"59\" /><option startIndex=\"60\" endIndex=\"66\" /><option startIndex=\"67\" endIndex=\"68\" /><option startIndex=\"69\" endIndex=\"75\" /><option correct=\"false\"><content><text value=\"'PA56'\" /></content></option><option correct=\"false\"><content><text value=\"destination\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"number\" /><header content=\"type\" /><header content=\"origin\" /><header content=\"destination\" /><header content=\"duration\" /><header content=\"mealservice\" /></row><row><data content=\"PA84\" /><data content=\"International\" /><data content=\"Paris\" /><data content=\"London\" /><data content=\"1.2\" /><data content=\"\" /></row><row><data content=\"PA56\" /><data content=\"Domestic\" /><data content=\"New York\" /><data content=\"Los Angeles\" /><data content=\"5.5\" /><data content=\"\" /></row><row><data content=\"PA67\" /><data content=\"International\" /><data content=\"New York\" /><data content=\"London\" /><data content=\"7.0\" /><data content=\"1\" /></row><row><data content=\"PA76\" /><data content=\"Domestic\" /><data content=\"Honolulu\" /><data content=\"Boston\" /><data content=\"9.5\" /><data content=\"1\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>WHERE</code>, diikuti oleh <code>number</code>, lalu <code>=</code>, <code>OR</code>, <code>number</code>, <code>=</code>, <code>'PA67'</code>.</p></body></html>"
          },
          {
            "title": "Question: Column Definition",
            "id": 120027,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Manakah dari berikut ini yang bukan merupakan persyaratan untuk mendefinisikan kolom tabel SQL?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Batasan kolom</item><item value=\"2\" correct=\"false\">Nama kolom</item><item value=\"3\" correct=\"false\">Tipe data kolom</item></selection><p visible-if=\"wrong\">Batasan kolom.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Dengan format nama-kolom-lalu-tipe yang diajarkan, baris mana yang mendefinisikan <code>title</code> sebagai teks tanpa batasan opsional?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>title TEXT</code></item><item value=\"2\" correct=\"false\"><code>TEXT</code></item><item value=\"3\" correct=\"false\"><code>title</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>title TEXT</code>.</p></body></html>",
            "hardModeSelected": true
