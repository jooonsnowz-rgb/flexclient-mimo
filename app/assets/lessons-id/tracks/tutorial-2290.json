            "interactiveContent": "<!DOCTYPE html ><html><body><p>Manakah dari opsi berikut yang bukan merupakan tipe data kolom SQL yang valid?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>BOOLEAN</code></item><item value=\"2\" correct=\"false\"><code>TEXT</code></item><item value=\"3\" correct=\"false\"><code>REAL</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>BOOLEAN</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Kamu memerlukan kolom untuk rating film yang dapat berisi nilai desimal seperti <code>4.5</code>. Tipe SQLite mana yang harus digunakan kolom tersebut?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>REAL</code></item><item value=\"2\" correct=\"false\"><code>INTEGER</code></item><item value=\"3\" correct=\"false\"><code>TEXT</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>REAL</code>.</p></body></html>"
