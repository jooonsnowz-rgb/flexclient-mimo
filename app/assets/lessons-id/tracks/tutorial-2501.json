            "id": 126353,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang ditampilkan kode ini di konsol?</p><code name=\"main.swift\" version=\"2\" codelang=\"swift\"><content><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"10\" class=\"number\" /><text value=\" == \" /><text value=\"11\" class=\"number\" /><text value=\")\" /></content><output><content><text value=\"false\" /></content></output></code><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\"><code>false</code></item><item correct=\"false\" value=\"2\"><code>true</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>false</code>.</p></body></html>"
          },
