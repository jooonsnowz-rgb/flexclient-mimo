            "id": 126359,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Periksa apakah angka-angka ini sama dengan mengetikkan <code>==</code>.</p><code name=\"main.swift\" version=\"2\" codelang=\"swift\"><content><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"100\" class=\"number\" /><text value=\" == \" /><text value=\"100\" class=\"number\" /><text value=\")\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"10\" endIndex=\"12\" /></interactions><output><content><text value=\"true\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>==</code>.</p></body></html>"
