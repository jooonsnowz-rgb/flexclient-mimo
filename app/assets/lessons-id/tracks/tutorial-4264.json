            "id": 145332,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Operator mana yang kita gunakan untuk memeriksa apakah skor di sebelah kiri pernyataan sama dengan atau lebih besar dari <code>21</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>&gt;=</code></item><item value=\"2\" correct=\"false\"><code>&lt;=</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>&gt;=</code>.</p></body></html>"
          },
