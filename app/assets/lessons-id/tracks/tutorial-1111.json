            "hardModeContent": "<!DOCTYPE html ><html><body><p>Bandingkan <code>10</code> dengan <code>13</code> agar kode mencetak <code>False</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"print(\" /><text value=\"10\" class=\"number\" /><text value=\" == \" /><text value=\"13\" class=\"number\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"9\" endIndex=\"11\" /><option startIndex=\"12\" endIndex=\"14\" /><option correct=\"false\"><content><text value=\"=\" /></content></option><option correct=\"false\"><content><text value=\"10\" /></content></option></options></interaction></interactions><output><content><text value=\"False\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>==</code>, diikuti oleh <code>13</code>.</p></body></html>"
