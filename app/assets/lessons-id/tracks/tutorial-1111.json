            "interactiveContent": "<!DOCTYPE html ><html><body><img src=\"151b6e63-caf5-4fe2-abd9-b39b49d9a8da\" visible-if=\"always\" /><p>Saat membandingkan, hanya ada dua hasil: <code>True</code> atau <code>False</code>.</p></body></html>",
            "hardModeSelected": true
