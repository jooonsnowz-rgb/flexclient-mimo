            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pernyataan <code>return</code> mana yang dijalankan dalam kode ini?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"addScoreBonus\" class=\"title\" /><text value=\"(\" /><text value=\"score\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" score + \" /><text value=\"10\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" \" /><text value=\"&quot;This line isn't executed&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" result = addScoreBonus(\" /><text value=\"29\" class=\"number\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(result);\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>return score + 10;</code></item><item value=\"2\" correct=\"false\"><code>return \"This line isn't executed\";</code></item></selection><p visible-if=\"wrong\"><code>return score + 10;</code>.</p></body></html>"
