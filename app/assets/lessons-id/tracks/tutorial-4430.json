            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang salah dengan kode ini?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"getRespawnMessage\" class=\"title\" /><text value=\"(\" /><text value=\"lives\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"if\" class=\"keyword\" /><text value=\" (lives &lt;= \" /><text value=\"0\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"return\" class=\"keyword\" /><text value=\" \" /><text value=\"&quot;Game Over&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" \" /><text value=\"&quot;Respawn&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" result = getRespawnMessage(\" /><text value=\"3\" class=\"number\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(result);\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Pernyataan <code>return</code> terakhir berada di luar fungsi</item><item value=\"2\" correct=\"false\">Kondisinya tidak akan pernah <code>true</code></item></selection><p visible-if=\"wrong\">Pernyataan <code>return</code> terakhir berada di luar fungsi.</p></body></html>"
          },
          {
