tor_id = director.director_id;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"8\" /><option startIndex=\"9\" endIndex=\"19\" /><option startIndex=\"20\" endIndex=\"30\" /><option startIndex=\"31\" endIndex=\"39\" /><option startIndex=\"40\" endIndex=\"42\" /><option correct=\"false\"><content><text value=\"DISTINCT\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"title\" /><header content=\"director_id\" /><header content=\"director_id\" /><header content=\"name\" /></row><row><data content=\"The Pianist\" /><data content=\"2\" /><data content=\"2\" /><data content=\"Polanski\" /></row><row><data content=\"Macbeth\" /><data content=\"2\" /><data content=\"2\" /><data content=\"Polanski\" /></row><row><data content=\"Somewhere\" /><data content=\"1\" /><data content=\"1\" /><data content=\"Coppola\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>SELECT *</code>, diikuti oleh <code>FROM movie</code>, lalu <code>INNER JOIN</code>, <code>director</code>, <code>ON</code>.</p></body></html>"
