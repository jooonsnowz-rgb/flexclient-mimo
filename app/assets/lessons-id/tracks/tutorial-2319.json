            "id": 84580,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tulis kondisi <code>if</code> agar blok kode <code>if</code> dijalankan.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"exercise = \" /><text value=\"60\" class=\"number\" /><text type=\"break\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" exercise &lt;= \" /><text value=\"60\" class=\"number\" /><text value=\":\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"&quot;Keep exercising, you're almost there.&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"else\" class=\"keyword\" /><text value=\":\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"&quot;Nice job! You exercised for the full amount.&quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"18\" endIndex=\"26\" /><option startIndex=\"27\" endIndex=\"29\" /><option startIndex=\"32\" endIndex=\"33\" /><option startIndex=\"30\" endIndex=\"32\" /><option correct=\"false\"><content><text value=\"&quot;60&quot;\" /></content></option><option correct=\"false\"><content><text value=\"=\" /></content></option></options></interaction></interactions><output><content><text value=\"Keep exercising, you're almost there.\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>exercise</code>, diikuti oleh <code>&lt;=</code>, lalu <code>60</code>, <code>:</code>.</p></body></html>"
