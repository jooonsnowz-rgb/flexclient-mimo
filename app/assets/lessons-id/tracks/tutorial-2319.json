            "interactiveContent": "<!DOCTYPE html ><html><body><p>Di mana letak pernyataan else?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"false\">Sebelum blok kode pernyataan if</item><item value=\"2\" correct=\"false\">Jika tidak ada blok kode pernyataan if</item><item value=\"3\" correct=\"false\">Di dalam blok kode pernyataan if</item><item value=\"4\" correct=\"true\">Setelah blok kode pernyataan if</item></selection><p visible-if=\"wrong\">Setelah blok kode pernyataan if.</p></body></html>"
