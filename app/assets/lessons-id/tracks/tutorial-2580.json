            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang ditampilkan kode ini di konsol?</p><code name=\"main.swift\" version=\"2\" codelang=\"swift\"><content><text value=\"var\" class=\"keyword\" /><text value=\" counter = \" /><text value=\"0\" class=\"number\" /><text type=\"break\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" counter &lt; \" /><text value=\"3\" class=\"number\" /><text value=\" {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"print\" class=\"built_in\" /><text value=\"(counter)\" /><text type=\"break\" /><text value=\"  counter += \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text value=\"}\" /></content><output><content><text value=\"0\" /><text type=\"break\" /><text value=\"1\" /><text type=\"break\" /><text value=\"2\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Angka <code>0</code>, <code>1</code>, dan <code>2</code></item><item value=\"2\" correct=\"false\">Angka <code>1</code>, <code>2</code>, dan <code>3</code></item><item value=\"3\" correct=\"false\">Angka <code>0</code>, <code>1</code>, <code>2</code>, dan<code>3</code></item></selection><p visible-if=\"wrong\">Angka <code>0</code>, <code>1</code>, dan <code>2</code>.</p></body></html>"
