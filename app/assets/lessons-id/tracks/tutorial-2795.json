          {
            "title": "Lesson #9",
            "id": 131245,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang dimaksud dengan union type dalam TypeScript?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Tipe yang dapat berupa salah satu dari beberapa tipe</item><item value=\"3\" correct=\"false\">Tipe yang mengecualikan properti tertentu</item><item value=\"4\" correct=\"false\">Tipe yang mengganti nama properti</item><item value=\"4\" correct=\"false\">Tidak ada yang namanya union type</item></selection><p visible-if=\"wrong\">Tipe yang dapat berupa salah satu dari beberapa tipe.</p></body></html>"
          },
          {
