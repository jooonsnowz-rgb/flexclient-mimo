            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pilih opsi yang memungkinkan perubahan tipe variabel <code>value</code>.</p><code version=\"2\" codelang=\"typescript\" name=\"script.ts\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" value: \" /><text value=\"any\" class=\"built_in\" /><text value=\" = \" /><text value=\"&quot;Hi there!&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"value = \" /><text value=\"100\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(value);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"11\" endIndex=\"14\" /><option correct=\"false\"><content><text value=\"string\" /></content></option></options></interaction></interactions><output><content><text value=\"100\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>any</code>.</p></body></html>"
