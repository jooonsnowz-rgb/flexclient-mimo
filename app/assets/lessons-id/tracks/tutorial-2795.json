            "id": 131206,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Gunakan union type untuk menentukan bahwa <code>id</code> dapat menyimpan nilai bertipe number atau string.</p><code version=\"2\" codelang=\"typescript\" name=\"script.ts\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" id: \" /><text value=\"number\" class=\"built_in\" /><text value=\" | \" /><text value=\"string\" class=\"built_in\" /><text value=\";\" /><text type=\"break\" /><text value=\"id = \" /><text value=\"&quot;1234&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"id = \" /><text value=\"1234\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(id);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"15\" endIndex=\"16\" /><option correct=\"false\"><content><text value=\"OR\" /></content></option></options></interaction></interactions><output><content><text value=\"1234\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>|</code>.</p></body></html>"
          },
