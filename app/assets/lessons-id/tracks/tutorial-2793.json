            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jenis apa yang bisa kita gunakan untuk membuat array campuran di TypeScript?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Semua tipe</item><item value=\"2\" correct=\"false\">Maksimal dua yang berbeda</item></selection><p visible-if=\"wrong\">Semua tipe.</p></body></html>"
          },
