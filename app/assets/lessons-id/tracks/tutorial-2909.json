            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa cara yang benar untuk mengirim parameter query ke <code>/search</code> untuk <code>type=fruit</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>/search?type=fruit</code></item><item value=\"2\" correct=\"false\"><code>/search/fruit</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>/search?type=fruit</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Rute <code>/search</code> membaca <code>req.query.type</code>. URL mana yang mengirim nilai <code>fruit</code> ke properti tersebut?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>/search?type=fruit</code></item><item value=\"2\" correct=\"false\"><code>/search/fruit</code></item><item value=\"3\" correct=\"false\"><code>/search?fruit=type</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>/search?type=fruit</code>.</p></body></html>"
