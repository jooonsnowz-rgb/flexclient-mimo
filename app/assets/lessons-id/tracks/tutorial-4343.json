            "id": 146818,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang ditampilkan kode ini di konsol?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"let\" class=\"keyword\" /><text value=\" level = \" /><text value=\"1\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" (level &lt;= \" /><text value=\"2\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\" level++;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(level);\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>3</code></item><item value=\"2\" correct=\"false\"><code>2</code></item><item value=\"3\" correct=\"false\"><code>1</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>3</code>.</p></body></html>"
