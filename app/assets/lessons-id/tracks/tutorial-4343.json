            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kode iterator sehingga variabel penghitung berkurang setiap kali loop diulangi.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"ammo++\" /></content></option><option correct=\"false\"><content><text value=\"ammo += 1\" /></content></option><option startIndex=\"31\" endIndex=\"37\" /></options></interaction></interactions><content><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" ammo = \" /><text value=\"30\" class=\"number\" /><text value=\"; ammo &gt; \" /><text value=\"25\" class=\"number\" /><text value=\"; ammo--) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(ammo);\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>ammo--</code>.</p></body></html>"
