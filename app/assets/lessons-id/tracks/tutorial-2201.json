            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang salah dengan kode ini?</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;!doctype html&gt;\" class=\"meta\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;\" /><text value=\"head\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"link\" class=\"name\" /><text value=\" \" /><text value=\"href\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;style.css&quot;\" class=\"string\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;/\" /><text value=\"head\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;/\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;/\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Attribute <code>rel</code> tidak ada</item><item value=\"2\" correct=\"false\">Atribut <code>href</code> seharusnya berupa <code>src</code></item><item value=\"3\" correct=\"false\">Lokasi style sheet salah</item><item value=\"3\" correct=\"false\">Elemen <code>link</code> harus berupa <code>script</code></item></selection><p visible-if=\"wrong\">Attribute <code>rel</code> tidak ada.</p></body></html>",
