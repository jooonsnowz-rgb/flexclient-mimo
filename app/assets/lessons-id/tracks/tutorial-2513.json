            "id": 126554,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tipe <strong>boolean</strong> hanya berisi dua nilai: nilai khusus <code>true</code> dan <code>false</code>.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" isOn = \" /><text value=\"true\" class=\"literal\" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(isOn)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"11\" endIndex=\"15\" /><option correct=\"false\"><content><text value=\"&quot;true&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"true\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>true</code>.</p></body></html>"
