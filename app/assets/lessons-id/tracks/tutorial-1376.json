            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa cara yang benar untuk mengakses variabel milik instance?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>instance.variable</code></item><item value=\"2\" correct=\"false\"><code>instance(variable)</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>instance.variable</code>.</p></body></html>",
