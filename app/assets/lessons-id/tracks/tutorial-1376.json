            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang dilakukan kode ini?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"VirtualPet\" class=\"title\" /><text value=\":\" /><text type=\"break\" /><text value=\"  color = \" /><text value=\"&quot;brown&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"fluffy = VirtualPet()\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Kita sedang mendefinisikan sebuah class dan membuat instance-nya</item><item value=\"4\" correct=\"false\">Kita hanya sedang mendefinisikan sebuah class</item></selection><p visible-if=\"wrong\">Kita sedang mendefinisikan sebuah class dan membuat instance-nya.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Setelah kode ini dijalankan, apa yang direpresentasikan oleh <code>VirtualPet</code> dan <code>fluffy</code>?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"VirtualPet\" class=\"title\" /><text value=\":\" /><text type=\"break\" /><text value=\"  color = \" /><text value=\"&quot;brown&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"fluffy = VirtualPet()\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>VirtualPet</code> adalah class dan <code>fluffy</code> adalah instance-nya</item><item value=\"2\" correct=\"false\">Kedua nama merepresentasikan class</item><item value=\"3\" correct=\"false\"><code>fluffy</code> adalah class dan <code>VirtualPet</code> adalah instance-nya</item></selection><p visible-if=\"wrong\"><code>VirtualPet</code> adalah class dan <code>fluffy</code> adalah instance-nya.</p></body></html>",
