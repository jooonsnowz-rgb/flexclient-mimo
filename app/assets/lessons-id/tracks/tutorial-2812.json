            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa itu signature fungsi?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Parameter dan tipe pengembalian suatu fungsi<br /></item><item value=\"2\" correct=\"false\">Nama sebuah fungsi<br /></item><item value=\"3\" correct=\"false\">Kode di dalam fungsi<br /></item><item value=\"4\" correct=\"false\">Variabel yang digunakan dalam sebuah fungsi</item></selection><p visible-if=\"wrong\">Parameter dan tipe pengembalian suatu fungsi<br />.</p></body></html>"
