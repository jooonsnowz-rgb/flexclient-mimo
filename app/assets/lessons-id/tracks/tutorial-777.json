            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa sebutan untuk kurung kurawal <code>{ }</code> dan kode di dalamnya?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"while\" class=\"keyword\" /><text value=\" (\" /><text value=\"false\" class=\"literal\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Echo&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Blok kode</item><item value=\"2\" correct=\"false\">Sebuah kondisi</item></selection><p visible-if=\"wrong\">Blok kode.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Dalam loop ini, bagian mana yang akan berulang jika kondisinya menjadi <code>true</code>?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"while\" class=\"keyword\" /><text value=\" (\" /><text value=\"false\" class=\"literal\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Echo&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Blok kode</item><item value=\"2\" correct=\"false\">Sebuah kondisi</item><item value=\"3\" correct=\"false\">Sebuah keyword</item></selection><p visible-if=\"wrong\">Pastikan kamu memilih Blok kode.</p></body></html>"
