            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa sebutan untuk loop yang terus mengulang selamanya?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Loop tak terbatas</item><item value=\"2\" correct=\"false\">Loop while</item></selection><p visible-if=\"wrong\">Loop tak terbatas.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Kondisi sebuah loop tidak pernah menjadi <code>false</code>. Jenis loop apakah itu?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Loop tak terbatas</item><item value=\"2\" correct=\"false\">Loop while</item><item value=\"3\" correct=\"false\">Blok kode</item></selection><p visible-if=\"wrong\">Pastikan kamu memilih Loop tak terbatas.</p></body></html>"
