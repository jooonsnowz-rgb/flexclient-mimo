            "id": 72691,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bagaimana kita tahu kapan perulangan while akan berhenti?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Dengan memeriksa kondisinya</item><item value=\"2\" correct=\"false\">Dengan memeriksa keyword-nya</item></selection><p visible-if=\"wrong\">Dengan memeriksa kondisinya.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Sebuah loop mulai berjalan. Apa yang menentukan apakah loop berhenti atau berjalan lagi?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Dengan memeriksa kondisinya</item><item value=\"2\" correct=\"false\">Dengan memeriksa keyword-nya</item><item value=\"3\" correct=\"false\">Dengan memeriksa kurung kurawal</item></selection><p visible-if=\"wrong\">Dengan memeriksa kondisinya.</p></body></html>"
