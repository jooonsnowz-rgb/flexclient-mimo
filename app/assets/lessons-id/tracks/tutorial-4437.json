            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bagaimana cara meneruskan nilai-nilai array ke fungsi inline <code>.map()</code> untuk dimodifikasi?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Dengan menambahkan parameter ke fungsi inline</item><item value=\"2\" correct=\"false\">Dengan menggunakan sintaks kurung siku</item></selection><p visible-if=\"wrong\">Dengan menambahkan parameter ke fungsi inline.</p></body></html>"
