            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang bisa kita akses dengan menyertakan parameter kedua dalam fungsi inline <code>.map()</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Indeks iterasi</item><item value=\"3\" correct=\"false\">Nilai array</item></selection><p visible-if=\"wrong\">Indeks iterasi.</p></body></html>"
