            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jenis fungsi apa yang dapat kita gunakan untuk menyederhanakan sintaks fungsi <code>.map()</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Fungsi arrow</item><item value=\"2\" correct=\"false\">Fungsi inline</item></selection><p visible-if=\"wrong\">Fungsi arrow.</p></body></html>"
