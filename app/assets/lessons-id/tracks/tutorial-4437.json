            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang perlu kita teruskan sebagai parameter untuk memberi tahu fungsi <code>.map()</code> cara memodifikasi setiap elemen?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Sebuah fungsi</item><item value=\"2\" correct=\"false\"><code>element</code></item></selection><p visible-if=\"wrong\">Sebuah fungsi.</p></body></html>"
