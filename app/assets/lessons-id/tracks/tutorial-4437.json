            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang harus disertakan fungsi <code>.map()</code> agar dapat menghasilkan array nilai baru dengan benar?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"2\" correct=\"true\">Pernyataan return</item><item value=\"3\" correct=\"false\">Sintaks untuk memodifikasi nilai array</item></selection><p visible-if=\"wrong\">Pernyataan return.</p></body></html>"
          },
          {
