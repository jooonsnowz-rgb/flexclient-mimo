            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang salah dengan kode ini?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"Musical\" class=\"title\" /><text value=\":\" /><text type=\"break\" /><text value=\"  name = \" /><text value=\"&quot;Hamilton&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"  length = \" /><text value=\"&quot;2h 40m&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"songs = \" /><text value=\"46\" class=\"number\" /><text type=\"break\" /><text type=\"break\" /><text value=\"hamilton = Musical()\" /><text type=\"break\" /><text value=\"print(hamilton.songs)\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Variabel <code>songs</code> harus diberi indentasi agar menjadi bagian dari definisi class</item><item value=\"2\" correct=\"false\">Tidak ada yang salah dengan kode ini</item><item value=\"3\" correct=\"false\">Variabel <code>hamilton</code> harus ditulis dengan huruf kapital</item></selection><p visible-if=\"wrong\">Variabel <code>songs</code> harus diberi indentasi agar menjadi bagian dari definisi class.</p></body></html>"
