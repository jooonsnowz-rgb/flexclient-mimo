            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tambahkan variabel bernama <code>channel_num</code> ke class dan atur nilainya menjadi 56.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"TV_Show\" class=\"title\" /><text value=\":\" /><text type=\"break\" /><text value=\"  show = \" /><text value=\"&quot;Spongebob Circleshirt&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"  channel = \" /><text value=\"&quot;Nickelodeon&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"  print(show)\" /><text type=\"break\" /><text value=\"  channel_num = \" /><text value=\"56\" class=\"number\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"90\" endIndex=\"105\" /></interactions><output><content><text value=\"Spongebob Circleshirt\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>channel_num = 5</code>.</p></body></html>"
