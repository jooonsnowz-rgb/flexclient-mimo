            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Minta nama pengguna dan simpan di variabel <code>user_name</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.py\" visible-if=\"always\"><content><text value=\"user_name = input(\" /><text value=\"&quot;Enter your name: &quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"12\" endIndex=\"17\" /></options></interaction></interactions></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>input</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Simpan jawaban dari prompt <code>Enter your name: </code> dalam <code>user_name</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.py\" visible-if=\"always\"><content><text value=\"user_name = input(\" /><text value=\"&quot;Enter your name: &quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"9\" /><option startIndex=\"10\" endIndex=\"11\" /><option startIndex=\"12\" endIndex=\"17\" /><option startIndex=\"18\" endIndex=\"37\" /><option correct=\"false\"><content><text value=\"print\" /></content></option><option correct=\"false\"><content><text value=\"name\" /></content></option><option correct=\"false\"><content><text value=\"==\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>user_name</code>, diikuti oleh <code>=</code>, <code>input</code>, dan terakhir <code>\"Enter your name: \"</code>.</p></body></html>"
