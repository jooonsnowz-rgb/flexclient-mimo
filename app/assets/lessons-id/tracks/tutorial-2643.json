            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tambahkan simbol untuk mengumpulkan input string dari pengguna dengan benar.</p><code version=\"2\" codelang=\"javascript\" name=\"script.py\" visible-if=\"always\"><content><text value=\"user_input = input(\" /><text value=\"&quot;Enter something: &quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"18\" endIndex=\"19\" /><option startIndex=\"38\" endIndex=\"39\" /></options></interaction></interactions></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>(</code>, diikuti oleh <code>)</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Lengkapi pemanggilan fungsi yang membaca string setelah menampilkan <code>Enter something: </code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.py\" visible-if=\"always\"><content><text value=\"user_input = input(\" /><text value=\"&quot;Enter something: &quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"13\" endIndex=\"18\" /><option startIndex=\"18\" endIndex=\"19\" /><option startIndex=\"19\" endIndex=\"38\" /><option startIndex=\"38\" endIndex=\"39\" /><option correct=\"false\"><content><text value=\"print\" /></content></option><option correct=\"false\"><content><text value=\"[\" /></content></option><option correct=\"false\"><content><text value=\"]\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>input</code>, diikuti oleh <code>(</code>, <code>\"Enter something: \"</code>, dan terakhir <code>)</code>.</p></body></html>"
