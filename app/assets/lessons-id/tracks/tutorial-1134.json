            "interactiveContent": "<!DOCTYPE html ><html><body><p>Berikan nilai <code>15</code> ke variabel <code>wallet</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"wallet = \" /><text value=\"15\" class=\"number\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"7\" endIndex=\"8\" /><option startIndex=\"9\" endIndex=\"11\" /><option correct=\"false\"><content><text value=\"==\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>=</code>, diikuti oleh <code>15</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Berikan nilai <code>15</code> ke variabel <code>wallet</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"wallet = \" /><text value=\"15\" class=\"number\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"8\" /><option startIndex=\"9\" endIndex=\"11\" /><option correct=\"false\"><content><text value=\"balance\" /></content></option><option correct=\"false\"><content><text value=\"==\" /></content></option><option correct=\"false\"><content><text value=\"16\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>wallet</code>, diikuti oleh <code>=</code>, dan terakhir <code>15</code>.</p></body></html>"
