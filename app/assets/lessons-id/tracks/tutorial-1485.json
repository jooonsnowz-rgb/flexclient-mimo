        "title": "Mengganti Nama",
        "type": "practiceLevel1",
        "lessons": [
          {
            "title": "Intro",
            "id": 96461,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Nama tabel atau kolom bisa cukup panjang, seperti <code>first_name</code> dan <code>last_name</code> di sini.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE contacts (&#xA; first_name varchar(255),&#xA; last_name varchar(255),&#xA; email varchar(255)&#xA;);&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Sam', 'Smith', 'sam17@mail.com');&#xA;&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Remy', 'Allard', 'rem@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Luis', 'Martinez', 'luis_99@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Kim', 'Zhong', 'kim.z@mail.com');&#xA;\"><tables><table name=\"contacts\"><row><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"Sam\" /><data content=\"Smith\" /><data content=\"sam17@mail.com\" /></row><row><data content=\"Remy\" /><data content=\"Allard\" /><data content=\"rem@mail.com\" /></row><row><data content=\"Luis\" /><data content=\"Martinez\" /><data content=\"luis_99@mail.com\" /></row><row><data content=\"Kim\" /><data content=\"Zhong\" /><data content=\"kim.z@mail.com\" /></row></table></tables></database></body></html>"
          },
          {
            "title": "Intro 2",
            "id": 96462,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Untuk menyederhanakan nama seperti <code>first_name</code> atau memberikan makna yang berbeda pada kolom dalam query, kita menggunakan <strong>aliasing</strong>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE contacts (&#xA; first_name varchar(255),&#xA; last_name varchar(255),&#xA; email varchar(255)&#xA;);&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Sam', 'Smith', 'sam17@mail.com');&#xA;&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Remy', 'Allard', 'rem@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Luis', 'Martinez', 'luis_99@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Kim', 'Zhong', 'kim.z@mail.com');&#xA;\"><tables><table name=\"contacts\"><row><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"Sam\" /><data content=\"Smith\" /><data content=\"sam17@mail.com\" /></row><row><data content=\"Remy\" /><data content=\"Allard\" /><data content=\"rem@mail.com\" /></row><row><data content=\"Luis\" /><data content=\"Martinez\" /><data content=\"luis_99@mail.com\" /></row><row><data content=\"Kim\" /><data content=\"Zhong\" /><data content=\"kim.z@mail.com\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" first_name\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" contacts;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"17\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"first_name\" /></row><row><data content=\"Sam\" /></row><row><data content=\"Remy\" /></row><row><data content=\"Luis\" /></row><row><data content=\"Kim\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>SELECT</code>, diikuti oleh <code>first_name</code>.</p></body></html>"
          },
          {
            "title": "Aliasing",
            "id": 96463,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dengan memberikan <strong>alias</strong> pada kolom, kita menetapkan nama sementara untuknya. Di sini, kita mengganti nama <code>first_name</code> menjadi <code>user</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE contacts (&#xA; first_name varchar(255),&#xA; last_name varchar(255),&#xA; email varchar(255)&#xA;);&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Sam', 'Smith', 'sam17@mail.com');&#xA;&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Remy', 'Allard', 'rem@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Luis', 'Martinez', 'luis_99@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Kim', 'Zhong', 'kim.z@mail.com');&#xA;\"><tables><table name=\"contacts\"><row><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"Sam\" /><data content=\"Smith\" /><data content=\"sam17@mail.com\" /></row><row><data content=\"Remy\" /><data content=\"Allard\" /><data content=\"rem@mail.com\" /></row><row><data content=\"Luis\" /><data content=\"Martinez\" /><data content=\"luis_99@mail.com\" /></row><row><data content=\"Kim\" /><data content=\"Zhong\" /><data content=\"kim.z@mail.com\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" first_name \" /><text value=\"AS\" class=\"keyword\" /><text value=\" \" /><text value=\"user\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" contacts;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"18\" endIndex=\"25\" /><option correct=\"false\"><content><text value=\"AS person\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"user\" /></row><row><data content=\"Sam\" /></row><row><data content=\"Remy\" /></row><row><data content=\"Luis\" /></row><row><data content=\"Kim\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>AS user</code>.</p></body></html>"
          },
          {
            "title": "AS",
            "id": 96465,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Saat membuat alias, kita mulai dengan memilih kolom seperti biasa. Lalu, kita menggunakan <code>AS</code> dengan sebuah alias, seperti <code>user</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE contacts (&#xA; first_name varchar(255),&#xA; last_name varchar(255),&#xA; email varchar(255)&#xA;);&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Sam', 'Smith', 'sam17@mail.com');&#xA;&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Remy', 'Allard', 'rem@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Luis', 'Martinez', 'luis_99@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Kim', 'Zhong', 'kim.z@mail.com');&#xA;\"><tables><table name=\"contacts\"><row><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"Sam\" /><data content=\"Smith\" /><data content=\"sam17@mail.com\" /></row><row><data content=\"Remy\" /><data content=\"Allard\" /><data content=\"rem@mail.com\" /></row><row><data content=\"Luis\" /><data content=\"Martinez\" /><data content=\"luis_99@mail.com\" /></row><row><data content=\"Kim\" /><data content=\"Zhong\" /><data content=\"kim.z@mail.com\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" first_name \" /><text value=\"AS\" class=\"keyword\" /><text value=\" \" /><text value=\"user\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" contacts;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"18\" endIndex=\"25\" /></interactions><output><table name=\"Result\"><row><header content=\"user\" /></row><row><data content=\"Sam\" /></row><row><data content=\"Remy\" /></row><row><data content=\"Luis\" /></row><row><data content=\"Kim\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>AS user</code>.</p></body></html>"
          },
          {
            "title": "Only within the query",
            "id": 96464,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Saat membuat alias untuk sebuah kolom, namanya berubah di dalam tabel hasil. Periksa kolom <code>user</code> dalam hasil kita.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE contacts (&#xA; first_name varchar(255),&#xA; last_name varchar(255),&#xA; email varchar(255)&#xA;);&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Sam', 'Smith', 'sam17@mail.com');&#xA;&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Remy', 'Allard', 'rem@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Luis', 'Martinez', 'luis_99@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Kim', 'Zhong', 'kim.z@mail.com');&#xA;\"><tables><table name=\"contacts\"><row><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"Sam\" /><data content=\"Smith\" /><data content=\"sam17@mail.com\" /></row><row><data content=\"Remy\" /><data content=\"Allard\" /><data content=\"rem@mail.com\" /></row><row><data content=\"Luis\" /><data content=\"Martinez\" /><data content=\"luis_99@mail.com\" /></row><row><data content=\"Kim\" /><data content=\"Zhong\" /><data content=\"kim.z@mail.com\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" first_name \" /><text value=\"AS\" class=\"keyword\" /><text value=\" \" /><text value=\"user\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" contacts;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"21\" endIndex=\"25\" /></interactions><output><table name=\"Result\"><row><header content=\"user\" /></row><row><data content=\"Sam\" /></row><row><data content=\"Remy\" /></row><row><data content=\"Luis\" /></row><row><data content=\"Kim\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>user</code>.</p></body></html>"
          },
          {
            "title": "Question: Aliasing",
            "id": 96784,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa fungsi aliasing?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Aliasing memberikan nama sementara pada sebuah kolom, yaitu alias</item><item value=\"2\" correct=\"false\">Aliasing hanya memilih nilai pertama dalam kolom</item></selection><p visible-if=\"wrong\">Aliasing memberikan nama sementara pada sebuah kolom, yaitu alias.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Kamu menjalankan <code>SELECT price AS cost FROM products;</code> Header mana yang muncul dalam tabel hasil?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>cost</code></item><item value=\"2\" correct=\"false\"><code>price</code>, karena alias hanya memberi label pada nilai</item><item value=\"3\" correct=\"false\"><code>products</code>, karena nama tabel menjadi header</item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>cost</code>.</p></body></html>"
          },
          {
            "title": "Question: AS",
            "id": 96785,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kata kunci apa yang kita gunakan saat membuat alias?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>AS</code></item><item value=\"2\" correct=\"false\"><code>FROM</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>AS</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Kita menggunakan <code>AS</code> saat membuat alias. Kamu ingin memilih <code>price</code> dan menampilkannya di bawah header <code>cost</code>. Fragmen mana yang menempatkan kata kunci dengan benar?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>price AS cost</code></item><item value=\"2\" correct=\"false\"><code>price FROM cost</code></item><item value=\"3\" correct=\"false\"><code>cost AS price</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>price AS cost</code>.</p></body></html>"
          },
          {
            "title": "Question: Only within the query",
            "id": 96786,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apakah alias mengganti nama kolom di tabel asli?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Tidak, aliasing hanya mengganti nama kolom di tabel hasil</item><item value=\"2\" correct=\"false\">Ya, aliasing mengganti nama kolom di tabel asli </item></selection><p visible-if=\"wrong\">Tidak, aliasing hanya mengganti nama kolom di tabel hasil.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Setelah <code>SELECT price AS cost FROM products;</code>, kamu menjalankan <code>SELECT price FROM products;</code>. Nama kolom mana yang masih berfungsi?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>price</code>, karena alias tidak mengubah tabel asli</item><item value=\"2\" correct=\"false\"><code>cost</code>, karena query pertama mengganti nama kolom secara permanen</item><item value=\"3\" correct=\"false\">Kedua nama, karena alias menambahkan kolom kedua ke tabel</item></selection><p visible-if=\"wrong\"><code>price</code>, karena alias tidak mengubah tabel asli.</p></body></html>"
          },
          {
            "title": "Example: Aliasing",
            "id": 96789,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pilih nilai <code>score</code> yang lebih besar dari <code>7</code> dengan alias <code>highest_score</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; score int&#xA;);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Jean Miller', 5);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Emma Brown', 8);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Reese Jones', 2);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Kim Lee', 9);&#xA;\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"score\" /></row><row><data content=\"Jean Miller\" /><data content=\"5\" /></row><row><data content=\"Emma Brown\" /><data content=\"8\" /></row><row><data content=\"Reese Jones\" /><data content=\"2\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" score \" /><text value=\"AS\" class=\"keyword\" /><text value=\" highest_score\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" score &gt; \" /><text value=\"7\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"12\" /><option startIndex=\"13\" endIndex=\"29\" /><option correct=\"false\"><content><text value=\"AS score\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"highest_score\" /></row><row><data content=\"8\" /></row><row><data content=\"9\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>SELECT score</code>, diikuti oleh <code>AS highest_score</code>.</p></body></html>"
          },
          {
            "title": "Example: AS",
            "id": 96790,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Gunakan <code>AS</code> untuk memberikan alias pada kolom hasil.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; score int&#xA;);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Jean Miller', 5);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Emma Brown', 8);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Reese Jones', 2);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Kim Lee', 9);&#xA;\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"score\" /></row><row><data content=\"Jean Miller\" /><data content=\"5\" /></row><row><data content=\"Emma Brown\" /><data content=\"8\" /></row><row><data content=\"Reese Jones\" /><data content=\"2\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" score \" /><text value=\"AS\" class=\"keyword\" /><text value=\" highest_score\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" score &gt; \" /><text value=\"7\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"13\" endIndex=\"15\" /></interactions><output><table name=\"Result\"><row><header content=\"highest_score\" /></row><row><data content=\"8\" /></row><row><data content=\"9\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>AS</code>.</p></body></html>"
          },
          {
            "title": "Example: Only within the query",
            "id": 96791,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pilih kolom <code>name</code> dan ganti namanya menjadi <code>team_leader</code> di tabel hasil.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; score int&#xA;);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Jean Miller', 5);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Emma Brown', 8);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Reese Jones', 2);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Kim Lee', 9);&#xA;\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"score\" /></row><row><data content=\"Jean Miller\" /><data content=\"5\" /></row><row><data content=\"Emma Brown\" /><data content=\"8\" /></row><row><data content=\"Reese Jones\" /><data content=\"2\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" team_leader\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" = \" /><text value=\"'Kim Lee'\" class=\"string\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"11\" /><option startIndex=\"12\" endIndex=\"14\" /><option startIndex=\"15\" endIndex=\"26\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"team_leader\" /></row><row><data content=\"Kim Lee\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>SELECT</code>, diikuti oleh <code>name</code>, lalu <code>AS</code>, <code>team_leader</code>.</p></body></html>"
          }
        ]
