            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Berapa banyak alias yang dapat kita berikan dalam sebuah query?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Satu untuk setiap kolom yang kita pilih</item><item value=\"2\" correct=\"false\">Hanya satu, untuk kolom pertama yang kita pilih</item></selection><p visible-if=\"wrong\">Satu untuk setiap kolom yang kita pilih.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Sebuah query memilih <code>name</code> dan <code>price</code>. Kamu menginginkan header hasil <code>product</code> dan <code>cost</code>. Bagaimana cara memberi alias?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Gunakan <code>name AS product</code> dan <code>price AS cost</code></item><item value=\"2\" correct=\"false\">Gunakan satu alias setelah <code>price</code>; alias tersebut mengganti nama kedua kolom yang dipilih</item><item value=\"3\" correct=\"false\">Beri alias tabel sebagai <code>product</code>; alias tersebut mengubah kedua header hasil</item></selection><p visible-if=\"wrong\">Gunakan <code>name AS product</code> dan <code>price AS cost</code>.</p></body></html>"
