            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pastikan variabel counter berkurang setiap kali loop diulang.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"30\" class=\"number\" /><text value=\"; i &gt; \" /><text value=\"25\" class=\"number\" /><text value=\"; i--) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(i);\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"25\" endIndex=\"28\" /><option correct=\"false\"><content><text value=\"i++\" /></content></option><option correct=\"false\"><content><text value=\"i += 1\" /></content></option></options></interaction></interactions><output><content><text value=\"30\" /><text type=\"break\" /><text value=\"29\" /><text type=\"break\" /><text value=\"28\" /><text type=\"break\" /><text value=\"27\" /><text type=\"break\" /><text value=\"26\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>i--</code>.</p></body></html>",
