            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jika kita ingin tombol tersusun bertumpuk, kita dapat menggunakan tag <code>&lt;br&gt;</code> untuk menempatkan setiap tombol di baris baru.</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"130\" endIndex=\"131\" /><option startIndex=\"131\" endIndex=\"133\" /><option startIndex=\"133\" endIndex=\"134\" /></options></interaction></interactions><content><text value=\"&lt;!doctype html&gt;\" class=\"meta\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"h3\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Game Menu\" /><text value=\"&lt;/\" /><text value=\"h3\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Choose an option to continue your quest.\" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"button\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Resume\" /><text value=\"&lt;/\" /><text value=\"button\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"br\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"button\" class=\"name\" /><text value=\"&gt;\" /><text value=\"New Game\" /><text value=\"&lt;/\" /><text value=\"button\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;/\" />