            "interactiveContent": "<!DOCTYPE html ><html><body><p>Gabungkan kedua list dan simpan hasilnya ke dalam <code>total_score</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"round_1 = [\" /><text value=\"5\" class=\"number\" /><text value=\", \" /><text value=\"3\" class=\"number\" /><text value=\", \" /><text value=\"1\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text value=\"round_2 = [\" /><text value=\"0\" class=\"number\" /><text value=\", \" /><text value=\"0\" class=\"number\" /><text value=\", \" /><text value=\"2\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"total_score = round_2 + round_1\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(total_score)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"63\" endIndex=\"64\" /><option startIndex=\"65\" endIndex=\"72\" /><option correct=\"false\"><content><text value=\"-\" /></content></option><option correct=\"false\"><content><text value=\",\" /></content></option><option correct=\"false\"><content><text value=\"/\" /></content></option></options></interaction></interactions><output><content><text value=\"[0, 0, 2, 5, 3, 1]\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>+</code>, diikuti oleh <code>round_1</code>.</p></body></html>"
