            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa fungsi kurung kurawal <code>{</code> dan <code>}</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Menandai blok kode yang menjadi bagian dari fungsi</item><item value=\"2\" correct=\"false\">Menunjukkan kode mana yang harus dilewati fungsi</item></selection><p visible-if=\"wrong\">Menandai blok kode yang menjadi bagian dari fungsi.</p></body></html>"
