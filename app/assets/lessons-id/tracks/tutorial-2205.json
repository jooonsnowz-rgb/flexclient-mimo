            "interactiveContent": "<!DOCTYPE html ><html><body><p>Nilai mana yang bukan merupakan string?</p><selection multiple=\"multiple\" iscode=\"false\"><item correct=\"true\" value=\"1\"><code>true</code></item><item correct=\"false\" value=\"2\"><code>\"true\"</code></item><item correct=\"false\" value=\"2\"><code>\"wrong\"</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>true</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Aplikasimu sudah siap. Nilai khusus mana yang harus disimpan dalam <code>isReady</code> untuk menunjukkannya?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>true</code></item><item value=\"2\" correct=\"false\"><code>\"true\"</code></item><item value=\"3\" correct=\"false\"><code>false</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>true</code>.</p></body></html>",
