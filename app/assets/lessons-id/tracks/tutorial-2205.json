            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa hasil dari penggunaan operator <code>===</code>?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">Nilai berupa <code>true</code> atau <code>false</code></item><item correct=\"false\" value=\"2\">Nilai berupa <code>\"true\"</code> atau <code>\"false\"</code></item><item correct=\"false\" value=\"2\">Nilai numerik</item></selection><p visible-if=\"wrong\">Nilai berupa <code>true</code> atau <code>false</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Jenis nilai apa yang dihasilkan ekspresi <code>8 === 8</code>?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Nilai Boolean <code>true</code></item><item value=\"2\" correct=\"false\">Nilai string <code>\"true\"</code></item><item value=\"3\" correct=\"false\">Angka <code>8</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih Nilai Boolean <code>true</code>.</p></body></html>"
