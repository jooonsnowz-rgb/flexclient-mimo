            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tanda mana yang mengubah <code>true</code> menjadi <code>false</code>?</p><selection multiple=\"multiple\" iscode=\"false\"><item correct=\"true\" value=\"1\"><code>!</code></item><item correct=\"false\" value=\"2\"><code>-</code></item><item correct=\"false\" value=\"2\"><code>?</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>!</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Ekspresi mana yang menghasilkan <code>false</code> dengan membalikkan <code>true</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>!true</code></item><item value=\"2\" correct=\"false\"><code>-true</code></item><item value=\"3\" correct=\"false\"><code>?true</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>!true</code>.</p></body></html>"
