            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tulis tanda <code>=</code> untuk memberikan variabel <code>spaceship</code> nilai string <code>\"Enterprise\"</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" spaceship = \" /><text value=\"&quot;Enterprise&quot;\" class=\"string\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"16\" endIndex=\"17\" /></interactions></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>=</code>.</p></body></html>"
