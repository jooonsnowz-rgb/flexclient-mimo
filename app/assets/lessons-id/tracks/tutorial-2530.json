            "id": 126735,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tambahkan pernyataan print di antara kurung kurawal untuk membuat blok kode pernyataan if.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"if\" class=\"keyword\" /><text value=\" \" /><text value=\"true\" class=\"literal\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Ticket booked!&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"8\" endIndex=\"9\" /><option startIndex=\"11\" endIndex=\"16\" /><option startIndex=\"17\" endIndex=\"33\" /><option correct=\"false\"><content><text value=\"(\" /></content></option><option correct=\"false\"><content><text value=\")\" /></content></option></options></interaction></interactions><output><content><text value=\"Ticket booked!\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>{</code>, diikuti oleh <code>print</code>, dan terakhir <code>\"Ticket booked!\"</code>.</p></body></html>"
