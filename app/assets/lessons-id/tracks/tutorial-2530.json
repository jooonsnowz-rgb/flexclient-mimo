            "id": 126736,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tambahkan snippet kode kedua untuk memperluas blok kode.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"if\" class=\"keyword\" /><text value=\" \" /><text value=\"true\" class=\"literal\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Good morning!&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;You have three appointments today&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"35\" endIndex=\"40\" /><option startIndex=\"40\" endIndex=\"41\" /><option startIndex=\"41\" endIndex=\"76\" /><option startIndex=\"76\" endIndex=\"77\" /><option correct=\"false\"><content><text value=\"{\" /></content></option><option correct=\"false\"><content><text value=\"}\" /></content></option></options></interaction></interactions><output><content><text value=\"Good morning!\" /><text type=\"break\" /><text value=\"You have three appointments today\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>print</code>, diikuti oleh <code>(</code>, lalu <code>\"You have three appointments today\"</code>, <code>)</code>.</p></body></html>"
          },
          {
