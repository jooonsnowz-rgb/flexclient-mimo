            "id": 126734,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang ditampilkan kode ini di konsol?</p><code name=\"main.swift\" version=\"2\" codelang=\"swift\"><content><text value=\"let\" class=\"keyword\" /><text value=\" inboxFull = \" /><text value=\"false\" class=\"literal\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" inboxFull {\" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Your inbox is full&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Tidak ada apa pun karena kode di antara kurung kurawal dilewati</item><item value=\"2\" correct=\"false\"><code>Your inbox is full</code></item></selection><p visible-if=\"wrong\">Tidak ada apa pun karena kode di antara kurung kurawal dilewati.</p></body></html>"
