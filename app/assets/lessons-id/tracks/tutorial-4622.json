            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Lengkapi handler kedua agar jumlah yang hilang mendapatkan responsnya sendiri.</p><code version=\"2\" codelang=\"python\" name=\"checkout.py\" visible-if=\"always\"><content><text value=\"record = {\" /><text value=\"&quot;price&quot;\" class=\"string\" /><text value=\": \" /><text value=\"&quot;12&quot;\" class=\"string\" /><text value=\"}\" /><text type=\"break\" /><text value=\"try\" class=\"keyword\" /><text value=\":\" /><text type=\"break\" /><text value=\"  price = float(record[\" /><text value=\"&quot;price&quot;\" class=\"string\" /><text value=\"])\" /><text type=\"break\" /><text value=\"  quantity = record[\" /><text value=\"&quot;quantity&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text value=\"except\" class=\"keyword\" /><text value=\" ValueError:\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"&quot;Price failed&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"except\" class=\"keyword\" /><text value=\" KeyError:\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"&quot;Read failed&quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"145\" endIndex=\"153\" /><option correct=\"false\"><content><text value=\"ValueError\" /></content></option><option correct=\"false\"><content><text value=\"TypeError\" /></content></option></options></interaction></interactions><output><content><text value=\"Read failed\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>KeyError</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Lengkapi handler kedua agar jumlah yang hilang mendapatkan responsnya sendiri.</p><code version=\"2\" codelang=\"python\" name=\"checkout.py\" visible-if=\"always\"><content><text value=\"record = {\" /><text value=\"&quot;price&quot;\" class=\"string\" /><text value=\": \" /><text value=\"&quot;12&quot;\" class=\"string\" /><text value=\"}\" /><text type=\"break\" /><text value=\"try\" class=\"keyword\" /><text value=\":\" /><text type=\"break\" /><text value=\"  price = float(record[\" /><text value=\"&quot;price&quot;\" class=\"string\" /><text value=\"])\" /><text type=\"break\" /><text value=\"  quantity = record[\" /><text value=\"&quot;quantity&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text value=\"except\" class=\"keyword\" /><text value=\" ValueError:\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"&quot;Price failed&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"except\" class=\"keyword\" /><text value=\" KeyError:\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"&quot;Read failed&quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"145\" endIndex=\"153\" /><option startIndex=\"74\" endIndex=\"75\" /><option correct=\"false\"><content><text value=\"ValueError\" /></content></option><option correct=\"false\"><content><text value=\"TypeError\" /></content></option></options></interaction></interactions><output><content><text value=\"Read failed\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>=</code>, diikuti oleh <code>KeyError</code>.</p></body></html>"
