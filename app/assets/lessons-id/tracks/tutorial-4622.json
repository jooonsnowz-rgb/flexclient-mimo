          {
            "title": "Label the Failed Step",
            "id": 152099,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tambahkan label singkat yang mengidentifikasi konversi rating yang gagal.</p><code version=\"2\" codelang=\"python\" name=\"rating.py\" visible-if=\"always\"><content><text value=\"rating_text = \" /><text value=\"&quot;great&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"try\" class=\"keyword\" /><text value=\":\" /><text type=\"break\" /><text value=\"  rating = int(rating_text)\" /><text type=\"break\" /><text value=\"except\" class=\"keyword\" /><text value=\" ValueError \" /><text value=\"as\" class=\"keyword\" /><text value=\" error:\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"&quot;Rating:&quot;\" class=\"string\" /><text value=\", error)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"91\" endIndex=\"100\" /><option correct=\"false\"><content><text value=\"&quot;Price:&quot;\" /></content></option><option correct=\"false\"><content><text value=\"&quot;Order:&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"Rating: invalid literal for int() with base 10: 'great'\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>\"Rating:\"</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Tampilkan <code>Rating:</code> sebelum detail kegagalan konversi rating.</p><code version=\"2\" codelang=\"python\" name=\"rating.py\" visible-if=\"always\"><content><text value=\"rating_text = \" /><text value=\"&quot;great&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"try\" class=\"keyword\" /><text value=\":\" /><text type=\"break\" /><text value=\"  rating = int(rating_text)\" /><text type=\"break\" /><text value=\"except\" class=\"keyword\" /><text value=\" ValueError \" /><text value=\"as\" class=\"keyword\" /><text value=\" error:\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"&quot;Rating:&quot;\" class=\"string\" /><text value=\", error)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"62\" endIndex=\"72\" /><option startIndex=\"91\" endIndex=\"100\" /><option correct=\"false\"><content><text value=\"TypeError\" /></content></option><option correct=\"false\"><content><text value=\"&quot;Price:&quot;\" /></content></option><option correct=\"false\"><content><text value=\"&quot;Order:&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"Rating: invalid literal for int() with base 10: 'great'\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>ValueError</code>, diikuti oleh <code>\"Rating:\"</code>.</p></body></html>",
            "hardModeSelected": true
