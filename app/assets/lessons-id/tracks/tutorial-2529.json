            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Operator mana yang dapat menetapkan hasil perbandingan ke variabel dalam Swift?</p><selection multiple=\"multiple\" iscode=\"false\"><item correct=\"true\" value=\"1\"><code>=</code></item><item correct=\"false\" value=\"2\"><code>==</code></item><item correct=\"false\" value=\"3\"><code>&lt;=</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>=</code>.</p></body></html>"
          },
