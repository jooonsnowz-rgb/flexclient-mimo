            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang ditampilkan kode ini di konsol?</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Repeat song: \\(true)&quot;\" class=\"string\" /><text value=\")\" /></content><output><content><text value=\"Repeat song: true\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">String <code>\"Repeat song: true\"</code></item><item value=\"2\" correct=\"false\">Boolean <code>true</code></item><item value=\"3\" correct=\"false\">String <code>\"Repeat song: \"</code></item></selection><p visible-if=\"wrong\">String <code>\"Repeat song: true\"</code>.</p></body></html>"
