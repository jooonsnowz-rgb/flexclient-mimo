            "id": 126696,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Simpan hasil perbandingan di <code>pass</code>.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" score = \" /><text value=\"32\" class=\"number\" /><text type=\"break\" /><text value=\"let\" class=\"keyword\" /><text value=\" minScore = \" /><text value=\"30\" class=\"number\" /><text type=\"break\" /><text value=\"let\" class=\"keyword\" /><text value=\" pass = score &gt;= minScore\" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(pass)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"33\" endIndex=\"36\" /><option startIndex=\"37\" endIndex=\"41\" /><option startIndex=\"42\" endIndex=\"43\" /><option startIndex=\"44\" endIndex=\"61\" /><option correct=\"false\"><content><text value=\"===\" /></content></option><option correct=\"false\"><content><text value=\"&lt;=\" /></content></option></options></interaction></interactions><output><content><text value=\"true\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>let</code>, diikuti oleh <code>pass</code>, lalu <code>=</code>, <code>score &gt;= minScore</code>.</p></body></html>"
          },
