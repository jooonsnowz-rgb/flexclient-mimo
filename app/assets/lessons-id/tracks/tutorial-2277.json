            "interactiveContent": "<!DOCTYPE html ><html><body><p>Di mana aku bisa mendapatkan informasi tentang fungsi yang dimiliki sebuah library?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Dokumentasi</item><item value=\"2\" correct=\"false\">Hubungi penulis</item><item value=\"3\" correct=\"false\">Kamu tidak bisa mendapatkan informasinya</item></selection><p visible-if=\"wrong\">Pastikan kamu memilih Dokumentasi.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Kamu perlu mengetahui argumen yang diterima dan nilai return sebuah fungsi library sebelum memanggilnya. Di mana kamu harus melihat terlebih dahulu?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Dokumentasi library.</item><item value=\"2\" correct=\"false\">Detail kontak pribadi penulis.</item><item value=\"3\" correct=\"false\">Nama package saja.</item></selection><p visible-if=\"wrong\">Dokumentasi library.</p></body></html>"
