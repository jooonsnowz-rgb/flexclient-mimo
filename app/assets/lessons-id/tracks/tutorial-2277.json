            "interactiveContent": "<!DOCTYPE html ><html><body><p>Mari ekspor <code>bill</code> dan <code>total</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"mod.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" bill = \" /><text value=\"40\" class=\"number\" /><text value=\"; \" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" total = \" /><text value=\"(\" /><text value=\"bill\" class=\"params\" /><text value=\") =&gt;\" /><text value=\" { \" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" bill + \" /><text value=\"5\" class=\"number\" /><text value=\"; \" /><text type=\"break\" /><text value=\"}; \" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"export\" class=\"keyword\" /><text value=\" {bill, total};\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"72\" endIndex=\"78\" /><option startIndex=\"79\" endIndex=\"80\" /><option startIndex=\"91\" endIndex=\"92\" /><option correct=\"false\"><content><text value=\"[\" /></content></option><option correct=\"false\"><content><text value=\"]\" /></content></option></options></interaction></interactions><output><content><text value=\"40\" /></content></output></code><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"import\" class=\"keyword\" /><text value=\" bill \" /><text value=\"from\" class=\"keyword\" /><text value=\" \" /><text value=\"&quot;./mod.js&quot;\" class=\"string\" /><text value=\"; \" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(bill);\" /></content></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>export</code>, diikuti oleh <code>{</code>, dan terakhir <code>}</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Modul harus menyediakan <code>bill</code> dan <code>total</code>. Gunakan sintaks named export.</p><code version=\"2\" codelang=\"javascript\" name=\"mod.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" bill = \" /><text value=\"40\" class=\"number\" /><text value=\"; \" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" total = \" /><text value=\"(\" /><text value=\"bill\" class=\"params\" /><text value=\") =&gt;\" /><text value=\" { \" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" bill + \" /><text value=\"5\" class=\"number\" /><text value=\"; \" /><text type=\"break\" /><text value=\"}; \" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"export\" class=\"keyword\" /><text value=\" {bill, total};\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"72\" endIndex=\"78\" /><option startIndex=\"79\" endIndex=\"80\" /><option startIndex=\"91\" endIndex=\"92\" /><option correct=\"false\"><content><text value=\"[\" /></content></option><option correct=\"false\"><content><text value=\"]\" /></content></option><option correct=\"false\"><content><text value=\"default\" /></content></option></options></interaction></interactions></code><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"import\" class=\"keyword\" /><text value=\" \" /><text value=\"{\" /><text value=\"bill\" /><text value=\"}\" /><text value=\" \" /><text value=\"from\" class=\"keyword\" /><text value=\" \" /><text value=\"&quot;./mod.js&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".\" /><text value=\"log\" /><text value=\"(\" /><text value=\"bill\" /><text value=\")\" /><text value=\";\" /></content><output><content><text value=\"40\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>export</code>, diikuti oleh <code>{</code>, dan terakhir <code>}</code>.</p></body></html>",
            "hardModeSelected": true
