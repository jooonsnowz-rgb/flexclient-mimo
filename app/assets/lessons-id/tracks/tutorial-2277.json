            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Mari tulis sebuah modul yang berisi kode untuk menampilkan tagihan pelanggan. Gunakan default export untuk mengekspor <code>bill</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"mod.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" bill = \" /><text value=\"40\" class=\"number\" /><text value=\"; \" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"export\" class=\"keyword\" /><text value=\" \" /><text value=\"default\" class=\"keyword\" /><text value=\" bill;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"20\" endIndex=\"26\" /><option startIndex=\"27\" endIndex=\"34\" /><option correct=\"false\"><content><text value=\"import\" /></content></option></options></interaction></interactions></code><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"// To be continued!\" class=\"comment\" /></content></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>export</code>, diikuti oleh <code>default</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Modul memiliki satu nilai publik, <code>bill</code>. Ekspor nilai tersebut sebagai default modul.</p><code version=\"2\" codelang=\"javascript\" name=\"mod.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" bill = \" /><text value=\"40\" class=\"number\" /><text value=\"; \" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"export\" class=\"keyword\" /><text value=\" \" /><text value=\"default\" class=\"keyword\" /><text value=\" bill;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"20\" endIndex=\"26\" /><option startIndex=\"27\" endIndex=\"34\" /><option correct=\"false\"><content><text value=\"import\" /></content></option><option correct=\"false\"><content><text value=\"from\" /></content></option><option correct=\"false\"><content><text value=\"return\" /></content></option></options></interaction></interactions></code><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"// To be continued!\" class=\"comment\" /></content></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>export</code>, diikuti oleh <code>default</code>.</p></body></html>",
