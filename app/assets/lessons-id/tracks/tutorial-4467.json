        "lessons": [
          {
            "title": "Lesson #1",
            "id": 148752,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa tujuan ES6?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Memperbaiki masalah dan meningkatkan sintaks JS</item><item value=\"2\" correct=\"false\">Untuk membuat scope baru</item><item value=\"3\" correct=\"false\">Untuk menyertakan kata-kata khusus baru</item></selection><p visible-if=\"wrong\">Memperbaiki masalah dan meningkatkan sintaks JS.</p></body></html>"
          },
          {
            "title": "Lesson #2",
            "id": 148753,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa scope dari variabel <code>health</code>?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"1\" class=\"number\" /><text value=\"; i &lt;= \" /><text value=\"3\" class=\"number\" /><text value=\"; i++) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" health = i * \" /><text value=\"10\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Player health: &quot;\" class=\"string\" /><text value=\" + health);\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Cakupan Blok</item><item value=\"2\" correct=\"false\">Scope Lokal</item><item value=\"3\" correct=\"false\">Scope Global</item></selection><p visible-if=\"wrong\">Cakupan Blok.</p></body></html>"
          },
          {
            "title": "Lesson #3",
            "id": 148754,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa jenis variabel <code>score</code>?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"let\" class=\"keyword\" /><text value=\" score = \" /><text value=\"6\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"0\" class=\"number\" /><text value=\"; i &lt;= \" /><text value=\"5\" class=\"number\" /><text value=\"; i++) {\" /><text type=\"break\" /><text value=\" score--;\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(score);\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Global</item><item value=\"2\" correct=\"false\">Lokal</item><item value=\"3\" correct=\"false\">Blok</item></selection><p visible-if=\"wrong\">Pastikan kamu memilih Global.</p></body></html>"
          },
          {
            "title": "Lesson #4",
            "id": 148755,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Variabel mana yang berada dalam cakupan blok?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"var\" class=\"keyword\" /><text value=\" gameRunning = \" /><text value=\"true\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"toggleGame\" class=\"title\" /><text value=\"(\" /><text value=\"\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\"  \" /><text value=\"var\" class=\"keyword\" /><text value=\" logMessage = \" /><text value=\"&quot;Game state: &quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"  \" /><text value=\"if\" class=\"keyword\" /><text value=\" (gameRunning) {\" /><text type=\"break\" /><text value=\"    \" /><text value=\"let\" class=\"keyword\" /><text value=\" action = \" /><text value=\"&quot;Pausing game...&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"    \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(logMessage + action);\" /><text type=\"break\" /><text value=\"    gameRunning = \" /><text value=\"false\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"  } \" /><text value=\"else\" class=\"keyword\" /><text value=\" {\" /><text type=\"break\" /><text value=\"    \" /><text value=\"let\" class=\"keyword\" /><text value=\" action = \" /><text value=\"&quot;Resuming game...&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"    \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(logMessage + action);\" /><text type=\"break\" /><text value=\"    gameRunning = \" /><text value=\"true\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"  }\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"toggleGame();\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>action</code></item><item value=\"2\" correct=\"false\"><code>gameRunning</code></item><item value=\"3\" correct=\"false\"><code>logMessage</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>action</code>.</p></body></html>"
          },
          {
            "title": "Lesson #5",
            "id": 148756,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jenis variabel apa yang tidak dapat dideklarasikan ulang atau nilainya diperbarui?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>const</code></item><item value=\"2\" correct=\"false\"><code>let</code></item><item value=\"3\" correct=\"false\"><code>var</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>const</code>.</p></body></html>"
          },
          {
            "title": "Lesson #6",
            "id": 148757,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tulis sintaks yang membuat arrow function tanpa parameter.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"{\" /></content></option><option correct=\"false\"><content><text value=\"}\" /></content></option><option startIndex=\"21\" endIndex=\"22\" /><option startIndex=\"22\" endIndex=\"23\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" getMaxHealth = \" /><text value=\"()\" class=\"params\" /><text value=\" =&gt;\" /><text value=\" \" /><text value=\"200\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getMaxHealth());\" /></content></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>(</code>, diikuti oleh <code>)</code>.</p></body></html>"
          },
          {
            "title": "Lesson #7",
            "id": 148758,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kodekan nilai yang digunakan untuk mendeklarasikan fungsi arrow.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"-&gt;\" /></content></option><option correct=\"false\"><content><text value=\"=\" /></content></option><option startIndex=\"24\" endIndex=\"26\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" getMaxHealth = \" /><text value=\"()\" class=\"params\" /><text value=\" =&gt;\" /><text value=\" \" /><text value=\"200\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getMaxHealth());\" /></content></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>=&gt;</code>.</p></body></html>"
          },
          {
            "title": "Lesson #8",
            "id": 148759,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Isi nilai yang hilang dalam kode berikut.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"(\" /></content></option><option correct=\"false\"><content><text value=\")\" /></content></option><option startIndex=\"27\" endIndex=\"28\" /><option startIndex=\"66\" endIndex=\"67\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" getMaxHealth = \" /><text value=\"()\" class=\"params\" /><text value=\" =&gt;\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" health = \" /><text value=\"200\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" health;\" /><text type=\"break\" /><text value=\"};\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getMaxHealth());\" /></content></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>{</code>, diikuti oleh <code>}</code>.</p></body></html>"
          },
          {
            "title": "Lesson #9",
            "id": 148760,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Buat fungsi arrow yang akan mengembalikan nilai <code>200</code> saat dipanggil.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"21\" endIndex=\"30\" isDefault=\"true\" /></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" getMaxHealth = \" /><text value=\"()\" class=\"params\" /><text value=\" =&gt;\" /><text value=\" \" /><text value=\"200\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getMaxHealth());}\" /></content></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>() =&gt; 200</code>.</p></body></html>"
          },
          {
            "title": "Lesson #10",
            "id": 148761,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Panggil arrow function di dalam pernyataan display.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"74\" endIndex=\"84\" isDefault=\"true\" /></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" getScore = \" /><text value=\"()\" class=\"params\" /><text value=\" =&gt;\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" score = \" /><text value=\"200\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" score\" /><text type=\"break\" /><text value=\"};\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getScore());}\" /></content></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>getScore()</code>.</p></body></html>"
          },
          {
            "title": "Lesson #11",
            "id": 148762,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bagaimana hasil menjalankan kode berikut?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getDamagePerHit = \" /><text value=\"(\" /><text value=\"totalDamage, hits\" class=\"params\" /><text value=\") =&gt;\" /><text value=\" totalDamage / hits;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getDamagePerHit(\" /><text value=\"20\" class=\"number\" /><text value=\", \" /><text value=\"2\" class=\"number\" /><text value=\"));\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>10</code></item><item value=\"2\" correct=\"false\"><code>40</code></item><item value=\"3\" correct=\"false\"><code>22</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>10</code>.</p></body></html>"
          },
          {
            "title": "Lesson #12",
            "id": 148763,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang salah dengan kode berikut?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getDoubleDamage = \" /><text value=\"(\" /><text value=\"damage\" class=\"params\" /><text value=\") =&gt;\" /><text value=\" damage * \" /><text value=\"2\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getDoubleDamage());\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Kita perlu menetapkan nilai parameter default agar <code>NaN</code> tidak ditampilkan</item><item value=\"2\" correct=\"false\">Menggunakan tanda kurung dengan satu parameter menyebabkan error</item><item value=\"3\" correct=\"false\">Kurung kurawal tidak ada</item></selection><p visible-if=\"wrong\">Kita perlu menetapkan nilai parameter default agar <code>NaN</code> tidak ditampilkan.</p></body></html>"
          },
          {
            "title": "Lesson #13",
            "id": 148764,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tambahkan nilai parameter default <code>0</code> ke fungsi arrow.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"=&gt;\" /></content></option><option startIndex=\"38\" endIndex=\"45\" /><option startIndex=\"46\" endIndex=\"47\" /><option startIndex=\"48\" endIndex=\"49\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" getConvertedSecondsToMinutes = \" /><text value=\"(\" /><text value=\"seconds = \" /><text value=\"0\" class=\"number\" /><text value=\") =&gt;\" /><text value=\" seconds / \" /><text value=\"60\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getConvertedSecondsToMinutes());\" /></content></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>seconds</code>, diikuti oleh <code>=</code>, dan terakhir <code>0</code>.</p></body></html>"
          },
          {
            "title": "Lesson #14",
            "id": 148765,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tulis sintaks sesingkat mungkin yang meneruskan satu parameter, <code>deltaTime</code>, ke fungsi arrow.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"26\" endIndex=\"35\" isDefault=\"true\" /></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" getFramesInSecond = \" /><text value=\"deltaTime\" class=\"params\" /><text value=\" =&gt;\" /><text value=\" \" /><text value=\"1\" class=\"number\" /><text value=\" / deltaTime;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getFramesInSecond(\" /><text value=\"0.5\" class=\"number\" /><text value=\"));}\" /></content></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>deltaTime</code>.</p></body></html>"
          },
          {
            "title": "Lesson #15",
            "id": 148766,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tambahkan parameter kedua, <code>enemyCount</code>, ke fungsi arrow.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\":\" /></content></option><option correct=\"false\"><content><text value=\"and\" /></content></option><option startIndex=\"27\" endIndex=\"28\" /><option startIndex=\"29\" endIndex=\"39\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" getTotalLoot = \" /><text value=\"(\" /><text value=\"coins, enemyCount\" class=\"params\" /><text value=\") =&gt;\" /><text value=\" coins * enemyCount;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getTotalLoot(\" /><text value=\"10\" class=\"number\" /><text value=\", \" /><text value=\"5\" class=\"number\" /><text value=\"));\" /></content></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>,</code>, diikuti oleh <code>enemyCount</code>.</p></body></html>"
          }
        ]
      }
    ]
  }
