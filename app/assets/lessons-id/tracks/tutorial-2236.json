            "id": 73145,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang ditampilkan kode ini di konsol?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" counter = \" /><text value=\"1\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" (counter &lt; \" /><text value=\"2\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\" counter++;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(counter);\" /></content><output><content><text value=\"2\" /></content></output></code><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>2</code></item><item value=\"2\" correct=\"false\"><code>1</code></item><item value=\"3\" correct=\"false\"><code>3</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>2</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Apa yang ditampilkan kode ini di konsol?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" counter = \" /><text value=\"1\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" (counter &lt; \" /><text value=\"2\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\" counter++;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(counter);\" /></content><output><content><text value=\"2\" /></content></output></code><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>2</code></item><item value=\"2\" correct=\"false\"><code>1</code></item><item value=\"3\" correct=\"false\"><code>3</code></item><item value=\"4\" correct=\"false\"><code>0</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>2</code>.</p></body></html>"
