            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bagaimana kita tahu bahwa while loop ini melewati blok kodenya?</p><code name=\"main.swift\" version=\"2\" codelang=\"swift\"><content><text value=\"while\" class=\"keyword\" /><text value=\" \" /><text value=\"false\" class=\"literal\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Loading...&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Kondisinya adalah <code>false</code></item><item value=\"2\" correct=\"false\">Kondisinya adalah <code>true</code></item><item value=\"3\" correct=\"false\">Kita tidak bisa mengetahui apakah fungsi tersebut melewati blok kodenya</item></selection><p visible-if=\"wrong\">Kondisinya adalah <code>false</code>.</p></body></html>"
