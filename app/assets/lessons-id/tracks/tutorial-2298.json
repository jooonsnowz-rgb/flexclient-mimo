          {
            "title": "Question: MAX",
            "id": 96941,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa hasil dari query ini?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE coffee (&#xA; type varchar(255),&#xA; price numeric(3,2)&#xA;);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('espresso', 3);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('macchiato', 5);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('americano', 4.5);&#xA;&#xA;\"><tables><table name=\"coffee\"><row><header content=\"type\" /><header content=\"price\" /></row><row><data content=\"espresso\" /><data content=\"3\" /></row><row><data content=\"macchiato\" /><data content=\"5\" /></row><row><data content=\"americano\" /><data content=\"4.5\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"MAX\" class=\"keyword\" /><text value=\"(price)\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" coffee;\" /></content><output><table name=\"Result\"><row><header content=\"MAX(price)\" /></row><row><data content=\"5\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>5</code></item><item value=\"2\" correct=\"false\"><code>3</code></item><item value=\"3\" correct=\"false\"><code>4.5</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>5</code>.</p></body></html>"
          },
          {
            "title": "Example: MIN",
            "id": 96942,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pilih nilai <code>price</code> terkecil dengan <code>MIN</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE coffee (&#xA; type varchar(255),&#xA; price numeric(3,2)&#xA;);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('espresso', 3);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('macchiato', 5);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('americano', 4.5);&#xA;&#xA;\"><tables><table name=\"coffee\"><row><header content=\"type\" /><header content=\"price\" /></row><row><data content=\"espresso\" /><data content=\"3\" /></row><row><data content=\"macchiato\" /><data content=\"5\" /></row><row><data content=\"americano\" /><data content=\"4.5\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"MIN\" class=\"keyword\" /><text value=\"(price)\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" coffee;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"0\" endIndex=\"17\" /></interactions><output><table name=\"Result\"><row><header content=\"MIN(price)\" /></row><row><data content=\"3\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>SELECT MIN(price)</code>.</p></body></html>"
          },
          {
            "title": "Example: AVG",
            "id": 96946,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pilih rata-rata <code>price</code> dengan <code>AVG</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE coffee (&#xA; type varchar(255),&#xA; price numeric(3,2)&#xA;);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('espresso', 3);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('macchiato', 5);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('americano', 4.5);&#xA;&#xA;\"><tables><table name=\"coffee\"><row><header content=\"type\" /><header content=\"price\" /></row><row><data content=\"espresso\" /><data content=\"3\" /></row><row><data content=\"macchiato\" /><data content=\"5\" /></row><row><data content=\"americano\" /><data content=\"4.5\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"AVG\" class=\"keyword\" /><text value=\"(price)\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" coffee;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"0\" endIndex=\"17\" /></interactions><output><table name=\"Result\"><row><header content=\"AVG(price)\" /></row><row><data content=\"4.16666666666667\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>SELECT AVG(price)</code>.</p></body></html>"
          },
          {
            "title": "Question: Aliasing",
            "id": 96944,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Nama kolom apa yang akan kita lihat di tabel hasil?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE coffee (&#xA; type varchar(255),&#xA; price numeric(3,2)&#xA;);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('espresso', 3);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('macchiato', 5);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('americano', 4.5);&#xA;&#xA;\"><tables><table name=\"coffee\"><row><header content=\"type\" /><header content=\"price\" /></row><row><data content=\"espresso\" /><data content=\"3\" /></row><row><data content=\"macchiato\" /><data content=\"5\" /></row><row><data content=\"americano\" /><data content=\"4.5\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"MIN\" class=\"keyword\" /><text value=\"(price) \" /><text value=\"AS\" class=\"keyword\" /><text value=\" cheapest\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" coffee;\" /></content><output><table name=\"Result\"><row><header content=\"cheapest\" /></row><row><data content=\"3\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>cheapest</code></item><item value=\"2\" correct=\"false\"><code>price</code></item><item value=\"3\" correct=\"false\"><code>3</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>cheapest</code>.</p></body></html>"
          },
          {
            "title": "Example: Aliasing",
            "id": 96947,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Gunakan <code>AS</code> untuk memilih nilai rata-rata <code>price</code> dengan alias <code>average_price</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE coffee (&#xA; type varchar(255),&#xA; price numeric(3,2)&#xA;);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('espresso', 3);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('macchiato', 5);&#xA;&#xA;INSERT INTO coffee (type, price)&#xA;VALUES ('americano', 4.5);&#xA;&#xA;\"><tables><table name=\"coffee\"><row><header content=\"type\" /><header content=\"price\" /></row><row><data content=\"espresso\" /><data content=\"3\" /></row><row><data content=\"macchiato\" /><data content=\"5\" /></row><row><data content=\"americano\" /><data content=\"4.5\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"AVG\" class=\"keyword\" /><text value=\"(price) \" /><text value=\"AS\" class=\"keyword\" /><text value=\" average_price\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" coffee;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"7\" endIndex=\"34\" /></interactions><output><table name=\"Result\"><row><header content=\"average_price\" /></row><row><data content=\"4.16666666666667\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>AVG(price) AS average_price</code>.</p></body></html>"
          },
          {
            "title": "Question: COUNT (*)",
            "id": 97079,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa hasil dari query ini?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE project_time (&#xA; employee varchar(255),&#xA; hours int&#xA;);&#xA;&#xA;INSERT INTO project_time(employee, hours)&#xA;VALUES ('Mike', 8);&#xA;&#xA;INSERT INTO project_time(employee, hours)&#xA;VALUES ('Mona', 20);&#xA;&#xA;INSERT INTO project_time(employee, hours)&#xA;VALUES ('Mary', 12);&#xA;\"><tables><table name=\"project_time\"><row><header content=\"employee\" /><header content=\"hours\" /></row><row><data content=\"Mike\" /><data content=\"8\" /></row><row><data content=\"Mona\" /><data content=\"20\" /></row><row><data content=\"Mary\" /><data content=\"12\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"COUNT\" class=\"keyword\" /><text value=\"(*)\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" project_time;\" /></content><output><table name=\"Result\"><row><header content=\"COUNT(*)\" /></row><row><data content=\"3\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>3</code> karena kita memiliki tiga baris</item><item value=\"2\" correct=\"false\"><code>6</code> karena kita memiliki dua kolom dengan masing-masing tiga baris</item><item value=\"3\" correct=\"false\"><code>2</code> karena kita memiliki dua kolom</item></selection><p visible-if=\"wrong\"><code>3</code> karena kita memiliki tiga baris.</p></body></html>"
          },
          {
            "title": "Example: SUM()",
            "id": 97086,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jumlahkan <code>hours</code> proyek.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE project_time (&#xA; employee varchar(255),&#xA; hours int&#xA;);&#xA;&#xA;INSERT INTO project_time(employee, hours)&#xA;VALUES ('Mike', 8);&#xA;&#xA;INSERT INTO project_time(employee, hours)&#xA;VALUES ('Mona', 20);&#xA;&#xA;INSERT INTO project_time(employee, hours)&#xA;VALUES ('Mary', 12);&#xA;\"><tables><table name=\"project_time\"><row><header content=\"employee\" /><header content=\"hours\" /></row><row><data content=\"Mike\" /><data content=\"8\" /></row><row><data content=\"Mona\" /><data content=\"20\" /></row><row><data content=\"Mary\" /><data content=\"12\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"SUM\" class=\"keyword\" /><text value=\"(\" /><text value=\"hours\" class=\"keyword\" /><text value=\")\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" project_time;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"7\" endIndex=\"17\" /></interactions><output><table name=\"Result\"><row><header content=\"SUM(hours)\" /></row><row><data content=\"40\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>SUM(hours)</code>.</p></body></html>"
          },
          {
            "title": "Question: Count DISTINCT",
            "id": 97082,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa hasil dari query ini?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE project_time (&#xA; employee varchar(255),&#xA; hours int&#xA;);&#xA;&#xA;INSERT INTO project_time(employee, hours)&#xA;VALUES ('Mona', 8);&#xA;&#xA;INSERT INTO project_time(employee, hours)&#xA;VALUES ('Mona', 20);&#xA;&#xA;INSERT INTO project_time(employee, hours)&#xA;VALUES ('Mary', 12);&#xA;\"><tables><table name=\"project_time\"><row><header content=\"employee\" /><header content=\"hours\" /></row><row><data content=\"Mona\" /><data content=\"8\" /></row><row><data content=\"Mona\" /><data content=\"20\" /></row><row><data content=\"Mary\" /><data content=\"12\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"COUNT\" class=\"keyword\" /><text value=\"(\" /><text value=\"DISTINCT\" class=\"keyword\" /><text value=\" employee)\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" project_time;\" /></content><output><table name=\"Result\"><row><header content=\"COUNT(DISTINCT employee)\" /></row><row><data content=\"2\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>2</code> karena kita tidak menghitung duplikat <code>'Mona'</code></item><item value=\"2\" correct=\"false\"><code>3</code> karena kita memiliki tiga baris</item><item value=\"3\" correct=\"false\"><code>2</code> karena kita tidak menghitung <code>'Mary'</code></item></selection><p visible-if=\"wrong\"><code>2</code> karena kita tidak menghitung duplikat <code>'Mona'</code>.</p></body></html>"
          },
          {
            "title": "Example: Count by column 2",
            "id": 97083,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Hitung nilai dalam kolom <code>employee</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE project_time (&#xA; employee varchar(255),&#xA; hours int&#xA;);&#xA;&#xA;INSERT INTO project_time(employee, hours)&#xA;VALUES ('Mike', 8);&#xA;&#xA;INSERT INTO project_time(employee, hours)&#xA;VALUES (NULL, 20);&#xA;&#xA;INSERT INTO project_time(employee, hours)&#xA;VALUES ('Mary', 12);&#xA;\"><tables><table name=\"project_time\"><row><header content=\"employee\" /><header content=\"hours\" /></row><row><data content=\"Mike\" /><data content=\"8\" /></row><row><data content=\"\" /><data content=\"20\" /></row><row><data content=\"Mary\" /><data content=\"12\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"COUNT\" class=\"keyword\" /><text value=\"(employee) \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" project_time;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"7\" endIndex=\"12\" /><option startIndex=\"12\" endIndex=\"13\" /><option startIndex=\"13\" endIndex=\"21\" /><option startIndex=\"21\" endIndex=\"22\" /><option correct=\"false\"><content><text value=\".\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"COUNT(employee)\" /></row><row><data content=\"2\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>COUNT</code>, diikuti oleh <code>(</code>, lalu <code>employee</code>, <code>)</code>.</p></body></html>"
          },
          {
            "title": "Example: Aliasing",
            "id": 97087,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jumlahkan <code>hours</code> project, lalu beri kolom hasilnya alias <code>duration</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE project_time (&#xA; employee varchar(255),&#xA; hours int&#xA;);&#xA;&#xA;INSERT INTO project_time(employee, hours)&#xA;VALUES ('Mike', 8);&#xA;&#xA;INSERT INTO project_time(employee, hours)&#xA;VALUES ('Mona', 20);&#xA;&#xA;INSERT INTO project_time(employee, hours)&#xA;VALUES ('Mary', 12);&#xA;\"><tables><table name=\"project_time\"><row><header content=\"employee\" /><header content=\"hours\" /></row><row><data content=\"Mike\" /><data content=\"8\" /></row><row><data content=\"Mona\" /><data content=\"20\" /></row><row><data content=\"Mary\" /><data content=\"12\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"SUM\" class=\"keyword\" /><text value=\"(\" /><text value=\"hours\" class=\"keyword\" /><text value=\") \" /><text value=\"AS\" class=\"keyword\" /><text value=\" \" /><text value=\"duration\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" project_time;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"7\" endIndex=\"29\" /></interactions><output><table name=\"Result\"><row><header content=\"duration\" /></row><row><data content=\"40\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>SUM(hours) AS duration</code>.</p></body></html>"
          },
          {
            "title": "Question: Query explanation",
            "id": 100541,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang dilakukan query ini?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE wishlist (&#xA; item varchar(255),&#xA; price numeric(2,1),&#xA; category varchar(255)&#xA;);&#xA;&#xA;INSERT INTO wishlist (item, price, category)&#xA;VALUES ('headphones', 250, 'electronics');&#xA;&#xA;INSERT INTO wishlist (item, price, category)&#xA;VALUES ('pencils', 37, 'stationery');&#xA;&#xA;INSERT INTO wishlist (item, price, category)&#xA;VALUES ('phone charger', 110, 'electronics');&#xA;&#xA;INSERT INTO wishlist (item, price, category)&#xA;VALUES ('daily planner', 29, 'stationery');&#xA;&#xA;\"><tables><table name=\"wishlist\"><row><header content=\"item\" /><header content=\"price\" /><header content=\"category\" /></row><row><data content=\"headphones\" /><data content=\"250\" /><data content=\"electronics\" /></row><row><data content=\"pencils\" /><data content=\"37\" /><data content=\"stationery\" /></row><row><data content=\"phone charger\" /><data content=\"110\" /><data content=\"electronics\" /></row><row><data content=\"daily planner\" /><data content=\"29\" /><data content=\"stationery\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"category\" class=\"keyword\" /><text value=\", \" /><text value=\"SUM\" class=\"keyword\" /><text value=\"(price)\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" wishlist\" /><text type=\"break\" /><text value=\"GROUP\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" \" /><text value=\"category\" class=\"keyword\" /><text value=\";\" /></content><output><table name=\"Result\"><row><header content=\"category\" /><header content=\"SUM(price)\" /></row><row><data content=\"electronics\" /><data content=\"360\" /></row><row><data content=\"stationery\" /><data content=\"66\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Mengelompokkan item <code>wishlist</code> berdasarkan <code>category</code> dan menjumlahkan harga di setiap kategori</item><item value=\"2\" correct=\"false\">Ini mengelompokkan item <code>wishlist</code> berdasarkan <code>price</code></item><item value=\"3\" correct=\"false\">Menjumlahkan semua nilai <code>price</code> menjadi satu hasil</item></selection><p visible-if=\"wrong\">Mengelompokkan item <code>wishlist</code> berdasarkan <code>category</code> dan menjumlahkan harga di setiap kategori.</p></body></html>"
          },
          {
            "title": "Question: Grouping the count results",
            "id": 100540,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Berapa banyak grup yang akan kita dapatkan dalam hasilnya?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE wishlist (&#xA; item varchar(255),&#xA; price numeric(2,1),&#xA; category varchar(255)&#xA;);&#xA;&#xA;INSERT INTO wishlist (item, price, category)&#xA;VALUES ('headphones', 250, 'electronics');&#xA;&#xA;INSERT INTO wishlist (item, price, category)&#xA;VALUES ('pencils', 37, 'stationery');&#xA;&#xA;INSERT INTO wishlist (item, price, category)&#xA;VALUES ('phone charger', 110, 'electronics');&#xA;&#xA;INSERT INTO wishlist (item, price, category)&#xA;VALUES ('daily planner', 29, 'stationery');&#xA;&#xA;\"><tables><table name=\"wishlist\"><row><header content=\"item\" /><header content=\"price\" /><header content=\"category\" /></row><row><data content=\"headphones\" /><data content=\"250\" /><data content=\"electronics\" /></row><row><data content=\"pencils\" /><data content=\"37\" /><data content=\"stationery\" /></row><row><data content=\"phone charger\" /><data content=\"110\" /><data content=\"electronics\" /></row><row><data content=\"daily planner\" /><data content=\"29\" /><data content=\"stationery\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"category\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" wishlist\" /><text type=\"break\" /><text value=\"GROUP\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" \" /><text value=\"category\" class=\"keyword\" /><text value=\";\" /></content><output><table name=\"Result\"><row><header content=\"category\" /></row><row><data content=\"electronics\" /></row><row><data content=\"stationery\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Dua, <code>electronics</code> dan <code>stationery</code></item><item value=\"2\" correct=\"false\">Tidak ada</item><item value=\"3\" correct=\"false\">Empat, <code>electronics</code> dua kali, dan <code>stationery</code> dua kali</item></selection><p visible-if=\"wrong\">Dua, <code>electronics</code> dan <code>stationery</code>.</p></body></html>"
          },
          {
            "title": "Example: Aliasing COUNT",
            "id": 100545,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Gunakan alias untuk mengganti nama <code>COUNT(*)</code> menjadi <code>items</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE wishlist (&#xA; item varchar(255),&#xA; price numeric(2,1),&#xA; category varchar(255)&#xA;);&#xA;&#xA;INSERT INTO wishlist (item, price, category)&#xA;VALUES ('headphones', 250, 'electronics');&#xA;&#xA;INSERT INTO wishlist (item, price, category)&#xA;VALUES ('pencils', 37, 'stationery');&#xA;&#xA;INSERT INTO wishlist (item, price, category)&#xA;VALUES ('phone charger', 110, 'electronics');&#xA;&#xA;INSERT INTO wishlist (item, price, category)&#xA;VALUES ('daily planner', 29, 'stationery');&#xA;&#xA;\"><tables><table name=\"wishlist\"><row><header content=\"item\" /><header content=\"price\" /><header content=\"category\" /></row><row><data content=\"headphones\" /><data content=\"250\" /><data content=\"electronics\" /></row><row><data content=\"pencils\" /><data content=\"37\" /><data content=\"stationery\" /></row><row><data content=\"phone charger\" /><data content=\"110\" /><data content=\"electronics\" /></row><row><data content=\"daily planner\" /><data content=\"29\" /><data content=\"stationery\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"category\" class=\"keyword\" /><text value=\", \" /><text value=\"COUNT\" class=\"keyword\" /><text value=\"(*) \" /><text value=\"AS\" class=\"keyword\" /><text value=\" items\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" wishlist\" /><text type=\"break\" /><text value=\"GROUP\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" \" /><text value=\"category\" class=\"keyword\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"26\" endIndex=\"34\" /></interactions><output><table name=\"Result\"><row><header content=\"category\" /><header content=\"items\" /></row><row><data content=\"electronics\" /><data content=\"2\" /></row><row><data content=\"stationery\" /><data content=\"2\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>AS items</code>.</p></body></html>"
          },
          {
            "title": "Question: What to filter by",
            "id": 100548,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kolom mana yang bisa kita gunakan untuk memfilter grup dalam kueri ini?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"category\" class=\"keyword\" /><text value=\", \" /><text value=\"COUNT\" class=\"keyword\" /><text value=\"(*)\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" wishlist\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"category\" class=\"keyword\" /><text value=\" \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'s%'\" class=\"string\" /><text type=\"break\" /><text value=\"GROUP\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" \" /><text value=\"category\" class=\"keyword\" /><text value=\";\" /></content><output><table name=\"Result\"><row><data content=\"No result!\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>category</code> atau <code>COUNT(*)</code></item><item value=\"2\" correct=\"false\">Hanya <code>COUNT(*)</code></item><item value=\"3\" correct=\"false\">Hanya <code>category</code></item></selection><p visible-if=\"wrong\"><code>category</code> atau <code>COUNT(*)</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Klausa <code>HAVING</code> akan memfilter grup yang dihasilkan query ini. Pasangan mana yang berisi dua kondisi yang valid?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"category\" class=\"keyword\" /><text value=\", \" /><text value=\"COUNT\" class=\"keyword\" /><text value=\"(*)\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" wishlist\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"category\" class=\"keyword\" /><text value=\" \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'s%'\" class=\"string\" /><text type=\"break\" /><text value=\"GROUP\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" \" /><text value=\"category\" class=\"keyword\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>category LIKE 's%'</code> atau <code>COUNT(*) &gt; 2</code></item><item value=\"2\" correct=\"false\">Hanya <code>COUNT(*) &gt; 2</code>, karena <code>HAVING</code> hanya menerima agregat</item><item value=\"3\" correct=\"false\">Hanya <code>category LIKE 's%'</code>, karena hasil agregat tidak dapat difilter</item><item value=\"4\" correct=\"false\"><code>wishlist</code> atau <code>category</code>, karena keduanya muncul sebelum <code>GROUP BY</code></item></selection><p visible-if=\"wrong\"><code>category LIKE 's%'</code> atau <code>COUNT(*) &gt; 2</code>.</p></body></html>"
