            "id": 85832,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tampilkan kedua pesan di console.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"isLying\" class=\"title\" /><text value=\"(\" /><text value=\"boolean\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"if\" class=\"keyword\" /><text value=\" (boolean === \" /><text value=\"true\" class=\"literal\" /><text value=\") {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;He's not lying&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Done&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"isLying(\" /><text value=\"true\" class=\"literal\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"122\" endIndex=\"126\" /><option correct=\"false\"><content><text value=\"false\" /></content></option></options></interaction></interactions><output><content><text value=\"He's not lying\" /><text type=\"break\" /><text value=\"Done\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>true</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Uji apakah parameter Boolean sama dengan <code>true</code> tanpa mengubahnya.</p><p>Panggil fungsi agar menampilkan <code>He's not lying</code> sebelum <code>Done</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"isLying\" class=\"title\" /><text value=\"(\" /><text value=\"boolean\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"if\" class=\"keyword\" /><text value=\" (boolean === \" /><text value=\"true\" class=\"literal\" /><text value=\") {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;He's not lying&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Done&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"isLying(\" /><text value=\"true\" class=\"literal\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"33\" endIndex=\"40\" /><option startIndex=\"41\" endIndex=\"44\" /><option startIndex=\"122\" endIndex=\"126\" /><option startIndex=\"55\" endIndex=\"85\" /><option correct=\"false\"><content><text value=\"false\" /></content></option><option correct=\"false\"><content><text value=\"=\" /></content></option><option correct=\"false\"><content><text value=\"console.log(&quot;Done&quot;);\" /></content></option><option correct=\"false\"><content><text value=\"&quot;true&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"He's not lying\" /><text type=\"break\" /><text value=\"Done\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>boolean</code>, diikuti oleh <code>===</code>, <code>console.log(\"He's not lying\");</code>, dan terakhir <code>true</code>.</p></body></html>",
            "hardModeSelected": true
