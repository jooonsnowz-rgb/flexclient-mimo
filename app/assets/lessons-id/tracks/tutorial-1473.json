            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Ganti item terakhir dalam daftar dengan <code>Paul</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"users = [\" /><text value=\"&quot;Peter&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Zaneta&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Irina&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text value=\"users[\" /><text value=\"-1\" class=\"number\" /><text value=\"] = \" /><text value=\"&quot;Paul&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"print(users)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"42\" endIndex=\"43\" /><option correct=\"false\"><content><text value=\"3\" /></content></option><option startIndex=\"43\" endIndex=\"44\" /><option startIndex=\"44\" endIndex=\"45\" /><option startIndex=\"45\" endIndex=\"46\" /></options></interaction></interactions><output><content><text value=\"['Peter', 'Zaneta', 'Paul']\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>[</code>, diikuti oleh <code>-</code>, lalu <code>1</code>, <code>]</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Ganti item <strong>terakhir</strong> dalam list dengan <code>\"Paul\"</code> menggunakan indeks negatif.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"users = [\" /><text value=\"&quot;Peter&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Zaneta&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Irina&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text value=\"users[\" /><text value=\"-1\" class=\"number\" /><text value=\"] = \" /><text value=\"&quot;Paul&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"print(users)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"42\" endIndex=\"43\" /><option startIndex=\"43\" endIndex=\"44\" /><option startIndex=\"44\" endIndex=\"45\" /><option startIndex=\"45\" endIndex=\"46\" /><option correct=\"false\"><content><text value=\"3\" /></content></option></options></interaction></interactions><output><content><text value=\"['Peter', 'Zaneta', 'Paul']\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>[</code>, diikuti oleh <code>-</code>, <code>1</code>, dan terakhir <code>]</code>.</p></body></html>"
