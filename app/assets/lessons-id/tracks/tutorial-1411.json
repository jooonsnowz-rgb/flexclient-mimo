          {
            "title": "Within a range",
            "id": 91465,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kita dapat menggunakan kondisi untuk memilih item yang memiliki properti dalam suatu rentang, seperti film dengan <code>rating</code> antara <code>9</code> dan <code>10</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE movies (&#xA;title varchar(255),&#xA;rating numeric (1,1)&#xA;);&#xA;&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Godfather', 9.2);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Matrix', 8.7);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('La Strada', 8);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Dark Knight', 9);\"><tables><table name=\"movies\"><row><header content=\"title\" /><header content=\"rating\" /></row><row><data content=\"The Godfather\" /><data content=\"9.2\" /></row><row><data content=\"The Matrix\" /><data content=\"8.7\" /></row><row><data content=\"La Strada\" /><data content=\"8\" /></row><row><data content=\"The Dark Knight\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" movies\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" rating \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"9\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"10\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"21\" endIndex=\"50\" /><option correct=\"false\"><content><text value=\"WHERE rating BETWEEN 10 AND 20\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"title\" /><header content=\"rating\" /></row><row><data content=\"The Godfather\" /><data content=\"9.2\" /></row><row><data content=\"The Dark Knight\" /><data content=\"9\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>WHERE rating BETWEEN 9 AND 10</code>.</p></body></html>"
          },
          {
            "title": "Condition",
            "id": 91467,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Saat menulis kondisi, kita mulai dengan kolom yang nilainya sedang kita periksa, seperti <code>rating</code> di sini.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE movies (&#xA;title varchar(255),&#xA;rating numeric (1,1)&#xA;);&#xA;&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Godfather', 9.2);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Matrix', 8.7);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('La Strada', 8);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Dark Knight', 9);\"><tables><table name=\"movies\"><row><header content=\"title\" /><header content=\"rating\" /></row><row><data content=\"The Godfather\" /><data content=\"9.2\" /></row><row><data content=\"The Matrix\" /><data content=\"8.7\" /></row><row><data content=\"La Strada\" /><data content=\"8\" /></row><row><data content=\"The Dark Knight\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" movies\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" rating \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"9\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"10\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"27\" endIndex=\"33\" /></interactions><output><table name=\"Result\"><row><header content=\"title\" /><header content=\"rating\" /></row><row><data content=\"The Godfather\" /><data content=\"9.2\" /></row><row><data content=\"The Dark Knight\" /><data content=\"9\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>rating</code>.</p></body></html>"
          },
          {
            "title": "The keyword BETWEEN",
            "id": 91469,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Untuk memeriksa apakah suatu nilai berada dalam suatu rentang, kita menggunakan keyword <code>BETWEEN</code> diikuti oleh rentang nilai.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE movies (&#xA;title varchar(255),&#xA;rating numeric (1,1)&#xA;);&#xA;&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Godfather', 9.2);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Matrix', 8.7);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('La Strada', 8);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Dark Knight', 9);\"><tables><table name=\"movies\"><row><header content=\"title\" /><header content=\"rating\" /></row><row><data content=\"The Godfather\" /><data content=\"9.2\" /></row><row><data content=\"The Matrix\" /><data content=\"8.7\" /></row><row><data content=\"La Strada\" /><data content=\"8\" /></row><row><data content=\"The Dark Knight\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" movies\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" rating \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"9\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"10\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"34\" endIndex=\"41\" /><option startIndex=\"42\" endIndex=\"50\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"title\" /><header content=\"rating\" /></row><row><data content=\"The Godfather\" /><data content=\"9.2\" /></row><row><data content=\"The Dark Knight\" /><data content=\"9\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>BETWEEN</code>, diikuti oleh <code>9 AND 10</code>.</p></body></html>"
          },
          {
            "title": "Defining a range",
            "id": 91470,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kita menetapkan awal rentang, seperti <code>9</code>, dan akhir rentang, seperti <code>10</code>, yang dipisahkan oleh kata kunci <code>AND</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE movies (&#xA;title varchar(255),&#xA;rating numeric (1,1)&#xA;);&#xA;&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Godfather', 9.2);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Matrix', 8.7);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('La Strada', 8);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Dark Knight', 9);\"><tables><table name=\"movies\"><row><header content=\"title\" /><header content=\"rating\" /></row><row><data content=\"The Godfather\" /><data content=\"9.2\" /></row><row><data content=\"The Matrix\" /><data content=\"8.7\" /></row><row><data content=\"La Strada\" /><data content=\"8\" /></row><row><data content=\"The Dark Knight\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" movies\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" rating \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"9\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"10\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"42\" endIndex=\"43\" /><option startIndex=\"44\" endIndex=\"47\" /><option startIndex=\"48\" endIndex=\"50\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"title\" /><header content=\"rating\" /></row><row><data content=\"The Godfather\" /><data content=\"9.2\" /></row><row><data content=\"The Dark Knight\" /><data content=\"9\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>9</code>, diikuti oleh <code>AND</code>, dan terakhir <code>10</code>.</p></body></html>"
          },
          {
            "title": "Border inclusive",
            "id": 91471,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Rentang mencakup batas-batasnya. Dengan rentang seperti <code>BETWEEN 8 AND 9</code>, kita memilih film dengan rating 8 dan 9, serta semua nilai di antaranya.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE movies (&#xA;title varchar(255),&#xA;rating numeric (1,1)&#xA;);&#xA;&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Godfather', 9.2);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Matrix', 8.7);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('La Strada', 8);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Dark Knight', 9);\"><tables><table name=\"movies\"><row><header content=\"title\" /><header content=\"rating\" /></row><row><data content=\"The Godfather\" /><data content=\"9.2\" /></row><row><data content=\"The Matrix\" /><data content=\"8.7\" /></row><row><data content=\"La Strada\" /><data content=\"8\" /></row><row><data content=\"The Dark Knight\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" movies\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" rating \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"8\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"9\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"34\" endIndex=\"41\" /><option startIndex=\"42\" endIndex=\"43\" /><option startIndex=\"44\" endIndex=\"47\" /><option startIndex=\"48\" endIndex=\"49\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"title\" /><header content=\"rating\" /></row><row><data content=\"The Matrix\" /><data content=\"8.7\" /></row><row><data content=\"La Strada\" /><data content=\"8\" /></row><row><data content=\"The Dark Knight\" /><data content=\"9\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>BETWEEN</code>, diikuti oleh <code>8</code>, lalu <code>AND</code>, <code>9</code>.</p></body></html>"
          },
          {
            "title": "Question: Within a range",
            "id": 93205,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kondisi mana yang memeriksa apakah properti <code>age</code> berada di antara dua angka, seperti <code>10</code> dan <code>20</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>age BETWEEN 10 AND 20</code></item><item value=\"2\" correct=\"false\"><code>age &lt;= 20</code></item></selection><p visible-if=\"wrong\"><code>age BETWEEN 10 AND 20</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Gunakan <code>column BETWEEN lower AND upper</code> untuk memeriksa rentang. Rentang mencakup kedua batas.</p><p>Kamu memerlukan pasien berusia minimal <code>10</code> dan maksimal <code>20</code>. Kondisi mana yang berfungsi?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>age BETWEEN 10 AND 20</code></item><item value=\"2\" correct=\"false\"><code>age &lt;= 20</code></item><item value=\"3\" correct=\"false\"><code>age BETWEEN 20 AND 10</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>age BETWEEN 10 AND 20</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
