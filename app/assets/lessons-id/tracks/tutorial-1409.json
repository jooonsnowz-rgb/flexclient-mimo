          {
            "title": "Doesn't satisfy a condition",
            "id": 91448,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Terkadang kita ingin memilih data yang <em>tidak</em> memenuhi suatu kondisi, seperti semua mahasiswa yang <em>bukan</em> mahasiswa tahun pertama.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA;name varchar(255),&#xA;year int,&#xA;major varchar(255)&#xA;);&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Ava Smith', 1, 'Biology');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Luis Garcia', 1, 'Physics');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Lin Wong', 3, 'Biology');\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" &lt;&gt; \" /><text value=\"1\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"29\" endIndex=\"38\" /><option startIndex=\"23\" endIndex=\"28\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>WHERE</code>, diikuti oleh <code>year &lt;&gt; 1</code>.</p></body></html>"
          },
          {
            "title": "All years",
            "id": 91450,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Seperti sebelumnya, kita mulai dengan memilih semua item menggunakan <code>*</code>. Ini akan memberi kita siswa dari semua tahun.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA;name varchar(255),&#xA;year int,&#xA;major varchar(255)&#xA;);&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Ava Smith', 1, 'Biology');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Luis Garcia', 1, 'Physics');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Lin Wong', 3, 'Biology');\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"7\" endIndex=\"8\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>*</code>.</p></body></html>"
          },
          {
            "title": "The inequality operator",
            "id": 91451,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Untuk memeriksa apakah nilai dalam sebuah kolom <em>tidak</em> sama dengan nilai lainnya, kita menggunakan operator ketidaksamaan <code>&lt;&gt;</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA;name varchar(255),&#xA;year int,&#xA;major varchar(255)&#xA;);&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Ava Smith', 1, 'Biology');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Luis Garcia', 1, 'Physics');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Lin Wong', 3, 'Biology');\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" &lt;&gt; \" /><text value=\"1\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"34\" endIndex=\"35\" /><option startIndex=\"35\" endIndex=\"36\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>&lt;</code>, diikuti oleh <code>&gt;</code>.</p></body></html>"
          },
          {
            "title": "The inequality operator 2",
            "id": 91452,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Karena <code>year &lt;&gt; 1</code> menyaring item siswa dengan <code>1</code> di kolom <code>year</code>, kita hanya mendapatkan seorang siswa di tahun ketiganya.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA;name varchar(255),&#xA;year int,&#xA;major varchar(255)&#xA;);&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Ava Smith', 1, 'Biology');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Luis Garcia', 1, 'Physics');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Lin Wong', 3, 'Biology');\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" &lt;&gt; \" /><text value=\"1\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"29\" endIndex=\"38\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>year &lt;&gt; 1</code>.</p></body></html>"
          },
          {
            "title": "Inequality with text values",
            "id": 91453,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kita juga bisa menggunakan operator ketidaksamaan dengan nilai teks, seperti mendapatkan semua mahasiswa yang tidak mengambil jurusan <code>'Biology'</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA;name varchar(255),&#xA;year int,&#xA;major varchar(255)&#xA;);&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Ava Smith', 1, 'Biology');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Luis Garcia', 1, 'Physics');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Lin Wong', 3, 'Biology');\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" major &lt;&gt; \" /><text value=\"'Biology'\" class=\"string\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"38\" endIndex=\"47\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>'Biology'</code>.</p></body></html>"
          },
          {
            "title": "Question: Doesn't satisfy a condition",
            "id": 91744,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kapan tanda pertidaksamaan berguna?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Saat kita ingin mendapatkan semua item yang tidak memenuhi suatu kriteria</item><item value=\"2\" correct=\"false\">Saat kita ingin mendapatkan semua item yang memenuhi suatu kriteria</item></selection><p visible-if=\"wrong\">Saat kita ingin mendapatkan semua item yang tidak memenuhi suatu kriteria.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Daftar perusahaan harus mengecualikan setiap perusahaan yang telah aktif tepat selama tiga tahun. Perbandingan mana yang sesuai dalam filter?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Gunakan pertidaksamaan untuk mempertahankan nilai yang bukan 3.</item><item value=\"2\" correct=\"false\">Gunakan persamaan untuk hanya mempertahankan nilai 3.</item><item value=\"3\" correct=\"false\">Gunakan pertidaksamaan untuk mempertahankan nilai yang lebih besar dari 3.</item></selection><p visible-if=\"wrong\">Gunakan pertidaksamaan untuk mempertahankan nilai yang bukan 3.</p></body></html>"
          },
          {
            "title": "Question: All years",
            "id": 91745,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang salah dengan query ini?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"FROM companies\" /><text type=\"break\" /><text value=\"WHERE years_active &lt;&gt; 3;\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Seharusnya pertama-tama memilih item sebelum memfilternya</item><item value=\"2\" correct=\"false\">Tidak ada yang salah dengan query tersebut</item></selection><p visible-if=\"wrong\">Seharusnya pertama-tama memilih item sebelum memfilternya.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Query memfilter perusahaan yang masa aktifnya bukan 3 tahun. Apa yang harus berada sebelum <code>FROM</code> agar query tersebut lengkap?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"FROM companies\" /><text type=\"break\" /><text value=\"WHERE years_active &lt;&gt; 3;\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Klausa SELECT yang memilih hal yang akan dikembalikan.</item><item value=\"2\" correct=\"false\">Klausa ORDER BY yang mengurutkan baris.</item><item value=\"3\" correct=\"false\">Klausa VALUES yang membuat baris baru.</item></selection><p visible-if=\"wrong\">Klausa SELECT yang memilih hal yang akan dikembalikan.</p></body></html>"
          },
          {
            "title": "Question: The inequality operator",
            "id": 91746,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Operator mana yang kita gunakan untuk memeriksa apakah dua nilai <em>tidak</em> sama?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>&lt;&gt;</code></item><item value=\"2\" correct=\"false\"><code>=</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>&lt;&gt;</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Operator pertidaksamaan memeriksa apakah dua nilai tidak sama.</p><p>Kamu memerlukan baris dengan nilai <code>years_active</code> apa pun kecuali <code>3</code>. Operator mana yang menyatakan kondisi tersebut?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>&lt;&gt;</code></item><item value=\"2\" correct=\"false\"><code>=</code></item><item value=\"3\" correct=\"false\"><code>&gt;</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>&lt;&gt;</code>.</p></body></html>"
          },
          {
            "title": "Question: The inequality operator 2",
            "id": 91747,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Item mana yang akan hilang dari tabel hasil?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE companies (&#xA;name varchar(255),&#xA;years_active int&#xA;);&#xA;&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Rocket Delivery', 3);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Teachya', 1);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Hyped', 8);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Thread Co.', 1);\"><tables><table name=\"companies\"><row><header content=\"name\" /><header content=\"years_active\" /></row><row><data content=\"Rocket Delivery\" /><data content=\"3\" /></row><row><data content=\"Teachya\" /><data content=\"1\" /></row><row><data content=\"Hyped\" /><data content=\"8\" /></row><row><data content=\"Thread Co.\" /><data content=\"1\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" companies\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" years_active &lt;&gt; \" /><text value=\"8\" class=\"number\" /><text value=\";\" /></content><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"years_active\" /></row><row><data content=\"Rocket Delivery\" /><data content=\"3\" /></row><row><data content=\"Teachya\" /><data content=\"1\" /></row><row><data content=\"Thread Co.\" /><data content=\"1\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>Hyped</code>, <code>8</code></item><item value=\"2\" correct=\"false\"><code>Rocket Delivery</code>, <code>3</code></item></selection><p visible-if=\"wrong\"><code>Hyped</code>, <code>8</code>.</p></body></html>"
          },
          {
            "title": "Question: Inequality with text values",
            "id": 91748,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jenis nilai apa yang bisa kita gunakan dengan operator ketidaksamaan <code>&lt;&gt;</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Jenis apa pun, seperti teks dan angka</item><item value=\"2\" correct=\"false\">Hanya angka</item></selection><p visible-if=\"wrong\">Jenis apa pun, seperti teks dan angka.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Operator pertidaksamaan <code>&lt;&gt;</code> dapat digunakan dengan nilai seperti teks dan angka.</p><p>Filter mana yang dapat menggunakan <code>&lt;&gt;</code> untuk mengecualikan satu nilai tertentu?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Kecualikan nilai teks <code>'closed'</code> dari kolom status.</item><item value=\"2\" correct=\"false\">Ubah kolom angka menjadi teks.</item><item value=\"3\" correct=\"false\">Jumlahkan dua nilai numerik.</item></selection><p visible-if=\"wrong\">Kecualikan nilai teks <code>'closed'</code> dari kolom status.</p></body></html>"
          },
          {
            "title": "Example: Doesn't satisfy a condition",
            "id": 91749,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Buat kode kondisi untuk memilih semua item <code>companies</code> dengan <code>years_active</code> yang tidak sama dengan <code>3</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE companies (&#xA;name varchar(255),&#xA;years_active int&#xA;);&#xA;&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Rocket Delivery', 3);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Teachya', 1);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Hyped', 8);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Thread Co.', 1);\"><tables><table name=\"companies\"><row><header content=\"name\" /><header content=\"years_active\" /></row><row><data content=\"Rocket Delivery\" /><data content=\"3\" /></row><row><data content=\"Teachya\" /><data content=\"1\" /></row><row><data content=\"Hyped\" /><data content=\"8\" /></row><row><data content=\"Thread Co.\" /><data content=\"1\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" companies\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" years_active &lt;&gt; \" /><text value=\"3\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"24\" endIndex=\"29\" /><option correct=\"false\"><content><text value=\"years_active = 3\" /></content></option><option startIndex=\"30\" endIndex=\"47\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"years_active\" /></row><row><data content=\"Teachya\" /><data content=\"1\" /></row><row><data content=\"Hyped\" /><data content=\"8\" /></row><row><data content=\"Thread Co.\" /><data content=\"1\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>WHERE</code>, diikuti oleh <code>years_active &lt;&gt; 3</code>.</p></body></html>"
          },
          {
            "title": "Example: The inequality operator",
            "id": 91751,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pilih semua item dari tabel <code>companies</code>, sebelum memfilternya.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE companies (&#xA;name varchar(255),&#xA;years_active int&#xA;);&#xA;&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Rocket Delivery', 3);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Teachya', 1);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Hyped', 8);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Thread Co.', 1);\"><tables><table name=\"companies\"><row><header content=\"name\" /><header content=\"years_active\" /></row><row><data content=\"Rocket Delivery\" /><data content=\"3\" /></row><row><data content=\"Teachya\" /><data content=\"1\" /></row><row><data content=\"Hyped\" /><data content=\"8\" /></row><row><data content=\"Thread Co.\" /><data content=\"1\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" companies;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"8\" /><option startIndex=\"9\" endIndex=\"13\" /><option startIndex=\"14\" endIndex=\"23\" /><option correct=\"false\"><content><text value=\"name\" /></content></option><option startIndex=\"23\" endIndex=\"24\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"years_active\" /></row><row><data content=\"Rocket Delivery\" /><data content=\"3\" /></row><row><data content=\"Teachya\" /><data content=\"1\" /></row><row><data content=\"Hyped\" /><data content=\"8\" /></row><row><data content=\"Thread Co.\" /><data content=\"1\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>SELECT</code>, diikuti oleh <code>*</code>, lalu <code>FROM</code>, <code>companies</code>, <code>;</code>.</p></body></html>"
          },
          {
            "title": "Example: The inequality operator 2",
            "id": 91752,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tuliskan <code>years_active</code>, operator pertidaksamaan <code>&lt;&gt;</code>, dan <code>1</code> untuk memfilter perusahaan yang belum aktif selama satu tahun.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE companies (&#xA;name varchar(255),&#xA;years_active int&#xA;);&#xA;&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Rocket Delivery', 3);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Teachya', 1);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Hyped', 8);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Thread Co.', 1);\"><tables><table name=\"companies\"><row><header content=\"name\" /><header content=\"years_active\" /></row><row><data content=\"Rocket Delivery\" /><data content=\"3\" /></row><row><data content=\"Teachya\" /><data content=\"1\" /></row><row><data content=\"Hyped\" /><data content=\"8\" /></row><row><data content=\"Thread Co.\" /><data content=\"1\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" companies\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" years_active &lt;&gt; \" /><text value=\"1\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"30\" endIndex=\"47\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"years_active\" /></row><row><data content=\"Rocket Delivery\" /><data content=\"3\" /></row><row><data content=\"Hyped\" /><data content=\"8\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>years_active &lt;&gt; 1</code>.</p></body></html>"
          },
          {
            "title": "Example: Inequality with text values",
            "id": 91753,
