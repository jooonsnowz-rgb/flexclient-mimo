          {
            "title": "Example: Condition",
            "id": 93291,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tulis <code>WHERE</code> diikuti nama kolom untuk mendapatkan hanya game yang dirilis antara tahun 2000 dan 2020.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"2000\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"2020\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"27\" endIndex=\"40\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>WHERE release</code>.</p></body></html>"
          },
          {
            "title": "Question: Defining a range",
            "id": 93288,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang dipilih oleh query ini?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" score \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"0\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"50\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">item <code>players</code> dengan <code>score</code> antara 0 dan 50</item><item value=\"2\" correct=\"false\">item <code>players</code> dengan <code>score</code> lebih besar dari 50</item><item value=\"3\" correct=\"false\">  Item <code>players</code> dengan skor sama dengan 50</item></selection><p visible-if=\"wrong\">item <code>players</code> dengan <code>score</code> antara 0 dan 50.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Pemain memiliki score <code>0</code>, <code>25</code>, <code>50</code>, dan <code>51</code>. Score mana yang dipilih query tersebut?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" score \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"0\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"50\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>0</code>, <code>25</code>, dan <code>50</code></item><item value=\"2\" correct=\"false\">Hanya <code>25</code>, karena kedua batas tidak disertakan</item><item value=\"3\" correct=\"false\">Hanya <code>0</code> dan <code>50</code>, karena hanya batas yang cocok</item><item value=\"4\" correct=\"false\">Hanya <code>51</code>, karena <code>BETWEEN</code> berarti lebih besar dari nilai batas atas</item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>0</code>, <code>25</code>, dan <code>50</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example: The keyword BETWEEN",
            "id": 93292,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p> Selesaikan penulisan kondisi agar hanya game yang dirilis antara tahun 1990 dan 2000 yang muncul di tabel hasil.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"1990\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"2000\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"41\" endIndex=\"62\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>BETWEEN 1990 AND 2000</code>.</p></body></html>"
          },
          {
            "title": "Question: Border inclusive",
            "id": 93289,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apakah query ini akan memilih item dengan skor yang sama dengan <code>70</code> atau <code>100</code>?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" score \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"70\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"100\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Ya, karena rentang mencakup batas-batasnya</item><item value=\"2\" correct=\"false\">Tidak, karena range <em>tidak</em> menyertakan batasnya</item><item value=\"3\" correct=\"false\">Ya, ini akan memilih <em>hanya</em> item dengan <code>score</code> yang sama dengan <code>70</code> atau <code>100</code>, tidak ada nilai di antaranya</item></selection><p visible-if=\"wrong\">Ya, karena rentang mencakup batas-batasnya.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Diberikan score <code>69</code>, <code>70</code>, <code>85</code>, <code>100</code>, dan <code>101</code>, mana yang dipilih query?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" score \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"70\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"100\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>70</code>, <code>85</code>, dan <code>100</code></item><item value=\"2\" correct=\"false\">Hanya <code>85</code>, karena batas tidak disertakan</item><item value=\"3\" correct=\"false\">Hanya <code>70</code> dan <code>100</code>, karena <code>BETWEEN</code> mencantumkan dua opsi persis</item><item value=\"4\" correct=\"false\"><code>85</code>, <code>100</code>, dan <code>101</code>, karena hanya batas bawah yang berlaku</item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>70</code>, <code>85</code>, dan <code>100</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example: Border inclusive",
            "id": 93294,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Buat kode kondisi agar game yang dirilis antara tahun 1995 dan 2007, termasuk kedua tahun tersebut, ditampilkan di tabel hasil.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"1995\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"2007\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"27\" endIndex=\"40\" /><option startIndex=\"41\" endIndex=\"48\" /><option startIndex=\"49\" endIndex=\"53\" /><option startIndex=\"54\" endIndex=\"57\" /><option startIndex=\"58\" endIndex=\"62\" /><option correct=\"false\"><content><text value=\"1996\" /></content></option><option correct=\"false\"><content><text value=\"2008\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>WHERE release</code>, diikuti oleh <code>BETWEEN</code>, lalu <code>1995</code>, <code>AND</code>, <code>2007</code>.</p></body></html>"
          },
          {
            "title": "Question: A pattern is a text",
            "id": 93785,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Mengapa kita mengapit pola dengan tanda kutip tunggal?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Karena pola juga merupakan nilai teks</item><item value=\"2\" correct=\"false\">Kita tidak mengapit pola dengan tanda kutip tunggal</item><item value=\"3\" correct=\"false\">Kita tidak mengapit seluruh pola dengan tanda kutip tunggal, hanya wildcard <code>%</code></item></selection><p visible-if=\"wrong\">Karena pola juga merupakan nilai teks.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Pola adalah nilai teks. Apit seluruh pola dengan tanda kutip tunggal.</p><p>Kamu menulis <code>A'%'</code>. Perubahan mana yang membuat seluruh pola <code>A%</code> menjadi satu nilai teks?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Pindahkan tanda kutip pembuka ke sebelum <code>A</code></item><item value=\"2\" correct=\"false\">Hapus kedua tanda kutip</item><item value=\"3\" correct=\"false\">Letakkan tanda kutip di sekitar nama kolom</item><item value=\"4\" correct=\"false\">Pindahkan tanda kutip penutup ke sebelum <code>%</code></item></selection><p visible-if=\"wrong\">Pindahkan tanda kutip pembuka ke sebelum <code>A</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Question: Zero or more symbols",
            "id": 93786,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang akan dicocokkan oleh pola dalam query ini?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE users (&#xA;name varchar(255),&#xA;email varchar(255)&#xA;&#xA;);&#xA;&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Tara', 'tara.smith@gmail.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Ben', 'ben.turner@rdelivery.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Joan', 'joan.j@threadandco.uk');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Kim', 'kim.s.lee@gmail.uk');\"><tables><table name=\"users\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Tara\" /><data content=\"tara.smith@gmail.com\" /></row><row><data content=\"Ben\" /><data content=\"ben.turner@rdelivery.com\" /></row><row><data content=\"Joan\" /><data content=\"joan.j@threadandco.uk\" /></row><row><data content=\"Kim\" /><data content=\"kim.s.lee@gmail.uk\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" \" /><text value=\"users\" class=\"keyword\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" email \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'ben%'\" class=\"string\" /><text value=\";\" /></content><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Ben\" /><data content=\"ben.turner@rdelivery.com\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Nilai yang dimulai dengan teks <code>'ben'</code></item><item value=\"2\" correct=\"false\">Nilai yang diakhiri teks <code>'ben'</code></item><item value=\"3\" correct=\"false\">Nilai yang berisi teks <code>'ben'</code></item></selection><p visible-if=\"wrong\">Nilai yang dimulai dengan teks <code>'ben'</code>.</p></body></html>"
          },
          {
            "title": "Example: Start with",
            "id": 93790,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Buat pola untuk mencocokkan nilai <code>email</code> yang diawali dengan <code>'kim'</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE users (&#xA;name varchar(255),&#xA;email varchar(255)&#xA;&#xA;);&#xA;&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Tara', 'tara.smith@gmail.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Ben', 'ben.turner@rdelivery.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Joan', 'joan.j@threadandco.uk');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Kim', 'kim.s.lee@gmail.uk');\"><tables><table name=\"users\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Tara\" /><data content=\"tara.smith@gmail.com\" /></row><row><data content=\"Ben\" /><data content=\"ben.turner@rdelivery.com\" /></row><row><data content=\"Joan\" /><data content=\"joan.j@threadandco.uk\" /></row><row><data content=\"Kim\" /><data content=\"kim.s.lee@gmail.uk\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" \" /><text value=\"users\" class=\"keyword\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" email \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'kim%'\" class=\"string\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"38\" endIndex=\"44\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Kim\" /><data content=\"kim.s.lee@gmail.uk\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>'kim%'</code>.</p></body></html>"
          },
          {
            "title": "Example: End with",
            "id": 93791,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Buat pola yang cocok dengan nilai <code>email</code> yang diakhiri dengan <code>'.uk'</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE users (&#xA;name varchar(255),&#xA;email varchar(255)&#xA;&#xA;);&#xA;&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Tara', 'tara.smith@gmail.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Ben', 'ben.turner@rdelivery.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Joan', 'joan.j@threadandco.uk');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Kim', 'kim.s.lee@gmail.uk');\"><tables><table name=\"users\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Tara\" /><data content=\"tara.smith@gmail.com\" /></row><row><data content=\"Ben\" /><data content=\"ben.turner@rdelivery.com\" /></row><row><data content=\"Joan\" /><data content=\"joan.j@threadandco.uk\" /></row><row><data content=\"Kim\" /><data content=\"kim.s.lee@gmail.uk\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" \" /><text value=\"users\" class=\"keyword\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" email \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'%.uk'\" class=\"string\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"38\" endIndex=\"44\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Joan\" /><data content=\"joan.j@threadandco.uk\" /></row><row><data content=\"Kim\" /><data content=\"kim.s.lee@gmail.uk\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>'%.uk'</code>.</p></body></html>"
          },
          {
            "title": "Example: Containing",
            "id": 93792,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Gunakan dua wildcard dan <code>LIKE</code> untuk menulis kondisi yang memeriksa apakah nilai di kolom <code>email</code> berisi <code>'gmail'</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE users (&#xA;name varchar(255),&#xA;email varchar(255)&#xA;&#xA;);&#xA;&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Tara', 'tara.smith@gmail.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Ben', 'ben.turner@rdelivery.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Joan', 'joan.j@threadandco.uk');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Kim', 'kim.s.lee@gmail.uk');\"><tables><table name=\"users\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Tara\" /><data content=\"tara.smith@gmail.com\" /></row><row><data content=\"Ben\" /><data content=\"ben.turner@rdelivery.com\" /></row><row><data content=\"Joan\" /><data content=\"joan.j@threadandco.uk\" /></row><row><data content=\"Kim\" /><data content=\"kim.s.lee@gmail.uk\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" \" /><text value=\"users\" class=\"keyword\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" email \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'%gmail%'\" class=\"string\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"27\" endIndex=\"47\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Tara\" /><data content=\"tara.smith@gmail.com\" /></row><row><data content=\"Kim\" /><data content=\"kim.s.lee@gmail.uk\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>email LIKE '%gmail%'</code>.</p></body></html>"
          },
          {
            "title": "Example: IN keyword",
            "id": 93813,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kodekan keyword yang hilang untuk hanya memilih item dengan nilai <code>type</code> berupa <code>'basic'</code> atau <code>'pro'</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE membership (&#xA; name varchar(255),&#xA; type varchar(255),&#xA; months_active int&#xA;);&#xA;&#xA;INSERT INTO membership (name, type, months_active)&#xA;VALUES ('Sam', 'free', 2);&#xA;&#xA;INSERT INTO membership (name, type, months_active)&#xA;VALUES ('Remy', 'pro', 1);&#xA;&#xA;INSERT INTO membership (name, type, months_active)&#xA;VALUES ('Luis', 'basic', 12);&#xA;&#xA;INSERT INTO membership (name, type, months_active)&#xA;VALUES ('Kim', 'pro', 7);&#xA;\"><tables><table name=\"membership\"><row><header content=\"name\" /><header content=\"type\" /><header content=\"months_active\" /></row><row><data content=\"Sam\" /><data content=\"free\" /><data content=\"2\" /></row><row><data content=\"Remy\" /><data content=\"pro\" /><data content=\"1\" /></row><row><data content=\"Luis\" /><data content=\"basic\" /><data content=\"12\" /></row><row><data content=\"Kim\" /><data content=\"pro\" /><data content=\"7\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" membership\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"type\" class=\"keyword\" /><text value=\" \" /><text value=\"IN\" class=\"keyword\" /><text value=\" (\" /><text value=\"'basic'\" class=\"string\" /><text value=\", \" /><text value=\"'pro'\" class=\"string\" /><text value=\");\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"37\" endIndex=\"39\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"type\" /><header content=\"months_active\" /></row><row><data content=\"Remy\" /><data content=\"pro\" /><data content=\"1\" /></row><row><data content=\"Luis\" /><data content=\"basic\" /><data content=\"12\" /></row><row><data content=\"Kim\" /><data content=\"pro\" /><data content=\"7\" /></row></table></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>IN</code>.</p></body></html>"
          },
          {
            "title": "Question: Comma",
            "id": 93810,
