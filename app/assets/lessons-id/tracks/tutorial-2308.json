            "id": 132467,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Bagaimana cara mengirim respons HTML?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>res.send(\"&lt;p&gt;Me?&lt;/p&gt;\");</code></item><item value=\"2\" correct=\"false\"><code>res.html(\"&lt;p&gt;Me?&lt;/p&gt;\");</code></item><item value=\"3\" correct=\"false\"><code>res.json(\"&lt;p&gt;Me?&lt;/p&gt;\");</code></item></selection><p visible-if=\"wrong\">Pastikan kamu memilih <code>res.send(\"&lt;p&gt;Me?&lt;/p&gt;\");</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Bagaimana cara mengirim respons HTML?</p><p>Pilih method response yang mengirim paragraf HTML yang ditampilkan ke client.</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>res.send(\"&lt;p&gt;Me?&lt;/p&gt;\");</code></item><item value=\"2\" correct=\"false\"><code>res.html(\"&lt;p&gt;Me?&lt;/p&gt;\");</code></item><item value=\"3\" correct=\"false\"><code>res.json(\"&lt;p&gt;Me?&lt;/p&gt;\");</code></item><item value=\"4\" correct=\"false\"><code>res.render(\"&lt;p&gt;Me?&lt;/p&gt;\");</code></item></selection><p visible-if=\"wrong\"><code>res.send(\"&lt;p&gt;Me?&lt;/p&gt;\");</code>.</p></body></html>"
