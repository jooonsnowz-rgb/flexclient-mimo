            "interactiveContent": "<!DOCTYPE html ><html><body><p>Di mana parameter ditempatkan?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Parameter diletakkan di dalam tanda kurung fungsi yang sedang kita buat</item><item value=\"2\" correct=\"false\">Parameter hanya berada di dalam pernyataan <code>console.log()</code></item></selection><p visible-if=\"wrong\">Parameter diletakkan di dalam tanda kurung fungsi yang sedang kita buat.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Saat menulis <code>function greet(...)</code>, di mana kamu mendeklarasikan parameter yang menerima nama?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Parameter diletakkan di dalam tanda kurung fungsi yang sedang kita buat</item><item value=\"2\" correct=\"false\">Parameter hanya berada di dalam pernyataan <code>console.log()</code></item><item value=\"3\" correct=\"false\">Parameter berada di antara kurung kurawal</item></selection><p visible-if=\"wrong\">Parameter diletakkan di dalam tanda kurung fungsi yang sedang kita buat.</p></body></html>"
