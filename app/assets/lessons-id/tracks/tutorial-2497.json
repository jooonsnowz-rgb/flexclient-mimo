            "interactiveContent": "<!DOCTYPE html ><html><body><p>Mengapa kita memberi variabel nama yang deskriptif seperti <code>city</code> atau <code>country</code>, bukan <code>x</code> atau <code>y</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Untuk membantu kita memahami apa yang ada di dalamnya</item><item value=\"2\" correct=\"false\">Karena variabel harus memiliki setidaknya empat huruf</item></selection><p visible-if=\"wrong\">Untuk membantu kita memahami apa yang ada di dalamnya.</p></body></html>"
          },
