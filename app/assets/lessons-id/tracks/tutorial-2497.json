            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kata kunci apa yang bisa kita gunakan untuk mendeklarasikan variabel di Swift?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>let</code> dan <code>var</code></item><item value=\"2\" correct=\"false\"><code>const</code> dan <code>variable</code></item></selection><p visible-if=\"wrong\"><code>let</code> dan <code>var</code>.</p></body></html>"
