            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Apa yang salah dengan nama variabel ini?</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"var\" class=\"keyword\" /><text value=\" high \" /><text value=\"Score\" class=\"type\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Ini berisi spasi</item><item value=\"2\" correct=\"false\">Ini berisi huruf kapital</item></selection><p visible-if=\"wrong\">Ini berisi spasi.</p></body></html>"
