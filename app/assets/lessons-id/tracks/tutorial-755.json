            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Masukkan <code>!true</code> ke dalam statement display.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\"><content><text value=\"console\" class=\"built_in\" /><text value=\".log(!\" /><text value=\"true\" class=\"literal\" /><text value=\");\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"12\" endIndex=\"17\" /></interactions><output><content><text value=\"false\" /></content></output></code><p visible-if=\"wrong\">Pastikan kamu mengetik <code>!true</code>.</p></body></html>"
