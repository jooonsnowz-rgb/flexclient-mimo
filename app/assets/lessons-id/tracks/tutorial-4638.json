            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pelacak pengiriman memerlukan status numerik dari respons. Lengkapi akses atributnya.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"status = response.status_code\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"18\" endIndex=\"29\" /><option correct=\"false\"><content><text value=\"ok\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>status_code</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Pelacak pengiriman memerlukan status numerik dari respons. Lengkapi akses atributnya.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"status = response.status_code\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"18\" endIndex=\"29\" /><option correct=\"false\"><content><text value=\"ok\" /></content></option><option correct=\"false\"><content><text value=\"json\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Pastikan kamu memilih <code>status_code</code>.</p></body></html>",
            "hardModeSelected": true
