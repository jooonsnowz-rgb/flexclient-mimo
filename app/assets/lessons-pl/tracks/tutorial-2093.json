            "interactiveContent": "<!DOCTYPE html ><html><body><p>Podobnie jak w przypadku innych złączeń, słowo kluczowe <code>ON</code> określa warunek używany do dopasowywania wierszy.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students( &#xA; name varchar(255), &#xA; student_id int, &#xA; course_id int &#xA;); &#xA; &#xA;CREATE TABLE courses( &#xA; course_name varchar(255), &#xA; course_id int, &#xA; duration_in_years int &#xA;); &#xA; &#xA;INSERT INTO students(name, student_id, course_id) &#xA;VALUES(&quot;Pat&quot;, 234, 112); &#xA; &#xA;INSERT INTO students(name, student_id, course_id) &#xA;VALUES(&quot;Reagan&quot;, 098, 102); &#xA; &#xA;INSERT INTO students(name, student_id, course_id) &#xA;VALUES(&quot;Ash&quot;, 712, 212); &#xA; &#xA;INSERT INTO courses(course_name, course_id, duration_in_years) &#xA;VALUES(&quot;Anthropology&quot;, 102, 3); &#xA; &#xA;INSERT INTO courses(course_name, course_id, duration_in_years) &#xA;VALUES(&quot;Liberal Arts&quot;, 112, 4); &#xA; &#xA;INSERT INTO courses(course_name, course_id, duration_in_years) &#xA;VALUES(&quot;Gender Studies&quot;, 202, 2);\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"student_id\" /><header content=\"course_id\" /></row><row><data content=\"Pat\" /><data content=\"234\" /><data content=\"112\" /></row><row><data content=\"Reagan\" /><data content=\"98\" /><data content=\"102\" /></row><row><data content=\"Ash\" /><data content=\"712\" /><data content=\"212\" /></row></table><table name=\"courses\"><row><header content=\"course_name\" /><header content=\"course_id\" /><header content=\"duration_in_years\" /></row><row><data content=\"Anthropology\" /><data content=\"102\" /><data content=\"3\" /></row><row><data content=\"Liberal Arts\" /><data content=\"112\" /><data content=\"4\" /></row><row><data content=\"Gender Studies\" /><data content=\"202\" /><data content=\"2\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" courses \" /><text type=\"break\" /><text value=\"RIGHT\" class=\"keyword\" /><text value=\" \" /><text value=\"JOIN\" class=\"keyword\" /><text value=\" students \" /><text type=\"break\" /><text value=\"ON\" class=\"keyword\" /><text value=\" students.course_id = courses.course_id;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"44\" endIndex=\"46\" /></interactions><output><table name=\"Result\"><row><header content=\"course_name\" /><header content=\"course_id\" /><header content=\"duration_in_years\" /><header content=\"name\" /><header content=\"student_id\" /><header content=\"course_id\" /></row><row><data content=\"Anthropology\" /><data content=\"102\" /><data content=\"3\" /><data content=\"Reagan\" /><data content=\"98\" /><data content=\"102\" /></row><row><data content=\"Liberal Arts\" /><data content=\"112\" /><data content=\"4\" /><data content=\"Pat\" /><data content=\"234\" /><data content=\"112\" /></row><row><data content=\"\" /><data content=\"\" /><data content=\"\" /><data content=\"Ash\" /><data content=\"712\" /><data content=\"212\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>ON</code>.</p></body></html>"
