            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jak używamy zmiennych wewnątrz funkcji?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Używamy zmiennych wewnątrz funkcji tak jak zwykle</item><item value=\"2\" correct=\"false\">Nie możemy tworzyć nowych zmiennych w funkcjach</item></selection><p visible-if=\"wrong\">Używamy zmiennych wewnątrz funkcji tak jak zwykle.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Musisz zapisać imię osoby wewnątrz funkcji, zanim je wyświetlisz. Jak możesz użyć tam zmiennej?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Używamy zmiennych wewnątrz funkcji tak jak zwykle</item><item value=\"2\" correct=\"false\">Nie możemy tworzyć nowych zmiennych w funkcjach</item><item value=\"3\" correct=\"false\">Zmienne mogą być używane tylko poza funkcjami</item></selection><p visible-if=\"wrong\">Używamy zmiennych wewnątrz funkcji tak jak zwykle.</p></body></html>"
