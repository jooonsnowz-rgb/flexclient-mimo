            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dlaczego używamy wielu klas CSS?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Aby połączyć wiele stylów w naszym kodzie HTML</item><item value=\"2\" correct=\"false\">Aby utworzyć więcej klas CSS, które robią to samo</item></selection><p visible-if=\"wrong\">Aby połączyć wiele stylów w naszym kodzie HTML.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Akapit potrzebuje stylów z klas <code>bold</code> i <code>underlined</code>. Który atrybut zastosuje obie klasy?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>class=\"bold underlined\"</code></item><item value=\"2\" correct=\"false\"><code>class=\"bold, underlined\"</code></item><item value=\"3\" correct=\"false\"><code>class=\"bold\" class=\"underlined\"</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>class=\"bold underlined\"</code>.</p></body></html>",
