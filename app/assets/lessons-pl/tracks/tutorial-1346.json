          {
            "title": "Retrieve individual values",
            "id": 88674,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jak pobieramy poszczególne wartości z krotki zwróconej przez funkcję?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Według ich indeksu</item><item value=\"2\" correct=\"false\">Według ich wartości</item></selection><p visible-if=\"wrong\">Według ich indeksu.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Poszczególne wartości ze zwróconej krotki pobieramy za pomocą ich indeksów.</p><p>Zmienna <code>profile</code> przechowuje <code>(\"Mia\", 21)</code>. Które wyrażenie pobiera wiek?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>profile[1]</code></item><item value=\"2\" correct=\"false\"><code>profile[21]</code></item><item value=\"3\" correct=\"false\"><code>profile.age</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>profile[1]</code>.</p></body></html>"
