            "id": 145200,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Odejmij <code>damageTaken</code> od <code>health</code> i wyświetl wynik obliczenia w konsoli.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"89\" endIndex=\"95\" /><option startIndex=\"96\" endIndex=\"97\" /><option startIndex=\"98\" endIndex=\"109\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" health = \" /><text value=\"100\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" damageTaken = \" /><text value=\"20\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Health after hit:&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(health - damageTaken);\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>health</code>, następnie <code>-</code> i na końcu <code>damageTaken</code>.</p></body></html>"
          },
