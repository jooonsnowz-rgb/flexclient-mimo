            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Przechowaj wynik <code>score &gt;= 10</code> w zmiennej <code>unlockedLevelTwo</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"&lt;=\" /></content></option><option startIndex=\"41\" endIndex=\"42\" /><option startIndex=\"49\" endIndex=\"51\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" score = \" /><text value=\"12\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" unlockedLevelTwo = score &gt;= \" /><text value=\"10\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Level 2 unlocked: &quot;\" class=\"string\" /><text value=\" + unlockedLevelTwo);\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>=</code>, a następnie <code>&gt;=</code>.</p></body></html>"
