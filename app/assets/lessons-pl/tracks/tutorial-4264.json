            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co wyświetla ten kod w konsoli?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"10\" class=\"number\" /><text value=\" &gt;= \" /><text value=\"10\" class=\"number\" /><text value=\");\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>true</code></item><item value=\"2\" correct=\"false\"><code>false</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>true</code>.</p></body></html>"
