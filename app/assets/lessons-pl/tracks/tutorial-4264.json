            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Do czego używamy operatora <code>&gt;</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Aby sprawdzić, czy wynik jest większy od innego wyniku</item><item value=\"2\" correct=\"false\">Aby sprawdzić, czy wynik jest równy innemu wynikowi</item></selection><p visible-if=\"wrong\">Aby sprawdzić, czy wynik jest większy od innego wyniku.</p></body></html>"
