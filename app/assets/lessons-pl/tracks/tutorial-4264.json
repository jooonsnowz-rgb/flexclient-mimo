            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jakiego operatora używamy, aby sprawdzić, czy wynik po lewej stronie instrukcji jest równy <code>21</code> lub większy?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>&gt;=</code></item><item value=\"2\" correct=\"false\"><code>&lt;=</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>&gt;=</code>.</p></body></html>"
