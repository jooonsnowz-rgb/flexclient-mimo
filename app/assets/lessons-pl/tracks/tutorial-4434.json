            "id": 148291,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Podczas wywoływania funkcji <code>displayScores</code> zakoduj wartość wyświetlającą tablicę <code>scores</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"106\" endIndex=\"114\" isDefault=\"true\" /></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" scores = [\" /><text value=\"1200\" class=\"number\" /><text value=\", \" /><text value=\"2400\" class=\"number\" /><text value=\", \" /><text value=\"3600\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text type=\"break\" /><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"displayScores\" class=\"title\" /><text value=\"(\" /><text value=\"scores\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(scores);\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"displayScores(scores);}\" /></content></code><p visible-if=\"wrong\">Koniecznie wpisz <code>(scores)</code>.</p></body></html>"
