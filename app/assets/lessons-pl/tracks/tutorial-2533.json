            "title": "Intro 1",
            "id": 126768,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Świetne oprogramowanie nie tylko decyduje, co zrobić, gdy warunek ma wartość <code>true</code>, ale ma też plan awaryjny, jeśli warunek ma wartość <code>false</code>.</p><webview version=\"2\" visible-if=\"always\" content=\"&lt;!doctype html&gt;&#xA;&lt;html&gt;&#xA; &lt;head&gt;&#xA;  &lt;style&gt;&#xA;   img {&#xA;    height: 300px;&#xA;    width: 200px;&#xA;    border: 1px;&#xA;    border-radius: 10px;&#xA;   }&#xA;   &#xA;   div {&#xA;    margin: auto;&#xA;    width: 50%;&#xA;    background-color: black;&#xA;    height: 300px;&#xA;    width: 200px;&#xA;    border: 1px;&#xA;    border-radius: 10px;&#xA;   }&#xA;   &#xA;   button {&#xA;    width: 200px;&#xA;    height: 30px;&#xA;    font-size: 20px;&#xA;    border-radius: 5px;&#xA;    margin: 0 auto;&#xA;    display: block;&#xA;    background-color: #7a88ba;&#xA;    color: white;&#xA;    touch-action: manipulation;&#xA;   }&#xA;  &lt;/style&gt;&#xA; &lt;/head&gt;&#xA; &lt;body&gt;&#xA;  &lt;div id=&quot;imgDiv&quot;&gt;&#xA;  &lt;/div&gt;&lt;br&gt;&#xA;  &lt;button onClick=&quot;toggle()&quot; id=&quot;switch&quot;&gt;isOn == false&lt;/button&gt;&#xA;  &lt;script&gt;&#xA;   let labelOn = &quot;isOn == false&quot;;&#xA;   let labelOff = &quot;isOn == true&quot;;&#xA;   let btn = document.getElementById(&quot;switch&quot;);&#xA;   let imgDiv = document.getElementById(&quot;imgDiv&quot;);&#xA;   let img = document.createElement(&quot;img&quot;);&#xA;   img.src =&#xA;    &quot;https://images.unsplash.com/photo-1537923733628-c28d980ef483?ixlib=rb-1.2.1&amp;ixid=eyJhcHBfaWQiOjEyMDd9&amp;auto=format&amp;fit=crop&amp;w=2734&amp;q=80&quot;;&#xA;   &#xA;   function toggle() {&#xA;    if (btn.innerHTML == labelOn) {&#xA;     btn.innerHTML = labelOff;&#xA;     imgDiv.appendChild(img);&#xA;    } else {&#xA;     btn.innerHTML = labelOn;&#xA;     imgDiv.removeChild(img);&#xA;    }&#xA;   }&#xA;  &lt;/script&gt;&#xA; &lt;/body&gt;&#xA;&lt;/html&gt;\" /></body></html>"
          },
          {
            "title": "Intro 2",
            "id": 126769,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Na przykład ta aplikacja włącza światła, jeśli <code>isOn</code> ma wartość <code>true</code>, i wyłącza je, jeśli <code>isOn</code> ma wartość <code>false</code>.</p><webview version=\"2\" content=\"&lt;!doctype html&gt;&#xA;&lt;html&gt;&#xA; &lt;head&gt;&#xA;  &lt;style&gt;&#xA;   img {&#xA;    height: 300px;&#xA;    width: 200px;&#xA;    border: 1px;&#xA;    border-radius: 10px;&#xA;   }&#xA;   &#xA;   div {&#xA;    margin: auto;&#xA;    width: 50%;&#xA;    background-color: black;&#xA;    height: 300px;&#xA;    width: 200px;&#xA;    border: 1px;&#xA;    border-radius: 10px;&#xA;   }&#xA;   &#xA;   button {&#xA;    width: 200px;&#xA;    height: 30px;&#xA;    font-size: 20px;&#xA;    border-radius: 5px;&#xA;    margin: 0 auto;&#xA;    display: block;&#xA;    background-color: #7a88ba;&#xA;    color: white;&#xA;    touch-action: manipulation;&#xA;   }&#xA;  &lt;/style&gt;&#xA; &lt;/head&gt;&#xA; &lt;body&gt;&#xA;  &lt;div id=&quot;imgDiv&quot;&gt;&#xA;  &lt;/div&gt;&lt;br&gt;&#xA;  &lt;button onClick=&quot;toggle()&quot; id=&quot;switch&quot;&gt;isOn == false&lt;/button&gt;&#xA;  &lt;script&gt;&#xA;   let labelOn = &quot;isOn == false&quot;;&#xA;   let labelOff = &quot;isOn == true&quot;;&#xA;   let btn = document.getElementById(&quot;switch&quot;);&#xA;   let imgDiv = document.getElementById(&quot;imgDiv&quot;);&#xA;   let img = document.createElement(&quot;img&quot;);&#xA;   img.src =&#xA;    &quot;https://images.unsplash.com/photo-1537923733628-c28d980ef483?ixlib=rb-1.2.1&amp;ixid=eyJhcHBfaWQiOjEyMDd9&amp;auto=format&amp;fit=crop&amp;w=2734&amp;q=80&quot;;&#xA;   &#xA;   function toggle() {&#xA;    if (btn.innerHTML == labelOn) {&#xA;     btn.innerHTML = labelOff;&#xA;     imgDiv.appendChild(img);&#xA;    } else {&#xA;     btn.innerHTML = labelOn;&#xA;     imgDiv.removeChild(img);&#xA;    }&#xA;   }&#xA;  &lt;/script&gt;&#xA; &lt;/body&gt;&#xA;&lt;/html&gt;\" /></body></html>"
          },
          {
            "title": "Intro 3",
