            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dodaj poprawny typ.</p><code version=\"2\" codelang=\"typescript\" name=\"script.ts\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" colors: \" /><text value=\"string\" class=\"built_in\" /><text value=\"[] = [\" /><text value=\"&quot;red&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;green&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;blue&quot;\" class=\"string\" /><text value=\"];\" /><text type=\"break\" /><text value=\"let\" class=\"keyword\" /><text value=\" firstColor = colors[\" /><text value=\"0\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(firstColor);\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"12\" endIndex=\"20\" /></interactions><output><content><text value=\"red\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>string[]</code>.</p></body></html>"
