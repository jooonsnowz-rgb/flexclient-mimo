            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Przechowuj listę w zmiennej <code>cart</code>, tak aby w konsoli wyświetlała się wartość <code>1</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"cart = [(\" /><text value=\"&quot;t-shirt&quot;\" class=\"string\" /><text value=\", \" /><text value=\"40\" class=\"number\" /><text value=\")]\" /><text type=\"break\" /><text value=\"print(len(cart))\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"7\" endIndex=\"24\" /><option correct=\"false\"><content><text value=\"[(&quot;t-shirt&quot;, 40), (&quot;jeans&quot;, 70)]\" /></content></option></options></interaction></interactions><output><content><text value=\"1\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>[(\"t-shirt\", 40)]</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Zapisz w <code>cart</code> listę zawierającą jedną krotkę, aby w konsoli została wyświetlona wartość <code>1</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"cart = [(\" /><text value=\"&quot;t-shirt&quot;\" class=\"string\" /><text value=\", \" /><text value=\"40\" class=\"number\" /><text value=\")]\" /><text type=\"break\" /><text value=\"print(len(cart))\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"7\" endIndex=\"24\" /><option correct=\"false\"><content><text value=\"[(&quot;t-shirt&quot;, 40), (&quot;jeans&quot;, 70)]\" /></content></option></options></interaction></interactions><output><content><text value=\"1\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>[(\"t-shirt\", 40)]</code>.</p></body></html>"
