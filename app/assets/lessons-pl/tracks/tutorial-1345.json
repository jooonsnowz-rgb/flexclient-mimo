            "hardModeContent": "<!DOCTYPE html ><html><body><p>Odczytaj pierwszą wartość z krotki <code>jupiter</code>, aby kod wyświetlił <code>surface area: 61.42 billion km2</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"jupiter\" /><text value=\" \" /><text value=\"=\" /><text value=\" \" /><text value=\"(\" /><text value=\"&quot;61.42 billion km2&quot;\" class=\"string\" /><text value=\",\" /><text value=\" \" /><text value=\"&quot;79 moons&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"print\" /><text value=\"(\" /><text value=\"f\" /><text value=\"&quot;surface area: {jupiter[0]}&quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"67\" endIndex=\"74\" /><option startIndex=\"74\" endIndex=\"75\" /><option startIndex=\"75\" endIndex=\"76\" /><option startIndex=\"76\" endIndex=\"77\" /><option correct=\"false\"><content><text value=\"(\" /></content></option><option correct=\"false\"><content><text value=\")\" /></content></option><option correct=\"false\"><content><text value=\"1\" /></content></option></options></interaction></interactions><output><content><text value=\"surface area: 61.42 billion km2\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>jupiter</code>, następnie <code>[</code>, <code>0</code> i na końcu <code>]</code>.</p></body></html>",
