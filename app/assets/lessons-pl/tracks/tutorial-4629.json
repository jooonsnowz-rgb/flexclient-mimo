          {
            "title": "Catch HTTP Errors",
            "id": 152198,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Która linia przechwytuje błąd HTTP zgłoszony przez kod w bloku <code>try</code>?</p><code version=\"2\" codelang=\"python\" name=\"request.py\" visible-if=\"always\"><content><text value=\"try\" class=\"keyword\" /><text value=\":\" /><text type=\"break\" /><text value=\"  response = requests.get(url)\" /><text type=\"break\" /><text value=\"  response.raise_for_status()\" /></content></code><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>except requests.HTTPError as error:</code></item><item value=\"2\" correct=\"false\"><code>except ValueError as error:</code></item><item value=\"3\" correct=\"false\"><code>else:</code></item></selection><p visible-if=\"wrong\"><code>except requests.HTTPError as error:</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Która linia przechwytuje błąd HTTP zgłoszony przez kod w bloku <code>try</code>?</p><code version=\"2\" codelang=\"python\" name=\"request.py\" visible-if=\"always\"><content><text value=\"try\" class=\"keyword\" /><text value=\":\" /><text type=\"break\" /><text value=\"  response = requests.get(url)\" /><text type=\"break\" /><text value=\"  response.raise_for_status()\" /></content></code><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>except requests.HTTPError as error:</code></item><item value=\"2\" correct=\"false\"><code>except ValueError as error:</code></item><item value=\"3\" correct=\"false\"><code>else:</code></item><item value=\"4\" correct=\"false\"><code>except requests.ConnectionError as error:</code></item></selection><p visible-if=\"wrong\"><code>except requests.HTTPError as error:</code>.</p></body></html>"
          },
