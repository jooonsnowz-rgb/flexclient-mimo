            "hardModeContent": "<!DOCTYPE html ><html><body><p>Profil ma już imię i adres e-mail. Musisz tylko zmienić jego adres e-mail. Które wywołanie pasuje do tego zadania?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>requests.patch(url, json=data)</code></item><item value=\"2\" correct=\"false\"><code>requests.put(url, json=data)</code></item><item value=\"3\" correct=\"false\"><code>requests.post(url, json=data)</code></item><item value=\"4\" correct=\"false\"><code>requests.get(url, json=data)</code></item></selection><p visible-if=\"wrong\"><code>requests.patch(url, json=data)</code>.</p></body></html>"
