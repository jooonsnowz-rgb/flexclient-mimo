            "interactiveContent": "<!DOCTYPE html ><html><body><p>Uzupełnij wywołanie, które tworzy użytkownika i wysyła <code>data</code> jako JSON.</p><code version=\"2\" codelang=\"python\" name=\"create_user.py\" visible-if=\"always\"><content><text value=\"data = {\" /><text value=\"&quot;name&quot;\" class=\"string\" /><text value=\": \" /><text value=\"&quot;Ari&quot;\" class=\"string\" /><text value=\"}\" /><text type=\"break\" /><text value=\"response = requests.post(url, json=data)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"43\" endIndex=\"47\" /><option startIndex=\"53\" endIndex=\"62\" /><option correct=\"false\"><content><text value=\"get\" /></content></option><option correct=\"false\"><content><text value=\"data=json\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>post</code>, a następnie <code>json=data</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Utwórz użytkownika pod adresem <code>url</code> i wyślij słownik <code>data</code> jako JSON.</p><code version=\"2\" codelang=\"python\" name=\"create_user.py\" visible-if=\"always\"><content><text value=\"data = {\" /><text value=\"&quot;name&quot;\" class=\"string\" /><text value=\": \" /><text value=\"&quot;Ari&quot;\" class=\"string\" /><text value=\"}\" /><text type=\"break\" /><text value=\"response = requests.post(url, json=data)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"43\" endIndex=\"47\" /><option startIndex=\"48\" endIndex=\"51\" /><option startIndex=\"53\" endIndex=\"57\" /><option startIndex=\"58\" endIndex=\"62\" /><option correct=\"false\"><content><text value=\"get\" /></content></option><option correct=\"false\"><content><text value=\"response\" /></content></option><option correct=\"false\"><content><text value=\"text\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>post</code>, następnie <code>url</code>, <code>json</code> i na końcu <code>data</code>.</p></body></html>",
