          {
            "title": "Build a GET Request",
            "id": 152193,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Uzupełnij wywołanie funkcji, które wysyła żądanie <code>GET</code> do <code>url</code>.</p><code version=\"2\" codelang=\"python\" name=\"books.py\" visible-if=\"always\"><content><text value=\"import\" class=\"keyword\" /><text value=\" requests\" /><text type=\"break\" /><text type=\"break\" /><text value=\"url = \" /><text value=\"&quot;https://api.example.com/books/7&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"response = requests.get(url)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"77\" endIndex=\"80\" /><option correct=\"false\"><content><text value=\"post\" /></content></option><option correct=\"false\"><content><text value=\"delete\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>get</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Pobierz książkę pod adresem <code>url</code> i zapisz zwrócony obiekt w <code>response</code>.</p><code version=\"2\" codelang=\"python\" name=\"books.py\" visible-if=\"always\"><content><text value=\"import\" class=\"keyword\" /><text value=\" requests\" /><text type=\"break\" /><text type=\"break\" /><text value=\"url = \" /><text value=\"&quot;https://api.example.com/books/7&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"response = requests.get(url)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"57\" endIndex=\"65\" /><option startIndex=\"68\" endIndex=\"76\" /><option startIndex=\"77\" endIndex=\"80\" /><option startIndex=\"81\" endIndex=\"84\" /><option correct=\"false\"><content><text value=\"post\" /></content></option><option correct=\"false\"><content><text value=\"delete\" /></content></option><option correct=\"false\"><content><text value=\"data\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>response</code>, następnie <code>requests</code>, <code>get</code> i na końcu <code>url</code>.</p></body></html>",
            "hardModeSelected": true
          },
