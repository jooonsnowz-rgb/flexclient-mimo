            "id": 152197,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Uzupełnij metodę response, która zgłasza błąd HTTP w przypadku niepomyślnego statusu.</p><code version=\"2\" codelang=\"python\" name=\"errors.py\" visible-if=\"always\"><content><text value=\"response.raise_for_status()\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"9\" endIndex=\"18\" /><option startIndex=\"18\" endIndex=\"25\" /><option correct=\"false\"><content><text value=\"check_for\" /></content></option><option correct=\"false\"><content><text value=\"_error\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>raise_for</code>, a następnie <code>_status</code>.</p></body></html>",
            "hardModeSelected": true
