            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co robi <code>max()</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Znajduje największą wartość na liście liczb</item><item value=\"2\" correct=\"false\">Podaje długość listy liczb</item></selection><p visible-if=\"wrong\">Znajduje największą wartość na liście liczb.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Funkcja <code>max()</code> znajduje największą wartość na liście liczb.</p><p>Dana jest lista <code>prices = [12, 18, 9]</code>. Co zwróci <code>max(prices)</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>18</code></item><item value=\"2\" correct=\"false\"><code>3</code>, ponieważ lista zawiera trzy wartości</item><item value=\"3\" correct=\"false\"><code>9</code>, ponieważ jest ostatnią wartością</item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>18</code>.</p></body></html>"
