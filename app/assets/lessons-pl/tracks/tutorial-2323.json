            "id": 86463,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wyświetl liczby od <code>1</code> do <code>7</code> w konsoli.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"days = \" /><text value=\"0\" class=\"number\" /><text type=\"break\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" days &lt; \" /><text value=\"7\" class=\"number\" /><text value=\":\" /><text type=\"break\" /><text value=\"  days += \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text value=\"  print(days)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"28\" endIndex=\"37\" /><option startIndex=\"40\" endIndex=\"51\" /><option correct=\"false\"><content><text value=\"days += 2\" /></content></option><option correct=\"false\"><content><text value=\"print(&quot;days&quot;)\" /></content></option></options></interaction></interactions><output><content><text value=\"1\" /><text type=\"break\" /><text value=\"2\" /><text type=\"break\" /><text value=\"3\" /><text type=\"break\" /><text value=\"4\" /><text type=\"break\" /><text value=\"5\" /><text type=\"break\" /><text value=\"6\" /><text type=\"break\" /><text value=\"7\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>days += 1</code>, a następnie <code>print(days)</code>.</p></body></html>"
