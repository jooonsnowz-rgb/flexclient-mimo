            "id": 86468,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co wyświetla ten kod w konsoli?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"counter = \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" counter &lt; \" /><text value=\"5\" class=\"number\" /><text value=\":\" /><text type=\"break\" /><text value=\"  print(counter)\" /><text type=\"break\" /><text value=\"  counter += \" /><text value=\"1\" class=\"number\" /></content><output><content><text value=\"1\" /><text type=\"break\" /><text value=\"2\" /><text type=\"break\" /><text value=\"3\" /><text type=\"break\" /><text value=\"4\" /></content></output></code><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Liczby od <code>1</code> do <code>4</code></item><item value=\"2\" correct=\"false\">Liczby od <code>1</code> do <code>5</code></item><item value=\"3\" correct=\"false\">Liczby od <code>2</code> do <code>5</code></item><item value=\"4\" correct=\"false\">Liczby od <code>2</code> do <code>4</code></item></selection><p visible-if=\"wrong\">Liczby od <code>1</code> do <code>4</code>.</p></body></html>"
          },
          {
