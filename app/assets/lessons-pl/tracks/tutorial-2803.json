            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jakiego modyfikatora użyjesz, aby zagwarantować, że właściwość nie będzie mogła zostać zmieniona po inicjalizacji?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">readonly</item><item value=\"2\" correct=\"false\">opcjonalne</item><item value=\"3\" correct=\"false\">public</item><item value=\"4\" correct=\"false\">prywatne</item></selection><p visible-if=\"wrong\">Koniecznie wybierz readonly.</p></body></html>"
