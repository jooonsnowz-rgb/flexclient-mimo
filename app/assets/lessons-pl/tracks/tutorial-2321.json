            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jak nazywa się zmienna licznika w tym kodzie?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"i = \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" i &lt; \" /><text value=\"5\" class=\"number\" /><text value=\": \" /><text type=\"break\" /><text value=\"  print(i)\" /><text type=\"break\" /><text value=\"  i += \" /><text value=\"1\" class=\"number\" /></content><output><content><text value=\"1\" /><text type=\"break\" /><text value=\"2\" /><text type=\"break\" /><text value=\"3\" /><text type=\"break\" /><text value=\"4\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>i</code></item><item value=\"2\" correct=\"false\"><code>counter</code></item><item value=\"3\" correct=\"false\">W kodzie nie ma zmiennej licznika</item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>i</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Zmieniasz nazwę zmiennej licznika z <code>i</code> na <code>step</code>. Która zmiana pozwoli zachować takie samo działanie pętli?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"i = \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" i &lt; \" /><text value=\"5\" class=\"number\" /><text value=\": \" /><text type=\"break\" /><text value=\"  print(i)\" /><text type=\"break\" /><text value=\"  i += \" /><text value=\"1\" class=\"number\" /></content><output><content><text value=\"1\" /><text type=\"break\" /><text value=\"2\" /><text type=\"break\" /><text value=\"3\" /><text type=\"break\" /><text value=\"4\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Zastąp <code>i</code> zmienną <code>step</code> wszędzie, gdzie występuje.</item><item value=\"2\" correct=\"false\">Zastąp <code>i</code> tylko w pierwszym wierszu.</item><item value=\"3\" correct=\"false\">Zastąp <code>i</code> tylko w warunku i aktualizacji.</item></selection><p visible-if=\"wrong\">Zastąp <code>i</code> zmienną <code>step</code> wszędzie, gdzie występuje.</p></body></html>",
            "hardModeSelected": true
