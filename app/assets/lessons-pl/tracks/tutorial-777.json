            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jakiego słowa kluczowego używamy do tworzenia pętli while?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>while</code></item><item value=\"2\" correct=\"false\"><code>if</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>while</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Chcesz powtarzać kod, dopóki warunek ma wartość true. Które słowo kluczowe rozpoczyna taką pętlę?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>while</code></item><item value=\"2\" correct=\"false\"><code>if</code></item><item value=\"3\" correct=\"false\"><code>for</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>while</code>.</p></body></html>"
