            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zadeklaruj zmienną poprawnie.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"0\" endIndex=\"3\" isDefault=\"true\" /></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" currentLevel = \" /><text value=\"1\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"currentLevel = \" /><text value=\"2\" class=\"number\" /><text value=\";\" /></content></code><p visible-if=\"wrong\">Koniecznie wpisz <code>let</code>.</p></body></html>"
