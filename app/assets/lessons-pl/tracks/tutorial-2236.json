            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co wyświetla ten kod w konsoli?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" acceleration = \" /><text value=\"0\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" (acceleration &lt; \" /><text value=\"3\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\" acceleration++;\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(acceleration);\" /><text type=\"break\" /><text value=\"}\" /></content><output><content><text value=\"1\" /><text type=\"break\" /><text value=\"2\" /><text type=\"break\" /><text value=\"3\" /></content></output></code><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Liczby od <code>1</code> do <code>3</code></item><item value=\"2\" correct=\"false\">Liczby od <code>0</code> do <code>3</code></item><item value=\"3\" correct=\"false\">Liczby od <code>1</code> do <code>4</code></item></selection><p visible-if=\"wrong\">Liczby od <code>1</code> do <code>3</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Co wyświetla ten kod w konsoli?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" acceleration = \" /><text value=\"0\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" (acceleration &lt; \" /><text value=\"3\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\" acceleration++;\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(acceleration);\" /><text type=\"break\" /><text value=\"}\" /></content><output><content><text value=\"1\" /><text type=\"break\" /><text value=\"2\" /><text type=\"break\" /><text value=\"3\" /></content></output></code><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Liczby od <code>1</code> do <code>3</code></item><item value=\"2\" correct=\"false\">Liczby od <code>0</code> do <code>3</code></item><item value=\"3\" correct=\"false\">Liczby od <code>1</code> do <code>4</code></item><item value=\"4\" correct=\"false\">Liczby od <code>1</code> do <code>2</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz Liczby od <code>1</code> do <code>3</code>.</p></body></html>"
