            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zakoduj warunek tak, aby zmienna licznika odliczała od <code>5</code> do <code>1</code>. Uwzględnij liczbę <code>1</code> w warunku.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"5\" class=\"number\" /><text value=\"; i &gt;= \" /><text value=\"1\" class=\"number\" /><text value=\"; i--) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(i);\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"16\" endIndex=\"17\" /><option startIndex=\"18\" endIndex=\"20\" /><option startIndex=\"21\" endIndex=\"22\" /><option correct=\"false\"><content><text value=\"index\" /></content></option><option correct=\"false\"><content><text value=\"0\" /></content></option></options></interaction></interactions><output><content><text value=\"5\" /><text type=\"break\" /><text value=\"4\" /><text type=\"break\" /><text value=\"3\" /><text type=\"break\" /><text value=\"2\" /><text type=\"break\" /><text value=\"1\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>i</code>, następnie <code>&gt;=</code> i na końcu <code>1</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Odliczaj od <code>5</code> do <code>1</code>. W warunku umieść <code>i</code> po lewej stronie, a <code>1</code> po prawej.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"5\" class=\"number\" /><text value=\"; i &gt;= \" /><text value=\"1\" class=\"number\" /><text value=\"; i--) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(i);\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"13\" endIndex=\"14\" /><option startIndex=\"16\" endIndex=\"17\" /><option startIndex=\"18\" endIndex=\"20\" /><option startIndex=\"21\" endIndex=\"22\" /><option correct=\"false\"><content><text value=\"index\" /></content></option><option correct=\"false\"><content><text value=\"&gt;\" /></content></option><option correct=\"false\"><content><text value=\"0\" /></content></option><option correct=\"false\"><content><text value=\"6\" /></content></option></options></interaction></interactions><output><content><text value=\"5\" /><text type=\"break\" /><text value=\"4\" /><text type=\"break\" /><text value=\"3\" /><text type=\"break\" /><text value=\"2\" /><text type=\"break\" /><text value=\"1\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>5</code>, następnie <code>i</code>, <code>&gt;=</code> i na końcu <code>1</code>.</p></body></html>",
