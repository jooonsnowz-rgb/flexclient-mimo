            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co wyświetla ten kod w konsoli?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" tracker = \" /><text value=\"1\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" (tracker &lt;= \" /><text value=\"2\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\" tracker++;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(tracker);\" /></content><output><content><text value=\"3\" /></content></output></code><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>3</code></item><item value=\"2\" correct=\"false\"><code>2</code></item><item value=\"3\" correct=\"false\"><code>1</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>3</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Zastępujesz <code>tracker &lt;= 2</code> wyrażeniem <code>tracker &lt; 2</code>. Co wyświetli ostatni wiersz?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" tracker = \" /><text value=\"1\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" (tracker &lt;= \" /><text value=\"2\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\" tracker++;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(tracker);\" /></content><output><content><text value=\"3\" /></content></output></code><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>2</code></item><item value=\"2\" correct=\"false\"><code>3</code></item><item value=\"3\" correct=\"false\"><code>1</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>2</code>.</p></body></html>",
            "hardModeSelected": true
