            "id": 74824,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co wyświetla ten kod w konsoli?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"0\" class=\"number\" /><text value=\"; i &lt; \" /><text value=\"3\" class=\"number\" /><text value=\"; i++) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Polly wants a cracker!&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content><output><content><text value=\"Polly wants a cracker!\" /><text type=\"break\" /><text value=\"Polly wants a cracker!\" /><text type=\"break\" /><text value=\"Polly wants a cracker!\" /></content></output></code><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>Polly wants a cracker!</code> trzy razy</item><item value=\"2\" correct=\"false\">Liczby od <code>1</code> do <code>3</code></item><item value=\"3\" correct=\"false\">Liczby od <code>0</code> do <code>3</code></item></selection><p visible-if=\"wrong\"><code>Polly wants a cracker!</code> trzy razy.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Co wyświetla ten kod w konsoli?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"0\" class=\"number\" /><text value=\"; i &lt; \" /><text value=\"3\" class=\"number\" /><text value=\"; i++) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Polly wants a cracker!&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content><output><content><text value=\"Polly wants a cracker!\" /><text type=\"break\" /><text value=\"Polly wants a cracker!\" /><text type=\"break\" /><text value=\"Polly wants a cracker!\" /></content></output></code><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>Polly wants a cracker!</code> trzy razy</item><item value=\"2\" correct=\"false\">Liczby od <code>1</code> do <code>3</code></item><item value=\"3\" correct=\"false\">Liczby od <code>0</code> do <code>3</code></item><item value=\"4\" correct=\"false\">Wiadomość jeden raz</item></selection><p visible-if=\"wrong\"><code>Polly wants a cracker!</code> trzy razy.</p></body></html>"
