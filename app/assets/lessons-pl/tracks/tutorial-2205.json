            "id": 62039,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Która wartość nie jest ciągiem znaków?</p><selection multiple=\"multiple\" iscode=\"false\"><item correct=\"true\" value=\"1\"><code>true</code></item><item correct=\"false\" value=\"2\"><code>\"true\"</code></item><item correct=\"false\" value=\"2\"><code>\"wrong\"</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>true</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Twoja aplikacja jest gotowa. Którą specjalną wartość należy zapisać w <code>isReady</code>, aby to pokazać?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>true</code></item><item value=\"2\" correct=\"false\"><code>\"true\"</code></item><item value=\"3\" correct=\"false\"><code>false</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>true</code>.</p></body></html>",
            "hardModeSelected": true
