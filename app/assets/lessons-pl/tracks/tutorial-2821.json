            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dlaczego link nie działa?</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Example link\" /><text value=\"&lt;/\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text value=\" \" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"a\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Click here\" /><text value=\"&lt;/\" /><text value=\"a\" class=\"name\" /><text value=\"&gt;\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Ponieważ nie ma atrybutu <code>href</code></item><item value=\"2\" correct=\"false\">Ponieważ nie ma tekstu między <code>&lt;a&gt;</code> a <code>&lt;/a&gt;</code></item></selection><p visible-if=\"wrong\">Ponieważ nie ma atrybutu <code>href</code>.</p></body></html>"
