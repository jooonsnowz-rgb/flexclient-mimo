            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zwróć ten ciąg znaków, kodując <code>greeting</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"add_greeting\" class=\"title\" /><text value=\"(user)\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\"  greeting = \" /><text value=\"&quot;Greetings &quot;\" class=\"string\" /><text value=\" + user\" /><text type=\"break\" /><text value=\"  \" /><text value=\"return\" class=\"keyword\" /><text value=\" greeting\" /><text type=\"break\" /><text type=\"break\" /><text value=\"result = add_greeting(\" /><text value=\"&quot;Saoirse&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"print(result)\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"66\" endIndex=\"74\" /></interactions><output><content><text value=\"Greetings Saoirse\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>greeting</code>.</p></body></html>"
