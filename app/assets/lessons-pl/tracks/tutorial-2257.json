            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co jest nie tak z poniższym kodem?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getDouble = \" /><text value=\"(\" /><text value=\"number\" class=\"params\" /><text value=\") =&gt;\" /><text value=\" number * \" /><text value=\"2\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getDouble());\" /></content><output><content><text value=\"NaN\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Musimy ustawić domyślną wartość parametru, aby uniknąć wyświetlania <code>NaN</code></item><item value=\"2\" correct=\"false\">Używanie nawiasów z jednym parametrem prowadzi do błędu</item><item value=\"3\" correct=\"false\">Brakuje nawiasów klamrowych</item></selection><p visible-if=\"wrong\">Musimy ustawić domyślną wartość parametru, aby uniknąć wyświetlania <code>NaN</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>getDouble()</code> nie przekazuje wartości do <code>number</code>, więc mnożenie daje <code>NaN</code>. Która zmiana naprawi ten przypadek?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getDouble = \" /><text value=\"(\" /><text value=\"number\" class=\"params\" /><text value=\") =&gt;\" /><text value=\" number * \" /><text value=\"2\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getDouble());\" /></content><output><content><text value=\"NaN\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Musimy ustawić domyślną wartość parametru, aby uniknąć wyświetlania <code>NaN</code></item><item value=\"2\" correct=\"false\">Używanie nawiasów z jednym parametrem prowadzi do błędu</item><item value=\"3\" correct=\"false\">Brakuje nawiasów klamrowych</item><item value=\"4\" correct=\"false\">Funkcja potrzebuje drugiego parametru</item></selection><p visible-if=\"wrong\">Musimy ustawić domyślną wartość parametru, aby uniknąć wyświetlania <code>NaN</code>.</p></body></html>"
