            "hardModeContent": "<!DOCTYPE html ><html><body><p>Dodaj drugi parametr, <code>width</code>, do funkcji strzałkowej. Użyj go w obliczeniu pola, aby kod wyświetlił <code>50</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getRectangleArea = \" /><text value=\"(\" /><text value=\"length, width\" class=\"params\" /><text value=\") =&gt;\" /><text value=\" length * width;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getRectangleArea(\" /><text value=\"10\" class=\"number\" /><text value=\", \" /><text value=\"5\" class=\"number\" /><text value=\"));\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"32\" endIndex=\"33\" /><option startIndex=\"34\" endIndex=\"39\" /><option startIndex=\"51\" endIndex=\"52\" /><option startIndex=\"53\" endIndex=\"58\" /><option correct=\"false\"><content><text value=\":\" /></content></option><option correct=\"false\"><content><text value=\"and\" /></content></option><option correct=\"false\"><content><text value=\"+\" /></content></option></options></interaction></interactions><output><content><text value=\"50\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>,</code>, następnie <code>width</code>, <code>*</code> i na końcu <code>width</code>.</p></body></html>",
