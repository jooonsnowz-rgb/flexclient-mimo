            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dodaj domyślną wartość parametru <code>0</code> do funkcji strzałkowej.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getConvertedHours = \" /><text value=\"(\" /><text value=\"seconds = \" /><text value=\"0\" class=\"number\" /><text value=\") =&gt;\" /><text value=\" seconds / \" /><text value=\"3600\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getConvertedHours());\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"27\" endIndex=\"34\" /><option startIndex=\"35\" endIndex=\"36\" /><option startIndex=\"37\" endIndex=\"38\" /><option correct=\"false\"><content><text value=\"=&gt;\" /></content></option></options></interaction></interactions><output><content><text value=\"0\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>seconds</code>, następnie <code>=</code> i na końcu <code>0</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Dodaj do funkcji strzałkowej domyślną wartość parametru <code>0</code>. Uzupełnij przypisanie, aby wywołanie bez argumentu wyświetliło <code>0</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getConvertedHours = \" /><text value=\"(\" /><text value=\"seconds = \" /><text value=\"0\" class=\"number\" /><text value=\") =&gt;\" /><text value=\" seconds / \" /><text value=\"3600\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getConvertedHours());\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"27\" endIndex=\"34\" /><option startIndex=\"24\" endIndex=\"25\" /><option startIndex=\"37\" endIndex=\"38\" /><option startIndex=\"43\" endIndex=\"50\" /><option correct=\"false\"><content><text value=\"=&gt;\" /></content></option><option correct=\"false\"><content><text value=\"minutes\" /></content></option><option correct=\"false\"><content><text value=\"3600\" /></content></option></options></interaction></interactions><output><content><text value=\"0\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>=</code>, następnie <code>seconds</code>, <code>0</code> i na końcu <code>seconds</code>.</p></body></html>",
