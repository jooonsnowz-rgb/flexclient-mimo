            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dowiedzmy się, jak wyświetlać w konsoli różne rodzaje wartości za pomocą przydatnej funkcji znanej jako sformatowane ciągi znaków.</p></body></html>",
            "hardModeSelected": true
