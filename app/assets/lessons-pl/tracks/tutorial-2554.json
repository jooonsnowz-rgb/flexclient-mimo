            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zwróć wartość z tej funkcji.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"func\" class=\"keyword\" /><text value=\" \" /><text value=\"giveMeTen\" class=\"title\" /><text value=\"()\" class=\"params\" /><text value=\" -&gt; \" /><text value=\"Int\" class=\"type\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" \" /><text value=\"10\" class=\"number\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(giveMeTen())\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"20\" endIndex=\"23\" /><option startIndex=\"27\" endIndex=\"33\" /><option startIndex=\"34\" endIndex=\"36\" /><option correct=\"false\"><content><text value=\"String\" /></content></option></options></interaction></interactions><output><content><text value=\"10\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>Int</code>, następnie <code>return</code> i na końcu <code>10</code>.</p></body></html>"
