            "id": 146718,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Upewnij się, że ta pętla while powtarza swój blok kodu, gdy <code>isPaused</code> jest równe <code>true</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"false\" /></content></option><option startIndex=\"37\" endIndex=\"40\" /><option startIndex=\"41\" endIndex=\"45\" /></options></interaction></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" isPaused = \" /><text value=\"true\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" (isPaused === \" /><text value=\"true\" class=\"literal\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Game is paused&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" isPaused = \" /><text value=\"false\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>===</code>, a następnie <code>true</code>.</p></body></html>"
