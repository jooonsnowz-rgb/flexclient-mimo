            "id": 146706,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wyświetl <code>Level up, Silvia</code> w konsoli, dodając <code>\" Silvia\"</code> do wartości zmiennej <code>message</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"--\" /></content></option><option startIndex=\"27\" endIndex=\"34\" /><option startIndex=\"35\" endIndex=\"37\" /><option startIndex=\"38\" endIndex=\"47\" /><option startIndex=\"47\" endIndex=\"48\" /></options></interaction></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" message = \" /><text value=\"&quot;Level up,&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"message += \" /><text value=\"&quot; Silvia&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(message);\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>message</code>, następnie <code>+=</code>, a potem <code>\" Silvia\"</code>, <code>;</code>.</p></body></html>"
          },
