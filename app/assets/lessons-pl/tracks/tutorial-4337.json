            "id": 146701,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Odejmij jeden od wartości zmiennej <code>playerLives</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"+\" /></content></option><option startIndex=\"109\" endIndex=\"120\" /><option startIndex=\"121\" endIndex=\"122\" /><option startIndex=\"123\" endIndex=\"124\" /></options></interaction></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" playerLives = \" /><text value=\"2\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"playerLives = playerLives - \" /><text value=\"1\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Lives left: &quot;\" class=\"string\" /><text value=\" + playerLives);\" /><text type=\"break\" /><text value=\"playerLives = playerLives - \" /><text value=\"1\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Lives left: &quot;\" class=\"string\" /><text value=\" + playerLives);\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Game over!&quot;\" class=\"string\" /><text value=\");\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>playerLives</code>, następnie <code>-</code> i na końcu <code>1</code>.</p></body></html>"
          },
