            "id": 146705,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Odejmij 50 od wartości zmiennej.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"--\" /></content></option><option correct=\"false\"><content><text value=\"+=\" /></content></option><option startIndex=\"23\" endIndex=\"25\" /></options></interaction></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" coins = \" /><text value=\"231\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"coins -= \" /><text value=\"50\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(coins);\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>-=</code>.</p></body></html>"
