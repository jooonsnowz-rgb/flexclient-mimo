          {
            "title": "Example: Commas",
            "id": 91167,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zakoduj <code>athlete</code> i <code>time</code>, rozdzielając je przecinkiem <code>,</code>, aby uzyskać tabelę wszystkich zawodników oraz czas, w jakim ukończyli bieg.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE race (&#xA; athlete varchar(255),&#xA; country varchar(255),&#xA; time varchar(255)&#xA;);&#xA;&#xA;INSERT INTO race (athlete, country, time)&#xA;VALUES ('Vivian Cheruiyot', 'Kenya', '14:26');&#xA;&#xA;INSERT INTO race (athlete, country, time)&#xA;VALUES ('Hellen Onsando Obiri', 'Kenya', '14:29');&#xA;&#xA;INSERT INTO race (athlete, country, time)&#xA;VALUES ('Almaz Ayana', 'Ethiopia', '14:33');&#xA;\"><tables><table name=\"race\"><row><header content=\"athlete\" /><header content=\"country\" /><header content=\"time\" /></row><row><data content=\"Vivian Cheruiyot\" /><data content=\"Kenya\" /><data content=\"14:26\" /></row><row><data content=\"Hellen Onsando Obiri\" /><data content=\"Kenya\" /><data content=\"14:29\" /></row><row><data content=\"Almaz Ayana\" /><data content=\"Ethiopia\" /><data content=\"14:33\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" athlete, \" /><text value=\"time\" class=\"built_in\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" race;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"7\" endIndex=\"20\" /></interactions><output><table name=\"Result\"><row><header content=\"athlete\" /><header content=\"time\" /></row><row><data content=\"Vivian Cheruiyot\" /><data content=\"14:26\" /></row><row><data content=\"Hellen Onsando Obiri\" /><data content=\"14:29\" /></row><row><data content=\"Almaz Ayana\" /><data content=\"14:33\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>athlete, time</code>.</p></body></html>"
          },
          {
            "title": "Question: Selecting with duplicates",
            "id": 91172,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Ile wartości <code>Wii</code> znajdzie się w wyniku tego zapytania?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE games (&#xA; game varchar(255),&#xA; platform varchar(255),&#xA; year int&#xA;);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('Super Mario', 'NES', 1985);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('Mario Kart', 'Wii', 2008);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('Just Dance', 'Wii', 2009);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('FIFA 16', 'PS4', 2015);&#xA;\"><tables><table name=\"games\"><row><header content=\"game\" /><header content=\"platform\" /><header content=\"year\" /></row><row><data content=\"Super Mario\" /><data content=\"NES\" /><data content=\"1985\" /></row><row><data content=\"Mario Kart\" /><data content=\"Wii\" /><data content=\"2008\" /></row><row><data content=\"Just Dance\" /><data content=\"Wii\" /><data content=\"2009\" /></row><row><data content=\"FIFA 16\" /><data content=\"PS4\" /><data content=\"2015\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" platform\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" games;\" /></content><output><table name=\"Result\"><row><header content=\"platform\" /></row><row><data content=\"NES\" /></row><row><data content=\"Wii\" /></row><row><data content=\"Wii\" /></row><row><data content=\"PS4\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Dwie, ponieważ kolumna <code>platform</code> zawiera dwie wartości <code>Wii</code></item><item value=\"2\" correct=\"false\">Tylko jeden, ponieważ duplikaty nie zostają wybrane</item><item value=\"3\" correct=\"false\">Brak wartości <code>Wii</code></item></selection><p visible-if=\"wrong\">Dwie, ponieważ kolumna <code>platform</code> zawiera dwie wartości <code>Wii</code>.</p></body></html>"
          },
          {
            "title": "Example: Select all columns",
            "id": 91164,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Napisz zapytanie, które wybiera wszystkie kolumny z tabeli <code>cereals</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE cereals (&#xA;name varchar(255),&#xA;fiber int,&#xA;sugar int&#xA;);&#xA;&#xA;INSERT INTO cereals (name, fiber, sugar)&#xA;VALUES ('Cheerios', 2, 1);&#xA;&#xA;INSERT INTO cereals (name, fiber, sugar)&#xA;VALUES ('Lucky Charms', 0, 12);&#xA;&#xA;INSERT INTO cereals (name, fiber, sugar)&#xA;VALUES ('Cocoa Puffs', 0, 13);&#xA;&#xA;INSERT INTO cereals (name, fiber, sugar)&#xA;VALUES ('100% Bran', 10, 6);&#xA;\"><tables><table name=\"cereals\"><row><header content=\"name\" /><header content=\"fiber\" /><header content=\"sugar\" /></row><row><data content=\"Cheerios\" /><data content=\"2\" /><data content=\"1\" /></row><row><data content=\"Lucky Charms\" /><data content=\"0\" /><data content=\"12\" /></row><row><data content=\"Cocoa Puffs\" /><data content=\"0\" /><data content=\"13\" /></row><row><data content=\"100% Bran\" /><data content=\"10\" /><data content=\"6\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" cereals;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"8\" /><option startIndex=\"9\" endIndex=\"13\" /><option startIndex=\"14\" endIndex=\"21\" /><option startIndex=\"21\" endIndex=\"22\" /><option correct=\"false\"><content><text value=\".\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"fiber\" /><header content=\"sugar\" /></row><row><data content=\"Cheerios\" /><data content=\"2\" /><data content=\"1\" /></row><row><data content=\"Lucky Charms\" /><data content=\"0\" /><data content=\"12\" /></row><row><data content=\"Cocoa Puffs\" /><data content=\"0\" /><data content=\"13\" /></row><row><data content=\"100% Bran\" /><data content=\"10\" /><data content=\"6\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>SELECT</code>, następnie <code>*</code>, a potem <code>FROM</code>, <code>cereals</code>, <code>;</code>.</p></body></html>"
          },
          {
            "title": "Question: Select *",
            "id": 91165,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jaka jest różnica między tymi dwoma zapytaniami?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE race (&#xA; athlete varchar(255),&#xA; country varchar(255),&#xA; time varchar(255)&#xA;);&#xA;&#xA;INSERT INTO race (athlete, country, time)&#xA;VALUES ('Vivian Cheruiyot', 'Kenya', '14:26');&#xA;&#xA;INSERT INTO race (athlete, country, time)&#xA;VALUES ('Hellen Onsando Obiri', 'Kenya', '14:29');&#xA;&#xA;INSERT INTO race (athlete, country, time)&#xA;VALUES ('Almaz Ayana', 'Ethiopia', '14:33');&#xA;\"><tables><table name=\"race\"><row><header content=\"athlete\" /><header content=\"country\" /><header content=\"time\" /></row><row><data content=\"Vivian Cheruiyot\" /><data content=\"Kenya\" /><data content=\"14:26\" /></row><row><data content=\"Hellen Onsando Obiri\" /><data content=\"Kenya\" /><data content=\"14:29\" /></row><row><data content=\"Almaz Ayana\" /><data content=\"Ethiopia\" /><data content=\"14:33\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" race;\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" athlete, country, \" /><text value=\"time\" class=\"built_in\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" race;\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Nie ma różnicy, oba zapytania wybierają wszystkie kolumny z tabeli <code>race</code></item><item value=\"2\" correct=\"false\">Pierwsze zapytanie niczego nie wybiera, natomiast drugie wybiera wszystkie kolumny</item><item value=\"3\" correct=\"false\">W pierwszym zapytaniu brakuje instrukcji <code>SELECT</code></item></selection><p visible-if=\"wrong\">Nie ma różnicy, oba zapytania wybierają wszystkie kolumny z tabeli <code>race</code>.</p></body></html>"
          },
          {
            "title": "Example: Distinct",
            "id": 91174,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Napisz <code>SELECT</code>, a następnie <code>DISTINCT</code> i kolumnę <code>platform</code>, aby wybrać tylko unikalne wartości <code>platform</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE games (&#xA; game varchar(255),&#xA; platform varchar(255),&#xA; year int&#xA;);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('Super Mario', 'NES', 1985);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('Mario Kart', 'Wii', 2008);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('Just Dance', 'Wii', 2009);&#xA;&#xA;INSERT INTO games (game, platform, year)&#xA;VALUES ('FIFA 16', 'PS4', 2015);&#xA;\"><tables><table name=\"games\"><row><header content=\"game\" /><header content=\"platform\" /><header content=\"year\" /></row><row><data content=\"Super Mario\" /><data content=\"NES\" /><data content=\"1985\" /></row><row><data content=\"Mario Kart\" /><data content=\"Wii\" /><data content=\"2008\" /></row><row><data content=\"Just Dance\" /><data content=\"Wii\" /><data content=\"2009\" /></row><row><data content=\"FIFA 16\" /><data content=\"PS4\" /><data content=\"2015\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"DISTINCT\" class=\"keyword\" /><text value=\" platform\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" games;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"0\" endIndex=\"24\" /></interactions><output><table name=\"Result\"><row><header content=\"platform\" /></row><row><data content=\"NES\" /></row><row><data content=\"Wii\" /></row><row><data content=\"PS4\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>SELECT DISTINCT platform</code>.</p></body></html>"
          },
          {
            "title": "Question: Ascending by default ",
            "id": 91780,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Które zapytanie sortuje elementy rosnąco według ich <code>score</code>?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" score;\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" score \" /><text value=\"ASC\" class=\"keyword\" /><text value=\";\" /><text type=\"break\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Oba</item><item value=\"2\" correct=\"false\">Pierwszy</item><item value=\"3\" correct=\"false\">Druga</item></selection><p visible-if=\"wrong\">Koniecznie wybierz Oba.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Uczniowie mają wyniki <code>90</code>, <code>40</code> i <code>70</code>. Które pokazane zapytanie zwraca je w kolejności <code>40</code>, <code>70</code>, <code>90</code>?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" score;\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" score \" /><text value=\"ASC\" class=\"keyword\" /><text value=\";\" /><text type=\"break\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Oba</item><item value=\"2\" correct=\"false\">Pierwszy</item><item value=\"3\" correct=\"false\">Druga</item><item value=\"4\" correct=\"false\">Żadne z nich, ponieważ kolejność rosnąca zawsze wymaga <code>ASCENDING</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz Oba.</p></body></html>"
          },
          {
            "title": "Example: Order by ",
            "id": 91776,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zmień kolejność elementów w tabeli <code>students</code> na podstawie ich <code>score</code> za pomocą <code>ORDER BY score</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; score int&#xA;);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Jean Miller', 5);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Emma Brown', 8);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Reese Jones', 2);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Kim Lee', 9);&#xA;\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"score\" /></row><row><data content=\"Jean Miller\" /><data content=\"5\" /></row><row><data content=\"Emma Brown\" /><data content=\"8\" /></row><row><data content=\"Reese Jones\" /><data content=\"2\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" score;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"23\" endIndex=\"37\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"score\" /></row><row><data content=\"Reese Jones\" /><data content=\"2\" /></row><row><data content=\"Jean Miller\" /><data content=\"5\" /></row><row><data content=\"Emma Brown\" /><data content=\"8\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>ORDER BY score</code>.</p></body></html>"
          },
          {
            "title": "Question: Alphabetical order",
            "id": 91778,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jakie wartości pojawiają się jako pierwsze, gdy sortujemy według właściwości tekstowej?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Najpierw znajdują się wartości z literami z początku alfabetu</item><item value=\"2\" correct=\"false\">Nie możemy tego wiedzieć, sortowanie według właściwości tekstowych daje losowe wyniki</item><item value=\"3\" correct=\"false\">Nie możemy sortować według właściwości tekstowych</item></selection><p visible-if=\"wrong\">Najpierw znajdują się wartości z literami z początku alfabetu.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Właściwość tekstowa zawiera wartości <code>\"Zoe\"</code>, <code>\"Ava\"</code> i <code>\"Mia\"</code>. Która wartość pojawi się jako pierwsza po posortowaniu rosnąco?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>\"Ava\"</code>, ponieważ jej pierwsza litera występuje najwcześniej w alfabecie</item><item value=\"2\" correct=\"false\"><code>\"Zoe\"</code>, ponieważ wartości tekstowe są porządkowane od końca alfabetu</item><item value=\"3\" correct=\"false\"><code>\"Mia\"</code>, ponieważ środkowa wartość pozostaje pierwsza</item><item value=\"4\" correct=\"false\">Żadna, ponieważ właściwości tekstowych nie można porządkować</item></selection><p visible-if=\"wrong\"><code>\"Ava\"</code>, ponieważ jej pierwsza litera występuje najwcześniej w alfabecie.</p></body></html>"
          },
          {
            "title": "Question: Descending order",
            "id": 91781,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jak to zapytanie porządkuje elementy?<br /></p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" score \" /><text value=\"DESC\" class=\"keyword\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">W kolejności malejącej</item><item value=\"2\" correct=\"false\">Rosnąco</item><item value=\"3\" correct=\"false\">Ta sama kolejność, ponieważ <code>DESC</code> nie jest prawidłowym słowem kluczowym</item></selection><p visible-if=\"wrong\">W kolejności malejącej.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Uczniowie mają wyniki <code>42</code>, <code>95</code> i <code>70</code>. W jakiej kolejności zwróci je zapytanie?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" score \" /><text value=\"DESC\" class=\"keyword\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>95</code>, <code>70</code>, <code>42</code></item><item value=\"2\" correct=\"false\"><code>42</code>, <code>70</code>, <code>95</code></item><item value=\"3\" correct=\"false\"><code>42</code>, <code>95</code>, <code>70</code>, ponieważ <code>DESC</code> zachowuje kolejność przechowywania</item><item value=\"4\" correct=\"false\">Żadnych wierszy, ponieważ <code>DESC</code> odfiltrowuje niższe wyniki</item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>95</code>, <code>70</code>, <code>42</code>.</p></body></html>"
          },
          {
            "title": "Example: Descending order",
            "id": 91784,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zakoduj słowo kluczowe, aby element z wartością <code>name</code><code>Reese Jones</code> znalazł się jako pierwszy.<br /></p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; score int&#xA;);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Jean Miller', 5);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Emma Brown', 8);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Reese Jones', 2);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Kim Lee', 9);&#xA;\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"score\" /></row><row><data content=\"Jean Miller\" /><data content=\"5\" /></row><row><data content=\"Emma Brown\" /><data content=\"8\" /></row><row><data content=\"Reese Jones\" /><data content=\"2\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"ORDER\" class=\"keyword\" /><text value=\" \" /><text value=\"BY\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"DESC\" class=\"keyword\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"37\" endIndex=\"41\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"score\" /></row><row><data content=\"Reese Jones\" /><data content=\"2\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row><row><data content=\"Jean Miller\" /><data content=\"5\" /></row><row><data content=\"Emma Brown\" /><data content=\"8\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>DESC</code>.</p></body></html>"
          },
          {
            "title": "Question: The `=` operator 2",
            "id": 91793,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jakiego rodzaju elementy filtruje to zapytanie?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" books\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" title = \" /><text value=\"'The Prince'\" class=\"string\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Elementy książek, których właściwość <code>title</code> jest równa <code>'The Prince'</code></item><item value=\"2\" correct=\"false\">Elementy książek, których właściwość <code>title</code> różni się od <code>'The Prince'</code></item><item value=\"3\" correct=\"false\">Elementy książek, w których wszystkie właściwości są równe <code>'The Prince'</code></item></selection><p visible-if=\"wrong\">Elementy książek, których właściwość <code>title</code> jest równa <code>'The Prince'</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Tabela zawiera dwie książki o tytule <code>'The Prince'</code> i jedną o tytule <code>'The Little Prince'</code>. Które wiersze zwróci zapytanie?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" books\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" title = \" /><text value=\"'The Prince'\" class=\"string\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Oba wiersze, w których właściwość <code>title</code> ma wartość <code>'The Prince'</code></item><item value=\"2\" correct=\"false\">Tylko wiersz o tytule <code>'The Little Prince'</code></item><item value=\"3\" correct=\"false\">Wszystkie trzy wiersze, ponieważ <code>SELECT *</code> ignoruje filtr</item><item value=\"4\" correct=\"false\">Tylko pierwszy pasujący wiersz, ponieważ <code>WHERE</code> zatrzymuje się po znalezieniu jednego dopasowania</item></selection><p visible-if=\"wrong\">Oba wiersze, w których właściwość <code>title</code> ma wartość <code>'The Prince'</code>.</p></body></html>"
          },
          {
            "title": "Example: WHERE",
            "id": 91791,
            "contentType": "interactive",
            "images": [],
