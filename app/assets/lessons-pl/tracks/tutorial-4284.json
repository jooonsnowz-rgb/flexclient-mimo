            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Atrybut <code>placeholder</code> podpowiada, co gracz powinien wpisać w polu.</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><interactions><interaction type=\"validatedInput\" startIndex=\"60\" endIndex=\"71\" isDefault=\"true\" /></interactions><content><text value=\"&lt;!doctype html&gt;\" class=\"meta\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"h4\" class=\"name\" /><text value=\"&gt;\" /><text value=\"New Game\" /><text value=\"&lt;/\" /><text value=\"h4\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"input\" class=\"name\" /><text value=\" \" /><text value=\"placeholder\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;Hero name&quot;\" class=\"string\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"br\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"input\" class=\"name\" /><text value=\" \" /><text value=\"placeholder\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;Guild&quot;\" class=\"string\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;/\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;/\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Koniecznie wpisz <code>placeholder</code>.</p></body></html>"
          },
