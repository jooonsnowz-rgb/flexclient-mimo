          {
            "title": "Distinguish request parameters",
            "id": 152315,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>To żądanie dotyczy członka <code>2</code> z zespołu <code>5</code> i filtruje aktywnych członków. Jaki adres URL wysyła?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"import\" class=\"keyword\" /><text value=\" requests\" /><text type=\"break\" /><text type=\"break\" /><text value=\"url = \" /><text value=\"&quot;https://things.mimo.dev/api/teams/5/members/2&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"filters = {\" /><text value=\"&quot;active&quot;\" class=\"string\" /><text value=\": \" /><text value=\"&quot;true&quot;\" class=\"string\" /><text value=\"}\" /><text type=\"break\" /><text value=\"response = requests.get(url, params=filters)\" /></content></code><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>https://things.mimo.dev/api/teams/5/members/2?active=true</code></item><item value=\"2\" correct=\"false\"><code>https://things.mimo.dev/api/teams?teamId=5&amp;memberId=2&amp;active=true</code></item><item value=\"3\" correct=\"false\"><code>https://things.mimo.dev/api/teams/5/members/2/active/true</code></item><item value=\"4\" correct=\"false\"><code>https://things.mimo.dev/api/teams/2/members/5?active=true</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>https://things.mimo.dev/api/teams/5/members/2?active=true</code>.</p></body></html>"
