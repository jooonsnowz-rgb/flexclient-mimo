            "hardModeContent": "<!DOCTYPE html ><html><body><p>Podziel <code>sales</code> na listę, aby konsola pokazała <code>['24K', '29K', '7K']</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"sales = \" /><text value=\"&quot;24K 29K 7K&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"sales_list = sales.split()\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(sales_list)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"40\" endIndex=\"41\" /><option startIndex=\"41\" endIndex=\"46\" /><option startIndex=\"35\" endIndex=\"40\" /><option correct=\"false\"><content><text value=\"sales_list\" /></content></option><option correct=\"false\"><content><text value=\"&quot;sales&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"['24K', '29K', '7K']\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>sales</code>, następnie <code>.</code> i na końcu <code>split</code>.</p></body></html>",
