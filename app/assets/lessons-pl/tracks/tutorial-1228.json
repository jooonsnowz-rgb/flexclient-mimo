            "interactiveContent": "<!DOCTYPE html ><html><body><p>Podczas pracy z różnymi rodzajami danych często otrzymujemy je w <br />formacie, z którym trudno pracować.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"new_users = \" /><text value=\"&quot;Ann Jon Alex&quot;\" class=\"string\" /></content></code></body></html>",
            "hardModeSelected": true
