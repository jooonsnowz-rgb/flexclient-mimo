            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Ponieważ nie możemy wyświetlać w konsoli nieskończonej liczby komunikatów <code>and again</code>, kod powoduje awarię programu.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"while\" class=\"keyword\" /><text value=\" \" /><text value=\"true\" class=\"literal\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;and again&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"}\" /></content><output><content><text value=\"and again\" /><text type=\"break\" /><text value=\"and again\" /><text type=\"break\" /><text value=\"and again\" /><text type=\"break\" /><text value=\"...\" /><text type=\"break\" /><text value=\"// program crashes\" /></content></output></code></body></html>"
