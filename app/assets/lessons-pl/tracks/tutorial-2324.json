            "interactiveContent": "<!DOCTYPE html ><html><body><p>Czym są indeksy?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Numerowane pozycje elementów na listach</item><item value=\"2\" correct=\"false\">Wartości elementów na listach</item><item value=\"3\" correct=\"false\">Elementy list</item></selection><p visible-if=\"wrong\">Numerowane pozycje elementów na listach.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Indeksy to numerowane pozycje elementów na liście.</p><p>Lista wyników zawiera <code>[90, 85, 78]</code>. Czym jest <code>85</code> na tej liście?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Wartością przechowywaną pod indeksem</item><item value=\"2\" correct=\"false\">Samym indeksem</item><item value=\"3\" correct=\"false\">Liczbą elementów na liście</item></selection><p visible-if=\"wrong\">Wartością przechowywaną pod indeksem.</p></body></html>",
            "hardModeSelected": true
