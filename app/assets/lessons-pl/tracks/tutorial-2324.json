            "id": 79516,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Uzyskaj dostęp do zmiennej <code>third</code> na liście za pomocą jej indeksu <code>2</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"first = \" /><text value=\"&quot;John&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"second = \" /><text value=\"&quot;Joseph&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"third = \" /><text value=\"&quot;Donnie&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"winners = [first, second, third]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(winners[\" /><text value=\"2\" class=\"number\" /><text value=\"])\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"98\" endIndex=\"99\" /></interactions><output><content><text value=\"Donnie\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>2</code>.</p></body></html>"
