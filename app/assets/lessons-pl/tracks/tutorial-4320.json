            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jakie określenie opisuje sposób, w jaki duszki i elementy interfejsu użytkownika są domyślnie rozmieszczane, zanim przeniesiesz je za pomocą CSS?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Przepływ normalny</item><item value=\"2\" correct=\"false\">Przepływ</item><item value=\"3\" correct=\"false\">Podstawowy przepływ</item></selection><p visible-if=\"wrong\">Przepływ normalny.</p></body></html>"
