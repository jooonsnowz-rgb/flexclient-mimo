            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jaka metoda JavaScript wykonuje kod asynchronicznie?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>setInterval()</code></item><item value=\"2\" correct=\"false\"><code>.filter()</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>setInterval()</code>.</p></body></html>"
