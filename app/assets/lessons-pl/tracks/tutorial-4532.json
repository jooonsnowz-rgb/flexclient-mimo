            "interactiveContent": "<!DOCTYPE html ><html><body><p>Które stwierdzenie dotyczące metody <code>setTimeout()</code> jest prawdziwe?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">To asynchroniczna metoda JavaScript</item><item value=\"2\" correct=\"false\">To synchroniczna metoda JavaScript</item></selection><p visible-if=\"wrong\">To asynchroniczna metoda JavaScript.</p></body></html>"
          },
