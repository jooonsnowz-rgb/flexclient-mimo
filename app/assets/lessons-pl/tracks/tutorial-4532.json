            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kiedy wykonywana jest funkcja zwrotna <code>setTimeout()</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Po upływie czasu ustawionego przez parametr <code>delay</code></item><item value=\"2\" correct=\"false\">Zanim upłynie czas ustawiony przez parametr <code>delay</code></item></selection><p visible-if=\"wrong\">Po upływie czasu ustawionego przez parametr <code>delay</code>.</p></body></html>"
