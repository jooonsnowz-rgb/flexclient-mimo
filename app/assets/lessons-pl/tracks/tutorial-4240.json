            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wybierz znacznik otwierający, który sprawia, że link można kliknąć.</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"&lt;a&gt;\" /></content></option><option startIndex=\"0\" endIndex=\"35\" /></options></interaction></interactions><content><text value=\"&lt;\" /><text value=\"a\" class=\"name\" /><text value=\" \" /><text value=\"href\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;https://example.com/wiki&quot;\" class=\"string\" /><text value=\"&gt;\" /><text value=\"Game Wiki\" /><text value=\"&lt;/\" /><text value=\"a\" class=\"name\" /><text value=\"&gt;\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>&lt;a href=\"https://example.com/wiki\"&gt;</code>.</p></body></html>"
          },
          {
