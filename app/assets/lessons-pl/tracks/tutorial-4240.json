            "interactiveContent": "<!DOCTYPE html ><html><body><p>Do czego służą <code>attributes</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Aby dostarczać dodatkowe informacje o znacznikach</item><item value=\"2\" correct=\"false\">Aby zamienić wszystkie znaczniki w przeciwników</item></selection><p visible-if=\"wrong\">Aby dostarczać dodatkowe informacje o znacznikach.</p></body></html>"
