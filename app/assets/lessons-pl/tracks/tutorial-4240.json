            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co robią odnośniki?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Połącz strony gry z innymi stronami i witrynami</item><item value=\"2\" correct=\"false\">Zwiększ zdrowie gracza</item></selection><p visible-if=\"wrong\">Połącz strony gry z innymi stronami i witrynami.</p></body></html>"
