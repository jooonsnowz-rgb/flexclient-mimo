            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Ustaw atrybuty <code>height</code> i <code>width</code> tak, aby wysokość była większa niż szerokość.</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"src\" /></content></option><option correct=\"false\"><content><text value=\"href\" /></content></option><option startIndex=\"39\" endIndex=\"44\" /><option startIndex=\"51\" endIndex=\"56\" /></options></interaction></interactions><content><text value=\"&lt;\" /><text value=\"img\" class=\"name\" /><text value=\" \" /><text value=\"src\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;/img/boss-sprite.png&quot;\" class=\"string\" /><text value=\" \" /><text value=\"height\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;300&quot;\" class=\"string\" /><text value=\" \" /><text value=\"width\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;220&quot;\" class=\"string\" /><text value=\"&gt;\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>\"300\"</code>, a następnie <code>\"220\"</code>.</p></body></html>"
