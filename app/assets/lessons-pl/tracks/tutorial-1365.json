            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dodaj wartość do zbioru <code>wishlist</code>, tak aby zbiór pozostał niezmieniony.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"wishlist = {\" /><text value=\"&quot;earpods&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;notebook&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;handgloves&quot;\" class=\"string\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"wishlist.add(\" /><text value=\"&quot;notebook&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"63\" endIndex=\"73\" /><option correct=\"false\"><content><text value=\"&quot;watch&quot;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>\"notebook\"</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Dodaj wartość do zbioru <code>wishlist</code> tak, aby jego rozmiar pozostał równy <code>3</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"wishlist\" /><text value=\" \" /><text value=\"=\" /><text value=\" \" /><text value=\"{\" /><text value=\"&quot;earpods&quot;\" class=\"string\" /><text value=\",\" /><text value=\" \" /><text value=\"&quot;notebook&quot;\" class=\"string\" /><text value=\",\" /><text value=\" \" /><text value=\"&quot;handgloves&quot;\" class=\"string\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"wishlist\" /><text value=\".\" /><text value=\"add\" /><text value=\"(\" /><text value=\"&quot;notebook&quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"63\" endIndex=\"73\" /><option correct=\"false\"><content><text value=\"&quot;watch&quot;\" /></content></option><option correct=\"false\"><content><text value=\"&quot;charger&quot;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>\"notebook\"</code>.</p></body></html>",
