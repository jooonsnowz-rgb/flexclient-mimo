            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Który fragment kodu poprawnie tworzy instancję klasy <code>Cat</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>let fluffy = Cat()</code></item><item value=\"4\" correct=\"false\"><code>let fluffy = VirtualPet()</code></item></selection><p visible-if=\"wrong\"><code>let fluffy = Cat()</code>.</p></body></html>"
