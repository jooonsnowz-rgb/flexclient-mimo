          {
            "title": "Code: Counter variable",
            "id": 73130,
            "contentType": "executableFiles",
            "images": [],
            "executableContent": {
              "instructions": "Utwórz zmienną licznika o nazwie `number` i przypisz jej wartość `-5`.",
              "preselectedFileIndex": 0,
              "hasVisualOutput": false,
              "files": [
                {
                  "name": "script.js",
                  "codeLanguage": "javascript",
                  "content": "while (number < 5) {\n console.log(number);\n number++;\n}",
                  "solvedContent": "let number = -5;\nwhile (number < 5) {\n console.log(number);\n number++;\n}"
                }
              ],
              "hints": []
            }
          },
          {
            "title": "Code: Condition",
            "id": 73131,
            "contentType": "executableFiles",
            "images": [],
            "executableContent": {
              "instructions": "Pozostawiając resztę kodu bez zmian, zmień warunek, aby zapobiec nieskończonej pętli. Pętla powinna wykonać się co najmniej raz.",
              "preselectedFileIndex": 0,
              "hasVisualOutput": false,
              "files": [
                {
                  "name": "script.js",
                  "codeLanguage": "javascript",
                  "content": "let number = 0;\nwhile (number >= 0) {\n console.log(number);\n number++;\n}",
                  "solvedContent": "let number = 0;\nwhile (number <= 5) {\n console.log(number);\n number++;\n}"
                }
              ],
              "hints": []
            }
          },
          {
            "title": "Code: Changing the condition",
            "id": 73136,
            "contentType": "executableFiles",
            "images": [],
            "executableContent": {
              "instructions": "Wyświetl w konsoli liczby od `10` do `40` (z przyrostem o 10), zmieniając warunek.",
              "preselectedFileIndex": 0,
              "hasVisualOutput": false,
              "files": [
                {
                  "name": "script.js",
                  "codeLanguage": "javascript",
                  "content": "let counter = 10;\nwhile (counter < 40) {\n console.log(counter);\n counter += 10;\n}",
                  "solvedContent": "let counter = 10;\nwhile (counter <= 40) {\n console.log(counter);\n counter += 10;\n}"
                }
              ],
              "hints": []
            }
          },
          {
