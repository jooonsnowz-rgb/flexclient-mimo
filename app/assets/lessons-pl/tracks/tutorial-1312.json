          {
            "title": "Example: Global scope 1",
            "id": 87045,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Utwórz <code>rent</code> poza funkcją, aby miał zakres globalny.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"rent = \" /><text value=\"1000\" class=\"number\" /><text type=\"break\" /><text type=\"break\" /><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"calculate_spendings\" class=\"title\" /><text value=\"(groceries)\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"f&quot;Total: \" /><text value=\"{rent + groceries}\" class=\"subst\" /><text value=\"&quot;\" /><text value=\")\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(\" /><text value=\"f&quot;Rent: \" /><text value=\"{rent}\" class=\"subst\" /><text value=\"&quot;\" /><text value=\")\" /><text type=\"break\" /><text value=\"calculate_spendings(\" /><text value=\"300\" class=\"number\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"4\" /><option startIndex=\"5\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"11\" /></options></interaction></interactions><output><content><text value=\"Rent: 1000\" /><text type=\"break\" /><text value=\"Total: 1300\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>rent</code>, następnie <code>=</code> i na końcu <code>1000</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Utwórz <code>rent</code> poza funkcją, aby funkcja i zewnętrzny print mogły ją odczytać. Ustaw ją na <code>1000</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"rent = \" /><text value=\"1000\" class=\"number\" /><text type=\"break\" /><text type=\"break\" /><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"calculate_spendings\" class=\"title\" /><text value=\"(groceries)\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"f&quot;Total: \" /><text value=\"{rent + groceries}\" class=\"subst\" /><text value=\"&quot;\" /><text value=\")\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(\" /><text value=\"f&quot;Rent: \" /><text value=\"{rent}\" class=\"subst\" /><text value=\"&quot;\" /><text value=\")\" /><text type=\"break\" /><text value=\"calculate_spendings(\" /><text value=\"300\" class=\"number\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"4\" /><option startIndex=\"5\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"11\" /><option correct=\"false\"><content><text value=\"groceries\" /></content></option><option correct=\"false\"><content><text value=\"100\" /></content></option><option correct=\"false\"><content><text value=\"==\" /></content></option></options></interaction></interactions><output><content><text value=\"Rent: 1000\" /><text type=\"break\" /><text value=\"Total: 1300\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>rent</code>, następnie <code>=</code> i na końcu <code>1000</code>.</p></body></html>",
            "hardModeSelected": true
