            "interactiveContent": "<!DOCTYPE html ><html><body><p>Uzupełnij poniższy kod, aby przeliczyć kilogramy na funty.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" pounds = conversion.kgToLb(\" /><text value=\"5\" class=\"number\" /><text value=\"); \" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(pounds);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"15\" endIndex=\"25\" /><option startIndex=\"26\" endIndex=\"32\" /><option correct=\"false\"><content><text value=\"conversion.js\" /></content></option></options></interaction></interactions><output><content><text value=\"11\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>conversion</code>, a następnie <code>kgToLb</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Użyj metody biblioteki konwertującej kilogramy na funty, aby przekształcić <code>5</code> w pokazany wynik.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" pounds = conversion.kgToLb(\" /><text value=\"5\" class=\"number\" /><text value=\"); \" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(pounds);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"15\" endIndex=\"25\" /><option startIndex=\"26\" endIndex=\"32\" /><option correct=\"false\"><content><text value=\"conversion.js\" /></content></option><option correct=\"false\"><content><text value=\"lbToKg\" /></content></option><option correct=\"false\"><content><text value=\"convert\" /></content></option></options></interaction></interactions><output><content><text value=\"11\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>conversion</code>, a następnie <code>kgToLb</code>.</p></body></html>",
