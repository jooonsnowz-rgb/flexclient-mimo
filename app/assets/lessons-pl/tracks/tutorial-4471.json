        "lessons": [
          {
            "title": "Lesson #1",
            "id": 148835,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Czego używamy do połączenia zmiennej <code>playerName</code> z literałem tekstowym?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Składnia <code>${playerName}</code></item><item value=\"2\" correct=\"false\">Składnia <code>$(playerName)</code></item><item value=\"3\" correct=\"false\">Składnia <code>$[playerName]</code></item></selection><p visible-if=\"wrong\">Składnia <code>${playerName}</code>.</p></body></html>"
          },
          {
            "title": "Lesson #2",
            "id": 148836,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co jest nie tak z poniższym kodem?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"const\" class=\"keyword\" /><text value=\" coins = \" /><text value=\"20\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" gems = \" /><text value=\"10\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" scoreText = \" /><text value=\"`Score : $(coins + gems)`\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(scoreText);\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Składnia <code>$()</code> powinna mieć nawiasy klamrowe <code>{}</code></item><item value=\"2\" correct=\"false\">Składnia <code>$()</code> powinna mieć nawiasy <code>[]</code></item><item value=\"3\" correct=\"false\">Nie ma w tym nic złego</item></selection><p visible-if=\"wrong\">Składnia <code>$()</code> powinna mieć nawiasy klamrowe <code>{}</code>.</p></body></html>"
          },
          {
            "title": "Lesson #3",
            "id": 148837,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Połącz literał tekstowy <code>dungeon</code> wewnątrz zmiennej <code>levelName</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"(\" /></content></option><option correct=\"false\"><content><text value=\")\" /></content></option><option startIndex=\"44\" endIndex=\"45\" /><option startIndex=\"45\" endIndex=\"46\" /><option startIndex=\"46\" endIndex=\"51\" /><option startIndex=\"51\" endIndex=\"52\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" level = \" /><text value=\"`dungeon`\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" levelName = \" /><text value=\"`\" /><text value=\"${level}\" class=\"subst\" /><text value=\" level`\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(levelName);\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>$</code>, następnie <code>{</code>, a potem <code>level</code>, <code>}</code>.</p></body></html>"
          },
          {
            "title": "Lesson #4",
            "id": 148838,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kod wyświetlający łączny wynik gracza.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"(\" /></content></option><option correct=\"false\"><content><text value=\")\" /></content></option><option startIndex=\"72\" endIndex=\"73\" /><option startIndex=\"73\" endIndex=\"74\" /><option startIndex=\"84\" endIndex=\"85\" /><option startIndex=\"96\" endIndex=\"97\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" baseScore = \" /><text value=\"32100\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" bonusScore = \" /><text value=\"450\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" score = \" /><text value=\"`Score : \" /><text value=\"${baseScore + bonusScore}\" class=\"subst\" /><text value=\"`\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(score);\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>$</code>, następnie <code>{</code>, a potem <code>+</code>, <code>}</code>.</p></body></html>"
          },
          {
            "title": "Lesson #5",
            "id": 148839,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wywołaj funkcję <code>getPlayerTitle</code> i przekaż literał tekstowy <code>Mage</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"&quot;Mage&quot;\" /></content></option><option correct=\"false\"><content><text value=\"'Mage'\" /></content></option><option startIndex=\"115\" endIndex=\"129\" /><option startIndex=\"129\" endIndex=\"135\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" getPlayerTitle = \" /><text value=\"role\" class=\"params\" /><text value=\" =&gt;\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" title = \" /><text value=\"`Champion`\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" \" /><text value=\"`\" /><text value=\"${role}\" class=\"subst\" /><text value=\"'s title is \" /><text value=\"${title}\" class=\"subst\" /><text value=\".`\" /><text value=\";\" /><text type=\"break\" /><text value=\"};\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getPlayerTitle\" /><text value=\"`Mage`\" class=\"string\" /><text value=\");\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>getPlayerTitle</code>, a następnie <code>`Mage`</code>.</p></body></html>"
          },
          {
            "title": "Lesson #6",
            "id": 148840,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Czy <code>\"Dragon\"</code> jest jednym z elementów destrukturyzowanych z tej tablicy?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"const\" class=\"keyword\" /><text value=\" [firstEnemy, secondEnemy, thirdEnemy, fourthEnemy, fifthEnemy,\" /><text type=\"break\" /><text value=\" sixthEnemy\" /><text type=\"break\" /><text value=\"] = [\" /><text value=\"&quot;Slime&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Goblin&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Orc&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Skeleton&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Bat&quot;\" class=\"string\" /><text value=\",\" /><text type=\"break\" /><text value=\" \" /><text value=\"&quot;Wolf&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Dragon&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(firstEnemy);\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(secondEnemy);\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(thirdEnemy);\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(fourthEnemy);\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(fifthEnemy);\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(sixthEnemy);\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Nie</item><item value=\"2\" correct=\"false\">Tak</item></selection><p visible-if=\"wrong\">Koniecznie wybierz Nie.</p></body></html>"
          },
          {
            "title": "Lesson #7",
            "id": 148841,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co wyświetli <code>console.log(defaultWeapon)</code>?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"const\" class=\"keyword\" /><text value=\" [playerId, playerName, defaultWeapon = \" /><text value=\"'Sword'\" class=\"string\" /><text value=\"] = [\" /><text value=\"'0015'\" class=\"string\" /><text value=\",\" /><text type=\"break\" /><text value=\" \" /><text value=\"'Ben Anderson'\" class=\"string\" /><text value=\", \" /><text value=\"'Bow'\" class=\"string\" /><text type=\"break\" /><text value=\"];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(playerId);\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(playerName);\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(defaultWeapon);\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Ukłon</item><item value=\"2\" correct=\"false\">Miecz</item></selection><p visible-if=\"wrong\">Koniecznie wybierz Ukłon.</p></body></html>"
          },
          {
            "title": "Lesson #8",
            "id": 148842,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wydobądź dwa pierwsze elementy tej tablicy i umieść pozostałe elementy w zmiennej <code>otherItems</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"30\" endIndex=\"43\" isDefault=\"true\" /></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" [firstItem, secondItem, ...otherItems] = [\" /><text value=\"&quot;Potion&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Shield&quot;\" class=\"string\" /><text value=\",\" /><text type=\"break\" /><text value=\" \" /><text value=\"&quot;Key&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Map&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Gem&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Arrow&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Scroll&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Torch&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(firstItem);\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(secondItem);\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(otherItems);}\" /></content></code><p visible-if=\"wrong\">Koniecznie wpisz <code>...otherItems</code>.</p></body></html>"
          },
          {
            "title": "Lesson #9",
            "id": 148843,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dokonaj destrukturyzacji obiektu <code>player</code> i dodaj obie zmienne do <code>console.log</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"60\" endIndex=\"69\" /><option startIndex=\"72\" endIndex=\"78\" /><option startIndex=\"117\" endIndex=\"126\" /><option startIndex=\"141\" endIndex=\"147\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" player = {\" /><text type=\"break\" /><text value=\" \" /><text value=\"className\" class=\"attr\" /><text value=\": \" /><text value=\"'Mage'\" class=\"string\" /><text value=\",\" /><text type=\"break\" /><text value=\" \" /><text value=\"health\" class=\"attr\" /><text value=\": \" /><text value=\"3\" class=\"number\" /><text type=\"break\" /><text value=\"};\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" {\" /><text type=\"break\" /><text value=\" className,\" /><text type=\"break\" /><text value=\" health,\" /><text type=\"break\" /><text value=\"} = player;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"`Hi! I'm a \" /><text value=\"${className}\" class=\"subst\" /><text value=\" and I have \" /><text value=\"${health}\" class=\"subst\" /><text value=\" HP.`\" /><text value=\");\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>className</code>, następnie <code>health</code>, a potem <code>className</code>, <code>health</code>.</p></body></html>"
          },
          {
            "title": "Lesson #10",
            "id": 148844,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jakie właściwości zawiera obiekt <code>favoriteLoadout</code>?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"const\" class=\"keyword\" /><text value=\" playerProfile = {\" /><text type=\"break\" /><text value=\" \" /><text value=\"id\" class=\"attr\" /><text value=\": \" /><text value=\"144\" class=\"number\" /><text value=\",\" /><text type=\"break\" /><text value=\" \" /><text value=\"name\" class=\"attr\" /><text value=\": \" /><text value=\"'kori Jackson'\" class=\"string\" /><text value=\",\" /><text type=\"break\" /><text value=\" \" /><text value=\"favoriteWeapon\" class=\"attr\" /><text value=\": \" /><text value=\"'Bow'\" class=\"string\" /><text value=\",\" /><text type=\"break\" /><text value=\" \" /><text value=\"favoriteSpell\" class=\"attr\" /><text value=\": \" /><text value=\"'Fireball'\" class=\"string\" /><text value=\",\" /><text type=\"break\" /><text value=\" \" /><text value=\"favoriteLevel\" class=\"attr\" /><text value=\": \" /><text value=\"'Dungeon'\" class=\"string\" /><text type=\"break\" /><text value=\"};\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" {\" /><text type=\"break\" /><text value=\" id,\" /><text type=\"break\" /><text value=\" name,\" /><text type=\"break\" /><text value=\" ...favoriteLoadout\" /><text type=\"break\" /><text value=\"} = playerProfile;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(id);\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(name);\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(favoriteLoadout);\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>favoriteWeapon</code>, <code>favoriteSpell</code>, <code>favoriteLevel</code></item><item value=\"2\" correct=\"false\"><code>id</code>, <code>name</code></item></selection><p visible-if=\"wrong\"><code>favoriteWeapon</code>, <code>favoriteSpell</code>, <code>favoriteLevel</code>.</p></body></html>"
          }
        ]
