            "interactiveContent": "<!DOCTYPE html ><html><body><p>Upewnij się, że pętla zatrzymuje się, gdy <code>count</code> osiągnie <code>3</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"count = \" /><text value=\"0\" class=\"number\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" count &lt; \" /><text value=\"5\" class=\"number\" /><text value=\":\" /><text type=\"break\" /><text value=\"  \" /><text value=\"if\" class=\"keyword\" /><text value=\" count == \" /><text value=\"3\" class=\"number\" /><text value=\":\" /><text type=\"break\" /><text value=\"    \" /><text value=\"break\" class=\"keyword\" /><text type=\"break\" /><text value=\"  print(count)\" /><text type=\"break\" /><text value=\"  count = count + \" /><text value=\"1\" class=\"number\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"48\" endIndex=\"53\" /><option correct=\"false\"><content><text value=\"continue\" /></content></option><option correct=\"false\"><content><text value=\"else\" /></content></option></options></interaction></interactions><output><content><text value=\"0\" /><text type=\"break\" /><text value=\"1\" /><text type=\"break\" /><text value=\"2\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>break</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Spraw, aby pętla wyświetliła tylko <code>0</code>, <code>1</code> i <code>2</code>, a następnie całkowicie się zakończyła.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"count = \" /><text value=\"0\" class=\"number\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" count &lt; \" /><text value=\"5\" class=\"number\" /><text value=\":\" /><text type=\"break\" /><text value=\"  \" /><text value=\"if\" class=\"keyword\" /><text value=\" count == \" /><text value=\"3\" class=\"number\" /><text value=\":\" /><text type=\"break\" /><text value=\"    \" /><text value=\"break\" class=\"keyword\" /><text type=\"break\" /><text value=\"  print(count)\" /><text type=\"break\" /><text value=\"  count = count + \" /><text value=\"1\" class=\"number\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"38\" endIndex=\"40\" /><option startIndex=\"41\" endIndex=\"42\" /><option startIndex=\"48\" endIndex=\"53\" /><option correct=\"false\"><content><text value=\"!=\" /></content></option><option correct=\"false\"><content><text value=\"4\" /></content></option><option correct=\"false\"><content><text value=\"continue\" /></content></option></options></interaction></interactions><output><content><text value=\"0\" /><text type=\"break\" /><text value=\"1\" /><text type=\"break\" /><text value=\"2\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>==</code>, następnie <code>3</code> i na końcu <code>break</code>.</p></body></html>",
