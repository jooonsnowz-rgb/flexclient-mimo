            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Upewnij się, że pętla nie wyświetla <code>3</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"count = \" /><text value=\"0\" class=\"number\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" count &lt; \" /><text value=\"5\" class=\"number\" /><text value=\":\" /><text type=\"break\" /><text value=\"  \" /><text value=\"if\" class=\"keyword\" /><text value=\" count == \" /><text value=\"3\" class=\"number\" /><text value=\":\" /><text type=\"break\" /><text value=\"    count = count + \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text value=\"    \" /><text value=\"continue\" class=\"keyword\" /><text type=\"break\" /><text value=\"  print(count)\" /><text type=\"break\" /><text value=\"  count = count + \" /><text value=\"1\" class=\"number\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"70\" endIndex=\"78\" /><option correct=\"false\"><content><text value=\"break\" /></content></option><option correct=\"false\"><content><text value=\"else\" /></content></option></options></interaction></interactions><output><content><text value=\"0\" /><text type=\"break\" /><text value=\"1\" /><text type=\"break\" /><text value=\"2\" /><text type=\"break\" /><text value=\"4\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>continue</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Uzupełnij logikę pomijania tak, aby pętla wyświetliła <code>0</code>, <code>1</code>, <code>2</code> i <code>4</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"count = \" /><text value=\"0\" class=\"number\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" count &lt; \" /><text value=\"5\" class=\"number\" /><text value=\":\" /><text type=\"break\" /><text value=\"  \" /><text value=\"if\" class=\"keyword\" /><text value=\" count == \" /><text value=\"3\" class=\"number\" /><text value=\":\" /><text type=\"break\" /><text value=\"    count = count + \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text value=\"    \" /><text value=\"continue\" class=\"keyword\" /><text type=\"break\" /><text value=\"  print(count)\" /><text type=\"break\" /><text value=\"  count = count + \" /><text value=\"1\" class=\"number\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"41\" endIndex=\"42\" /><option startIndex=\"70\" endIndex=\"78\" /><option correct=\"false\"><content><text value=\"4\" /></content></option><option correct=\"false\"><content><text value=\"break\" /></content></option><option correct=\"false\"><content><text value=\"else\" /></content></option></options></interaction></interactions><output><content><text value=\"0\" /><text type=\"break\" /><text value=\"1\" /><text type=\"break\" /><text value=\"2\" /><text type=\"break\" /><text value=\"4\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>3</code>, a następnie <code>continue</code>.</p></body></html>",
