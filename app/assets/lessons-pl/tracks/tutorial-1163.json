            "id": 79925,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Do czego służy dwukropek <code>:</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Oznaczają początek bloku kodu funkcji</item><item value=\"2\" correct=\"false\">Wskazuje, który kod funkcja powinna pominąć</item></selection><p visible-if=\"wrong\">Oznaczają początek bloku kodu funkcji.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Dwukropek <code>:</code> oznacza początek bloku kodu funkcji.</p><p>Który nagłówek poprawnie rozpoczyna funkcję <code>greet</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>def greet():</code></item><item value=\"2\" correct=\"false\"><code>def greet()</code></item><item value=\"3\" correct=\"false\"><code>def greet(:)</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>def greet():</code>.</p></body></html>",
            "hardModeSelected": true
