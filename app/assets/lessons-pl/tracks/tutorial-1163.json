            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jak nazywamy funkcję?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Używając notacji snake case</item><item value=\"2\" correct=\"false\">Przez umieszczenie spacji w nazwie funkcji</item></selection><p visible-if=\"wrong\">Używając notacji snake case.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Do nazywania funkcji używamy notacji snake case.</p><p>Która nazwa jest zgodna z tym stylem dla funkcji wyświetlającej sumę?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>display_total</code></item><item value=\"2\" correct=\"false\"><code>display total</code></item><item value=\"3\" correct=\"false\"><code>DisplayTotal</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>display_total</code>.</p></body></html>"
          },
          {
