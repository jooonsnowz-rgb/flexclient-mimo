            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zakoduj przecinek <code>,</code>, aby oddzielić dwa parametry.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"add_prefix\" class=\"title\" /><text value=\"(prefix, word)\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\"  \" /><text value=\"return\" class=\"keyword\" /><text value=\" prefix + word\" /><text type=\"break\" /><text type=\"break\" /><text value=\"new_word = add_prefix(\" /><text value=\"&quot;re&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;do&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"print(new_word)\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"21\" endIndex=\"22\" /></interactions><output><content><text value=\"redo\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>,</code>.</p></body></html>"
