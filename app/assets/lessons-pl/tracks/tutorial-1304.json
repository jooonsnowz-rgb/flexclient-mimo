            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jaki znak oddziela parametry funkcji?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>,</code></item><item value=\"2\" correct=\"false\"><code>;</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>,</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Funkcja potrzebuje parametrów <code>first</code> i <code>second</code>. Który nagłówek prawidłowo je rozdziela?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>def show(first, second):</code></item><item value=\"2\" correct=\"false\"><code>def show(first; second):</code></item><item value=\"3\" correct=\"false\"><code>def show(first second):</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>def show(first, second):</code>.</p></body></html>"
          },
          {
