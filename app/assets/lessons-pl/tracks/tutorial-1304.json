            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dodaj drugi parametr do tej funkcji.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"create_email\" class=\"title\" /><text value=\"(name, year)\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\"  \" /><text value=\"return\" class=\"keyword\" /><text value=\" name + year + \" /><text value=\"&quot;@hutmail.com&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"email = create_email(\" /><text value=\"&quot;jo&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;1998&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"print(email)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"23\" endIndex=\"27\" /><option correct=\"false\"><content><text value=\"&quot;1998&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"jo1998@hutmail.com\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>year</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Dodaj tej funkcji dwa parametry, aby mogła utworzyć adres e-mail i wyświetlić <code>jo1998@hutmail.com</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"create_email\" class=\"title\" /><text value=\"(name, year)\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\"  \" /><text value=\"return\" class=\"keyword\" /><text value=\" name + year + \" /><text value=\"&quot;@hutmail.com&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"email = create_email(\" /><text value=\"&quot;jo&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;1998&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"print(email)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"17\" endIndex=\"21\" /><option startIndex=\"23\" endIndex=\"27\" /><option correct=\"false\"><content><text value=\"&quot;jo&quot;\" /></content></option><option correct=\"false\"><content><text value=\"&quot;1998&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"jo1998@hutmail.com\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>name</code>, a następnie <code>year</code>.</p></body></html>"
