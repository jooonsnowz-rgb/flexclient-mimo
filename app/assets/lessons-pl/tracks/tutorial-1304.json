            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Ile parametrów może mieć funkcja?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Tak wiele, ile chcemy</item><item value=\"3\" correct=\"false\">Co najwyżej trzy</item></selection><p visible-if=\"wrong\">Tak wiele, ile chcemy.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Funkcja ma już trzy parametry, ale potrzebuje teraz czwartej wartości. Co możesz zrobić?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Dodać czwarty parametr do definicji.</item><item value=\"2\" correct=\"false\">Pozostawić trzy, ponieważ Python dopuszcza najwyżej trzy parametry.</item><item value=\"3\" correct=\"false\">Zastąpić jeden z istniejących parametrów, ponieważ ich liczba nie może wzrosnąć.</item></selection><p visible-if=\"wrong\">Dodać czwarty parametr do definicji.</p></body></html>"
          },
          {
