            "title": "Introduction",
            "id": 86509,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Funkcje potrzebują <strong>wielu parametrów</strong>, aby wykonywać zadania na większej liczbie danych, takich jak imię i nazwisko nowego gracza.</p><webview version=\"2\" visible-if=\"always\" content=\"&lt;!doctype html&gt;&#xA;&lt;html&gt;&#xA; &lt;head&gt;&#xA;  &lt;style&gt;&#xA;   body {&#xA;    text-align: center;&#xA;    height: 350px;&#xA;    font-size: 16px;&#xA;    margin: 0 auto;&#xA;    background-color: #F0F8FF&#xA;   }&#xA;   button {&#xA;    width: 200px;&#xA;    height: 30px;&#xA;    font-size: 20px;&#xA;    border-radius: 5px;&#xA;    margin: 0 auto;&#xA;    display: block;&#xA;    color: black;&#xA;    outline: none;&#xA;   }&#xA;   input {&#xA;    border-radius: 5px;&#xA;    padding: 10px;&#xA;    margin: 10px;&#xA;    outline: none;&#xA;   }&#xA;   h2 {&#xA;    text-align: center;&#xA;   }&#xA;   #playerList {&#xA;    text-align: left;&#xA;   }&#xA;  &lt;/style&gt;&#xA; &lt;/head&gt;&#xA; &lt;body id=&quot;main&quot;&gt;&#xA;  &lt;h1&gt;Add Team Players&lt;/h1&gt;&#xA;  &lt;div class=&quot;Signup&quot;&gt;&#xA;   &lt;div class=&quot;playerInput&quot;&gt; &#xA;    &lt;input id=&quot;firstNameInput&quot; type=&quot;text&quot; placeholder=&quot;First Name&quot;&gt;&#xA;    &lt;input id=&quot;surnameInput&quot; type=&quot;text&quot; placeholder=&quot;Last Name&quot;&gt;&#xA;   &lt;/div&gt; &#xA;   &lt;button onClick=&quot;add()&quot;&gt;Submit&lt;/button&gt;&#xA;   &lt;h3&gt;Current Team&lt;/h3&gt;&#xA;  &lt;/div&gt;&#xA;  &lt;ul id=playerList&gt; &lt;/ul&gt;&#xA;  &lt;p id=&quot;full&quot;&gt;&lt;/p&gt;&#xA;  &lt;script&gt;&#xA;   let number = 0;&#xA;   function add() {&#xA;    if (number &gt;= 3) {&#xA;     document.getElementById(&quot;full&quot;).innerHTML = &quot;Team Full&quot;;&#xA;    } else {&#xA;     const firstName = document.getElementById(&quot;firstNameInput&quot;).value;&#xA;     const surname = document.getElementById(&quot;surnameInput&quot;).value;&#xA;     const node = document.createElement(&quot;P&quot;);&#xA;     const textnode = document.createTextNode(&quot;Added: &quot; + firstName +&#xA;      &quot; &quot; + surname);&#xA;     node.appendChild(textnode);&#xA;     document.getElementById(&quot;playerList&quot;).appendChild(node);&#xA;     number++;&#xA;     document.getElementById(&quot;firstNameInput&quot;).value = &quot;&quot;;&#xA;     document.getElementById(&quot;surnameInput&quot;).value = &quot;&quot;;&#xA;    }&#xA;   }&#xA;  &lt;/script&gt;&#xA; &lt;/body&gt;&#xA;&lt;/html&gt;\" /></body></html>",
            "hardModeSelected": true
