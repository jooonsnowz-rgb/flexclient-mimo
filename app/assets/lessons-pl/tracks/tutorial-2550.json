            "title": "Length 2",
            "id": 127048,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wypróbuj to samodzielnie: zacznij od nazwy tablicy, dodaj kropkę <code>.</code>, a następnie <code>count</code>.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" tasks = [\" /><text value=\"&quot;dishes&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;windows&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;vacuum&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(tasks.\" /><text value=\"count\" class=\"built_in\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"items\" /></content></option><option startIndex=\"50\" endIndex=\"55\" /><option startIndex=\"55\" endIndex=\"56\" /><option startIndex=\"56\" endIndex=\"61\" /></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>tasks</code>, następnie <code>.</code> i na końcu <code>count</code>.</p></body></html>"
