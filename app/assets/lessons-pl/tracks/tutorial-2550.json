          {
            "title": "Array length",
            "id": 127047,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Używamy właściwości <code>count</code> po nazwie tablicy i kropce <code>.</code>, aby uzyskać liczbę elementów w tablicy.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" tasks = [\" /><text value=\"&quot;dishes&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;windows&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;vacuum&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(tasks.\" /><text value=\"count\" class=\"built_in\" /><text value=\")\" /></content><output><content><text value=\"3\" /></content></output></code></body></html>"
          },
