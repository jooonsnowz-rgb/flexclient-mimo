            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pomiń blok kodu pętli while, ustawiając warunek na <code>false</code>.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Let's go!&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" \" /><text value=\"false\" class=\"literal\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Repeat after me:&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;I love to code!&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;That's all!&quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"25\" endIndex=\"30\" /></interactions><output><content><text value=\"Let's go!\" /><text type=\"break\" /><text value=\"That's all!\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>false</code>.</p></body></html>"
