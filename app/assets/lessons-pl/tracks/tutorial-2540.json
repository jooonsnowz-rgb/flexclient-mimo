            "title": "Example: Why self-assigning matters",
            "id": 126886,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Odejmij jeden od wartości zmiennej <code>lives</code>.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"var\" class=\"keyword\" /><text value=\" lives = \" /><text value=\"2\" class=\"number\" /><text type=\"break\" /><text value=\"lives = lives - \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Lives left: \\(lives)&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"lives = lives - \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Lives left: \\(lives)&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Game over!&quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"70\" endIndex=\"75\" /><option startIndex=\"76\" endIndex=\"77\" /><option startIndex=\"78\" endIndex=\"79\" /><option correct=\"false\"><content><text value=\"+\" /></content></option></options></interaction></interactions><output><content><text value=\"Lives left: 1\" /><text type=\"break\" /><text value=\"Lives left: 0\" /><text type=\"break\" /><text value=\"Game over!\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>lives</code>, następnie <code>-</code> i na końcu <code>1</code>.</p></body></html>"
          },
