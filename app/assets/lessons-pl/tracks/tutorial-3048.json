            "interactiveContent": "<!DOCTYPE html ><html><body><p>HTML pozwala nam również dodawać obrazy do strony internetowej.</p><webview version=\"2\" visible-if=\"always\" content=\"&lt;!doctype html&gt;&#xA;&lt;html&gt;&#xA; &lt;head&gt;&#xA;  &lt;link rel=&quot;stylesheet&quot; href=&quot;style.css&quot;&gt;&#xA;  &lt;style&gt;&#xA;   body {&#xA;    text-align: center;&#xA;   }&#xA;   &#xA;   img {&#xA;    border: solid gray 10px;&#xA;    margin: 10px;&#xA;    padding: 5px;&#xA;   }&#xA;   &#xA;   h2 {&#xA;    width: 250px;&#xA;    margin: auto;&#xA;   }&#xA;  &lt;/style&gt;&#xA; &lt;/head&gt;&#xA; &lt;body&gt;&#xA;  &lt;h2&gt;Photography competition winner&lt;/h2&gt; &lt;br&gt; &lt;img&#xA;   style=&quot;width: 200px;&quot; src=&quot;https://mimo.app/i/fox.png&quot;&gt;&#xA; &lt;/body&gt;&#xA;&lt;/html&gt;\" /></body></html>"
