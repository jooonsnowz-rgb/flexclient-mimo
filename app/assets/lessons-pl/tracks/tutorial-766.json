            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Odejmij jeden od wartości zmiennej <code>cards</code>, a następnie dodaj cztery.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" cards = \" /><text value=\"3\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"cards = cards - \" /><text value=\"1\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"cards = cards + \" /><text value=\"4\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(cards);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"29\" endIndex=\"30\" /><option startIndex=\"31\" endIndex=\"32\" /><option startIndex=\"48\" endIndex=\"49\" /><option startIndex=\"50\" endIndex=\"51\" /></options></interaction></interactions><output><content><text value=\"6\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>-</code>, następnie <code>1</code>, a potem <code>+</code>, <code>4</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Odejmij jeden od wartości zmiennej <code>cards</code>, a następnie dodaj cztery, aby w konsoli pojawiło się <code>6</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" cards = \" /><text value=\"3\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"cards = cards - \" /><text value=\"1\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"cards = cards + \" /><text value=\"4\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(cards);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"29\" endIndex=\"30\" /><option startIndex=\"31\" endIndex=\"32\" /><option startIndex=\"48\" endIndex=\"49\" /><option startIndex=\"50\" endIndex=\"51\" /><option correct=\"false\"><content><text value=\"*\" /></content></option><option correct=\"false\"><content><text value=\"2\" /></content></option><option correct=\"false\"><content><text value=\"3\" /></content></option></options></interaction></interactions><output><content><text value=\"6\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>-</code>, następnie <code>1</code>, <code>+</code> i na końcu <code>4</code>.</p></body></html>",
