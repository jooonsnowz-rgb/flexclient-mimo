            "interactiveContent": "<!DOCTYPE html ><html><body><p>Połącz listę napisów <code>members</code> z listą liczb <code>scores</code>, tak aby członkowie znajdowali się na początku.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"members = [\" /><text value=\"&quot;Ana&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Joe&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Kim&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text value=\"scores = [\" /><text value=\"57\" class=\"number\" /><text value=\", \" /><text value=\"60\" class=\"number\" /><text value=\", \" /><text value=\"32\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(members + scores)\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"61\" endIndex=\"77\" /></interactions><output><content><text value=\"['Ana', 'Joe', 'Kim', 57, 60, 32]\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>members + scores</code>.</p></body></html>"
