            "id": 78304,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jak nazywa się kod z wcięciem po <code>False:</code>?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"while\" class=\"keyword\" /><text value=\" \" /><text value=\"False\" class=\"literal\" /><text value=\": \" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"&quot;Echo&quot;\" class=\"string\" /><text value=\")\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Blok kodu</item><item value=\"2\" correct=\"false\">Warunek</item></selection><p visible-if=\"wrong\">Blok kodu.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Co zrobiłby blok kodu z wcięciem po zmianie <code>False</code> na <code>True</code>?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"while\" class=\"keyword\" /><text value=\" \" /><text value=\"False\" class=\"literal\" /><text value=\": \" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"&quot;Echo&quot;\" class=\"string\" /><text value=\")\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Wielokrotnie wyświetlałby <code>Echo</code>.</item><item value=\"2\" correct=\"false\">Wyświetliłby <code>Echo</code> raz, a potem by się zatrzymał.</item><item value=\"3\" correct=\"false\">Nadal pomijałby <code>print(\"Echo\")</code>.</item></selection><p visible-if=\"wrong\">Wielokrotnie wyświetlałby <code>Echo</code>.</p></body></html>",
