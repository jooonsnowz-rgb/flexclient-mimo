            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co wyświetla ten kod w konsoli?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"10\" class=\"number\" /><text value=\" &gt;= \" /><text value=\"10\" class=\"number\" /><text value=\");\" /></content><output><content><text value=\"true\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>true</code></item><item value=\"2\" correct=\"false\"><code>false</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>true</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Obie wartości w tym porównaniu są równe. Co wyświetli kod?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"10\" class=\"number\" /><text value=\" &gt;= \" /><text value=\"10\" class=\"number\" /><text value=\");\" /></content><output><content><text value=\"true\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>true</code></item><item value=\"2\" correct=\"false\"><code>false</code></item><item value=\"3\" correct=\"false\"><code>10</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>true</code>.</p></body></html>"
          },
          {
            "title": "Example 1",
            "id": 62861,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Sprawdź, czy <code>batteryLevel</code> jest mniejsze lub równe <code>20</code>, używając operatora mniejszości lub równości, <code>&lt;=</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" batteryLevel = \" /><text value=\"10\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" low = batteryLevel &lt;= \" /><text value=\"20\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Low battery: &quot;\" class=\"string\" /><text value=\" + low);\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"50\" endIndex=\"52\" /></interactions><output><content><text value=\"Low battery: true\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>&lt;=</code>.</p></body></html>"
