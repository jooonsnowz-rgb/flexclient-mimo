            "interactiveContent": "<!DOCTYPE html ><html><body><p>Spraw, aby ten kod wyświetlał w konsoli wartość <code>true</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"10\" class=\"number\" /><text value=\" &gt; \" /><text value=\"9\" class=\"number\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"15\" endIndex=\"16\" /><option correct=\"false\"><content><text value=\"&lt;\" /></content></option></options></interaction></interactions><output><content><text value=\"true\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>&gt;</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Spraw, aby ten kod wyświetlał w konsoli wartość <code>true</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"10\" class=\"number\" /><text value=\" &gt; \" /><text value=\"9\" class=\"number\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"15\" endIndex=\"16\" /><option correct=\"false\"><content><text value=\"&lt;\" /></content></option><option correct=\"false\"><content><text value=\"===\" /></content></option><option correct=\"false\"><content><text value=\"=\" /></content></option></options></interaction></interactions><output><content><text value=\"true\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>&gt;</code>.</p></body></html>"
