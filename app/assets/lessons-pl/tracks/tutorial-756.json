            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jakiego operatora używamy, aby sprawdzić, czy liczba po lewej stronie instrukcji jest równa <code>21</code> lub większa?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>&gt;=</code></item><item value=\"2\" correct=\"false\"><code>&lt;=</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>&gt;=</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Gracz przechodzi dalej z co najmniej <code>21</code> punktami. Który operator uzupełnia wyrażenie <code>points ? 21</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>&gt;=</code></item><item value=\"2\" correct=\"false\"><code>&lt;=</code></item><item value=\"3\" correct=\"false\"><code>&gt;</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>&gt;=</code>.</p></body></html>"
