            "id": 62858,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co robi operator większe niż lub równe, <code>&gt;=</code>?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">Sprawdza, czy jedna liczba jest większa od innej lub jej równa</item><item correct=\"false\" value=\"2\">Sprawdza, czy jedna liczba jest większa od innej liczby</item></selection><p visible-if=\"wrong\">Sprawdza, czy jedna liczba jest większa od innej lub jej równa.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Jeśli zmienna <code>score</code> ma dokładnie wartość <code>10</code>, jaki wynik da wyrażenie <code>score &gt;= 10</code>?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>true</code></item><item value=\"2\" correct=\"false\"><code>false</code></item><item value=\"3\" correct=\"false\">To zależy od tego, czy <code>score</code> jest zmienną.</item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>true</code>.</p></body></html>"
