          {
            "title": "Within a range",
            "id": 91465,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Możemy użyć warunku, aby wybrać elementy, których właściwość mieści się w określonym zakresie, na przykład filmy z oceną <code>rating</code> między <code>9</code> a <code>10</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE movies (&#xA;title varchar(255),&#xA;rating numeric (1,1)&#xA;);&#xA;&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Godfather', 9.2);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Matrix', 8.7);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('La Strada', 8);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Dark Knight', 9);\"><tables><table name=\"movies\"><row><header content=\"title\" /><header content=\"rating\" /></row><row><data content=\"The Godfather\" /><data content=\"9.2\" /></row><row><data content=\"The Matrix\" /><data content=\"8.7\" /></row><row><data content=\"La Strada\" /><data content=\"8\" /></row><row><data content=\"The Dark Knight\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" movies\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" rating \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"9\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"10\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"21\" endIndex=\"50\" /><option correct=\"false\"><content><text value=\"WHERE rating BETWEEN 10 AND 20\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"title\" /><header content=\"rating\" /></row><row><data content=\"The Godfather\" /><data content=\"9.2\" /></row><row><data content=\"The Dark Knight\" /><data content=\"9\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>WHERE rating BETWEEN 9 AND 10</code>.</p></body></html>"
          },
          {
            "title": "Condition",
            "id": 91467,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Podczas zapisywania warunku zaczynamy od kolumny, której wartości sprawdzamy, tak jak tutaj <code>rating</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE movies (&#xA;title varchar(255),&#xA;rating numeric (1,1)&#xA;);&#xA;&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Godfather', 9.2);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Matrix', 8.7);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('La Strada', 8);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Dark Knight', 9);\"><tables><table name=\"movies\"><row><header content=\"title\" /><header content=\"rating\" /></row><row><data content=\"The Godfather\" /><data content=\"9.2\" /></row><row><data content=\"The Matrix\" /><data content=\"8.7\" /></row><row><data content=\"La Strada\" /><data content=\"8\" /></row><row><data content=\"The Dark Knight\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" movies\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" rating \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"9\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"10\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"27\" endIndex=\"33\" /></interactions><output><table name=\"Result\"><row><header content=\"title\" /><header content=\"rating\" /></row><row><data content=\"The Godfather\" /><data content=\"9.2\" /></row><row><data content=\"The Dark Knight\" /><data content=\"9\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>rating</code>.</p></body></html>"
          },
          {
            "title": "The keyword BETWEEN",
            "id": 91469,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Aby sprawdzić, czy wartość mieści się w zakresie, używamy słowa kluczowego <code>BETWEEN</code>, po którym podajemy zakres wartości.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE movies (&#xA;title varchar(255),&#xA;rating numeric (1,1)&#xA;);&#xA;&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Godfather', 9.2);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Matrix', 8.7);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('La Strada', 8);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Dark Knight', 9);\"><tables><table name=\"movies\"><row><header content=\"title\" /><header content=\"rating\" /></row><row><data content=\"The Godfather\" /><data content=\"9.2\" /></row><row><data content=\"The Matrix\" /><data content=\"8.7\" /></row><row><data content=\"La Strada\" /><data content=\"8\" /></row><row><data content=\"The Dark Knight\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" movies\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" rating \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"9\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"10\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"34\" endIndex=\"41\" /><option startIndex=\"42\" endIndex=\"50\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"title\" /><header content=\"rating\" /></row><row><data content=\"The Godfather\" /><data content=\"9.2\" /></row><row><data content=\"The Dark Knight\" /><data content=\"9\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>BETWEEN</code>, a następnie <code>9 AND 10</code>.</p></body></html>"
          },
          {
            "title": "Defining a range",
            "id": 91470,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Ustawiamy początek zakresu, na przykład <code>9</code>, oraz koniec zakresu, na przykład <code>10</code>, oddzielone słowem kluczowym <code>AND</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE movies (&#xA;title varchar(255),&#xA;rating numeric (1,1)&#xA;);&#xA;&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Godfather', 9.2);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Matrix', 8.7);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('La Strada', 8);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Dark Knight', 9);\"><tables><table name=\"movies\"><row><header content=\"title\" /><header content=\"rating\" /></row><row><data content=\"The Godfather\" /><data content=\"9.2\" /></row><row><data content=\"The Matrix\" /><data content=\"8.7\" /></row><row><data content=\"La Strada\" /><data content=\"8\" /></row><row><data content=\"The Dark Knight\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" movies\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" rating \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"9\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"10\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"42\" endIndex=\"43\" /><option startIndex=\"44\" endIndex=\"47\" /><option startIndex=\"48\" endIndex=\"50\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"title\" /><header content=\"rating\" /></row><row><data content=\"The Godfather\" /><data content=\"9.2\" /></row><row><data content=\"The Dark Knight\" /><data content=\"9\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>9</code>, następnie <code>AND</code> i na końcu <code>10</code>.</p></body></html>"
          },
          {
            "title": "Border inclusive",
            "id": 91471,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zakresy obejmują swoje granice. W przypadku zakresu takiego jak <code>BETWEEN 8 AND 9</code> wybieramy filmy z oceną 8 i 9 oraz wszystkie pomiędzy nimi.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE movies (&#xA;title varchar(255),&#xA;rating numeric (1,1)&#xA;);&#xA;&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Godfather', 9.2);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Matrix', 8.7);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('La Strada', 8);&#xA;INSERT INTO movies (title, rating)&#xA;VALUES ('The Dark Knight', 9);\"><tables><table name=\"movies\"><row><header content=\"title\" /><header content=\"rating\" /></row><row><data content=\"The Godfather\" /><data content=\"9.2\" /></row><row><data content=\"The Matrix\" /><data content=\"8.7\" /></row><row><data content=\"La Strada\" /><data content=\"8\" /></row><row><data content=\"The Dark Knight\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" movies\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" rating \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"8\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"9\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"34\" endIndex=\"41\" /><option startIndex=\"42\" endIndex=\"43\" /><option startIndex=\"44\" endIndex=\"47\" /><option startIndex=\"48\" endIndex=\"49\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"title\" /><header content=\"rating\" /></row><row><data content=\"The Matrix\" /><data content=\"8.7\" /></row><row><data content=\"La Strada\" /><data content=\"8\" /></row><row><data content=\"The Dark Knight\" /><data content=\"9\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>BETWEEN</code>, następnie <code>8</code>, a potem <code>AND</code>, <code>9</code>.</p></body></html>"
          },
          {
            "title": "Question: Within a range",
            "id": 93205,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Który warunek sprawdza, czy właściwość <code>age</code> mieści się między dwiema liczbami, takimi jak <code>10</code> i <code>20</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>age BETWEEN 10 AND 20</code></item><item value=\"2\" correct=\"false\"><code>age &lt;= 20</code></item></selection><p visible-if=\"wrong\"><code>age BETWEEN 10 AND 20</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Użyj <code>column BETWEEN lower AND upper</code>, aby sprawdzić zakres. Obejmuje on oba końce.</p><p>Potrzebujesz pacjentów w wieku od <code>10</code> do <code>20</code> lat włącznie. Który warunek zadziała?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>age BETWEEN 10 AND 20</code></item><item value=\"2\" correct=\"false\"><code>age &lt;= 20</code></item><item value=\"3\" correct=\"false\"><code>age BETWEEN 20 AND 10</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>age BETWEEN 10 AND 20</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Question: Condition",
            "id": 93206,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co jest nie tak z tym zapytaniem?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" patients\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"10\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"20\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Po <code>WHERE</code> powinna znajdować się nazwa kolumny</item><item value=\"2\" correct=\"false\">Z zapytaniem jest wszystko w porządku</item></selection><p visible-if=\"wrong\">Po <code>WHERE</code> powinna znajdować się nazwa kolumny.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Chcesz wybrać pacjentów w wieku od <code>10</code> do <code>20</code> lat. Która zmiana sprawi, że zapytanie sprawdzi <code>age</code>?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" patients\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"10\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"20\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Dodaj <code>age</code> bezpośrednio po <code>WHERE</code></item><item value=\"2\" correct=\"false\">Zastąp <code>WHERE</code> przez <code>age</code></item><item value=\"3\" correct=\"false\">Dodaj <code>age</code> bezpośrednio po <code>AND</code></item></selection><p visible-if=\"wrong\">Dodaj <code>age</code> bezpośrednio po <code>WHERE</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Question: The keyword BETWEEN",
            "id": 93207,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jakiego słowa kluczowego używamy, aby sprawdzić, czy właściwość liczbowa mieści się w określonym zakresie?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>BETWEEN</code></item><item value=\"2\" correct=\"false\"><code>ORDER BY</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>BETWEEN</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Używasz <code>BETWEEN</code>, aby zachować tylko pacjentów w wieku od <code>10</code> do <code>20</code> lat. Która część zapytania go wymaga?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Warunek po <code>WHERE</code></item><item value=\"2\" correct=\"false\">Nazwa tabeli po <code>FROM</code></item><item value=\"3\" correct=\"false\">Kolumny wymienione po <code>SELECT</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz Warunek po <code>WHERE</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Question: Defining a range",
            "id": 93208,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jakiego słowa kluczowego używamy do zdefiniowania zakresu?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>AND</code>, jak w <code>BETWEEN 10 AND 20</code></item><item value=\"2\" correct=\"false\">Nie potrzebujemy słowa kluczowego, możemy po prostu zapisać liczby, tak jak w <code>BETWEEN 10 20</code></item></selection><p visible-if=\"wrong\"><code>AND</code>, jak w <code>BETWEEN 10 AND 20</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Masz <code>age BETWEEN 10 AND 10</code>. Zachowaj dolny koniec zakresu i rozszerz go do wieku <code>20</code>.</p><p>Która zmiana zadziała?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Zmień liczbę po <code>AND</code> na <code>20</code></item><item value=\"2\" correct=\"false\">Zmień liczbę przed <code>AND</code> na <code>20</code></item><item value=\"3\" correct=\"false\">Zastąp <code>AND</code> przez <code>OR</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz Zmień liczbę po <code>AND</code> na <code>20</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Question: Border inclusive",
            "id": 93209,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jakie wartości <code>age</code> wybierze to zapytanie?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" patients\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" age \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"30\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"60\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Wartości od <code>30</code> do <code>60</code>, włącznie z <code>30</code> i <code>60</code></item><item value=\"2\" correct=\"false\">Wartości między <code>30</code> a <code>60</code>, ale bez <code>30</code> i <code>60</code></item></selection><p visible-if=\"wrong\">Wartości od <code>30</code> do <code>60</code>, włącznie z <code>30</code> i <code>60</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Zmieniasz dolny koniec zakresu z <code>30</code> na <code>31</code>. Który wiek pasuje do pokazanego zapytania, ale nie do zmienionego?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" patients\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" age \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"30\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"60\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>30</code></item><item value=\"2\" correct=\"false\"><code>60</code></item><item value=\"3\" correct=\"false\"><code>45</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>30</code>.</p></body></html>",
            "hardModeSelected": true
