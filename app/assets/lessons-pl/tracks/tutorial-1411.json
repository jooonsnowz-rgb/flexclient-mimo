          {
            "title": "Example: Within a range",
            "id": 93282,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zakoduj warunek, aby w tabeli wyników pojawiali się tylko pacjenci z wartością <code>age</code> między <code>20</code> a <code>30</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE patients (&#xA; name varchar(255),&#xA; age int&#xA;);&#xA;&#xA;INSERT INTO patients (name, age)&#xA;VALUES ('Smith, Lily', 52);&#xA;&#xA;INSERT INTO patients (name, age)&#xA;VALUES ('Jones, Harry', 19);&#xA;&#xA;INSERT INTO patients (name, age)&#xA;VALUES ('Wilson, Liam', 60);&#xA;&#xA;INSERT INTO patients (name, age)&#xA;VALUES ('Garcia, Linda', 35);&#xA;&#xA;INSERT INTO patients (name, age)&#xA;VALUES ('Brown, Ava', 25);&#xA;\"><tables><table name=\"patients\"><row><header content=\"name\" /><header content=\"age\" /></row><row><data content=\"Smith, Lily\" /><data content=\"52\" /></row><row><data content=\"Jones, Harry\" /><data content=\"19\" /></row><row><data content=\"Wilson, Liam\" /><data content=\"60\" /></row><row><data content=\"Garcia, Linda\" /><data content=\"35\" /></row><row><data content=\"Brown, Ava\" /><data content=\"25\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" patients\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" age \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"20\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"30\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"23\" endIndex=\"28\" /><option startIndex=\"29\" endIndex=\"50\" /><option correct=\"false\"><content><text value=\"name BETWEEN 20 AND 30\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"age\" /></row><row><data content=\"Brown, Ava\" /><data content=\"25\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>WHERE</code>, a następnie <code>age BETWEEN 20 AND 30</code>.</p></body></html>"
