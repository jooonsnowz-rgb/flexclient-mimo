            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Atrybut <code>height</code> dostosowuje <strong>wysokość</strong> obrazu.</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"img\" class=\"name\" /><text value=\" \" /><text value=\"src\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;https://mimo.app/i/earth.png&quot;\" class=\"string\" /><text value=\" \" /><text value=\"width\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;200&quot;\" class=\"string\" /><text value=\" \" /><text value=\"height\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;300&quot;\" class=\"string\" /><text value=\" &gt;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"52\" endIndex=\"58\" /></interactions></code><p visible-if=\"wrong\">Koniecznie wpisz <code>height</code>.</p></body></html>"
