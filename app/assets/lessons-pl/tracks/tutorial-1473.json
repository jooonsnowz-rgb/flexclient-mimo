            "interactiveContent": "<!DOCTYPE html ><html><body><p>Użyj <code>del</code>, aby usunąć parę klucz-wartość <code>gender</code> ze słownika.<br /></p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"details = {\" /><text value=\"&quot;name&quot;\" class=\"string\" /><text value=\": \" /><text value=\"&quot;Alex&quot;\" class=\"string\" /><text value=\",\" /><text type=\"break\" /><text value=\"           \" /><text value=\"&quot;age&quot;\" class=\"string\" /><text value=\": \" /><text value=\"22\" class=\"number\" /><text value=\",\" /><text type=\"break\" /><text value=\"           \" /><text value=\"&quot;gender&quot;\" class=\"string\" /><text value=\": \" /><text value=\"&quot;Female&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"del\" class=\"keyword\" /><text value=\" details[\" /><text value=\"&quot;gender&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text value=\"print(details)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"93\" endIndex=\"94\" /><option startIndex=\"94\" endIndex=\"102\" /><option startIndex=\"102\" endIndex=\"103\" /><option correct=\"false\"><content><text value=\"del\" /></content></option></options></interaction></interactions><output><content><text value=\"{'name': 'Alex', 'age': 22}\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>[</code>, następnie <code>\"gender\"</code> i na końcu <code>]</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Za pomocą <code>del</code> usuń ze słownika parę klucz-wartość <code>\"gender\"</code>.<br/></p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"details = {\" /><text value=\"&quot;name&quot;\" class=\"string\" /><text value=\": \" /><text value=\"&quot;Alex&quot;\" class=\"string\" /><text value=\",\" /><text type=\"break\" /><text value=\"           \" /><text value=\"&quot;age&quot;\" class=\"string\" /><text value=\": \" /><text value=\"22\" class=\"number\" /><text value=\",\" /><text type=\"break\" /><text value=\"           \" /><text value=\"&quot;gender&quot;\" class=\"string\" /><text value=\": \" /><text value=\"&quot;Female&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"del\" class=\"keyword\" /><text value=\" details[\" /><text value=\"&quot;gender&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text value=\"print(details)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"93\" endIndex=\"94\" /><option startIndex=\"94\" endIndex=\"102\" /><option startIndex=\"102\" endIndex=\"103\" /><option correct=\"false\"><content><text value=\"&quot;age&quot;\" /></content></option><option correct=\"false\"><content><text value=\"del\" /></content></option></options></interaction></interactions><output><content><text value=\"{'name': 'Alex', 'age': 22}\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>[</code>, następnie <code>\"gender\"</code> i na końcu <code>]</code>.</p></body></html>"
