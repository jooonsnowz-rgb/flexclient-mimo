            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zastąp ostatni element na liście wartością <code>Paul</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"users = [\" /><text value=\"&quot;Peter&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Zaneta&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Irina&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text value=\"users[\" /><text value=\"-1\" class=\"number\" /><text value=\"] = \" /><text value=\"&quot;Paul&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"print(users)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"42\" endIndex=\"43\" /><option correct=\"false\"><content><text value=\"3\" /></content></option><option startIndex=\"43\" endIndex=\"44\" /><option startIndex=\"44\" endIndex=\"45\" /><option startIndex=\"45\" endIndex=\"46\" /></options></interaction></interactions><output><content><text value=\"['Peter', 'Zaneta', 'Paul']\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>[</code>, następnie <code>-</code>, a potem <code>1</code>, <code>]</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Za pomocą indeksu ujemnego zastąp <strong>ostatni</strong> element listy wartością <code>\"Paul\"</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"users = [\" /><text value=\"&quot;Peter&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Zaneta&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Irina&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text value=\"users[\" /><text value=\"-1\" class=\"number\" /><text value=\"] = \" /><text value=\"&quot;Paul&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"print(users)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"42\" endIndex=\"43\" /><option startIndex=\"43\" endIndex=\"44\" /><option startIndex=\"44\" endIndex=\"45\" /><option startIndex=\"45\" endIndex=\"46\" /><option correct=\"false\"><content><text value=\"3\" /></content></option></options></interaction></interactions><output><content><text value=\"['Peter', 'Zaneta', 'Paul']\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>[</code>, następnie <code>-</code>, <code>1</code> i na końcu <code>]</code>.</p></body></html>"
