    "iconBanner": null,
    "chapters": [
      {
        "id": 13209,
        "title": "AKTUALIZUJ",
        "type": "practiceLevel1",
        "lessons": [
          {
            "title": "Intro",
            "id": 118687,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Czasami musimy zaktualizować istniejące wpisy w tabeli, na przykład gdy gość musi przesunąć swoją rezerwację kolacji o 30 minut.</p><p>Przyjrzyjmy się, jak możemy to zrobić w SQLite!</p></body></html>"
          },
          {
            "title": "Intro II",
            "id": 118688,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Nie chcemy po prostu wykonać operacji <code>INSERT</code>, aby dodać nowy wpis do tabeli, ponieważ w przeciwnym razie będziemy mieć zduplikowane rezerwacje o tej samej nazwie. To mogłoby wprowadzić zamieszanie!</p><p>Usuwanie i ponowne wstawianie wpisu również nie jest eleganckie. Zamiast tego możemy użyć składni SQL <code>UPDATE</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE `Reservations` (&#xA; `id` INTEGER NOT NULL,&#xA; `name` TEXT NOT NULL,&#xA; `phonenumber` TEXT NOT NULL,&#xA; `time` TEXT NOT NULL,&#xA; `partysize` INTEGER NOT NULL,&#xA; PRIMARY KEY (`id`)&#xA;);&#xA;&#xA;&#xA;INSERT INTO `Reservations` (`id`, `name`, `phonenumber`, `time`, `partysize`) VALUES ('1', 'Powers', '+16352637463', '18:00',4);&#xA;&#xA;INSERT INTO `Reservations` (`id`, `name`, `phonenumber`, `time`, `partysize`) VALUES ('2', 'Miranda', '+17487652839', '19:00',5);&#xA;&#xA;INSERT INTO `Reservations` (`id`, `name`, `phonenumber`, `time`, `partysize`) VALUES ('3', 'Smith', '+17648373572', '18:30',3);&#xA;\"><tables><table name=\"Reservations\"><row><header content=\"id\" /><header content=\"name\" /><header content=\"phonenumber\" /><header content=\"time\" /><header content=\"partysize\" /></row><row><data content=\"1\" /><data content=\"Powers\" /><data content=\"+16352637463\" /><data content=\"18:00\" /><data content=\"4\" /></row><row><data content=\"2\" /><data content=\"Miranda\" /><data content=\"+17487652839\" /><data content=\"19:00\" /><data content=\"5\" /></row><row><data content=\"3\" /><data content=\"Smith\" /><data content=\"+17648373572\" /><data content=\"18:30\" /><data content=\"3\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" Reservations \" /><text value=\"SET\" class=\"keyword\" /><text value=\" \" /><text value=\"time\" class=\"built_in\" /><text value=\" = \" /><text value=\"'19:00'\" class=\"string\" /><text value=\" \" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" = \" /><text value=\"'Smith'\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" Reservations;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"id\" /><header content=\"name\" /><header content=\"phonenumber\" /><header content=\"time\" /><header content=\"partysize\" /></row><row><data content=\"1\" /><data content=\"Powers\" /><data content=\"+16352637463\" /><data content=\"18:00\" /><data content=\"4\" /></row><row><data content=\"2\" /><data content=\"Miranda\" /><data content=\"+17487652839\" /><data content=\"19:00\" /><data content=\"5\" /></row><row><data content=\"3\" /><data content=\"Smith\" /><data content=\"+17648373572\" /><data content=\"19:00\" /><data content=\"3\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>UPDATE</code>.</p></body></html>"
          },
          {
            "title": "Limitations",
            "id": 118690,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>UPDATE</code> nie może służyć do wstawiania nowych wpisów do tabeli. Można go używać tylko do zmieniania istniejących wpisów.</p><p>Na przykład wykonanie poniższej instrukcji <code>UPDATE</code> nie zmieni żadnych danych, ponieważ tabela nie zawiera jeszcze wiersza z wartością <code>id</code> równą 4.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE `Reservations` (&#xA; `id` INTEGER NOT NULL,&#xA; `name` TEXT NOT NULL,&#xA; `phonenumber` TEXT NOT NULL,&#xA; `time` TEXT NOT NULL,&#xA; `partysize` INTEGER NOT NULL,&#xA; PRIMARY KEY (`id`)&#xA;);&#xA;&#xA;&#xA;INSERT INTO `Reservations` (`id`, `name`, `phonenumber`, `time`, `partysize`) VALUES ('1', 'Powers', '+16352637463', '18:00',4);&#xA;&#xA;INSERT INTO `Reservations` (`id`, `name`, `phonenumber`, `time`, `partysize`) VALUES ('2', 'Miranda', '+17487652839', '19:00',5);&#xA;&#xA;INSERT INTO `Reservations` (`id`, `name`, `phonenumber`, `time`, `partysize`) VALUES ('3', 'Smith', '+17648373572', '18:30',3);&#xA;\"><tables><table name=\"Reservations\"><row><header content=\"id\" /><header content=\"name\" /><header content=\"phonenumber\" /><header content=\"time\" /><header content=\"partysize\" /></row><row><data content=\"1\" /><data content=\"Powers\" /><data content=\"+16352637463\" /><data content=\"18:00\" /><data content=\"4\" /></row><row><data content=\"2\" /><data content=\"Miranda\" /><data content=\"+17487652839\" /><data content=\"19:00\" /><data content=\"5\" /></row><row><data content=\"3\" /><data content=\"Smith\" /><data content=\"+17648373572\" /><data content=\"18:30\" /><data content=\"3\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" Reservations \" /><text value=\"SET\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" = \" /><text value=\"'Kelly'\" class=\"string\" /><text value=\" \" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"id\" class=\"keyword\" /><text value=\" = \" /><text value=\"4\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" Reservations;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"39\" endIndex=\"44\" /><option startIndex=\"45\" endIndex=\"47\" /><option startIndex=\"48\" endIndex=\"49\" /><option startIndex=\"50\" endIndex=\"51\" /><option startIndex=\"51\" endIndex=\"52\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"id\" /><header content=\"name\" /><header content=\"phonenumber\" /><header content=\"time\" /><header content=\"partysize\" /></row><row><data content=\"1\" /><data content=\"Powers\" /><data content=\"+16352637463\" /><data content=\"18:00\" /><data content=\"4\" /></row><row><data content=\"2\" /><data content=\"Miranda\" /><data content=\"+17487652839\" /><data content=\"19:00\" /><data content=\"5\" /></row><row><data content=\"3\" /><data content=\"Smith\" /><data content=\"+17648373572\" /><data content=\"18:30\" /><data content=\"3\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>WHERE</code>, następnie <code>id</code>, a potem <code>=</code>, <code>4</code>, <code>;</code>.</p></body></html>"
          },
          {
            "title": "Syntax",
            "id": 118691,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Instrukcja <code>UPDATE</code> zawsze zaczyna się od słowa kluczowego <code>UPDATE</code>, po którym następuje nazwa tabeli.</p><p>Następnie po nazwie tabeli występuje słowo kluczowe <code>SET</code> oraz wyrażenie przypisujące kolumnie określoną wartość. Zobaczmy, jak to wygląda!</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE `Directory` (&#xA; `floor` INTEGER NOT NULL,&#xA; `company` TEXT NOT NULL,&#xA; PRIMARY KEY (`floor`)&#xA;);&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (1, 'Lobby');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (2, 'Perkins Legal');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (3, '(Vacant)');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (4, 'Bright Whites Dental');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (5, 'Whiz Kid IT Support');\"><tables><table name=\"Directory\"><row><header content=\"floor\" /><header content=\"company\" /></row><row><data content=\"1\" /><data content=\"Lobby\" /></row><row><data content=\"2\" /><data content=\"Perkins Legal\" /></row><row><data content=\"3\" /><data content=\"(Vacant)\" /></row><row><data content=\"4\" /><data content=\"Bright Whites Dental\" /></row><row><data content=\"5\" /><data content=\"Whiz Kid IT Support\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" \" /><text value=\"Directory\" class=\"keyword\" /><text value=\" \" /><text value=\"SET\" class=\"keyword\" /><text value=\" company = \" /><text value=\"'Smith Tax &amp; Audit'\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" \" /><text value=\"Directory\" class=\"keyword\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"floor\" /><header content=\"company\" /></row><row><data content=\"1\" /><data content=\"Smith Tax &amp; Audit\" /></row><row><data content=\"2\" /><data content=\"Smith Tax &amp; Audit\" /></row><row><data content=\"3\" /><data content=\"Smith Tax &amp; Audit\" /></row><row><data content=\"4\" /><data content=\"Smith Tax &amp; Audit\" /></row><row><data content=\"5\" /><data content=\"Smith Tax &amp; Audit\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>UPDATE</code>.</p></body></html>"
          },
          {
            "title": "One Row",
            "id": 118694,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jak zapewne zauważyłeś, <code>UPDATE</code> pozwala aktualizować wartość kolumny w każdym wierszu, ale najczęściej chcemy zmienić konkretny wiersz.</p><p>Możemy to zrobić, dodając klauzulę <code>WHERE</code> na końcu instrukcji <code>UPDATE</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE `Directory` (&#xA; `floor` INTEGER NOT NULL,&#xA; `company` TEXT NOT NULL,&#xA; PRIMARY KEY (`floor`)&#xA;);&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (1, 'Lobby');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (2, 'Perkins Legal');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (3, '(Vacant)');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (4, 'Bright Whites Dental');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (5, 'Whiz Kid IT Support');\"><tables><table name=\"Directory\"><row><header content=\"floor\" /><header content=\"company\" /></row><row><data content=\"1\" /><data content=\"Lobby\" /></row><row><data content=\"2\" /><data content=\"Perkins Legal\" /></row><row><data content=\"3\" /><data content=\"(Vacant)\" /></row><row><data content=\"4\" /><data content=\"Bright Whites Dental\" /></row><row><data content=\"5\" /><data content=\"Whiz Kid IT Support\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" \" /><text value=\"Directory\" class=\"keyword\" /><text value=\" \" /><text type=\"break\" /><text value=\"SET\" class=\"keyword\" /><text value=\" company = \" /><text value=\"'Smith Tax &amp; Audit'\" class=\"string\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"floor\" class=\"keyword\" /><text value=\" = \" /><text value=\"3\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" \" /><text value=\"Directory\" class=\"keyword\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"52\" endIndex=\"57\" /><option startIndex=\"58\" endIndex=\"63\" /><option startIndex=\"64\" endIndex=\"65\" /><option startIndex=\"66\" endIndex=\"67\" /><option startIndex=\"67\" endIndex=\"68\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"floor\" /><header content=\"company\" /></row><row><data content=\"1\" /><data content=\"Lobby\" /></row><row><data content=\"2\" /><data content=\"Perkins Legal\" /></row><row><data content=\"3\" /><data content=\"Smith Tax &amp; Audit\" /></row><row><data content=\"4\" /><data content=\"Bright Whites Dental\" /></row><row><data content=\"5\" /><data content=\"Whiz Kid IT Support\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>WHERE</code>, następnie <code>floor</code>, a potem <code>=</code>, <code>3</code>, <code>;</code>.</p></body></html>"
          },
          {
            "title": "Multiple Rows",
            "id": 118695,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dodanie warunku do klauzuli <code>WHERE</code> naszego polecenia <code>UPDATE</code> pozwala nam jednocześnie zaktualizować wiele wierszy spełniających ten warunek.</p><p>Na przykład wyobraź sobie, że chcemy wypełnić kolumnę <code>mealservice</code> wartością <code>True</code> dla wszystkich lotów trwających co najmniej 6 godzin.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE `Flights` (&#xA; `number` TEXT NOT NULL,&#xA; `type` TEXT NOT NULL,&#xA; `origin` TEXT NOT NULL,&#xA; `destination` TEXT NOT NULL,&#xA; `duration` REAL NOT NULL,&#xA; `mealservice` INTEGER,&#xA; PRIMARY KEY (`number`)&#xA;);&#xA;&#xA;INSERT INTO `Flights` (`number`, `type`, `origin`, `destination`, `duration`) VALUES ('PA84', 'International', 'Paris', 'London', 1.2);&#xA;&#xA;INSERT INTO `Flights` (`number`, `type`, `origin`, `destination`, `duration`) VALUES ('PA56', 'Domestic', 'New York', 'Los Angeles', 5.5);&#xA;&#xA;INSERT INTO `Flights` (`number`, `type`, `origin`, `destination`, `duration`) VALUES ('PA67', 'International', 'New York', 'London', 7);&#xA;&#xA;INSERT INTO `Flights` (`number`, `type`, `origin`, `destination`, `duration`) VALUES ('PA76', 'Domestic', 'Honolulu', 'Boston', 9.5);\"><tables><table name=\"Flights\"><row><header content=\"number\" /><header content=\"type\" /><header content=\"origin\" /><header content=\"destination\" /><header content=\"duration\" /><header content=\"mealservice\" /></row><row><data content=\"PA84\" /><data content=\"International\" /><data content=\"Paris\" /><data content=\"London\" /><data content=\"1.2\" /><data content=\"\" /></row><row><data content=\"PA56\" /><data content=\"Domestic\" /><data content=\"New York\" /><data content=\"Los Angeles\" /><data content=\"5.5\" /><data content=\"\" /></row><row><data content=\"PA67\" /><data content=\"International\" /><data content=\"New York\" /><data content=\"London\" /><data content=\"7.0\" /><data content=\"\" /></row><row><data content=\"PA76\" /><data content=\"Domestic\" /><data content=\"Honolulu\" /><data content=\"Boston\" /><data content=\"9.5\" /><data content=\"\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" Flights \" /><text type=\"break\" /><text value=\"SET\" class=\"keyword\" /><text value=\" mealservice = \" /><text value=\"True\" class=\"literal\" /><text value=\" \" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"duration\" class=\"keyword\" /><text value=\" &gt;= \" /><text value=\"6\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" Flights;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"40\" endIndex=\"45\" /><option startIndex=\"46\" endIndex=\"54\" /><option startIndex=\"55\" endIndex=\"57\" /><option startIndex=\"58\" endIndex=\"59\" /><option startIndex=\"59\" endIndex=\"60\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"number\" /><header content=\"type\" /><header content=\"origin\" /><header content=\"destination\" /><header content=\"duration\" /><header content=\"mealservice\" /></row><row><data content=\"PA84\" /><data content=\"International\" /><data content=\"Paris\" /><data content=\"London\" /><data content=\"1.2\" /><data content=\"\" /></row><row><data content=\"PA56\" /><data content=\"Domestic\" /><data content=\"New York\" /><data content=\"Los Angeles\" /><data content=\"5.5\" /><data content=\"\" /></row><row><data content=\"PA67\" /><data content=\"International\" /><data content=\"New York\" /><data content=\"London\" /><data content=\"7.0\" /><data content=\"1\" /></row><row><data content=\"PA76\" /><data content=\"Domestic\" /><data content=\"Honolulu\" /><data content=\"Boston\" /><data content=\"9.5\" /><data content=\"1\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>WHERE</code>, następnie <code>duration</code>, a potem <code>&gt;=</code>, <code>6</code>, <code>;</code>.</p></body></html>"
          },
          {
            "title": "Question: Intro II",
            "id": 118697,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Które rozwiązanie jest bardziej eleganckie w przypadku zmiany istniejącego wpisu w tabeli?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Używanie instrukcji <code>UPDATE</code></item><item value=\"2\" correct=\"false\">Używanie instrukcji <code>DELETE</code>, po której następuje instrukcja <code>INSERT</code></item></selection><p visible-if=\"wrong\">Używanie instrukcji <code>UPDATE</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Użytkownik zmienia adres e-mail, ale jego dotychczasowy wiersz w tabeli i pozostałe wartości muszą zostać zachowane. Które rozwiązanie pasuje do tego zadania?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Używanie instrukcji <code>UPDATE</code></item><item value=\"2\" correct=\"false\">Używanie instrukcji <code>DELETE</code>, po której następuje instrukcja <code>INSERT</code></item><item value=\"3\" correct=\"false\">Użycie instrukcji <code>INSERT</code> z tym samym identyfikatorem użytkownika</item></selection><p visible-if=\"wrong\">Używanie instrukcji <code>UPDATE</code>.</p></body></html>"
          },
          {
            "title": "Question: Limitations",
            "id": 118698,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Czy <code>UPDATE</code> można użyć do wstawiania nowych wpisów do tabeli?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Nie, <code>UPDATE</code> może służyć tylko do modyfikowania istniejących wpisów</item><item value=\"2\" correct=\"false\">Tak, SQLite automatycznie utworzy nowy wpis</item></selection><p visible-if=\"wrong\">Nie, <code>UPDATE</code> może służyć tylko do modyfikowania istniejących wpisów.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Instrukcja <code>UPDATE</code> wskazuje użytkownika o identyfikatorze <code>42</code>, ale takiego identyfikatora nie ma w tabeli. Czy instrukcja doda użytkownika <code>42</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Nie, <code>UPDATE</code> może modyfikować tylko pasujący istniejący wpis</item><item value=\"2\" correct=\"false\">Tak, SQLite utworzy użytkownika <code>42</code> na podstawie zmienionych wartości</item><item value=\"3\" correct=\"false\">Tak, ale tylko jeśli identyfikator użytkownika <code>42</code> jest kolejnym dostępnym identyfikatorem</item></selection><p visible-if=\"wrong\">Nie, <code>UPDATE</code> może modyfikować tylko pasujący istniejący wpis.</p></body></html>"
          },
          {
            "title": "Question: Syntax",
            "id": 118699,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Od jakich słów kluczowych zaczyna się podstawowa składnia instrukcji <code>UPDATE</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>UPDATE</code>, a następnie nazwa tabeli do zmiany</item><item value=\"2\" correct=\"false\"><code>UPDATE</code> followed by the name of the column to change</item></selection><p visible-if=\"wrong\"><code>UPDATE</code>, a następnie nazwa tabeli do zmiany.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Musisz zmienić kolumnę <code>email</code> w tabeli <code>users</code>. Który początek prawidłowo wskazuje tabelę do zaktualizowania?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>UPDATE users</code></item><item value=\"2\" correct=\"false\"><code>UPDATE email</code></item><item value=\"3\" correct=\"false\"><code>UPDATE users.email</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>UPDATE users</code>.</p></body></html>"
          },
          {
            "title": "Question: One Row",
            "id": 118700,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co musisz uwzględnić, jeśli chcesz zmienić tylko określony wiersz danych?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Klauzula <code>WHERE</code></item><item value=\"2\" correct=\"false\">Nazwa kolumny i nowa wartość</item></selection><p visible-if=\"wrong\">Klauzula <code>WHERE</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Chcesz zmienić wynik tylko w wierszu, którego <code>id</code> ma wartość <code>7</code>. Co musi zawierać instrukcja <code>UPDATE</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Klauzulę <code>WHERE id = 7</code></item><item value=\"2\" correct=\"false\">Tylko kolumnę wyniku i jej nową wartość</item><item value=\"3\" correct=\"false\">Klauzulę <code>ON id = 7</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz Klauzulę <code>WHERE id = 7</code>.</p></body></html>"
          },
          {
            "title": "Question: Multiple Rows",
            "id": 118701,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Które wiersze zmieni ta instrukcja <code>UPDATE</code>?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE `Songs` (&#xA; `songname` TEXT NOT NULL,&#xA; `artist` TEXT NOT NULL,&#xA; `streams` INTEGER NOT NULL,&#xA; `certifications` TEXT&#xA;);&#xA;&#xA;INSERT INTO `Songs` (`songname`, `artist`, `streams`) VALUES ('Paradise', 'The Jets', 120);&#xA;&#xA;INSERT INTO `Songs` (`songname`, `artist`, `streams`) VALUES ('My Way', 'Stevie J', 100);&#xA;&#xA;INSERT INTO `Songs` (`songname`, `artist`, `streams`) VALUES ('Purple Sunrise', 'Harry', 90);&#xA;&#xA;INSERT INTO `Songs` (`songname`, `artist`, `streams`) VALUES ('California Highway', 'Joan &amp; Jerry', 85);&#xA;&#xA;INSERT INTO `Songs` (`songname`, `artist`, `streams`) VALUES ('My Sister Meg', 'Couches', 70);\"><tables><table name=\"Songs\"><row><header content=\"songname\" /><header content=\"artist\" /><header content=\"streams\" /><header content=\"certifications\" /></row><row><data content=\"Paradise\" /><data content=\"The Jets\" /><data content=\"120\" /><data content=\"\" /></row><row><data content=\"My Way\" /><data content=\"Stevie J\" /><data content=\"100\" /><data content=\"\" /></row><row><data content=\"Purple Sunrise\" /><data content=\"Harry\" /><data content=\"90\" /><data content=\"\" /></row><row><data content=\"California Highway\" /><data content=\"Joan &amp; Jerry\" /><data content=\"85\" /><data content=\"\" /></row><row><data content=\"My Sister Meg\" /><data content=\"Couches\" /><data content=\"70\" /><data content=\"\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" Songs \" /><text type=\"break\" /><text value=\"SET\" class=\"keyword\" /><text value=\" certifications = \" /><text value=\"'Platinum'\" class=\"string\" /><text value=\" \" /><text type=\"break\" /><text value=\"WH