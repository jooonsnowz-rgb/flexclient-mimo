            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Napisz instrukcję <code>UPDATE</code>, aby zmienić wartość kolumny <code>company</code> w każdym wierszu na <code>(Vacant)</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE `Directory` (&#xA; `floor` INTEGER NOT NULL,&#xA; `company` TEXT NOT NULL,&#xA; PRIMARY KEY (`floor`)&#xA;);&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (1, 'Lobby');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (2, 'Perkins Legal');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (3, '(Vacant)');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (4, 'Bright Whites Dental');&#xA;&#xA;INSERT INTO `Directory` (`floor`, `company`) VALUES (5, 'Whiz Kid IT Support');\"><tables><table name=\"Directory\"><row><header content=\"floor\" /><header content=\"company\" /></row><row><data content=\"1\" /><data content=\"Lobby\" /></row><row><data content=\"2\" /><data content=\"Perkins Legal\" /></row><row><data content=\"3\" /><data content=\"(Vacant)\" /></row><row><data content=\"4\" /><data content=\"Bright Whites Dental\" /></row><row><data content=\"5\" /><data content=\"Whiz Kid IT Support\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"UPDATE\" class=\"keyword\" /><text value=\" \" /><text value=\"Directory\" class=\"keyword\" /><text value=\" \" /><text value=\"SET\" class=\"keyword\" /><text value=\" company = \" /><text value=\"'(Vacant)'\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" \" /><text value=\"Directory\" class=\"keyword\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"31\" endIndex=\"41\" /></interactions><output><table name=\"Result\"><row><header content=\"floor\" /><header content=\"company\" /></row><row><data content=\"1\" /><data content=\"(Vacant)\" /></row><row><data content=\"2\" /><data content=\"(Vacant)\" /></row><row><data content=\"3\" /><data content=\"(Vacant)\" /></row><row><data content=\"4\" /><data content=\"(Vacant)\" /></row><row><data content=\"5\" /><data content=\"(Vacant)\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>'(Vacant)'</code>.</p></body></html>"
