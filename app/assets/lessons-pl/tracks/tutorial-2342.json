            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Ile metod może znajdować się w klasie?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Tak wiele, ile chcemy</item><item value=\"2\" correct=\"false\">100 metodów</item><item value=\"3\" correct=\"false\">3 metody</item></selection><p visible-if=\"wrong\">Tak wiele, ile chcemy.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Klasa ma już metody do zapisywania i wczytywania danych. Potrzebuje też metod do sprawdzania poprawności i usuwania danych. Co należy zrobić?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Dodać obie metody, ponieważ klasa może mieć ich tyle, ile potrzeba</item><item value=\"2\" correct=\"false\">Dodać tylko jedną, ponieważ klasa może mieć najwyżej trzy metody</item><item value=\"3\" correct=\"false\">Utworzyć nową klasę, ponieważ do istniejącej nie można dodać kolejnych metod</item></selection><p visible-if=\"wrong\">Dodać obie metody, ponieważ klasa może mieć ich tyle, ile potrzeba.</p></body></html>",
            "hardModeSelected": true
