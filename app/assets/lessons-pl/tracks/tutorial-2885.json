            "interactiveContent": "<!DOCTYPE html ><html><body><p>Właściwość obiektu odpowiedzi zawierająca kod statusu żądania to:</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>response.status_code</code></item><item value=\"2\" correct=\"false\"><code>response.content</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>response.status_code</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Musisz zarejestrować, czy żądanie zwróciło <code>200</code>, czy <code>404</code>, bez odczytywania jego treści. Którą wartość należy sprawdzić?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>response.status_code</code></item><item value=\"2\" correct=\"false\"><code>response.content</code></item><item value=\"3\" correct=\"false\"><code>response.json()</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>response.status_code</code>.</p></body></html>",
