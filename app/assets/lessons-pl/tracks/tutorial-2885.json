            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jakiego parametru używasz, aby dołączyć klucz API?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Parametr <code>headers</code></item><item value=\"2\" correct=\"false\">Parametr <code>body</code></item><item value=\"3\" correct=\"false\">Parametr <code>params</code></item></selection><p visible-if=\"wrong\">Parametr <code>headers</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Przechowujesz klucz API w słowniku <code>auth</code>. Który argument żądania wysyła go jako metadane uwierzytelniania?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>headers=auth</code></item><item value=\"2\" correct=\"false\"><code>json=auth</code></item><item value=\"3\" correct=\"false\"><code>params=auth</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>headers=auth</code>.</p></body></html>",
