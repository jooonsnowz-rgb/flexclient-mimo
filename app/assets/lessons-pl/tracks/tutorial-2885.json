            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jaki kod statusu zazwyczaj wskazuje, że żądanie zakończyło się powodzeniem i utworzono nowy zasób?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>201 Created</code></item><item value=\"2\" correct=\"false\"><code>404 Not Found</code></item></selection><p visible-if=\"wrong\"><code>201 Created</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Wysyłasz żądanie POST, które tworzy nowe konto. Która odpowiedź najdokładniej informuje o tym wyniku?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>201 Created</code></item><item value=\"2\" correct=\"false\"><code>404 Not Found</code></item><item value=\"3\" correct=\"false\"><code>200 OK</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>201 Created</code>.</p></body></html>",
