            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pamiętaj, aby poprawnie ustawić <code>body</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"import\" class=\"keyword\" /><text value=\" requests\" /><text type=\"break\" /><text type=\"break\" /><text value=\"headers = {\" /><text value=\"&quot;api-key&quot;\" class=\"string\" /><text value=\": \" /><text value=\"&quot;MY_SECRET_KEY&quot;\" class=\"string\" /><text value=\"}\" /><text type=\"break\" /><text value=\"body = {\" /><text value=\"&quot;my-message&quot;\" class=\"string\" /><text value=\": \" /><text value=\"&quot;I was here!&quot;\" class=\"string\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"requests.post(\" /><text value=\"&quot;http://mimo.org/api/exclusive_guest_book&quot;\" class=\"string\" /><text value=\", headers=headers, json=body)\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"169\" endIndex=\"178\" /></interactions></code><p visible-if=\"wrong\">Koniecznie wpisz <code>json=body</code>.</p></body></html>"
