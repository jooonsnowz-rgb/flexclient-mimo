            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Która metoda w <code>requests</code> umożliwia łatwe przekazywanie parametrów zapytania?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Argument <code>params</code></item><item value=\"2\" correct=\"false\">Argument <code>body</code></item><item value=\"3\" correct=\"false\">Argument <code>headers</code></item></selection><p visible-if=\"wrong\">Argument <code>params</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Przechowujesz parametry zapytania w słowniku <code>filters</code>. Który argument przekazuje je za pomocą <code>requests</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>params=filters</code></item><item value=\"2\" correct=\"false\"><code>json=filters</code></item><item value=\"3\" correct=\"false\"><code>headers=filters</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>params=filters</code>.</p></body></html>",
