            "id": 88781,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co dzieje się w tym kodzie?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"VirtualPet\" class=\"title\" /><text value=\":\" /><text type=\"break\" /><text value=\"  wagging_tail = \" /><text value=\"True\" class=\"literal\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Definiujemy klasę</item><item value=\"2\" correct=\"false\">Tworzymy instancję klasy</item></selection><p visible-if=\"wrong\">Definiujemy klasę.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Dlaczego ten kod definiuje klasę, ale nie tworzy żadnej instancji <code>VirtualPet</code>?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"VirtualPet\" class=\"title\" /><text value=\":\" /><text type=\"break\" /><text value=\"  wagging_tail = \" /><text value=\"True\" class=\"literal\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Nigdzie nie wywołuje <code>VirtualPet()</code></item><item value=\"2\" correct=\"false\">Zmienna <code>wagging_tail</code> automatycznie tworzy instancję</item><item value=\"3\" correct=\"false\">Zapisanie ciała klasy tworzy również jedną instancję bez nazwy</item></selection><p visible-if=\"wrong\">Nigdzie nie wywołuje <code>VirtualPet()</code>.</p></body></html>"
