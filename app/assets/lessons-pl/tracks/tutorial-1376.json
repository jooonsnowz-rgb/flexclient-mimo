            "interactiveContent": "<!DOCTYPE html ><html><body><p>Który fragment kodu poprawnie tworzy instancję klasy <code>Cat</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>fluffy = Cat()</code></item><item value=\"4\" correct=\"false\"><code>fluffy = VirtualPet()</code></item></selection><p visible-if=\"wrong\"><code>fluffy = Cat()</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Program zawiera klasę <code>Cat</code>. Który wiersz tworzy instancję klasy <code>Cat</code> o nazwie <code>fluffy</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>fluffy = Cat()</code></item><item value=\"2\" correct=\"false\"><code>fluffy = Cat</code></item><item value=\"3\" correct=\"false\"><code>Cat = fluffy()</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>fluffy = Cat()</code>.</p></body></html>"
