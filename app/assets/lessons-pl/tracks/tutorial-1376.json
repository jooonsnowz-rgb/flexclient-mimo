            "id": 89473,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co robi ten kod?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"VirtualPet\" class=\"title\" /><text value=\":\" /><text type=\"break\" /><text value=\"  color = \" /><text value=\"&quot;brown&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"fluffy = VirtualPet()\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Definiujemy klasę i tworzymy jej instancję</item><item value=\"4\" correct=\"false\">Definiujemy tylko klasę</item></selection><p visible-if=\"wrong\">Definiujemy klasę i tworzymy jej instancję.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Co reprezentują <code>VirtualPet</code> i <code>fluffy</code> po wykonaniu tego kodu?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"VirtualPet\" class=\"title\" /><text value=\":\" /><text type=\"break\" /><text value=\"  color = \" /><text value=\"&quot;brown&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"fluffy = VirtualPet()\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>VirtualPet</code> jest klasą, a <code>fluffy</code> jej instancją</item><item value=\"2\" correct=\"false\">Obie nazwy reprezentują klasy</item><item value=\"3\" correct=\"false\"><code>fluffy</code> jest klasą, a <code>VirtualPet</code> jej instancją</item></selection><p visible-if=\"wrong\"><code>VirtualPet</code> jest klasą, a <code>fluffy</code> jej instancją.</p></body></html>",
