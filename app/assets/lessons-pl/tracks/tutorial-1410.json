          {
            "title": "Intro",
            "id": 91673,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Czasami porównania za pomocą <code>=</code> lub <code>&lt;&gt;</code> nie są wystarczająco elastyczne, na przykład podczas filtrowania według ceny artykułu spożywczego.</p><p>Klikaj przyciski, aby zobaczyć, ile elementów otrzymujemy przy użyciu tych dwóch porównań.</p><webview version=\"2\" visible-if=\"always\" content=\"&lt;!DOCTYPE html&gt;&#xA;&lt;html&gt;&#xA; &lt;head&gt;&#xA; &lt;meta charset=&quot;utf-8&quot;&gt;&#xA; &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width&quot;&gt;&#xA; &lt;title&gt;repl.it&lt;/title&gt;&#xA; &lt;link href=&quot;style.css&quot; rel=&quot;stylesheet&quot; type=&quot;text/css&quot; /&gt;&#xA; &lt;/head&gt;&#xA; &lt;body&gt;&#xA; &lt;!DOCTYPE html&gt;&#xA;&lt;html&gt;&#xA;&lt;head&gt;&#xA;&lt;style&gt;&#xA;&#xA;#equalTable {&#xA; display: none;&#xA;}&#xA;#lessOrEqualTable {&#xA; display: none;&#xA;}&#xA;&#xA;&#xA;#btnDiv {&#xA; text-align: center;&#xA;}&#xA;&#xA;button {&#xA; margin: 0 3px 0 3px;&#xA; padding: 6px 14px 6px 14px;&#xA; border-radius: 20px;&#xA; font-weight: bold;&#xA; border: 3px solid aliceblue;&#xA; outline-color: #BFDAF9;&#xA; background-color: #D9E8FB;&#xA; color: #4D4D87;&#xA; font-size: 16px;&#xA; }&#xA;&#xA;.green {&#xA; color: #32B964;&#xA;}&#xA;&#xA;h3{&#xA; margin-top: 0px;&#xA; color: #96BCEF;&#xA;}&#xA;table {&#xA; font-family: arial, sans-serif;&#xA; border-collapse: collapse;&#xA; width: 100%;&#xA; color: #4D4D87;&#xA;margin-top: 7px;&#xA;}&#xA;&#xA;thead {&#xA; background-color: #4D4D87;&#xA; color: white;&#xA;}&#xA;&#xA;/* change border color here */&#xA;td, th {&#xA; border: 1px solid #96BCEF;&#xA; text-align: left;&#xA; padding: 8px;&#xA;}&#xA;&#xA;/* Change color for every second row */&#xA;tr:nth-child(even) {&#xA; background-color: #D9E8FB;&#xA;}&#xA;&#xA;h2 {&#xA; color: #4D4D87;&#xA;margin-bottom: 0px;&#xA;}&#xA;&lt;/style&gt;&#xA;&lt;/head&gt;&#xA;&lt;body id=&quot;main&quot;&gt;&#xA;&#xA;&lt;div id=&quot;btnDiv&quot;&gt;&#xA;&lt;button id=&quot;equalBtn&quot;&gt;price &lt;span class=&quot;green&quot;&gt;=&lt;/span&gt; 2$&lt;/button&gt;&#xA;&lt;button id=&quot;lessOrEqualBtn&quot;&gt;price &lt;span class=&quot;green&quot;&gt;&lt;=&lt;/span&gt; 2$&lt;/button&gt;&#xA;&lt;/div&gt;&#xA;&#xA;&lt;div id=&quot;baseTable&quot;&gt;&#xA;&lt;h2&gt;chocolate&lt;/h2&gt;&#xA;&lt;table&gt;&#xA;&lt;thead&gt;&lt;tr&gt;&#xA;&lt;th title=&quot;Field #1&quot;&gt;description&lt;/th&gt;&#xA;&lt;th title=&quot;Field #2&quot;&gt;price&lt;/th&gt;&#xA;&lt;/tr&gt;&lt;/thead&gt;&#xA;&lt;tbody&gt;&#xA;&lt;tr&gt;&#xA;&lt;td&gt;90% cacao&lt;/td&gt;&#xA;&lt;td&gt;3&lt;/td&gt;&#xA;&lt;/tr&gt;&#xA;&lt;tr&gt;&#xA;&lt;td&gt;Caramel sea salt&lt;/td&gt;&#xA;&lt;td&gt;1.99&lt;/td&gt;&#xA;&lt;/tr&gt;&#xA;&lt;tr&gt;&#xA;&lt;td&gt;Milk chocolate&lt;/td&gt;&#xA;&lt;td&gt;2.5&lt;/td&gt;&#xA;&lt;/tr&gt;&#xA;&lt;tr&gt;&#xA;&lt;td&gt;Brownie core&lt;/td&gt;&#xA;&lt;td&gt;2&lt;/td&gt;&#xA;&lt;/tr&gt;&#xA;&lt;/tbody&gt;&lt;/table&gt;&#xA;&#xA;&lt;/div&gt;&#xA;&#xA;&lt;div id=&quot;equalTable&quot;&gt;&#xA;&lt;h2&gt;chocolate&lt;/h2&gt;&#xA;&lt;table&gt;&#xA;&lt;thead&gt;&lt;tr&gt;&#xA;&lt;th title=&quot;Field #1&quot;&gt;description&lt;/th&gt;&#xA;&lt;th title=&quot;Field #2&quot;&gt;price&lt;/th&gt;&#xA;&lt;/tr&gt;&lt;/thead&gt;&#xA;&lt;tbody&gt;&#xA;&lt;tr&gt;&#xA;&lt;td&gt;Brownie core&lt;/td&gt;&#xA;&lt;td&gt;2&lt;/td&gt;&#xA;&lt;/tr&gt;&#xA;&lt;/tbody&gt;&lt;/table&gt;&#xA;&lt;/tbody&gt;&lt;/table&gt;&#xA;&#xA;&lt;/div&gt;&#xA;&#xA;&lt;div id=&quot;lessOrEqualTable&quot;&gt;&#xA;&lt;h2&gt;chocolate&lt;/h2&gt;&#xA;&lt;table&gt;&#xA;&lt;thead&gt;&lt;tr&gt;&#xA;&lt;th title=&quot;Field #1&quot;&gt;description&lt;/th&gt;&#xA;&lt;th title=&quot;Field #2&quot;&gt;price&lt;/th&gt;&#xA;&lt;/tr&gt;&lt;/thead&gt;&#xA;&lt;tbody&gt;&#xA;&lt;tr&gt;&#xA;&lt;td&gt;Caramel sea salt&lt;/td&gt;&#xA;&lt;td&gt;1.99&lt;/td&gt;&#xA;&lt;/tr&gt;&#xA;&lt;tr&gt;&#xA;&lt;td&gt;Brownie core&lt;/td&gt;&#xA;&lt;td&gt;2&lt;/td&gt;&#xA;&lt;/tr&gt;&#xA;&lt;/tbody&gt;&lt;/table&gt;&#xA;&lt;/div&gt;&#xA;&#xA;&lt;/body&gt;&#xA;&lt;/html&gt;&#xA;&#xA; &lt;script&gt;&#xA;document.getElementById(&quot;equalBtn&quot;).addEventListener(&quot;click&quot;, function() {&#xA; let equalTable = document.getElementById(&quot;equalTable&quot;);&#xA; let lessOrEqualTable = document.getElementById(&quot;lessOrEqualTable&quot;);&#xA; let baseTable = document.getElementById(&quot;baseTable&quot;);&#xA;&#xA; equalTable.style.display = 'block';&#xA; lessOrEqualTable.style.display = 'none';&#xA; baseTable.style.display = 'none';&#xA;});&#xA;&#xA;&#xA;document.getElementById(&quot;lessOrEqualBtn&quot;).addEventListener(&quot;click&quot;, function() {&#xA; let equalTable = document.getElementById(&quot;equalTable&quot;);&#xA; let lessOrEqualTable = document.getElementById(&quot;lessOrEqualTable&quot;);&#xA; let baseTable = document.getElementById(&quot;baseTable&quot;);&#xA;&#xA; equalTable.style.display = 'none';&#xA; lessOrEqualTable.style.display = 'block';&#xA; baseTable.style.display = 'none';&#xA;});&#xA;&#xA;&lt;/script&gt;&#xA; &lt;/body&gt;&#xA;&lt;/html&gt;\" /></body></html>"
          },
          {
            "title": "Less than",
            "id": 91456,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Możemy używać warunków do wybierania elementów, których właściwość ma wartość mniejszą od wartości progowej, na przykład elementów czekoladowych, których <code>price</code> wynosi mniej niż 2$.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE chocolate (&#xA;description varchar(255),&#xA;price numeric(1,2)&#xA;);&#xA;&#xA;INSERT INTO chocolate (description, price)&#xA;VALUES ('90% cacao', 3);&#xA;INSERT INTO chocolate (description, price)&#xA;VALUES ('Caramel sea salt', 1.99);&#xA;INSERT INTO chocolate (description, price)&#xA;VALUES ('Milk chocolate', 2.5);&#xA;INSERT INTO chocolate (description, price)&#xA;VALUES ('Brownie core', 2);\"><tables><table name=\"chocolate\"><row><header content=\"description\" /><header content=\"price\" /></row><row><data content=\"90% cacao\" /><data content=\"3\" /></row><row><data content=\"Caramel sea salt\" /><data content=\"1.99\" /></row><row><data content=\"Milk chocolate\" /><data content=\"2.5\" /></row><row><data content=\"Brownie core\" /><data content=\"2\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" chocolate\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" price &lt; \" /><text value=\"2\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"25\" endIndex=\"30\" /><option startIndex=\"31\" endIndex=\"40\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"description\" /><header content=\"price\" /></row><row><data content=\"Caramel sea salt\" /><data content=\"1.99\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>WHERE</code>, a następnie <code>price &lt; 2</code>.</p></body></html>"
          },
          {
            "title": "Less than operator",
            "id": 91457,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><strong>Operator mniejszości</strong>, <code>&lt;</code>, sprawdza, czy wartość po lewej stronie jest mniejsza niż wartość po prawej, na przykład czy właściwość <code>price</code> jest mniejsza niż <code>2</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE chocolate (&#xA;description varchar(255),&#xA;price numeric(1,2)&#xA;);&#xA;&#xA;INSERT INTO chocolate (description, price)&#xA;VALUES ('90% cacao', 3);&#xA;INSERT INTO chocolate (description, price)&#xA;VALUES ('Caramel sea salt', 1.99);&#xA;INSERT INTO chocolate (description, price)&#xA;VALUES ('Milk chocolate', 2.5);&#xA;INSERT INTO chocolate (description, price)&#xA;VALUES ('Brownie core', 2);\"><tables><table name=\"chocolate\"><row><header content=\"description\" /><header content=\"price\" /></row><row><data content=\"90% cacao\" /><data content=\"3\" /></row><row><data content=\"Caramel sea salt\" /><data content=\"1.99\" /></row><row><data content=\"Milk chocolate\" /><data content=\"2.5\" /></row><row><data content=\"Brownie core\" /><data content=\"2\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" chocolate\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" price &lt; \" /><text value=\"2\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"31\" endIndex=\"36\" /><option startIndex=\"37\" endIndex=\"38\" /><option startIndex=\"39\" endIndex=\"40\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"description\" /><header content=\"price\" /></row><row><data content=\"Caramel sea salt\" /><data content=\"1.99\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>price</code>, następnie <code>&lt;</code> i na końcu <code>2</code>.</p></body></html>"
          },
          {
            "title": "Less than operator 2",
            "id": 91458,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>To zapytanie nie wybiera produktów czekoladowych w cenie dokładnie 2$, ponieważ <code>2</code> nie jest mniejsze od wartości progowej <code>2</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE chocolate (&#xA;description varchar(255),&#xA;price numeric(1,2)&#xA;);&#xA;&#xA;INSERT INTO chocolate (description, price)&#xA;VALUES ('90% cacao', 3);&#xA;INSERT INTO chocolate (description, price)&#xA;VALUES ('Caramel sea salt', 1.99);&#xA;INSERT INTO chocolate (description, price)&#xA;VALUES ('Milk chocolate', 2.5);&#xA;INSERT INTO chocolate (description, price)&#xA;VALUES ('Brownie core', 2);\"><tables><table name=\"chocolate\"><row><header content=\"description\" /><header content=\"price\" /></row><row><data content=\"90% cacao\" /><data content=\"3\" /></row><row><data content=\"Caramel sea salt\" /><data content=\"1.99\" /></row><row><data content=\"Milk chocolate\" /><data content=\"2.5\" /></row><row><data content=\"Brownie core\" /><data content=\"2\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" chocolate\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" price &lt; \" /><text value=\"2\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"39\" endIndex=\"40\" /></interactions><output><table name=\"Result\"><row><header content=\"description\" /><header content=\"price\" /></row><row><data content=\"Caramel sea salt\" /><data content=\"1.99\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>2</code>.</p></body></html>"
          },
          {
            "title": "The <= operator",
            "id": 91460,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Aby wybrać elementy z ceną mniejszą lub równą wartości takiej jak <code>2</code>, używamy operatora <code>&lt;=</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE chocolate (&#xA;description varchar(255),&#xA;price numeric(1,2)&#xA;);&#xA;&#xA;INSERT INTO chocolate (description, price)&#xA;VALUES ('90% cacao', 3);&#xA;INSERT INTO chocolate (description, price)&#xA;VALUES ('Caramel sea salt', 1.99);&#xA;INSERT INTO chocolate (description, price)&#xA;VALUES ('Milk chocolate', 2.5);&#xA;INSERT INTO chocolate (description, price)&#xA;VALUES ('Brownie core', 2);\"><tables><table name=\"chocolate\"><row><header content=\"description\" /><header content=\"price\" /></row><row><data content=\"90% cacao\" /><data content=\"3\" /></row><row><data content=\"Caramel sea salt\" /><data content=\"1.99\" /></row><row><data content=\"Milk chocolate\" /><data content=\"2.5\" /></row><row><data content=\"Brownie core\" /><data content=\"2\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" chocolate\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" price &lt;= \" /><text value=\"2\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"37\" endIndex=\"39\" /></interactions><output><table name=\"Result\"><row><header content=\"description\" /><header content=\"price\" /></row><row><data content=\"Caramel sea salt\" /><data content=\"1.99\" /></row><row><data content=\"Brownie core\" /><data content=\"2\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>&lt;=</code>.</p></body></html>"
          },
          {
            "title": "Question: Less than",
            "id": 91755,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co robi to zapytanie?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" city\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" pollution\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" pollution_index &lt; \" /><text value=\"80\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Wybiera właściwość <code>city</code> wszystkich elementów, dla których <code>pollution_index</code> jest mniejszy niż <code>80</code></item><item value=\"2\" correct=\"false\">Wybiera właściwość <code>city</code> wszystkich elementów z <code>pollution_index</code> równym <code>80</code></item></selection><p visible-if=\"wrong\">Wybiera właściwość <code>city</code> wszystkich elementów, dla których <code>pollution_index</code> jest mniejszy niż <code>80</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Jakie wartości wskaźnika zanieczyszczenia mogą pojawić się w wyniku tego zapytania?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" city\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" pollution\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" pollution_index &lt; \" /><text value=\"80\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Dowolna wartość poniżej <code>80</code>, na przykład <code>79</code></item><item value=\"2\" correct=\"false\">Tylko wartość <code>80</code></item><item value=\"3\" correct=\"false\"><code>80</code> i wszystkie mniejsze wartości</item></selection><p visible-if=\"wrong\">Dowolna wartość poniżej <code>80</code>, na przykład <code>79</code>.</p></body></html>"
          },
          {
            "title": "Question: Less than operator",
            "id": 91756,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jakiego operatora używamy, gdy chcemy sprawdzić, czy właściwość jest mniejsza od określonej wartości?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Operator <code>&lt;</code></item><item value=\"2\" correct=\"false\">Operator <code>=</code></item></selection><p visible-if=\"wrong\">Operator <code>&lt;</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Które porównanie należy umieścić po <code>WHERE temperature</code>, aby zachować tylko temperatury poniżej <code>20</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>&lt; 20</code></item><item value=\"2\" correct=\"false\"><code>= 20</code></item><item value=\"3\" correct=\"false\"><code>&lt;= 20</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>&lt; 20</code>.</p></body></html>"
          },
          {
            "title": "Question: Less than operator 2",
            "id": 91757,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Czy to zapytanie wybiera elementy, dla których <code>pollution_index</code> jest równy <code>72</code>?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" pollution\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" pollution_index &lt; \" /><text value=\"72\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Nie, ponieważ <code>72</code> nie jest mniejsze niż <code>72</code></item><item value=\"2\" correct=\"false\">Tak, wybiera elementy z wartością <code>pollution_index</code> mniejszą lub równą <code>72</code></item></selection><p visible-if=\"wrong\">Nie, ponieważ <code>72</code> nie jest mniejsze niż <code>72</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Wiersz ma wartość <code>pollution_index</code> równą <code>71</code>. Czy to zapytanie go uwzględni?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" pollution\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" pollution_index &lt; \" /><text value=\"72\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Tak, ponieważ <code>71</code> jest mniejsze niż <code>72</code></item><item value=\"2\" correct=\"false\">Nie, ponieważ wybrana zostaje tylko wartość <code>72</code></item><item value=\"3\" correct=\"false\">Nie, ponieważ zapytanie wymaga operatora <code>&lt;=</code></item></selection><p visible-if=\"wrong\">Tak, ponieważ <code>71</code> jest mniejsze niż <code>72</code>.</p></body></html>"
          },
          {
            "title": "Question: The <= operator",
            "id": 91758,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kiedy używamy operatora <code>&lt;=</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Gdy chcemy wybrać elementy, których właściwość jest mniejsza niż <em>lub</em> równa danej wartości</item><item value=\"2\" correct=\"false\">Gdy chcemy wybrać elementy, których właściwość jest mniejsza od danej wartości</item></selection><p visible-if=\"wrong\">Gdy chcemy wybrać elementy, których właściwość jest mniejsza niż <em>lub</em> równa danej wartości.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Który warunek zachowuje wyniki równe <code>90</code> lub wyższe?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>score &gt;= 90</code></item><item value=\"2\" correct=\"false\"><code>score &gt; 90</code></item><item value=\"3\" correct=\"false\"><code>score &lt;= 90</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>score &gt;= 90</code>.</p></body></html>"
          },
          {
            "title": "Example: Less than",
            "id": 91760,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zakoduj warunek wybierający elementy, dla których <code>pollution_index</code> jest mniejszy niż <code>100</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE pollution (&#xA;city varchar(255),&#xA;pollution_index int&#xA;);&#xA;&#xA;INSERT INTO pollution (city, pollution_index)&#xA;VALUES ('Delhi', 168);&#xA;INSERT INTO pollution (city, pollution_index)&#xA;VALUES ('Milano', 122);&#xA;INSERT INTO pollution (city, pollution_index)&#xA;VALUES ('Shanghai', 74);&#xA;INSERT INTO pollution (city, pollution_index)&#xA;VALUES ('Tokyo', 21);\"><tables><table name=\"pollution\"><row><header content=\"city\" /><header content=\"pollution_index\" /></row><row><data content=\"Delhi\" /><data content=\"168\" /></row><row><data content=\"Milano\" /><data content=\"122\" /></row><row><data content=\"Shanghai\" /><data content=\"74\" /></row><row><data content=\"Tokyo\" /><data content=\"21\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" pollution\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" pollution_index &lt; \" /><text value=\"100\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"24\" endIndex=\"29\" /><option startIndex=\"30\" endIndex=\"45\" /><option startIndex=\"46\" endIndex=\"47\" /><option startIndex=\"48\" endIndex=\"51\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"city\" /><header content=\"pollution_index\" /></row><row><data content=\"Shanghai\" /><data content=\"74\" /></row><row><data content=\"Tokyo\" /><data content=\"21\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>WHERE</code>, następnie <code>pollution_index</code>, a potem <code>&lt;</code>, <code>100</code>.</p></body></html>"
          },
          {
            "title": "Example: Less than operator",
            "id": 91761,
