            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co wyświetla ten kod w konsoli?</p><code name=\"main.swift\" version=\"2\" codelang=\"swift\"><content><text value=\"var\" class=\"keyword\" /><text value=\" counter = \" /><text value=\"0\" class=\"number\" /><text type=\"break\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" counter &lt; \" /><text value=\"3\" class=\"number\" /><text value=\" {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"print\" class=\"built_in\" /><text value=\"(counter)\" /><text type=\"break\" /><text value=\"  counter += \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text value=\"}\" /></content><output><content><text value=\"0\" /><text type=\"break\" /><text value=\"1\" /><text type=\"break\" /><text value=\"2\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Liczby <code>0</code>, <code>1</code> i <code>2</code></item><item value=\"2\" correct=\"false\">Liczby <code>1</code>, <code>2</code> i <code>3</code></item><item value=\"3\" correct=\"false\">Liczby <code>0</code>, <code>1</code>, <code>2</code> i <code>3</code></item></selection><p visible-if=\"wrong\">Liczby <code>0</code>, <code>1</code> i <code>2</code>.</p></body></html>"
