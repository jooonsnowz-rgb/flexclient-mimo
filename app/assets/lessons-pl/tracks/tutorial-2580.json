            "id": 127596,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co wyświetla ten kod w konsoli?</p><code name=\"main.swift\" version=\"2\" codelang=\"swift\"><content><text value=\"var\" class=\"keyword\" /><text value=\" counter = \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" counter &lt; \" /><text value=\"2\" class=\"number\" /><text value=\" {\" /><text type=\"break\" /><text value=\"  counter += \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(counter)\" /></content><output><content><text value=\"2\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>2</code></item><item value=\"2\" correct=\"false\"><code>1</code></item><item value=\"3\" correct=\"false\"><code>3</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>2</code>.</p></body></html>"
