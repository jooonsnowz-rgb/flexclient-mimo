            "hardModeContent": "<!DOCTYPE html ><html><body><p>Włącz automatyczne zapisywanie, przypisując wartość logiczną <code>True</code> do zmiennej <code>auto_save</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"auto_save = \" /><text value=\"True\" class=\"literal\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"12\" endIndex=\"16\" /><option correct=\"false\"><content><text value=\"true\" /></content></option><option correct=\"false\"><content><text value=\"&quot;True&quot;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>True</code>.</p></body></html>"
