            "hardModeContent": "<!DOCTYPE html ><html><body><p>Co w tym przypisaniu wskazuje, że <code>False</code> nie jest ciągiem znaków?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"upload = \" /><text value=\"False\" class=\"literal\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Nie ma wokół niego cudzysłowów</item><item value=\"2\" correct=\"false\">Jest przechowywany wewnątrz zmiennej</item><item value=\"3\" correct=\"false\">Ta wartość zaczyna się wielką literą</item></selection><p visible-if=\"wrong\">Nie ma wokół niego cudzysłowów.</p></body></html>",
