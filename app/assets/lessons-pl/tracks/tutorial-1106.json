            "hardModeContent": "<!DOCTYPE html ><html><body><p>Użytkownik nie jest już subskrybentem. Który wiersz zapisuje ten stan?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>subscribed = False</code></item><item value=\"2\" correct=\"false\"><code>subscribed = True</code></item><item value=\"3\" correct=\"false\"><code>subscribed = \"False\"</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>subscribed = False</code>.</p></body></html>"
