            "interactiveContent": "<!DOCTYPE html ><html><body><p>Do czego dobrze nadają się wartości <code>True</code> i <code>False</code>? </p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Pokazywanie, czy funkcja jest włączona, czy wyłączona</item><item value=\"2\" correct=\"false\">Przechowywanie wartości od jednego do pięciu</item></selection><p visible-if=\"wrong\">Pokazywanie, czy funkcja jest włączona, czy wyłączona.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Ustawienie może być tylko włączone lub wyłączone. Do czego najlepiej pasują wartości <code>True</code> i <code>False</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Pokazywanie, czy funkcja jest włączona, czy wyłączona</item><item value=\"2\" correct=\"false\">Przechowywanie wartości od jednego do pięciu</item><item value=\"3\" correct=\"false\">Do liczenia, ile razy użyto danej funkcji</item></selection><p visible-if=\"wrong\">Pokazywanie, czy funkcja jest włączona, czy wyłączona.</p></body></html>",
