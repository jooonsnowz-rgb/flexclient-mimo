          {
            "title": "Lesson #14",
            "id": 148355,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wywołaj funkcję <code>.filter()</code> na tablicy <code>loot</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"map\" /></content></option><option startIndex=\"60\" endIndex=\"64\" /><option startIndex=\"64\" endIndex=\"65\" /><option startIndex=\"65\" endIndex=\"71\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" loot = [\" /><text value=\"&quot;Torch&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Trap&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Gem&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Tunic&quot;\" class=\"string\" /><text value=\"];\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" arr = loot.filter(\" /><text value=\"element\" class=\"params\" /><text value=\" =&gt;\" /><text value=\" (element[\" /><text value=\"0\" class=\"number\" /><text value=\"] === \" /><text value=\"&quot;T&quot;\" class=\"string\" /><text value=\"));\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(arr);\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>loot</code>, następnie <code>.</code> i na końcu <code>filter</code>.</p></body></html>"
