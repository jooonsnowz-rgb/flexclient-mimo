            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dodaj parametr <code>status</code> do funkcji.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"user_status\" class=\"title\" /><text value=\"(status)\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"f&quot;Bob: \" /><text value=\"{status}\" class=\"subst\" /><text value=\"&quot;\" /><text value=\")\" /><text type=\"break\" /><text value=\"user_status(\" /><text value=\"&quot;Active&quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"16\" endIndex=\"22\" /></interactions><output><content><text value=\"Bob: Active\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>status</code>.</p></body></html>"
