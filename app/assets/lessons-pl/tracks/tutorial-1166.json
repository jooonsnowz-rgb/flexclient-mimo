            "interactiveContent": "<!DOCTYPE html ><html><body><p>Uzupełnij zmienną i instrukcję wyświetlania.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"user_status\" class=\"title\" /><text value=\"()\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\"  status = \" /><text value=\"&quot;Active&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"  username = \" /><text value=\"&quot;Bob&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"f&quot;\" /><text value=\"{username}\" class=\"subst\" /><text value=\" is \" /><text value=\"{status}\" class=\"subst\" /><text value=\"&quot;\" /><text value=\")\" /><text type=\"break\" /><text value=\"user_status()\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"41\" endIndex=\"49\" /><option startIndex=\"69\" endIndex=\"77\" /></options></interaction></interactions><output><content><text value=\"Bob is Active\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>username</code>, a następnie <code>username</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Zapisz imię jako jedną z dwóch wartości i użyj go, aby kod wyświetlił <code>Bob is Active</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"user_status\" class=\"title\" /><text value=\"()\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\"  status = \" /><text value=\"&quot;Active&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"  username = \" /><text value=\"&quot;Bob&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"f&quot;\" /><text value=\"{username}\" class=\"subst\" /><text value=\" is \" /><text value=\"{status}\" class=\"subst\" /><text value=\"&quot;\" /><text value=\")\" /><text type=\"break\" /><text value=\"user_status()\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"41\" endIndex=\"49\" /><option startIndex=\"69\" endIndex=\"77\" /><option correct=\"false\"><content><text value=\"status\" /></content></option></options></interaction></interactions><output><content><text value=\"Bob is Active\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>username</code>, a następnie <code>username</code>.</p></body></html>"
