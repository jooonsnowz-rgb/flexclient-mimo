          {
            "title": "Doesn't satisfy a condition",
            "id": 91448,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Czasami chcemy wybrać dane, które <em>nie</em> spełniają warunku, na przykład wszystkich studentów, którzy <em>nie</em> są na pierwszym roku.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA;name varchar(255),&#xA;year int,&#xA;major varchar(255)&#xA;);&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Ava Smith', 1, 'Biology');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Luis Garcia', 1, 'Physics');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Lin Wong', 3, 'Biology');\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" &lt;&gt; \" /><text value=\"1\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"29\" endIndex=\"38\" /><option startIndex=\"23\" endIndex=\"28\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>WHERE</code>, a następnie <code>year &lt;&gt; 1</code>.</p></body></html>"
          },
          {
            "title": "All years",
            "id": 91450,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tak jak wcześniej, zaczynamy od wybrania wszystkich elementów za pomocą <code>*</code>. Dzięki temu otrzymamy studentów ze wszystkich lat.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA;name varchar(255),&#xA;year int,&#xA;major varchar(255)&#xA;);&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Ava Smith', 1, 'Biology');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Luis Garcia', 1, 'Physics');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Lin Wong', 3, 'Biology');\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"7\" endIndex=\"8\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>*</code>.</p></body></html>"
          },
          {
            "title": "The inequality operator",
            "id": 91451,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Aby sprawdzić, czy wartość kolumny <em>nie</em> jest równa innej wartości, używamy operatora nierówności <code>&lt;&gt;</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA;name varchar(255),&#xA;year int,&#xA;major varchar(255)&#xA;);&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Ava Smith', 1, 'Biology');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Luis Garcia', 1, 'Physics');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Lin Wong', 3, 'Biology');\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" &lt;&gt; \" /><text value=\"1\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"34\" endIndex=\"35\" /><option startIndex=\"35\" endIndex=\"36\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>&lt;</code>, a następnie <code>&gt;</code>.</p></body></html>"
          },
          {
            "title": "The inequality operator 2",
            "id": 91452,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Ponieważ <code>year &lt;&gt; 1</code> odfiltrowuje elementy studentów z wartością <code>1</code> w kolumnie <code>year</code>, otrzymujemy tylko studentkę na trzecim roku.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA;name varchar(255),&#xA;year int,&#xA;major varchar(255)&#xA;);&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Ava Smith', 1, 'Biology');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Luis Garcia', 1, 'Physics');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Lin Wong', 3, 'Biology');\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" &lt;&gt; \" /><text value=\"1\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"29\" endIndex=\"38\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>year &lt;&gt; 1</code>.</p></body></html>"
          },
          {
            "title": "Inequality with text values",
            "id": 91453,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Możemy również używać operatora nierówności z wartościami tekstowymi, na przykład aby uzyskać wszystkich studentów, którzy nie specjalizują się w <code>'Biology'</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA;name varchar(255),&#xA;year int,&#xA;major varchar(255)&#xA;);&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Ava Smith', 1, 'Biology');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Luis Garcia', 1, 'Physics');&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Lin Wong', 3, 'Biology');\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" major &lt;&gt; \" /><text value=\"'Biology'\" class=\"string\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"38\" endIndex=\"47\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>'Biology'</code>.</p></body></html>"
          },
          {
            "title": "Question: Doesn't satisfy a condition",
            "id": 91744,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kiedy przydaje się znak nierówności?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Gdy chcemy uzyskać wszystkie elementy, które nie spełniają kryterium</item><item value=\"2\" correct=\"false\">Gdy chcemy uzyskać wszystkie elementy spełniające kryterium</item></selection><p visible-if=\"wrong\">Gdy chcemy uzyskać wszystkie elementy, które nie spełniają kryterium.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Z listy firm trzeba wykluczyć wszystkie firmy prowadzące działalność od dokładnie trzech lat. Jakiego porównania należy użyć w filtrze?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Użyj nierówności, aby zachować wartości inne niż 3.</item><item value=\"2\" correct=\"false\">Użyj równości, aby zachować tylko wartości równe 3.</item><item value=\"3\" correct=\"false\">Użyj nierówności, aby zachować wartości większe niż 3.</item></selection><p visible-if=\"wrong\">Użyj nierówności, aby zachować wartości inne niż 3.</p></body></html>"
          },
          {
            "title": "Question: All years",
            "id": 91745,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co jest nie tak z tym zapytaniem?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"FROM companies\" /><text type=\"break\" /><text value=\"WHERE years_active &lt;&gt; 3;\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Najpierw powinno wybrać elementy, a dopiero potem je filtrować</item><item value=\"2\" correct=\"false\">Z zapytaniem jest wszystko w porządku</item></selection><p visible-if=\"wrong\">Najpierw powinno wybrać elementy, a dopiero potem je filtrować.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Zapytanie filtruje firmy, których okres działalności nie wynosi 3 lat. Co musi znaleźć się przed <code>FROM</code>, aby zapytanie było kompletne?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"FROM companies\" /><text type=\"break\" /><text value=\"WHERE years_active &lt;&gt; 3;\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Klauzula SELECT określająca, co ma zostać zwrócone.</item><item value=\"2\" correct=\"false\">Klauzula ORDER BY sortująca wiersze.</item><item value=\"3\" correct=\"false\">Klauzula VALUES tworząca nowe wiersze.</item></selection><p visible-if=\"wrong\">Klauzula SELECT określająca, co ma zostać zwrócone.</p></body></html>"
          },
          {
            "title": "Question: The inequality operator",
            "id": 91746,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jakiego operatora używamy do sprawdzania, czy dwie wartości są <em>różne</em>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>&lt;&gt;</code></item><item value=\"2\" correct=\"false\"><code>=</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>&lt;&gt;</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Operator nierówności sprawdza, czy dwie wartości są różne.</p><p>Potrzebujesz wierszy, w których wartość <code>years_active</code> jest inna niż <code>3</code>. Który operator wyraża ten warunek?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>&lt;&gt;</code></item><item value=\"2\" correct=\"false\"><code>=</code></item><item value=\"3\" correct=\"false\"><code>&gt;</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>&lt;&gt;</code>.</p></body></html>"
          },
          {
            "title": "Question: The inequality operator 2",
            "id": 91747,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Którego elementu będzie brakować w tabeli wyników?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE companies (&#xA;name varchar(255),&#xA;years_active int&#xA;);&#xA;&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Rocket Delivery', 3);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Teachya', 1);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Hyped', 8);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Thread Co.', 1);\"><tables><table name=\"companies\"><row><header content=\"name\" /><header content=\"years_active\" /></row><row><data content=\"Rocket Delivery\" /><data content=\"3\" /></row><row><data content=\"Teachya\" /><data content=\"1\" /></row><row><data content=\"Hyped\" /><data content=\"8\" /></row><row><data content=\"Thread Co.\" /><data content=\"1\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" companies\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" years_active &lt;&gt; \" /><text value=\"8\" class=\"number\" /><text value=\";\" /></content><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"years_active\" /></row><row><data content=\"Rocket Delivery\" /><data content=\"3\" /></row><row><data content=\"Teachya\" /><data content=\"1\" /></row><row><data content=\"Thread Co.\" /><data content=\"1\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>Hyped</code>, <code>8</code></item><item value=\"2\" correct=\"false\"><code>Rocket Delivery</code>, <code>3</code></item></selection><p visible-if=\"wrong\"><code>Hyped</code>, <code>8</code>.</p></body></html>"
          },
          {
            "title": "Question: Inequality with text values",
            "id": 91748,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Z jakimi rodzajami wartości możemy używać operatora nierówności <code>&lt;&gt;</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Dowolnego rodzaju, na przykład tekst i liczby</item><item value=\"2\" correct=\"false\">Tylko liczby</item></selection><p visible-if=\"wrong\">Dowolnego rodzaju, na przykład tekst i liczby.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Operator nierówności <code>&lt;&gt;</code> działa z wartościami takimi jak tekst i liczby.</p><p>W którym filtrze można prawidłowo użyć operatora <code>&lt;&gt;</code>, aby wykluczyć jedną konkretną wartość?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Wyklucz wartość tekstową <code>'closed'</code> z kolumny statusu.</item><item value=\"2\" correct=\"false\">Zmień kolumnę liczbową na tekst.</item><item value=\"3\" correct=\"false\">Dodaj do siebie dwie wartości liczbowe.</item></selection><p visible-if=\"wrong\">Wyklucz wartość tekstową <code>'closed'</code> z kolumny statusu.</p></body></html>"
          },
          {
            "title": "Example: Doesn't satisfy a condition",
            "id": 91749,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zakoduj warunek, aby wybrać wszystkie elementy <code>companies</code>, dla których <code>years_active</code> nie jest równe <code>3</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE companies (&#xA;name varchar(255),&#xA;years_active int&#xA;);&#xA;&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Rocket Delivery', 3);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Teachya', 1);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Hyped', 8);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Thread Co.', 1);\"><tables><table name=\"companies\"><row><header content=\"name\" /><header content=\"years_active\" /></row><row><data content=\"Rocket Delivery\" /><data content=\"3\" /></row><row><data content=\"Teachya\" /><data content=\"1\" /></row><row><data content=\"Hyped\" /><data content=\"8\" /></row><row><data content=\"Thread Co.\" /><data content=\"1\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" companies\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" years_active &lt;&gt; \" /><text value=\"3\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"24\" endIndex=\"29\" /><option correct=\"false\"><content><text value=\"years_active = 3\" /></content></option><option startIndex=\"30\" endIndex=\"47\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"years_active\" /></row><row><data content=\"Teachya\" /><data content=\"1\" /></row><row><data content=\"Hyped\" /><data content=\"8\" /></row><row><data content=\"Thread Co.\" /><data content=\"1\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>WHERE</code>, a następnie <code>years_active &lt;&gt; 3</code>.</p></body></html>"
          },
          {
            "title": "Example: The inequality operator",
            "id": 91751,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wybierz wszystkie elementy z tabeli <code>companies</code> przed ich filtrowaniem.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE companies (&#xA;name varchar(255),&#xA;years_active int&#xA;);&#xA;&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Rocket Delivery', 3);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Teachya', 1);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Hyped', 8);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Thread Co.', 1);\"><tables><table name=\"companies\"><row><header content=\"name\" /><header content=\"years_active\" /></row><row><data content=\"Rocket Delivery\" /><data content=\"3\" /></row><row><data content=\"Teachya\" /><data content=\"1\" /></row><row><data content=\"Hyped\" /><data content=\"8\" /></row><row><data content=\"Thread Co.\" /><data content=\"1\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" companies;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"8\" /><option startIndex=\"9\" endIndex=\"13\" /><option startIndex=\"14\" endIndex=\"23\" /><option correct=\"false\"><content><text value=\"name\" /></content></option><option startIndex=\"23\" endIndex=\"24\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"years_active\" /></row><row><data content=\"Rocket Delivery\" /><data content=\"3\" /></row><row><data content=\"Teachya\" /><data content=\"1\" /></row><row><data content=\"Hyped\" /><data content=\"8\" /></row><row><data content=\"Thread Co.\" /><data content=\"1\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>SELECT</code>, następnie <code>*</code>, a potem <code>FROM</code>, <code>companies</code>, <code>;</code>.</p></body></html>"
          },
          {
            "title": "Example: The inequality operator 2",
            "id": 91752,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Użyj kodu <code>years_active</code>, operatora nierówności <code>&lt;&gt;</code> oraz <code>1</code>, aby filtrować firmy, które nie działają od jednego roku.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE companies (&#xA;name varchar(255),&#xA;years_active int&#xA;);&#xA;&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Rocket Delivery', 3);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Teachya', 1);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Hyped', 8);&#xA;INSERT INTO companies (name, years_active)&#xA;VALUES ('Thread Co.', 1);\"><tables><table name=\"companies\"><row><header content=\"name\" /><header content=\"years_active\" /></row><row><data content=\"Rocket Delivery\" /><data content=\"3\" /></row><row><data content=\"Teachya\" /><data content=\"1\" /></row><row><data content=\"Hyped\" /><data content=\"8\" /></row><row><data content=\"Thread Co.\" /><data content=\"1\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" companies\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" years_active &lt;&gt; \" /><text value=\"1\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"30\" endIndex=\"47\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"years_active\" /></row><row><data content=\"Rocket Delivery\" /><data content=\"3\" /></row><row><data content=\"Hyped\" /><data content=\"8\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>years_active &lt;&gt; 1</code>.</p></body></html>"
          },
          {
            "title": "Example: Inequality with text values",
            "id": 91753,
