            "id": 148389,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Uzupełnij składnię wywołania funkcji <code>.reduce()</code> dla tablicy <code>coinPickups</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"60\" endIndex=\"78\" isDefault=\"true\" /></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" coinPickups = [\" /><text value=\"20\" class=\"number\" /><text value=\", \" /><text value=\"21\" class=\"number\" /><text value=\", \" /><text value=\"5\" class=\"number\" /><text value=\", \" /><text value=\"12\" class=\"number\" /><text value=\", \" /><text value=\"13\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" totalCoins = coinPickups.reduce(\" /><text value=\"function\" class=\"keyword\" /><text value=\"(\" /><text value=\"prevVal, currVal\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" prevVal + currVal;\" /><text type=\"break\" /><text value=\"});\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(totalCoins);}\" /></content></code><p visible-if=\"wrong\">Koniecznie wpisz <code>coinPickups.reduce</code>.</p></body></html>"
          },
