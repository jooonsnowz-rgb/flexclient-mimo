            "id": 146682,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co się dzieje, gdy warunek tej pętli while pozostaje <code>true</code>?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"while\" class=\"keyword\" /><text value=\" (\" /><text value=\"true\" class=\"literal\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Player is still playing!&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Pętla powtarza się w nieskończoność i powoduje awarię programu</item><item value=\"2\" correct=\"false\">Pętla wykonuje swój blok kodu jeden raz</item></selection><p visible-if=\"wrong\">Pętla powtarza się w nieskończoność i powoduje awarię programu.</p></body></html>"
          },
