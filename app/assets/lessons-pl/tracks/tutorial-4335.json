            "id": 146683,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dodaj słowo kluczowe, aby utworzyć pętlę while.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"if\" /></content></option><option correct=\"false\"><content><text value=\"false\" /></content></option><option startIndex=\"0\" endIndex=\"5\" /></options></interaction></interactions><content><text value=\"while\" class=\"keyword\" /><text value=\" (\" /><text value=\"false\" class=\"literal\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Pause screen&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>while</code>.</p></body></html>"
          },
          {
