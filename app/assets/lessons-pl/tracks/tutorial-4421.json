            "title": "Lesson #9",
            "id": 148038,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dodaj parametr do funkcji, a następnie wywołaj ją z wartością.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"var\" /></content></option><option startIndex=\"28\" endIndex=\"34\" /><option startIndex=\"113\" endIndex=\"115\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"updatePlayerHealth\" class=\"title\" /><text value=\"(\" /><text value=\"health\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Player health:&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(health);\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"updatePlayerHealth(\" /><text value=\"60\" class=\"number\" /><text value=\");\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>health</code>, a następnie <code>60</code>.</p></body></html>"
