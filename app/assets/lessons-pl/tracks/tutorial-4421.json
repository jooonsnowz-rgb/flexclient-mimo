            "id": 148039,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dokończ wywołanie funkcji.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"86\" endIndex=\"94\" isDefault=\"true\" /></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"addScore\" class=\"title\" /><text value=\"(\" /><text value=\"amount\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" label = \" /><text value=\"&quot; points&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(amount + label);\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"addScore(\" /><text value=\"250\" class=\"number\" /><text value=\");}\" /></content></code><p visible-if=\"wrong\">Koniecznie wpisz <code>addScore</code>.</p></body></html>"
