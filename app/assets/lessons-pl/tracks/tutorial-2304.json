          {
            "title": "Example: Subquery",
            "id": 113137,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wybierz <code>name</code> najnowszej gry.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" = \" /><text type=\"break\" /><text value=\"(\" /><text type=\"break\" /><text value=\" \" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"MAX\" class=\"keyword\" /><text value=\"(\" /><text value=\"release\" class=\"keyword\" /><text value=\") \" /><text type=\"break\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"MIN\" /></content></option><option startIndex=\"76\" endIndex=\"87\" /><option startIndex=\"7\" endIndex=\"11\" /><option startIndex=\"17\" endIndex=\"28\" /><option startIndex=\"56\" endIndex=\"68\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /></row><row><data content=\"Super Mario 3D World\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>name</code>, następnie <code>mario_games</code>, a potem <code>MAX(release)</code>, <code>mario_games</code>.</p></body></html>"
          },
          {
            "title": "Example: Subquery",
            "id": 113138,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wybierz <code>name</code> najstarszej gry, używając podzapytania z <code>MIN</code>, aby znaleźć najwcześniejszą wartość <code>release</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" = \" /><text type=\"break\" /><text value=\"(\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"MIN\" class=\"keyword\" /><text value=\"(\" /><text value=\"release\" class=\"keyword\" /><text value=\") \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games);\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"47\" endIndex=\"83\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /></row><row><data content=\"Mario Bros.\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>SELECT MIN(release) FROM mario_games</code>.</p></body></html>"
          },
          {
            "title": "Question: Only within the query",
            "id": 113136,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Czego szuka to zapytanie?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" &gt; \" /><text type=\"break\" /><text value=\"(\" /><text type=\"break\" /><text value=\" \" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"AVG\" class=\"keyword\" /><text value=\"(\" /><text value=\"release\" class=\"keyword\" /><text value=\") \" /><text type=\"break\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\");\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Nazwy wszystkich gier wydanych po średnim roku wydania</item><item value=\"2\" correct=\"false\">Średni rok wydania wszystkich gier</item><item value=\"3\" correct=\"false\">Nazwa wszystkich gier wydanych przed średnim rokiem wydania</item></selection><p visible-if=\"wrong\">Nazwy wszystkich gier wydanych po średnim roku wydania.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Załóżmy, że podzapytanie zwraca <code>2005</code> jako średni rok wydania. Które gry może zwrócić zapytanie zewnętrzne?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" &gt; \" /><text type=\"break\" /><text value=\"(\" /><text type=\"break\" /><text value=\" \" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"AVG\" class=\"keyword\" /><text value=\"(\" /><text value=\"release\" class=\"keyword\" /><text value=\") \" /><text type=\"break\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\");\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Gry wydane po <code>2005</code> roku</item><item value=\"2\" correct=\"false\">Jeden wiersz zawierający rok <code>2005</code></item><item value=\"3\" correct=\"false\">Gry wydane przed <code>2005</code> rokiem</item></selection><p visible-if=\"wrong\">Koniecznie wybierz Gry wydane po <code>2005</code> roku.</p></body></html>"
          },
          {
            "title": "Question: Another table",
            "id": 114257,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co powinniśmy zrobić inaczej, gdy piszemy podzapytanie dotyczące innej tabeli?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Nic, oba podzapytania używają tych samych słów kluczowych i mają te same reguły</item><item value=\"2\" correct=\"false\">Podzapytanie z innej tabeli musi używać aliasów dla kolumn</item><item value=\"3\" correct=\"false\">Podzapytanie z tej samej tabeli musi zwracać wiele kolumn</item></selection><p visible-if=\"wrong\">Nic, oba podzapytania używają tych samych słów kluczowych i mają te same reguły.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Zapytanie zewnętrzne odczytuje zamówienia, a jego podzapytanie odczytuje identyfikatory klientów. Jaka dodatkowa składnia jest wymagana wyłącznie dlatego, że tabele są różne?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Żadna, podzapytanie podlega tym samym regułom SQL</item><item value=\"2\" correct=\"false\">Alias każdej kolumny w podzapytaniu</item><item value=\"3\" correct=\"false\"><code>JOIN</code> wewnątrz podzapytania</item></selection><p visible-if=\"wrong\">Żadna, podzapytanie podlega tym samym regułom SQL.</p></body></html>"
          },
          {
            "title": "Example: Another table",
            "id": 114258,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Elementy w <code>snack</code> są powiązane z informacjami o wartościach odżywczych w <code>macros</code> za pośrednictwem wspólnego <code>ID</code>. Znajdź informacje o makroskładnikach dla jabłka.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE snack (&#xA; id varchar(255),&#xA; name varchar(255), &#xA; type varchar(255)&#xA;);&#xA;&#xA;INSERT INTO snack (id, name, type)&#xA;VALUES ('001', 'apple', 'vegan');&#xA;INSERT INTO snack (id, name, type)&#xA;VALUES ('133', 'Cheerios', 'vegan');&#xA;INSERT INTO snack (id, name, type)&#xA;VALUES ('455', 'chocolate', 'vegetarian');&#xA;INSERT INTO snack (id, name, type)&#xA;VALUES ('060', 'cashews', 'vegan');&#xA;&#xA;&#xA;&#xA;&#xA;CREATE TABLE macros (&#xA; id varchar(255),&#xA; carbs_g numeric,&#xA; protein_g numeric,&#xA; fat_g numeric&#xA;);&#xA;&#xA;INSERT INTO macros (id, carbs_g, protein_g, fat_g)&#xA;VALUES ('001', 14, 0.2, 0.2 );&#xA;INSERT INTO macros (id, carbs_g, protein_g, fat_g)&#xA;VALUES ('455', 2, 15, 12 );&#xA;INSERT INTO macros (id, carbs_g, protein_g, fat_g)&#xA;VALUES ('111', 0, 25, 7);&#xA;\"><tables><table name=\"snack\"><row><header content=\"id\" /><header content=\"name\" /><header content=\"type\" /></row><row><data content=\"001\" /><data content=\"apple\" /><data content=\"vegan\" /></row><row><data content=\"133\" /><data content=\"Cheerios\" /><data content=\"vegan\" /></row><row><data content=\"455\" /><data content=\"chocolate\" /><data content=\"vegetarian\" /></row><row><data content=\"060\" /><data content=\"cashews\" /><data content=\"vegan\" /></row></table><table name=\"macros\"><row><header content=\"id\" /><header content=\"carbs_g\" /><header content=\"protein_g\" /><header content=\"fat_g\" /></row><row><data content=\"001\" /><data content=\"14\" /><data content=\"0.2\" /><data content=\"0.2\" /></row><row><data content=\"455\" /><data content=\"2\" /><data content=\"15\" /><data content=\"12\" /></row><row><data content=\"111\" /><data content=\"0\" /><data content=\"25\" /><data content=\"7\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" carbs_g, protein_g, fat_g\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" macros\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"id\" class=\"keyword\" /><text value=\" = \" /><text type=\"break\" /><text value=\"(\" /><text type=\"break\" /><text value=\" \" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"id\" class=\"keyword\" /><text type=\"break\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" snack\" /><text type=\"break\" /><text value=\" \" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" = \" /><text value=\"'apple'\" class=\"string\" /><text type=\"break\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"76\" endIndex=\"81\" /><option startIndex=\"83\" endIndex=\"88\" /><option startIndex=\"89\" endIndex=\"93\" /><option startIndex=\"94\" endIndex=\"95\" /><option startIndex=\"96\" endIndex=\"103\" /><option correct=\"false\"><content><text value=\"*\" /></content></option><option startIndex=\"67\" endIndex=\"69\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"carbs_g\" /><header content=\"protein_g\" /><header content=\"fat_g\" /></row><row><data content=\"14\" /><data content=\"0.2\" /><data content=\"0.2\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>id</code>, następnie <code>snack</code>, a potem <code>WHERE</code>, <code>name</code>, <code>=</code>, <code>'apple'</code>.</p></body></html>"
          },
          {
            "title": "Example: IN budget greater",
            "id": 113299,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wybierz wszystkich pracowników, których dział ma budżet większy niż 1800.</p><database visible-if=\"always\" bootstrapScript=\"&#xA;&#xA;CREATE TABLE employees (&#xA; employee_id INT (11),&#xA; first_name VARCHAR (20) DEFAULT NULL,&#xA; last_name VARCHAR (25) NOT NULL,&#xA; department_id INT (11) DEFAULT NULL&#xA;&#xA;);&#xA;CREATE TABLE departments (&#xA; department_id INT (11),&#xA; department_name VARCHAR (30) NOT NULL,&#xA; budget INT (11) DEFAULT NULL&#xA;);&#xA;INSERT INTO departments(department_id,department_name,budget) VALUES (1,'Administration',1700);&#xA;INSERT INTO departments(department_id,department_name,budget) VALUES (2,'Marketing',1800);&#xA;INSERT INTO departments(department_id,department_name,budget) VALUES (3,'Purchasing',1700);&#xA;INSERT INTO departments(department_id,department_name,budget) VALUES (4,'Human Resources',2400);&#xA;INSERT INTO departments(department_id,department_name,budget) VALUES (5,'Shipping',1500);&#xA;&#xA;&#xA;INSERT INTO employees(employee_id,first_name,last_name,department_id) VALUES (100,'Steven','King',4);&#xA;INSERT INTO employees(employee_id,first_name,last_name,department_id) VALUES (101,'Neena','Kochhar',9);&#xA;INSERT INTO employees(employee_id,first_name,last_name,department_id) VALUES (102,'Lex','De Haan',9);&#xA;INSERT INTO employees(employee_id,first_name,last_name,department_id) VALUES (103,'Alexander','Hunold',6);&#xA;INSERT INTO employees(employee_id,first_name,last_name,department_id) VALUES (104,'Bruce','Ernst',6);&#xA;\"><tables><table name=\"employees\"><row><header content=\"employee_id\" /><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"department_id\" /></row><row><data content=\"100\" /><data content=\"Steven\" /><data content=\"King\" /><data content=\"4\" /></row><row><data content=\"101\" /><data content=\"Neena\" /><data content=\"Kochhar\" /><data content=\"9\" /></row><row><data content=\"102\" /><data content=\"Lex\" /><data content=\"De Haan\" /><data content=\"9\" /></row><row><data content=\"103\" /><data content=\"Alexander\" /><data content=\"Hunold\" /><data content=\"6\" /></row><row><data content=\"104\" /><data content=\"Bruce\" /><data content=\"Ernst\" /><data content=\"6\" /></row></table><table name=\"departments\"><row><header content=\"department_id\" /><header content=\"department_name\" /><header content=\"budget\" /></row><row><data content=\"1\" /><data content=\"Administration\" /><data content=\"1700\" /></row><row><data content=\"2\" /><data content=\"Marketing\" /><data content=\"1800\" /></row><row><data content=\"3\" /><data content=\"Purchasing\" /><data content=\"1700\" /></row><row><data content=\"4\" /><data content=\"Human Resources\" /><data content=\"2400\" /></row><row><data content=\"5\" /><data content=\"Shipping\" /><data content=\"1500\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text type=\"break\" /><text value=\"employees\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text type=\"break\" /><text value=\"department_id \" /><text value=\"IN\" class=\"keyword\" /><text value=\" \" /><text type=\"break\" /><text value=\"( \" /><text type=\"break\" /><text value=\" \" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" department_id \" /><text type=\"break\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" departments \" /><text type=\"break\" /><text value=\" \" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" budget &gt; \" /><text value=\"1800\" class=\"number\" /><text type=\"break\" /><text value=\");\" /><text type=\"break\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"60\" endIndex=\"73\" /><option startIndex=\"81\" endIndex=\"92\" /><option startIndex=\"101\" endIndex=\"107\" /><option startIndex=\"108\" endIndex=\"109\" /><option startIndex=\"110\" endIndex=\"114\" /><option correct=\"false\"><content><text value=\"NOT\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"employee_id\" /><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"department_id\" /></row><row><data content=\"100\" /><data content=\"Steven\" /><data content=\"King\" /><data content=\"4\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>department_id</code>, następnie <code>departments</code>, a potem <code>budget</code>, <code>&gt;</code>, <code>1800</code>.</p></body></html>"
          },
          {
            "title": "Question: whats wrong",
            "id": 113298,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co jest nie tak z tym zapytaniem?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" employees\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" department_id = (\" /><text type=\"break\" /><text value=\" \" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" department_id\" /><text type=\"break\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" departments\" /><text type=\"break\" /><text value=\" \" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" budget &gt; \" /><text value=\"2000\" class=\"number\" /><text type=\"break\" /><text value=\");\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Używa <code>=</code> z podzapytaniem obejmującym wiele wierszy</item><item value=\"2\" correct=\"false\">Podzapytania nie mogą używać <code>WHERE</code></item><item value=\"3\" correct=\"false\">Podzapytanie zwraca wiele kolumn</item></selection><p visible-if=\"wrong\">Używa <code>=</code> z podzapytaniem obejmującym wiele wierszy.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Podzapytanie może zwrócić kilka wartości <code>department_id</code> z budżetem powyżej <code>2000</code>. Która zmiana naprawia warunek zewnętrzny?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" employees\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" department_id = (\" /><text type=\"break\" /><text value=\" \" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" department_id\" /><text type=\"break\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" departments\" /><text type=\"break\" /><text value=\" \" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" budget &gt; \" /><text value=\"2000\" class=\"number\" /><text type=\"break\" /><text value=\");\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Zastąp <code>=</code> słowem <code>IN</code></item><item value=\"2\" correct=\"false\">Usuń klauzulę <code>WHERE</code> podzapytania</item><item value=\"3\" correct=\"false\">Zmień podzapytanie na <code>SELECT *</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz Zastąp <code>=</code> słowem <code>IN</code>.</p></body></html>"
          },
          {
            "title": "Example: IN department name",
            "id": 113300,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wybierz wszystkich pracowników, którzy pracują w dziale marketingu lub sprzedaży.</p><database visible-if=\"always\" bootstrapScript=\"&#xA;&#xA;CREATE TABLE employees (&#xA; employee_id INT (11),&#xA; first_name VARCHAR (20) DEFAULT NULL,&#xA; last_name VARCHAR (25) NOT NULL,&#xA; department_id INT (11) DEFAULT NULL&#xA;&#xA;);&#xA;CREATE TABLE departments (&#xA; department_id INT (11),&#xA; department_name VARCHAR (30) NOT NULL,&#xA; budget INT (11) DEFAULT NULL&#xA;);&#xA;INSERT INTO departments(department_id,department_name,budget) VALUES (1,'Administration',1700);&#xA;INSERT INTO departments(department_id,department_name,budget) VALUES (2,'Marketing',1800);&#xA;INSERT INTO departments(department_id,department_name,budget) VALUES (3,'Purchasing',1700);&#xA;INSERT INTO departments(department_id,department_name,budget) VALUES (4,'Human Resources',2400);&#xA;INSERT INTO departments(department_id,department_name,budget) VALUES (5,'Sales',1500);&#xA;&#xA;&#xA;INSERT INTO employees(employee_id,first_name,last_name,department_id) VALUES (100,'Steven','King',2);&#xA;INSERT INTO employees(employee_id,first_name,last_name,department_id) VALUES (101,'Neena','Kochhar',9);&#xA;INSERT INTO employees(employee_id,first_name,last_name,department_id) VALUES (102,'Lex','De Haan',9);&#xA;INSERT INTO employees(employee_id,first_name,last_name,department_id) VALUES (103,'Alexander','Hunold',5);&#xA;INSERT INTO employees(employee_id,first_name,last_name,department_id) VALUES (104,'Bruce','Ernst',6);&#xA;\"><tables><table name=\"employees\"><row><header content=\"employee_id\" /><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"department_id\" /></row><row><data content=\"100\" /><data content=\"Steven\" /><data content=\"King\" /><data content=\"2\" /></row><row><data content=\"101\" /><data content=\"Neena\" /><data content=\"Kochhar\" /><data content=\"9\" /></row><row><data content=\"102\" /><data content=\"Lex\" /><data content=\"De Haan\" /><data content=\"9\" /></row><row><data content=\"103\" /><data content=\"Alexander\" /><data content=\"Hunold\" /><data content=\"5\" /></row><row><data content=\"104\" /><data content=\"Bruce\" /><data content=\"Ernst\" /><data content=\"6\" /></row></table><table name=\"departments\"><row><header content=\"department_id\" /><header content=\"department_name\" /><header content=\"budget\" /></row><row><data content=\"1\" /><data content=\"Administration\" /><data content=\"1700\" /></row><row><data content=\"2\" /><data content=\"Marketing\" /><data content=\"1800\" /></row><row><data content=\"3\" /><data content=\"Purchasing\" /><data content=\"1700\" /></row><row><data content=\"4\" /><data content=\"Human Resources\" /><data content=\"2400\" /></row><row><data content=\"5\" /><data content=\"Sales\" /><data content=\"1500\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text type=\"break\" /><text value=\"employees\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text type=\"break\" /><text value=\"department_id \" /><text value=\"IN\" class=\"keyword\" /><text value=\" \" /><text type=\"break\" /><text value=\"( \" /><text type=\"break\" /><text value=\" \" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" department_id \" /><text type=\"break\" /><text value=\" \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" departments \" /><text type=\"break\" /><text value=\" \" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" department_name = \" /><text value=\"'Marketing'\" class=\"string\" /><text value=\" \" /><text type=\"break\" /><text value=\" \" /><text value=\"OR\" class=\"keyword\" /><text value=\" department_name = \" /><text value=\"'Sales'\" class=\"string\" /><text type=\"break\" /><text value=\");\" /><text type=\"break\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"133\" endIndex=\"161\" /></interactions><output><table name=\"Result\"><row><header content=\"employee_id\" /><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"department_id\" /></row><row><data content=\"100\" /><data content=\"Steven\" /><data content=\"King\" /><data content=\"2\" /></row><row><data content=\"103\" /><data content=\"Alexander\" /><data content=\"Hunold\" /><data content=\"5\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>OR department_name = 'Sales'</code>.</p></body></html>"
          },
          {
            "title": "Question: NOT IN",
            "id": 114346,
