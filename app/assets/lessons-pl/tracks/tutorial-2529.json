            "id": 126709,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Użytkownicy mogą się zalogować, jeśli <em>nie</em> obleją testu na bota. Użyj operatora, aby sprawdzić, czy użytkownik może się zalogować.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"var\" class=\"keyword\" /><text value=\" failedBotTest = \" /><text value=\"false\" class=\"literal\" /><text value=\" \" /><text type=\"break\" /><text value=\"let\" class=\"keyword\" /><text value=\" loggedIn = !failedBotTest \" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Logged in? : \\(loggedIn)&quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"42\" endIndex=\"43\" /><option correct=\"false\"><content><text value=\"||\" /></content></option><option correct=\"false\"><content><text value=\"&amp;&amp;\" /></content></option></options></interaction></interactions><output><content><text value=\"Logged in? : true\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>!</code>.</p></body></html>"
