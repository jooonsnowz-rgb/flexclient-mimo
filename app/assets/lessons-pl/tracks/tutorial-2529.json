            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Spraw, aby ten kod wyświetlał <code>true</code>.</p><code name=\"main.swift\" version=\"2\" codelang=\"swift\"><content><text value=\"let\" class=\"keyword\" /><text value=\" age = \" /><text value=\"21\" class=\"number\" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(age &lt; \" /><text value=\"26\" class=\"number\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"26\" /></content></option><option correct=\"false\"><content><text value=\"27\" /></content></option><option startIndex=\"10\" endIndex=\"12\" /></options></interaction></interactions><output><content><text value=\"true\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>21</code>.</p></body></html>"
