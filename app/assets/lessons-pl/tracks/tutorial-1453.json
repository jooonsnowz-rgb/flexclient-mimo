          {
            "title": "NOT",
            "id": 94557,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Aby uzyskać elementy, które nie spełniają warunku, wpisz <code>NOT</code> między nazwą kolumny a operatorem warunku.<br /></p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; year int,&#xA; major varchar(255)&#xA;);&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Ava Smith', 1, 'Biology');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Luis Garcia', 1, 'Physics');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Lin Wong', 3, 'Biology');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Sam Mitchell', 2, 'History');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Nora Hansen', 4, 'Biology');\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row><row><data content=\"Sam Mitchell\" /><data content=\"2\" /><data content=\"History\" /></row><row><data content=\"Nora Hansen\" /><data content=\"4\" /><data content=\"Biology\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"NOT\" class=\"keyword\" /><text value=\" \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'a%'\" class=\"string\" /><text value=\" ;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"34\" endIndex=\"37\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row><row><data content=\"Sam Mitchell\" /><data content=\"2\" /><data content=\"History\" /></row><row><data content=\"Nora Hansen\" /><data content=\"4\" /><data content=\"Biology\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>NOT</code>.</p></body></html>"
          },
          {
            "title": "NOT LIKE",
            "id": 94558,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>NOT</code> używamy głównie z warunkami takimi jak <code>IN</code>, <code>BETWEEN</code> i <code>LIKE</code>. Tutaj pobieramy elementy, których <code>name</code> nie zawiera <code>a</code>.<br /></p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; year int,&#xA; major varchar(255)&#xA;);&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Ava Smith', 1, 'Biology');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Luis Garcia', 1, 'Physics');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Lin Wong', 3, 'Biology');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Sam Mitchell', 2, 'History');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Nora Hansen', 4, 'Biology');\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row><row><data content=\"Sam Mitchell\" /><data content=\"2\" /><data content=\"History\" /></row><row><data content=\"Nora Hansen\" /><data content=\"4\" /><data content=\"Biology\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"NOT\" class=\"keyword\" /><text value=\" \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'%a%'\" class=\"string\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"34\" endIndex=\"42\" /><option correct=\"false\"><content><text value=\"BETWEEN\" /></content></option><option startIndex=\"43\" endIndex=\"48\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>NOT LIKE</code>, a następnie <code>'%a%'</code>.</p></body></html>"
          },
          {
            "title": "NOT IN",
            "id": 94559,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zakodowanie <code>NOT IN ('History', 'Physics')</code> zwraca wszystkie elementy z wartością <code>major</code> inną niż <code>'History'</code> lub <code>'Physics'</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; year int,&#xA; major varchar(255)&#xA;);&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Ava Smith', 1, 'Biology');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Luis Garcia', 1, 'Physics');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Lin Wong', 3, 'Biology');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Sam Mitchell', 2, 'History');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Nora Hansen', 4, 'Biology');\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row><row><data content=\"Sam Mitchell\" /><data content=\"2\" /><data content=\"History\" /></row><row><data content=\"Nora Hansen\" /><data content=\"4\" /><data content=\"Biology\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" major \" /><text value=\"NOT\" class=\"keyword\" /><text value=\" \" /><text value=\"IN\" class=\"keyword\" /><text value=\" (\" /><text value=\"'History'\" class=\"string\" /><text value=\", \" /><text value=\"'Physics'\" class=\"string\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"35\" endIndex=\"41\" /><option startIndex=\"42\" endIndex=\"64\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row><row><data content=\"Nora Hansen\" /><data content=\"4\" /><data content=\"Biology\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>NOT IN</code>, a następnie <code>('History', 'Physics')</code>.</p></body></html>"
          },
          {
            "title": "NOT BETWEEN",
            "id": 94560,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zakodowanie <code>NOT BETWEEN 1 AND 3</code> daje nam elementy z wartością <code>year</code> mniejszą niż <code>1</code> lub większą niż <code>3</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; year int,&#xA; major varchar(255)&#xA;);&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Ava Smith', 1, 'Biology');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Luis Garcia', 1, 'Physics');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Lin Wong', 3, 'Biology');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Sam Mitchell', 2, 'History');&#xA;&#xA;INSERT INTO students (name, year, major)&#xA;VALUES ('Nora Hansen', 4, 'Biology');\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Ava Smith\" /><data content=\"1\" /><data content=\"Biology\" /></row><row><data content=\"Luis Garcia\" /><data content=\"1\" /><data content=\"Physics\" /></row><row><data content=\"Lin Wong\" /><data content=\"3\" /><data content=\"Biology\" /></row><row><data content=\"Sam Mitchell\" /><data content=\"2\" /><data content=\"History\" /></row><row><data content=\"Nora Hansen\" /><data content=\"4\" /><data content=\"Biology\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" \" /><text value=\"NOT\" class=\"keyword\" /><text value=\" \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"1\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"3\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"34\" endIndex=\"37\" /><option startIndex=\"38\" endIndex=\"45\" /><option startIndex=\"46\" endIndex=\"47\" /><option startIndex=\"48\" endIndex=\"51\" /><option startIndex=\"52\" endIndex=\"53\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"year\" /><header content=\"major\" /></row><row><data content=\"Nora Hansen\" /><data content=\"4\" /><data content=\"Biology\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>NOT</code>, następnie <code>BETWEEN</code>, a potem <code>1</code>, <code>AND</code>, <code>3</code>.</p></body></html>"
          },
          {
            "title": "Question: Intro",
            "id": 96009,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Kiedy używamy słowa kluczowego <code>NOT</code> w klauzuli <code>WHERE</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Gdy chcemy wybrać elementy, które nie spełniają warunku</item><item value=\"2\" correct=\"false\">Gdy chcemy wybrać elementy spełniające warunek</item></selection><p visible-if=\"wrong\">Gdy chcemy wybrać elementy, które nie spełniają warunku.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Filtr używa <code>NOT</code>, aby odwrócić warunek <code>year = 1970</code>. Masz elementy z lat <code>1970</code> i <code>1980</code>.</p><p>Które elementy pozostaną?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Tylko elementy z 1980 roku</item><item value=\"2\" correct=\"false\">Tylko elementy z 1970 roku</item><item value=\"3\" correct=\"false\">Elementy z obu lat</item></selection><p visible-if=\"wrong\">Tylko elementy z 1980 roku.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Question: NOT",
            "id": 96010,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co wybiera to zapytanie?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" inventory\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" manufacturer \" /><text value=\"NOT\" class=\"keyword\" /><text value=\" \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'f%'\" class=\"string\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Elementy, których <code>manufacturer</code> nie zaczyna się na literę f</item><item value=\"2\" correct=\"false\">Elementy z wartością <code>manufacturer</code> zaczynającą się na literę f</item></selection><p visible-if=\"wrong\">Elementy, których <code>manufacturer</code> nie zaczyna się na literę f.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>LIKE 'f%'</code> dopasowuje tekst zaczynający się od <code>f</code>. Znak <code>%</code> może zastąpić zero lub więcej znaków.</p><p>Masz producentów <code>futura</code>, <code>nova</code> i <code>forge</code>. Które wiersze wybierze to zapytanie?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" inventory\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" manufacturer \" /><text value=\"NOT\" class=\"keyword\" /><text value=\" \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'f%'\" class=\"string\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Tylko wiersz z <code>nova</code></item><item value=\"2\" correct=\"false\">Wiersze z <code>futura</code> i <code>forge</code></item><item value=\"3\" correct=\"false\">Wszystkie trzy wiersze, ponieważ <code>%</code> pasuje do każdego producenta</item></selection><p visible-if=\"wrong\">Koniecznie wybierz Tylko wiersz z <code>nova</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Question: NOT LIKE",
            "id": 96011,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Z jakimi warunkami możemy używać <code>NOT</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Dowolny typ, ale używamy go głównie w warunkach z <code>IN</code>, <code>BETWEEN</code> lub <code>LIKE</code></item><item value=\"2\" correct=\"false\">Tylko z warunkami <code>LIKE</code></item></selection><p visible-if=\"wrong\">Dowolny typ, ale używamy go głównie w warunkach z <code>IN</code>, <code>BETWEEN</code> lub <code>LIKE</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Za pomocą <code>NOT</code> możesz odwracać warunki z <code>IN</code>, <code>BETWEEN</code> lub <code>LIKE</code>.</p><p>Masz identyfikatory <code>2</code>, <code>3</code> i <code>4</code>. Który warunek wyklucza tylko <code>2</code> i <code>4</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>ID NOT IN (2, 4)</code></item><item value=\"2\" correct=\"false\"><code>ID NOT BETWEEN 2 AND 4</code></item><item value=\"3\" correct=\"false\"><code>ID IN (2, 4)</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>ID NOT IN (2, 4)</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Question: NOT IN",
            "id": 96012,
