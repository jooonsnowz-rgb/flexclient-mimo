              "hasVisualOutput": true,
              "files": [
                {
                  "name": "index.html",
                  "codeLanguage": "html",
                  "content": "<!doctype html>\n<html>\n  <head>\n    <link href=\"style.css\" rel=\"stylesheet\" type=\"text/css\"/>\n  </head>\n  <body>\n    <a>Home</a>\n    <a>About</a>\n    <a>Contact</a>\n  </body>\n</html>",
                  "solvedContent": null
                },
                {
