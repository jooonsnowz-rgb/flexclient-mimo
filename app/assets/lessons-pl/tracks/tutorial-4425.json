        "lessons": [
          {
            "title": "Lesson #1",
            "id": 148130,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wybierz właściwy znak, aby oddzielić dwa parametry.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\":\" /></content></option><option correct=\"false\"><content><text value=\";\" /></content></option><option correct=\"false\"><content><text value=\".\" /></content></option><option correct=\"false\"><content><text value=\"/\" /></content></option><option startIndex=\"24\" endIndex=\"25\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"spawnEnemy\" class=\"title\" /><text value=\"(\" /><text value=\"type, x\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" type + \" /><text value=\"&quot; at &quot;\" class=\"string\" /><text value=\" + x;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" enemyInfo = spawnEnemy(\" /><text value=\"&quot;slime&quot;\" class=\"string\" /><text value=\", \" /><text value=\"10\" class=\"number\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(enemyInfo);\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>,</code>.</p></body></html>"
          },
          {
            "title": "Lesson #2",
            "id": 148131,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jak przekazujemy wartości do funkcji z wieloma parametrami?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Wartości i parametry muszą być w tej samej kolejności</item><item value=\"2\" correct=\"false\">Możemy przekazywać wartości w dowolnej kolejności</item><item value=\"3\" correct=\"false\">Wartości i parametry muszą być w odwrotnej kolejności</item></selection><p visible-if=\"wrong\">Wartości i parametry muszą być w tej samej kolejności.</p></body></html>"
          },
          {
            "title": "Lesson #3",
            "id": 148132,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wybierz prawidłowe wartości, aby <code>\"Helene\"</code> wyświetlało się jako drugie, a <code>\"Joe\"</code> jako ostatnie.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"&quot;Mike&quot;\" /></content></option><option correct=\"false\"><content><text value=\"&quot;Elaine&quot;\" /></content></option><option startIndex=\"171\" endIndex=\"179\" /><option startIndex=\"179\" endIndex=\"180\" /><option startIndex=\"181\" endIndex=\"186\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"showLeaderboard\" class=\"title\" /><text value=\"(\" /><text value=\"first, second, third\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;1st: &quot;\" class=\"string\" /><text value=\" + first);\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;2nd: &quot;\" class=\"string\" /><text value=\" + second);\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;3rd: &quot;\" class=\"string\" /><text value=\" + third);\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"showLeaderboard(\" /><text value=\"&quot;Elaine&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Helene&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Joe&quot;\" class=\"string\" /><text value=\");\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>\"Helene\"</code>, następnie <code>,</code> i na końcu <code>\"Joe\"</code>.</p></body></html>"
          },
          {
            "title": "Lesson #4",
            "id": 148133,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co wyświetla ten kod w konsoli?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"addScore\" class=\"title\" /><text value=\"(\" /><text value=\"kills, coins, bonus\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" kills + coins + bonus;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" result = addScore(\" /><text value=\"100\" class=\"number\" /><text value=\", \" /><text value=\"20\" class=\"number\" /><text value=\", \" /><text value=\"3\" class=\"number\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(result);\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">123</item><item value=\"2\" correct=\"false\">100203</item><item value=\"4\" correct=\"false\">100+20+3</item></selection><p visible-if=\"wrong\">Koniecznie wybierz 123.</p></body></html>"
          },
          {
            "title": "Lesson #5",
            "id": 148134,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wybierz poprawny drugi parametr tej funkcji.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"8\" /></content></option><option correct=\"false\"><content><text value=\"&quot;8&quot;\" /></content></option><option startIndex=\"38\" endIndex=\"45\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"calculateDamage\" class=\"title\" /><text value=\"(\" /><text value=\"attackPower, defense\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" attackPower - defense;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" damage = calculateDamage(\" /><text value=\"25\" class=\"number\" /><text value=\", \" /><text value=\"8\" class=\"number\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(damage);\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>defense</code>.</p></body></html>"
          },
          {
            "title": "Lesson #6",
            "id": 148135,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Które z poniższych stwierdzeń jest prawdziwe w kontekście nazywania funkcji?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Nazwy funkcji powinny być jasne i opisywać, co robi funkcja</item><item value=\"2\" correct=\"false\">Możemy nazwać funkcję, jak tylko chcemy</item><item value=\"3\" correct=\"false\">Lepiej mieć długą i złożoną nazwę funkcji</item></selection><p visible-if=\"wrong\">Nazwy funkcji powinny być jasne i opisywać, co robi funkcja.</p></body></html>"
          },
          {
            "title": "Lesson #7",
            "id": 148136,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jaką wartość wyświetla poniższy kod?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"displayInventorySize\" class=\"title\" /><text value=\"(\" /><text value=\"items\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(items.length);\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" inventory = [\" /><text value=\"&quot;Potion&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Key&quot;\" class=\"string\" /><text value=\"];\" /><text type=\"break\" /><text value=\"displayInventorySize(inventory);\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>2</code></item><item value=\"2\" correct=\"false\"><code>1</code></item><item value=\"3\" correct=\"false\"><code>0</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>2</code>.</p></body></html>"
          },
          {
            "title": "Lesson #8",
            "id": 148137,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co wyświetla poniższy kod?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"const\" class=\"keyword\" /><text value=\" sprites = [\" /><text value=\"&quot;Hero&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Goblin&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Chest&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Dragon&quot;\" class=\"string\" /><text value=\"];\" /><text type=\"break\" /><text type=\"break\" /><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"processValues\" class=\"title\" /><text value=\"(\" /><text value=\"arr\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(arr[\" /><text value=\"3\" class=\"number\" /><text value=\"] + \" /><text value=\"&quot; and &quot;\" class=\"string\" /><text value=\" + arr[\" /><text value=\"2\" class=\"number\" /><text value=\"] +\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&quot; are the last two sprites in reverse order.&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"processValues(sprites);\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>Dragon and Chest are the last two sprites in reverse order</code></item><item value=\"2\" correct=\"false\"><code>Goblin and Hero are the last two sprites in reverse order</code></item><item value=\"3\" correct=\"false\"><code>Chest and Dragon are the last two sprites in reverse order</code></item></selection><p visible-if=\"wrong\"><code>Dragon and Chest are the last two sprites in reverse order</code>.</p></body></html>"
          },
          {
            "title": "Lesson #9",
            "id": 148138,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wybierz nazwę funkcji, która najlepiej pasuje do poniższej funkcji wyświetlającej nazwę użytkownika klienta.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"display()\" /></content></option><option correct=\"false\"><content><text value=\"display(player)\" /></content></option><option startIndex=\"9\" endIndex=\"32\" /><option startIndex=\"132\" endIndex=\"157\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"displayPlayerInfo\" class=\"title\" /><text value=\"(\" /><text value=\"info\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Name: &quot;\" class=\"string\" /><text value=\" + info[\" /><text value=\"0\" class=\"number\" /><text value=\"] + \" /><text value=\"&quot;, &quot;\" class=\"string\" /><text value=\" + \" /><text value=\"&quot;ID: &quot;\" class=\"string\" /><text value=\" + info[\" /><text value=\"1\" class=\"number\" /><text value=\"]);\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" player = [\" /><text value=\"&quot;Megan&quot;\" class=\"string\" /><text value=\", \" /><text value=\"2837434\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"displayPlayerInfo(player);\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>displayPlayerInfo(info)</code>, a następnie <code>displayPlayerInfo(player)</code>.</p></body></html>"
          },
          {
            "title": "Lesson #10",
            "id": 148139,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Uzupełnij poniższy kod, podając prawidłowe dane wejściowe.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"&quot;3&quot;,\" /></content></option><option correct=\"false\"><content><text value=\"&quot;5&quot;\" /></content></option><option startIndex=\"85\" endIndex=\"87\" /><option startIndex=\"88\" endIndex=\"89\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"sumNumbers\" class=\"title\" /><text value=\"(\" /><text value=\"numbers\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(numbers[\" /><text value=\"0\" class=\"number\" /><text value=\"] + numbers[\" /><text value=\"1\" class=\"number\" /><text value=\"]);\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" arr = [\" /><text value=\"3\" class=\"number\" /><text value=\", \" /><text value=\"5\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"sumNumbers(arr);\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>3,</code>, a następnie <code>5</code>.</p></body></html>"
          }
