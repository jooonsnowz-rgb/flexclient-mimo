            "interactiveContent": "<!DOCTYPE html ><html><body><p>Przypisz wartość <code>57</code> do stałej <code>let</code><code>score</code>.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" score = \" /><text value=\"57\" class=\"number\" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(score)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"3\" /><option startIndex=\"4\" endIndex=\"9\" /><option startIndex=\"10\" endIndex=\"11\" /><option startIndex=\"12\" endIndex=\"14\" /><option correct=\"false\"><content><text value=\"&quot;fifty-seven&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"57\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>let</code>, następnie <code>score</code>, a potem <code>=</code>, <code>57</code>.</p></body></html>"
