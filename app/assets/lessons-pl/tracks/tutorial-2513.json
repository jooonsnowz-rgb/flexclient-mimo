          {
            "title": "Example: Types",
            "id": 126561,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Przypisz <strong>łańcuch znaków</strong> do zmiennej <code>userName</code>, <strong>liczbę</strong> do <code>age</code> oraz <strong>wartość logiczną</strong> do <code>isMale</code>.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" userName = \" /><text value=\"&quot;Joey&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"let\" class=\"keyword\" /><text value=\" age = \" /><text value=\"28\" class=\"number\" /><text type=\"break\" /><text value=\"let\" class=\"keyword\" /><text value=\" isMale = \" /><text value=\"true\" class=\"literal\" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(userName, age, isMale)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"15\" endIndex=\"21\" /><option startIndex=\"32\" endIndex=\"34\" /><option startIndex=\"48\" endIndex=\"52\" /><option correct=\"false\"><content><text value=\"nil\" /></content></option></options></interaction></interactions><output><content><text value=\"Joey 28 true\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>\"Joey\"</code>, następnie <code>28</code> i na końcu <code>true</code>.</p></body></html>"
          },
          {
            "title": "Example: Strings",
