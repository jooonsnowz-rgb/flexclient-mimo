            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co robi operator <code>!</code> w języku Swift?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">Zmienia wartości logiczne <code>true</code> lub <code>false</code> na ich przeciwieństwo</item><item correct=\"false\" value=\"2\">Sprawdza, czy wartości są równe</item></selection><p visible-if=\"wrong\">Zmienia wartości logiczne <code>true</code> lub <code>false</code> na ich przeciwieństwo.</p></body></html>"
          },
