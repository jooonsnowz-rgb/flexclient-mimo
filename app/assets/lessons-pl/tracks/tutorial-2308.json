            "interactiveContent": "<!DOCTYPE html ><html><body><p>Napisz kod, aby zaimportować zainstalowany pakiet o nazwie <code>express</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"app.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" express = \" /><text value=\"require\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;express&quot;\" class=\"string\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"16\" endIndex=\"23\" /><option correct=\"false\"><content><text value=\"load\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>require</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Załaduj zainstalowany pakiet <code>express</code> do zmiennej <code>express</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"app.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" express = \" /><text value=\"require\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;express&quot;\" class=\"string\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"16\" endIndex=\"23\" /><option startIndex=\"24\" endIndex=\"33\" /><option correct=\"false\"><content><text value=\"import\" /></content></option><option correct=\"false\"><content><text value=\"load\" /></content></option><option correct=\"false\"><content><text value=\"&quot;app&quot;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>require</code>, a następnie <code>\"express\"</code>.</p></body></html>",
            "hardModeSelected": true
