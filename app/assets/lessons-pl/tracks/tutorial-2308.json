            "interactiveContent": "<!DOCTYPE html ><html><body><p>Utwórz serwer Express działający na porcie <code>3000</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"app.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" express = \" /><text value=\"require\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;express&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" app = express();\" /><text type=\"break\" /><text type=\"break\" /><text value=\"app.listen(\" /><text value=\"3000\" class=\"number\" /><text value=\", () =&gt; {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Server is running on port 3000&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"});\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"60\" endIndex=\"63\" /><option startIndex=\"64\" endIndex=\"70\" /><option startIndex=\"71\" endIndex=\"75\" /><option correct=\"false\"><content><text value=\"port\" /></content></option><option correct=\"false\"><content><text value=\"createServer\" /></content></option></options></interaction></interactions><output><content><text value=\"Server is running on port 3000\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>app</code>, następnie <code>listen</code> i na końcu <code>3000</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Utwórz aplikację Express, a następnie uruchom ją na porcie <code>3000</code>, aby wyświetliła informację o działaniu serwera.</p><code version=\"2\" codelang=\"javascript\" name=\"app.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" express = \" /><text value=\"require\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;express&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" app = express();\" /><text type=\"break\" /><text type=\"break\" /><text value=\"app.listen(\" /><text value=\"3000\" class=\"number\" /><text value=\", () =&gt; {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Server is running on port 3000&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"});\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"48\" endIndex=\"55\" /><option startIndex=\"60\" endIndex=\"63\" /><option startIndex=\"64\" endIndex=\"70\" /><option startIndex=\"71\" endIndex=\"75\" /><option correct=\"false\"><content><text value=\"require\" /></content></option><option correct=\"false\"><content><text value=\"port\" /></content></option><option correct=\"false\"><content><text value=\"createServer\" /></content></option></options></interaction></interactions><output><content><text value=\"Server is running on port 3000\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>express</code>, następnie <code>app</code>, <code>listen</code> i na końcu <code>3000</code>.</p></body></html>",
