            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jak wysyłasz odpowiedź HTML?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>res.send(\"&lt;p&gt;Me?&lt;/p&gt;\");</code></item><item value=\"2\" correct=\"false\"><code>res.html(\"&lt;p&gt;Me?&lt;/p&gt;\");</code></item><item value=\"3\" correct=\"false\"><code>res.json(\"&lt;p&gt;Me?&lt;/p&gt;\");</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>res.send(\"&lt;p&gt;Me?&lt;/p&gt;\");</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Jak wysyłasz odpowiedź HTML?</p><p>Wybierz metodę odpowiedzi, która wysyła pokazany akapit HTML do klienta.</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>res.send(\"&lt;p&gt;Me?&lt;/p&gt;\");</code></item><item value=\"2\" correct=\"false\"><code>res.html(\"&lt;p&gt;Me?&lt;/p&gt;\");</code></item><item value=\"3\" correct=\"false\"><code>res.json(\"&lt;p&gt;Me?&lt;/p&gt;\");</code></item><item value=\"4\" correct=\"false\"><code>res.render(\"&lt;p&gt;Me?&lt;/p&gt;\");</code></item></selection><p visible-if=\"wrong\"><code>res.send(\"&lt;p&gt;Me?&lt;/p&gt;\");</code>.</p></body></html>"
