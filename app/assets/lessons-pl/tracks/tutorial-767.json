            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jak nazywamy wartości tablicy?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">\"Elementy\"</item><item value=\"2\" correct=\"false\">\"Warunki\"</item></selection><p visible-if=\"wrong\">Koniecznie wybierz \"Elementy\".</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Jak nazywamy wartości <code>\"Tom\"</code> i <code>\"Mia\"</code> w tablicy <code>[\"Tom\", \"Mia\"]</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Elementami</item><item value=\"2\" correct=\"false\">Warunkami</item><item value=\"3\" correct=\"false\">Zmiennymi</item></selection><p visible-if=\"wrong\">Koniecznie wybierz Elementami.</p></body></html>"
          },
          {
            "title": "Question: Empty array",
            "id": 73191,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Ile wartości ma ta tablica?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" messages = [];\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">0</item><item value=\"2\" correct=\"false\">1</item></selection><p visible-if=\"wrong\">Koniecznie wybierz 0.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Ile elementów może udostępnić tablica <code>messages</code>, zanim cokolwiek zostanie do niej dodane?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" messages = [];\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">0</item><item value=\"2\" correct=\"false\">1</item><item value=\"3\" correct=\"false\">Nie można tego ustalić, dopóki tablica nie zostanie wyświetlona.</item></selection><p visible-if=\"wrong\">Koniecznie wybierz 0.</p></body></html>"
          },
          {
            "title": "Question: Value in an array",
            "id": 73192,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jaką wartość ma ta tablica?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" pet = [\" /><text value=\"&quot;Coco&quot;\" class=\"string\" /><text value=\"];\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>\"Coco\"</code></item><item value=\"2\" correct=\"false\">Nie ma żadnych wartości</item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>\"Coco\"</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Jaką wartość znajdziesz, gdy odczytasz jedyny element zapisany w tablicy <code>pet</code>?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" pet = [\" /><text value=\"&quot;Coco&quot;\" class=\"string\" /><text value=\"];\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>\"Coco\"</code></item><item value=\"2\" correct=\"false\">Nie ma żadnych wartości</item><item value=\"3\" correct=\"false\"><code>pet</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>\"Coco\"</code>.</p></body></html>"
