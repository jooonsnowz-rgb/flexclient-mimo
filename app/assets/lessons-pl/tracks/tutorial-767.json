            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jakie symbole służą do otaczania wartości w tablicy?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>[</code> i <code>]</code></item><item value=\"2\" correct=\"false\"><code>{</code> i <code>}</code></item></selection><p visible-if=\"wrong\"><code>[</code> i <code>]</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Musisz otoczyć kilka wartości w tablicy JavaScript. Których symboli użyjesz?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>[</code> i <code>]</code></item><item value=\"2\" correct=\"false\"><code>{</code> i <code>}</code></item><item value=\"3\" correct=\"false\"><code>(</code> i <code>)</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>[</code> i <code>]</code>.</p></body></html>"
