            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jaki symbol służy do oddzielania wartości w tablicy?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Przecinek <code>,</code></item><item value=\"2\" correct=\"false\">Średnik <code>;</code></item></selection><p visible-if=\"wrong\">Przecinek <code>,</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Dodajesz <code>\"Mia\"</code> jako drugi element tablicy <code>[\"Tom\"]</code>. Która tablica używa prawidłowego separatora?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>[\"Tom\", \"Mia\"]</code></item><item value=\"2\" correct=\"false\"><code>[\"Tom\"; \"Mia\"]</code></item><item value=\"3\" correct=\"false\"><code>[\"Tom\": \"Mia\"]</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>[\"Tom\", \"Mia\"]</code>.</p></body></html>",
