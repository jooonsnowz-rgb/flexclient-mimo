            "title": "Example: Replace",
            "id": 82810,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zastąp wszystkie wystąpienia <code>!</code> znakami <code>?</code>. </p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"rep = \" /><text value=\"&quot;Yes!&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"rep = rep.replace(\" /><text value=\"&quot;!&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;?&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(rep)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"37\" endIndex=\"38\" /><option startIndex=\"38\" endIndex=\"39\" /><option startIndex=\"39\" endIndex=\"40\" /><option correct=\"false\"><content><text value=\"^\" /></content></option></options></interaction></interactions><output><content><text value=\"Yes?\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>\"</code>, następnie <code>?</code> i na końcu <code>\"</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Zamień każdy znak <code>!</code> na <code>?</code>, aby konsola wyświetliła <code>Yes?</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"rep = \" /><text value=\"&quot;Yes!&quot;\" class=\"string\" /><text type=\"break\" /><text type=\"break\" /><text value=\"rep = rep.replace(\" /><text value=\"&quot;!&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;?&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(rep)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"37\" endIndex=\"38\" /><option startIndex=\"38\" endIndex=\"39\" /><option startIndex=\"39\" endIndex=\"40\" /><option startIndex=\"32\" endIndex=\"35\" /><option correct=\"false\"><content><text value=\"&quot;?&quot;\" /></content></option><option correct=\"false\"><content><text value=\"^\" /></content></option><option correct=\"false\"><content><text value=\"!\" /></content></option></options></interaction></interactions><output><content><text value=\"Yes?\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>\"!\"</code>, następnie <code>\"</code>, <code>?</code> i na końcu <code>\"</code>.</p></body></html>",
            "hardModeSelected": true
