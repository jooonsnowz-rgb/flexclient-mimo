            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co robi <code>split()</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Dzieli ciąg znaków na listę</item><item value=\"2\" correct=\"false\">Łączy ciąg znaków</item><item value=\"3\" correct=\"false\">Zastępuje część ciągu znaków</item></selection><p visible-if=\"wrong\">Dzieli ciąg znaków na listę.</p></body></html>",
