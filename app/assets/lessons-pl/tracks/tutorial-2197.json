          {
            "title": "Headings",
            "id": 58993,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dodaj właściwe fragmenty kodu, aby utworzyć nagłówki.</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Video games\" /><text value=\"&lt;/\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"h2\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Console games\" /><text value=\"&lt;/\" /><text value=\"h2\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"h2\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Mobile games\" /><text value=\"&lt;/\" /><text value=\"h2\" class=\"name\" /><text value=\"&gt;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"4\" /><option startIndex=\"21\" endIndex=\"25\" /><option startIndex=\"44\" endIndex=\"48\" /><option correct=\"false\"><content><text value=\"&lt;h3&gt;\" /></content></option><option correct=\"false\"><content><text value=\"&lt;h4&gt;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>&lt;h1&gt;</code>, następnie <code>&lt;h2&gt;</code> i na końcu <code>&lt;h2&gt;</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Użyj pasujących znaczników: ustaw <code>Video games</code> jako największy nagłówek, a dwa typy gier jako drugie co do wielkości.</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Video games\" /><text value=\"&lt;/\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"h2\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Console games\" /><text value=\"&lt;/\" /><text value=\"h2\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"h2\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Mobile games\" /><text value=\"&lt;/\" /><text value=\"h2\" class=\"name\" /><text value=\"&gt;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"4\" /><option startIndex=\"15\" endIndex=\"20\" /><option startIndex=\"21\" endIndex=\"25\" /><option startIndex=\"44\" endIndex=\"48\" /><option correct=\"false\"><content><text value=\"&lt;h3&gt;\" /></content></option><option correct=\"false\"><content><text value=\"&lt;/h2&gt;\" /></content></option><option correct=\"false\"><content><text value=\"&lt;h4&gt;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>&lt;h1&gt;</code>, następnie <code>&lt;/h1&gt;</code>, <code>&lt;h2&gt;</code> i na końcu <code>&lt;h2&gt;</code>.</p></body></html>",
            "hardModeSelected": true
