            "id": 59093,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Napisz znacznik otwierający, który definiuje tekst jako ważny.</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Dr. Amp's Gold Shovels\" /><text value=\"&lt;/\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text value=\" Order now - \" /><text value=\"&lt;\" /><text value=\"strong\" class=\"name\" /><text value=\"&gt;\" /><text value=\"only $29.99\" /><text value=\"&lt;/\" /><text value=\"strong\" class=\"name\" /><text value=\"&gt;\" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"48\" endIndex=\"49\" /><option startIndex=\"49\" endIndex=\"55\" /><option startIndex=\"55\" endIndex=\"56\" /><option correct=\"false\"><content><text value=\"/\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>&lt;</code>, następnie <code>strong</code> i na końcu <code>&gt;</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Umieść <code>only $29.99</code> w pasujących znacznikach, aby oznaczyć ten tekst jako ważny.</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Dr. Amp's Gold Shovels\" /><text value=\"&lt;/\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Order now: \" /><text value=\"&lt;\" /><text value=\"strong\" class=\"name\" /><text value=\"&gt;\" /><text value=\"only $29.99\" /><text value=\"&lt;/\" /><text value=\"strong\" class=\"name\" /><text value=\"&gt;\" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"46\" endIndex=\"54\" /><option startIndex=\"54\" endIndex=\"65\" /><option startIndex=\"65\" endIndex=\"74\" /><option correct=\"false\"><content><text value=\"&lt;em&gt;\" /></content></option><option correct=\"false\"><content><text value=\"&lt;/em&gt;\" /></content></option><option correct=\"false\"><content><text value=\"Order now:\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>&lt;strong&gt;</code>, następnie <code>only $29.99</code> i na końcu <code>&lt;/strong&gt;</code>.</p></body></html>",
            "hardModeSelected": true
