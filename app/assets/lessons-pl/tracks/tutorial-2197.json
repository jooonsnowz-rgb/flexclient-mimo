          {
            "title": "Question 2",
            "id": 59083,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dlaczego znacznik podziału wiersza jest znacznikiem pustym?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">Ponieważ nie ma znacznika zamykającego</item><item correct=\"false\" value=\"2\">Ponieważ nie ma wpływu na strukturę strony internetowej</item><item correct=\"false\" value=\"2\">Ponieważ nie ma znacznika otwierającego</item></selection><p visible-if=\"wrong\">Ponieważ nie ma znacznika zamykającego.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Dodajesz <code>&lt;br&gt;</code> między dwoma wierszami tekstu. Dlaczego nie dodajesz po nim <code>&lt;/br&gt;</code>?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Ponieważ <code>&lt;br&gt;</code> jest pustym znacznikiem i nie ma znacznika zamykającego</item><item value=\"2\" correct=\"false\">Ponieważ <code>&lt;br&gt;</code> jest znacznikiem nagłówka</item><item value=\"3\" correct=\"false\">Ponieważ puste znaczniki nie mają znacznika otwierającego</item></selection><p visible-if=\"wrong\">Ponieważ <code>&lt;br&gt;</code> jest pustym znacznikiem i nie ma znacznika zamykającego.</p></body></html>"
          },
          {
            "title": "Example: Text between the tags",
            "id": 67563,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wyświetl <code>Accept</code> na przycisku, wpisując kod między znacznikiem otwierającym a zamykającym.</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"h4\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Terms and Conditions\" /><text value=\"&lt;/\" /><text value=\"h4\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text value=\"By clicking accept, you agree to helping a friend this weekend.\" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"button\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Accept\" /><text value=\"&lt;/\" /><text value=\"button\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"button\" class=\"name\" /><text value=\"&gt;\" /><text value=\"No way!\" /><text value=\"&lt;/\" /><text value=\"button\" class=\"name\" /><text value=\"&gt;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"109\" endIndex=\"115\" /><option correct=\"false\"><content><text value=\"Reject\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>Accept</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Spraw, aby pierwszy przycisk wyświetlał <code>Accept</code>, a drugi nadal wyświetlał <code>No way!</code>.</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"h4\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Terms and Conditions\" /><text value=\"&lt;/\" /><text value=\"h4\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text value=\"By clicking accept, you agree to helping a friend this weekend.\" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"button\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Accept\" /><text value=\"&lt;/\" /><text value=\"button\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"button\" class=\"name\" /><text value=\"&gt;\" /><text value=\"No way!\" /><text value=\"&lt;/\" /><text value=\"button\" class=\"name\" /><text value=\"&gt;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"109\" endIndex=\"115\" /><option startIndex=\"133\" endIndex=\"140\" /><option correct=\"false\"><content><text value=\"Agree\" /></content></option><option correct=\"false\"><content><text value=\"Reject\" /></content></option><option correct=\"false\"><content><text value=\"Terms and Conditions\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>Accept</code>, a następnie <code>No way!</code>.</p></body></html>"
          },
