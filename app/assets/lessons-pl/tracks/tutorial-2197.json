          {
            "title": "Closing tag",
            "id": 58994,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dodaj brakujący znacznik zamykający.</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Welcome\" /><text value=\"&lt;/\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"11\" endIndex=\"16\" /><option correct=\"false\"><content><text value=\"&lt;\\h1&gt;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>&lt;/h1&gt;</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Użyj pasujących znaczników otwierającego i zamykającego, aby umieścić <code>Welcome</code> w nagłówku <code>h1</code>.</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Welcome\" /><text value=\"&lt;/\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"4\" /><option startIndex=\"11\" endIndex=\"16\" /><option correct=\"false\"><content><text value=\"&lt;h2&gt;\" /></content></option><option correct=\"false\"><content><text value=\"&lt;\\h1&gt;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>&lt;h1&gt;</code>, a następnie <code>&lt;/h1&gt;</code>.</p></body></html>",
            "hardModeSelected": true
