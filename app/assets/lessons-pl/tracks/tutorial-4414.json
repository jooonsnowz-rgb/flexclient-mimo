            "id": 147910,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zakoduj wartość <code>false</code> w tej tablicy.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"27\" endIndex=\"32\" isDefault=\"true\" /></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" gameOptions = [\" /><text value=\"true\" class=\"literal\" /><text value=\", \" /><text value=\"false\" class=\"literal\" /><text value=\"];\" /></content></code><p visible-if=\"wrong\">Koniecznie wpisz <code>false</code>.</p></body></html>"
          },
          {
            "title": "Lesson #16",
            "id": 147911,
