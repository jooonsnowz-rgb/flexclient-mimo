            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jaki typ ma wartość zwracana przez tę funkcję?</p><code version=\"2\" codelang=\"typescript\" name=\"script.ts\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" myFunction: \" /><text value=\"(\" /><text value=\"input: \" /><text value=\"string\" class=\"built_in\" /><text value=\") =&gt;\" /><text value=\" \" /><text value=\"number\" class=\"built_in\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">liczba</item><item value=\"2\" correct=\"false\">string</item><item value=\"3\" correct=\"false\">wartość logiczna</item><item value=\"4\" correct=\"false\">dowolny</item></selection><p visible-if=\"wrong\">Koniecznie wybierz liczba.</p></body></html>"
