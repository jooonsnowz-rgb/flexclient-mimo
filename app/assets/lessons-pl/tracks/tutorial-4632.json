            "hardModeContent": "<!DOCTYPE html ><html><body><p>Zmieniasz żądanie z <code>/courses?id=12</code> na <code>/courses/12</code>. Gdzie jest teraz przekazywany identyfikator?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">W ścieżce URL</item><item value=\"2\" correct=\"false\">W imporcie requests</item><item value=\"3\" correct=\"false\">W danych odpowiedzi</item><item value=\"4\" correct=\"false\">W ciągu zapytania po znaku <code>?</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz W ścieżce URL.</p></body></html>",
