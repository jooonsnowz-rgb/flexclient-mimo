            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Użyj zmiennej <code>certificate_id</code> jako parametru trasy, aby zażądać konkretnego certyfikatu.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"import\" class=\"keyword\" /><text value=\" requests\" /><text type=\"break\" /><text type=\"break\" /><text value=\"certificate_id = \" /><text value=\"37631\" class=\"number\" /><text type=\"break\" /><text value=\"url = \" /><text value=\"f&quot;https://mimo.org/certificates/\" /><text value=\"{certificate_id}\" class=\"subst\" /><text value=\"&quot;\" /><text type=\"break\" /><text type=\"break\" /><text value=\"response = requests.get(url)\" /><text type=\"break\" /><text type=\"break\" /><text value=\"data = response.json()\" /><text type=\"break\" /><text value=\"print(data)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"78\" endIndex=\"79\" /><option startIndex=\"79\" endIndex=\"93\" /><option startIndex=\"93\" endIndex=\"94\" /></options></interaction></interactions><output><content><text value=\"{\" /><text type=\"break\" /><text value=\"  &quot;id&quot;: 37631,\" /><text type=\"break\" /><text value=\"  &quot;learner_id&quot;: 14689122\" /><text type=\"break\" /><text value=\"  &quot;course&quot;: &quot;Python&quot;,\" /><text type=\"break\" /><text value=\"  &quot;status&quot;: &quot;completed&quot;\" /><text type=\"break\" /><text value=\"}\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>{</code>, następnie <code>certificate_id</code> i na końcu <code>}</code>.</p></body></html>",
            "hardModeSelected": true
