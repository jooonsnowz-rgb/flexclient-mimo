          {
            "title": "Example: Two matching values 2",
            "id": 98696,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Napisz zapytanie, które wybiera wszystkie elementy podczas łączenia tabel <code>movie</code> i <code>director</code> na podstawie wspólnej właściwości <code>director_id</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE movie (&#xA; title varchar(255),&#xA; director_id int&#xA;);&#xA;&#xA;INSERT INTO movie (title, director_id)&#xA;VALUES ('The Pianist', 2);&#xA;INSERT INTO movie (title, director_id)&#xA;VALUES ('Macbeth', 2);&#xA;INSERT INTO movie (title, director_id)&#xA;VALUES ('Somewhere', 1);&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;CREATE TABLE director (&#xA; director_id int,&#xA; name varchar(255)&#xA;);&#xA;&#xA;INSERT INTO director (director_id, name)&#xA;VALUES (1, 'Coppola');&#xA;INSERT INTO director (director_id, name)&#xA;VALUES (2, 'Polanski');&#xA;INSERT INTO director (director_id, name)&#xA;VALUES (3, 'Kurosawa');&#xA;\"><tables><table name=\"movie\"><row><header content=\"title\" /><header content=\"director_id\" /></row><row><data content=\"The Pianist\" /><data content=\"2\" /></row><row><data content=\"Macbeth\" /><data content=\"2\" /></row><row><data content=\"Somewhere\" /><data content=\"1\" /></row></table><table name=\"director\"><row><header content=\"director_id\" /><header content=\"name\" /></row><row><data content=\"1\" /><data content=\"Coppola\" /></row><row><data content=\"2\" /><data content=\"Polanski\" /></row><row><data content=\"3\" /><data content=\"Kurosawa\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" movie\" /><text type=\"break\" /><text value=\"INNER\" class=\"keyword\" /><text value=\" \" /><text value=\"JOIN\" class=\"keyword\" /><text value=\" director\" /><text type=\"break\" /><text value=\"ON\" class=\"keyword\" /><text value=\" movie.director_id = director.director_id;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"8\" /><option startIndex=\"9\" endIndex=\"19\" /><option startIndex=\"20\" endIndex=\"30\" /><option startIndex=\"31\" endIndex=\"39\" /><option startIndex=\"40\" endIndex=\"42\" /><option correct=\"false\"><content><text value=\"DISTINCT\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"title\" /><header content=\"director_id\" /><header content=\"director_id\" /><header content=\"name\" /></row><row><data content=\"The Pianist\" /><data content=\"2\" /><data content=\"2\" /><data content=\"Polanski\" /></row><row><data content=\"Macbeth\" /><data content=\"2\" /><data content=\"2\" /><data content=\"Polanski\" /></row><row><data content=\"Somewhere\" /><data content=\"1\" /><data content=\"1\" /><data content=\"Coppola\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>SELECT *</code>, następnie <code>FROM movie</code>, a potem <code>INNER JOIN</code>, <code>director</code>, <code>ON</code>.</p></body></html>"
