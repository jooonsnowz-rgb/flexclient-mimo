            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jaką wspólną właściwość mają te dwie tabele?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE movie (&#xA; title varchar(255),&#xA; director_id int&#xA;);&#xA;&#xA;INSERT INTO movie (title, director_id)&#xA;VALUES ('The Pianist', 2);&#xA;INSERT INTO movie (title, director_id)&#xA;VALUES ('Macbeth', 2);&#xA;INSERT INTO movie (title, director_id)&#xA;VALUES ('Somewhere', 1);&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;CREATE TABLE director (&#xA; director_id int,&#xA; name varchar(255)&#xA;);&#xA;&#xA;INSERT INTO director (director_id, name)&#xA;VALUES (1, 'Coppola');&#xA;INSERT INTO director (director_id, name)&#xA;VALUES (2, 'Polanski');&#xA;INSERT INTO director (director_id, name)&#xA;VALUES (3, 'Kurosawa');&#xA;\"><tables><table name=\"movie\"><row><header content=\"title\" /><header content=\"director_id\" /></row><row><data content=\"The Pianist\" /><data content=\"2\" /></row><row><data content=\"Macbeth\" /><data content=\"2\" /></row><row><data content=\"Somewhere\" /><data content=\"1\" /></row></table><table name=\"director\"><row><header content=\"director_id\" /><header content=\"name\" /></row><row><data content=\"1\" /><data content=\"Coppola\" /></row><row><data content=\"2\" /><data content=\"Polanski\" /></row><row><data content=\"3\" /><data content=\"Kurosawa\" /></row></table></tables></database><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>director_id</code></item><item value=\"2\" correct=\"false\"><code>title</code></item><item value=\"3\" correct=\"false\"><code>director</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>director_id</code>.</p></body></html>"
