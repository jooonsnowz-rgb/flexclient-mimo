            "interactiveContent": "<!DOCTYPE html ><html><body><p>Użyj aliasów tabel, aby najpierw wybrać kolumnę <code>title</code> z tabeli <code>movie</code>, a następnie kolumnę <code>name</code> z tabeli <code>director</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE movie (&#xA; title varchar(255),&#xA; director_id int&#xA;);&#xA;&#xA;INSERT INTO movie (title, director_id)&#xA;VALUES ('The Pianist', 2);&#xA;INSERT INTO movie (title, director_id)&#xA;VALUES ('Macbeth', 2);&#xA;INSERT INTO movie (title, director_id)&#xA;VALUES ('Somewhere', 1);&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;CREATE TABLE director (&#xA; id int,&#xA; name varchar(255)&#xA;);&#xA;&#xA;INSERT INTO director (id, name)&#xA;VALUES (1, 'Coppola');&#xA;INSERT INTO director (id, name)&#xA;VALUES (2, 'Polanski');&#xA;INSERT INTO director (id, name)&#xA;VALUES (3, 'Kurosawa');&#xA;\"><tables><table name=\"movie\"><row><header content=\"title\" /><header content=\"director_id\" /></row><row><data content=\"The Pianist\" /><data content=\"2\" /></row><row><data content=\"Macbeth\" /><data content=\"2\" /></row><row><data content=\"Somewhere\" /><data content=\"1\" /></row></table><table name=\"director\"><row><header content=\"id\" /><header content=\"name\" /></row><row><data content=\"1\" /><data content=\"Coppola\" /></row><row><data content=\"2\" /><data content=\"Polanski\" /></row><row><data content=\"3\" /><data content=\"Kurosawa\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" m.title, d.name\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" movie \" /><text value=\"AS\" class=\"keyword\" /><text value=\" m\" /><text type=\"break\" /><text value=\"INNER\" class=\"keyword\" /><text value=\" \" /><text value=\"JOIN\" class=\"keyword\" /><text value=\" director \" /><text value=\"AS\" class=\"keyword\" /><text value=\" d\" /><text type=\"break\" /><text value=\"ON\" class=\"keyword\" /><text value=\" m.director_id = d.id;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"7\" endIndex=\"22\" /></interactions><output><table name=\"Result\"><row><header content=\"title\" /><header content=\"name\" /></row><row><data content=\"The Pianist\" /><data content=\"Polanski\" /></row><row><data content=\"Macbeth\" /><data content=\"Polanski\" /></row><row><data content=\"Somewhere\" /><data content=\"Coppola\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>m.title, d.name</code>.</p></body></html>"
