          {
            "title": "Question 7",
            "id": 76344,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Które z tych wyrażeń przypisuje <code>is_monday</code> wartość <code>False</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>is_monday = not True</code></item><item value=\"2\" correct=\"false\"><code>is_monday = \"True\"</code></item><item value=\"2\" correct=\"false\"><code>is_monday = \"not True\"</code></item></selection><p visible-if=\"wrong\"><code>is_monday = not True</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Który wiersz używa <code>not</code>, aby nadać zmiennej <code>is_monday</code> specjalną wartość <code>False</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>is_monday = not True</code></item><item value=\"2\" correct=\"false\"><code>is_monday = True</code></item><item value=\"3\" correct=\"false\"><code>is_monday = \"not True\"</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>is_monday = not True</code>.</p></body></html>",
            "hardModeSelected": true
