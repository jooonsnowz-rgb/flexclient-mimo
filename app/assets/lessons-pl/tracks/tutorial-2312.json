            "id": 76089,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jak często możemy zmieniać wartość zmiennej?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">Tak często, jak chcemy</item><item correct=\"false\" value=\"2\">Tylko raz</item><item correct=\"false\" value=\"2\">Nigdy</item></selection><p visible-if=\"wrong\">Tak często, jak chcemy.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Program wykonuje <code>points = 4</code>, a później <code>points = 8</code>. Co jest prawdą o <code>points</code>?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Ta zmienna przechowuje teraz <code>8</code></item><item value=\"2\" correct=\"false\">Nadal przechowuje tylko <code>4</code></item><item value=\"3\" correct=\"false\">Python nie pozwoli zmienić tej wartości</item></selection><p visible-if=\"wrong\">Ta zmienna przechowuje teraz <code>8</code>.</p></body></html>"
