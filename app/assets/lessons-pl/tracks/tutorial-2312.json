            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co wyświetla ten kod w konsoli?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"print(\" /><text value=\"&quot;Hair&quot;\" class=\"string\" /><text value=\" + \" /><text value=\"&quot;cut&quot;\" class=\"string\" /><text value=\")\" /></content><output><content><text value=\"Haircut\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>Haircut</code></item><item value=\"2\" correct=\"false\"><code>\"Hair + cut\"</code></item><item value=\"3\" correct=\"false\"><code>Hair + cut</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>Haircut</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Kod łączy dwa ciągi znaków. Co pojawi się w konsoli?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"print(\" /><text value=\"&quot;Hair&quot;\" class=\"string\" /><text value=\" + \" /><text value=\"&quot;cut&quot;\" class=\"string\" /><text value=\")\" /></content><output><content><text value=\"Haircut\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>Haircut</code></item><item value=\"2\" correct=\"false\"><code>Hair cut</code></item><item value=\"3\" correct=\"false\"><code>\"Haircut\"</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>Haircut</code>.</p></body></html>",
