            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co wyświetli konsola po uruchomieniu kodu?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"average_grade = \" /><text value=\"&quot;B&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"average_grade = \" /><text value=\"&quot;A-&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"subject = \" /><text value=\"&quot;Programming&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"print(average_grade)\" /></content><output><content><text value=\"A-\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>A-</code></item><item value=\"2\" correct=\"false\"><code>Programming</code></item><item value=\"4\" correct=\"false\"><code>B</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>A-</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Wartość <code>average_grade</code> jest przypisywana dwukrotnie. Której wartości użyje <code>print(average_grade)</code>?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"average_grade = \" /><text value=\"&quot;B&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"average_grade = \" /><text value=\"&quot;A-&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"subject = \" /><text value=\"&quot;Programming&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"print(average_grade)\" /></content><output><content><text value=\"A-\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Ostatnio przypisanej wartości, czyli <code>A-</code>.</item><item value=\"2\" correct=\"false\">Pierwszej przypisanej wartości, czyli <code>B</code>.</item><item value=\"3\" correct=\"false\">Wartości zmiennej <code>subject</code>, czyli <code>Programming</code>.</item></selection><p visible-if=\"wrong\">Ostatnio przypisanej wartości, czyli <code>A-</code>.</p></body></html>"
