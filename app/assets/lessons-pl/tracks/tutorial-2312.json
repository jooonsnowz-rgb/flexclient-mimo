            "interactiveContent": "<!DOCTYPE html ><html><body><p>Do czego służy znak <code>=</code>?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">Przypisuje wartość do zmiennej</item><item correct=\"false\" value=\"2\">Dodaje do siebie wartości tekstowe</item><item correct=\"false\" value=\"3\">Dzieli jedną liczbę przez inną</item></selection><p visible-if=\"wrong\">Przypisuje wartość do zmiennej.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Co robi znak <code>=</code> w <code>score = 9</code>?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Zapisuje <code>9</code> w <code>score</code></item><item value=\"2\" correct=\"false\">Wyświetla <code>9</code> w konsoli</item><item value=\"3\" correct=\"false\">Łączy <code>score</code> z <code>9</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz Zapisuje <code>9</code> w <code>score</code>.</p></body></html>"
