            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dlaczego <code>first name</code> nie jest prawidłową nazwą zmiennej?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">Ponieważ zawiera spację między <code>first</code> a <code>name</code></item><item correct=\"false\" value=\"2\">Ponieważ oba słowa trzeba zapisać wielką literą</item><item correct=\"false\" value=\"2\">Ponieważ nie opisuje wystarczająco jasno</item></selection><p visible-if=\"wrong\">Ponieważ zawiera spację między <code>first</code> a <code>name</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Dla imienia osoby zapisujesz <code>first name = \"Ada\"</code>. Dlaczego <code>first name</code> nie jest poprawną nazwą zmiennej?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Ponieważ zawiera spację między <code>first</code> a <code>name</code></item><item value=\"2\" correct=\"false\">Ponieważ pierwsze słowo musi zaczynać się wielką literą</item><item value=\"3\" correct=\"false\">Ponieważ nazwa jest zbyt opisowa</item></selection><p visible-if=\"wrong\">Ponieważ zawiera spację między <code>first</code> a <code>name</code>.</p></body></html>"
