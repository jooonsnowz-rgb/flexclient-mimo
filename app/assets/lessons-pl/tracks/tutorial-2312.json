          {
            "title": "Question 1",
            "id": 76943,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jakiego znaku używamy, aby sprawdzić, czy dwie wartości są równe?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>==</code></item><item value=\"2\" correct=\"false\"><code>=</code></item><item value=\"2\" correct=\"false\"><code>()</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>==</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Użyj znaku, aby sprawdzić, czy dwie wartości są równe. Który wiersz sprawdza, czy <code>score</code> ma wartość <code>10</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>score == 10</code></item><item value=\"2\" correct=\"false\"><code>score = 10</code></item><item value=\"3\" correct=\"false\"><code>score != 10</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>score == 10</code>.</p></body></html>"
          },
          {
            "title": "Question 2",
            "id": 76942,
            "contentType": "interactive",
            "images": [],
