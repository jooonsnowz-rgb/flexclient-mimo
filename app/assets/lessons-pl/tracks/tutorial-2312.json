            "hardModeContent": "<!DOCTYPE html ><html><body><p>Wartość ma być logiczna, a nie tekstowa. Która spełnia ten warunek?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>True</code></item><item value=\"2\" correct=\"false\"><code>\"True\"</code></item><item value=\"3\" correct=\"false\"><code>\"False\"</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>True</code>.</p></body></html>"
