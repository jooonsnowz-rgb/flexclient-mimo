          },
          {
            "title": "Lesson #14",
            "id": 148005,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Utwórz stałą do użycia wewnątrz funkcji.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"25\" endIndex=\"30\" /><option startIndex=\"31\" endIndex=\"37\" /><option startIndex=\"38\" endIndex=\"39\" /><option startIndex=\"40\" endIndex=\"43\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"showHealth\" class=\"title\" /><text value=\"(\" /><text value=\"\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" health = \" /><text value=\"100\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Player Health: &quot;\" class=\"string\" /><text value=\" + health);\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"showHealth();\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>const</code>, następnie <code>health</code>, a potem <code>=</code>, <code>100</code>.</p></body></html>"
          },
          {
            "title": "Lesson #15",
            "id": 148006,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Uzupełnij instrukcję wyświetlania.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"78\" endIndex=\"85\" /><option startIndex=\"85\" endIndex=\"86\" /><option startIndex=\"86\" endIndex=\"89\" /><option startIndex=\"102\" endIndex=\"108\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"gameState\" class=\"title\" /><text value=\"(\" /><text value=\"\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" playing = \" /><text value=\"&quot;Playing&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" paused = \" /><text value=\"&quot;Paused&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;State: &quot;\" class=\"string\" /><text value=\" + paused);\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"gameState();\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>console</code>, następnie <code>.</code>, a potem <code>log</code>, <code>paused</code>.</p></body></html>"
          },
          {
            "title": "Lesson #16",
            "id": 148007,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dodaj parametr <code>state</code> do funkcji.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"19\" endIndex=\"24\" isDefault=\"true\" /></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"gameState\" class=\"title\" /><text value=\"(\" /><text value=\"state\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;State: &quot;\" class=\"string\" /><text value=\" + state);\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"gameState(\" /><text value=\"&quot;Playing&quot;\" class=\"string\" /><text value=\");}\" /></content></code><p visible-if=\"wrong\">Koniecznie wpisz <code>state</code>.</p></body></html>"
          },
          {
            "title": "Lesson #17",
            "id": 148008,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dodaj nazwę funkcji <code>addScoreBonus</code> i parametr <code>score</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"9\" endIndex=\"22\" /><option startIndex=\"22\" endIndex=\"23\" /><option startIndex=\"23\" endIndex=\"28\" /><option startIndex=\"28\" endIndex=\"29\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"addScoreBonus\" class=\"title\" /><text value=\"(\" /><text value=\"score\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" bonus = score / \" /><text value=\"2\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(bonus);\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"addScoreBonus(\" /><text value=\"10\" class=\"number\" /><text value=\");\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>addScoreBonus</code>, następnie <code>(</code>, a potem <code>score</code>, <code>)</code>.</p></body></html>"
          },
          {
