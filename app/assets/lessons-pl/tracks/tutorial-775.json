            "title": "Array length",
            "id": 52858,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Używamy słowa <code>length</code> po nazwie tablicy i kropce <code>.</code>, aby uzyskać liczbę elementów w tablicy.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" tasks = [\" /><text value=\"&quot;dishes&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;windows&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;vacuum&quot;\" class=\"string\" /><text value=\"];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(tasks.length);\" /></content><output><content><text value=\"3\" /></content></output></code></body></html>",
            "hardModeSelected": true
