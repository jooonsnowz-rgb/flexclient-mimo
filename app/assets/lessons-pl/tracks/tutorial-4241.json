            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Ile sprite'ów pojawi się na tym interfejsie gry?</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><content><text value=\"&lt;\" /><text value=\"img\" class=\"name\" /><text value=\" \" /><text value=\"src\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;https://mimo.app/i/rocket.png&quot;\" class=\"string\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"img\" class=\"name\" /><text value=\" \" /><text value=\"src\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;https://mimo.app/i/star.png&quot;\" class=\"string\" /><text value=\"&gt;\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">2</item><item value=\"2\" correct=\"false\">1</item></selection><p visible-if=\"wrong\">Koniecznie wybierz 2.</p></body></html>"
          },
          {
