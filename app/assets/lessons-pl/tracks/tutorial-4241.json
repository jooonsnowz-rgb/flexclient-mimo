            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wybierz poprawny znacznik dla obrazu sprite.</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"img\" class=\"name\" /><text value=\" \" /><text value=\"src\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;https://mimo.app/i/sword.png&quot;\" class=\"string\" /><text value=\"&gt;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"4\" /><option startIndex=\"5\" endIndex=\"9\" /><option startIndex=\"9\" endIndex=\"39\" /><option startIndex=\"39\" endIndex=\"40\" /><option correct=\"false\"><content><text value=\"&lt;/img&gt;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>&lt;img</code>, następnie <code>src=</code>, a potem <code>\"https://mimo.app/i/sword.png\"</code>, <code>&gt;</code>.</p></body></html>"
