            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Napisz porównanie, które wyświetla tekst, jeśli <code>flightPrice</code> jest mniejsze lub równe <code>budget</code>.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" budget = \" /><text value=\"500\" class=\"number\" /><text type=\"break\" /><text value=\"let\" class=\"keyword\" /><text value=\" flightPrice = \" /><text value=\"300\" class=\"number\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" flightPrice &lt;= budget {\" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Book your flight!&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"42\" endIndex=\"53\" /><option startIndex=\"54\" endIndex=\"56\" /><option startIndex=\"57\" endIndex=\"63\" /><option correct=\"false\"><content><text value=\"true\" /></content></option><option correct=\"false\"><content><text value=\"&quot;budget&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"Book your flight!\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>flightPrice</code>, następnie <code>&lt;=</code> i na końcu <code>budget</code>.</p></body></html>"
