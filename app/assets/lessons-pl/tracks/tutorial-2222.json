            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co wyświetla ten kod?</p><code version=\"2\" codelang=\"css\" name=\"style.css\" visible-if=\"always\"><content><text value=\"button\" class=\"selector-tag\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"position\" class=\"attribute\" /><text value=\": absolute;\" /><text type=\"break\" /><text value=\" \" /><text value=\"left\" class=\"attribute\" /><text value=\": \" /><text value=\"10px\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Przycisk <code>10px</code> od lewej strony strony internetowej</item><item value=\"2\" correct=\"false\">Przycisk w swoim pierwotnym położeniu</item><item value=\"3\" correct=\"false\">Przycisk <code>10px</code> od prawej strony strony internetowej</item></selection><p visible-if=\"wrong\">Przycisk <code>10px</code> od lewej strony strony internetowej.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Zmieniasz tylko <code>left: 10px</code> na <code>left: 30px</code>. Jak przycisk przesunie się względem pokazanej pozycji?</p><code version=\"2\" codelang=\"css\" name=\"style.css\" visible-if=\"always\"><content><text value=\"button\" class=\"selector-tag\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"position\" class=\"attribute\" /><text value=\": absolute;\" /><text type=\"break\" /><text value=\" \" /><text value=\"left\" class=\"attribute\" /><text value=\": \" /><text value=\"10px\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">O 20px w prawo.</item><item value=\"2\" correct=\"false\">O 20px w lewo.</item><item value=\"3\" correct=\"false\">O 30px w prawo.</item></selection><p visible-if=\"wrong\">O 20px w prawo.</p></body></html>",
            "hardModeSelected": true
