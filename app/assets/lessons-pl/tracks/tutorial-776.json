            "interactiveContent": "<!DOCTYPE html ><html><body><p>Uzyskaj dostęp do trzeciego elementu tablicy.<br /></p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" topSpeeds = [\" /><text value=\"100\" class=\"number\" /><text value=\", \" /><text value=\"130\" class=\"number\" /><text value=\", \" /><text value=\"240\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(topSpeeds[\" /><text value=\"2\" class=\"number\" /><text value=\"]);\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"57\" endIndex=\"58\" /></interactions><output><content><text value=\"240\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>2</code>.</p></body></html>"
