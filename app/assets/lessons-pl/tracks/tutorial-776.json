          {
            "title": "Intro 1",
            "id": 73661,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Przyjrzyjmy się bliżej wartościom, które może przechowywać tablica, oraz temu, jak możemy je aktualizować. Na przykład aplikacja pogodowa może śledzić temperatury.</p><webview version=\"2\" visible-if=\"always\" content=\"&lt;!DOCTYPE html&gt;&#xA;&lt;html lang=&quot;en&quot;&gt;&#xA;&lt;head&gt;&#xA;    &lt;meta charset=&quot;UTF-8&quot;&gt;&#xA;    &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;&#xA;    &lt;title&gt;Weather App&lt;/title&gt;&#xA;    &lt;style&gt;&#xA;        body {&#xA;            font-family: Arial, sans-serif;&#xA;            display: flex;&#xA;            justify-content: center;&#xA;            align-items: center;&#xA;            margin: 24px auto;&#xA;            background: url('background-image.jpg') no-repeat center center;&#xA;            background-size: cover;&#xA;            color: #fff;&#xA;        }&#xA;        .weather-container {&#xA;            background-color: #1e90ff;&#xA;            border-radius: 10px;&#xA;            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);&#xA;            padding: 20px;&#xA;            width: 300px;&#xA;            text-align: center;&#xA;        }&#xA;        .weather-header {&#xA;            font-size: 24px;&#xA;            margin-bottom: 20px;&#xA;        }&#xA;        .weather-days {&#xA;            display: flex;&#xA;            justify-content: space-around;&#xA;            margin-bottom: 20px;&#xA;        }&#xA;        .weather-day {&#xA;            cursor: pointer;&#xA;            padding: 10px;&#xA;            background-color: rgba(255, 255, 255, 0.2);&#xA;        }&#xA;        .weather-day.active {&#xA;            background-color: rgba(255, 255, 255, 0.4);&#xA;        }&#xA;        .weather-forecast {&#xA;            font-size: 16px;&#xA;        }&#xA;        .weather-forecast .time {&#xA;            display: flex;&#xA;            justify-content: space-between;&#xA;            margin-bottom: 10px;&#xA;        }&#xA;        .weather-forecast .time div {&#xA;            flex: 1;&#xA;            text-align: center;&#xA;        }&#xA;    &lt;/style&gt;&#xA;&lt;/head&gt;&#xA;&lt;body&gt;&#xA;    &lt;div class=&quot;weather-container&quot;&gt;&#xA;        &lt;div class=&quot;weather-header&quot;&gt;New York&lt;/div&gt;&#xA;        &lt;div class=&quot;weather-days&quot;&gt;&#xA;            &lt;div class=&quot;weather-day active&quot; data-day=&quot;1&quot;&gt;🌞 Fri, June 1&lt;/div&gt;&#xA;            &lt;div class=&quot;weather-day&quot; data-day=&quot;2&quot;&gt;🌧️ Sat, June 2&lt;/div&gt;&#xA;            &lt;div class=&quot;weather-day&quot; data-day=&quot;3&quot;&gt;⛅ Sun, June 3&lt;/div&gt;&#xA;        &lt;/div&gt;&#xA;        &lt;div class=&quot;weather-forecast&quot;&gt;&#xA;            &lt;div class=&quot;time&quot; data-day=&quot;1&quot;&gt;&#xA;                &lt;div&gt;17°&lt;br&gt;9:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;20°&lt;br&gt;12:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;26°&lt;br&gt;15:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;24°&lt;br&gt;18:00 🌤️&lt;/div&gt;&#xA;                &lt;div&gt;20°&lt;br&gt;21:00 🌙&lt;/div&gt;&#xA;                &lt;div&gt;16°&lt;br&gt;00:00 🌙&lt;/div&gt;&#xA;            &lt;/div&gt;&#xA;            &lt;div class=&quot;time&quot; data-day=&quot;2&quot; style=&quot;display: none;&quot;&gt;&#xA;                &lt;div&gt;18°&lt;br&gt;9:00 ☁️&lt;/div&gt;&#xA;                &lt;div&gt;22°&lt;br&gt;12:00 🌧️&lt;/div&gt;&#xA;                &lt;div&gt;27°&lt;br&gt;15:00 🌧️&lt;/div&gt;&#xA;                &lt;div&gt;25°&lt;br&gt;18:00 ☁️&lt;/div&gt;&#xA;                &lt;div&gt;21°&lt;br&gt;21:00 🌙&lt;/div&gt;&#xA;                &lt;div&gt;17°&lt;br&gt;00:00 🌙&lt;/div&gt;&#xA;            &lt;/div&gt;&#xA;            &lt;div class=&quot;time&quot; data-day=&quot;3&quot; style=&quot;display: none;&quot;&gt;&#xA;                &lt;div&gt;19°&lt;br&gt;9:00 ⛅&lt;/div&gt;&#xA;                &lt;div&gt;23°&lt;br&gt;12:00 ⛅&lt;/div&gt;&#xA;                &lt;div&gt;28°&lt;br&gt;15:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;26°&lt;br&gt;18:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;22°&lt;br&gt;21:00 🌙&lt;/div&gt;&#xA;                &lt;div&gt;18°&lt;br&gt;00:00 🌙&lt;/div&gt;&#xA;            &lt;/div&gt;&#xA;        &lt;/div&gt;&#xA;    &lt;/div&gt;&#xA;&#xA;    &lt;script&gt;&#xA;        document.addEventListener('DOMContentLoaded', function() {&#xA;            const days = document.querySelectorAll('.weather-day');&#xA;            const forecasts = document.querySelectorAll('.weather-forecast .time');&#xA;&#xA;            days.forEach(day =&gt; {&#xA;                day.addEventListener('click', function() {&#xA;                    days.forEach(d =&gt; d.classList.remove('active'));&#xA;                    this.classList.add('active');&#xA;&#xA;                    const day = this.getAttribute('data-day');&#xA;                    forecasts.forEach(forecast =&gt; {&#xA;                        if (forecast.getAttribute('data-day') === day) {&#xA;                            forecast.style.display = 'flex';&#xA;                        } else {&#xA;                            forecast.style.display = 'none';&#xA;                        }&#xA;                    });&#xA;                });&#xA;            });&#xA;        });&#xA;    &lt;/script&gt;&#xA;&lt;/body&gt;&#xA;&lt;/html&gt;\" /></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Intro 2",
            "id": 73679,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Tablica może przechowywać różne wartości temperatury i być aktualizowana, gdy w ciągu dnia napływają nowe dane ze stacji pogodowych.</p><webview version=\"2\" visible-if=\"always\" content=\"&lt;!DOCTYPE html&gt;&#xA;&lt;html lang=&quot;en&quot;&gt;&#xA;&lt;head&gt;&#xA;    &lt;meta charset=&quot;UTF-8&quot;&gt;&#xA;    &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;&#xA;    &lt;title&gt;Weather App&lt;/title&gt;&#xA;    &lt;style&gt;&#xA;        body {&#xA;            font-family: Arial, sans-serif;&#xA;            display: flex;&#xA;            justify-content: center;&#xA;            align-items: center;&#xA;            margin: 24px auto;&#xA;            background: url('background-image.jpg') no-repeat center center;&#xA;            background-size: cover;&#xA;            color: #fff;&#xA;        }&#xA;        .weather-container {&#xA;            background-color: #1e90ff;&#xA;            border-radius: 10px;&#xA;            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);&#xA;            padding: 20px;&#xA;            width: 300px;&#xA;            text-align: center;&#xA;        }&#xA;        .weather-header {&#xA;            font-size: 24px;&#xA;            margin-bottom: 20px;&#xA;        }&#xA;        .weather-days {&#xA;            display: flex;&#xA;            justify-content: space-around;&#xA;            margin-bottom: 20px;&#xA;        }&#xA;        .weather-day {&#xA;            cursor: pointer;&#xA;            padding: 10px;&#xA;            background-color: rgba(255, 255, 255, 0.2);&#xA;        }&#xA;        .weather-day.active {&#xA;            background-color: rgba(255, 255, 255, 0.4);&#xA;        }&#xA;        .weather-forecast {&#xA;            font-size: 16px;&#xA;        }&#xA;        .weather-forecast .time {&#xA;            display: flex;&#xA;            justify-content: space-between;&#xA;            margin-bottom: 10px;&#xA;        }&#xA;        .weather-forecast .time div {&#xA;            flex: 1;&#xA;            text-align: center;&#xA;        }&#xA;    &lt;/style&gt;&#xA;&lt;/head&gt;&#xA;&lt;body&gt;&#xA;    &lt;div class=&quot;weather-container&quot;&gt;&#xA;        &lt;div class=&quot;weather-header&quot;&gt;New York&lt;/div&gt;&#xA;        &lt;div class=&quot;weather-days&quot;&gt;&#xA;            &lt;div class=&quot;weather-day active&quot; data-day=&quot;1&quot;&gt;🌞 Fri, June 1&lt;/div&gt;&#xA;            &lt;div class=&quot;weather-day&quot; data-day=&quot;2&quot;&gt;🌧️ Sat, June 2&lt;/div&gt;&#xA;            &lt;div class=&quot;weather-day&quot; data-day=&quot;3&quot;&gt;⛅ Sun, June 3&lt;/div&gt;&#xA;        &lt;/div&gt;&#xA;        &lt;div class=&quot;weather-forecast&quot;&gt;&#xA;            &lt;div class=&quot;time&quot; data-day=&quot;1&quot;&gt;&#xA;                &lt;div&gt;17°&lt;br&gt;9:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;20°&lt;br&gt;12:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;26°&lt;br&gt;15:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;24°&lt;br&gt;18:00 🌤️&lt;/div&gt;&#xA;                &lt;div&gt;20°&lt;br&gt;21:00 🌙&lt;/div&gt;&#xA;                &lt;div&gt;16°&lt;br&gt;00:00 🌙&lt;/div&gt;&#xA;            &lt;/div&gt;&#xA;            &lt;div class=&quot;time&quot; data-day=&quot;2&quot; style=&quot;display: none;&quot;&gt;&#xA;                &lt;div&gt;18°&lt;br&gt;9:00 ☁️&lt;/div&gt;&#xA;                &lt;div&gt;22°&lt;br&gt;12:00 🌧️&lt;/div&gt;&#xA;                &lt;div&gt;27°&lt;br&gt;15:00 🌧️&lt;/div&gt;&#xA;                &lt;div&gt;25°&lt;br&gt;18:00 ☁️&lt;/div&gt;&#xA;                &lt;div&gt;21°&lt;br&gt;21:00 🌙&lt;/div&gt;&#xA;                &lt;div&gt;17°&lt;br&gt;00:00 🌙&lt;/div&gt;&#xA;            &lt;/div&gt;&#xA;            &lt;div class=&quot;time&quot; data-day=&quot;3&quot; style=&quot;display: none;&quot;&gt;&#xA;                &lt;div&gt;19°&lt;br&gt;9:00 ⛅&lt;/div&gt;&#xA;                &lt;div&gt;23°&lt;br&gt;12:00 ⛅&lt;/div&gt;&#xA;                &lt;div&gt;28°&lt;br&gt;15:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;26°&lt;br&gt;18:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;22°&lt;br&gt;21:00 🌙&lt;/div&gt;&#xA;                &lt;div&gt;18°&lt;br&gt;00:00 🌙&lt;/div&gt;&#xA;            &lt;/div&gt;&#xA;        &lt;/div&gt;&#xA;    &lt;/div&gt;&#xA;&#xA;    &lt;script&gt;&#xA;        document.addEventListener('DOMContentLoaded', function() {&#xA;            const days = document.querySelectorAll('.weather-day');&#xA;            const forecasts = document.querySelectorAll('.weather-forecast .time');&#xA;&#xA;            days.forEach(day =&gt; {&#xA;                day.addEventListener('click', function() {&#xA;                    days.forEach(d =&gt; d.classList.remove('active'));&#xA;                    this.classList.add('active');&#xA;&#xA;                    const day = this.getAttribute('data-day');&#xA;                    forecasts.forEach(forecast =&gt; {&#xA;                        if (forecast.getAttribute('data-day') === day) {&#xA;                            forecast.style.display = 'flex';&#xA;                        } else {&#xA;                            forecast.style.display = 'none';&#xA;                        }&#xA;                    });&#xA;                });&#xA;            });&#xA;        });&#xA;    &lt;/script&gt;&#xA;&lt;/body&gt;&#xA;&lt;/html&gt;\" /></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Any value",
            "id": 73662,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wyobraź sobie tablicę jako komodę z szufladami. Szuflada może przechowywać dowolną zmienną lub wartość, na przykład ciąg znaków, wartość logiczną albo liczbę taką jak <code>17</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" temperatures = [\" /><text value=\"17\" class=\"number\" /><text value=\", \" /><text value=\"20\" class=\"number\" /><text value=\", \" /><text value=\"26\" class=\"number\" /><text value=\", \" /><text value=\"24\" class=\"number\" /><text value=\"];\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"22\" endIndex=\"24\" /><option correct=\"false\"><content><text value=\"&quot;17&quot;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>17</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Index",
            "id": 73663,
            "contentType": "interactive",
            "images": [
              {
                "id": "841bb221-569c-4748-ab76-f5261dcadd13"
              }
            ],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Każdy element tablicy ma numerowaną pozycję nazywaną indeksem.</p><img src=\"841bb221-569c-4748-ab76-f5261dcadd13\" visible-if=\"always\" /></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Start at zero",
            "id": 73665,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Indeksy zaczynają się od 0 i zwiększają się przy każdej kolejnej wartości. Oznacza to, że drugi element w <code>temperatures</code> znajduje się pod indeksem <code>1</code>. Zakoduj ten indeks.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" temperatures = [\" /><text value=\"17\" class=\"number\" /><text value=\", \" /><text value=\"20\" class=\"number\" /><text value=\", \" /><text value=\"26\" class=\"number\" /><text value=\", \" /><text value=\"24\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(temperatures[\" /><text value=\"1\" class=\"number\" /><text value=\"]);\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"64\" endIndex=\"65\" /></interactions><output><content><text value=\"20\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>1</code>.</p></body></html>"
          },
          {
            "title": "Access element",
            "id": 73666,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Aby uzyskać dostęp do elementu takiego jak <code>26</code>, wpisz nazwę tablicy <code>temperatures</code>, a następnie indeks elementu w nawiasach kwadratowych <code>[2]</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" temperatures = [\" /><text value=\"17\" class=\"number\" /><text value=\", \" /><text value=\"20\" class=\"number\" /><text value=\", \" /><text value=\"26\" class=\"number\" /><text value=\", \" /><text value=\"24\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(temperatures[\" /><text value=\"2\" class=\"number\" /><text value=\"]);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"51\" endIndex=\"63\" /><option startIndex=\"63\" endIndex=\"64\" /><option startIndex=\"64\" endIndex=\"65\" /><option startIndex=\"65\" endIndex=\"66\" /><option correct=\"false\"><content><text value=\"3\" /></content></option></options></interaction></interactions><output><content><text value=\"26\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>temperatures</code>, następnie <code>[</code>, a potem <code>2</code>, <code>]</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Aby uzyskać dostęp do elementu takiego jak <code>26</code>, wpisz nazwę tablicy <code>temperatures</code>, a następnie indeks elementu w nawiasach kwadratowych <code>[2]</code>. Wyświetl trzeci odczyt.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" temperatures = [\" /><text value=\"17\" class=\"number\" /><text value=\", \" /><text value=\"20\" class=\"number\" /><text value=\", \" /><text value=\"26\" class=\"number\" /><text value=\", \" /><text value=\"24\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(temperatures[\" /><text value=\"2\" class=\"number\" /><text value=\"]);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"51\" endIndex=\"63\" /><option startIndex=\"63\" endIndex=\"64\" /><option startIndex=\"64\" endIndex=\"65\" /><option startIndex=\"65\" endIndex=\"66\" /><option correct=\"false\"><content><text value=\"3\" /></content></option><option correct=\"false\"><content><text value=\"1\" /></content></option><option correct=\"false\"><content><text value=\"temperatures[2]\" /></content></option></options></interaction></interactions><output><content><text value=\"26\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>temperatures</code>, następnie <code>[</code>, <code>2</code> i na końcu <code>]</code>.</p></body></html>"
          },
          {
            "title": "Change value",
            "id": 73668,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Aby zaktualizować wartość temperatury pod drugim indeksem, uzyskaj do niej dostęp za pomocą <code>temperatures[2]</code>, a następnie użyj <code>=</code>, aby przypisać jej nową wartość, na przykład <code>25</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" temperatures = [\" /><text value=\"17\" class=\"number\" /><text value=\", \" /><text value=\"20\" class=\"number\" /><text value=\", \" /><text value=\"26\" class=\"number\" /><text value=\", \" /><text value=\"24\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"temperatures[\" /><text value=\"2\" class=\"number\" /><text value=\"] = \" /><text value=\"25\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(temperatures);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"39\" endIndex=\"54\" /><option startIndex=\"55\" endIndex=\"56\" /><option startIndex=\"57\" endIndex=\"59\" /><option correct=\"false\"><content><text value=\"3\" /></content></option></options></interaction></interactions><output><content><text value=\"[ 17, 20, 25, 24 ]\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>temperatures[2]</code>, następnie <code>=</code> i na końcu <code>25</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Aby zmienić temperaturę pod drugim indeksem, uzyskaj do niej dostęp przez <code>temperatures[2]</code>, a następnie użyj <code>=</code>, aby przypisać nową wartość, na przykład <code>25</code>. Ustaw trzeci odczyt na <code>25</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" temperatures = [\" /><text value=\"17\" class=\"number\" /><text value=\", \" /><text value=\"20\" class=\"number\" /><text value=\", \" /><text value=\"26\" class=\"number\" /><text value=\", \" /><text value=\"24\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"temperatures[\" /><text value=\"2\" class=\"number\" /><text value=\"] = \" /><text value=\"25\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(temperatures);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"39\" endIndex=\"54\" /><option startIndex=\"19\" endIndex=\"20\" /><option startIndex=\"57\" endIndex=\"59\" /><option correct=\"false\"><content><text value=\"3\" /></content></option><option correct=\"false\"><content><text value=\"==\" /></content></option><option correct=\"false\"><content><text value=\"26\" /></content></option></options></interaction></interactions><output><content><text value=\"[ 17, 20, 25, 24 ]\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>=</code>, następnie <code>temperatures[2]</code> i na końcu <code>25</code>.</p></body></html>"
          },
          {
            "title": "Valid index",
            "id": 73667,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Mimo że tablica ma cztery elementy, ostatni indeks, do którego możemy uzyskać dostęp, to <code>3</code>, ponieważ indeksowanie zaczyna się od 0.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" temperatures = [\" /><text value=\"17\" class=\"number\" /><text value=\", \" /><text value=\"25\" class=\"number\" /><text value=\", \" /><text value=\"26\" class=\"number\" /><text value=\", \" /><text value=\"24\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"temperatures[\" /><text value=\"3\" class=\"number\" /><text value=\"] = \" /><text value=\"20\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(temperatures);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"52\" endIndex=\"53\" /><option correct=\"false\"><content><text value=\"4\" /></content></option></options></interaction></interactions><output><content><text value=\"[ 17, 25, 26, 20 ]\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>3</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Indeksy tablicy zaczynają się od <code>0</code>, więc ostatnim indeksem tablicy z czterema elementami jest <code>3</code>.</p><p>Uzyskaj dostęp do elementu za pomocą jego indeksu w nawiasach kwadratowych, np. <code>temperatures[0]</code>. Użyj <code>=</code>, aby go zaktualizować.</p><p>Zmień trzeci odczyt na <code>20</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" \" /><text value=\"temperatures\" /><text value=\" \" /><text value=\"=\" /><text value=\" \" /><text value=\"[\" /><text value=\"17\" class=\"number\" /><text value=\",\" /><text value=\" \" /><text value=\"25\" class=\"number\" /><text value=\",\" /><text value=\" \" /><text value=\"26\" class=\"number\" /><text value=\",\" /><text value=\" \" /><text value=\"24\" class=\"number\" /><text value=\"]\" /><text value=\";\" /><text type=\"break\" /><text value=\"temperatures\" /><text value=\"[\" /><text value=\"2\" class=\"number\" /><text value=\"]\" /><text value=\" \" /><text value=\"=\" /><text value=\" \" /><text value=\"20\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".\" /><text value=\"log\" /><text value=\"(\" /><text value=\"temperatures\" /><text value=\")\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"51\" endIndex=\"52\" /><option startIndex=\"52\" endIndex=\"53\" /><option startIndex=\"53\" endIndex=\"54\" /><option correct=\"false\"><content><text value=\"3\" /></content></option><option correct=\"false\"><content><text value=\"4\" /></content></option><option correct=\"false\"><content><text value=\"=\" /></content></option></options></interaction></interactions><output><content><text value=\"[ 17, 25, 20, 24 ]\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>[</code>, następnie <code>2</code> i na końcu <code>]</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Question: Any value",
            "id": 73682,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jakie typy wartości może przechowywać tablica?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Dowolna wartość, w tym ciągi znaków, liczby i wartości logiczne</item><item value=\"2\" correct=\"false\">Tylko ciągi znaków</item></selection><p visible-if=\"wrong\">Dowolna wartość, w tym ciągi znaków, liczby i wartości logiczne.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Tablica zawiera <code>\"Mia\"</code>, <code>17</code> i <code>false</code>. Które stwierdzenie jest prawdziwe?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Może przechowywać ciągi znaków, liczby i wartości logiczne.</item><item value=\"2\" correct=\"false\">Może przechowywać tylko ciągi znaków.</item><item value=\"3\" correct=\"false\">Każdy element musi mieć ten sam typ.</item></selection><p visible-if=\"wrong\">Może przechowywać ciągi znaków, liczby i wartości logiczne.</p></body></html>"
          },
          {
            "title": "Question: Index",
            "id": 73683,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jak nazywamy pozycję elementu w tablicy?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Indeks elementu</item><item value=\"2\" correct=\"false\">Numer elementu</item></selection><p visible-if=\"wrong\">Indeks elementu.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Jak nazywa się pozycja <code>2</code> w wyrażeniu <code>colors[2]</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Indeks elementu</item><item value=\"2\" correct=\"false\">Numer elementu</item><item value=\"3\" correct=\"false\">Wartość elementu</item></selection><p visible-if=\"wrong\">Koniecznie wybierz Indeks elementu.</p></body></html>"
          },
          {
            "title": "Question: Start at zero",
            "id": 73684,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jaki indeks ma element w tej tablicy?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" friends = [\" /><text value=\"&quot;Kim&quot;\" class=\"string\" /><text value=\"];\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>0</code></item><item value=\"2\" correct=\"false\"><code>1</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>0</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Wyobraź sobie, że dodajesz <code>\"Lee\"</code> przed <code>\"Kim\"</code> w tej tablicy. Który indeks zwróci wtedy <code>\"Kim\"</code>?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" friends = [\" /><text value=\"&quot;Kim&quot;\" class=\"string\" /><text value=\"];\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>1</code></item><item value=\"2\" correct=\"false\"><code>0</code></item><item value=\"3\" correct=\"false\"><code>2</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>1</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Question: Access element",
            "id": 73685,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jak uzyskujemy dostęp do elementu w tej tablicy?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" cars = [\" /><text value=\"&quot;Fiat&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Tesla&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Saab&quot;\" class=\"string\" /><text value=\"];\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>cars[1]</code></item><item value=\"2\" correct=\"false\"><code>cars[\"Tesla\"]</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>cars[1]</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Które wyrażenie uzyskuje dostęp do środkowego elementu <code>\"Tesla\"</code> w pokazanej tablicy?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" cars = [\" /><text value=\"&quot;Fiat&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Tesla&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Saab&quot;\" class=\"string\" /><text value=\"];\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>cars[1]</code></item><item value=\"2\" correct=\"false\"><code>cars[\"Tesla\"]</code></item><item value=\"3\" correct=\"false\"><code>cars[2]</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>cars[1]</code>.</p></body></html>"
          },
          {
            "title": "Question: Change value",
            "id": 73686,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jak aktualizować wartość w tablicy?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Uzyskujemy dostęp do wartości za pomocą jej indeksu, a następnie przypisujemy inną wartość</item><item value=\"2\" correct=\"false\">Nie możemy aktualizować wartości w tablicach</item></selection><p visible-if=\"wrong\">Uzyskujemy dostęp do wartości za pomocą jej indeksu, a następnie przypisujemy inną wartość.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Musisz zastąpić wartość pod indeksem <code>1</code>. Co należy zrobić?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Uzyskać do niej dostęp za pomocą indeksu, a następnie przypisać nową wartość.</item><item value=\"2\" correct=\"false\">Tablic nie można aktualizować.</item><item value=\"3\" correct=\"false\">Przypisać wartości nowy indeks.</item></selection><p visible-if=\"wrong\">Uzyskać do niej dostęp za pomocą indeksu, a następnie przypisać nową wartość.</p></body></html>"
          },
          {
            "title": "Question: Valid index",
            "id": 73687,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Do jakich indeksów możemy uzyskać dostęp w tablicy z dwoma elementami?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>0</code> i <code>1</code></item><item value=\"2\" correct=\"false\"><code>1</code> i <code>2</code></item></selection><p visible-if=\"wrong\"><code>0</code> i <code>1</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Tablica ma dokładnie dwa elementy. Które indeksy mogą pobrać istniejący element?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>0</code> i <code>1</code></item><item value=\"2\" correct=\"false\"><code>1</code> i <code>2</code></item><item value=\"3\" correct=\"false\"><code>0</code> i <code>2</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>0</code> i <code>1</code>.</p></body></html>"
          },
          {
            "title": "Example: Any value",
            "id": 73690,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zakoduj wartość <code>false</code> w tej tablicy.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" options = [\" /><text value=\"true\" class=\"literal\" /><text value=\", \" /><text value=\"false\" class=\"literal\" /><text value=\"];\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"23\" endIndex=\"28\" /></interactions></code><p visible-if=\"wrong\">Koniecznie wpisz <code>false</code>.</p></body></html>"
          },
          {
            "title": "Example: Index",
            "id": 73691,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Upewnij się, że <code>\"cat\"</code> znajduje się pod indeksem <code>0</code>, a <code>\"dog\"</code> pod indeksem <code>1</code>, kodując najpierw <code>\"cat\"</code>, a następnie <code>\"dog\"</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" animals = [\" /><text value=\"&quot;cat&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;dog&quot;\" class=\"string\" /><text value=\"];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(animals);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"17\" endIndex=\"22\" /><option startIndex=\"24\" endIndex=\"29\" /><option correct=\"false\"><content><text value=\"&quot;parrot&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"[ 'cat', 'dog' ]\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>\"cat\"</code>, a następnie <code>\"dog\"</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Umieść <code>\"dog\"</code> pod indeksem <code>2</code>, <code>\"cat\"</code> pod indeksem <code>0</code>, a <code>\"parrot\"</code> pod indeksem <code>1</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" \" /><text value=\"animals\" /><text value=\" \" /><text value=\"=\" /><text value=\" \" /><text value=\"[\" /><text value=\"&quot;cat&quot;\" class=\"string\" /><text value=\",\" /><text value=\" \" /><text value=\"&quot;parrot&quot;\" class=\"string\" /><text value=\",\" /><text value=\" \" /><text value=\"&quot;dog&quot;\" class=\"string\" /><text value=\"]\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"17\" endIndex=\"22\" /><option startIndex=\"24\" endIndex=\"32\" /><option startIndex=\"34\" endIndex=\"39\" /><option correct=\"false\"><content><text value=\"&quot;hamster&quot;\" /></content></option><option correct=\"false\"><content><text value=\"&quot;fish&quot;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>\"cat\"</code>, następnie <code>\"parrot\"</code> i na końcu <code>\"dog\"</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example: Start at zero",
            "id": 73692,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zakoduj wartość <code>9</code> pod indeksem zero.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" lockCombination = [\" /><text value=\"9\" class=\"number\" /><text value=\", \" /><text value=\"4\" class=\"number\" /><text value=\", \" /><text value=\"7\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(lockCombination);\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"25\" endIndex=\"26\" /></interactions><output><content><text value=\"[ 9, 4, 7 ]\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>9</code>.</p></body></html>"
          },
          {
            "title": "Example: Access element",
            "id": 73693,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Użyj kodu <code>items[1]</code>, aby wyświetlić drugi element, <code>\"tomato\"</code>, w tablicy.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" items = [\" /><text value=\"&quot;milk&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;tomato&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;apple&quot;\" class=\"string\" /><text value=\"];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(items[\" /><text value=\"1\" class=\"number\" /><text value=\"]);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"55\" endIndex=\"63\" /><option correct=\"false\"><content><text value=\"items[2]\" /></content></option></options></interaction></interactions><output><content><text value=\"tomato\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>items[1]</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Wyświetl drugi element tablicy, <code>tomato</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" items = [\" /><text value=\"&quot;milk&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;tomato&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;apple&quot;\" class=\"string\" /><text value=\"];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(items[\" /><text value=\"1\" class=\"number\" /><text value=\"]);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"55\" endIndex=\"63\" /><option correct=\"false\"><content><text value=\"items[2]\" /></content></option><option correct=\"false\"><content><text value=\"items[0]\" /></content></option></options></interaction></interactions><output><content><text value=\"tomato\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>items[1]</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example: Change value",
            "id": 73694,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zaktualizuj pierwszy element tablicy z <code>3</code> na <code>2</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" even = [\" /><text value=\"3\" class=\"number\" /><text value=\", \" /><text value=\"4\" class=\"number\" /><text value=\", \" /><text value=\"6\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"even[\" /><text value=\"0\" class=\"number\" /><text value=\"] = \" /><text value=\"2\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(even);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"24\" endIndex=\"31\" /><option startIndex=\"32\" endIndex=\"33\" /><option startIndex=\"34\" endIndex=\"35\" /></options></interaction></interactions><output><content><text value=\"[ 2, 4, 6 ]\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>even[0]</code>, następnie <code>=</code> i na końcu <code>2</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Popraw pierwszą wartość, aby tablica została wyświetlona jako <code>[ 2, 4, 6 ]</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" even = [\" /><text value=\"3\" class=\"number\" /><text value=\", \" /><text value=\"4\" class=\"number\" /><text value=\", \" /><text value=\"6\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"even[\" /><text value=\"0\" class=\"number\" /><text value=\"] = \" /><text value=\"2\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(even);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"24\" endIndex=\"31\" /><option startIndex=\"11\" endIndex=\"12\" /><option startIndex=\"34\" endIndex=\"35\" /><option correct=\"false\"><content><text value=\"even[1]\" /></content></option><option correct=\"false\"><content><text value=\"==\" /></content></option><option correct=\"false\"><content><text value=\"3\" /></content></option></options></interaction></interactions><output><content><text value=\"[ 2, 4, 6 ]\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>=</code>, następnie <code>even[0]</code> i na końcu <code>2</code>.</p></body></html>",
            "hardModeSelected": true
          },
