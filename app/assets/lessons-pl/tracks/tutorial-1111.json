            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wyświetl <code>False</code> w konsoli.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"print(\" /><text value=\"10\" class=\"number\" /><text value=\" == \" /><text value=\"13\" class=\"number\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"12\" endIndex=\"14\" /><option correct=\"false\"><content><text value=\"10\" /></content></option></options></interaction></interactions><output><content><text value=\"False\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>13</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Porównaj <code>10</code> z <code>13</code>, aby kod wyświetlił <code>False</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"print(\" /><text value=\"10\" class=\"number\" /><text value=\" == \" /><text value=\"13\" class=\"number\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"9\" endIndex=\"11\" /><option startIndex=\"12\" endIndex=\"14\" /><option correct=\"false\"><content><text value=\"=\" /></content></option><option correct=\"false\"><content><text value=\"10\" /></content></option></options></interaction></interactions><output><content><text value=\"False\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>==</code>, a następnie <code>13</code>.</p></body></html>"
