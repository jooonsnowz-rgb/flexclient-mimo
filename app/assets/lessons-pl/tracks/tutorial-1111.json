            "interactiveContent": "<!DOCTYPE html ><html><body><p>Sprawdź, czy wartość <code>votes</code> jest równa <code>11</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"votes = \" /><text value=\"10\" class=\"number\" /><text type=\"break\" /><text value=\"print(votes == \" /><text value=\"11\" class=\"number\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"23\" endIndex=\"24\" /><option startIndex=\"24\" endIndex=\"25\" /><option startIndex=\"26\" endIndex=\"28\" /></options></interaction></interactions><output><content><text value=\"False\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>=</code>, następnie <code>=</code> i na końcu <code>11</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Sprawdź równość, umieszczając <code>votes</code> po lewej stronie, a <code>11</code> po prawej, aby kod wyświetlił <code>False</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"votes = \" /><text value=\"10\" class=\"number\" /><text type=\"break\" /><text value=\"print(votes == \" /><text value=\"11\" class=\"number\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"17\" endIndex=\"22\" /><option startIndex=\"23\" endIndex=\"25\" /><option startIndex=\"26\" endIndex=\"28\" /><option correct=\"false\"><content><text value=\"=\" /></content></option><option correct=\"false\"><content><text value=\"10\" /></content></option></options></interaction></interactions><output><content><text value=\"False\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>votes</code>, następnie <code>==</code> i na końcu <code>11</code>.</p></body></html>",
            "hardModeSelected": true
