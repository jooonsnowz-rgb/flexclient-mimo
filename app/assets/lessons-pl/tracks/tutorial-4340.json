            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wyświetl w konsoli liczby od <code>1</code> do <code>7</code>, zmieniając warunek.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"9\" /></content></option><option correct=\"false\"><content><text value=\"10\" /></content></option><option startIndex=\"34\" endIndex=\"35\" /></options></interaction></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" counter = \" /><text value=\"1\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" (counter &lt; \" /><text value=\"8\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Wave &quot;\" class=\"string\" /><text value=\" + counter);\" /><text type=\"break\" /><text value=\" counter++;\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>8</code>.</p></body></html>"
