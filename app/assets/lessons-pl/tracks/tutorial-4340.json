            "interactiveContent": "<!DOCTYPE html ><html><body><p>Aby pętla się zatrzymała, zwiększ zmienną licznika wewnątrz bloku kodu.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"&lt;\" /></content></option><option startIndex=\"78\" endIndex=\"85\" /><option startIndex=\"85\" endIndex=\"86\" /><option startIndex=\"86\" endIndex=\"87\" /><option startIndex=\"87\" endIndex=\"88\" /></options></interaction></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" counter = \" /><text value=\"1\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" (counter &lt; \" /><text value=\"6\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Hit combo &quot;\" class=\"string\" /><text value=\" + counter);\" /><text type=\"break\" /><text value=\" counter++;\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>counter</code>, następnie <code>+</code>, a potem <code>+</code>, <code>;</code>.</p></body></html>"
