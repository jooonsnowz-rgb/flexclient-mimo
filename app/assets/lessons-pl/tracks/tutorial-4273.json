          {
            "title": "Lesson #10",
            "id": 145549,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co się dzieje, gdy warunki instrukcji <code>if</code> i instrukcji <code>else if</code> zwracają wartość <code>false</code>?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"let\" class=\"keyword\" /><text value=\" score = \" /><text value=\"75\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" (score &gt; \" /><text value=\"90\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Perfect clear!&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"} \" /><text value=\"else\" class=\"keyword\" /><text value=\" \" /><text value=\"if\" class=\"keyword\" /><text value=\" (score &gt; \" /><text value=\"80\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Great run!&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"} \" /><text value=\"else\" class=\"keyword\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Try again!&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Blok kodu instrukcji <code>else</code> zostaje wykonany</item><item value=\"2\" correct=\"false\">Nic się nie dzieje</item></selection><p visible-if=\"wrong\">Blok kodu instrukcji <code>else</code> zostaje wykonany.</p></body></html>"
