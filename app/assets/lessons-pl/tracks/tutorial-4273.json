            "id": 145548,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co wyświetla ten kod w konsoli?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"let\" class=\"keyword\" /><text value=\" score = \" /><text value=\"75\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" (score &gt; \" /><text value=\"70\" class=\"number\" /><text value=\" &amp;&amp; score &lt; \" /><text value=\"90\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Level cleared!&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"} \" /><text value=\"else\" class=\"keyword\" /><text value=\" \" /><text value=\"if\" class=\"keyword\" /><text value=\" (score &gt;= \" /><text value=\"90\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Perfect clear!&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>Level cleared!</code></item><item value=\"2\" correct=\"false\"><code>Idealnie jasno!</code></item></selection><p visible-if=\"wrong\"><code>Level cleared!</code>.</p></body></html>"
