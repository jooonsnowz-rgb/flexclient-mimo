            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dokończ wywołanie funkcji.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"func\" class=\"keyword\" /><text value=\" \" /><text value=\"totalWeight\" class=\"title\" /><text value=\"(amount: Int)\" class=\"params\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"let\" class=\"keyword\" /><text value=\" measurement = \" /><text value=\"&quot;grams&quot;\" class=\"string\" /><text type=\"break\" /><text value=\" \" /><text value=\"print\" class=\"built_in\" /><text value=\"(amount, measurement)\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"totalWeight(amount: \" /><text value=\"250\" class=\"number\" /><text value=\")\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"90\" endIndex=\"101\" /></interactions><output><content><text value=\"250 grams\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>totalWeight</code>.</p></body></html>"
