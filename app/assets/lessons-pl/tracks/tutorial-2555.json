            "title": "Example: No value",
            "id": 127147,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dodaj parametr do funkcji, a następnie wywołaj ją z wartością.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"func\" class=\"keyword\" /><text value=\" \" /><text value=\"temperatureUpdate\" class=\"title\" /><text value=\"(temp: Int)\" class=\"params\" /><text value=\" {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"&quot;Current temp:&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"  \" /><text value=\"print\" class=\"built_in\" /><text value=\"(temp)\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"temperatureUpdate(temp: \" /><text value=\"60\" class=\"number\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"23\" endIndex=\"32\" /><option startIndex=\"102\" endIndex=\"104\" /><option correct=\"false\"><content><text value=\"var\" /></content></option></options></interaction></interactions><output><content><text value=\"Current temp:\" /><text type=\"break\" /><text value=\"60\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>temp: Int</code>, a następnie <code>60</code>.</p></body></html>"
          },
