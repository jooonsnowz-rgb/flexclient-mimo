            "interactiveContent": "<!DOCTYPE html ><html><body><p>Uruchom wyświetlanie w console.log, dodając <code>(true)</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"3\" endIndex=\"9\" isDefault=\"true\" /></interactions><content><text value=\"if\" class=\"keyword\" /><text value=\" (\" /><text value=\"true\" class=\"literal\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Start game loop&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Koniecznie wpisz <code>(true)</code>.</p></body></html>"
