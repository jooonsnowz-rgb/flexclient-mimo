            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zakoduj wartość logiczną, która pomija instrukcję wyświetlania.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"true\" /></content></option><option startIndex=\"4\" endIndex=\"9\" /></options></interaction></interactions><content><text value=\"if\" class=\"keyword\" /><text value=\" (\" /><text value=\"false\" class=\"literal\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Opened inventory&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>false</code>.</p></body></html>"
