            "id": 90596,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Napisz pętlę <code>for</code>, aby przeiterować przez każdą sieć <code>wifi</code> w <code>networks</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"networks = [\" /><text value=\"&quot;open-WIFI&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;guest&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Wi-Fly&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"open_networks = [wifi \" /><text value=\"for\" class=\"keyword\" /><text value=\" wifi \" /><text value=\"in\" class=\"keyword\" /><text value=\" networks \" /><text value=\"if\" class=\"keyword\" /><text value=\" wifi.count(\" /><text value=\"&quot;open&quot;\" class=\"string\" /><text value=\") &gt; \" /><text value=\"0\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(open_networks)\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"67\" endIndex=\"87\" /></interactions><output><content><text value=\"['open-WIFI']\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>for wifi in networks</code>.</p></body></html>"
