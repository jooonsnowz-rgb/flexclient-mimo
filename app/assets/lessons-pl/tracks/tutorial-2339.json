            "interactiveContent": "<!DOCTYPE html ><html><body><p>Użyj zmiennej iteracyjnej <code>km</code>, przeiteruj przez każdą wartość <code>km</code> w <code>distances</code> i kopiuj tylko te wartości, dla których <code>km &lt;= 5</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"distances = [\" /><text value=\"1\" class=\"number\" /><text value=\", \" /><text value=\"4\" class=\"number\" /><text value=\", \" /><text value=\"20\" class=\"number\" /><text value=\", \" /><text value=\"14\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"walking_distance = [km \" /><text value=\"for\" class=\"keyword\" /><text value=\" km \" /><text value=\"in\" class=\"keyword\" /><text value=\" distances \" /><text value=\"if\" class=\"keyword\" /><text value=\" km &lt;= \" /><text value=\"5\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(walking_distance)\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"48\" endIndex=\"81\" /></interactions><output><content><text value=\"[1, 4]\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>km for km in distances if km &lt;= 5</code>.</p></body></html>"
