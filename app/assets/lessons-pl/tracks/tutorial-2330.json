            "id": 82921,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wyświetl posortowaną listę <code>contacts</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"contacts = [\" /><text value=\"&quot;Ava&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Ana&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Bill&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text value=\"contacts.sort()\" /><text type=\"break\" /><text value=\"print(contacts)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"34\" endIndex=\"49\" /><option startIndex=\"50\" endIndex=\"65\" /><option correct=\"false\"><content><text value=\"print\" /></content></option><option correct=\"false\"><content><text value=\"=\" /></content></option></options></interaction></interactions><output><content><text value=\"['Ana', 'Ava', 'Bill']\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>contacts.sort()</code>, a następnie <code>print(contacts)</code>.</p></body></html>"
          },
