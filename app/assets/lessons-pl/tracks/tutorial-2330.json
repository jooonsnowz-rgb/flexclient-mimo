            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co zostanie wyświetlone w konsoli?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"heights = [\" /><text value=\"166\" class=\"number\" /><text value=\", \" /><text value=\"172.6\" class=\"number\" /><text value=\", \" /><text value=\"159.4\" class=\"number\" /><text value=\", \" /><text value=\"170\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text value=\"heights.sort()\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(heights)\" /></content><output><content><text value=\"[159.4, 166, 170, 172.6]\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>[159.4, 166, 170, 172.6]</code></item><item value=\"2\" correct=\"false\"><code>[159.4, 172.6]</code> i <code>[166, 170]</code></item><item value=\"3\" correct=\"false\">Nic</item><item value=\"4\" correct=\"false\">Tylko <code>[166, 170]</code></item></selection><p visible-if=\"wrong\"><code>[159.4, 166, 170, 172.6]</code>.</p></body></html>"
