            "interactiveContent": "<!DOCTYPE html ><html><body><p>Znajdź największą liczbę kroków wykonanych przez użytkownika w ciągu trzech dni, kodując <code>max(steps)</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"steps = [\" /><text value=\"6000\" class=\"number\" /><text value=\", \" /><text value=\"9000\" class=\"number\" /><text value=\", \" /><text value=\"2000\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text value=\"print(max(steps))\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"33\" endIndex=\"43\" /></interactions><output><content><text value=\"9000\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>max(steps)</code>.</p></body></html>"
