            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wejście jest zawsze typu string. Jeśli chcesz użyć go jako liczby, musisz wcześniej przekonwertować je na liczbę całkowitą lub zmiennoprzecinkową.</p><code version=\"2\" codelang=\"javascript\" name=\"script.py\" visible-if=\"always\"><content><text value=\"user_input_1 = input(\" /><text value=\"&quot;Enter a number: &quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"user_input_2 = input(\" /><text value=\"&quot;Enter another number: &quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"number1 = int(user_input_1)\" /><text type=\"break\" /><text value=\"number2 = int(user_input_2)\" /><text type=\"break\" /><text value=\"result = number1 + number2\" /><text type=\"break\" /><text value=\"print(f\" /><text value=\"&quot;The sum is {result}&quot;\" class=\"string\" /><text value=\")\" /></content><output><content><text value=\"Enter a number: 100\" /><text type=\"break\" /><text value=\"Enter another number: 200\" /><text type=\"break\" /><text value=\"The sum is 300\" /></content></output></code></body></html>",
