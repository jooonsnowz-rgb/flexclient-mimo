            "id": 129303,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co robi funkcja <code>input()</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Odczytuje wiersz z wejścia i zwraca go jako ciąg znaków</item><item value=\"2\" correct=\"false\">Zapisuje wartość na wyjściu</item></selection><p visible-if=\"wrong\">Odczytuje wiersz z wejścia i zwraca go jako ciąg znaków.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Co <code>input()</code> zwraca programowi po naciśnięciu klawisza Enter przez użytkownika?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Wiersz wpisany przez użytkownika jako ciąg znaków</item><item value=\"2\" correct=\"false\">Komunikat zapisany w wyjściu konsoli</item><item value=\"3\" correct=\"false\">Wiersz jako liczbę, jeśli zawiera tylko cyfry</item></selection><p visible-if=\"wrong\">Wiersz wpisany przez użytkownika jako ciąg znaków.</p></body></html>"
