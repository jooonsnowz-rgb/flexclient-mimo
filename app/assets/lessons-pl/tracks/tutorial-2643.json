            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dodaj symbole, aby poprawnie pobrać od użytkownika dane wejściowe w postaci ciągu znaków.</p><code version=\"2\" codelang=\"javascript\" name=\"script.py\" visible-if=\"always\"><content><text value=\"user_input = input(\" /><text value=\"&quot;Enter something: &quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"18\" endIndex=\"19\" /><option startIndex=\"38\" endIndex=\"39\" /></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>(</code>, a następnie <code>)</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Uzupełnij wywołanie funkcji, które po wyświetleniu <code>Enter something: </code> odczytuje ciąg znaków.</p><code version=\"2\" codelang=\"javascript\" name=\"script.py\" visible-if=\"always\"><content><text value=\"user_input = input(\" /><text value=\"&quot;Enter something: &quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"13\" endIndex=\"18\" /><option startIndex=\"18\" endIndex=\"19\" /><option startIndex=\"19\" endIndex=\"38\" /><option startIndex=\"38\" endIndex=\"39\" /><option correct=\"false\"><content><text value=\"print\" /></content></option><option correct=\"false\"><content><text value=\"[\" /></content></option><option correct=\"false\"><content><text value=\"]\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>input</code>, następnie <code>(</code>, <code>\"Enter something: \"</code> i na końcu <code>)</code>.</p></body></html>"
