            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wyświetl wartości od <code>3</code> do <code>7</code> w konsoli, ustawiając wartość zmiennej counter.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"counter = \" /><text value=\"3\" class=\"number\" /><text type=\"break\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" counter &lt; \" /><text value=\"8\" class=\"number\" /><text value=\": \" /><text type=\"break\" /><text value=\"  print(counter)\" /><text type=\"break\" /><text value=\"  counter += \" /><text value=\"1\" class=\"number\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"10\" endIndex=\"11\" /></interactions><output><content><text value=\"3\" /><text type=\"break\" /><text value=\"4\" /><text type=\"break\" /><text value=\"5\" /><text type=\"break\" /><text value=\"6\" /><text type=\"break\" /><text value=\"7\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>3</code>.</p></body></html>"
