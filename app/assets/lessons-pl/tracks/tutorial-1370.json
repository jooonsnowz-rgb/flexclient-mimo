          {
            "title": "Example: Process",
            "id": 89687,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Uzupełnij warunek tak, aby do nowej listy były kopiowane tylko wartości większe lub równe <code>30</code> i mniejsze lub równe <code>50</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"humidity_percent = [\" /><text value=\"40\" class=\"number\" /><text value=\", \" /><text value=\"35\" class=\"number\" /><text value=\", \" /><text value=\"20\" class=\"number\" /><text value=\", \" /><text value=\"70\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"ideal = [level \" /><text value=\"for\" class=\"keyword\" /><text value=\" level \" /><text value=\"in\" class=\"keyword\" /><text value=\" humidity_percent \" /><text value=\"if\" class=\"keyword\" /><text value=\" level &gt;= \" /><text value=\"30\" class=\"number\" /><text value=\" \" /><text value=\"and\" class=\"keyword\" /><text value=\" level &lt;= \" /><text value=\"50\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(ideal)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"97\" endIndex=\"100\" /><option startIndex=\"101\" endIndex=\"112\" /><option correct=\"false\"><content><text value=\"level == 30\" /></content></option></options></interaction></interactions><output><content><text value=\"[40, 35]\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>and</code>, a następnie <code>level &lt;= 50</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Zachowaj wartości od <code>30</code> do <code>50</code> włącznie. Najpierw umieść test dolnej granicy.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"humidity_percent = [\" /><text value=\"40\" class=\"number\" /><text value=\", \" /><text value=\"35\" class=\"number\" /><text value=\", \" /><text value=\"20\" class=\"number\" /><text value=\", \" /><text value=\"70\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"ideal = [level \" /><text value=\"for\" class=\"keyword\" /><text value=\" level \" /><text value=\"in\" class=\"keyword\" /><text value=\" humidity_percent \" /><text value=\"if\" class=\"keyword\" /><text value=\" level &gt;= \" /><text value=\"30\" class=\"number\" /><text value=\" \" /><text value=\"and\" class=\"keyword\" /><text value=\" level &lt;= \" /><text value=\"50\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(ideal)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"85\" endIndex=\"96\" /><option startIndex=\"97\" endIndex=\"100\" /><option startIndex=\"101\" endIndex=\"112\" /><option correct=\"false\"><content><text value=\"or\" /></content></option><option correct=\"false\"><content><text value=\"level == 30\" /></content></option></options></interaction></interactions><output><content><text value=\"[40, 35]\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>level &gt;= 30</code>, następnie <code>and</code> i na końcu <code>level &lt;= 50</code>.</p></body></html>",
            "hardModeSelected": true
