          {
            "title": "Example: Filtering",
            "id": 89683,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Przefiltruj listę <code>humidity</code>, aby uzyskać tylko poziomy, które są zbyt niskie, sprawdzając, czy <code>level &lt; 30</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"humidity = [\" /><text value=\"40\" class=\"number\" /><text value=\", \" /><text value=\"35\" class=\"number\" /><text value=\", \" /><text value=\"20\" class=\"number\" /><text value=\", \" /><text value=\"70\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"too_low = [level \" /><text value=\"for\" class=\"keyword\" /><text value=\" level \" /><text value=\"in\" class=\"keyword\" /><text value=\" humidity \" /><text value=\"if\" class=\"keyword\" /><text value=\" level &lt; \" /><text value=\"30\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(too_low)\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"68\" endIndex=\"81\" /></interactions><output><content><text value=\"[20]\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>if level &lt; 30</code>.</p></body></html>"
          },
          {
            "title": "Example: For loop",
            "id": 89684,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Napisz pętlę <code>for</code>, aby iterować po każdej wartości <code>website</code> w <code>websites</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"websites = [\" /><text value=\"&quot;nytimes.com&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;lemonde.fr&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;economist.com&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"french = [website \" /><text value=\"for\" class=\"keyword\" /><text value=\" website \" /><text value=\"in\" class=\"keyword\" /><text value=\" websites \" /><text value=\"if\" class=\"keyword\" /><text value=\" website.count(\" /><text value=\"&quot;.fr&quot;\" class=\"string\" /><text value=\") &gt; \" /><text value=\"0\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(french)\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"77\" endIndex=\"100\" /></interactions><output><content><text value=\"['lemonde.fr']\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>for website in websites</code>.</p></body></html>"
