            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zwróć pojedynczą wartość z tej funkcji.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"var\" /></content></option><option startIndex=\"56\" endIndex=\"62\" /><option startIndex=\"63\" endIndex=\"72\" /><option startIndex=\"72\" endIndex=\"73\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"hasLowHealth\" class=\"title\" /><text value=\"(\" /><text value=\"hp\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" lowHealth = hp &lt; \" /><text value=\"5\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" lowHealth;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" result = hasLowHealth(\" /><text value=\"10\" class=\"number\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(result);\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>return</code>, następnie <code>lowHealth</code> i na końcu <code>;</code>.</p></body></html>"
