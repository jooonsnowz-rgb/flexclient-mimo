            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zwróć ciąg znaków, kodując <code>message;</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"81\" endIndex=\"89\" isDefault=\"true\" /></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"lootMessage\" class=\"title\" /><text value=\"(\" /><text value=\"item\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" message = \" /><text value=\"&quot;Loot collected: &quot;\" class=\"string\" /><text value=\" + item;\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" message;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" result = lootMessage(\" /><text value=\"&quot;Health Potion&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(result);}\" /></content></code><p visible-if=\"wrong\">Koniecznie wpisz <code>message;</code>.</p></body></html>"
