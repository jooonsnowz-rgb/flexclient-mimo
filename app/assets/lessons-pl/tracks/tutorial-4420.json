            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zwróć wartość z tej funkcji.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"number\" /></content></option><option startIndex=\"24\" endIndex=\"30\" /><option startIndex=\"31\" endIndex=\"33\" /><option startIndex=\"33\" endIndex=\"34\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"giveMeTen\" class=\"title\" /><text value=\"(\" /><text value=\"\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" \" /><text value=\"10\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(giveMeTen());\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>return</code>, następnie <code>10</code> i na końcu <code>;</code>.</p></body></html>"
