            "id": 148027,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wywołaj funkcję <code>addTen()</code> z wartością.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"89\" endIndex=\"95\" /><option startIndex=\"95\" endIndex=\"96\" /><option startIndex=\"96\" endIndex=\"98\" /><option startIndex=\"98\" endIndex=\"99\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"addTen\" class=\"title\" /><text value=\"(\" /><text value=\"number\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" addedTen = \" /><text value=\"10\" class=\"number\" /><text value=\" + number;\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" addedTen;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(addTen(\" /><text value=\"20\" class=\"number\" /><text value=\"));\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>addTen</code>, następnie <code>(</code>, a potem <code>20</code>, <code>)</code>.</p></body></html>"
