            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dodaj wartość <code>False</code> do tej listy.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"options = [\" /><text value=\"True\" class=\"literal\" /><text value=\", \" /><text value=\"False\" class=\"literal\" /><text value=\"]\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"17\" endIndex=\"22\" /></interactions></code><p visible-if=\"wrong\">Koniecznie wpisz <code>False</code>.</p></body></html>"
