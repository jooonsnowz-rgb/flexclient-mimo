            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jakie pola zawiera treść JSON żądania?</p><code version=\"2\" codelang=\"bash\" name=\"script.sh\" visible-if=\"always\"><content><text value=\"POST https://fakenews.com/article\" /><text type=\"break\" /><text type=\"break\" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"&quot;title&quot;\" class=\"string\" /><text value=\": \" /><text value=\"&quot;UFOs sighted&quot;\" class=\"string\" /><text value=\",\" /><text type=\"break\" /><text value=\" \" /><text value=\"&quot;content&quot;\" class=\"string\" /><text value=\": \" /><text value=\"&quot;Belive it or not ...&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>title</code> i <code>content</code></item><item value=\"2\" correct=\"false\"><code>title</code> i <code>date</code></item><item value=\"3\" correct=\"false\"><code>content</code> i <code>author</code></item><item value=\"4\" correct=\"false\"><code>date</code> i <code>author</code></item></selection><p visible-if=\"wrong\"><code>title</code> i <code>content</code>.</p></body></html>"
