            "hardModeContent": "<!DOCTYPE html ><html><body><p>Operator <code>+</code> łączy etykietę z wartością logiczną. Co wyświetli konsola?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Repeat song: &quot;\" class=\"string\" /><text value=\" + \" /><text value=\"true\" class=\"literal\" /><text value=\");\" /></content><output><content><text value=\"Repeat song: true\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Ciąg znaków <code>\"Repeat song: true\"</code></item><item value=\"2\" correct=\"false\">Wartość logiczna <code>true</code></item><item value=\"3\" correct=\"false\">Ciąg znaków <code>\"Repeat song: \"</code></item><item value=\"4\" correct=\"false\">Ciąg znaków <code>\"Repeat song: false\"</code></item></selection><p visible-if=\"wrong\">Ciąg znaków <code>\"Repeat song: true\"</code>.</p></body></html>"
