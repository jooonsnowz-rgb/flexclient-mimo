            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co robi <code>!==</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Sprawdza, czy ciąg znaków nie jest równy innemu ciągowi znaków</item><item value=\"2\" correct=\"false\">Sprawdza, czy jeden ciąg znaków jest równy innemu ciągowi znaków</item><item value=\"2\" correct=\"false\">Sprawdza, czy jeden ciąg znaków jest krótszy od innego ciągu znaków</item></selection><p visible-if=\"wrong\">Sprawdza, czy ciąg znaków nie jest równy innemu ciągowi znaków.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>W wyrażeniu <code>name !== \"Nina\"</code> zmienna <code>name</code> przechowuje <code>\"Mika\"</code>. Co sprawdza operator <code>!==</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Sprawdza, czy ciąg znaków nie jest równy innemu ciągowi znaków</item><item value=\"2\" correct=\"false\">Sprawdza, czy jeden ciąg znaków jest równy innemu ciągowi znaków</item><item value=\"3\" correct=\"false\">Sprawdza, czy jeden ciąg znaków jest krótszy od innego ciągu znaków</item><item value=\"4\" correct=\"false\">Przypisuje <code>\"Nina\"</code> do zmiennej <code>name</code></item></selection><p visible-if=\"wrong\">Sprawdza, czy ciąg znaków nie jest równy innemu ciągowi znaków.</p></body></html>"
          },
