            "interactiveContent": "<!DOCTYPE html ><html><body><p>Sprawdź, czy <code>score</code> jest większe lub równe <code>minScore</code>, używając operatora większe lub równe.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" score = \" /><text value=\"11\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" minScore = \" /><text value=\"10\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" pass = score &gt;= minScore;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(pass);\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"58\" endIndex=\"60\" /></interactions><output><content><text value=\"true\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>&gt;=</code>.</p></body></html>"
