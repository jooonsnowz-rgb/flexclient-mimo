          {
            "title": "Example: Aliasing",
            "id": 129097,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wybierz wartość <code>name</code> dla najstarszej gry pod aliasem <code>oldest</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" oldest\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" = \" /><text value=\"1983\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"11\" /><option startIndex=\"12\" endIndex=\"14\" /><option startIndex=\"15\" endIndex=\"21\" /><option correct=\"false\"><content><text value=\"release\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"oldest\" /></row><row><data content=\"Mario Bros.\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>SELECT</code>, następnie <code>name</code>, a potem <code>AS</code>, <code>oldest</code>.</p></body></html>"
          },
          {
            "title": "Question: The inequality operator 2",
            "id": 91829,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Które zapytanie wybiera elementy, w których właściwość <code>destination</code> nie ma wartości <code>'Rome'</code>?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" flights\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" destination = \" /><text value=\"'Rome'\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" flights\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" destination &lt;&gt; \" /><text value=\"'Rome'\" class=\"string\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Druga, ponieważ używa operatora nierówności <code>&lt;&gt;</code></item><item value=\"2\" correct=\"false\">Pierwsza, ponieważ używa operatora równości <code>=</code></item><item value=\"3\" correct=\"false\">Oba</item></selection><p visible-if=\"wrong\">Druga, ponieważ używa operatora nierówności <code>&lt;&gt;</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>W języku SQL operator <code>&lt;&gt;</code> sprawdza, czy dwie wartości są różne.</p><p>Miejsce docelowe lotu to <code>'Paris'</code>. Które zapytanie uwzględnia ten lot?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" flights\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" destination = \" /><text value=\"'Rome'\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" flights\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" destination &lt;&gt; \" /><text value=\"'Rome'\" class=\"string\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Tylko drugie zapytanie.</item><item value=\"2\" correct=\"false\">Tylko pierwsze zapytanie.</item><item value=\"3\" correct=\"false\">Oba zapytania.</item><item value=\"4\" correct=\"false\">Żadne zapytanie.</item></selection><p visible-if=\"wrong\">Tylko drugie zapytanie.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example: The inequality operator 2",
            "id": 91827,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zakoduj warunek wybierający wszystkie elementy <code>flights</code>, w których <code>daily</code> nie jest równe <code>1</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE flights (&#xA;destination varchar(255),&#xA;daily int&#xA;);&#xA;&#xA;INSERT INTO flights (destination, daily)&#xA;VALUES ('New York', 1);&#xA;INSERT INTO flights (destination, daily)&#xA;VALUES ('Paris', 3);&#xA;INSERT INTO flights (destination, daily)&#xA;VALUES ('Hong Kong', 1);&#xA;INSERT INTO flights (destination, daily)&#xA;VALUES ('Rome', 3);\"><tables><table name=\"flights\"><row><header content=\"destination\" /><header content=\"daily\" /></row><row><data content=\"New York\" /><data content=\"1\" /></row><row><data content=\"Paris\" /><data content=\"3\" /></row><row><data content=\"Hong Kong\" /><data content=\"1\" /></row><row><data content=\"Rome\" /><data content=\"3\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" flights\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" daily &lt;&gt; \" /><text value=\"1\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"28\" endIndex=\"38\" /></interactions><output><table name=\"Result\"><row><header content=\"destination\" /><header content=\"daily\" /></row><row><data content=\"Paris\" /><data content=\"3\" /></row><row><data content=\"Rome\" /><data content=\"3\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>daily &lt;&gt; 1</code>.</p></body></html>"
          },
          {
            "title": "Example: AS",
            "id": 129098,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wybierz nazwę najnowszej gry pod aliasem za pomocą <code>SELECT name</code>, <code>AS</code> i aliasu <code>newest</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" newest\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" = \" /><text value=\"2013\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"0\" endIndex=\"21\" /></interactions><output><table name=\"Result\"><row><header content=\"newest\" /></row><row><data content=\"Super Mario 3D World\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>SELECT name AS newest</code>.</p></body></html>"
          },
          {
            "title": "Question: Only within the query",
            "id": 129096,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jak nazywa się kolumna <code>name</code> w tabeli <em>original</em> po uruchomieniu tego zapytania?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" newest\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" = \" /><text value=\"2013\" class=\"number\" /><text value=\";\" /></content><output><table name=\"Result\"><row><data content=\"No result!\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>name</code>, ponieważ alias nie zmienia oryginalnej tabeli</item><item value=\"2\" correct=\"false\"><code>newest</code>, ponieważ nadaliśmy mu alias</item><item value=\"3\" correct=\"false\"><code>name</code>, ponieważ brakuje słowa kluczowego <code>AS</code></item></selection><p visible-if=\"wrong\"><code>name</code>, ponieważ alias nie zmienia oryginalnej tabeli.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Alias zmienia etykietę zwracanej kolumny, a nie oryginalną tabelę.</p><p>Usuwasz <code>AS newest</code>. Jak nazywają się teraz zwracana kolumna i kolumna w oryginalnej tabeli?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" newest\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" = \" /><text value=\"2013\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Obie nazywają się name.</item><item value=\"2\" correct=\"false\">Obie nazywają się newest.</item><item value=\"3\" correct=\"false\">Wynik używa name, a tabela używa newest.</item><item value=\"4\" correct=\"false\">Wynik używa newest, a tabela używa name.</item></selection><p visible-if=\"wrong\">Obie nazywają się name.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example: As many as we want",
            "id": 129099,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wpisz przecinek <code>,</code>, a następnie wybierz również kolumnę <code>release</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" newest, \" /><text value=\"release\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" = \" /><text value=\"2013\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"21\" endIndex=\"30\" /></interactions><output><table name=\"Result\"><row><header content=\"newest\" /><header content=\"release\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>, release</code>.</p></body></html>"
          },
          {
            "title": "Example: As many as we want 2",
            "id": 129100,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wybierz kolumnę <code>release</code> i zmień jej nazwę na <code>year</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" newest, \" /><text value=\"release\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" = \" /><text value=\"2013\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"23\" endIndex=\"30\" /><option startIndex=\"31\" endIndex=\"33\" /><option startIndex=\"34\" endIndex=\"38\" /><option correct=\"false\"><content><text value=\"release_year\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"newest\" /><header content=\"year\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>release</code>, następnie <code>AS</code> i na końcu <code>year</code>.</p></body></html>"
          },
          {
            "title": "Question: Inequality with text values",
            "id": 91828,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co jest nie tak z tym zapytaniem?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" daily\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" flights\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" destination &lt;&gt; \" /><text value=\"'Paris'\" class=\"string\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Z zapytaniem jest wszystko w porządku</item><item value=\"2\" correct=\"false\">Nie możemy używać <code>&lt;&gt;</code> z wartościami tekstowymi, takimi jak <code>'Paris'</code></item><item value=\"3\" correct=\"false\">Zawsze musimy wybierać wszystkie kolumny za pomocą <code>*</code></item></selection><p visible-if=\"wrong\">Z zapytaniem jest wszystko w porządku.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Jeden lot prowadzi do <code>'Paris'</code> i ma <code>daily = 2</code>, a drugi do <code>'Rome'</code> i ma <code>daily = 3</code>.</p><p>Co to zapytanie zwróci z tych dwóch wierszy?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" daily\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" flights\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" destination &lt;&gt; \" /><text value=\"'Paris'\" class=\"string\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Tylko wartość daily równą 3.</item><item value=\"2\" correct=\"false\">Tylko miejsce docelowe Rome.</item><item value=\"3\" correct=\"false\">Wartości daily równe 2 i 3.</item><item value=\"4\" correct=\"false\">Tylko wartość daily równą 2.</item></selection><p visible-if=\"wrong\">Tylko wartość daily równą 3.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Inequality with text values",
            "id": 91833,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Napisz <code>WHERE</code> i warunek sprawdzający, czy właściwość <code>destination</code> nie jest równa <code>'Paris'</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE flights (&#xA;destination varchar(255),&#xA;daily int&#xA;);&#xA;&#xA;INSERT INTO flights (destination, daily)&#xA;VALUES ('New York', 1);&#xA;INSERT INTO flights (destination, daily)&#xA;VALUES ('Paris', 3);&#xA;INSERT INTO flights (destination, daily)&#xA;VALUES ('Hong Kong', 1);&#xA;INSERT INTO flights (destination, daily)&#xA;VALUES ('Rome', 3);\"><tables><table name=\"flights\"><row><header content=\"destination\" /><header content=\"daily\" /></row><row><data content=\"New York\" /><data content=\"1\" /></row><row><data content=\"Paris\" /><data content=\"3\" /></row><row><data content=\"Hong Kong\" /><data content=\"1\" /></row><row><data content=\"Rome\" /><data content=\"3\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" flights\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" destination &lt;&gt; \" /><text value=\"'Paris'\" class=\"string\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"22\" endIndex=\"50\" /></interactions><output><table name=\"Result\"><row><header content=\"destination\" /><header content=\"daily\" /></row><row><data content=\"New York\" /><data content=\"1\" /></row><row><data content=\"Hong Kong\" /><data content=\"1\" /></row><row><data content=\"Rome\" /><data content=\"3\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>WHERE destination &lt;&gt; 'Paris'</code>.</p></body></html>"
          },
          {
            "title": "Question: Greater than operator",
            "id": 91838,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Które zapytanie wybiera elementy, w których <code>games_won</code> jest większe niż <code>1000</code>?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" chess_players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" games_won &lt; \" /><text value=\"1000\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" chess_players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" games_won &gt; \" /><text value=\"1000\" class=\"number\" /><text value=\";\" /><text type=\"break\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Druga</item><item value=\"2\" correct=\"false\">Pierwszy</item><item value=\"3\" correct=\"false\">Oba</item></selection><p visible-if=\"wrong\">Koniecznie wybierz Druga.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>W języku SQL <code>&lt;</code> oznacza mniej niż, a <code>&gt;</code> oznacza więcej niż.</p><p>Gracz ma dokładnie <code>1000</code> zwycięstw. Które zapytanie zwróci tego gracza?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" chess_players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" games_won &lt; \" /><text value=\"1000\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" chess_players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" games_won &gt; \" /><text value=\"1000\" class=\"number\" /><text value=\";\" /><text type=\"break\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Żadne zapytanie.</item><item value=\"2\" correct=\"false\">Tylko pierwsze zapytanie.</item><item value=\"3\" correct=\"false\">Tylko drugie zapytanie.</item><item value=\"4\" correct=\"false\">Oba zapytania.</item></selection><p visible-if=\"wrong\">Żadne zapytanie.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example: Less than operator",
            "id": 91836,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Napisz <code>WHERE</code>, a następnie warunek sprawdzający, czy <code>games_won</code> jest mniejsze niż <code>1000</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE chess_players (&#xA;name varchar(255),&#xA;games_won int&#xA;);&#xA;&#xA;INSERT INTO chess_players (name, games_won)&#xA;VALUES ('Carlsen', 1162);&#xA;INSERT INTO chess_players (name, games_won)&#xA;VALUES ('Kasparov', 1370);&#xA;INSERT INTO chess_players (name, games_won)&#xA;VALUES ('Polgár', 692);&#xA;INSERT INTO chess_players (name, games_won)&#xA;VALUES ('Fischer', 546);\"><tables><table name=\"chess_players\"><row><header content=\"name\" /><header content=\"games_won\" /></row><row><data content=\"Carlsen\" /><data content=\"1162\" /></row><row><data content=\"Kasparov\" /><data content=\"1370\" /></row><row><data content=\"Polgár\" /><data content=\"692\" /></row><row><data content=\"Fischer\" /><data content=\"546\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" *\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" chess_players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" games_won &lt; \" /><text value=\"1000\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"28\" endIndex=\"50\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"games_won\" /></row><row><data content=\"Polgár\" /><data content=\"692\" /></row><row><data content=\"Fischer\" /><data content=\"546\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>WHERE games_won &lt; 1000</code>.</p></body></html>"
          },
          {
            "title": "Question: The <= operator",
            "id": 91835,
