            "id": 145621,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zakoduj słowo kluczowe <code>function</code>, aby ukończyć funkcję.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"0\" endIndex=\"8\" isDefault=\"true\" /></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"addScore\" class=\"title\" /><text value=\"(\" /><text value=\"\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Score update&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;+10 points&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"addScore();}\" /></content></code><p visible-if=\"wrong\">Koniecznie wpisz <code>function</code>.</p></body></html>"
          },
