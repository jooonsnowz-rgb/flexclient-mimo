            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jak uruchamiamy kod znajdujący się wewnątrz funkcji?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Wywołując ją</item><item value=\"2\" correct=\"false\">Tworząc na jego podstawie zmienną</item></selection><p visible-if=\"wrong\">Wywołując ją.</p></body></html>"
