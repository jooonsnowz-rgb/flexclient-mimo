            "id": 152220,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Znak ampersand <code>&amp;</code> oddziela jeden parametr zapytania od następnego.</p><p>Dodaj <code>&amp;</code> po parametrze języka, aby zrobić miejsce na kolejny.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"url = \" /><text value=\"&quot;https://mimo.org/courses?language=python&amp;&quot;\" class=\"string\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"47\" endIndex=\"48\" /><option correct=\"false\"><content><text value=\"?\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>&amp;</code>.</p></body></html>",
            "hardModeSelected": true
