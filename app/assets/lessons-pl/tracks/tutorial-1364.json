            "interactiveContent": "<!DOCTYPE html ><html><body><p>Aby ponownie użyć zbioru, możemy przechować go w zmiennej takiej jak <code>postcodes</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"postcodes = {\" /><text value=\"&quot;SW1A&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;SY3&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;B44&quot;\" class=\"string\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"9\" /><option startIndex=\"10\" endIndex=\"11\" /></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>postcodes</code>, a następnie <code>=</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Aby ponownie użyć zbioru, zapisz go w zmiennej o nazwie <code>postcodes</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"postcodes = {\" /><text value=\"&quot;SW1A&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;SY3&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;B44&quot;\" class=\"string\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"9\" /><option startIndex=\"10\" endIndex=\"11\" /><option correct=\"false\"><content><text value=\"==\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>postcodes</code>, a następnie <code>=</code>.</p></body></html>",
