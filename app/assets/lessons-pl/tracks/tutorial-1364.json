            "id": 89142,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Oddzielamy wartości zbioru, takie jak <code>\"SW1A\"</code> i <code>\"SY3\"</code>, za pomocą przecinków <code>,</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"postcodes = {\" /><text value=\"&quot;SW1A&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;SY3&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;B44&quot;\" class=\"string\" /><text value=\"}\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"19\" endIndex=\"20\" /></interactions></code><p visible-if=\"wrong\">Koniecznie wpisz <code>,</code>.</p></body></html>"
