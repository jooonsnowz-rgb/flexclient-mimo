            "id": 89457,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Przypisz do zmiennej <code>cities</code> prawidłowy zbiór.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"cities = {\" /><text value=\"&quot;Kyoto&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Oslo&quot;\" class=\"string\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"9\" endIndex=\"26\" /><option correct=\"false\"><content><text value=\"{&quot;Kyoto&quot;, &quot;Kyoto&quot;, &quot;Oslo&quot;}\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>{\"Kyoto\", \"Oslo\"}</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Zapisz <code>\"Kyoto\"</code> i <code>\"Oslo\"</code> w zbiorze o nazwie <code>cities</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"cities = {\" /><text value=\"&quot;Kyoto&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Oslo&quot;\" class=\"string\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"9\" endIndex=\"26\" /><option correct=\"false\"><content><text value=\"[&quot;Kyoto&quot;, &quot;Oslo&quot;]\" /></content></option><option correct=\"false\"><content><text value=\"(&quot;Kyoto&quot;, &quot;Oslo&quot;)\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>{\"Kyoto\", \"Oslo\"}</code>.</p></body></html>",
            "hardModeSelected": true
