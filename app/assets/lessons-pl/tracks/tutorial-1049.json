            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Do czego służą <code>attributes</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Aby dostarczać dodatkowe informacje o znacznikach</item><item value=\"2\" correct=\"false\">Aby zamienić wszystkie znaczniki w linki</item></selection><p visible-if=\"wrong\">Aby dostarczać dodatkowe informacje o znacznikach.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Do czego służy atrybut <code>href</code> w <code>&lt;a href=\"https://mimo.org\"&gt;</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Dostarcza dodatkowych informacji o znaczniku</item><item value=\"2\" correct=\"false\">Zastępuje tekst wyświetlany na stronie</item><item value=\"3\" correct=\"false\">Zmienia znacznik odnośnika w inny element</item></selection><p visible-if=\"wrong\">Dostarcza dodatkowych informacji o znaczniku.</p></body></html>"
