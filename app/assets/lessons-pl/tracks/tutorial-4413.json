            "id": 147894,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Utwórz tablicę, w której <code>\"coin\"</code>, a następnie <code>\"gem\"</code> są dwiema ostatnimi wartościami.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"&quot;apple&quot;\" /></content></option><option startIndex=\"34\" endIndex=\"40\" /><option startIndex=\"40\" endIndex=\"41\" /><option startIndex=\"42\" endIndex=\"47\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" pickups = [\" /><text value=\"&quot;heart&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;star&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;coin&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;gem&quot;\" class=\"string\" /><text value=\"];\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>\"coin\"</code>, następnie <code>,</code> i na końcu <code>\"gem\"</code>.</p></body></html>"
          },
          {
