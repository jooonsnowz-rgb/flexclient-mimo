            "interactiveContent": "<!DOCTYPE html ><html><body><p>Utwórz tablicę z dwiema wartościami, zapisując <code>, \"Shield\"</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"26\" endIndex=\"36\" isDefault=\"true\" /></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" equipment = [\" /><text value=\"&quot;Sword&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Shield&quot;\" class=\"string\" /><text value=\"];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(equipment);}\" /></content></code><p visible-if=\"wrong\">Koniecznie wpisz <code>, \"Shield\"</code>.</p></body></html>"
