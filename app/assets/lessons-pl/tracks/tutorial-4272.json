            "interactiveContent": "<!DOCTYPE html ><html><body><p>Gdzie umieszcza się instrukcję <code>else</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Na końcu bloku kodu instrukcji <code>if</code></item><item value=\"2\" correct=\"false\">Przed blokiem kodu instrukcji <code>if</code></item></selection><p visible-if=\"wrong\">Na końcu bloku kodu instrukcji <code>if</code>.</p></body></html>"
