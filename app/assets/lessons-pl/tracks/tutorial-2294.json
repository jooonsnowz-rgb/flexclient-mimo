        "lessons": [
          {
            "title": "Example: Condition",
            "id": 93291,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Użyj <code>WHERE</code> po nazwie kolumny, aby uzyskać tylko te gry, które zostały wydane między 2000 a 2020 rokiem.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"2000\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"2020\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"27\" endIndex=\"40\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>WHERE release</code>.</p></body></html>"
          },
          {
            "title": "Question: Defining a range",
            "id": 93288,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co wybiera to zapytanie?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" score \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"0\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"50\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">  Elementy <code>players</code> z <code>score</code> w zakresie od 0 do 50</item><item value=\"2\" correct=\"false\">elementy <code>players</code> z wartością <code>score</code> większą niż 50</item><item value=\"3\" correct=\"false\">Elementy <code>players</code> z wynikiem równym 50</item></selection><p visible-if=\"wrong\">  Elementy <code>players</code> z <code>score</code> w zakresie od 0 do 50.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Gracze mają wyniki <code>0</code>, <code>25</code>, <code>50</code> i <code>51</code>. Które wyniki wybierze pokazane zapytanie?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" score \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"0\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"50\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>0</code>, <code>25</code> i <code>50</code></item><item value=\"2\" correct=\"false\">Tylko <code>25</code>, ponieważ obie granice są wykluczone</item><item value=\"3\" correct=\"false\">Tylko <code>0</code> i <code>50</code>, ponieważ pasują wyłącznie granice</item><item value=\"4\" correct=\"false\">Tylko <code>51</code>, ponieważ <code>BETWEEN</code> oznacza wartość większą od górnej granicy</item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>0</code>, <code>25</code> i <code>50</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example: The keyword BETWEEN",
            "id": 93292,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dokończ kodowanie warunku, aby w tabeli wyników pojawiały się tylko gry wydane w latach 1990–2000.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"1990\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"2000\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"41\" endIndex=\"62\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>BETWEEN 1990 AND 2000</code>.</p></body></html>"
          },
          {
            "title": "Question: Border inclusive",
            "id": 93289,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Czy to zapytanie wybierze elementy z wynikiem równym <code>70</code> lub <code>100</code>?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" score \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"70\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"100\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Tak, ponieważ zakresy obejmują swoje granice</item><item value=\"2\" correct=\"false\">Nie, ponieważ zakresy <em>nie obejmują</em> swoich granic</item><item value=\"3\" correct=\"false\">Tak, wybierze <em>tylko</em> elementy z wartością <code>score</code> równą <code>70</code> lub <code>100</code>, bez żadnych wartości pomiędzy nimi</item></selection><p visible-if=\"wrong\">Tak, ponieważ zakresy obejmują swoje granice.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Które z wyników <code>69</code>, <code>70</code>, <code>85</code>, <code>100</code> i <code>101</code> wybierze zapytanie?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" players\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" score \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"70\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"100\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>70</code>, <code>85</code> i <code>100</code></item><item value=\"2\" correct=\"false\">Tylko <code>85</code>, ponieważ granice są wykluczone</item><item value=\"3\" correct=\"false\">Tylko <code>70</code> i <code>100</code>, ponieważ <code>BETWEEN</code> wymienia dwie konkretne opcje</item><item value=\"4\" correct=\"false\"><code>85</code>, <code>100</code> i <code>101</code>, ponieważ obowiązuje tylko dolna granica</item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>70</code>, <code>85</code> i <code>100</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example: Border inclusive",
            "id": 93294,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zakoduj warunek tak, aby gry wydane w latach od 1995 do 2007 włącznie pojawiały się w tabeli wyników.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE mario_games (&#xA; name varchar(255),&#xA; release int&#xA;);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Bros.', 1983);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Mario Clash', 1995);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario Galaxy', 2007);&#xA;&#xA;INSERT INTO mario_games (name, release)&#xA;VALUES ('Super Mario 3D World', 2013);&#xA;\"><tables><table name=\"mario_games\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Bros.\" /><data content=\"1983\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row><row><data content=\"Super Mario 3D World\" /><data content=\"2013\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" mario_games\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"release\" class=\"keyword\" /><text value=\" \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"1995\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"2007\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"27\" endIndex=\"40\" /><option startIndex=\"41\" endIndex=\"48\" /><option startIndex=\"49\" endIndex=\"53\" /><option startIndex=\"54\" endIndex=\"57\" /><option startIndex=\"58\" endIndex=\"62\" /><option correct=\"false\"><content><text value=\"1996\" /></content></option><option correct=\"false\"><content><text value=\"2008\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"release\" /></row><row><data content=\"Mario Clash\" /><data content=\"1995\" /></row><row><data content=\"Super Mario Galaxy\" /><data content=\"2007\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>WHERE release</code>, następnie <code>BETWEEN</code>, a potem <code>1995</code>, <code>AND</code>, <code>2007</code>.</p></body></html>"
          },
          {
            "title": "Question: A pattern is a text",
            "id": 93785,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dlaczego otaczamy wzorce apostrofami?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Ponieważ wzorce również są wartościami tekstowymi</item><item value=\"2\" correct=\"false\">Nie otaczamy wzorców prostymi cudzysłowami</item><item value=\"3\" correct=\"false\">Nie otaczamy całego wzorca prostymi cudzysłowami, tylko symbolem wieloznacznym <code>%</code></item></selection><p visible-if=\"wrong\">Ponieważ wzorce również są wartościami tekstowymi.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Wzorce są wartościami tekstowymi. Otocz cały wzorzec apostrofami.</p><p>Masz <code>A'%'</code>. Która zmiana sprawi, że cały wzorzec <code>A%</code> będzie jedną wartością tekstową?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Przenieś apostrof otwierający przed <code>A</code></item><item value=\"2\" correct=\"false\">Usuń oba apostrofy</item><item value=\"3\" correct=\"false\">Umieść apostrofy wokół nazwy kolumny</item><item value=\"4\" correct=\"false\">Przenieś apostrof zamykający przed <code>%</code></item></selection><p visible-if=\"wrong\">Przenieś apostrof otwierający przed <code>A</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Question: Zero or more symbols",
            "id": 93786,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co dopasuje wzorzec w tym zapytaniu?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE users (&#xA;name varchar(255),&#xA;email varchar(255)&#xA;&#xA;);&#xA;&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Tara', 'tara.smith@gmail.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Ben', 'ben.turner@rdelivery.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Joan', 'joan.j@threadandco.uk');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Kim', 'kim.s.lee@gmail.uk');\"><tables><table name=\"users\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Tara\" /><data content=\"tara.smith@gmail.com\" /></row><row><data content=\"Ben\" /><data content=\"ben.turner@rdelivery.com\" /></row><row><data content=\"Joan\" /><data content=\"joan.j@threadandco.uk\" /></row><row><data content=\"Kim\" /><data content=\"kim.s.lee@gmail.uk\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" \" /><text value=\"users\" class=\"keyword\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" email \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'ben%'\" class=\"string\" /><text value=\";\" /></content><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Ben\" /><data content=\"ben.turner@rdelivery.com\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Wartości zaczynające się od tekstu <code>'ben'</code></item><item value=\"2\" correct=\"false\">Wartości kończące się tekstem <code>'ben'</code></item><item value=\"3\" correct=\"false\">Wartości zawierające tekst <code>'ben'</code></item></selection><p visible-if=\"wrong\">Wartości zaczynające się od tekstu <code>'ben'</code>.</p></body></html>"
          },
          {
            "title": "Example: Start with",
            "id": 93790,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zakoduj wzorzec dopasowujący wartości <code>email</code> zaczynające się od <code>'kim'</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE users (&#xA;name varchar(255),&#xA;email varchar(255)&#xA;&#xA;);&#xA;&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Tara', 'tara.smith@gmail.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Ben', 'ben.turner@rdelivery.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Joan', 'joan.j@threadandco.uk');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Kim', 'kim.s.lee@gmail.uk');\"><tables><table name=\"users\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Tara\" /><data content=\"tara.smith@gmail.com\" /></row><row><data content=\"Ben\" /><data content=\"ben.turner@rdelivery.com\" /></row><row><data content=\"Joan\" /><data content=\"joan.j@threadandco.uk\" /></row><row><data content=\"Kim\" /><data content=\"kim.s.lee@gmail.uk\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" \" /><text value=\"users\" class=\"keyword\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" email \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'kim%'\" class=\"string\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"38\" endIndex=\"44\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Kim\" /><data content=\"kim.s.lee@gmail.uk\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>'kim%'</code>.</p></body></html>"
          },
          {
            "title": "Example: End with",
            "id": 93791,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zakoduj wzorzec, który dopasowuje wartości <code>email</code> kończące się na <code>'.uk'</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE users (&#xA;name varchar(255),&#xA;email varchar(255)&#xA;&#xA;);&#xA;&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Tara', 'tara.smith@gmail.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Ben', 'ben.turner@rdelivery.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Joan', 'joan.j@threadandco.uk');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Kim', 'kim.s.lee@gmail.uk');\"><tables><table name=\"users\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Tara\" /><data content=\"tara.smith@gmail.com\" /></row><row><data content=\"Ben\" /><data content=\"ben.turner@rdelivery.com\" /></row><row><data content=\"Joan\" /><data content=\"joan.j@threadandco.uk\" /></row><row><data content=\"Kim\" /><data content=\"kim.s.lee@gmail.uk\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" \" /><text value=\"users\" class=\"keyword\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" email \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'%.uk'\" class=\"string\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"38\" endIndex=\"44\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Joan\" /><data content=\"joan.j@threadandco.uk\" /></row><row><data content=\"Kim\" /><data content=\"kim.s.lee@gmail.uk\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>'%.uk'</code>.</p></body></html>"
          },
          {
            "title": "Example: Containing",
            "id": 93792,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Użyj dwóch symboli wieloznacznych i <code>LIKE</code>, aby zapisać warunek sprawdzający, czy wartość w kolumnie <code>email</code> zawiera <code>'gmail'</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE users (&#xA;name varchar(255),&#xA;email varchar(255)&#xA;&#xA;);&#xA;&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Tara', 'tara.smith@gmail.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Ben', 'ben.turner@rdelivery.com');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Joan', 'joan.j@threadandco.uk');&#xA;INSERT INTO users (name, email)&#xA;VALUES ('Kim', 'kim.s.lee@gmail.uk');\"><tables><table name=\"users\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Tara\" /><data content=\"tara.smith@gmail.com\" /></row><row><data content=\"Ben\" /><data content=\"ben.turner@rdelivery.com\" /></row><row><data content=\"Joan\" /><data content=\"joan.j@threadandco.uk\" /></row><row><data content=\"Kim\" /><data content=\"kim.s.lee@gmail.uk\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" \" /><text value=\"users\" class=\"keyword\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" email \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'%gmail%'\" class=\"string\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"27\" endIndex=\"47\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"email\" /></row><row><data content=\"Tara\" /><data content=\"tara.smith@gmail.com\" /></row><row><data content=\"Kim\" /><data content=\"kim.s.lee@gmail.uk\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>email LIKE '%gmail%'</code>.</p></body></html>"
          },
          {
            "title": "Example: IN keyword",
            "id": 93813,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wpisz brakujące słowo kluczowe, aby wybierać tylko elementy, których wartość <code>type</code> to <code>'basic'</code> lub <code>'pro'</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE membership (&#xA; name varchar(255),&#xA; type varchar(255),&#xA; months_active int&#xA;);&#xA;&#xA;INSERT INTO membership (name, type, months_active)&#xA;VALUES ('Sam', 'free', 2);&#xA;&#xA;INSERT INTO membership (name, type, months_active)&#xA;VALUES ('Remy', 'pro', 1);&#xA;&#xA;INSERT INTO membership (name, type, months_active)&#xA;VALUES ('Luis', 'basic', 12);&#xA;&#xA;INSERT INTO membership (name, type, months_active)&#xA;VALUES ('Kim', 'pro', 7);&#xA;\"><tables><table name=\"membership\"><row><header content=\"name\" /><header content=\"type\" /><header content=\"months_active\" /></row><row><data content=\"Sam\" /><data content=\"free\" /><data content=\"2\" /></row><row><data content=\"Remy\" /><data content=\"pro\" /><data content=\"1\" /></row><row><data content=\"Luis\" /><data content=\"basic\" /><data content=\"12\" /></row><row><data content=\"Kim\" /><data content=\"pro\" /><data content=\"7\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" membership\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"type\" class=\"keyword\" /><text value=\" \" /><text value=\"IN\" class=\"keyword\" /><text value=\" (\" /><text value=\"'basic'\" class=\"string\" /><text value=\", \" /><text value=\"'pro'\" class=\"string\" /><text value=\");\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"37\" endIndex=\"39\" /></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"type\" /><header content=\"months_active\" /></row><row><data content=\"Remy\" /><data content=\"pro\" /><data content=\"1\" /></row><row><data content=\"Luis\" /><data content=\"basic\" /><data content=\"12\" /></row><row><data content=\"Kim\" /><data content=\"pro\" /><data content=\"7\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>IN</code>.</p></body></html>"
