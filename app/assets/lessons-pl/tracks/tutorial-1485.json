        "lessons": [
          {
            "title": "Temporary",
            "id": 96466,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Aliasing nie zmienia nazwy w oryginalnej tabeli. Aliasy, takie jak <code>user</code>, to tymczasowe nazwy w tabeli wyników.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE contacts (&#xA; first_name varchar(255),&#xA; last_name varchar(255),&#xA; email varchar(255)&#xA;);&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Sam', 'Smith', 'sam17@mail.com');&#xA;&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Remy', 'Allard', 'rem@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Luis', 'Martinez', 'luis_99@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Kim', 'Zhong', 'kim.z@mail.com');&#xA;\"><tables><table name=\"contacts\"><row><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"Sam\" /><data content=\"Smith\" /><data content=\"sam17@mail.com\" /></row><row><data content=\"Remy\" /><data content=\"Allard\" /><data content=\"rem@mail.com\" /></row><row><data content=\"Luis\" /><data content=\"Martinez\" /><data content=\"luis_99@mail.com\" /></row><row><data content=\"Kim\" /><data content=\"Zhong\" /><data content=\"kim.z@mail.com\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" first_name \" /><text value=\"AS\" class=\"keyword\" /><text value=\" \" /><text value=\"user\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" contacts;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"17\" /><option startIndex=\"18\" endIndex=\"20\" /><option startIndex=\"21\" endIndex=\"25\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"user\" /></row><row><data content=\"Sam\" /></row><row><data content=\"Remy\" /></row><row><data content=\"Luis\" /></row><row><data content=\"Kim\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>SELECT</code>, następnie <code>first_name</code>, a potem <code>AS</code>, <code>user</code>.</p></body></html>"
          },
          {
            "title": "As many as we want",
            "id": 96467,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Możemy również używać aliasów podczas wybierania wielu kolumn. Wybierz także kolumnę <code>email</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE contacts (&#xA; first_name varchar(255),&#xA; last_name varchar(255),&#xA; email varchar(255)&#xA;);&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Sam', 'Smith', 'sam17@mail.com');&#xA;&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Remy', 'Allard', 'rem@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Luis', 'Martinez', 'luis_99@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Kim', 'Zhong', 'kim.z@mail.com');&#xA;\"><tables><table name=\"contacts\"><row><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"Sam\" /><data content=\"Smith\" /><data content=\"sam17@mail.com\" /></row><row><data content=\"Remy\" /><data content=\"Allard\" /><data content=\"rem@mail.com\" /></row><row><data content=\"Luis\" /><data content=\"Martinez\" /><data content=\"luis_99@mail.com\" /></row><row><data content=\"Kim\" /><data content=\"Zhong\" /><data content=\"kim.z@mail.com\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" first_name \" /><text value=\"AS\" class=\"keyword\" /><text value=\" \" /><text value=\"user\" class=\"keyword\" /><text value=\", email\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" contacts;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"25\" endIndex=\"26\" /><option startIndex=\"27\" endIndex=\"32\" /><option correct=\"false\"><content><text value=\";\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"user\" /><header content=\"email\" /></row><row><data content=\"Sam\" /><data content=\"sam17@mail.com\" /></row><row><data content=\"Remy\" /><data content=\"rem@mail.com\" /></row><row><data content=\"Luis\" /><data content=\"luis_99@mail.com\" /></row><row><data content=\"Kim\" /><data content=\"kim.z@mail.com\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>,</code>, a następnie <code>email</code>.</p></body></html>"
