            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wybierz kolumnę <code>score</code> i zmień jej nazwę na <code>max_score</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; score int&#xA;);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Jean Miller', 5);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Emma Brown', 8);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Reese Jones', 2);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Kim Lee', 9);&#xA;\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"score\" /></row><row><data content=\"Jean Miller\" /><data content=\"5\" /></row><row><data content=\"Emma Brown\" /><data content=\"8\" /></row><row><data content=\"Reese Jones\" /><data content=\"2\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" student, score \" /><text value=\"AS\" class=\"keyword\" /><text value=\" max_score\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" score = \" /><text value=\"9\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"24\" endIndex=\"29\" /><option startIndex=\"30\" endIndex=\"32\" /><option startIndex=\"33\" endIndex=\"42\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"student\" /><header content=\"max_score\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>score</code>, następnie <code>AS</code> i na końcu <code>max_score</code>.</p></body></html>"
