        "lessons": [
          {
            "title": "Intro",
            "id": 96461,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>nazwy tabel lub kolumn mogą być dość długie, tak jak <code>first_name</code> i <code>last_name</code> tutaj.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE contacts (&#xA; first_name varchar(255),&#xA; last_name varchar(255),&#xA; email varchar(255)&#xA;);&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Sam', 'Smith', 'sam17@mail.com');&#xA;&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Remy', 'Allard', 'rem@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Luis', 'Martinez', 'luis_99@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Kim', 'Zhong', 'kim.z@mail.com');&#xA;\"><tables><table name=\"contacts\"><row><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"Sam\" /><data content=\"Smith\" /><data content=\"sam17@mail.com\" /></row><row><data content=\"Remy\" /><data content=\"Allard\" /><data content=\"rem@mail.com\" /></row><row><data content=\"Luis\" /><data content=\"Martinez\" /><data content=\"luis_99@mail.com\" /></row><row><data content=\"Kim\" /><data content=\"Zhong\" /><data content=\"kim.z@mail.com\" /></row></table></tables></database></body></html>"
          },
          {
            "title": "Intro 2",
            "id": 96462,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Aby uprościć nazwy takie jak <code>first_name</code> lub nadać kolumnom inne znaczenie w zapytaniu, używamy <strong>aliasowania</strong>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE contacts (&#xA; first_name varchar(255),&#xA; last_name varchar(255),&#xA; email varchar(255)&#xA;);&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Sam', 'Smith', 'sam17@mail.com');&#xA;&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Remy', 'Allard', 'rem@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Luis', 'Martinez', 'luis_99@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Kim', 'Zhong', 'kim.z@mail.com');&#xA;\"><tables><table name=\"contacts\"><row><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"Sam\" /><data content=\"Smith\" /><data content=\"sam17@mail.com\" /></row><row><data content=\"Remy\" /><data content=\"Allard\" /><data content=\"rem@mail.com\" /></row><row><data content=\"Luis\" /><data content=\"Martinez\" /><data content=\"luis_99@mail.com\" /></row><row><data content=\"Kim\" /><data content=\"Zhong\" /><data content=\"kim.z@mail.com\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" first_name\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" contacts;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"17\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"first_name\" /></row><row><data content=\"Sam\" /></row><row><data content=\"Remy\" /></row><row><data content=\"Luis\" /></row><row><data content=\"Kim\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>SELECT</code>, a następnie <code>first_name</code>.</p></body></html>"
          },
          {
            "title": "Aliasing",
            "id": 96463,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Nadając kolumnie <strong>alias</strong>, przypisujemy jej tymczasową nazwę. Tutaj zmieniamy nazwę <code>first_name</code> na <code>user</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE contacts (&#xA; first_name varchar(255),&#xA; last_name varchar(255),&#xA; email varchar(255)&#xA;);&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Sam', 'Smith', 'sam17@mail.com');&#xA;&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Remy', 'Allard', 'rem@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Luis', 'Martinez', 'luis_99@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Kim', 'Zhong', 'kim.z@mail.com');&#xA;\"><tables><table name=\"contacts\"><row><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"Sam\" /><data content=\"Smith\" /><data content=\"sam17@mail.com\" /></row><row><data content=\"Remy\" /><data content=\"Allard\" /><data content=\"rem@mail.com\" /></row><row><data content=\"Luis\" /><data content=\"Martinez\" /><data content=\"luis_99@mail.com\" /></row><row><data content=\"Kim\" /><data content=\"Zhong\" /><data content=\"kim.z@mail.com\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" first_name \" /><text value=\"AS\" class=\"keyword\" /><text value=\" \" /><text value=\"user\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" contacts;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"18\" endIndex=\"25\" /><option correct=\"false\"><content><text value=\"AS person\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"user\" /></row><row><data content=\"Sam\" /></row><row><data content=\"Remy\" /></row><row><data content=\"Luis\" /></row><row><data content=\"Kim\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>AS user</code>.</p></body></html>"
          },
          {
            "title": "AS",
            "id": 96465,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Podczas nadawania aliasu zaczynamy od wybrania kolumny jak zwykle. Następnie używamy <code>AS</code> z aliasem, takim jak <code>user</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE contacts (&#xA; first_name varchar(255),&#xA; last_name varchar(255),&#xA; email varchar(255)&#xA;);&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Sam', 'Smith', 'sam17@mail.com');&#xA;&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Remy', 'Allard', 'rem@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Luis', 'Martinez', 'luis_99@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Kim', 'Zhong', 'kim.z@mail.com');&#xA;\"><tables><table name=\"contacts\"><row><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"Sam\" /><data content=\"Smith\" /><data content=\"sam17@mail.com\" /></row><row><data content=\"Remy\" /><data content=\"Allard\" /><data content=\"rem@mail.com\" /></row><row><data content=\"Luis\" /><data content=\"Martinez\" /><data content=\"luis_99@mail.com\" /></row><row><data content=\"Kim\" /><data content=\"Zhong\" /><data content=\"kim.z@mail.com\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" first_name \" /><text value=\"AS\" class=\"keyword\" /><text value=\" \" /><text value=\"user\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" contacts;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"18\" endIndex=\"25\" /></interactions><output><table name=\"Result\"><row><header content=\"user\" /></row><row><data content=\"Sam\" /></row><row><data content=\"Remy\" /></row><row><data content=\"Luis\" /></row><row><data content=\"Kim\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>AS user</code>.</p></body></html>"
          },
          {
            "title": "Only within the query",
            "id": 96464,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Podczas nadawania aliasu kolumnie jej nazwa zmienia się w tabeli wyników. Sprawdź kolumnę <code>user</code> w naszych wynikach.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE contacts (&#xA; first_name varchar(255),&#xA; last_name varchar(255),&#xA; email varchar(255)&#xA;);&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Sam', 'Smith', 'sam17@mail.com');&#xA;&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Remy', 'Allard', 'rem@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Luis', 'Martinez', 'luis_99@mail.com');&#xA;&#xA;INSERT INTO contacts (first_name, last_name, email)&#xA;VALUES ('Kim', 'Zhong', 'kim.z@mail.com');&#xA;\"><tables><table name=\"contacts\"><row><header content=\"first_name\" /><header content=\"last_name\" /><header content=\"email\" /></row><row><data content=\"Sam\" /><data content=\"Smith\" /><data content=\"sam17@mail.com\" /></row><row><data content=\"Remy\" /><data content=\"Allard\" /><data content=\"rem@mail.com\" /></row><row><data content=\"Luis\" /><data content=\"Martinez\" /><data content=\"luis_99@mail.com\" /></row><row><data content=\"Kim\" /><data content=\"Zhong\" /><data content=\"kim.z@mail.com\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" first_name \" /><text value=\"AS\" class=\"keyword\" /><text value=\" \" /><text value=\"user\" class=\"keyword\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" contacts;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"21\" endIndex=\"25\" /></interactions><output><table name=\"Result\"><row><header content=\"user\" /></row><row><data content=\"Sam\" /></row><row><data content=\"Remy\" /></row><row><data content=\"Luis\" /></row><row><data content=\"Kim\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>user</code>.</p></body></html>"
          },
          {
            "title": "Question: Aliasing",
            "id": 96784,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co robi aliasowanie?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Aliasing nadaje kolumnie tymczasową nazwę, alias</item><item value=\"2\" correct=\"false\">Aliasing wybiera tylko pierwszą wartość w kolumnie</item></selection><p visible-if=\"wrong\">Aliasing nadaje kolumnie tymczasową nazwę, alias.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Uruchamiasz zapytanie <code>SELECT price AS cost FROM products;</code> Jaki nagłówek pojawi się w tabeli wyników?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>cost</code></item><item value=\"2\" correct=\"false\"><code>price</code>, ponieważ aliasy służą tylko do opisywania wartości</item><item value=\"3\" correct=\"false\"><code>products</code>, ponieważ nazwa tabeli staje się nagłówkiem</item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>cost</code>.</p></body></html>"
          },
          {
            "title": "Question: AS",
            "id": 96785,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jakiego słowa kluczowego używamy podczas tworzenia aliasu?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>AS</code></item><item value=\"2\" correct=\"false\"><code>FROM</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>AS</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Podczas tworzenia aliasu używamy słowa <code>AS</code>. Chcesz wybrać właściwość <code>price</code> i wyświetlić ją pod nagłówkiem <code>cost</code>. W którym fragmencie słowo kluczowe znajduje się we właściwym miejscu?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>price AS cost</code></item><item value=\"2\" correct=\"false\"><code>price FROM cost</code></item><item value=\"3\" correct=\"false\"><code>cost AS price</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>price AS cost</code>.</p></body></html>"
          },
          {
            "title": "Question: Only within the query",
            "id": 96786,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Czy alias zmienia nazwę kolumny w oryginalnej tabeli?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Nie, aliasowanie zmienia nazwę kolumny tylko w tabeli wynikowej</item><item value=\"2\" correct=\"false\">Tak, aliasowanie zmienia nazwę kolumny w oryginalnej tabeli </item></selection><p visible-if=\"wrong\">Nie, aliasowanie zmienia nazwę kolumny tylko w tabeli wynikowej.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Po zapytaniu <code>SELECT price AS cost FROM products;</code> uruchamiasz <code>SELECT price FROM products;</code>. Która nazwa kolumny nadal działa?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>price</code>, ponieważ alias nie zmienił oryginalnej tabeli</item><item value=\"2\" correct=\"false\"><code>cost</code>, ponieważ pierwsze zapytanie trwale zmieniło nazwę kolumny</item><item value=\"3\" correct=\"false\">Obie nazwy, ponieważ alias dodaje drugą kolumnę do tabeli</item></selection><p visible-if=\"wrong\"><code>price</code>, ponieważ alias nie zmienił oryginalnej tabeli.</p></body></html>"
          },
          {
            "title": "Example: Aliasing",
            "id": 96789,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wybierz wartości <code>score</code> większe niż <code>7</code> pod aliasem <code>highest_score</code>.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; score int&#xA;);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Jean Miller', 5);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Emma Brown', 8);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Reese Jones', 2);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Kim Lee', 9);&#xA;\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"score\" /></row><row><data content=\"Jean Miller\" /><data content=\"5\" /></row><row><data content=\"Emma Brown\" /><data content=\"8\" /></row><row><data content=\"Reese Jones\" /><data content=\"2\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" score \" /><text value=\"AS\" class=\"keyword\" /><text value=\" highest_score\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" score &gt; \" /><text value=\"7\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"12\" /><option startIndex=\"13\" endIndex=\"29\" /><option correct=\"false\"><content><text value=\"AS score\" /></content></option></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"highest_score\" /></row><row><data content=\"8\" /></row><row><data content=\"9\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>SELECT score</code>, a następnie <code>AS highest_score</code>.</p></body></html>"
          },
          {
            "title": "Example: AS",
            "id": 96790,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Napisz <code>AS</code>, aby nadać kolumnie wynikowej alias.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; score int&#xA;);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Jean Miller', 5);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Emma Brown', 8);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Reese Jones', 2);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Kim Lee', 9);&#xA;\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"score\" /></row><row><data content=\"Jean Miller\" /><data content=\"5\" /></row><row><data content=\"Emma Brown\" /><data content=\"8\" /></row><row><data content=\"Reese Jones\" /><data content=\"2\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" score \" /><text value=\"AS\" class=\"keyword\" /><text value=\" highest_score\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" score &gt; \" /><text value=\"7\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"13\" endIndex=\"15\" /></interactions><output><table name=\"Result\"><row><header content=\"highest_score\" /></row><row><data content=\"8\" /></row><row><data content=\"9\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>AS</code>.</p></body></html>"
          },
          {
            "title": "Example: Only within the query",
            "id": 96791,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wybierz kolumnę <code>name</code> i zmień jej nazwę na <code>team_leader</code> w tabeli wynikowej.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE students (&#xA; name varchar(255),&#xA; score int&#xA;);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Jean Miller', 5);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Emma Brown', 8);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Reese Jones', 2);&#xA;&#xA;INSERT INTO students (name, score)&#xA;VALUES ('Kim Lee', 9);&#xA;\"><tables><table name=\"students\"><row><header content=\"name\" /><header content=\"score\" /></row><row><data content=\"Jean Miller\" /><data content=\"5\" /></row><row><data content=\"Emma Brown\" /><data content=\"8\" /></row><row><data content=\"Reese Jones\" /><data content=\"2\" /></row><row><data content=\"Kim Lee\" /><data content=\"9\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" \" /><text value=\"AS\" class=\"keyword\" /><text value=\" team_leader\" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" students\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"name\" class=\"keyword\" /><text value=\" = \" /><text value=\"'Kim Lee'\" class=\"string\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"11\" /><option startIndex=\"12\" endIndex=\"14\" /><option startIndex=\"15\" endIndex=\"26\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"team_leader\" /></row><row><data content=\"Kim Lee\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>SELECT</code>, następnie <code>name</code>, a potem <code>AS</code>, <code>team_leader</code>.</p></body></html>"
          }
        ]
      },
      {
        "id": 10551,
        "title": "Wiele kolumn",
