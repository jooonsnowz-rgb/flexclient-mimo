            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Który operator dodaje do wartości zmiennej?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>+=</code></item><item value=\"2\" correct=\"false\"><code>-</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>+=</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Operator <code>+=</code> dodaje liczbę do wartości zmiennej i zapisuje wynik.</p><p>Zmienna <code>coins</code> przechowuje <code>7</code>. Który wiersz zmienia jej wartość na <code>12</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>coins += 5</code></item><item value=\"2\" correct=\"false\"><code>coins = 5</code></item><item value=\"3\" correct=\"false\"><code>coins + 5</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>coins += 5</code>.</p></body></html>",
