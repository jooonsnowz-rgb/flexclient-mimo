            "hardModeContent": "<!DOCTYPE html ><html><body><p>Użyj krótszej formy przypisania, aby dodać dziesięć do <code>yards</code>, dzięki czemu kod wyświetli <code>90</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"yards = \" /><text value=\"80\" class=\"number\" /><text type=\"break\" /><text value=\"yards += \" /><text value=\"10\" class=\"number\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(yards)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"11\" endIndex=\"16\" /><option startIndex=\"17\" endIndex=\"18\" /><option startIndex=\"18\" endIndex=\"19\" /><option startIndex=\"20\" endIndex=\"22\" /><option correct=\"false\"><content><text value=\"-\" /></content></option></options></interaction></interactions><output><content><text value=\"90\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>yards</code>, następnie <code>+</code>, <code>=</code> i na końcu <code>10</code>.</p></body></html>",
