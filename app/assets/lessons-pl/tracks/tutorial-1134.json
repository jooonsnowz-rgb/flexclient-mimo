            "interactiveContent": "<!DOCTYPE html ><html><body><p>Przypisz <code>likes</code> wartość, aby w konsoli wyświetliła się liczba <code>5</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"likes = \" /><text value=\"5\" class=\"number\" /><text type=\"break\" /><text value=\"likes = likes\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(likes)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"18\" endIndex=\"23\" /><option correct=\"false\"><content><text value=\"6\" /></content></option><option correct=\"false\"><content><text value=\"7\" /></content></option></options></interaction></interactions><output><content><text value=\"5\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>likes</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Przypisz <code>likes</code> wartość, aby w konsoli wyświetliła się liczba <code>5</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"likes = \" /><text value=\"5\" class=\"number\" /><text type=\"break\" /><text value=\"likes = likes\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(likes)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"6\" endIndex=\"7\" /><option startIndex=\"18\" endIndex=\"23\" /><option correct=\"false\"><content><text value=\"6\" /></content></option><option correct=\"false\"><content><text value=\"+=\" /></content></option></options></interaction></interactions><output><content><text value=\"5\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>=</code>, a następnie <code>likes</code>.</p></body></html>"
