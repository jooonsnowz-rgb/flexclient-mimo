            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dodaj pięć do wartości zmiennej <code>inventory</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"inventory = \" /><text value=\"11\" class=\"number\" /><text type=\"break\" /><text value=\"inventory = inventory + \" /><text value=\"5\" class=\"number\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(inventory)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"27\" endIndex=\"40\" /><option correct=\"false\"><content><text value=\"5\" /></content></option></options></interaction></interactions><output><content><text value=\"16\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>inventory + 5</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Dodaj pięć do wartości zmiennej <code>inventory</code> tak, aby kod wyświetlił <code>16</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"inventory = \" /><text value=\"11\" class=\"number\" /><text type=\"break\" /><text value=\"inventory = inventory + \" /><text value=\"5\" class=\"number\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(inventory)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"27\" endIndex=\"40\" /><option correct=\"false\"><content><text value=\"inventory - 5\" /></content></option><option correct=\"false\"><content><text value=\"inventory + 6\" /></content></option></options></interaction></interactions><output><content><text value=\"16\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>inventory + 5</code>.</p></body></html>"
