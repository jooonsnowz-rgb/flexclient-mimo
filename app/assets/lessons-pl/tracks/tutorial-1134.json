            "id": 78221,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wiemy, że możemy dodać <code>1</code> do zmiennej, zapisując jej nazwę. W tym przypadku dodajmy jeden do <code>likes</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"likes = \" /><text value=\"5\" class=\"number\" /><text type=\"break\" /><text value=\"likes = likes + \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(likes)\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"18\" endIndex=\"23\" /></interactions><output><content><text value=\"6\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>likes</code>.</p></body></html>"
