            "interactiveContent": "<!DOCTYPE html ><html><body><p>Odejmij jeden od wartości zmiennej <code>cards</code>, a następnie dodaj cztery.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"cards = \" /><text value=\"3\" class=\"number\" /><text type=\"break\" /><text value=\"cards = cards - \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text value=\"cards = cards + \" /><text value=\"4\" class=\"number\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(cards)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"24\" endIndex=\"25\" /><option startIndex=\"26\" endIndex=\"27\" /><option startIndex=\"42\" endIndex=\"43\" /><option startIndex=\"44\" endIndex=\"45\" /></options></interaction></interactions><output><content><text value=\"6\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>-</code>, następnie <code>1</code>, a potem <code>+</code>, <code>4</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Zacznij od <code>3</code>, odejmij jeden od <code>cards</code>, a następnie dodaj cztery tak, aby kod wyświetlił <code>6</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"cards = \" /><text value=\"3\" class=\"number\" /><text type=\"break\" /><text value=\"cards = cards - \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text value=\"cards = cards + \" /><text value=\"4\" class=\"number\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(cards)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"24\" endIndex=\"25\" /><option startIndex=\"26\" endIndex=\"27\" /><option startIndex=\"42\" endIndex=\"43\" /><option startIndex=\"44\" endIndex=\"45\" /><option correct=\"false\"><content><text value=\"*\" /></content></option><option correct=\"false\"><content><text value=\"3\" /></content></option><option correct=\"false\"><content><text value=\"6\" /></content></option></options></interaction></interactions><output><content><text value=\"6\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>-</code>, następnie <code>1</code>, <code>+</code> i na końcu <code>4</code>.</p></body></html>",
