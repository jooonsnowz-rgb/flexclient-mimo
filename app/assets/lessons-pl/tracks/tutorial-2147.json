          {
            "title": "Question 4",
            "id": 120911,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jeśli musisz usunąć tylko zamówienia z <code>price</code> większą niż 10, którego z poniższych fragmentów kodu możesz użyć?</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE orders( &#xA; name varchar(255), &#xA; id int, &#xA; price int &#xA;); &#xA; &#xA;INSERT INTO orders(name, id, price) &#xA;VALUES(&quot;Chocolate box&quot;, 1235, 14); &#xA; &#xA;INSERT INTO orders(name, id, price) &#xA;VALUES(&quot;Bath bombs&quot;, 2337, 9); &#xA; &#xA;INSERT INTO orders(name, id, price) &#xA;VALUES(&quot;Flower hamper&quot;, 7483, 21); &#xA; &#xA;INSERT INTO orders(name, id, price) &#xA;VALUES(&quot;Old console&quot;, 6574, 13);\"><tables><table name=\"orders\"><row><header content=\"name\" /><header content=\"id\" /><header content=\"price\" /></row><row><data content=\"Chocolate box\" /><data content=\"1235\" /><data content=\"14\" /></row><row><data content=\"Bath bombs\" /><data content=\"2337\" /><data content=\"9\" /></row><row><data content=\"Flower hamper\" /><data content=\"7483\" /><data content=\"21\" /></row><row><data content=\"Old console\" /><data content=\"6574\" /><data content=\"13\" /></row></table></tables></database><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>DELETE FROM orders WHERE price &gt; 10</code></item><item value=\"2\" correct=\"false\"><code>DELETE FROM orders WHERE price &lt;= 10</code></item></selection><p visible-if=\"wrong\"><code>DELETE FROM orders WHERE price &gt; 10</code>.</p></body></html>"
          },
          {
            "title": "Question 5",
            "id": 120910,
            "contentType": "interactive",
