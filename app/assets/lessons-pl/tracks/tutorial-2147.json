          {
            "title": "Intro",
            "id": 120840,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dowiedzieliśmy się, jak wybierać określone dane z danej tabeli. W niektórych przypadkach możemy potrzebować dodać dane do tabeli.</p><p>Na przykład załóżmy, że do twojego sklepu z prezentami wpłynęło nowe zamówienie.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE orders( &#xA; name varchar(255), &#xA; id int, &#xA; price int &#xA;); &#xA; &#xA;INSERT INTO orders(name, id, price) &#xA;VALUES(&quot;Chocolate box&quot;, 1235, 14); &#xA; &#xA;INSERT INTO orders(name, id, price) &#xA;VALUES(&quot;Bath bombs&quot;, 2337, 9); &#xA; &#xA;INSERT INTO orders(name, id, price) &#xA;VALUES(&quot;Flower hamper&quot;, 7483, 21);\"><tables><table name=\"orders\"><row><header content=\"name\" /><header content=\"id\" /><header content=\"price\" /></row><row><data content=\"Chocolate box\" /><data content=\"1235\" /><data content=\"14\" /></row><row><data content=\"Bath bombs\" /><data content=\"2337\" /><data content=\"9\" /></row><row><data content=\"Flower hamper\" /><data content=\"7483\" /><data content=\"21\" /></row></table></tables></database></body></html>"
          },
          {
            "title": "Intro 2",
            "id": 120898,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Możesz użyć <code>INSERT INTO</code>, aby dodać dane nowego zamówienia. Kliknij <code>Insert Into</code>, aby wyświetlić wizualizację.</p><webview version=\"2\" visible-if=\"always\" content=\"&lt;!doctype html&gt; &#xA;&lt;html&gt; &#xA; &lt;head&gt; &#xA;  &lt;meta charset=&quot;utf-8&quot;&gt; &#xA;  &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width&quot;&gt; &#xA;  &lt;link rel=&quot;stylesheet&quot; &#xA;   href=&quot;https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css&quot; /&gt; &#xA;  &lt;style&gt; &#xA;   @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@500&amp;display=swap'); &#xA; &#xA;   html, &#xA;   body { &#xA;    min-height: 100%; &#xA;    width: 100%; &#xA;    font-family: 'Montserrat', sans-serif; &#xA;   } &#xA;    &#xA;   table { &#xA;    border-collapse: collapse; &#xA;    width: 40%; &#xA;    background-color: rgb(244 248 254); &#xA;     &#xA;   } &#xA;    &#xA;   td, &#xA;   th { &#xA;    border: 1px solid rgb(217 232 251); &#xA;    padding: 8px; &#xA;    font-size: 10px; &#xA;   } &#xA;    &#xA;   th { &#xA;    background-color: #eeeeee; &#xA;    text-align: left; &#xA;   } &#xA;    &#xA;   caption { &#xA;    font-size: 10px; &#xA;    color: rgb(50 185 100); &#xA;    padding: 8px; &#xA;    text-align: left; &#xA;    border-bottom: 2px solid rgb(50 185 100); &#xA;   } &#xA;    &#xA;   button { &#xA;    font-family: 'Poppins', sans-serif; &#xA;    padding: 8px; &#xA;    background-color: rgb(50 185 100); &#xA;    border: none; &#xA;    margin: 5px; &#xA;    border-radius: 5px; &#xA;   } &#xA;   } &#xA;    &#xA;   tr.active td div { &#xA;    max-height: 100px; &#xA;    padding: 10px 10px; &#xA;    transition: max-height 0.6s, padding 0.6s; &#xA;   } &#xA;  &lt;/style&gt; &#xA; &lt;/head&gt; &#xA; &lt;body&gt; &#xA;  &lt;table&gt; &#xA;   &lt;caption&gt;orders&lt;/caption&gt; &#xA;   &lt;tr&gt; &#xA;    &lt;th&gt;name&lt;/th&gt; &#xA;    &lt;th&gt;id&lt;/th&gt; &#xA;    &lt;th&gt;price&lt;/th&gt; &#xA;   &lt;/tr&gt; &#xA;   &lt;tr&gt; &#xA;    &lt;td&gt;Chocolate box&lt;/td&gt; &#xA;    &lt;td&gt;1235&lt;/td&gt; &#xA;    &lt;td&gt;14&lt;/td&gt; &#xA;   &lt;/tr&gt; &#xA;   &lt;tr&gt; &#xA;    &lt;td&gt;Bath bombs&lt;/td&gt; &#xA;    &lt;td&gt;2337&lt;/td&gt; &#xA;    &lt;td&gt;9&lt;/td&gt; &#xA;    &lt;/td&gt; &#xA;   &lt;/tr&gt; &#xA;   &lt;tr&gt; &#xA;    &lt;td&gt;Flower hamper&lt;/td&gt; &#xA;    &lt;td&gt;7483&lt;/td&gt; &#xA;    &lt;td&gt;21&lt;/td&gt; &#xA;   &lt;/tr&gt; &#xA;   &lt;tr style=&quot;display:none&quot; id=&quot;new&quot;&gt; &#xA;    &lt;td&gt;Teddy bear&lt;/td&gt; &#xA;    &lt;td&gt;6574&lt;/td&gt; &#xA;    &lt;td&gt;13&lt;/td&gt; &#xA;   &lt;/tr&gt; &#xA;  &lt;/table&gt; &#xA;  &lt;button&gt;INSERT INTO table&lt;/button&gt; &#xA;  &lt;script&gt; &#xA;   /* &#xA;   const addRow = () =&gt; { &#xA;    let table = document.querySelector(&quot;table&quot;); &#xA;    let row = table.insertRow(4); &#xA;    let cell1 = row.insertCell(0); &#xA;    let cell2 = row.insertCell(1); &#xA;    let cell3 = row.insertCell(2); &#xA;    cell1.innerHTML = &quot;Teddy bear&quot;; &#xA;    cell2.innerHTML = &quot;6574&quot;; &#xA;    cell3.innerHTML = &quot;13&quot;; &#xA;    row.className = &quot;animate__animated animate__backInUp&quot;; &#xA;    row.style.border = &quot;2px solid gold&quot; &#xA;   } &#xA;   document.querySelector('button').onclick = () =&gt; { &#xA;    addRow(); &#xA;    document.querySelector(&quot;button&quot;).disabled = true; &#xA;   }; &#xA;   */ &#xA;   document.querySelector('button').onclick = () =&gt; { &#xA;    document.querySelector(&quot;#new&quot;).style.display = &quot;table-row&quot;; &#xA;    document.querySelector(&quot;button&quot;).disabled = true; &#xA;   }; &#xA;  &lt;/script&gt; &#xA; &lt;/body&gt; &#xA;&lt;/html&gt;\" /></body></html>"
          },
          {
            "title": "INSERT INTO",
            "id": 120900,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>INSERT INTO</code> wstawia nowy wiersz z nowymi danymi do istniejącej tabeli.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE orders( &#xA; name varchar(255), &#xA; id int, &#xA; price int &#xA;); &#xA; &#xA;INSERT INTO orders(name, id, price) &#xA;VALUES(&quot;Chocolate box&quot;, 1235, 14); &#xA; &#xA;INSERT INTO orders(name, id, price) &#xA;VALUES(&quot;Bath bombs&quot;, 2337, 9); &#xA; &#xA;INSERT INTO orders(name, id, price) &#xA;VALUES(&quot;Flower hamper&quot;, 7483, 21);\"><tables><table name=\"orders\"><row><header content=\"name\" /><header content=\"id\" /><header content=\"price\" /></row><row><data content=\"Chocolate box\" /><data content=\"1235\" /><data content=\"14\" /></row><row><data content=\"Bath bombs\" /><data content=\"2337\" /><data content=\"9\" /></row><row><data content=\"Flower hamper\" /><data content=\"7483\" /><data content=\"21\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"INSERT\" class=\"keyword\" /><text value=\" \" /><text value=\"INTO\" class=\"keyword\" /><text value=\" orders(\" /><text value=\"name\" class=\"keyword\" /><text value=\", \" /><text value=\"id\" class=\"keyword\" /><text value=\", price) \" /><text type=\"break\" /><text value=\"VALUES\" class=\"keyword\" /><text value=\"(\" /><text value=\"&quot;Teddy bear&quot;\" class=\"string\" /><text value=\", \" /><text value=\"6574\" class=\"number\" /><text value=\", \" /><text value=\"13\" class=\"number\" /><text value=\"); \" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" orders;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"7\" endIndex=\"11\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"id\" /><header content=\"price\" /></row><row><data content=\"Chocolate box\" /><data content=\"1235\" /><data content=\"14\" /></row><row><data content=\"Bath bombs\" /><data content=\"2337\" /><data content=\"9\" /></row><row><data content=\"Flower hamper\" /><data content=\"7483\" /><data content=\"21\" /></row><row><data content=\"Teddy bear\" /><data content=\"6574\" /><data content=\"13\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>INSERT</code>, a następnie <code>INTO</code>.</p></body></html>"
          },
          {
            "title": "INSERT INTO 2",
            "id": 120903,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Musisz określić tabelę, a następnie nazwy kolumn w nawiasach kwadratowych.</p><p>Niezachowanie kolejności kolumn powoduje umieszczanie wartości w niewłaściwych kolumnach.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE orders( &#xA; name varchar(255), &#xA; id int, &#xA; price int &#xA;); &#xA; &#xA;INSERT INTO orders(name, id, price) &#xA;VALUES(&quot;Chocolate box&quot;, 1235, 14); &#xA; &#xA;INSERT INTO orders(name, id, price) &#xA;VALUES(&quot;Bath bombs&quot;, 2337, 9); &#xA; &#xA;INSERT INTO orders(name, id, price) &#xA;VALUES(&quot;Flower hamper&quot;, 7483, 21);\"><tables><table name=\"orders\"><row><header content=\"name\" /><header content=\"id\" /><header content=\"price\" /></row><row><data content=\"Chocolate box\" /><data content=\"1235\" /><data content=\"14\" /></row><row><data content=\"Bath bombs\" /><data content=\"2337\" /><data content=\"9\" /></row><row><data content=\"Flower hamper\" /><data content=\"7483\" /><data content=\"21\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"INSERT\" class=\"keyword\" /><text value=\" \" /><text value=\"INTO\" class=\"keyword\" /><text value=\" orders(\" /><text value=\"name\" class=\"keyword\" /><text value=\", \" /><text value=\"id\" class=\"keyword\" /><text value=\", price) \" /><text type=\"break\" /><text value=\"VALUES\" class=\"keyword\" /><text value=\"(\" /><text value=\"&quot;Teddy bear&quot;\" class=\"string\" /><text value=\", \" /><text value=\"6574\" class=\"number\" /><text value=\", \" /><text value=\"13\" class=\"number\" /><text value=\"); \" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" orders;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"12\" endIndex=\"18\" /><option startIndex=\"19\" endIndex=\"24\" /><option startIndex=\"25\" endIndex=\"28\" /><option startIndex=\"29\" endIndex=\"34\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"name\" /><header content=\"id\" /><header content=\"price\" /></row><row><data content=\"Chocolate box\" /><data content=\"1235\" /><data content=\"14\" /></row><row><data content=\"Bath bombs\" /><data content=\"2337\" /><data content=\"9\" /></row><row><data content=\"Flower hamper\" /><data content=\"7483\" /><data content=\"21\" /></row><row><data content=\"Teddy bear\" /><data content=\"6574\" /><data content=\"13\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>orders</code>, następnie <code>name,</code>, a potem <code>id,</code>, <code>price</code>.</p></body></html>"
