            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Które z poniższych zapytań SQL może dodać dodatkowe wiersze do istniejącej tabeli?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>INSERT INTO</code></item><item value=\"2\" correct=\"false\"><code>SELECT</code></item></selection><p visible-if=\"wrong\"><code>INSERT INTO</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Tabela już istnieje. Która instrukcja SQL dodaje nowy wiersz bez zastępowania tabeli?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>INSERT INTO</code></item><item value=\"2\" correct=\"false\"><code>SELECT</code></item><item value=\"3\" correct=\"false\"><code>DELETE FROM</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>INSERT INTO</code>.</p></body></html>"
