            "interactiveContent": "<!DOCTYPE html ><html><body><p>Podczas porównywania istnieją tylko dwa wyniki: <code>true</code> lub <code>false</code>.</p><img src=\"83e1e899-d397-4889-baff-8c31a640bb6e\" visible-if=\"always\" /></body></html>"
