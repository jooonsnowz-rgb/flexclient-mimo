            "id": 126368,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dodaj operator, który sprawia, że porównanie ma wartość <code>false</code>.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"10\" class=\"number\" /><text value=\" != \" /><text value=\"10\" class=\"number\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"9\" endIndex=\"11\" /><option correct=\"false\"><content><text value=\"==\" /></content></option></options></interaction></interactions><output><content><text value=\"false\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>!=</code>.</p></body></html>"
          },
