            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co wyświetla ten kod w konsoli?</p><code name=\"main.swift\" version=\"2\" codelang=\"swift\"><content><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"5\" class=\"number\" /><text value=\" + \" /><text value=\"13\" class=\"number\" /><text value=\")\" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"5\" class=\"number\" /><text value=\" == \" /><text value=\"13\" class=\"number\" /><text value=\")\" /></content><output><content><text value=\"18\" /><text type=\"break\" /><text value=\"false\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>18</code>, a następnie <code>false</code></item><item value=\"2\" correct=\"false\"><code>18</code>, a następnie <code>513</code></item></selection><p visible-if=\"wrong\"><code>18</code>, a następnie <code>false</code>.</p></body></html>"
