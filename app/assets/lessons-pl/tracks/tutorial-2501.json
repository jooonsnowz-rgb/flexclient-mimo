          {
            "title": "Example 1",
            "id": 126356,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Sprawdź, czy wartość <code>votes</code> jest równa <code>11</code>.</p><code version=\"2\" codelang=\"swift\" name=\"main.swift\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" votes = \" /><text value=\"10\" class=\"number\" /><text type=\"break\" /><text value=\"print\" class=\"built_in\" /><text value=\"(votes == \" /><text value=\"11\" class=\"number\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"27\" endIndex=\"29\" /><option startIndex=\"30\" endIndex=\"32\" /></options></interaction></interactions><output><content><text value=\"false\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>==</code>, a następnie <code>11</code>.</p></body></html>"
