            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jakiej metody używamy do usunięcia ostatniego elementu tablicy?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>.removeLast()</code></item><item value=\"2\" correct=\"false\"><code>.append()</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>.removeLast()</code>.</p></body></html>"
