            "interactiveContent": "<!DOCTYPE html ><html><body><p>Aby sprawdzić, czy jedna liczba jest większa od innej, używamy <strong>operatora większe niż</strong><code>&gt;</code>.</p><code name=\"main.swift\" version=\"2\" codelang=\"swift\"><content><text value=\"print\" class=\"built_in\" /><text value=\"(\" /><text value=\"101\" class=\"number\" /><text value=\" &gt; \" /><text value=\"90\" class=\"number\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"&lt;\" /></content></option><option startIndex=\"10\" endIndex=\"11\" /></options></interaction></interactions><output><content><text value=\"true\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>&gt;</code>.</p></body></html>"
