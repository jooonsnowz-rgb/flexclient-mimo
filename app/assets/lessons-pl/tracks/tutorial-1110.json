            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co robi operator równości <code>==</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Sprawdza, czy jeden ciąg znaków jest równy innemu ciągowi znaków</item><item value=\"2\" correct=\"false\">Sprawdza, czy jeden ciąg znaków jest większy od innego ciągu znaków</item></selection><p visible-if=\"wrong\">Sprawdza, czy jeden ciąg znaków jest równy innemu ciągowi znaków.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Program sprawdza <code>\"sun\" == \"sunset\"</code>. Czego dotyczy to porównanie?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Czy oba ciągi znaków są dokładnie takie same</item><item value=\"2\" correct=\"false\">Czy pierwszy ciąg znaków znajduje się przed drugim</item><item value=\"3\" correct=\"false\">Czy drugi ciąg znaków zaczyna się od pierwszego</item></selection><p visible-if=\"wrong\">Czy oba ciągi znaków są dokładnie takie same.</p></body></html>"
