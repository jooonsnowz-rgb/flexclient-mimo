            "interactiveContent": "<!DOCTYPE html ><html><body><p>Sprawdź, czy <code>my_answer</code> jest równe <code>solution</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"my_answer = \" /><text value=\"&quot;act&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"solution  = \" /><text value=\"&quot;ace&quot;\" class=\"string\" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"print(my_answer == solution)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"54\" endIndex=\"56\" /><option correct=\"false\"><content><text value=\"=\" /></content></option></options></interaction></interactions><output><content><text value=\"False\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>==</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Słowa <code>\"act\"</code> i <code>\"ace\"</code> są prawie takie same, ale nie są równe.</p><p>Porównaj <code>my_answer</code> z <code>solution</code>, aby kod wyświetlił <code>False</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"my_answer = \" /><text value=\"&quot;act&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"solution  = \" /><text value=\"&quot;ace&quot;\" class=\"string\" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"print(my_answer == solution)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"54\" endIndex=\"56\" /><option correct=\"false\"><content><text value=\"=\" /></content></option><option correct=\"false\"><content><text value=\"!=\" /></content></option></options></interaction></interactions><output><content><text value=\"False\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>==</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
