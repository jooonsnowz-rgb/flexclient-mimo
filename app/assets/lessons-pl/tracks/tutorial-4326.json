            "id": 146569,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zaimportuj bibliotekę <code>collisions.js</code>. <code>CDN</code>, na którym jest przechowywana biblioteka, to <code>https://teach.getmimo.com</code>.</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"86\" endIndex=\"91\" /><option startIndex=\"91\" endIndex=\"92\" /><option startIndex=\"92\" endIndex=\"103\" /><option startIndex=\"103\" endIndex=\"117\" /></options></interaction></interactions><content><text value=\"&lt;\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /><text value=\" \" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;\" /><text value=\"head\" class=\"name\" /><text value=\"&gt;\" /><text value=\" \" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;/\" /><text value=\"head\" class=\"name\" /><text value=\"&gt;\" /><text value=\" \" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text value=\" \" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text value=\"My game uses libraries\" /><text value=\"&lt;/\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text value=\" \" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"script\" class=\"name\" /><text value=\" \" /><text value=\"src\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;https://mimo.org/collisions.js&quot;\" class=\"string\" /><text value=\"&gt;\" /><text value=\"\" class=\"undefined\" /><text value=\"&lt;/\" /><text value=\"script\" class=\"name\" /><text value=\"&gt;\" /><text value=\" \" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;/\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text value=\" \" /><text type=\"break\" /><text value=\"&lt;/\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>https</code>, następnie <code>:</code>, a potem <code>//mimo.org/</code>, <code>collisions.js\"</code>.</p></body></html>"
