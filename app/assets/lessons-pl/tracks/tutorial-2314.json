            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co zostanie wyświetlone w konsoli?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"print(\" /><text value=\"&quot;Nina&quot;\" class=\"string\" /><text value=\" != \" /><text value=\"&quot;Nina&quot;\" class=\"string\" /><text value=\")\" /></content><output><content><text value=\"False\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>False</code></item><item value=\"2\" correct=\"false\"><code>True</code></item><item value=\"3\" correct=\"false\"><code>NinaNina</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>False</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Dlaczego to porównanie za pomocą <code>!=</code> wyświetla <code>False</code>?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"print(\" /><text value=\"&quot;Nina&quot;\" class=\"string\" /><text value=\" != \" /><text value=\"&quot;Nina&quot;\" class=\"string\" /><text value=\")\" /></content><output><content><text value=\"False\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Oba ciągi znaków mają tę samą wartość, <code>Nina</code>.</item><item value=\"2\" correct=\"false\"><code>!=</code> sprawdza, czy ciągi znaków są równe.</item><item value=\"3\" correct=\"false\">Wartości tekstowych nie można porównywać za pomocą <code>!=</code>.</item></selection><p visible-if=\"wrong\">Oba ciągi znaków mają tę samą wartość, <code>Nina</code>.</p></body></html>"
          },
