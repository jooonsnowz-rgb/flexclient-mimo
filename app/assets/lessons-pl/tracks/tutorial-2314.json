            "id": 76692,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co robi <code>!=</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Sprawdza, czy wartość nie jest równa innej wartości</item><item value=\"2\" correct=\"false\">Sprawdza, czy jedna wartość jest równa innej wartości</item><item value=\"2\" correct=\"false\">Sprawdza, czy jedna wartość jest mniejsza od innej wartości</item></selection><p visible-if=\"wrong\">Sprawdza, czy wartość nie jest równa innej wartości.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Potrzebujesz porównania, które przyjmuje wartość <code>True</code>, gdy dwie wartości się różnią. Co robi <code>!=</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Sprawdza, czy jedna wartość nie jest równa drugiej</item><item value=\"2\" correct=\"false\">Sprawdza, czy jedna wartość jest równa drugiej</item><item value=\"3\" correct=\"false\">Sprawdza, czy jedna wartość jest mniejsza od drugiej</item></selection><p visible-if=\"wrong\">Sprawdza, czy jedna wartość nie jest równa drugiej.</p></body></html>"
