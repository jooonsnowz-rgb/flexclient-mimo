            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zapisz wynik porównania z <code>min_score</code> w zmiennej <code>pass</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"score = \" /><text value=\"32\" class=\"number\" /><text type=\"break\" /><text value=\"min_score = \" /><text value=\"30\" class=\"number\" /><text type=\"break\" /><text value=\"pass\" class=\"keyword\" /><text value=\" = score &gt;= min_score\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"26\" endIndex=\"30\" /><option startIndex=\"31\" endIndex=\"32\" /><option startIndex=\"39\" endIndex=\"41\" /><option startIndex=\"42\" endIndex=\"51\" /><option correct=\"false\"><content><text value=\"60\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>pass</code>, następnie <code>=</code>, a potem <code>&gt;=</code>, <code>min_score</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Użyj obu zmiennych, aby zapisać w <code>passed</code>, czy <code>score</code> jest większe lub równe <code>min_score</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"score\" /><text value=\" \" /><text value=\"=\" /><text value=\" \" /><text value=\"32\" class=\"number\" /><text type=\"break\" /><text value=\"min_score\" /><text value=\" \" /><text value=\"=\" /><text value=\" \" /><text value=\"30\" class=\"number\" /><text type=\"break\" /><text value=\"passed\" /><text value=\" \" /><text value=\"=\" /><text value=\" \" /><text value=\"score\" /><text value=\" \" /><text value=\"&gt;\" /><text value=\"=\" /><text value=\" \" /><text value=\"min_score\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"26\" endIndex=\"32\" /><option startIndex=\"33\" endIndex=\"34\" /><option startIndex=\"41\" endIndex=\"43\" /><option startIndex=\"44\" endIndex=\"53\" /><option correct=\"false\"><content><text value=\"==\" /></content></option><option correct=\"false\"><content><text value=\"30\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>passed</code>, następnie <code>=</code>, <code>&gt;=</code> i na końcu <code>min_score</code>.</p></body></html>",
