            "interactiveContent": "<!DOCTYPE html ><html><body><p>Utwórz zmienną <code>last_name</code>, która zawiera ciąg znaków.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"last_name = \" /><text value=\"&quot;Clooney&quot;\" class=\"string\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"9\" /><option startIndex=\"10\" endIndex=\"11\" /><option startIndex=\"12\" endIndex=\"21\" /><option correct=\"false\"><content><text value=\"Clooney\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>last_name</code>, następnie <code>=</code> i na końcu <code>\"Clooney\"</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Utwórz zmienną <code>last_name</code> i przypisz jej ciąg znaków <code>Clooney</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"last_name = \" /><text value=\"&quot;Clooney&quot;\" class=\"string\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"9\" /><option startIndex=\"10\" endIndex=\"11\" /><option startIndex=\"12\" endIndex=\"21\" /><option correct=\"false\"><content><text value=\"Clooney\" /></content></option><option correct=\"false\"><content><text value=\"==\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>last_name</code>, następnie <code>=</code> i na końcu <code>\"Clooney\"</code>.</p></body></html>",
