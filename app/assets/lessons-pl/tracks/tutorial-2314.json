            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Porównaj <code>copy</code> z <code>submission</code> za pomocą operatora nierówności.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"copy = \" /><text value=\"&quot;results.xls&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"submission  = \" /><text value=\"&quot;sales.xls&quot;\" class=\"string\" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"print(copy != submission)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"60\" endIndex=\"61\" /><option startIndex=\"61\" endIndex=\"62\" /><option correct=\"false\"><content><text value=\"&lt;\" /></content></option><option correct=\"false\"><content><text value=\"=\" /></content></option></options></interaction></interactions><output><content><text value=\"True\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>!</code>, a następnie <code>=</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Porównaj <code>copy</code> z <code>submission</code> tak, aby kod wyświetlił <code>True</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"copy = \" /><text value=\"&quot;results.xls&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"submission  = \" /><text value=\"&quot;sales.xls&quot;\" class=\"string\" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"print(copy != submission)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"60\" endIndex=\"62\" /><option startIndex=\"63\" endIndex=\"73\" /><option correct=\"false\"><content><text value=\"==\" /></content></option><option correct=\"false\"><content><text value=\"=\" /></content></option><option correct=\"false\"><content><text value=\"copy\" /></content></option></options></interaction></interactions><output><content><text value=\"True\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>!=</code>, a następnie <code>submission</code>.</p></body></html>",
