            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wynikiem którego porównania jest <code>False</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>5 &lt; 5</code></item><item value=\"2\" correct=\"false\"><code>5 &lt;= 5</code></item><item value=\"3\" correct=\"false\"><code>5 == 5</code></item></selection><p visible-if=\"wrong\"><code>5 &lt; 5</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Wynik wynosi dokładnie <code>5</code>. Które porównanie prawidłowo stwierdza, że wynik nie jest większy niż <code>5</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>5 &lt;= 5</code></item><item value=\"2\" correct=\"false\"><code>5 &lt; 5</code></item><item value=\"3\" correct=\"false\"><code>5 != 5</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>5 &lt;= 5</code>.</p></body></html>"
