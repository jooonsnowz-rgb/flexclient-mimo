            "id": 77302,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zapisz wartość <code>101</code> w zmiennej <code>result</code> i wyświetl ją.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"result = \" /><text value=\"100\" class=\"number\" /><text value=\" + \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text value=\"print(result)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"9\" endIndex=\"12\" /><option startIndex=\"13\" endIndex=\"14\" /><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"17\" endIndex=\"22\" /><option correct=\"false\"><content><text value=\"&quot;print&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"101\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>result</code>, następnie <code>100</code>, a potem <code>+</code>, <code>print</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Zapisz sumę <code>100</code> i <code>1</code> w <code>result</code>, a następnie ją wyświetl, aby konsola pokazała <code>101</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"result = \" /><text value=\"100\" class=\"number\" /><text value=\" + \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text value=\"print(result)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"6\" /><option startIndex=\"9\" endIndex=\"12\" /><option startIndex=\"13\" endIndex=\"14\" /><option startIndex=\"17\" endIndex=\"22\" /><option correct=\"false\"><content><text value=\"total\" /></content></option><option correct=\"false\"><content><text value=\"101\" /></content></option><option correct=\"false\"><content><text value=\"-\" /></content></option><option correct=\"false\"><content><text value=\"&quot;print&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"101\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>result</code>, następnie <code>100</code>, <code>+</code> i na końcu <code>print</code>.</p></body></html>"
