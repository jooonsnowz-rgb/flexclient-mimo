            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wyróżnij tytuł albumu, dodając otwierający i zamykający znacznik wyróżnienia.</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text value=\" I just listened to \" /><text value=\"&lt;\" /><text value=\"em\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Abbey Road\" /><text value=\"&lt;/\" /><text value=\"em\" class=\"name\" /><text value=\"&gt;\" /><text value=\" for the first time.\" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"23\" endIndex=\"27\" /><option startIndex=\"37\" endIndex=\"42\" /></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>&lt;em&gt;</code>, a następnie <code>&lt;/em&gt;</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Użyj pasujących znaczników, aby wyróżnić tylko tytuł albumu i wyświetlić go kursywą.</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text value=\" I just listened to \" /><text value=\"&lt;\" /><text value=\"em\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Abbey Road\" /><text value=\"&lt;/\" /><text value=\"em\" class=\"name\" /><text value=\"&gt;\" /><text value=\" for the first time.\" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"23\" endIndex=\"27\" /><option startIndex=\"37\" endIndex=\"42\" /><option correct=\"false\"><content><text value=\"&lt;strong&gt;\" /></content></option><option correct=\"false\"><content><text value=\"&lt;/strong&gt;\" /></content></option><option correct=\"false\"><content><text value=\"&lt;br&gt;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Koniecznie wybierz <code>&lt;em&gt;</code>, a następnie <code>&lt;/em&gt;</code>.</p></body></html>",
