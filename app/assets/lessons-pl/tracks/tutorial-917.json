            "interactiveContent": "<!DOCTYPE html ><html><body><p>Możemy przechowywać długość listy w zmiennej, tak jak tutaj w przypadku <code>number_of_users</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"users = [\" /><text value=\"&quot;Sarah&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Mike&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Ella&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"number_of_users = len(users)\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(number_of_users)\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"35\" endIndex=\"50\" /></interactions><output><content><text value=\"3\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>number_of_users</code>.</p></body></html>"
