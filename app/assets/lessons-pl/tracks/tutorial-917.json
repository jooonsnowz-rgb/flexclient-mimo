            "interactiveContent": "<!DOCTYPE html ><html><body><p>Używamy instrukcji <code>len()</code> z nazwą listy w nawiasach, aby uzyskać liczbę elementów na liście.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"users = [\" /><text value=\"&quot;Sarah&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Mike&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Ella&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(len(users))\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"41\" endIndex=\"44\" /><option startIndex=\"44\" endIndex=\"45\" /><option startIndex=\"50\" endIndex=\"51\" /></options></interaction></interactions><output><content><text value=\"3\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>len</code>, następnie <code>(</code> i na końcu <code>)</code>.</p></body></html>",
            "hardModeSelected": true
