            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Możemy użyć długości listy do tworzenia instrukcji warunkowych na podstawie liczby elementów, tak jak tutaj w przypadku <code>len(tasks) &gt; 0</code></p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"tasks = [\" /><text value=\"&quot;dishes&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;windows&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;vacuum&quot;\" class=\"string\" /><text value=\"]\" /><text type=\"break\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" len(tasks) &gt; \" /><text value=\"0\" class=\"number\" /><text value=\":\" /><text type=\"break\" /><text value=\"  print(\" /><text value=\"&quot;Ugh, more work!&quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"44\" endIndex=\"58\" /></interactions><output><content><text value=\"Ugh, more work!\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>len(tasks) &gt; 0</code>.</p></body></html>"
