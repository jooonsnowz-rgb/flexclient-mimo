            "title": "ADD",
            "id": 118767,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Możemy dodać nowe kolumny za pomocą słowa kluczowego <code>ADD</code>, nazwy nowej kolumny <code>discount</code> oraz jej typu danych <code>int</code>. Pamiętaj, że <code>ADD</code> dodaje kolumnę bez danych!</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE orders( &#xA; order_no int, &#xA; order_status varchar(255), &#xA; order_amt int, &#xA; customer_id int, &#xA; place_of_order varchar(255) &#xA;); &#xA; &#xA;INSERT INTO orders(order_no, order_status, order_amt, customer_id, place_of_order) &#xA;VALUES(101, &quot;Delivered&quot;, 550, 3001, &quot;Amazon&quot;); &#xA; &#xA;INSERT INTO orders(order_no, order_status, order_amt, customer_id, place_of_order) &#xA;VALUES(512, &quot;Delivered&quot;, 113, 3001, &quot;Amazon&quot;); &#xA; &#xA;INSERT INTO orders(order_no, order_status, order_amt, customer_id, place_of_order) &#xA;VALUES(984, &quot;Processing&quot;, 54, 3012, &quot;Store&quot;); &#xA; &#xA;INSERT INTO orders(order_no, order_status, order_amt, customer_id, place_of_order) &#xA;VALUES(566, &quot;Delivered&quot;, 850, 3120, &quot;Store&quot;); &#xA; &#xA;INSERT INTO orders(order_no, order_status, order_amt, customer_id, place_of_order) &#xA;VALUES(432, &quot;Shipped&quot;, 99, 3003, &quot;Amazon&quot;);\"><tables><table name=\"orders\"><row><header content=\"order_no\" /><header content=\"order_status\" /><header content=\"order_amt\" /><header content=\"customer_id\" /><header content=\"place_of_order\" /></row><row><data content=\"101\" /><data content=\"Delivered\" /><data content=\"550\" /><data content=\"3001\" /><data content=\"Amazon\" /></row><row><data content=\"512\" /><data content=\"Delivered\" /><data content=\"113\" /><data content=\"3001\" /><data content=\"Amazon\" /></row><row><data content=\"984\" /><data content=\"Processing\" /><data content=\"54\" /><data content=\"3012\" /><data content=\"Store\" /></row><row><data content=\"566\" /><data content=\"Delivered\" /><data content=\"850\" /><data content=\"3120\" /><data content=\"Store\" /></row><row><data content=\"432\" /><data content=\"Shipped\" /><data content=\"99\" /><data content=\"3003\" /><data content=\"Amazon\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"ALTER\" class=\"keyword\" /><text value=\" \" /><text value=\"TABLE\" class=\"keyword\" /><text value=\" orders \" /><text type=\"break\" /><text value=\"ADD\" class=\"keyword\" /><text value=\" discount \" /><text value=\"int\" class=\"built_in\" /><text value=\"; \" /><text type=\"break\" /><text value=\" \" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text value=\"FROM\" class=\"keyword\" /><text value=\" orders;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"20\" endIndex=\"23\" /><option startIndex=\"24\" endIndex=\"32\" /><option startIndex=\"33\" endIndex=\"36\" /></options></interaction></interactions><output><table name=\"Result\"><row><header content=\"order_no\" /><header content=\"order_status\" /><header content=\"order_amt\" /><header content=\"customer_id\" /><header content=\"place_of_order\" /><header content=\"discount\" /></row><row><data content=\"101\" /><data content=\"Delivered\" /><data content=\"550\" /><data content=\"3001\" /><data content=\"Amazon\" /><data content=\"\" /></row><row><data content=\"512\" /><data content=\"Delivered\" /><data content=\"113\" /><data content=\"3001\" /><data content=\"Amazon\" /><data content=\"\" /></row><row><data content=\"984\" /><data content=\"Processing\" /><data content=\"54\" /><data content=\"3012\" /><data content=\"Store\" /><data content=\"\" /></row><row><data content=\"566\" /><data content=\"Delivered\" /><data content=\"850\" /><data content=\"3120\" /><data content=\"Store\" /><data content=\"\" /></row><row><data content=\"432\" /><data content=\"Shipped\" /><data content=\"99\" /><data content=\"3003\" /><data content=\"Amazon\" /><data content=\"\" /></row></table></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>ADD</code>, następnie <code>discount</code> i na końcu <code>int</code>.</p></body></html>"
