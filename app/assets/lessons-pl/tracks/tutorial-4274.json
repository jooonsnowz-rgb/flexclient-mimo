            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Użyj zmiennej przechowującej wynik porównania jako warunku instrukcji if.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"players\" /></content></option><option correct=\"false\"><content><text value=\"players &gt; 1\" /></content></option><option startIndex=\"56\" endIndex=\"69\" /></options></interaction></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" players = \" /><text value=\"2\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" isMultiplayer = players &gt; \" /><text value=\"1\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"if\" class=\"keyword\" /><text value=\" (isMultiplayer) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Choose characters for each player&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>isMultiplayer</code>.</p></body></html>"
