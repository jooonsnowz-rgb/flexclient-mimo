            "interactiveContent": "<!DOCTYPE html ><html><body><p>Uzupełnij kod, importując dwa moduły.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"import\" class=\"keyword\" /><text value=\" statistics, math    \" /><text type=\"break\" /><text type=\"break\" /><text value=\"number_of_cases = [\" /><text value=\"2\" class=\"number\" /><text value=\", \" /><text value=\"2\" class=\"number\" /><text value=\", \" /><text value=\"4\" class=\"number\" /><text value=\", \" /><text value=\"5\" class=\"number\" /><text value=\"]\" /><text type=\"break\" /><text value=\"result = statistics.mean(number_of_cases)\" /><text type=\"break\" /><text value=\"print(\" /><text value=\"f&quot;Mean cases: \" /><text value=\"{result}\" class=\"subst\" /><text value=\"&quot;\" /><text value=\")\" /><text type=\"break\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"17\" endIndex=\"18\" /><option startIndex=\"7\" endIndex=\"17\" /><option startIndex=\"0\" endIndex=\"6\" /><option correct=\"false\"><content><text value=\"from\" /></content></option><option correct=\"false\"><content><text value=\"as\" /></content></option></options></interaction></interactions><output><content><text value=\"Mean cases: 3.25\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>import</code>, następnie <code>statistics</code> i na końcu <code>,</code>.</p></body></html>"
