            "hardModeContent": "<!DOCTYPE html ><html><body><p>Która zwracana wartość najlepiej pasuje do funkcji o nazwie <code>is_valid</code>, jeśli hasło nie przejdzie sprawdzenia?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"password = \" /><text value=\"&quot;123ABC&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"validity = is_valid(password)\" /><text type=\"break\" /></content><output><content><text value=\"True\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>False</code></item><item value=\"2\" correct=\"false\"><code>\"invalid\"</code></item><item value=\"3\" correct=\"false\">Oryginalne hasło</item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>False</code>.</p></body></html>"
