          {
            "title": "Question: Return",
            "id": 80363,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dokąd trafia wartość, którą chcemy zwrócić z funkcji?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Po słowie kluczowym <code>return</code></item><item value=\"2\" correct=\"false\">Bezpośrednio przed słowem kluczowym <code>return</code></item><item value=\"3\" correct=\"false\">Dodajemy ją do przedostatniego wiersza funkcji</item></selection><p visible-if=\"wrong\">Po słowie kluczowym <code>return</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Funkcja oblicza <code>total</code>. Który wiersz przekazuje tę wartość z powrotem do kodu wywołującego?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>return total</code></item><item value=\"2\" correct=\"false\"><code>total return</code></item><item value=\"3\" correct=\"false\"><code>print(total)</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>return total</code>.</p></body></html>",
            "hardModeSelected": true
