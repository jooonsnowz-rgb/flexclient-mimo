            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zakoduj prawidłowy symbol, aby oddzielić dwa parametry.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"addPrefix\" class=\"title\" /><text value=\"(\" /><text value=\"prefix, word\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" prefix + word;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" newWord = addPrefix(\" /><text value=\"&quot;re&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;do&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(newWord);\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"25\" endIndex=\"26\" /></interactions><output><content><text value=\"redo\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wpisz <code>,</code>.</p></body></html>"
