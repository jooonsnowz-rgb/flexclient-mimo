            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co wyświetla ten kod w konsoli?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"mix\" class=\"title\" /><text value=\"(\" /><text value=\"first, second, third\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" first + second + third;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" result = mix(\" /><text value=\"&quot;big&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;bad&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;wolf&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(result);\" /></content><output><content><text value=\"bigbadwolf\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>bigbadwolf</code></item><item value=\"2\" correct=\"false\"><code>wolfbadbig</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>bigbadwolf</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Funkcja łączy kolejno <code>first</code>, <code>second</code> i <code>third</code>. Co wyświetla?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"mix\" class=\"title\" /><text value=\"(\" /><text value=\"first, second, third\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" first + second + third;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" result = mix(\" /><text value=\"&quot;big&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;bad&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;wolf&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(result);\" /></content><output><content><text value=\"bigbadwolf\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>bigbadwolf</code></item><item value=\"2\" correct=\"false\"><code>wolfbadbig</code></item><item value=\"3\" correct=\"false\"><code>big wolf bad</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>bigbadwolf</code>.</p></body></html>"
