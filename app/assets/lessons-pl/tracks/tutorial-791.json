            "id": 82822,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Przekaż wartości tak, aby <code>Helen</code> wyświetlała się jako ostatnia.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"showWinners\" class=\"title\" /><text value=\"(\" /><text value=\"first, second\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;1st: &quot;\" class=\"string\" /><text value=\" + first);\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;2nd: &quot;\" class=\"string\" /><text value=\" + second);\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"showWinners(\" /><text value=\"&quot;Joe&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Helen&quot;\" class=\"string\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"115\" endIndex=\"120\" /><option startIndex=\"120\" endIndex=\"121\" /><option startIndex=\"122\" endIndex=\"129\" /></options></interaction></interactions><output><content><text value=\"1st: Joe\" /><text type=\"break\" /><text value=\"2nd: Helen\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>\"Joe\"</code>, następnie <code>,</code> i na końcu <code>\"Helen\"</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Przekaż imiona w takiej kolejności, aby w konsoli najpierw pojawiło się Joe, a potem Helen.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"showWinners\" class=\"title\" /><text value=\"(\" /><text value=\"first, second\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;1st: &quot;\" class=\"string\" /><text value=\" + first);\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;2nd: &quot;\" class=\"string\" /><text value=\" + second);\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"showWinners(\" /><text value=\"&quot;Joe&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Helen&quot;\" class=\"string\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"115\" endIndex=\"120\" /><option startIndex=\"120\" endIndex=\"121\" /><option startIndex=\"122\" endIndex=\"129\" /><option correct=\"false\"><content><text value=\";\" /></content></option><option correct=\"false\"><content><text value=\"first\" /></content></option><option correct=\"false\"><content><text value=\"second\" /></content></option></options></interaction></interactions><output><content><text value=\"1st: Joe\" /><text type=\"break\" /><text value=\"2nd: Helen\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>\"Joe\"</code>, następnie <code>,</code> i na końcu <code>\"Helen\"</code>.</p></body></html>",
            "hardModeSelected": true
