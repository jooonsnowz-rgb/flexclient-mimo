            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zakoduj drugi parametr tej funkcji.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"createID\" class=\"title\" /><text value=\"(\" /><text value=\"name, year\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" name + year + \" /><text value=\"&quot;@hutmail.com&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" email = createID(\" /><text value=\"&quot;jo&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;1998&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(email);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"24\" endIndex=\"28\" /><option correct=\"false\"><content><text value=\"1998\" /></content></option><option correct=\"false\"><content><text value=\"&quot;1998&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"jo1998@hutmail.com\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>year</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Uzupełnij drugi parametr, aby funkcja mogła użyć obu przekazanych wartości w zwracanym adresie.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"createID\" class=\"title\" /><text value=\"(\" /><text value=\"name, year\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" name + year + \" /><text value=\"&quot;@hutmail.com&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" email = createID(\" /><text value=\"&quot;jo&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;1998&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(email);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"24\" endIndex=\"28\" /><option correct=\"false\"><content><text value=\"1998\" /></content></option><option correct=\"false\"><content><text value=\"&quot;1998&quot;\" /></content></option><option correct=\"false\"><content><text value=\"email\" /></content></option></options></interaction></interactions><output><content><text value=\"jo1998@hutmail.com\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>year</code>.</p></body></html>",
