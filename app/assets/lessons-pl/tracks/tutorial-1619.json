            "hardModeContent": "<!DOCTYPE html ><html><body><p>Zmieniasz domyślną wartość <code>denom</code> z <code>2</code> na <code>4</code>. Co wyświetli to samo wywołanie?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getRatio = \" /><text value=\"(\" /><text value=\"nom, denom = \" /><text value=\"2\" class=\"number\" /><text value=\") =&gt;\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" nom / denom;\" /><text type=\"break\" /><text value=\"};\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getRatio(\" /><text value=\"40\" class=\"number\" /><text value=\"));\" /></content><output><content><text value=\"20\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">10</item><item value=\"2\" correct=\"false\">20</item><item value=\"3\" correct=\"false\">40</item></selection><p visible-if=\"wrong\">Koniecznie wybierz 10.</p></body></html>",
