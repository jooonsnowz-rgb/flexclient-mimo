            "id": 103691,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Uzupełnij funkcję strzałkową.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getPrice = \" /><text value=\"discount\" class=\"params\" /><text value=\" =&gt;\" /><text value=\" \" /><text value=\"100\" class=\"number\" /><text value=\" - discount;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getPrice(\" /><text value=\"10\" class=\"number\" /><text value=\"));\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"15\" endIndex=\"16\" /><option startIndex=\"17\" endIndex=\"25\" /><option startIndex=\"26\" endIndex=\"28\" /><option correct=\"false\"><content><text value=\"(\" /></content></option><option correct=\"false\"><content><text value=\"}\" /></content></option></options></interaction></interactions><output><content><text value=\"90\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>=</code>, następnie <code>discount</code> i na końcu <code>=&gt;</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Pojedynczy parametr funkcji strzałkowej nie wymaga nawiasów. Uzupełnij funkcję, aby rabat <code>10</code> dał wynik <code>90</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getPrice = \" /><text value=\"discount\" class=\"params\" /><text value=\" =&gt;\" /><text value=\" \" /><text value=\"100\" class=\"number\" /><text value=\" - discount;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getPrice(\" /><text value=\"10\" class=\"number\" /><text value=\"));\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"6\" endIndex=\"14\" /><option startIndex=\"15\" endIndex=\"16\" /><option startIndex=\"17\" endIndex=\"25\" /><option startIndex=\"26\" endIndex=\"28\" /><option correct=\"false\"><content><text value=\"function\" /></content></option><option correct=\"false\"><content><text value=\"(\" /></content></option><option correct=\"false\"><content><text value=\"price\" /></content></option><option correct=\"false\"><content><text value=\"discount()\" /></content></option></options></interaction></interactions><output><content><text value=\"90\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>getPrice</code>, następnie <code>=</code>, <code>discount</code> i na końcu <code>=&gt;</code>.</p></body></html>",
            "hardModeSelected": true
