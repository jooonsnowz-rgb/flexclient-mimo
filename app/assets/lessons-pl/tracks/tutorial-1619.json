            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Ustaw domyślną wartość parametru na <code>0</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getSquare = \" /><text value=\"(\" /><text value=\"number = \" /><text value=\"0\" class=\"number\" /><text value=\") =&gt;\" /><text value=\" number * number;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getSquare(\" /><text value=\"5\" class=\"number\" /><text value=\"));\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"18\" endIndex=\"19\" /><option startIndex=\"19\" endIndex=\"25\" /><option startIndex=\"26\" endIndex=\"27\" /><option startIndex=\"28\" endIndex=\"29\" /><option startIndex=\"29\" endIndex=\"30\" /><option correct=\"false\"><content><text value=\"=&gt;\" /></content></option></options></interaction></interactions><output><content><text value=\"25\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>(</code>, następnie <code>number</code>, a potem <code>=</code>, <code>0</code>, <code>)</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Ustaw domyślną wartość parametru na <code>0</code>. Wywołanie przekazuje <code>5</code>, więc wynik nadal powinien wynosić <code>25</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getSquare = \" /><text value=\"(\" /><text value=\"number = \" /><text value=\"0\" class=\"number\" /><text value=\") =&gt;\" /><text value=\" number * number;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getSquare(\" /><text value=\"5\" class=\"number\" /><text value=\"));\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"6\" endIndex=\"15\" /><option startIndex=\"18\" endIndex=\"19\" /><option startIndex=\"19\" endIndex=\"25\" /><option startIndex=\"26\" endIndex=\"27\" /><option startIndex=\"28\" endIndex=\"29\" /><option startIndex=\"29\" endIndex=\"30\" /><option correct=\"false\"><content><text value=\"=&gt;\" /></content></option><option correct=\"false\"><content><text value=\"==\" /></content></option><option correct=\"false\"><content><text value=\"5\" /></content></option><option correct=\"false\"><content><text value=\"getSquare()\" /></content></option></options></interaction></interactions><output><content><text value=\"25\" /></content></output></code><p visible-if=\"wrong\">Koniecznie wybierz <code>getSquare</code>, następnie <code>(</code>, <code>number</code>, <code>=</code>, <code>0</code> i na końcu <code>)</code>.</p></body></html>"
