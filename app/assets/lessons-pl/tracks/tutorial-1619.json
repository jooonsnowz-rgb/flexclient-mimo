            "interactiveContent": "<!DOCTYPE html ><html><body><p>Co jest nie tak z tym kodem?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getSquare = number,\" /><text type=\"break\" /><text value=\" multiplier =&gt; number * multiplier;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getSquare(\" /><text value=\"4\" class=\"number\" /><text value=\"));\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Brakuje nawiasów wokół dwóch parametrów</item><item value=\"2\" correct=\"false\">Nie możemy używać wielu parametrów z funkcjami strzałkowymi</item></selection><p visible-if=\"wrong\">Brakuje nawiasów wokół dwóch parametrów.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Które dwie poprawki pozwolą tej funkcji pomnożyć <code>4</code> przez podany mnożnik?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getSquare = number,\" /><text type=\"break\" /><text value=\" multiplier =&gt; number * multiplier;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getSquare(\" /><text value=\"4\" class=\"number\" /><text value=\"));\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Umieszczenie obu parametrów w nawiasach i przekazanie mnożnika w wywołaniu.</item><item value=\"2\" correct=\"false\">Przeniesienie obu parametrów za strzałkę i usunięcie przecinka.</item><item value=\"3\" correct=\"false\">Pozostawienie listy parametrów bez zmian i zastąpienie mnożenia dodawaniem.</item></selection><p visible-if=\"wrong\">Umieszczenie obu parametrów w nawiasach i przekazanie mnożnika w wywołaniu.</p></body></html>"
