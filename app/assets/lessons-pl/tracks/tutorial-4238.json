            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dodaj właściwe fragmenty kodu, aby utworzyć nagłówki.</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"&lt;h3&gt;\" /></content></option><option correct=\"false\"><content><text value=\"&lt;h4&gt;\" /></content></option><option startIndex=\"0\" endIndex=\"4\" /><option startIndex=\"19\" endIndex=\"23\" /><option startIndex=\"39\" endIndex=\"43\" /></options></interaction></interactions><content><text value=\"&lt;\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Game Menu\" /><text value=\"&lt;/\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"h2\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Start Game\" /><text value=\"&lt;/\" /><text value=\"h2\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"h2\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Options\" /><text value=\"&lt;/\" /><text value=\"h2\" class=\"name\" /><text value=\"&gt;\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>&lt;h1&gt;</code>, następnie <code>&lt;h2&gt;</code> i na końcu <code>&lt;h2&gt;</code>.</p></body></html>"
