            "contentType": "executableFiles",
            "images": [],
            "executableContent": {
              "instructions": "Zanim przejdziemy dalej, uruchom kod, aby wyświetlić podgląd bieżącego stanu. Jak dotąd wszystkie liczby znajdują się w wierszach, co wciąż znacznie odbiega od struktury sudoku z wierszami i kolumnami. Naprawmy to.\n \n1. W regule `grid-container` utwórz trzy równe kolumny siatki, każda o szerokości `40px`.",
              "preselectedFileIndex": 1,
              "hasVisualOutput": true,
              "files": [
                {
                  "name": "index.html",
                  "codeLanguage": "html",
                  "content": "<!doctype html>\n<html>\n  <head>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n  <body>\n    <h2>Sudoku Puzzle</h2>\n    <div class=\"grid-container\">\n      <div class=\"grid-item\">1</div>\n      <div class=\"grid-item\"></div>\n      <div class=\"grid-item\"></div>\n      <div class=\"grid-item\">3</div>\n      <div class=\"grid-item\">2</div>\n      <div class=\"grid-item\"></div>\n      <div class=\"grid-item\"></div>\n      <div class=\"grid-item\"></div>\n      <div class=\"grid-item\">1</div>\n    </div>\n  </body>\n</html>",
                  "solvedContent": null
                },
                {
                  "name": "style.css",
                  "codeLanguage": "css",
                  "content": ".grid-container {\n  display: grid;\n}\n\n.grid-item {\n  text-align: center;\n  font-weight: bold;\n  color: #2980B9;\n  background-color: #D6EAF8;\n  margin: 2px;\n}\n\nh2 {\n  color: #2980B9;\n}",
                  "solvedContent": ".grid-container {\n  display: grid;\n  grid-template-columns: 40px 40px 40px;\n}\n\n.grid-item {\n  text-align: center;\n  font-weight: bold;\n  color: #2980B9;\n  background-color: #D6EAF8;\n  margin: 2px;\n}\n\nh2 {\n  color: #2980B9;\n}"
                }
