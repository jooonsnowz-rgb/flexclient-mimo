        "id": 17174,
        "title": "Typy",
        "type": "practiceLevel1",
        "lessons": [
          {
            "title": "Lesson #1",
            "id": 145363,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dotychczas poznaliśmy i używaliśmy wielu różnych rodzajów wartości. W języku programowania te różne rodzaje wartości nazywamy <strong>typami</strong>.</p></body></html>"
          },
          {
            "title": "Lesson #2",
            "id": 145364,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Ciągi znaków to znaki umieszczone między cudzysłowami <code>\" \"</code>, na przykład wartość <code>\"PlayerOne\"</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"42\" /></content></option><option startIndex=\"19\" endIndex=\"30\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" playerName = \" /><text value=\"&quot;PlayerOne&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(playerName);\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>\"PlayerOne\"</code>.</p></body></html>"
          },
          {
            "title": "Lesson #3",
            "id": 145365,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><strong>Liczba</strong> to kolejny typ, którego już używaliśmy. Reprezentuje wartości liczbowe, takie jak <code>100</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"true\" /></content></option><option startIndex=\"21\" endIndex=\"24\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" playerHealth = \" /><text value=\"100\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(playerHealth);\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>100</code>.</p></body></html>"
          },
          {
            "title": "Lesson #4",
            "id": 145366,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Typ <strong>boolean</strong> zawiera tylko dwie wartości: specjalne wartości <code>true</code> i <code>false</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"&quot;true&quot;\" /></content></option><option startIndex=\"19\" endIndex=\"24\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" isGameOver = \" /><text value=\"false\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(isGameOver);\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>false</code>.</p></body></html>"
          },
          {
            "title": "Lesson #5",
            "id": 145367,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Gdy przechowujemy wartość <code>false</code> w zmiennej <code>isPaused</code>, mówimy, że <strong>przypisujemy</strong> wartość do zmiennej.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"49\" /></content></option><option startIndex=\"6\" endIndex=\"14\" /><option startIndex=\"17\" endIndex=\"22\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" isPaused = \" /><text value=\"false\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(isPaused);\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>isPaused</code>, a następnie <code>false</code>.</p></body></html>"
          },
          {
            "title": "Lesson #6",
            "id": 145368,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jak nazywają się wartości takie jak wartości logiczne, ciągi znaków i liczby?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Typy</item><item value=\"2\" correct=\"false\">Zmienne</item></selection><p visible-if=\"wrong\">Koniecznie wybierz Typy.</p></body></html>"
          },
          {
            "title": "Lesson #7",
            "id": 145369,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jak rozpoznajemy wartości typu <strong>string</strong>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Przez otaczające je cudzysłowy <code>\" \"</code></item><item value=\"2\" correct=\"false\">Przez to, że zawsze są słowami lub literami</item></selection><p visible-if=\"wrong\">Przez otaczające je cudzysłowy <code>\" \"</code>.</p></body></html>"
          },
          {
            "title": "Lesson #8",
            "id": 145370,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Która wartość jest typu <strong>number</strong>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>100</code></item><item value=\"2\" correct=\"false\"><code>\"100\"</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>100</code>.</p></body></html>"
          },
          {
            "title": "Lesson #9",
            "id": 145371,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jakie są wartości <strong>logiczne</strong>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>true</code> i <code>false</code></item><item value=\"2\" correct=\"false\"><code>\"True\"</code> i <code>\"False\"</code></item></selection><p visible-if=\"wrong\"><code>true</code> i <code>false</code>.</p></body></html>"
          },
          {
            "title": "Lesson #10",
            "id": 145372,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Czym jest przypisanie do zmiennej?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Przechowywanie wartości w zmiennej</item><item value=\"2\" correct=\"false\">Nadawanie zmiennej nazwy</item></selection><p visible-if=\"wrong\">Przechowywanie wartości w zmiennej.</p></body></html>"
          },
          {
            "title": "Lesson #11",
            "id": 145373,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Przypisz <strong>ciąg znaków</strong> do zmiennej <code>levelName</code>, <strong>liczbę</strong> do <code>score</code> oraz <strong>wartość logiczną</strong> do <code>hasKey</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"null\" /></content></option><option startIndex=\"18\" endIndex=\"26\" /><option startIndex=\"42\" endIndex=\"46\" /><option startIndex=\"63\" endIndex=\"67\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" levelName = \" /><text value=\"&quot;Forest&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" score = \" /><text value=\"2800\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" hasKey = \" /><text value=\"true\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(levelName, score, hasKey);\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>\"Forest\"</code>, następnie <code>2800</code> i na końcu <code>true</code>.</p></body></html>"
          },
          {
            "title": "Lesson #12",
            "id": 145374,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zapisz wartość typu <strong>string</strong> w zmiennej <code>enemyType</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"false\" /></content></option><option startIndex=\"18\" endIndex=\"25\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" enemyType = \" /><text value=\"&quot;Slime&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(enemyType);\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>\"Slime\"</code>.</p></body></html>"
          },
          {
            "title": "Lesson #13",
            "id": 145375,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zapisz wartość typu <strong>number</strong> w zmiennej.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"&quot;10&quot;\" /></content></option><option startIndex=\"6\" endIndex=\"15\" /><option startIndex=\"18\" endIndex=\"19\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" livesLeft = \" /><text value=\"3\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(livesLeft);\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>livesLeft</code>, a następnie <code>3</code>.</p></body></html>"
          },
          {
            "title": "Lesson #14",
            "id": 145376,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Przypisz <code>isPaused</code> wartość typu <strong>boolean</strong><code>true</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"17\" endIndex=\"21\" isDefault=\"true\" /></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" isPaused = \" /><text value=\"true\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(isPaused);\" /></content></code><p visible-if=\"wrong\">Koniecznie wpisz <code>true</code>.</p></body></html>"
          },
          {
            "title": "Lesson #15",
            "id": 145377,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Przypisz wartość <code>57</code> zmiennej <code>const</code><code>enemyCount</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"&quot;fifty-seven&quot;\" /></content></option><option startIndex=\"0\" endIndex=\"5\" /><option startIndex=\"6\" endIndex=\"16\" /><option startIndex=\"17\" endIndex=\"18\" /><option startIndex=\"19\" endIndex=\"21\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" enemyCount = \" /><text value=\"57\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(enemyCount);\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>const</code>, następnie <code>enemyCount</code>, a potem <code>=</code>, <code>57</code>.</p></body></html>"
          }
        ]
