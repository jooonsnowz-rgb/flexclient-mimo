ype=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" pickup1 = \" /><text value=\"new\" class=\"keyword\" /><text value=\" Pickup(\" /><text value=\"&quot;GoldCoin&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" pickup2 = \" /><text value=\"new\" class=\"keyword\" /><text value=\" Pickup(\" /><text value=\"&quot;Gem&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"pickup1.points = \" /><text value=\"10\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"pickup2.points = \" /><text value=\"50\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"pickup1.collect();\" /><text type=\"break\" /><text value=\"pickup2.collect();\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>.collect();</code>, a następnie <code>.collect();</code>.</p></body></html>"
