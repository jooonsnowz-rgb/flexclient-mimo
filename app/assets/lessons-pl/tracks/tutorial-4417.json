            "interactiveContent": "<!DOCTYPE html ><html><body><p>Dodaj <code>\"Health Potion\"</code> do tej tablicy ekwipunku.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"pop\" /></content></option><option correct=\"false\"><content><text value=\"&quot;Mana Potion&quot;\" /></content></option><option startIndex=\"46\" endIndex=\"55\" /><option startIndex=\"55\" endIndex=\"56\" /><option startIndex=\"56\" endIndex=\"60\" /><option startIndex=\"61\" endIndex=\"76\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" inventory = [\" /><text value=\"&quot;Wooden Sword&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Shield&quot;\" class=\"string\" /><text value=\"];\" /><text type=\"break\" /><text value=\"inventory.push(\" /><text value=\"&quot;Health Potion&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(inventory);\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>inventory</code>, następnie <code>.</code>, a potem <code>push</code>, <code>\"Health Potion\"</code>.</p></body></html>"
