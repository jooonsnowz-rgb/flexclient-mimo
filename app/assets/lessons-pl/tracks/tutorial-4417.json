            "id": 147956,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zaktualizuj drugi element na <code>\"Mage\"</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"party[2]\" /></content></option><option correct=\"false\"><content><text value=\"&quot;Paladin&quot;\" /></content></option><option startIndex=\"36\" endIndex=\"44\" /><option startIndex=\"45\" endIndex=\"46\" /><option startIndex=\"47\" endIndex=\"53\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" party = [\" /><text value=\"&quot;Warrior&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Rogue&quot;\" class=\"string\" /><text value=\"];\" /><text type=\"break\" /><text value=\"party[\" /><text value=\"1\" class=\"number\" /><text value=\"] = \" /><text value=\"&quot;Mage&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(party);\" /></content></code><p visible-if=\"wrong\">Koniecznie wybierz <code>party[1]</code>, następnie <code>=</code> i na końcu <code>\"Mage\"</code>.</p></body></html>"
