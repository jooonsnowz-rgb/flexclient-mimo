            "id": 66799,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Czym jest reguła CSS?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Selektor i jego deklaracje</item><item value=\"2\" correct=\"false\">Znaczniki <code>style</code>, selektor i deklaracje, które chcemy dodać</item><item value=\"3\" correct=\"false\">Para wartości właściwości CSS</item></selection><p visible-if=\"wrong\">Selektor i jego deklaracje.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Które części <code>p { color: red; }</code> tworzą regułę CSS?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Selektor <code>p</code> i deklaracja <code>color: red;</code></item><item value=\"2\" correct=\"false\">Znaczniki <code>style</code> i deklaracja <code>color: red;</code></item><item value=\"3\" correct=\"false\">Tylko właściwość i wartość, <code>color: red</code></item></selection><p visible-if=\"wrong\">Selektor <code>p</code> i deklaracja <code>color: red;</code>.</p></body></html>"
