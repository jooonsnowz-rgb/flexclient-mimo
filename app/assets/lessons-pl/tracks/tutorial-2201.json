            "id": 66697,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Do której właściwości należy wartość <code>italic</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>font-style</code></item><item value=\"2\" correct=\"false\"><code>font-family</code></item><item value=\"3\" correct=\"false\"><code>font-weight</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>font-style</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Używasz <code>font-family: italic;</code>, ale tekst pozostaje prosty. Która deklaracja powinna ją zastąpić?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>font-style: italic;</code></item><item value=\"2\" correct=\"false\"><code>font-family: italic;</code></item><item value=\"3\" correct=\"false\"><code>font-weight: italic;</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>font-style: italic;</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
