            "id": 66709,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jak zmieniamy rozmiar tekstu na stronie internetowej?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Za pomocą właściwości <code>font-size</code></item><item value=\"2\" correct=\"false\">Za pomocą właściwości <code>font-family</code></item><item value=\"3\" correct=\"false\">Za pomocą właściwości <code>font-weight</code></item></selection><p visible-if=\"wrong\">Za pomocą właściwości <code>font-size</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Akapit powinien mieć większy tekst. Która deklaracja zmienia rozmiar tekstu?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>font-size: 24px;</code></item><item value=\"2\" correct=\"false\"><code>font-family: 24px;</code></item><item value=\"3\" correct=\"false\"><code>font-weight: 24px;</code></item></selection><p visible-if=\"wrong\">Koniecznie wybierz <code>font-size: 24px;</code>.</p></body></html>"
