            "contentType": "executableFiles",
            "images": [],
            "executableContent": {
              "instructions": "Измени теги, чтобы исправить порядок заголовков. Оставь тексты в том же порядке; просто измени заголовки.",
              "preselectedFileIndex": 0,
              "hasVisualOutput": true,
              "files": [
                {
                  "name": "index.html",
                  "codeLanguage": "html",
                  "content": "<!doctype html>\n<html>\n <body>\n  <h3>Dungeon Quest</h3>\n  <h1>Boss Rush Mode</h1>\n  <h4>By Pixel Studio</h4>\n  <h2>Patch notes 1.2.0</h2>\n </body>\n</html>",
