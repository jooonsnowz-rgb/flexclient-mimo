                }
              ],
              "hints": []
            }
          },
          {
            "title": "Lesson #3",
            "id": 149466,
            "contentType": "executableFiles",
            "images": [],
            "executableContent": {
              "instructions": "Дайте элементу `<img>` осмысленный альтернативный текст. Выберите любое подходящее описание, но включите в него слово `\"Земля\"`.",
              "preselectedFileIndex": 0,
              "hasVisualOutput": true,
              "files": [
                {
                  "name": "index.html",
                  "codeLanguage": "html",
                  "content": "<!doctype html>\n<html>\n <body>\n  <img src=\"https://mimo.app/i/earth.png\">\n </body>\n</html>",
                  "solvedContent": "<!doctype html>\n<html>\n <body>\n  <img src=\"https://mimo.app/i/earth.png\" alt=\"Earth as seen from space in the game\">\n </body>\n</html>"
