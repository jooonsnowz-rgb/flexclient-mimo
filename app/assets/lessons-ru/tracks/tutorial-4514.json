            "id": 149470,
            "contentType": "executableFiles",
            "images": [],
            "executableContent": {
              "instructions": "Измени элементы `div`, чтобы сделать код семантическим, используй правильные HTML-элементы для секций.",
              "preselectedFileIndex": 0,
              "hasVisualOutput": true,
              "files": [
                {
                  "name": "index.html",
                  "codeLanguage": "html",
                  "content": "<!doctype html>\n<html lang=\"en\">\n <body>\n  <div>\n   <h1>This level is more than 1 year old.</h1>\n  </div>\n  <div>\n   <p>The hero explored the ancient ruins.</p>\n   <p>New quests appear each week in the realm.</p>\n  </div>\n  <div>2023 Pixel Forge Studios. All rights reserved.</div>\n </body>\n</html>",
                  "solvedContent": "<!doctype html>\n<html lang=\"en\">\n <body>\n  <header>\n   <h1>This level is more than 1 year old.</h1>\n  </header>\n  <main>\n   <p>The hero explored the ancient ruins.</p>\n   <p>New quests appear each week in the realm.</p>\n  </main>\n  <footer>2023 Pixel Forge Studios. All rights reserved.</footer>\n </body>\n</html>"
                }
