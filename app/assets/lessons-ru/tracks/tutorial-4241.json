            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Какой атрибут нам нужно установить для тега <code>img</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Атрибут <code>src</code></item><item value=\"2\" correct=\"false\">Атрибут <code>href</code></item></selection><p visible-if=\"wrong\">Атрибут <code>src</code>.</p></body></html>"
