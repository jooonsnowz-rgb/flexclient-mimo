            "interactiveContent": "<!DOCTYPE html ><html><body><p>Сколько подклассов можно создать из суперкласса?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Сколько угодно</item><item value=\"2\" correct=\"false\">Не более десяти</item></selection><p visible-if=\"wrong\">Сколько угодно.</p></body></html>"
