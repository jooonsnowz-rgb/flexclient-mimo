            "interactiveContent": "<!DOCTYPE html ><html><body><p>Мы используем метод <code>DELETE</code>, чтобы удалить ресурс с сервера, например, удалить файл или запись.</p><img src=\"5d5e1f86-5b01-497f-8ee6-04ace8d2921f\" visible-if=\"always\" /></body></html>",
            "hardModeSelected": true
