ue=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\" \" /><text value=\"class\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;color bold&quot;\" class=\"string\" /><text value=\"&gt;\" /><text value=\"Color\" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\" \" /><text value=\"class\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;italic&quot;\" class=\"string\" /><text value=\"&gt;\" /><text value=\"Italic\" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;/\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;/\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"202\" endIndex=\"206\" /></interactions></code><code version=\"2\" codelang=\"css\" name=\"style.css\" visible-if=\"always\"><content><text value=\".color\" class=\"selector-class\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"color\" class=\"attribute\" /><text value=\": brown;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\".italic\" class=\"selector-class\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"font-style\" class=\"attribute\" /><text value=\": italic;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\".bold\" class=\"selector-class\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"font-weight\" class=\"attribute\" /><text value=\": bold;\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Обязательно выбери <code>bold</code>.</p></body></html>"
