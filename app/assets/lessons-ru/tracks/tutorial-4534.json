            "interactiveContent": "<!DOCTYPE html ><html><body><p>Напиши код, чтобы вывести сообщение, указывающее, что покупка завершена, если покупка была совершена.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"buyArrows\" /></content></option><option correct=\"false\"><content><text value=\"catch\" /></content></option><option correct=\"false\"><content><text value=\"purchase\" /></content></option><option startIndex=\"328\" endIndex=\"341\" /><option startIndex=\"342\" endIndex=\"346\" /><option startIndex=\"378\" endIndex=\"390\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" inventory = {\" /><text type=\"break\" /><text value=\" \" /><text value=\"potions\" class=\"attr\" /><text value=\": \" /><text value=\"10\" class=\"number\" /><text value=\",\" /><text type=\"break\" /><text value=\" \" /><text value=\"arrows\" class=\"attr\" /><text value=\": \" /><text value=\"17\" class=\"number\" /><text value=\",\" /><text type=\"break\" /><text value=\" \" /><text value=\"bombs\" class=\"attr\" /><text value=\": \" /><text value=\"0\" class=\"number\" /><text type=\"break\" /><text value=\"};\" /><text type=\"break\" /><text type=\"break\" /><text value=\"let\" class=\"keyword\" /><text value=\" purchase = \" /><text value=\"false\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"buyArrows\" class=\"title\" /><text value=\"(\" /><text value=\"\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" \" /><text value=\"new\" class=\"keyword\" /><text value=\" \" /><text value=\"Promise\" class=\"built_in\" /><text value=\"(\" /><text value=\"func