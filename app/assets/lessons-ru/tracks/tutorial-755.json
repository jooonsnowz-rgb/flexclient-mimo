            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Код <code>!true</code> внутри оператора вывода.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\"><content><text value=\"console\" class=\"built_in\" /><text value=\".log(!\" /><text value=\"true\" class=\"literal\" /><text value=\");\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"12\" endIndex=\"17\" /></interactions><output><content><text value=\"false\" /></content></output></code><p visible-if=\"wrong\">Обязательно выбери <code>!true</code>.</p></body></html>"
