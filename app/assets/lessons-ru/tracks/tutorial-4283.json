            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Что отображает этот код?</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><content><text value=\"&lt;!doctype html&gt;\" class=\"meta\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Pause Screen\" /><text value=\"&lt;/\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"button\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Resume\" /><text value=\"&lt;/\" /><text value=\"button\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;/\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;/\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Кнопка с надписью <code>Resume</code></item><item value=\"2\" correct=\"false\">Кнопка, отображающая <code>Pause Screen</code></item></selection><p visible-if=\"wrong\">Кнопка с надписью <code>Resume</code>.</p></body></html>"
