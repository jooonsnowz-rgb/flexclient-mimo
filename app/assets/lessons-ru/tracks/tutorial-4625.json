            "executableContent": {
              "instructions": "Дополни вспомогательную функцию `read_quantity()`. Перехватывай только `ValueError` и возвращай `None` для некорректного текста.",
              "preselectedFileIndex": 0,
              "hasVisualOutput": false,
              "files": [
                {
                  "name": "script.py",
                  "codeLanguage": "python",
                  "content": "def read_quantity(value):\n  return int(value)\n\ndef read_discount(value):\n  try:\n    return int(value)\n  except ValueError:\n    return 0\n\ndef prepare_order(quantity_text, discount_text):\n  quantity = read_quantity(quantity_text)\n  if quantity is None:\n    return None\n\n  discount = read_discount(discount_text)\n  return quantity, discount",
                  "solvedContent": "def read_quantity(value):\n  try:\n    return int(value)\n  except ValueError:\n    return None\n\ndef read_discount(value):\n  try:\n    return int(value)\n  except ValueError:\n    return 0\n\ndef prepare_order(quantity_text, discount_text):\n  quantity = read_quantity(quantity_text)\n  if quantity is None:\n    return None\n\n  discount = read_discount(discount_text)\n  return quantity, discount"
                }
