ue=\"&lt;/\" /><text value=\"em\" class=\"name\" /><text value=\"&gt;\" /><text value=\"&lt;\" /><text value=\"br\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"   Dodge \" /><text value=\"&lt;\" /><text value=\"strong\" class=\"name\" /><text value=\"&gt;\" /><text value=\"asteroids\" /><text value=\"&lt;/\" /><text value=\"strong\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"   \" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;/\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;/\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /></content></code><p visible-if=\"wrong\">Обязательно выбери <code>&lt;</code>, затем <code>!doctype</code>, а затем <code>html</code>, <code>&gt;</code>.</p></body></html>"
