            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Что делает специальная инструкция <code>console.log()</code>?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">Он отображает значение в консоли</item><item correct=\"false\" value=\"2\">Он создает переменную</item></selection><p visible-if=\"wrong\">Он отображает значение в консоли.</p></body></html>"
          },
          {
