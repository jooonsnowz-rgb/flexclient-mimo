            "interactiveContent": "<!DOCTYPE html ><html><body><p>Какой код помещается в скобки <code>document.createElement()</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Тип элемента, например, <code>\"img\"</code> для элемента <code>img</code></item><item value=\"2\" correct=\"false\">Значение ID элемента</item><item value=\"3\" correct=\"false\">Имя переменной, которая хранит элемент</item></selection><p visible-if=\"wrong\">Тип элемента, например, <code>\"img\"</code> для элемента <code>img</code>.</p></body></html>"
