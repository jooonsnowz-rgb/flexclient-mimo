            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Сохрани строку в <code>nextState</code>, чтобы результат сравнения был <code>true</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"&quot;menu&quot;\" /></content></option><option startIndex=\"47\" endIndex=\"56\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" currentState = \" /><text value=\"&quot;menu&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" nextState = \" /><text value=\"&quot;playing&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" stateChanged = currentState !== nextState;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(stateChanged);\" /></content></code><p visible-if=\"wrong\">Обязательно выбери <code>\"playing\"</code>.</p></body></html>"
