            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Что не так с этим кодом?</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><content><text value=\"&lt;\" /><text value=\"button\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Equip Item\" /><text value=\"&lt;/\" /><text value=\"button\" class=\"name\" /><text value=\"&gt;\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">С кодом все в порядке</item><item value=\"2\" correct=\"false\">Текст внутри элемента <code>button</code> имеет пробел</item><item value=\"3\" correct=\"false\">В закрывающем теге кнопки отсутствует <code>/</code></item></selection><p visible-if=\"wrong\">С кодом все в порядке.</p></body></html>"
