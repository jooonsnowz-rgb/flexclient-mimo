            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Мы узнали о структуре дерева HTML-документа, узлах и их типах. Теперь давайте посмотрим, как узлы <em>связаны</em> друг с другом.</p></body></html>"
          },
          {
