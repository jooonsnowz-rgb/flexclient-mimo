            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pourquoi utilisons-nous des instructions <code>return</code> et des instructions conditionnelles ensemble ?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Pour arrêter une fonction à différentes parties de son exécution</item><item value=\"2\" correct=\"false\">Pour retourner plusieurs sorties simultanément</item></selection><p visible-if=\"wrong\">Pour arrêter une fonction à différentes parties de son exécution.</p></body></html>"
