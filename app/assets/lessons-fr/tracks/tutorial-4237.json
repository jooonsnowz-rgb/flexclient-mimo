            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Lequel de ces tags est un tag vide ou auto-fermable ?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>&lt;br&gt;</code></item><item value=\"2\" correct=\"false\"><code>&lt;/strong&gt;</code></item><item value=\"3\" correct=\"false\"><code>&lt;/em&gt;</code></item><item value=\"4\" correct=\"false\"><code>&lt;p&gt;</code></item></selection><p visible-if=\"wrong\">Assurez-vous de choisir <code>&lt;br&gt;</code>.</p></body></html>"
