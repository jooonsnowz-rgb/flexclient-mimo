            "hardModeContent": "<!DOCTYPE html ><html><body><p>Quel signe sépare les paramètres de requête après le premier ?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>&amp;</code></item><item value=\"2\" correct=\"false\"><code>?</code></item><item value=\"3\" correct=\"false\"><code>,</code></item></selection><p visible-if=\"wrong\">Assurez-vous de choisir <code>&amp;</code>.</p></body></html>"
