            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quelle URL demande des données à l'API pour un utilisateur dont l'identifiant est <code>4</code> ?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>https://mimo.org/users?userId=4</code></item><item value=\"2\" correct=\"false\"><code>https://mimo.org/courses?userId=4</code></item></selection><p visible-if=\"wrong\">Assurez-vous de choisir <code>https://mimo.org/users?userId=4</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Cette API filtre les utilisateurs avec le paramètre <code>userId</code>.</p><p>Quelle URL demande des données à l'API pour un utilisateur dont l'identifiant est <code>4</code> ?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>https://mimo.org/users?userId=4</code></item><item value=\"2\" correct=\"false\"><code>https://mimo.org/courses?userId=4</code></item><item value=\"3\" correct=\"false\"><code>https://mimo.org/users?id=4</code></item></selection><p visible-if=\"wrong\"><code>https://mimo.org/users?userId=4</code>.</p></body></html>",
            "hardModeSelected": true
