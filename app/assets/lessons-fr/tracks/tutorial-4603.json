            "interactiveContent": "<!DOCTYPE html ><html><body><p>Devons-nous installer des packages comme math ou random qui font partie de la bibliothèque standard de Python ?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Non, tout notre code Python a accès à ces modules</item><item value=\"2\" correct=\"false\">Oui, tous les modules doivent d'abord être installés</item></selection><p visible-if=\"wrong\">Non, tout notre code Python a accès à ces modules.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Devons-nous installer des packages comme math ou random qui font partie de la bibliothèque standard de Python ?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Non, tout notre code Python a accès à ces modules</item><item value=\"2\" correct=\"false\">Oui, pip doit installer <code>math</code> et <code>random</code> dans chaque projet</item></selection><p visible-if=\"wrong\">Non, tout notre code Python a accès à ces modules.</p></body></html>"
