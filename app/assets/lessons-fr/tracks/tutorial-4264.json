            "id": 145337,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Vérifie si <code>60</code> est supérieur ou égal à <code>50</code> avec l'opérateur supérieur ou égal à, <code>&gt;=</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"15\" endIndex=\"17\" isDefault=\"true\" /></interactions><content><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"60\" class=\"number\" /><text value=\" &gt;= \" /><text value=\"50\" class=\"number\" /><text value=\");\" /></content></code><p visible-if=\"wrong\">Assurez-vous de rentrer <code>&gt;=</code>.</p></body></html>"
