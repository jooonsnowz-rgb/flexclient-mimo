            "id": 103695,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Ajoute un deuxième paramètre, <code>width</code> à la fonction fléchée et définis sa valeur par défaut à <code>3</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getArea = \" /><text value=\"(\" /><text value=\"length, width = \" /><text value=\"3\" class=\"number\" /><text value=\") =&gt;\" /><text value=\" length * width;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getArea(\" /><text value=\"5\" class=\"number\" /><text value=\"));\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"25\" endIndex=\"34\" /></interactions><output><content><text value=\"15\" /></content></output></code><p visible-if=\"wrong\">Assurez-vous de rentrer <code>width = 3</code>.</p></body></html>"
