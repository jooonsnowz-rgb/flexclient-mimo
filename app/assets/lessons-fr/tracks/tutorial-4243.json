        "lessons": [
          {
            "title": "Lesson #1",
            "id": 144789,
            "contentType": "executableFiles",
            "images": [],
            "executableContent": {
              "instructions": "Ajoute la balise de fermeture pour l'élément `a` afin que seul le texte `Start game` devienne un lien.",
              "preselectedFileIndex": 0,
              "hasVisualOutput": true,
              "files": [
                {
                  "name": "index.html",
                  "codeLanguage": "html",
                  "content": "<!doctype html>\n<html>\n <body>\n  <h4>Arcade Menu:</h4>\n  <p>\n   <a href=\"https://example.com/play\">Start game\n    now!\n  </p>\n </body>\n</html>",
                  "solvedContent": "<!doctype html>\n<html>\n <body>\n  <h4>Arcade Menu:</h4>\n  <p>\n   <a href=\"https://example.com/play\">Start game</a>\n    now!\n  </p>\n </body>\n</html>"
                }
              ],
              "hints": []
            }
          },
          {
            "title": "Lesson #2",
            "id": 144790,
            "contentType": "executableFiles",
            "images": [],
            "executableContent": {
              "instructions": "À l'intérieur de la balise de lien ouvrante, ajoute le nom de l'attribut manquant. Ensuite, ajoute ton site web de jeu préféré après `https://`.",
