            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pourquoi passons-nous plusieurs tableaux à une fonction ?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Pour effectuer une action spécifique qui inclut des informations provenant de plusieurs tableaux</item><item value=\"2\" correct=\"false\">Pour effectuer une action spécifique qui inclut des informations provenant d'un seul tableau</item></selection><p visible-if=\"wrong\">Pour effectuer une action spécifique qui inclut des informations provenant de plusieurs tableaux.</p></body></html>"
