            "title": "Lesson #10 - Copy",
            "id": 131989,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quel paramètre utilises-tu pour inclure une clé API ?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Le paramètre <code>headers</code></item><item value=\"2\" correct=\"false\">Le paramètre <code>body</code></item><item value=\"3\" correct=\"false\">Le paramètre <code>params</code></item></selection><p visible-if=\"wrong\">Le paramètre <code>headers</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Tu stockes une clé API dans <code>auth</code>. Quel argument l'envoie comme métadonnée d'authentification ?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>headers=auth</code></item><item value=\"2\" correct=\"false\"><code>json=auth</code></item><item value=\"3\" correct=\"false\"><code>params=auth</code></item></selection><p visible-if=\"wrong\">Assurez-vous de choisir <code>headers=auth</code>.</p></body></html>",
            "hardModeSelected": true
