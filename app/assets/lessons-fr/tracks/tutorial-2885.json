            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quelle méthode dans <code>requests</code> te permet de passer facilement des paramètres de requête ?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">L'argument <code>params</code></item><item value=\"2\" correct=\"false\">L'argument <code>body</code></item><item value=\"3\" correct=\"false\">L'argument <code>headers</code></item></selection><p visible-if=\"wrong\">L'argument <code>params</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Tu stockes les paramètres de requête dans <code>filters</code>. Quel argument les transmet avec <code>requests</code> ?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>params=filters</code></item><item value=\"2\" correct=\"false\"><code>json=filters</code></item><item value=\"3\" correct=\"false\"><code>headers=filters</code></item></selection><p visible-if=\"wrong\">Assurez-vous de choisir <code>params=filters</code>.</p></body></html>",
