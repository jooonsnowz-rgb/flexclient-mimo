            "id": 144777,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Utilise le bon attribut pour définir la source du sprite.</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><interactions><interaction type=\"validatedInput\" startIndex=\"5\" endIndex=\"8\" isDefault=\"true\" /></interactions><content><text value=\"&lt;\" /><text value=\"img\" class=\"name\" /><text value=\" \" /><text value=\"src\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;https://mimo.app/i/rocket.png&quot;\" class=\"string\" /><text value=\"&gt;\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Assurez-vous de rentrer <code>src</code>.</p></body></html>"
