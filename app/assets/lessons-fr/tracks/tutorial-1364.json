            "id": 89142,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Nous séparons les valeurs de l'ensemble comme <code>\"SW1A\"</code> et <code>\"SY3\"</code> en utilisant des virgules <code>,</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"postcodes = {\" /><text value=\"&quot;SW1A&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;SY3&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;B44&quot;\" class=\"string\" /><text value=\"}\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"19\" endIndex=\"20\" /></interactions></code><p visible-if=\"wrong\">Assurez-vous de rentrer <code>,</code>.</p></body></html>"
