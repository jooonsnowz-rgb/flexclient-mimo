            "interactiveContent": "<!DOCTYPE html ><html><body><p>Code le tag d'ouverture pour afficher un bouton sur la page web.</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><interactions><interaction type=\"validatedInput\" startIndex=\"17\" endIndex=\"25\" isDefault=\"true\" /></interactions><content><text value=\"&lt;\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"button\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Play\" /><text value=\"&lt;/\" /><text value=\"button\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;/\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;/\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /></content></code><p visible-if=\"wrong\">Assurez-vous de rentrer <code>&lt;button&gt;</code>.</p></body></html>"
          },
          {
