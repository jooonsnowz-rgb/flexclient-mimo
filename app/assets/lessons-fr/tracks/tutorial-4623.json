            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Complète la f-string avec les détails de l'exception capturée.</p><code version=\"2\" codelang=\"python\" name=\"quantity.py\" visible-if=\"always\"><content><text value=\"quantity_text = \" /><text value=\"&quot;many&quot;\" class=\"string\" /><text type=\"break\" /><text value=\"try\" class=\"keyword\" /><text value=\":\" /><text type=\"break\" /><text value=\"  quantity = int(quantity_text)\" /><text type=\"break\" /><text value=\"except\" class=\"keyword\" /><text value=\" ValueError \" /><text value=\"as\" class=\"keyword\" /><text value=\" error:\" /><text type=\"break\" /><text value=\"  message = \" /><text value=\"f&quot;Quantity failed: \" /><text value=\"{error}\" class=\"subst\" /><text value=\"&quot;\" /><text type=\"break\" /><text value=\"  print(message)\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"119\" endIndex=\"126\" /></interactions><output><content><text value=\"Quantity failed: invalid literal for int() with base 10: 'many'\" /></content></output></code><p visible-if=\"wrong\">Assurez-vous de rentrer <code>{error}</code>.</p></body></html>"
