          {
            "title": "Example 6",
            "id": 59670,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Affiche <code>Atlanta</code> dans la console.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Atlanta&quot;\" class=\"string\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"11\" /><option startIndex=\"11\" endIndex=\"12\" /><option startIndex=\"12\" endIndex=\"21\" /><option startIndex=\"21\" endIndex=\"22\" /><option correct=\"false\"><content><text value=\"Atlanta\" /></content></option></options></interaction></interactions><output><content><text value=\"Atlanta\" /></content></output></code><p visible-if=\"wrong\">Assurez-vous de choisir <code>console.log</code> suivi de <code>(</code> puis <code>\"Atlanta\"</code>, <code>)</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Affiche la chaîne de caractères <code>Atlanta</code> dans la console.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Atlanta&quot;\" class=\"string\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"11\" /><option startIndex=\"11\" endIndex=\"12\" /><option startIndex=\"12\" endIndex=\"21\" /><option startIndex=\"21\" endIndex=\"22\" /><option correct=\"false\"><content><text value=\"console.error\" /></content></option><option correct=\"false\"><content><text value=\"console.warn\" /></content></option><option correct=\"false\"><content><text value=\"Atlanta\" /></content></option></options></interaction></interactions><output><content><text value=\"Atlanta\" /></content></output></code><p visible-if=\"wrong\">Assurez-vous de choisir <code>console.log</code> suivi de <code>(</code>, <code>\"Atlanta\"</code> et enfin <code>)</code>.</p></body></html>"
          },
