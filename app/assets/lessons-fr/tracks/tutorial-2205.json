            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quel signe transforme <code>true</code> en <code>false</code> ?</p><selection multiple=\"multiple\" iscode=\"false\"><item correct=\"true\" value=\"1\"><code>!</code></item><item correct=\"false\" value=\"2\"><code>-</code></item><item correct=\"false\" value=\"2\"><code>?</code></item></selection><p visible-if=\"wrong\">Assurez-vous de choisir <code>!</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Quelle expression donne <code>false</code> en inversant <code>true</code> ?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>!true</code></item><item value=\"2\" correct=\"false\"><code>-true</code></item><item value=\"3\" correct=\"false\"><code>?true</code></item></selection><p visible-if=\"wrong\">Assurez-vous de choisir <code>!true</code>.</p></body></html>"
