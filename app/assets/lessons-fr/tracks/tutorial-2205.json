            "id": 59768,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Affiche <code>goal</code> moins <code>milesRan</code> dans la console.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" goal = \" /><text value=\"5\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" milesRan = \" /><text value=\"3\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Miles left: &quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(goal - milesRan);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"78\" endIndex=\"82\" /><option startIndex=\"83\" endIndex=\"84\" /><option startIndex=\"85\" endIndex=\"93\" /><option correct=\"false\"><content><text value=\"/\" /></content></option></options></interaction></interactions><output><content><text value=\"Miles left: \" /><text type=\"break\" /><text value=\"2\" /></content></output></code><p visible-if=\"wrong\">Assurez-vous de choisir <code>goal</code> suivi de <code>-</code> et enfin <code>milesRan</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Après le libellé, affiche le nombre de miles restants par rapport à <code>goal</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" goal = \" /><text value=\"5\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" milesRan = \" /><text value=\"3\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Miles left: &quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(goal - milesRan);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"78\" endIndex=\"82\" /><option startIndex=\"83\" endIndex=\"84\" /><option startIndex=\"85\" endIndex=\"93\" /><option correct=\"false\"><content><text value=\"+\" /></content></option><option correct=\"false\"><content><text value=\"*\" /></content></option><option correct=\"false\"><content><text value=\"/\" /></content></option></options></interaction></interactions><output><content><text value=\"Miles left: \" /><text type=\"break\" /><text value=\"2\" /></content></output></code><p visible-if=\"wrong\">Assurez-vous de choisir <code>goal</code> suivi de <code>-</code> et enfin <code>milesRan</code>.</p></body></html>"
          },
