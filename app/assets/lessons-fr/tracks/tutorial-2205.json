            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quelle valeur n'est pas une chaîne de caractères ?</p><selection multiple=\"multiple\" iscode=\"false\"><item correct=\"true\" value=\"1\"><code>true</code></item><item correct=\"false\" value=\"2\"><code>\"true\"</code></item><item correct=\"false\" value=\"2\"><code>\"wrong\"</code></item></selection><p visible-if=\"wrong\">Assurez-vous de choisir <code>true</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Ton application est prête. Quelle valeur spéciale dois-tu stocker dans <code>isReady</code> pour l’indiquer ?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>true</code></item><item value=\"2\" correct=\"false\"><code>\"true\"</code></item><item value=\"3\" correct=\"false\"><code>false</code></item></selection><p visible-if=\"wrong\">Assurez-vous de choisir <code>true</code>.</p></body></html>",
