          {
            "title": "Closing tag",
            "id": 58994,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Ajoute la balise de fermeture manquante.</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Welcome\" /><text value=\"&lt;/\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"11\" endIndex=\"16\" /><option correct=\"false\"><content><text value=\"&lt;\\h1&gt;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Assurez-vous de choisir <code>&lt;/h1&gt;</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Utilise des balises ouvrante et fermante correspondantes pour placer <code>Welcome</code> dans un titre <code>h1</code>.</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Welcome\" /><text value=\"&lt;/\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"4\" /><option startIndex=\"11\" endIndex=\"16\" /><option correct=\"false\"><content><text value=\"&lt;h2&gt;\" /></content></option><option correct=\"false\"><content><text value=\"&lt;\\h1&gt;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Assurez-vous de choisir <code>&lt;h1&gt;</code> suivi de <code>&lt;/h1&gt;</code>.</p></body></html>",
            "hardModeSelected": true
