            "interactiveContent": "<!DOCTYPE html ><html><body><p>À quoi sert le signe <code>=</code> ?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">Il attribue une valeur à une variable</item><item correct=\"false\" value=\"2\">Il additionne des valeurs de chaîne ensemble</item><item correct=\"false\" value=\"3\">Il divise un nombre par un autre nombre</item></selection><p visible-if=\"wrong\">Il attribue une valeur à une variable.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Dans <code>score = 9</code>, que fait le signe <code>=</code> ?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Il stocke <code>9</code> dans <code>score</code></item><item value=\"2\" correct=\"false\">Il affiche <code>9</code> dans la console</item><item value=\"3\" correct=\"false\">Il joint <code>score</code> et <code>9</code></item></selection><p visible-if=\"wrong\">Assurez-vous de choisir Il stocke <code>9</code> dans <code>score</code>.</p></body></html>"
