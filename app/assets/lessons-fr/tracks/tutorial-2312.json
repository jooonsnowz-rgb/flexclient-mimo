            "id": 76347,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Que montre ce code dans la console ?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"is_close = \" /><text value=\"True\" class=\"literal\" /><text type=\"break\" /><text value=\"is_far = \" /><text value=\"not\" class=\"keyword\" /><text value=\" is_close\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(is_far)\" /></content><output><content><text value=\"False\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>False</code></item><item value=\"2\" correct=\"false\"><code>True</code></item><item value=\"3\" correct=\"false\"><code>\"True\"</code></item></selection><p visible-if=\"wrong\">Assurez-vous de choisir <code>False</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>is_close</code> commence à <code>True</code>, et <code>is_far</code> stocke <code>not is_close</code>. Qu'est-ce qui est affiché ?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"is_close = \" /><text value=\"True\" class=\"literal\" /><text type=\"break\" /><text value=\"is_far = \" /><text value=\"not\" class=\"keyword\" /><text value=\" is_close\" /><text type=\"break\" /><text type=\"break\" /><text value=\"print(is_far)\" /></content><output><content><text value=\"False\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>False</code></item><item value=\"2\" correct=\"false\"><code>True</code></item><item value=\"3\" correct=\"false\"><code>\"False\"</code></item></selection><p visible-if=\"wrong\">Assurez-vous de choisir <code>False</code>.</p></body></html>"
