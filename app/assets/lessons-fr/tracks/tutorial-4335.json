            "interactiveContent": "<!DOCTYPE html ><html><body><p>Ignore le bloc de code de la boucle while en définissant la condition sur <code>false</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"7\" endIndex=\"12\" isDefault=\"true\" /></interactions><content><text value=\"while\" class=\"keyword\" /><text value=\" (\" /><text value=\"false\" class=\"literal\" /><text value=\") {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Pause screen&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Assurez-vous de rentrer <code>false</code>.</p></body></html>"
