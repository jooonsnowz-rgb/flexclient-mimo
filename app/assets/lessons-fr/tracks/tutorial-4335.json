            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Comment savons-nous quand une boucle while s'arrêtera ?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">En vérifiant son état</item><item value=\"2\" correct=\"false\">En vérifiant son mot-clé</item></selection><p visible-if=\"wrong\">En vérifiant son état.</p></body></html>"
          },
          {
