            "interactiveContent": "<!DOCTYPE html ><html><body><p>Combien d'éléments un tableau vide contient-il ?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>0</code></item><item value=\"2\" correct=\"false\"><code>1</code></item><item value=\"3\" correct=\"false\"><code>2</code></item></selection><p visible-if=\"wrong\">Assurez-vous de choisir <code>0</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Un panier commence par <code>[]</code>, sans rien entre les crochets. Quelle est sa longueur ?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>0</code></item><item value=\"2\" correct=\"false\"><code>1</code></item><item value=\"3\" correct=\"false\"><code>2</code></item><item value=\"4\" correct=\"false\"><code>undefined</code>, car il n'existe aucun premier élément</item></selection><p visible-if=\"wrong\">Assurez-vous de choisir <code>0</code>.</p></body></html>"
