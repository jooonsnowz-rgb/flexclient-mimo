            "interactiveContent": "<!DOCTYPE html ><html><body><p>Change les <code>points</code> de <code>pickup1</code> et <code>pickup2</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"155\" endIndex=\"175\" /><option startIndex=\"176\" endIndex=\"196\" /></options></interaction></interactions><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"Pickup\" class=\"title\" /><text value=\" \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"constructor\" class=\"keyword\" /><text value=\"(name) {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"this\" class=\"keyword\" /><text value=\".name = name;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"this\" class=\"keyword\" /><text value=\".points = \" /><text value=\"0\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" pickup1 = \" /><text value=\"new\" class=\"keyword\" /><text value=\" Pickup(\" /><text value=\"&quot;GoldCoin&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" pickup2 = \" /><text value=\"new\" class=\"keyword\" /><text value=\" Pickup(\" /><text value=\"&quot;Gem&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"pickup1.points = \" /><text value=\"10\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"pickup2.points = \" /><text value=\"50\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(pickup1);\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(pickup2);\" /></content></code><p visible-