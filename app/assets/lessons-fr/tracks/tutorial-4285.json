ue=\"  \" /><text value=\"&lt;\" /><text value=\"script\" class=\"name\" /><text value=\" \" /><text value=\"src\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;script.js&quot;\" class=\"string\" /><text value=\"&gt;\" /><text value=\"\" class=\"undefined\" /><text value=\"&lt;/\" /><text value=\"script\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;/\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;/\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /></content></code><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"139\" endIndex=\"149\" /><option startIndex=\"150\" endIndex=\"151\" /><option startIndex=\"152\" endIndex=\"162\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"startGame\" class=\"title\" /><text value=\"(\" /><text value=\"\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" hud = \" /><text value=\"document\" class=\"built_in\" /><text value=\".querySelector(\" /><text value=\"&quot;p&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" playerName = \" /><text value=\"document\" class=\"built_in\" /><text value=\".getElementById(\" /><text value=\"&quot;playerNameInput&quot;\" class=\"string\" /><text value=\").value;\" /><text type=\"break\" /><text value=\" hud.innerHTML = playerName + \" /><text value=\"&quot;, ready!&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Assurez-vous de choisir <code>.innerHTML</code> suivi de <code>=</code> et en