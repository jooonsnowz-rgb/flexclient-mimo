            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Comment changeons-nous le nombre de points que le joueur gagne avec une pièce ?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Avec la propriété <code>scoreValue</code></item><item value=\"2\" correct=\"false\">Avec la propriété <code>spriteName</code></item><item value=\"3\" correct=\"false\">Avec la propriété <code>fontWeight</code></item></selection><p visible-if=\"wrong\">Avec la propriété <code>scoreValue</code>.</p></body></html>"
