            "interactiveContent": "<!DOCTYPE html ><html><body><p>À quelle propriété appartient la valeur <code>idle</code> ?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>animation-state</code></item><item value=\"2\" correct=\"false\"><code>sprite-sheet</code></item><item value=\"3\" correct=\"false\"><code>movement-speed</code></item></selection><p visible-if=\"wrong\">Assurez-vous de choisir <code>animation-state</code>.</p></body></html>"
