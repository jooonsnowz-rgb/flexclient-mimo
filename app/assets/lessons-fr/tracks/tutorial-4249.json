ex=\"1\" /><option startIndex=\"1\" endIndex=\"5\" /></options></interaction></interactions><content><text value=\".boss\" class=\"selector-class\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"color\" class=\"attribute\" /><text value=\": red;\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Assurez-vous de choisir <code>.</code> suivi de <code>boss</code>.</p></body></html>"
