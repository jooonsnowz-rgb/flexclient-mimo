            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quelle comparaison donne <code>False</code> ?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>5 &lt; 5</code></item><item value=\"2\" correct=\"false\"><code>5 &lt;= 5</code></item><item value=\"3\" correct=\"false\"><code>5 == 5</code></item></selection><p visible-if=\"wrong\"><code>5 &lt; 5</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Un score vaut exactement <code>5</code>. Quelle comparaison indique correctement que le score n'est pas supérieur à <code>5</code> ?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>5 &lt;= 5</code></item><item value=\"2\" correct=\"false\"><code>5 &lt; 5</code></item><item value=\"3\" correct=\"false\"><code>5 != 5</code></item></selection><p visible-if=\"wrong\">Assurez-vous de choisir <code>5 &lt;= 5</code>.</p></body></html>"
