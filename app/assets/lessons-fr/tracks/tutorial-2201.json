            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pour ajouter une bordure autour d'un élément, quelle valeur est nécessaire ?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">La valeur <code>solid</code></item><item value=\"2\" correct=\"false\">La valeur <code>10px red</code></item><item value=\"2\" correct=\"false\">La valeur <code>10px black</code></item></selection><p visible-if=\"wrong\">La valeur <code>solid</code>.</p></body></html>",
