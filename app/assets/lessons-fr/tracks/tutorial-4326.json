            "interactiveContent": "<!DOCTYPE html ><html><body><p>Que signifie <code>CDN</code> ?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>Content Delivery Network</code></item><item value=\"2\" correct=\"false\"><code>Central Data Notebook</code></item></selection><p visible-if=\"wrong\"><code>Content Delivery Network</code>.</p></body></html>"
