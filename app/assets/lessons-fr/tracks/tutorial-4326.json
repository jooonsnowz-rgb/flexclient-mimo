            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Comment les bibliothèques nous aident-elles à gagner du temps ?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Nous pouvons utiliser une solution déjà écrite par d'autres programmeurs</item><item value=\"2\" correct=\"false\">Un concepteur de jeux corrigera notre code pour nous</item></selection><p visible-if=\"wrong\">Nous pouvons utiliser une solution déjà écrite par d'autres programmeurs.</p></body></html>"
