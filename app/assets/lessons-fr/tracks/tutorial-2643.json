          {
            "title": "Question 1",
            "id": 129301,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Quel est le type de l'entrée que nous capturons ?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"false\">La saisie de l'utilisateur est soit une chaîne de caractères, soit un nombre</item><item value=\"2\" correct=\"true\">Toute entrée de l'utilisateur est traitée comme une chaîne de caractères</item></selection><p visible-if=\"wrong\">Toute entrée de l'utilisateur est traitée comme une chaîne de caractères.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Un utilisateur saisit <code>42</code> après un appel à <code>input()</code>. Quel type est stocké avant toute conversion ?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"false\">Un nombre, car <code>42</code> ne contient que des chiffres</item><item value=\"2\" correct=\"true\">Une chaîne de caractères, car l'entrée recueillie est initialement du texte</item><item value=\"3\" correct=\"false\">Une chaîne de caractères ou un nombre, selon ce que l'utilisateur saisit</item></selection><p visible-if=\"wrong\">Une chaîne de caractères, car l'entrée recueillie est initialement du texte.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Question 2",
            "id": 129302,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>À quoi sert la fonction <code>input</code> ?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Pour recevoir une entrée de l'utilisateur</item><item value=\"2\" correct=\"false\">Pour produire une sortie pour l'utilisateur</item></selection><p visible-if=\"wrong\">Pour recevoir une entrée de l'utilisateur.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>La fonction <code>input</code> reçoit une entrée de l'utilisateur.</p><p>Un programme demande à l'utilisateur sa ville. Quel rôle revient à <code>input()</code> ?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Lire la réponse saisie par l'utilisateur afin que le programme puisse l'utiliser</item><item value=\"2\" correct=\"false\">Afficher la ville à l'écran afin que l'utilisateur puisse la lire</item><item value=\"3\" correct=\"false\">Convertir la réponse de l'utilisateur dans le type dont le programme a besoin</item></selection><p visible-if=\"wrong\">Lire la réponse saisie par l'utilisateur afin que le programme puisse l'utiliser.</p></body></html>"
