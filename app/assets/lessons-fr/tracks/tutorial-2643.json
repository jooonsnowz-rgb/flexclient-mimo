            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Que fait la fonction <code>input()</code> ?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Il lit une ligne de l'entrée et la renvoie sous forme de chaîne</item><item value=\"2\" correct=\"false\">Il écrit une valeur en sortie</item></selection><p visible-if=\"wrong\">Il lit une ligne de l'entrée et la renvoie sous forme de chaîne.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Une fois que l'utilisateur appuie sur Entrée, que renvoie <code>input()</code> au programme ?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">La ligne saisie par l'utilisateur, sous forme de chaîne de caractères</item><item value=\"2\" correct=\"false\">Un message écrit dans la sortie de la console</item><item value=\"3\" correct=\"false\">La ligne sous forme de nombre lorsqu'elle ne contient que des chiffres</item></selection><p visible-if=\"wrong\">La ligne saisie par l'utilisateur, sous forme de chaîne de caractères.</p></body></html>"
