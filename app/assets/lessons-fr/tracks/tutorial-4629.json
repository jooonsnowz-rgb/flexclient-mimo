            "id": 152201,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Que se passe-t-il ici ?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"requests.put(course_url, json=course_data)\" /><text type=\"break\" /><text value=\"requests.delete(lesson_url)\" /></content></code><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Le code remplace un enregistrement de cours complet, puis supprime une ancienne leçon</item><item value=\"2\" correct=\"false\">Le code remplace un enregistrement de cours complet</item><item value=\"3\" correct=\"false\">Le code supprime une ancienne leçon</item></selection><p visible-if=\"wrong\">Le code remplace un enregistrement de cours complet, puis supprime une ancienne leçon.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Que se passe-t-il ici ?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"requests.put(course_url, json=course_data)\" /><text type=\"break\" /><text value=\"requests.delete(lesson_url)\" /></content></code><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Le code remplace un enregistrement de cours complet, puis supprime une ancienne leçon</item><item value=\"2\" correct=\"false\">Le code remplace un enregistrement de cours complet</item><item value=\"3\" correct=\"false\">Le code supprime une ancienne leçon</item><item value=\"4\" correct=\"false\">Le code modifie partiellement le cours, mais laisse chaque leçon intacte</item></selection><p visible-if=\"wrong\">Le code remplace un enregistrement de cours complet, puis supprime une ancienne leçon.</p></body></html>"
          },
          {
