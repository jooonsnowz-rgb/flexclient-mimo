          {
            "title": "Lesson #5",
            "id": 146820,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Muestra <code>1</code> a través de <code>4</code> en la consola.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"score += 2;\" /></content></option><option startIndex=\"36\" endIndex=\"44\" /><option startIndex=\"46\" endIndex=\"65\" /></options></interaction></interactions><content><text value=\"let\" class=\"keyword\" /><text value=\" score = \" /><text value=\"0\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" (score &lt; \" /><text value=\"4\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\" score++;\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(score);\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Asegúrese de elegir <code>score++;</code> seguido de <code>console.log(score);</code>.</p></body></html>"
          },
