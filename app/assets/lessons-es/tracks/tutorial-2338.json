            "interactiveContent": "<!DOCTYPE html ><html><body><p>¿Qué contiene el conjunto <code>difference</code>?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"airing = {\" /><text value=\"&quot;The Godfather&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Taxi Driver&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Moonlight&quot;\" class=\"string\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"recently_watched = {\" /><text value=\"&quot;Moonlight&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Vertigo&quot;\" class=\"string\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text type=\"break\" /><text value=\"difference = airing.difference(recently_watched)\" /><text type=\"break\" /><text value=\"print(difference)\" /></content><output><content><text value=\"{'The Godfather', 'Taxi Driver'}\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>{'The Godfather', 'Taxi Driver'}</code></item><item value=\"2\" correct=\"false\">Un conjunto vacío </item><item value=\"3\" correct=\"false\"><code>{'Vertigo'}</code></item></selection><p visible-if=\"wrong\"><code>{'The Godfather', 'Taxi Driver'}</code>.</p></body></html>",
