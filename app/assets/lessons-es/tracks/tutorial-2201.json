            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>¿A qué propiedad pertenece el valor <code>italic</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>font-style</code></item><item value=\"2\" correct=\"false\"><code>font-family</code></item><item value=\"3\" correct=\"false\"><code>font-weight</code></item></selection><p visible-if=\"wrong\">Asegúrese de elegir <code>font-style</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Escribiste <code>font-family: italic;</code>, pero el texto no se inclina. ¿Qué declaración debe sustituirla?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>font-style: italic;</code></item><item value=\"2\" correct=\"false\"><code>font-family: italic;</code></item><item value=\"3\" correct=\"false\"><code>font-weight: italic;</code></item></selection><p visible-if=\"wrong\">Asegúrese de elegir <code>font-style: italic;</code>.</p></body></html>",
            "hardModeSelected": true
