            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>¿Qué es una regla CSS?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Un selector y sus declaraciones</item><item value=\"2\" correct=\"false\">Las etiquetas <code>style</code>, el selector y las declaraciones que queremos agregar</item><item value=\"3\" correct=\"false\">El par de valores de propiedad CSS</item></selection><p visible-if=\"wrong\">Un selector y sus declaraciones.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>En <code>p { color: red; }</code>, ¿qué partes componen la regla CSS?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">El selector <code>p</code> y la declaración <code>color: red;</code></item><item value=\"2\" correct=\"false\">Las etiquetas <code>style</code> y la declaración <code>color: red;</code></item><item value=\"3\" correct=\"false\">Solo la propiedad y el valor, <code>color: red</code></item></selection><p visible-if=\"wrong\">El selector <code>p</code> y la declaración <code>color: red;</code>.</p></body></html>"
