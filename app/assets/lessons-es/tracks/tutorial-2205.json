            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>¿Puedes asegurarte de que <code>true</code> aparezca en la consola?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" loggedIn = \" /><text value=\"false\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Logged in:&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(loggedIn);\" /><text type=\"break\" /><text type=\"break\" /><text value=\"loggedIn = !\" /><text value=\"false\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Logged in:&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(loggedIn);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"133\" endIndex=\"141\" /><option correct=\"false\"><content><text value=\"!true\" /></content></option><option correct=\"false\"><content><text value=\"false\" /></content></option></options></interaction></interactions><output><content><text value=\"Logged in:\" /><text type=\"break\" /><text value=\"false\" /><text type=\"break\" /><text value=\"Logged in:\" /><text type=\"break\" /><text value=\"true\" /></content></output></code><p visible-if=\"wrong\">Asegúrese de elegir <code>loggedIn</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Completa el último mensaje para que el segundo estado muestre el valor actualizado.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"let\" class=\"keyword\" /><text value=\" loggedIn = \" /><text value=\"false\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Logged in:&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(loggedIn);\" /><text type=\"break\" /><text type=\"break\" /><text value=\"loggedIn = !\" /><text value=\"false\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Logged in:&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(loggedIn);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"133\" endIndex=\"141\" /><option correct=\"false\"><content><text value=\"!loggedIn\" /></content></option><option correct=\"false\"><content><text value=\"false\" /></content></option><option correct=\"false\"><content><text value=\"true\" /></content></option></options></interaction></interactions><output><content><text value=\"Logged in:\" /><text type=\"break\" /><text value=\"false\" /><text type=\"break\" /><text value=\"Logged in:\" /><text type=\"break\" /><text value=\"true\" /></content></output></code><p visible-if=\"wrong\">Asegúrese de elegir <code>loggedIn</code>.</p></body></html>"
