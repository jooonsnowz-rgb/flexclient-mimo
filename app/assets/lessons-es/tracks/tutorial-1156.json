          {
            "title": "Example: Index",
            "id": 79560,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Asegúrate de que <code>\"cat\"</code> esté en el índice <code>0</code>, y <code>\"dog\"</code> esté en el índice <code>1</code>, codificando <code>\"cat\"</code> luego <code>\"dog\"</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"animals = [\" /><text value=\"&quot;cat&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;dog&quot;\" class=\"string\" /><text value=\"]\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"11\" endIndex=\"16\" /><option startIndex=\"18\" endIndex=\"23\" /><option correct=\"false\"><content><text value=\"animals\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Asegúrese de elegir <code>\"cat\"</code> seguido de <code>\"dog\"</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Coloca <code>\"dog\"</code> en el índice <code>1</code> y <code>\"cat\"</code> en el índice <code>0</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"animals = [\" /><text value=\"&quot;cat&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;dog&quot;\" class=\"string\" /><text value=\"]\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"11\" endIndex=\"16\" /><option startIndex=\"18\" endIndex=\"23\" /><option correct=\"false\"><content><text value=\"animals\" /></content></option><option correct=\"false\"><content><text value=\"cat\" /></content></option><option correct=\"false\"><content><text value=\"dog\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Asegúrese de elegir <code>\"cat\"</code> seguido de <code>\"dog\"</code>.</p></body></html>",
