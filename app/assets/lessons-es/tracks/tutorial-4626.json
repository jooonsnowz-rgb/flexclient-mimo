            "interactiveContent": "<!DOCTYPE html ><html><body><p>¿Qué signo separa los parámetros de consulta después del primero?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>&amp;</code></item><item value=\"2\" correct=\"false\"><code>?</code></item></selection><p visible-if=\"wrong\">Asegúrese de elegir <code>&amp;</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>¿Qué signo separa los parámetros de consulta después del primero?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>&amp;</code></item><item value=\"2\" correct=\"false\"><code>?</code></item><item value=\"3\" correct=\"false\"><code>,</code></item></selection><p visible-if=\"wrong\">Asegúrese de elegir <code>&amp;</code>.</p></body></html>"
