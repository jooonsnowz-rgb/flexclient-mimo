            "interactiveContent": "<!DOCTYPE html ><html><body><p>Estilizamos partes del texto en una página web usando una etiqueta de apertura <code>&lt;span&gt;</code>, seguida de texto y luego una etiqueta de cierre <code>&lt;/span&gt;</code>.</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"&lt;style&gt;\" /></content></option><option correct=\"false\"><content><text value=\"&lt;/style&gt;\" /></content></option><option startIndex=\"78\" endIndex=\"84\" /><option startIndex=\"90\" endIndex=\"97\" /></options></interaction></interactions><content><text value=\"&lt;!doctype html&gt;\" class=\"meta\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"h3\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Mini Game HUD\" /><text value=\"&lt;/\" /><text value=\"h3\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"ul\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"   \" /><text value=\"&lt;\" /><text value=\"li\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Player: \" /><text value=\"&lt;\" /><text value=\"span\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Ranger\" /><text value=\"&lt;/\" /><text value=\"span\" class=\"name\" /><text value=\"&gt;\" /><text value=\"&lt;/\" /><text value=\"li\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"   \" /><text value=\"&lt;\" /><text value=\"li\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Level: 3\" /><text value=\"&lt;/\" /><text value=\"li\" class=\"name\" /><text 