            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Los programas son más divertidos si pueden recibir entradas del exterior.</p><p>Cuando ejecutamos código, podemos incluir la entrada para modificar el programa.</p></body></html>",
            "hardModeSelected": true
