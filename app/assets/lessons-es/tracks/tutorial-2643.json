            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Pídele al usuario su nombre y guárdalo en la variable <code>user_name</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.py\" visible-if=\"always\"><content><text value=\"user_name = input(\" /><text value=\"&quot;Enter your name: &quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"12\" endIndex=\"17\" /></options></interaction></interactions></code><p visible-if=\"wrong\">Asegúrese de elegir <code>input</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Guarda en <code>user_name</code> la respuesta al mensaje <code>Enter your name: </code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.py\" visible-if=\"always\"><content><text value=\"user_name = input(\" /><text value=\"&quot;Enter your name: &quot;\" class=\"string\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"9\" /><option startIndex=\"10\" endIndex=\"11\" /><option startIndex=\"12\" endIndex=\"17\" /><option startIndex=\"18\" endIndex=\"37\" /><option correct=\"false\"><content><text value=\"print\" /></content></option><option correct=\"false\"><content><text value=\"name\" /></content></option><option correct=\"false\"><content><text value=\"==\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Asegúrese de elegir <code>user_name</code> seguido de <code>=</code>, <code>input</code> y finalmente <code>\"Enter your name: \"</code>.</p></body></html>"
