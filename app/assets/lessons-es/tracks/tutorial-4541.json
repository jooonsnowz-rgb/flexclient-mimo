            "id": 149949,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Llama al nuevo método <code>collect()</code> que pertenece a la clase <code>Pickup</code> para ver cómo todas las instancias de <code>Pickup</code> pueden usarlo.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\".collect;\" /></content></option><option startIndex=\"313\" endIndex=\"324\" /><option startIndex=\"332\" endIndex=\"343\" /></options></interaction></interactions><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"Pickup\" class=\"title\" /><text value=\" \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"constructor\" class=\"keyword\" /><text value=\"(name) {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"this\" class=\"keyword\" /><text value=\".name = name;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"this\" class=\"keyword\" /><text value=\".points = \" /><text value=\"0\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"  \" /><text value=\"this\" class=\"keyword\" /><text value=\".rarity = \" /><text value=\"1\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"  \" /><text value=\"this\" class=\"keyword\" /><text value=\".total = \" /><text value=\"0\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\" collect() {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"this\" class=\"keyword\" /><text value=\".total += \" /><text value=\"this\" class=\"keyword\" /><text value=\".points;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"this\" class=\"keyword\" /><text value=\".total);\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" pickup1 = \" /><text value=\"new\" class=\"keyword\" /><text value=\" Pickup(\" /><text value=\"&quot;GoldCoin&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" pickup2 = \" /><text value=\"new\" class=\"keyword\" /><text value=\" Pickup(\" /><text value=\"&quot;Gem&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"pickup1.points = \" /><text value=\"10\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"pickup2.points = \" /><text value=\"50\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"pickup1.collect();\" /><text type=\"break\" /><text value=\"pickup2.collect();\" /></content></code><p visible-if=\"wrong\">Asegúrese de elegir <code>.collect();</code> seguido de <code>.collect();</code>.</p></body></html>"
