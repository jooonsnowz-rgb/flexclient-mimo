            "interactiveContent": "<!DOCTYPE html ><html><body><p>¿Cómo nombramos una función?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Usando camel case</item><item value=\"2\" correct=\"false\">Incluyendo espacios en el nombre de la función</item></selection><p visible-if=\"wrong\">Usando camel case.</p></body></html>"
          },
