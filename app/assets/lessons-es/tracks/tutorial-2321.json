          {
            "title": "Example: Condition",
            "id": 78419,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Muestra el número <code>1</code> al <code>3</code> estableciendo la condición <code>number &lt;= 3</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"number = \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" number &lt;= \" /><text value=\"3\" class=\"number\" /><text value=\":\" /><text type=\"break\" /><text value=\"  print(number)\" /><text type=\"break\" /><text value=\"  number += \" /><text value=\"1\" class=\"number\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"25\" endIndex=\"27\" /><option correct=\"false\"><content><text value=\"&lt;\" /></content></option><option correct=\"false\"><content><text value=\"&gt;\" /></content></option></options></interaction></interactions><output><content><text value=\"1\" /><text type=\"break\" /><text value=\"2\" /><text type=\"break\" /><text value=\"3\" /></content></output></code><p visible-if=\"wrong\">Asegúrese de elegir <code>&lt;=</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Imprime del <code>1</code> al <code>3</code>, incluido el propio <code>3</code>. Elige el operador que permite seguir repitiendo hasta incluir el <code>3</code>.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"number = \" /><text value=\"1\" class=\"number\" /><text type=\"break\" /><text type=\"break\" /><text value=\"while\" class=\"keyword\" /><text value=\" number &lt;= \" /><text value=\"3\" class=\"number\" /><text value=\":\" /><text type=\"break\" /><text value=\"  print(number)\" /><text type=\"break\" /><text value=\"  number += \" /><text value=\"1\" class=\"number\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"25\" endIndex=\"27\" /><option correct=\"false\"><content><text value=\"&lt;\" /></content></option><option correct=\"false\"><content><text value=\"&gt;\" /></content></option></options></interaction></interactions><output><content><text value=\"1\" /><text type=\"break\" /><text value=\"2\" /><text type=\"break\" /><text value=\"3\" /></content></output></code><p visible-if=\"wrong\">Asegúrese de elegir <code>&lt;=</code>.</p></body></html>"
          },
