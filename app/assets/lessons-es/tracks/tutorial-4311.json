            "id": 146314,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>¿Qué hace al establecer el ancho de un elemento hijo al <code>100%</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Hace que el elemento ocupe todo el ancho del elemento padre</item><item value=\"2\" correct=\"false\">Hace que el elemento se extienda a su tamaño completo</item></selection><p visible-if=\"wrong\">Hace que el elemento ocupe todo el ancho del elemento padre.</p></body></html>"
