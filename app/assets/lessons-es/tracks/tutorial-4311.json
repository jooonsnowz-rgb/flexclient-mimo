            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>¿A qué elemento se refiere un porcentaje cuando anidamos un elemento dentro de otro elemento, como un elemento <code>&lt;div&gt;</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Los porcentajes se refieren al nuevo elemento padre</item><item value=\"2\" correct=\"false\">Los porcentajes siempre se refieren al elemento <code>body</code></item></selection><p visible-if=\"wrong\">Los porcentajes se refieren al nuevo elemento padre.</p></body></html>"
