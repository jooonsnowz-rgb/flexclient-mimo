            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>¿Para qué sirve el signo <code>=</code>?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">Le da un valor a una variable</item><item correct=\"false\" value=\"2\">Agrega valores de cadena juntos</item><item correct=\"false\" value=\"3\">Divide un número por otro número</item></selection><p visible-if=\"wrong\">Le da un valor a una variable.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>En <code>score = 9</code>, ¿qué hace el signo <code>=</code>?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Almacena <code>9</code> en <code>score</code></item><item value=\"2\" correct=\"false\">Muestra <code>9</code> en la consola</item><item value=\"3\" correct=\"false\">Une <code>score</code> y <code>9</code></item></selection><p visible-if=\"wrong\">Asegúrese de elegir Almacena <code>9</code> en <code>score</code>.</p></body></html>"
