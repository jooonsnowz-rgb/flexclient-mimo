            "interactiveContent": "<!DOCTYPE html ><html><body><p>¿Cuántos elementos <code>img</code> tiene este código?</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><content><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Player Sprite\" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"img\" class=\"name\" /><text value=\" \" /><text value=\"src\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;/img/player.png&quot;\" class=\"string\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"br\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"a\" class=\"name\" /><text value=\" \" /><text value=\"href\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;https://example.com/sprites&quot;\" class=\"string\" /><text value=\"&gt;\" /><text value=\"More sprites\" /><text value=\"&lt;/\" /><text value=\"a\" class=\"name\" /><text value=\"&gt;\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Uno</item><item value=\"2\" correct=\"false\">Dos</item><item value=\"3\" correct=\"false\">Tres</item></selection><p visible-if=\"wrong\">Asegúrese de elegir Uno.</p></body></html>"
