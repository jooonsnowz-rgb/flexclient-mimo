          {
            "title": "Lesson #5",
            "id": 145808,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>El atributo <code>type</code> especifica el tipo de entrada. Por ejemplo, podemos ocultar lo que los jugadores escriben para códigos secretos con <code>type=\"password\"</code>.</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"113\" endIndex=\"117\" /><option startIndex=\"117\" endIndex=\"118\" /><option startIndex=\"118\" endIndex=\"128\" /></options></interaction></interactions><content><text value=\"&lt;!doctype html&gt;\" class=\"meta\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"h4\" class=\"name\" /><text value=\"&gt;\" /><text value=\"New Game\" /><text value=\"&lt;/\" /><text value=\"h4\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"input\" class=\"name\" /><text value=\" \" /><text value=\"type\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;text&quot;\" class=\"string\" /><text value=\" \" /><text value=\"placeholder\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;Hero name&quot;\" class=\"string\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"br\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"input\" class=\"name\" /><text value=\" \" /><text value=\"type\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;password&quot;\" class=\"string\" /><text value=\" \" /><text value=\"placeholder\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;Secret code&quot;\" class=\"string\" 