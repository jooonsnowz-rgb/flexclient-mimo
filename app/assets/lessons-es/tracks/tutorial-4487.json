            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Representamos una escena de la interfaz de usuario de un juego como un árbol. ¿Qué partes se consideran nodos?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Todos los elementos de la UI y su texto</item><item value=\"2\" correct=\"false\">Solo elementos que no tienen etiqueta de cierre</item><item value=\"3\" correct=\"false\">Solo elementos con hijos</item></selection><p visible-if=\"wrong\">Todos los elementos de la UI y su texto.</p></body></html>"
          },
