            "interactiveContent": "<!DOCTYPE html ><html><body><p>Agrega el parámetro <code>status</code> a la función.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"userStatus\" class=\"title\" /><text value=\"(\" /><text value=\"status\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Bob: &quot;\" class=\"string\" /><text value=\" + status);\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"userStatus(\" /><text value=\"&quot;Active&quot;\" class=\"string\" /><text value=\");\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"20\" endIndex=\"26\" /></interactions><output><content><text value=\"Bob: Active\" /></content></output></code><p visible-if=\"wrong\">Asegúrese de elegir <code>status</code>.</p></body></html>"
