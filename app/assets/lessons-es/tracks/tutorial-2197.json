            "interactiveContent": "<!DOCTYPE html ><html><body><p>Agrega la etiqueta de cierre que falta.</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Welcome\" /><text value=\"&lt;/\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"11\" endIndex=\"16\" /><option correct=\"false\"><content><text value=\"&lt;\\h1&gt;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Asegúrese de elegir <code>&lt;/h1&gt;</code>.</p></body></html>",
