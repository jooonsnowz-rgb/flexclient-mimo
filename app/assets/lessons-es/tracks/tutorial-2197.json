          {
            "title": "Question 2",
            "id": 59083,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>¿Por qué es la etiqueta de salto de línea una etiqueta vacía?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">Porque no tiene una etiqueta de cierre</item><item correct=\"false\" value=\"2\">Porque no tiene efecto en la estructura de una página web</item><item correct=\"false\" value=\"2\">Porque no tiene una etiqueta de apertura</item></selection><p visible-if=\"wrong\">Porque no tiene una etiqueta de cierre.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Añades <code>&lt;br&gt;</code> entre dos líneas de texto. ¿Por qué no añades <code>&lt;/br&gt;</code> después?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Porque <code>&lt;br&gt;</code> es una etiqueta vacía y no tiene etiqueta de cierre</item><item value=\"2\" correct=\"false\">Porque <code>&lt;br&gt;</code> es una etiqueta de encabezado</item><item value=\"3\" correct=\"false\">Porque las etiquetas vacías no tienen etiqueta de apertura</item></selection><p visible-if=\"wrong\">Porque <code>&lt;br&gt;</code> es una etiqueta vacía y no tiene etiqueta de cierre.</p></body></html>"
