            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>¿Cuándo podríamos necesitar verificar si dos números son iguales?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Cuando verificas si una variable es exactamente igual a 10</item><item value=\"2\" correct=\"false\">Al verificar si una variable es mayor que 50</item></selection><p visible-if=\"wrong\">Cuando verificas si una variable es exactamente igual a 10.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Un carrito almacena <code>items = 10</code>. ¿Qué comprobación coincide exactamente con <code>10</code> artículos, ni más ni menos?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Comprobar si <code>items</code> es igual a <code>10</code></item><item value=\"2\" correct=\"false\">Comprobar si <code>items</code> es mayor que <code>10</code></item><item value=\"3\" correct=\"false\">Comprobar si <code>items</code> es al menos <code>10</code></item></selection><p visible-if=\"wrong\">Comprobar si <code>items</code> es igual a <code>10</code>.</p></body></html>"
