            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>¿Pueden las subclases usar solo los métodos que tiene su superclase?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">No, las subclases también pueden tener métodos propios</item><item value=\"2\" correct=\"false\">Las subclases <em>no pueden</em> tener métodos propios</item></selection><p visible-if=\"wrong\">No, las subclases también pueden tener métodos propios.</p></body></html>"
