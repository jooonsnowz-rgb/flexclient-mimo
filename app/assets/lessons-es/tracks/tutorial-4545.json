            "title": "Lesson #8",
            "id": 150026,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>¿Cuántas subclases puedes crear a partir de una superclase?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Tantos como quieras</item><item value=\"2\" correct=\"false\">Como máximo diez</item></selection><p visible-if=\"wrong\">Tantos como quieras.</p></body></html>"
