                "id": "41d560a0-322c-4422-b428-caf11623cc72"
              }
            ],
            "interactiveContent": "<!DOCTYPE html ><html><body><img src=\"41d560a0-322c-4422-b428-caf11623cc72\" visible-if=\"always\" /><p>Hay un valor especial que <em>no es</em> ni una cadena <em>ni</em> un número: <code>true</code>.</p><p>No hay comillas alrededor y no es un valor numérico.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Displaying true",
            "id": 62052,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p><code>true</code> es ideal para situaciones como verificar si un interruptor está encendido o si una característica está habilitada.</p><p>Muestra <code>true</code> en la consola.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Allow updates&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"true\" class=\"literal\" /><text value=\");\" /><text type=\"break\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"42\" endIndex=\"46\" /></interactions><output><content><text value=\"Allow updates\" /><text type=\"break\" /><text value=\"true\" /></content></output></code><p visible-if=\"wrong\">Asegúrese de elegir <code>true</code>.</p></body></html>"
          },
          {
            "title": "Saving true ",
            "id": 62050,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Podemos almacenar <code>true</code> en una variable al igual que una cadena o un número.</p><p>Almacena <code>true</code> en una variable y muéstralo en la consola.</p><code version=\"2\" name=\"script.js\" visible-if=\"always\" codelang=\"javascript\"><content><text value=\"const\" class=\"keyword\" /><text value=\" correct = \" /><text value=\"true\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(correct);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"16\" endIndex=\"20\" /><option startIndex=\"34\" endIndex=\"41\" /></options></interaction></interactions><output><content><text value=\"true\" /></content></output></code><p visible-if=\"wrong\">Asegúrese de elegir <code>true</code> seguido de <code>correct</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Podemos almacenar <code>true</code> en una variable al igual que una cadena o un número.</p><p>Crea una variable llamada <code>enabled</code> para una opción activada y muestra su valor especial en la consola.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" \" /><text value=\"enabled\" /><text value=\" \" /><text value=\"=\" /><text value=\" \" /><text value=\"true\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".\" /><text value=\"log\" /><text value=\"(\" /><text value=\"enabled\" /><text value=\")\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"6\" endIndex=\"13\" /><option startIndex=\"16\" endIndex=\"20\" /><option startIndex=\"34\" endIndex=\"41\" /><option correct=\"false\"><content><text value=\"false\" /></content></option><option correct=\"false\"><content><text value=\"&quot;true&quot;\" /></content></option><option correct=\"false\"><content><text value=\"disabled\" /></content></option></options></interaction></interactions><output><content><text value=\"true\" /></content></output></code><p visible-if=\"wrong\">Asegúrese de elegir <code>enabled</code> seguido de <code>true</code> y finalmente <code>enabled</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "False",
            "id": 62049,
            "contentType": "interactive",
            "images": [
              {
                "id": "581c9bf2-4254-41a8-babe-529b2f7e4feb"
              }
            ],
            "interactiveContent": "<!DOCTYPE html ><html><body><img src=\"581c9bf2-4254-41a8-babe-529b2f7e4feb\" visible-if=\"always\" /><p><code>false</code> es otro valor especial y el opuesto de <code>true</code>. Podemos usarlo como <code>true</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Displaying false",
            "id": 62048,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Guarda el valor <code>false</code> en la variable <code>status</code> y muestra <code>status</code> en la consola.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Device charged&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" status = \" /><text value=\"false\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(status);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"46\" endIndex=\"51\" /><option startIndex=\"65\" endIndex=\"71\" /><option correct=\"false\"><content><text value=\"var\" /></content></option></options></interaction></interactions><output><content><text value=\"Device charged\" /><text type=\"break\" /><text value=\"false\" /></content></output></code><p visible-if=\"wrong\">Asegúrese de elegir <code>false</code> seguido de <code>status</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Conserva el primer mensaje. Después, usa <code>charged</code> para guardar el valor especial de un dispositivo sin carga y muéstralo.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"console\" class=\"built_in\" /><text value=\".\" /><text value=\"log\" /><text value=\"(\" /><text value=\"&quot;Device charged&quot;\" class=\"string\" /><text value=\")\" /><text value=\";\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" \" /><text value=\"charged\" /><text value=\" \" /><text value=\"=\" /><text value=\" \" /><text value=\"false\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".\" /><text value=\"log\" /><text value=\"(\" /><text value=\"charged\" /><text value=\")\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"37\" endIndex=\"44\" /><option startIndex=\"47\" endIndex=\"52\" /><option startIndex=\"66\" endIndex=\"73\" /><option correct=\"false\"><content><text value=\"true\" /></content></option><option correct=\"false\"><content><text value=\"&quot;false&quot;\" /></content></option><option correct=\"false\"><content><text value=\"status\" /></content></option></options></interaction></interactions><output><content><text value=\"Device charged\" /><text type=\"break\" /><text value=\"false\" /></content></output></code><p visible-if=\"wrong\">Asegúrese de elegir <code>charged</code> seguido de <code>false</code> y finalmente <code>charged</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Question 1",
            "id": 62132,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>¿Cuál es un buen uso para los valores <code>true</code> y <code>false</code>? </p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">Mostrar si una función está activada o desactivada</item><item correct=\"false\" value=\"2\">Almacenando valores del uno al cinco</item></selection><p visible-if=\"wrong\">Mostrar si una función está activada o desactivada.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Necesitas registrar si la reproducción automática está activada o desactivada. ¿Qué opción representa directamente estos dos estados?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Los valores especiales <code>true</code> y <code>false</code></item><item value=\"2\" correct=\"false\">Un número del uno al cinco</item><item value=\"3\" correct=\"false\">Una cadena que contenga el nombre de la función</item></selection><p visible-if=\"wrong\">Los valores especiales <code>true</code> y <code>false</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Question 2",
            "id": 62134,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>¿Por qué <code>false</code> no es una cadena?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" autoPlay = \" /><text value=\"false\" class=\"literal\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">No hay comillas alrededor</item><item value=\"2\" correct=\"false\">Está almacenado dentro de una variable</item></selection><p visible-if=\"wrong\">No hay comillas alrededor.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Añades comillas alrededor de <code>false</code> en el código mostrado. ¿Qué cambia?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" autoPlay = \" /><text value=\"false\" class=\"literal\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>autoPlay</code> guarda una cadena en vez del valor especial <code>false</code>.</item><item value=\"2\" correct=\"false\">El valor guardado no cambia porque las letras siguen siendo las mismas.</item><item value=\"3\" correct=\"false\">Muestra <code>false</code> en la consola en vez de guardar un valor.</item></selection><p visible-if=\"wrong\"><code>autoPlay</code> guarda una cadena en vez del valor especial <code>false</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Question 3",
            "id": 62133,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Elige la que sea mejor para mostrar que un usuario se dio de baja de un servicio.</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>const subscribed = false;</code></item><item value=\"2\" correct=\"false\"><code>const subscribed = true;</code></item></selection><p visible-if=\"wrong\"><code>const subscribed = false;</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Un usuario ha cancelado una suscripción. ¿Qué declaración registra correctamente ese estado?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>const subscribed = false;</code></item><item value=\"2\" correct=\"false\"><code>const subscribed = true;</code></item><item value=\"3\" correct=\"false\"><code>const subscribed = \"false\";</code></item></selection><p visible-if=\"wrong\">Asegúrese de elegir <code>const subscribed = false;</code>.</p></body></html>"
          },
          {
            "title": "Question 4",
            "id": 62135,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>¿Por qué <code>\"false\"</code> no es lo mismo que <code>false</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Hay comillas alrededor, así que <code>\"false\"</code> es una cadena</item><item value=\"2\" correct=\"false\"><code>\"false\"</code> y <code>false</code> son lo mismo</item></selection><p visible-if=\"wrong\">Hay comillas alrededor, así que <code>\"false\"</code> es una cadena.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Tienes los valores <code>true</code> y <code>\"false\"</code>. ¿Qué cambio convierte ambos valores en cadenas?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Añadir comillas alrededor de <code>true</code> y dejar <code>\"false\"</code> sin cambios.</item><item value=\"2\" correct=\"false\">Quitar las comillas de <code>\"false\"</code> y dejar <code>true</code> sin cambios.</item><item value=\"3\" correct=\"false\">Añadir comillas a <code>true</code> y quitarlas de <code>\"false\"</code>.</item></selection><p visible-if=\"wrong\">Añadir comillas alrededor de <code>true</code> y dejar <code>\"false\"</code> sin cambios.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example 1",
            "id": 62203,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Muestra el estado de la configuración de actualización automática mostrando <code>false</code> en la consola.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\"><content><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Auto update&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"false\" class=\"literal\" /><text value=\");\" /><text type=\"break\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"28\" endIndex=\"35\" /><option startIndex=\"35\" endIndex=\"36\" /><option startIndex=\"36\" endIndex=\"39\" /><option startIndex=\"39\" endIndex=\"40\" /><option startIndex=\"40\" endIndex=\"45\" /><option startIndex=\"45\" endIndex=\"46\" /></options></interaction></interactions><output><content><text value=\"Auto update\" /><text type=\"break\" /><text value=\"false\" /></content></output></code><p visible-if=\"wrong\">Asegúrese de elegir <code>console</code> seguido de <code>.</code> y luego <code>log</code>, <code>(</code>, <code>false</code>, <code>)</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Conserva el primer mensaje. Muestra el valor especial <code>true</code> o <code>false</code> que indica que la actualización automática está desactivada.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"console\" class=\"built_in\" /><text value=\".\" /><text value=\"log\" /><text value=\"(\" /><text value=\"&quot;Auto update&quot;\" class=\"string\" /><text value=\")\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".\" /><text value=\"log\" /><text value=\"(\" /><text value=\"false\" class=\"literal\" /><text value=\")\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"28\" endIndex=\"35\" /><option startIndex=\"35\" endIndex=\"36\" /><option startIndex=\"36\" endIndex=\"39\" /><option startIndex=\"39\" endIndex=\"40\" /><option startIndex=\"40\" endIndex=\"45\" /><option startIndex=\"45\" endIndex=\"46\" /><option correct=\"false\"><content><text value=\"true\" /></content></option><option correct=\"false\"><content><text value=\"alert\" /></content></option><option correct=\"false\"><content><text value=\"&quot;false&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"Auto update\" /><text type=\"break\" /><text value=\"false\" /></content></output></code><p visible-if=\"wrong\">Asegúrese de elegir <code>console</code> seguido de <code>.</code>, <code>log</code>, <code>(</code>, <code>false</code> y finalmente <code>)</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example 2",
            "id": 62204,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Crea la variable <code>autoSaveImage</code> y almacena <code>true</code> dentro de ella.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" autoSaveImage = \" /><text value=\"true\" class=\"literal\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"6\" endIndex=\"19\" /><option startIndex=\"22\" endIndex=\"26\" /><option startIndex=\"0\" endIndex=\"5\" /></options></interaction></interactions></code><p visible-if=\"wrong\">Asegúrese de elegir <code>const</code> seguido de <code>autoSaveImage</code> y finalmente <code>true</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Declara una configuración llamada <code>autoSaveImage</code> que esté activada.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" autoSaveImage = \" /><text value=\"true\" class=\"literal\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"5\" /><option startIndex=\"6\" endIndex=\"19\" /><option startIndex=\"22\" endIndex=\"26\" /><option correct=\"false\"><content><text value=\"let\" /></content></option><option correct=\"false\"><content><text value=\"false\" /></content></option><option correct=\"false\"><content><text value=\"&quot;true&quot;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Asegúrese de elegir <code>const</code> seguido de <code>autoSaveImage</code> y finalmente <code>true</code>.</p></body></html>"
          },
          {
            "title": "Example 3",
            "id": 62205,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Evita las cookies creando la variable y almacenando <code>false</code> en ella.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" allowCookies = \" /><text value=\"false\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"6\" endIndex=\"18\" /><option startIndex=\"21\" endIndex=\"26\" /><option correct=\"false\"><content><text value=\"&quot;false&quot;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Asegúrese de elegir <code>allowCookies</code> seguido de <code>false</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Declara <code>allowCookies</code> de modo que no se permitan las cookies.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" \" /><text value=\"allowCookies\" /><text value=\" \" /><text value=\"=\" /><text value=\" \" /><text value=\"false\" class=\"literal\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"5\" /><option startIndex=\"6\" endIndex=\"18\" /><option startIndex=\"21\" endIndex=\"26\" /><option correct=\"false\"><content><text value=\"let\" /></content></option><option correct=\"false\"><content><text value=\"true\" /></content></option><option correct=\"false\"><content><text value=\"&quot;false&quot;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Asegúrese de elegir <code>const</code> seguido de <code>allowCookies</code> y finalmente <code>false</code>.</p></body></html>"
          },
          {
            "title": "Example 4",
            "id": 62206,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Ajusta la configuración de reproducción automática codificando <code>true</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" autoPlay = \" /><text value=\"true\" class=\"literal\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"17\" endIndex=\"21\" /></interactions></code><p visible-if=\"wrong\">Asegúrese de elegir <code>true</code>.</p></body></html>"
          }
        ]
      },
      {
        "id": 7162,
        "title": "Negar valores",
        "type": "practiceLevel1",
        "lessons": [
          {
            "title": "True to false",
            "id": 62046,
            "contentType": "interactive",
            "images": [
              {
                "id": "c36a47d0-0c24-47c9-ad61-1010d797bdce"
              }
            ],
            "interactiveContent": "<!DOCTYPE html ><html><body><img src=\"c36a47d0-0c24-47c9-ad61-1010d797bdce\" visible-if=\"always\" /><p>Un signo <code>!</code> delante de <code>true</code> hace que la expresión resulte en <code>false</code>. Si algo no es verdadero, tiene que ser falso.</p><p>El signo <code>!</code> es el <strong>operador de negación</strong>. Convierte los valores en su <strong>opuesto</strong>.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Change true to false",
            "id": 62047,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Cuando cambiamos un valor a su opuesto con <code>!</code>, lo negamos.</p><p>Pon un signo <code>!</code> antes de <code>true</code> para cambiar su valor.</p><code version=\"2\" name=\"script.js\" codelang=\"javascript\"><content><text value=\"console\" class=\"built_in\" /><text value=\".log(!\" /><text value=\"true\" class=\"literal\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"12\" endIndex=\"13\" /><option startIndex=\"13\" endIndex=\"17\" /></options></interaction></interactions><output><content><text value=\"false\" /></content></output></code><p visible-if=\"wrong\">Asegúrese de elegir <code>!</code> seguido de <code>true</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Cuando cambiamos un valor a su opuesto con <code>!</code>, lo negamos.</p><p>Niega una vez el valor especial <code>true</code> o <code>false</code> para que la consola muestre <code>false</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"console\" class=\"built_in\" /><text value=\".log(!\" /><text value=\"true\" class=\"literal\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"12\" endIndex=\"13\" /><option startIndex=\"13\" endIndex=\"17\" /><option correct=\"false\"><content><text value=\"false\" /></content></option><option correct=\"false\"><content><text value=\"&quot;true&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"false\" /></content></output></code><p visible-if=\"wrong\">Asegúrese de elegir <code>!</code> seguido de <code>true</code>.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Change false to true",
            "id": 62044,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>El operador <code>!</code> antes de <code>false</code> también cambia su valor. Si un valor no es <code>false</code>, tiene que ser <code>true</code>.</p><code version=\"2\" name=\"script.js\" codelang=\"javascript\"><content><text value=\"console\" class=\"built_in\" /><text value=\".log(!\" /><text value=\"false\" class=\"literal\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"12\" endIndex=\"13\" /><option startIndex=\"13\" endIndex=\"18\" /></options></interaction></interactions><output><content><text value=\"true\" /></content></output></code><p visible-if=\"wrong\">Asegúrese de elegir <code>!</code> seguido de <code>false</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>El operador <code>!</code> antes de <code>false</code> también cambia su valor. Si un valor no es <code>false</code>, tiene que ser <code>true</code>.</p><p>Usa la negación para que la consola muestre <code>true</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"console\" class=\"built_in\" /><text value=\".log(!\" /><text value=\"false\" class=\"literal\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"12\" endIndex=\"13\" /><option startIndex=\"13\" endIndex=\"18\" /><option correct=\"false\"><content><text value=\"true\" /></content></option><option correct=\"false\"><content><text value=\"!!\" /></content></option><option correct=\"false\"><content><text value=\"&quot;false&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"true\" /></content></output></code><p visible-if=\"wrong\">Asegúrese de elegir <code>!</code> seguido de <code>false</code>.</p></body></html>"
          },
          {
            "title": "Negate variables",
            "id": 62040,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Podemos usar el operador <code>!</code> con variables para negar los valores que almacenan.</p><code version=\"2\" name=\"script.js\" visible-if=\"always\" codelang=\"javascript\"><content><text value=\"const\" class=\"keyword\" /><text value=\" isMorning = \" /><text value=\"true\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(!isMorning);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"36\" endIndex=\"37\" /><option startIndex=\"37\" endIndex=\"46\" /></options></interaction></interactions><output><content><text value=\"false\" /></content></output></code><p visible-if=\"wrong\">Asegúrese de elegir <code>!</code> seguido de <code>isMorning</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Podemos usar el operador <code>!</code> con variables para negar los valores que almacenan.</p><p>Guarda que es de mañana y luego haz que la consola muestre que la mañana ha terminado.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" isMorning = \" /><text value=\"true\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(!isMorning);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"18\" endIndex=\"22\" /><option startIndex=\"36\" endIndex=\"37\" /><option startIndex=\"37\" endIndex=\"46\" /><option correct=\"false\"><content><text value=\"false\" /></content></option><option correct=\"false\"><content><text value=\"isEvening\" /></content></option><option correct=\"false\"><content><text value=\"!!\" /></content></option></options></interaction></interactions><output><content><text value=\"false\" /></content></output></code><p visible-if=\"wrong\">Asegúrese de elegir <code>true</code> seguido de <code>!</code> y finalmente <code>isMorning</code>.</p></body></html>",
            "hardModeSelected": true
