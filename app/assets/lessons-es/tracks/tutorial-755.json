            "id": 62209,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>¿Cómo llamamos al signo <code>!</code> delante de <code>true</code> o <code>false</code>? </p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">El signo <code>!</code> es el operador de negación</item><item correct=\"false\" value=\"2\">El signo <code>!</code> es el operador de adición</item></selection><p visible-if=\"wrong\">El signo <code>!</code> es el operador de negación.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>¿Qué operador usarías para cambiar un valor booleano por su opuesto?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">El operador de negación, <code>!</code></item><item value=\"2\" correct=\"false\">El operador de adición, <code>+</code></item><item value=\"3\" correct=\"false\">El operador de asignación, <code>=</code></item></selection><p visible-if=\"wrong\">El operador de negación, <code>!</code></p></body></html>"
