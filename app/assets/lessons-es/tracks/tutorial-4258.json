            "interactiveContent": "<!DOCTYPE html ><html><body><p>¿Qué hace la instrucción especial <code>console.log()</code>?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">Muestra un valor en la consola</item><item correct=\"false\" value=\"2\">Crea una variable</item></selection><p visible-if=\"wrong\">Muestra un valor en la consola.</p></body></html>"
          },
