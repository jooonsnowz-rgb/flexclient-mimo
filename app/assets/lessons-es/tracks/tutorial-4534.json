=\"break\" /><text value=\" \" /><text value=\"boss\" class=\"attr\" /><text value=\": {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"enemies\" class=\"attr\" /><text value=\": \" /><text value=\"0\" class=\"number\" /><text value=\",\" /><text type=\"break\" /><text value=\"  \" /><text value=\"powerUps\" class=\"attr\" /><text value=\": []\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\"};\" /><text type=\"break\" /><text type=\"break\" /><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"loadForestLevel\" class=\"title\" /><text value=\"(\" /><text value=\"\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" \" /><text value=\"new\" class=\"keyword\" /><text value=\" \" /><text value=\"Promise\" class=\"built_in\" /><text value=\"(\" /><text value=\"function\" class=\"keyword\" /><text value=\"(\" /><text value=\"resolve, reject\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\"  \" /><text value=\"if\" class=\"keyword\" /><text value=\" (levelData.forest.enemies &gt; \" /><text value=\"0\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\"   resolve(\" /><text type=\"break\" /><text value=\"   \" /><text value=\"&quot;Forest level loaded with enemies. Starting level.&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"  }\" /><text type=\"break\" /><text value=\" });\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" startLoad = loadForestLevel();\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(startLoad);\" /></content></code><p visible-if=\"wrong\">Asegúrese de elegir <code>levelData.forest</code> seguido de <code>.enemies</code> y finalmente <co