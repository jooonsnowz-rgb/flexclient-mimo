lue=\"function\" class=\"keyword\" /><text value=\"(\" /><text value=\"resolve, reject\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\"  \" /><text value=\"if\" class=\"keyword\" /><text value=\" (inventory.arrows &gt; \" /><text value=\"0\" class=\"number\" /><text value=\") {\" /><text type=\"break\" /><text value=\"   purchase = \" /><text value=\"true\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"   resolve(purchase\" /><text type=\"break\" /><text value=\"    );\" /><text type=\"break\" /><text value=\"  } \" /><text value=\"else\" class=\"keyword\" /><text value=\" {\" /><text type=\"break\" /><text value=\"    reject(\" /><text value=\"&quot;Item not in inventory.&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\"  }\" /><text type=\"break\" /><text value=\" });\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" completeOrder = buyArrows();\" /><text type=\"break\" /><text type=\"break\" /><text value=\"completeOrder.then(\" /><text value=\"function\" class=\"keyword\" /><text value=\" (\" /><text value=\"successValue\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"if\" class=\"keyword\" /><text value=\" (successValue) {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Purchase complete.&quot;\" class=\"string\" /><text value=\");\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\"});\" /></content></code><p visible-if=\"wrong\">Asegúrese de elegir <code>completeOrder</code> seguido de <code>then</code> y finalmente <code>successValue</code>.</p></body></html>"
