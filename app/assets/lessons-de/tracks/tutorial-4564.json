ctions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"relative\" /></content></option><option startIndex=\"63\" endIndex=\"71\" /></options></interaction></interactions><content><text value=\".hud\" class=\"selector-class\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"background-color\" class=\"attribute\" /><text value=\": \" /><text value=\"#1e1e2f\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\" \" /><text value=\"color\" class=\"attribute\" /><text value=\": \" /><text value=\"#ffffff\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\" \" /><text value=\"position\" class=\"attribute\" /><text value=\": absolute;\" /><text type=\"break\" /><text value=\"}\" /></content></code><p visible-if=\"wrong\">Wähle <code>absolute</code> aus.</p></body></html>"
