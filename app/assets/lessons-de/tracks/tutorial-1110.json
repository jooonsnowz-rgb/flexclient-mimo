            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Was macht der Gleichheitsoperator, <code>==</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Es überprüft, ob ein String gleich einem anderen String ist</item><item value=\"2\" correct=\"false\">Es überprüft, ob ein String größer als ein anderer String ist</item></selection><p visible-if=\"wrong\">Es überprüft, ob ein String gleich einem anderen String ist.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Ein Programm prüft <code>\"sun\" == \"sunset\"</code>. Wonach fragt der Vergleich?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Ob beide Strings exakt gleich sind</item><item value=\"2\" correct=\"false\">Ob der erste String vor dem zweiten kommt</item><item value=\"3\" correct=\"false\">Ob der zweite String mit dem ersten beginnt</item></selection><p visible-if=\"wrong\">Ob beide Strings exakt gleich sind.</p></body></html>"
          },
          {
