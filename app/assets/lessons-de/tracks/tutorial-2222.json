          {
            "title": "Question: Zero pixels",
            "id": 82334,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Was zeigt dieser Code an?</p><code version=\"2\" codelang=\"css\" name=\"style.css\" visible-if=\"always\"><content><text value=\"button\" class=\"selector-tag\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"position\" class=\"attribute\" /><text value=\": absolute;\" /><text type=\"break\" /><text value=\" \" /><text value=\"left\" class=\"attribute\" /><text value=\": \" /><text value=\"10px\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Ein Button <code>10px</code> von der linken Seite der Webseite</item><item value=\"2\" correct=\"false\">Ein Button in seiner ursprünglichen Position</item><item value=\"3\" correct=\"false\">Ein Button <code>10px</code> von der rechten Seite der Webseite</item></selection><p visible-if=\"wrong\">Ein Button <code>10px</code> von der linken Seite der Webseite.</p></body></html>",
