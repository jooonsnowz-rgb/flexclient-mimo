            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Was passiert, wenn wir die Eigenschaft <code>display: flex</code> auf ein UI-Panel anwenden, das bereits ein Element innerhalb eines Flex-HUD ist?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Es wird zu einem Flex-Container, zusätzlich dazu, dass es das Flex-Kind seines übergeordneten Containers ist</item><item value=\"2\" correct=\"false\">Es wird auf <code>display: block</code> zurückgesetzt</item><item value=\"3\" correct=\"false\">Es wird nicht zurückgesetzt</item></selection><p visible-if=\"wrong\">Es wird zu einem Flex-Container, zusätzlich dazu, dass es das Flex-Kind seines übergeordneten Containers ist.</p></body></html>"
          },
