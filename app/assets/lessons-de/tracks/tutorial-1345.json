          {
            "title": "Example: One value",
            "id": 88628,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Speichere eine Liste in der <code>cart</code>-Variable, sodass <code>1</code> in der Konsole angezeigt wird.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"cart = [(\" /><text value=\"&quot;t-shirt&quot;\" class=\"string\" /><text value=\", \" /><text value=\"40\" class=\"number\" /><text value=\")]\" /><text type=\"break\" /><text value=\"print(len(cart))\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"7\" endIndex=\"24\" /><option correct=\"false\"><content><text value=\"[(&quot;t-shirt&quot;, 40), (&quot;jeans&quot;, 70)]\" /></content></option></options></interaction></interactions><output><content><text value=\"1\" /></content></output></code><p visible-if=\"wrong\">Wähle <code>[(\"t-shirt\", 40)]</code> aus.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Speichere in <code>cart</code> eine Liste mit einem einzelnen Tupel, sodass <code>1</code> in der Konsole angezeigt wird.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"cart = [(\" /><text value=\"&quot;t-shirt&quot;\" class=\"string\" /><text value=\", \" /><text value=\"40\" class=\"number\" /><text value=\")]\" /><text type=\"break\" /><text value=\"print(len(cart))\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"7\" endIndex=\"24\" /><option correct=\"false\"><content><text value=\"[(&quot;t-shirt&quot;, 40), (&quot;jeans&quot;, 70)]\" /></content></option></options></interaction></interactions><output><content><text value=\"1\" /></content></output></code><p visible-if=\"wrong\">Wähle <code>[(\"t-shirt\", 40)]</code> aus.</p></body></html>"
          },
