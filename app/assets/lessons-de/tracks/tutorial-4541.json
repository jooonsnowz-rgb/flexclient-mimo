            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Code einen parameterlosen Konstruktor.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"15\" endIndex=\"26\" /><option startIndex=\"26\" endIndex=\"27\" /><option startIndex=\"27\" endIndex=\"28\" /><option startIndex=\"29\" endIndex=\"30\" /><option startIndex=\"50\" endIndex=\"51\" /></options></interaction></interactions><content><text value=\"class\" class=\"keyword\" /><text value=\" \" /><text value=\"Level\" class=\"title\" /><text value=\" \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"constructor\" class=\"keyword\" /><text value=\"() {\" /><text type=\"break\" /><text value=\"  \" /><text value=\"this\" class=\"keyword\" /><text value=\".name = \" /><text value=\"&quot;&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\" }\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" level1 = \" /><text value=\"new\" class=\"keyword\" /><text value=\" Level();\" /><text type=\"break\" /><text value=\"level1.name = \" /><text value=\"&quot;Forest&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(level1);\" /></content></code><p visible-if=\"wrong\">Wähle <code>constructor</code>, gefolgt von <code>(</code> und schließlich <code>)</code>, <code>{</code>, <code>}</code> aus.</p></body></html>"
          },
          {
            "title": "Lesson #14",
            "id": 149951,
            "contentType": "interactive",
