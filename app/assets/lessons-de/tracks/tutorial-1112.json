            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wir können Vergleiche verwenden, um zu überprüfen, ob eine Zahl kleiner oder größer als eine andere Zahl ist.</p></body></html>",
            "hardModeSelected": true
