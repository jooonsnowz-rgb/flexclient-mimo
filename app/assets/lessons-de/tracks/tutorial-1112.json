            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wofür verwenden wir den <code>&gt;</code>-Operator?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Um zu überprüfen, ob eine Zahl größer als eine andere Zahl ist</item><item value=\"2\" correct=\"false\">Um zu überprüfen, ob eine Zahl gleich einer anderen Zahl ist</item></selection><p visible-if=\"wrong\">Um zu überprüfen, ob eine Zahl größer als eine andere Zahl ist.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Damit <code>score &gt; best_score</code> zu <code>True</code> wird, was muss zutreffen?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>score</code> ist größer als <code>best_score</code></item><item value=\"2\" correct=\"false\"><code>score</code> ist gleich <code>best_score</code></item><item value=\"3\" correct=\"false\"><code>score</code> ist größer oder gleich <code>best_score</code></item></selection><p visible-if=\"wrong\"><code>score</code> ist größer als <code>best_score</code>.</p></body></html>"
