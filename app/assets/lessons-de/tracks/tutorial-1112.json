            "hardModeContent": "<!DOCTYPE html ><html><body><p>Die linke Zahl ist größer, aber der Operator fragt, ob sie kleiner ist. Was zeigt der Code an?</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"print(\" /><text value=\"10\" class=\"number\" /><text value=\" &lt; \" /><text value=\"1\" class=\"number\" /><text value=\")\" /></content><output><content><text value=\"False\" /></content></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>False</code></item><item value=\"2\" correct=\"false\"><code>True</code></item><item value=\"3\" correct=\"false\"><code>10</code></item></selection><p visible-if=\"wrong\">Wähle <code>False</code> aus.</p></body></html>"
