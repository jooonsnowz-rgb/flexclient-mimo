            "hardModeContent": "<!DOCTYPE html ><html><body><p>Ein Teamkollege liest <code>level &gt; 3</code> laut vor. Welcher Name passt zu dem Zeichen?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Der Größer-als-Operator</item><item value=\"2\" correct=\"false\">Der Kleiner-als-Operator</item><item value=\"3\" correct=\"false\">Der Größer-oder-gleich-Operator</item></selection><p visible-if=\"wrong\">Wähle Der Größer-als-Operator aus.</p></body></html>"
