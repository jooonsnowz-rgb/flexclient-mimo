        "lessons": [
          {
            "title": "Lesson #1",
            "id": 144779,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Was machen Attribute?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Sie fügen Tags zusätzliche Informationen hinzu</item><item value=\"2\" correct=\"false\">Attribute erstellen Spielschleifen</item><item value=\"3\" correct=\"false\">Sie erzeugen Gegner</item><item value=\"4\" correct=\"false\">Attribute schaffen Ebenen</item></selection><p visible-if=\"wrong\">Sie fügen Tags zusätzliche Informationen hinzu.</p></body></html>"
          },
          {
            "title": "Lesson #2",
            "id": 144780,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wie erscheint der Link im Browser?</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><content><text value=\"&lt;\" /><text value=\"h3\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Game Wiki\" /><text value=\"&lt;/\" /><text value=\"h3\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text value=\"&lt;\" /><text value=\"a\" class=\"name\" /><text value=\" \" /><text value=\"href\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;https://en.wikipedia.org/wiki/Video_game&quot;\" class=\"string\" /><text value=\"&gt;\" /><text value=\"&lt;\" /><text value=\"em\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Video game\" /><text value=\"&lt;/\" /><text value=\"em\" class=\"name\" /><text value=\"&gt;\" /><text value=\"&lt;/\" /><text value=\"a\" class=\"name\" /><text value=\"&gt;\" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>Videospiel</code> als ein Link mit Betonung</item><item value=\"2\" correct=\"false\"><code>Video game</code> als normaler Link</item><item value=\"3\" correct=\"false\"><code>Video game</code> mit Betonung, aber mit einem defekten Link</item><item value=\"4\" correct=\"false\"><code>&lt;em&gt;Videospiel&lt;/em&gt;</code> als ein Link</item></selection><p visible-if=\"wrong\"><code>Videospiel</code> als ein Link mit Betonung.</p></body></html>"
          },
          {
            "title": "Lesson #3",
            "id": 144781,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Was ist falsch an diesem Code?</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><content><text value=\"&lt;\" /><text value=\"a\" class=\"name\" /><text value=\" \" /><text value=\"src\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;https://example.com/game-controls&quot;\" class=\"string\" /><text value=\"&gt;\" /><text value=\"Game Controls\" /><text value=\"&lt;/\" /><text value=\"a\" class=\"name\" /><text value=\"&gt;\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Der Attributname sollte <code>href</code> sein</item><item value=\"2\" correct=\"false\">Es hat keinen Text zwischen <code>&lt;a&gt;</code> und <code>&lt;/a&gt;</code></item><item value=\"3\" correct=\"false\">Mit dem Code ist nichts falsch</item><item value=\"4\" correct=\"false\">Der öffnende Tag <code>&lt;a&gt;</code> fehlt</item></selection><p visible-if=\"wrong\">Der Attributname sollte <code>href</code> sein.</p></body></html>"
          },
          {
            "title": "Lesson #4",
            "id": 144782,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Vervollständige den Code, damit er richtig funktioniert.</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"a\" class=\"name\" /><text value=\" \" /><text value=\"href\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;https://example.com/level-1&quot;\" class=\"string\" /><text value=\"&gt;\" /><text value=\"Click to start Level 1!\" /><text value=\"&lt;/\" /><text value=\"a\" class=\"name\" /><text value=\"&gt;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"61\" endIndex=\"65\" /></interactions></code><p visible-if=\"wrong\">Gib <code>&lt;/a&gt;</code> ein.</p></body></html>"
          },
          {
            "title": "Lesson #5",
            "id": 144783,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Füge das korrekte Attribut zum öffnenden <code>&lt;a&gt;</code>-Tag hinzu.</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"h3\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Welcome to the Arcade!\" /><text value=\"&lt;/\" /><text value=\"h3\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"a\" class=\"name\" /><text value=\" \" /><text value=\"href\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;https://example.com/high-scores&quot;\" class=\"string\" /><text value=\"&gt;\" /><text value=\" Take a look at the high\" /><text type=\"break\" /><text value=\"   scores here! \" /><text value=\"&lt;/\" /><text value=\"a\" class=\"name\" /><text value=\"&gt;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"35\" endIndex=\"39\" /></interactions></code><p visible-if=\"wrong\">Gib <code>href</code> ein.</p></body></html>"
          },
          {
            "title": "Lesson #6",
            "id": 144784,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Was ist falsch an diesem <code>img</code>-Element?</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><content><text value=\"&lt;\" /><text value=\"a\" class=\"name\" /><text value=\" \" /><text value=\"src\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;https://example.com/sprites/player.png&quot;\" class=\"string\" /><text value=\"&gt;\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Der Tag sollte <code>img</code> als Tag-Name haben, nicht den <code>a</code> Tag</item><item value=\"2\" correct=\"false\">Nichts</item><item value=\"3\" correct=\"false\">Dem <code>img</code>-Element fehlt ein schließendes Tag</item><item value=\"3\" correct=\"false\">Es fehlt eine URL, um auf das Bild zuzugreifen</item></selection><p visible-if=\"wrong\">Der Tag sollte <code>img</code> als Tag-Name haben, nicht den <code>a</code> Tag.</p></body></html>"
          },
          {
            "title": "Lesson #7",
            "id": 144785,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Setze das <code>width</code>-Attribut in diesem Bild-Tag auf <code>\"300\"</code>.</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"img\" class=\"name\" /><text value=\" \" /><text value=\"src\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;/img/player-sprite.png&quot;\" class=\"string\" /><text value=\" \" /><text value=\"width\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;300&quot;\" class=\"string\" /><text value=\" \" /><text value=\"height\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;200&quot;\" class=\"string\" /><text value=\"&gt;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"40\" endIndex=\"45\" /></interactions></code><p visible-if=\"wrong\">Gib <code>\"300\"</code> ein.</p></body></html>"
          },
          {
            "title": "Lesson #8",
            "id": 144786,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Setze das <code>height</code>-Attribut dieses Bild-Tags auf <code>\"200\"</code>.</p><code version=\"2\" codelang=\"html\" name=\"index.html\" visible-if=\"always\"><content><text value=\"&lt;\" /><text value=\"img\" class=\"name\" /><text value=\" \" /><text value=\"src\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;/img/enemy-sprite.png&quot;\" class=\"string\" /><text value=\" \" /><text value=\"height\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;200&quot;\" class=\"string\" /><text value=\" \" /><text value=\"width\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;200&quot;\" class=\"string\" /><text value=\"&gt;\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"33\" endIndex=\"45\" /></interactions></code><p visible-if=\"wrong\">Gib <code>height=\"200\"</code> ein.</p></body></html>"
          },
          {
            "title": "Lesson #9",
            "id": 144787,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wie viele <code>img</code>-Elemente hat dieser Code?</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><content><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Player Sprite\" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"img\" class=\"name\" /><text value=\" \" /><text value=\"src\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;/img/player.png&quot;\" class=\"string\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"br\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"a\" class=\"name\" /><text value=\" \" /><text value=\"href\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;https://example.com/sprites&quot;\" class=\"string\" /><text value=\"&gt;\" /><text value=\"More sprites\" /><text value=\"&lt;/\" /><text value=\"a\" class=\"name\" /><text value=\"&gt;\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Eins</item><item value=\"2\" correct=\"false\">Zwei</item><item value=\"3\" correct=\"false\">Drei</item></selection><p visible-if=\"wrong\">Wähle Eins aus.</p></body></html>"
          },
          {
            "title": "Lesson #10",
            "id": 144788,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Setze die Attribute <code>height</code> und <code>width</code> so, dass die Höhe größer als die Breite ist.</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"src\" /></content></option><option correct=\"false\"><content><text value=\"href\" /></content></option><option startIndex=\"39\" endIndex=\"44\" /><option startIndex=\"51\" endIndex=\"56\" /></options></interaction></interactions><content><text value=\"&lt;\" /><text value=\"img\" class=\"name\" /><text value=\" \" /><text value=\"src\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;/img/boss-sprite.png&quot;\" class=\"string\" /><text value=\" \" /><text value=\"height\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;300&quot;\" class=\"string\" /><text value=\" \" /><text value=\"width\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;220&quot;\" class=\"string\" /><text value=\"&gt;\" /></content></code><p visible-if=\"wrong\">Wähle <code>\"300\"</code>, gefolgt von <code>\"220\"</code> aus.</p></body></html>"
          }
        ]
      }
    ]
