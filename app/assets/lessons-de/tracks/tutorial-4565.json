            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wir können das <code>address</code>-Element verwenden, um die Adresse eines Speicherpunkts beim Lesen des Codes hervorzuheben. <code>address</code> wird den Text kursiv machen.</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"&lt;p&gt;\" /></content></option><option correct=\"false\"><content><text value=\"&lt;/p&gt;\" /></content></option><option startIndex=\"187\" endIndex=\"196\" /><option startIndex=\"229\" endIndex=\"239\" /></options></interaction></interactions><content><text value=\"&lt;!DOCTYPE html&gt;\" class=\"meta\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Level Complete!\" /><text value=\"&lt;/\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Next round starts at \" /><text value=\"&lt;\" /><text value=\"time\" class=\"name\" /><text value=\"&gt;\" /><text value=\"5:00 PM\" /><text value=\"&lt;/\" /><text value=\"time\" class=\"name\" /><text value=\"&gt;\" /><text value=\".\" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Speed boost lasts \" /><text value=\"&lt;\" /><text value=\"time\" class=\"name\" /><text value=\"&gt;\" /><text value=\"2m 30s\" /><text value=\"&lt;/\" /><text value=\"time\" class=\"name\" /><text val