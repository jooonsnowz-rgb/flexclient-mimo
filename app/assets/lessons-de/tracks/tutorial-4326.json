            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wie kann ich herausfinden, welche Funktionen in einer Bibliothek verfügbar sind?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Durch das Überprüfen der Dokumentation</item><item value=\"2\" correct=\"false\">Versuch einfach dein Glück und rate</item></selection><p visible-if=\"wrong\">Durch das Überprüfen der Dokumentation.</p></body></html>"
