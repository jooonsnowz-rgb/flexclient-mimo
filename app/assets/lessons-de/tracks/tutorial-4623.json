          {
            "title": "Report a Missing Field",
            "id": 152109,
            "contentType": "executableFiles",
            "images": [],
            "executableContent": {
              "instructions": "Fange die Ausnahme wegen des fehlenden Schlüssels ab und zeige ihre Details nach *Lesen fehlgeschlagen* an.",
              "preselectedFileIndex": 0,
              "hasVisualOutput": false,
              "files": [
                {
                  "name": "script.py",
                  "codeLanguage": "python",
                  "content": "record = {\"name\": \"Ada\"}\n\ntry:\n  print(record[\"role\"])\nexcept KeyError:\n  print(\"Read failed\")\n",
                  "solvedContent": "record = {\"name\": \"Ada\"}\n\ntry:\n  print(record[\"role\"])\nexcept KeyError as error:\n  print(\"Read failed\", error)\n"
                }
              ],
              "hints": []
            }
