          {
            "title": "Repair the Price Import",
            "id": 152108,
            "contentType": "executableFiles",
            "images": [],
            "executableContent": {
              "instructions": "Ersetze den allgemeinen Handler durch separate Handler für einen ungültigen Preis (`ValueError`) und eine Artikelanzahl von null (`ZeroDivisionError`). Zeige in beiden `except`-Blöcken passende Fehlermeldungen an.",
              "preselectedFileIndex": 0,
              "hasVisualOutput": false,
              "files": [
                {
                  "name": "script.py",
                  "codeLanguage": "python",
                  "content": "price_text = \"free\"\nitems = 2\n\ntry:\n price = float(price_text)\n share = price / items\nexcept:\n  print(\"Import failed\")\n",
                  "solvedContent": "price_text = \"free\"\nitems = 2\n\ntry:\n price = float(price_text)\n share = price / items\nexcept ValueError:\n  print(\"Enter a numeric price\")\nexcept ZeroDivisionError:\n  print(\"Add at least one item\")\n"
                }
              ],
              "hints": []
            }
