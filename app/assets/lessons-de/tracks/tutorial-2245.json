            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Lass diesen Code-Schnipsel jedes Element im <code>supplies</code>-Array anzeigen.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" supplies = [\" /><text value=\"&quot;pencil&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;book&quot;\" class=\"string\" /><text value=\"];\" /><text type=\"break\" /><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"0\" class=\"number\" /><text value=\"; i &lt; supplies.length; i++) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(supplies[i]);\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"103\" endIndex=\"104\" /><option correct=\"false\"><content><text value=\"0\" /></content></option><option correct=\"false\"><content><text value=\"2\" /></content></option></options></interaction></interactions><output><content><text value=\"pencil\" /><text type=\"break\" /><text value=\"book\" /></content></output></code><p visible-if=\"wrong\">Wähle <code>i</code> aus.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Lass diesen Code-Schnipsel jedes Element im <code>supplies</code>-Array anzeigen.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" supplies = [\" /><text value=\"&quot;pencil&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;book&quot;\" class=\"string\" /><text value=\"];\" /><text type=\"break\" /><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"0\" class=\"number\" /><text value=\"; i &lt; supplies.length; i++) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(supplies[i]);\" /><text type=\"break\" /><text value=\"}\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"103\" endIndex=\"104\" /><option startIndex=\"66\" endIndex=\"72\" /><option correct=\"false\"><content><text value=\"0\" /></content></option><option correct=\"false\"><content><text value=\"2\" /></content></option><option correct=\"false\"><content><text value=\"push\" /></content></option><option correct=\"false\"><content><text value=\"pop\" /></content></option></options></interaction></interactions><output><content><text value=\"pencil\" /><text type=\"break\" /><text value=\"book\" /></content></output></code><p visible-if=\"wrong\">Wähle <code>length</code>, gefolgt von <code>i</code> aus.</p></body></html>",
