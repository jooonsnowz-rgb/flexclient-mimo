            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wie viele Elemente enthält ein leeres Array?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>0</code></item><item value=\"2\" correct=\"false\"><code>1</code></item><item value=\"3\" correct=\"false\"><code>2</code></item></selection><p visible-if=\"wrong\">Wähle <code>0</code> aus.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Ein Warenkorb beginnt als <code>[]</code>, ohne Inhalt zwischen seinen Klammern. Welche Länge hat er?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>0</code></item><item value=\"2\" correct=\"false\"><code>1</code></item><item value=\"3\" correct=\"false\"><code>2</code></item><item value=\"4\" correct=\"false\"><code>undefined</code>, weil kein erstes Element existiert</item></selection><p visible-if=\"wrong\">Wähle <code>0</code> aus.</p></body></html>"
