            "id": 148009,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Rufe die <code>spawnEnemies()</code>-Funktion auf und übergebe den Wert <code>5</code>.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"82\" endIndex=\"94\" /><option startIndex=\"95\" endIndex=\"96\" /></options></interaction></interactions><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"spawnEnemies\" class=\"title\" /><text value=\"(\" /><text value=\"count\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" result = count * \" /><text value=\"2\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(result);\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"spawnEnemies(\" /><text value=\"5\" class=\"number\" /><text value=\");\" /></content></code><p visible-if=\"wrong\">Wähle <code>spawnEnemies</code>, gefolgt von <code>5</code> aus.</p></body></html>"
