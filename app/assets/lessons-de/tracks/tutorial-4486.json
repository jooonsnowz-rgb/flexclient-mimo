            "interactiveContent": "<!DOCTYPE html ><html><body><p>Welche Elemente müssen wir identifizieren, wenn wir ein Element aus einem anderen entfernen wollen?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Das Elternelement und das Kindelement</item><item value=\"2\" correct=\"false\">Nur das Kindelement</item></selection><p visible-if=\"wrong\">Das Elternelement und das Kindelement.</p></body></html>"
