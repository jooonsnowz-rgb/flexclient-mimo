            "interactiveContent": "<!DOCTYPE html ><html><body><p>Welche Anweisung ermöglicht es uns, auf ein Element <strong>zuzugreifen</strong>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>document.getElementById()</code></item><item value=\"2\" correct=\"false\"><code>removeChild()</code></item></selection><p visible-if=\"wrong\">Wähle <code>document.getElementById()</code> aus.</p></body></html>"
