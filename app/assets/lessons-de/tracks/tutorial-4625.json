                {
                  "name": "script.py",
                  "codeLanguage": "python",
                  "content": "def process_booking(booking):\n  try:\n    seats = int(booking[\"seats\"])\n    return seats * booking[\"price\"]\n  except ValueError:\n    pass\n",
                  "solvedContent": "def process_booking(booking):\n  try:\n    seats = int(booking[\"seats\"])\n  except ValueError:\n    return None\n  return seats * booking[\"price\"]\n"
