            "id": 74327,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Rufe die <code>addTen()</code> Funktion mit einem Wert auf.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"addTen\" class=\"title\" /><text value=\"(\" /><text value=\"number\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" addedTen = \" /><text value=\"10\" class=\"number\" /><text value=\" + number;\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" addedTen;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(addTen(\" /><text value=\"20\" class=\"number\" /><text value=\"));\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"89\" endIndex=\"95\" /><option startIndex=\"95\" endIndex=\"96\" /><option startIndex=\"96\" endIndex=\"98\" /><option startIndex=\"98\" endIndex=\"99\" /></options></interaction></interactions><output><content><text value=\"30\" /></content></output></code><p visible-if=\"wrong\">Wähle <code>addTen</code>, gefolgt von <code>(</code> und schließlich <code>20</code>, <code>)</code> aus.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Rufe <code>addTen</code> mit dem Wert auf, durch den die Konsole <code>30</code> ausgibt.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"addTen\" class=\"title\" /><text value=\"(\" /><text value=\"number\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" addedTen = \" /><text value=\"10\" class=\"number\" /><text value=\" + number;\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" addedTen;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(addTen(\" /><text value=\"20\" class=\"number\" /><text value=\"));\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"89\" endIndex=\"95\" /><option startIndex=\"95\" endIndex=\"96\" /><option startIndex=\"96\" endIndex=\"98\" /><option startIndex=\"98\" endIndex=\"99\" /><option correct=\"false\"><content><text value=\"addedTen\" /></content></option><option correct=\"false\"><content><text value=\"10\" /></content></option><option correct=\"false\"><content><text value=\"30\" /></content></option></options></interaction></interactions><output><content><text value=\"30\" /></content></output></code><p visible-if=\"wrong\">Wähle <code>addTen</code>, gefolgt von <code>(</code>, <code>20</code> und schließlich <code>)</code> aus.</p></body></html>",
