            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Gib einen einzelnen Wert von dieser Funktion zurück.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"lessThanFive\" class=\"title\" /><text value=\"(\" /><text value=\"number\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" lessThan = number &lt; \" /><text value=\"5\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" lessThan;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" result = lessThanFive(\" /><text value=\"10\" class=\"number\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(result);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"63\" endIndex=\"69\" /><option startIndex=\"70\" endIndex=\"78\" /><option startIndex=\"78\" endIndex=\"79\" /><option correct=\"false\"><content><text value=\"var\" /></content></option></options></interaction></interactions><output><content><text value=\"false\" /></content></output></code><p visible-if=\"wrong\">Wähle <code>return</code>, gefolgt von <code>lessThan</code> und schließlich <code>;</code> aus.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Gib den einzelnen Boolean zurück, den diese Funktion berechnet.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"lessThanFive\" class=\"title\" /><text value=\"(\" /><text value=\"number\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" lessThan = number &lt; \" /><text value=\"5\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" lessThan;\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text value=\"const\" class=\"keyword\" /><text value=\" result = lessThanFive(\" /><text value=\"10\" class=\"number\" /><text value=\");\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(result);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"63\" endIndex=\"69\" /><option startIndex=\"70\" endIndex=\"78\" /><option startIndex=\"78\" endIndex=\"79\" /><option correct=\"false\"><content><text value=\"number\" /></content></option><option correct=\"false\"><content><text value=\"result\" /></content></option><option correct=\"false\"><content><text value=\"var\" /></content></option></options></interaction></interactions><output><content><text value=\"false\" /></content></output></code><p visible-if=\"wrong\">Wähle <code>return</code>, gefolgt von <code>lessThan</code> und schließlich <code>;</code> aus.</p></body></html>",
