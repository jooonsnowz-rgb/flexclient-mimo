            "hardModeContent": "<!DOCTYPE html ><html><body><p>Vervollständige den expliziten Fallback für eine ungültige Elementanzahl.</p><code version=\"2\" codelang=\"python\" name=\"count_parser.py\" visible-if=\"always\"><content><text value=\"def\" class=\"keyword\" /><text value=\" \" /><text value=\"parse_count\" class=\"title\" /><text value=\"(value)\" class=\"params\" /><text value=\":\" /><text type=\"break\" /><text value=\"  \" /><text value=\"try\" class=\"keyword\" /><text value=\":\" /><text type=\"break\" /><text value=\"    \" /><text value=\"return\" class=\"keyword\" /><text value=\" int(value)\" /><text type=\"break\" /><text value=\"  \" /><text value=\"except\" class=\"keyword\" /><text value=\" ValueError:\" /><text type=\"break\" /><text value=\"    \" /><text value=\"return\" class=\"keyword\" /><text value=\" \" /><text value=\"None\" class=\"literal\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"85\" endIndex=\"89\" /><option startIndex=\"78\" endIndex=\"84\" /><option correct=\"false\"><content><text value=\"pass\" /></content></option><option correct=\"false\"><content><text value=\"result\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Wähle <code>return</code>, gefolgt von <code>None</code> aus.</p></body></html>"
