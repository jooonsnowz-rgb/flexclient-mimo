            "interactiveContent": "<!DOCTYPE html ><html><body><p>Verwende <code>details</code> und <code>summary</code>, um den längeren Absatz des Feindberichts zu verbergen und nur die Titelüberschrift anzuzeigen.</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"63\" endIndex=\"72\" /><option startIndex=\"76\" endIndex=\"85\" /><option startIndex=\"131\" endIndex=\"141\" /><option startIndex=\"272\" endIndex=\"282\" /></options></interaction></interactions><content><text value=\"&lt;!DOCTYPE html&gt;\" class=\"meta\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Enemy Report Board\" /><text value=\"&lt;/\" /><text value=\"h1\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"details\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"   \" /><text value=\"&lt;\" /><text value=\"summary\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"   \" /><text value=\"&lt;\" /><text value=\"h2\" class=\"name\" /><text value=\"&gt;\" /><text value=\"1020 - Slime hitbox feels off\" /><text value=\"&lt;/\" /><text value=\"h2\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"   \" /><text value=\"&lt;/\" /><text value=\"summary\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"   \" /><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text value=\"When the player swings the sword, the slime sometimes takes no damage. It is supposed t