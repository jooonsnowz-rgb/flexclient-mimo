            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wie oft können wir den Wert einer Variable ändern?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">So oft wir wollen</item><item correct=\"false\" value=\"2\">Nur einmal</item><item correct=\"false\" value=\"2\">Niemals</item></selection><p visible-if=\"wrong\">So oft wir wollen.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Ein Programm führt <code>points = 4</code> aus und später <code>points = 8</code>. Was stimmt über <code>points</code>?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Es speichert jetzt <code>8</code></item><item value=\"2\" correct=\"false\">Es speichert weiterhin nur <code>4</code></item><item value=\"3\" correct=\"false\">Python lässt den Wert nicht ändern</item></selection><p visible-if=\"wrong\">Wähle Es speichert jetzt <code>8</code> aus.</p></body></html>"
