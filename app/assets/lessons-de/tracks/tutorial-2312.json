            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wofür ist das <code>=</code>-Zeichen?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">Es weist einer Variable einen Wert zu</item><item correct=\"false\" value=\"2\">Es fügt String-Werte zusammen</item><item correct=\"false\" value=\"3\">Es teilt eine Zahl durch eine andere Zahl</item></selection><p visible-if=\"wrong\">Es weist einer Variable einen Wert zu.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Was macht das <code>=</code>-Zeichen in <code>score = 9</code>?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Es speichert <code>9</code> in <code>score</code></item><item value=\"2\" correct=\"false\">Es zeigt <code>9</code> in der Konsole an</item><item value=\"3\" correct=\"false\">Es verbindet <code>score</code> und <code>9</code></item></selection><p visible-if=\"wrong\">Wähle Es speichert <code>9</code> in <code>score</code> aus.</p></body></html>"
