            "interactiveContent": "<!DOCTYPE html ><html><body><p>Warum ist <code>first name</code> kein gültiger Variablenname?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">Weil es ein Leerzeichen zwischen <code>first</code> und <code>name</code> enthält</item><item correct=\"false\" value=\"2\">Weil beide Wörter großgeschrieben werden müssen</item><item correct=\"false\" value=\"2\">Weil es nicht beschreibend ist</item></selection><p visible-if=\"wrong\">Weil es ein Leerzeichen zwischen <code>first</code> und <code>name</code> enthält.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Du schreibst <code>first name = \"Ada\"</code> für den Vornamen einer Person. Warum ist <code>first name</code> kein gültiger Variablenname?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Weil es ein Leerzeichen zwischen <code>first</code> und <code>name</code> enthält</item><item value=\"2\" correct=\"false\">Weil das erste Wort einen Großbuchstaben braucht</item><item value=\"3\" correct=\"false\">Weil der Name zu beschreibend ist</item></selection><p visible-if=\"wrong\">Weil es ein Leerzeichen zwischen <code>first</code> und <code>name</code> enthält.</p></body></html>"
