            "interactiveContent": "<!DOCTYPE html ><html><body><p>Aktualisiere die <code>average_rating</code> Variable.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"average_rating = \" /><text value=\"25\" class=\"number\" /><text type=\"break\" /><text value=\"average_rating = \" /><text value=\"5\" class=\"number\" /><text type=\"break\" /><text value=\"print(average_rating)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"20\" endIndex=\"34\" /><option startIndex=\"35\" endIndex=\"36\" /><option startIndex=\"37\" endIndex=\"38\" /><option correct=\"false\"><content><text value=\"rating\" /></content></option></options></interaction></interactions><output><content><text value=\"5\" /></content></output></code><p visible-if=\"wrong\">Wähle <code>average_rating</code>, gefolgt von <code>=</code> und schließlich <code>5</code> aus.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Ändere <code>average_rating</code>, damit die Konsole <code>5</code> statt des ersten Werts ausgibt.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"average_rating = \" /><text value=\"25\" class=\"number\" /><text type=\"break\" /><text value=\"average_rating = \" /><text value=\"5\" class=\"number\" /><text type=\"break\" /><text value=\"print(average_rating)\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"20\" endIndex=\"34\" /><option startIndex=\"35\" endIndex=\"36\" /><option startIndex=\"37\" endIndex=\"38\" /><option correct=\"false\"><content><text value=\"==\" /></content></option><option correct=\"false\"><content><text value=\"25\" /></content></option></options></interaction></interactions><output><content><text value=\"5\" /></content></output></code><p visible-if=\"wrong\">Wähle <code>average_rating</code>, gefolgt von <code>=</code> und schließlich <code>5</code> aus.</p></body></html>",
