            "interactiveContent": "<!DOCTYPE html ><html><body><p>Verwende <code>thing_id</code> als Routenparameter in der Thing-URL.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"thing_id = \" /><text value=\"12\" class=\"number\" /><text type=\"break\" /><text value=\"url = \" /><text value=\"f&quot;https://things.mimo.dev/api/things/\" /><text value=\"{thing_id}\" class=\"subst\" /><text value=\"&quot;\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"57\" endIndex=\"67\" /><option correct=\"false\"><content><text value=\"?id=thing_id\" /></content></option><option correct=\"false\"><content><text value=\"{12}\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Wähle <code>{thing_id}</code> aus.</p></body></html>",
