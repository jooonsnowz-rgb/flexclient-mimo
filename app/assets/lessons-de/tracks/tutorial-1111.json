            "interactiveContent": "<!DOCTYPE html ><html><body><p>Zeige <code>False</code> in der Konsole an.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"print(\" /><text value=\"10\" class=\"number\" /><text value=\" == \" /><text value=\"13\" class=\"number\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"12\" endIndex=\"14\" /><option correct=\"false\"><content><text value=\"10\" /></content></option></options></interaction></interactions><output><content><text value=\"False\" /></content></output></code><p visible-if=\"wrong\">Wähle <code>13</code> aus.</p></body></html>",
