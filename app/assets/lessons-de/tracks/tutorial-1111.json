            "hardModeContent": "<!DOCTYPE html ><html><body><p>Füge den Operator hinzu, der die zwei Zahlen vergleicht, damit der Code <code>False</code> ausgibt.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"print(\" /><text value=\"99\" class=\"number\" /><text value=\" == \" /><text value=\"100\" class=\"number\" /><text value=\")\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"9\" endIndex=\"11\" /><option correct=\"false\"><content><text value=\"=\" /></content></option><option correct=\"false\"><content><text value=\"===\" /></content></option></options></interaction></interactions><output><content><text value=\"False\" /></content></output></code><p visible-if=\"wrong\">Wähle <code>==</code> aus.</p></body></html>"
