            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Einer der wichtigsten Teile eines Spiel-HUDs ist der Text. Wir können den Text auf viele Arten ändern, von der Größe bis zum Stil oder der Dicke.</p><webview version=\"2\" content=\"&lt;!doctype html&gt;&#xA;&lt;html&gt;&#xA; &lt;head&gt;&#xA;  &lt;style&gt;&#xA;  &lt;/style&gt;&#xA; &lt;/head&gt;&#xA; &lt;body&gt;&#xA;  &lt;p style=&quot;font-family: Courier New;&quot;&gt;Score: 1200&lt;/p&gt;&#xA;  &lt;p style=&quot;font-style: italic;&quot;&gt;Quest: Find the key&lt;/p&gt;&#xA;  &lt;p style=&quot;font-weight: bold;&quot;&gt;BOSS INCOMING&lt;/p&gt;&#xA;  &lt;p style=&quot;font-style: italic;font-weight: bold;&quot;&gt;Critical Hit!&#xA;   +50&lt;/p&gt;&#xA;  &lt;p style=&quot;font-size: 24px;&quot;&gt;LEVEL UP!&lt;/p&gt;&#xA;  &lt;p style=&quot;font-size: 8px;&quot;&gt;Tip: Press R to reload&lt;/p&gt;&#xA; &lt;/body&gt;&#xA;&lt;/html&gt;\" /></body></html>"
