            "hardModeContent": "<!DOCTYPE html ><html><body><p>Speichere den Wert <code>\"1001\"</code> in die Variable <code>result</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" result = \" /><text value=\"&quot;100&quot;\" class=\"string\" /><text value=\" + \" /><text value=\"1\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(result);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"15\" endIndex=\"20\" /><option startIndex=\"21\" endIndex=\"22\" /><option startIndex=\"23\" endIndex=\"24\" /><option correct=\"false\"><content><text value=\"100\" /></content></option><option correct=\"false\"><content><text value=\"200\" /></content></option><option correct=\"false\"><content><text value=\"===\" /></content></option><option correct=\"false\"><content><text value=\"==\" /></content></option></options></interaction></interactions><output><content><text value=\"1001\" /></content></output></code><p visible-if=\"wrong\">Wähle <code>\"100\"</code>, gefolgt von <code>+</code> und schließlich <code>1</code> aus.</p></body></html>",
