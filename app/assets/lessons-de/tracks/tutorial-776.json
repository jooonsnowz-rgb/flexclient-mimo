          {
            "title": "Intro 1",
            "id": 73661,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Lass uns tiefer in die Werte eintauchen, die ein Array speichern kann, und wie wir sie aktualisieren können. So wie eine Wetter-App möglicherweise Temperaturen verfolgt.</p><webview version=\"2\" visible-if=\"always\" content=\"&lt;!DOCTYPE html&gt;&#xA;&lt;html lang=&quot;en&quot;&gt;&#xA;&lt;head&gt;&#xA;    &lt;meta charset=&quot;UTF-8&quot;&gt;&#xA;    &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;&#xA;    &lt;title&gt;Weather App&lt;/title&gt;&#xA;    &lt;style&gt;&#xA;        body {&#xA;            font-family: Arial, sans-serif;&#xA;            display: flex;&#xA;            justify-content: center;&#xA;            align-items: center;&#xA;            margin: 24px auto;&#xA;            background: url('background-image.jpg') no-repeat center center;&#xA;            background-size: cover;&#xA;            color: #fff;&#xA;        }&#xA;        .weather-container {&#xA;            background-color: #1e90ff;&#xA;            border-radius: 10px;&#xA;            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);&#xA;            padding: 20px;&#xA;            width: 300px;&#xA;            text-align: center;&#xA;        }&#xA;        .weather-header {&#xA;            font-size: 24px;&#xA;            margin-bottom: 20px;&#xA;        }&#xA;        .weather-days {&#xA;            display: flex;&#xA;            justify-content: space-around;&#xA;            margin-bottom: 20px;&#xA;        }&#xA;        .weather-day {&#xA;            cursor: pointer;&#xA;            padding: 10px;&#xA;            background-color: rgba(255, 255, 255, 0.2);&#xA;        }&#xA;        .weather-day.active {&#xA;            background-color: rgba(255, 255, 255, 0.4);&#xA;        }&#xA;        .weather-forecast {&#xA;            font-size: 16px;&#xA;        }&#xA;        .weather-forecast .time {&#xA;            display: flex;&#xA;            justify-content: space-between;&#xA;            margin-bottom: 10px;&#xA;        }&#xA;        .weather-forecast .time div {&#xA;            flex: 1;&#xA;            text-align: center;&#xA;        }&#xA;    &lt;/style&gt;&#xA;&lt;/head&gt;&#xA;&lt;body&gt;&#xA;    &lt;div class=&quot;weather-container&quot;&gt;&#xA;        &lt;div class=&quot;weather-header&quot;&gt;New York&lt;/div&gt;&#xA;        &lt;div class=&quot;weather-days&quot;&gt;&#xA;            &lt;div class=&quot;weather-day active&quot; data-day=&quot;1&quot;&gt;🌞 Fri, June 1&lt;/div&gt;&#xA;            &lt;div class=&quot;weather-day&quot; data-day=&quot;2&quot;&gt;🌧️ Sat, June 2&lt;/div&gt;&#xA;            &lt;div class=&quot;weather-day&quot; data-day=&quot;3&quot;&gt;⛅ Sun, June 3&lt;/div&gt;&#xA;        &lt;/div&gt;&#xA;        &lt;div class=&quot;weather-forecast&quot;&gt;&#xA;            &lt;div class=&quot;time&quot; data-day=&quot;1&quot;&gt;&#xA;                &lt;div&gt;17°&lt;br&gt;9:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;20°&lt;br&gt;12:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;26°&lt;br&gt;15:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;24°&lt;br&gt;18:00 🌤️&lt;/div&gt;&#xA;                &lt;div&gt;20°&lt;br&gt;21:00 🌙&lt;/div&gt;&#xA;                &lt;div&gt;16°&lt;br&gt;00:00 🌙&lt;/div&gt;&#xA;            &lt;/div&gt;&#xA;            &lt;div class=&quot;time&quot; data-day=&quot;2&quot; style=&quot;display: none;&quot;&gt;&#xA;                &lt;div&gt;18°&lt;br&gt;9:00 ☁️&lt;/div&gt;&#xA;                &lt;div&gt;22°&lt;br&gt;12:00 🌧️&lt;/div&gt;&#xA;                &lt;div&gt;27°&lt;br&gt;15:00 🌧️&lt;/div&gt;&#xA;                &lt;div&gt;25°&lt;br&gt;18:00 ☁️&lt;/div&gt;&#xA;                &lt;div&gt;21°&lt;br&gt;21:00 🌙&lt;/div&gt;&#xA;                &lt;div&gt;17°&lt;br&gt;00:00 🌙&lt;/div&gt;&#xA;            &lt;/div&gt;&#xA;            &lt;div class=&quot;time&quot; data-day=&quot;3&quot; style=&quot;display: none;&quot;&gt;&#xA;                &lt;div&gt;19°&lt;br&gt;9:00 ⛅&lt;/div&gt;&#xA;                &lt;div&gt;23°&lt;br&gt;12:00 ⛅&lt;/div&gt;&#xA;                &lt;div&gt;28°&lt;br&gt;15:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;26°&lt;br&gt;18:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;22°&lt;br&gt;21:00 🌙&lt;/div&gt;&#xA;                &lt;div&gt;18°&lt;br&gt;00:00 🌙&lt;/div&gt;&#xA;            &lt;/div&gt;&#xA;        &lt;/div&gt;&#xA;    &lt;/div&gt;&#xA;&#xA;    &lt;script&gt;&#xA;        document.addEventListener('DOMContentLoaded', function() {&#xA;            const days = document.querySelectorAll('.weather-day');&#xA;            const forecasts = document.querySelectorAll('.weather-forecast .time');&#xA;&#xA;            days.forEach(day =&gt; {&#xA;                day.addEventListener('click', function() {&#xA;                    days.forEach(d =&gt; d.classList.remove('active'));&#xA;                    this.classList.add('active');&#xA;&#xA;                    const day = this.getAttribute('data-day');&#xA;                    forecasts.forEach(forecast =&gt; {&#xA;                        if (forecast.getAttribute('data-day') === day) {&#xA;                            forecast.style.display = 'flex';&#xA;                        } else {&#xA;                            forecast.style.display = 'none';&#xA;                        }&#xA;                    });&#xA;                });&#xA;            });&#xA;        });&#xA;    &lt;/script&gt;&#xA;&lt;/body&gt;&#xA;&lt;/html&gt;\" /></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Intro 2",
            "id": 73679,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Ein Array kann verschiedene Temperaturwerte speichern und wird aktualisiert, sobald im Laufe des Tages neue Daten von Wetterstationen eingehen.</p><webview version=\"2\" visible-if=\"always\" content=\"&lt;!DOCTYPE html&gt;&#xA;&lt;html lang=&quot;en&quot;&gt;&#xA;&lt;head&gt;&#xA;    &lt;meta charset=&quot;UTF-8&quot;&gt;&#xA;    &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;&#xA;    &lt;title&gt;Weather App&lt;/title&gt;&#xA;    &lt;style&gt;&#xA;        body {&#xA;            font-family: Arial, sans-serif;&#xA;            display: flex;&#xA;            justify-content: center;&#xA;            align-items: center;&#xA;            margin: 24px auto;&#xA;            background: url('background-image.jpg') no-repeat center center;&#xA;            background-size: cover;&#xA;            color: #fff;&#xA;        }&#xA;        .weather-container {&#xA;            background-color: #1e90ff;&#xA;            border-radius: 10px;&#xA;            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);&#xA;            padding: 20px;&#xA;            width: 300px;&#xA;            text-align: center;&#xA;        }&#xA;        .weather-header {&#xA;            font-size: 24px;&#xA;            margin-bottom: 20px;&#xA;        }&#xA;        .weather-days {&#xA;            display: flex;&#xA;            justify-content: space-around;&#xA;            margin-bottom: 20px;&#xA;        }&#xA;        .weather-day {&#xA;            cursor: pointer;&#xA;            padding: 10px;&#xA;            background-color: rgba(255, 255, 255, 0.2);&#xA;        }&#xA;        .weather-day.active {&#xA;            background-color: rgba(255, 255, 255, 0.4);&#xA;        }&#xA;        .weather-forecast {&#xA;            font-size: 16px;&#xA;        }&#xA;        .weather-forecast .time {&#xA;            display: flex;&#xA;            justify-content: space-between;&#xA;            margin-bottom: 10px;&#xA;        }&#xA;        .weather-forecast .time div {&#xA;            flex: 1;&#xA;            text-align: center;&#xA;        }&#xA;    &lt;/style&gt;&#xA;&lt;/head&gt;&#xA;&lt;body&gt;&#xA;    &lt;div class=&quot;weather-container&quot;&gt;&#xA;        &lt;div class=&quot;weather-header&quot;&gt;New York&lt;/div&gt;&#xA;        &lt;div class=&quot;weather-days&quot;&gt;&#xA;            &lt;div class=&quot;weather-day active&quot; data-day=&quot;1&quot;&gt;🌞 Fri, June 1&lt;/div&gt;&#xA;            &lt;div class=&quot;weather-day&quot; data-day=&quot;2&quot;&gt;🌧️ Sat, June 2&lt;/div&gt;&#xA;            &lt;div class=&quot;weather-day&quot; data-day=&quot;3&quot;&gt;⛅ Sun, June 3&lt;/div&gt;&#xA;        &lt;/div&gt;&#xA;        &lt;div class=&quot;weather-forecast&quot;&gt;&#xA;            &lt;div class=&quot;time&quot; data-day=&quot;1&quot;&gt;&#xA;                &lt;div&gt;17°&lt;br&gt;9:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;20°&lt;br&gt;12:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;26°&lt;br&gt;15:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;24°&lt;br&gt;18:00 🌤️&lt;/div&gt;&#xA;                &lt;div&gt;20°&lt;br&gt;21:00 🌙&lt;/div&gt;&#xA;                &lt;div&gt;16°&lt;br&gt;00:00 🌙&lt;/div&gt;&#xA;            &lt;/div&gt;&#xA;            &lt;div class=&quot;time&quot; data-day=&quot;2&quot; style=&quot;display: none;&quot;&gt;&#xA;                &lt;div&gt;18°&lt;br&gt;9:00 ☁️&lt;/div&gt;&#xA;                &lt;div&gt;22°&lt;br&gt;12:00 🌧️&lt;/div&gt;&#xA;                &lt;div&gt;27°&lt;br&gt;15:00 🌧️&lt;/div&gt;&#xA;                &lt;div&gt;25°&lt;br&gt;18:00 ☁️&lt;/div&gt;&#xA;                &lt;div&gt;21°&lt;br&gt;21:00 🌙&lt;/div&gt;&#xA;                &lt;div&gt;17°&lt;br&gt;00:00 🌙&lt;/div&gt;&#xA;            &lt;/div&gt;&#xA;            &lt;div class=&quot;time&quot; data-day=&quot;3&quot; style=&quot;display: none;&quot;&gt;&#xA;                &lt;div&gt;19°&lt;br&gt;9:00 ⛅&lt;/div&gt;&#xA;                &lt;div&gt;23°&lt;br&gt;12:00 ⛅&lt;/div&gt;&#xA;                &lt;div&gt;28°&lt;br&gt;15:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;26°&lt;br&gt;18:00 ☀️&lt;/div&gt;&#xA;                &lt;div&gt;22°&lt;br&gt;21:00 🌙&lt;/div&gt;&#xA;                &lt;div&gt;18°&lt;br&gt;00:00 🌙&lt;/div&gt;&#xA;            &lt;/div&gt;&#xA;        &lt;/div&gt;&#xA;    &lt;/div&gt;&#xA;&#xA;    &lt;script&gt;&#xA;        document.addEventListener('DOMContentLoaded', function() {&#xA;            const days = document.querySelectorAll('.weather-day');&#xA;            const forecasts = document.querySelectorAll('.weather-forecast .time');&#xA;&#xA;            days.forEach(day =&gt; {&#xA;                day.addEventListener('click', function() {&#xA;                    days.forEach(d =&gt; d.classList.remove('active'));&#xA;                    this.classList.add('active');&#xA;&#xA;                    const day = this.getAttribute('data-day');&#xA;                    forecasts.forEach(forecast =&gt; {&#xA;                        if (forecast.getAttribute('data-day') === day) {&#xA;                            forecast.style.display = 'flex';&#xA;                        } else {&#xA;                            forecast.style.display = 'none';&#xA;                        }&#xA;                    });&#xA;                });&#xA;            });&#xA;        });&#xA;    &lt;/script&gt;&#xA;&lt;/body&gt;&#xA;&lt;/html&gt;\" /></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Any value",
            "id": 73662,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Stell dir ein Array wie eine Kommode vor. Eine Schublade kann jede Variable oder jeden Wert speichern, sei es ein String, Boolean oder eine Zahl wie <code>17</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" temperatures = [\" /><text value=\"17\" class=\"number\" /><text value=\", \" /><text value=\"20\" class=\"number\" /><text value=\", \" /><text value=\"26\" class=\"number\" /><text value=\", \" /><text value=\"24\" class=\"number\" /><text value=\"];\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"22\" endIndex=\"24\" /><option correct=\"false\"><content><text value=\"&quot;17&quot;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Wähle <code>17</code> aus.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Index",
            "id": 73663,
            "contentType": "interactive",
            "images": [
              {
                "id": "841bb221-569c-4748-ab76-f5261dcadd13"
              }
            ],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Jedes Element in einem Array hat eine nummerierte Position, die als Index bezeichnet wird.</p><img src=\"841bb221-569c-4748-ab76-f5261dcadd13\" visible-if=\"always\" /></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Start at zero",
            "id": 73665,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Indizes beginnen bei 0 und erhöhen sich mit jedem weiteren Wert. Das bedeutet, dass das zweite Element in <code>temperatures</code> an Index <code>1</code> ist. Code diesen Index.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" temperatures = [\" /><text value=\"17\" class=\"number\" /><text value=\", \" /><text value=\"20\" class=\"number\" /><text value=\", \" /><text value=\"26\" class=\"number\" /><text value=\", \" /><text value=\"24\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(temperatures[\" /><text value=\"1\" class=\"number\" /><text value=\"]);\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"64\" endIndex=\"65\" /></interactions><output><content><text value=\"20\" /></content></output></code><p visible-if=\"wrong\">Gib <code>1</code> ein.</p></body></html>"
          },
          {
            "title": "Access element",
            "id": 73666,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Um auf ein Element wie <code>26</code> zuzugreifen, schreibe den Array-Namen <code>temperatures</code> gefolgt vom Index des Elements in eckigen Klammern <code>[2]</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" temperatures = [\" /><text value=\"17\" class=\"number\" /><text value=\", \" /><text value=\"20\" class=\"number\" /><text value=\", \" /><text value=\"26\" class=\"number\" /><text value=\", \" /><text value=\"24\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(temperatures[\" /><text value=\"2\" class=\"number\" /><text value=\"]);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"51\" endIndex=\"63\" /><option startIndex=\"63\" endIndex=\"64\" /><option startIndex=\"64\" endIndex=\"65\" /><option startIndex=\"65\" endIndex=\"66\" /><option correct=\"false\"><content><text value=\"3\" /></content></option></options></interaction></interactions><output><content><text value=\"26\" /></content></output></code><p visible-if=\"wrong\">Wähle <code>temperatures</code>, gefolgt von <code>[</code> und schließlich <code>2</code>, <code>]</code> aus.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Für ein Element wie <code>26</code> folgt auf <code>temperatures</code> sein Index in eckigen Klammern, etwa <code>[2]</code>. Gib den dritten Wert aus.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" temperatures = [\" /><text value=\"17\" class=\"number\" /><text value=\", \" /><text value=\"20\" class=\"number\" /><text value=\", \" /><text value=\"26\" class=\"number\" /><text value=\", \" /><text value=\"24\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(temperatures[\" /><text value=\"2\" class=\"number\" /><text value=\"]);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"51\" endIndex=\"63\" /><option startIndex=\"63\" endIndex=\"64\" /><option startIndex=\"64\" endIndex=\"65\" /><option startIndex=\"65\" endIndex=\"66\" /><option correct=\"false\"><content><text value=\"3\" /></content></option><option correct=\"false\"><content><text value=\"1\" /></content></option><option correct=\"false\"><content><text value=\"temperatures[2]\" /></content></option></options></interaction></interactions><output><content><text value=\"26\" /></content></output></code><p visible-if=\"wrong\">Wähle <code>temperatures</code>, gefolgt von <code>[</code>, <code>2</code> und schließlich <code>]</code> aus.</p></body></html>"
          },
          {
            "title": "Change value",
            "id": 73668,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Um den Temperaturwert am zweiten Index zu aktualisieren, greife darauf über <code>temperatures[2]</code> zu und verwende dann <code>=</code>, um ihm einen neuen Wert wie <code>25</code> zuzuweisen.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" temperatures = [\" /><text value=\"17\" class=\"number\" /><text value=\", \" /><text value=\"20\" class=\"number\" /><text value=\", \" /><text value=\"26\" class=\"number\" /><text value=\", \" /><text value=\"24\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"temperatures[\" /><text value=\"2\" class=\"number\" /><text value=\"] = \" /><text value=\"25\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(temperatures);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"39\" endIndex=\"54\" /><option startIndex=\"55\" endIndex=\"56\" /><option startIndex=\"57\" endIndex=\"59\" /><option correct=\"false\"><content><text value=\"3\" /></content></option></options></interaction></interactions><output><content><text value=\"[ 17, 20, 25, 24 ]\" /></content></output></code><p visible-if=\"wrong\">Wähle <code>temperatures[2]</code>, gefolgt von <code>=</code> und schließlich <code>25</code> aus.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Greife mit <code>temperatures[2]</code> auf den dritten Temperaturwert zu und weise ihm mit <code>=</code> den Wert <code>25</code> zu.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" temperatures = [\" /><text value=\"17\" class=\"number\" /><text value=\", \" /><text value=\"20\" class=\"number\" /><text value=\", \" /><text value=\"26\" class=\"number\" /><text value=\", \" /><text value=\"24\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"temperatures[\" /><text value=\"2\" class=\"number\" /><text value=\"] = \" /><text value=\"25\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(temperatures);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"39\" endIndex=\"54\" /><option startIndex=\"19\" endIndex=\"20\" /><option startIndex=\"57\" endIndex=\"59\" /><option correct=\"false\"><content><text value=\"3\" /></content></option><option correct=\"false\"><content><text value=\"==\" /></content></option><option correct=\"false\"><content><text value=\"26\" /></content></option></options></interaction></interactions><output><content><text value=\"[ 17, 20, 25, 24 ]\" /></content></output></code><p visible-if=\"wrong\">Wähle <code>=</code>, gefolgt von <code>temperatures[2]</code> und schließlich <code>25</code> aus.</p></body></html>"
          },
          {
            "title": "Valid index",
            "id": 73667,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Obwohl das Array vier Elemente hat, ist der letzte Index, auf den wir zugreifen können, <code>3</code>, da das Indexieren bei 0 beginnt.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" temperatures = [\" /><text value=\"17\" class=\"number\" /><text value=\", \" /><text value=\"25\" class=\"number\" /><text value=\", \" /><text value=\"26\" class=\"number\" /><text value=\", \" /><text value=\"24\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"temperatures[\" /><text value=\"3\" class=\"number\" /><text value=\"] = \" /><text value=\"20\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(temperatures);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"52\" endIndex=\"53\" /><option correct=\"false\"><content><text value=\"4\" /></content></option></options></interaction></interactions><output><content><text value=\"[ 17, 25, 26, 20 ]\" /></content></output></code><p visible-if=\"wrong\">Wähle <code>3</code> aus.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Array-Indizes beginnen bei <code>0</code>. Deshalb hat ein Array mit vier Elementen den letzten Index <code>3</code>.</p><p>Greife mit dem Index in eckigen Klammern auf ein Element zu, etwa <code>temperatures[0]</code>. Aktualisiere es mit <code>=</code>.</p><p>Aktualisiere den dritten Messwert auf <code>20</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" \" /><text value=\"temperatures\" /><text value=\" \" /><text value=\"=\" /><text value=\" \" /><text value=\"[\" /><text value=\"17\" class=\"number\" /><text value=\",\" /><text value=\" \" /><text value=\"25\" class=\"number\" /><text value=\",\" /><text value=\" \" /><text value=\"26\" class=\"number\" /><text value=\",\" /><text value=\" \" /><text value=\"24\" class=\"number\" /><text value=\"]\" /><text value=\";\" /><text type=\"break\" /><text value=\"temperatures\" /><text value=\"[\" /><text value=\"2\" class=\"number\" /><text value=\"]\" /><text value=\" \" /><text value=\"=\" /><text value=\" \" /><text value=\"20\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".\" /><text value=\"log\" /><text value=\"(\" /><text value=\"temperatures\" /><text value=\")\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"51\" endIndex=\"52\" /><option startIndex=\"52\" endIndex=\"53\" /><option startIndex=\"53\" endIndex=\"54\" /><option correct=\"false\"><content><text value=\"3\" /></content></option><option correct=\"false\"><content><text value=\"4\" /></content></option><option correct=\"false\"><content><text value=\"=\" /></content></option></options></interaction></interactions><output><content><text value=\"[ 17, 25, 20, 24 ]\" /></content></output></code><p visible-if=\"wrong\">Wähle <code>[</code>, gefolgt von <code>2</code> und schließlich <code>]</code> aus.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Question: Any value",
            "id": 73682,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Welche Arten von Werten kann ein Array speichern?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Jeder Wert, einschließlich Strings, Zahlen und Booleans</item><item value=\"2\" correct=\"false\">Nur Strings</item></selection><p visible-if=\"wrong\">Jeder Wert, einschließlich Strings, Zahlen und Booleans.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Ein Array enthält <code>\"Mia\"</code>, <code>17</code> und <code>false</code>. Welche Aussage stimmt?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Es kann Strings, Zahlen und Booleans speichern.</item><item value=\"2\" correct=\"false\">Es kann nur Strings speichern.</item><item value=\"3\" correct=\"false\">Alle Elemente müssen denselben Typ haben.</item></selection><p visible-if=\"wrong\">Es kann Strings, Zahlen und Booleans speichern.</p></body></html>"
          },
          {
            "title": "Question: Index",
            "id": 73683,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wie nennen wir die Position eines Elements in einem Array?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Der Index des Elements</item><item value=\"2\" correct=\"false\">Die Nummer des Elements</item></selection><p visible-if=\"wrong\">Der Index des Elements.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Wie heißt die Position <code>2</code> in <code>colors[2]</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Der Index des Elements</item><item value=\"2\" correct=\"false\">Die Nummer des Elements</item><item value=\"3\" correct=\"false\">Der Wert des Elements</item></selection><p visible-if=\"wrong\">Wähle Der Index des Elements aus.</p></body></html>"
          },
          {
            "title": "Question: Start at zero",
            "id": 73684,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Welchen Index hat das Element in diesem Array?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" friends = [\" /><text value=\"&quot;Kim&quot;\" class=\"string\" /><text value=\"];\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>0</code></item><item value=\"2\" correct=\"false\"><code>1</code></item></selection><p visible-if=\"wrong\">Wähle <code>0</code> aus.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Stell dir vor, du fügst <code>\"Lee\"</code> vor <code>\"Kim\"</code> in dieses Array ein. Welcher Index ruft dann <code>\"Kim\"</code> ab?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" friends = [\" /><text value=\"&quot;Kim&quot;\" class=\"string\" /><text value=\"];\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>1</code></item><item value=\"2\" correct=\"false\"><code>0</code></item><item value=\"3\" correct=\"false\"><code>2</code></item></selection><p visible-if=\"wrong\">Wähle <code>1</code> aus.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Question: Access element",
            "id": 73685,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wie greifen wir auf ein Element in diesem Array zu?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" cars = [\" /><text value=\"&quot;Fiat&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Tesla&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Saab&quot;\" class=\"string\" /><text value=\"];\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>cars[1]</code></item><item value=\"2\" correct=\"false\"><code>cars[\"Tesla\"]</code></item></selection><p visible-if=\"wrong\">Wähle <code>cars[1]</code> aus.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Welcher Ausdruck greift im gezeigten Array auf das mittlere Element <code>\"Tesla\"</code> zu?</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" cars = [\" /><text value=\"&quot;Fiat&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Tesla&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;Saab&quot;\" class=\"string\" /><text value=\"];\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>cars[1]</code></item><item value=\"2\" correct=\"false\"><code>cars[\"Tesla\"]</code></item><item value=\"3\" correct=\"false\"><code>cars[2]</code></item></selection><p visible-if=\"wrong\">Wähle <code>cars[1]</code> aus.</p></body></html>"
          },
          {
            "title": "Question: Change value",
            "id": 73686,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wie aktualisieren wir einen Wert in einem Array?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Wir greifen auf den Wert über seinen Index zu und weisen dann einen anderen Wert zu</item><item value=\"2\" correct=\"false\">Wir können Werte in Arrays nicht aktualisieren</item></selection><p visible-if=\"wrong\">Wir greifen auf den Wert über seinen Index zu und weisen dann einen anderen Wert zu.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Du musst den Wert am Index <code>1</code> ersetzen. Was musst du tun?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Greife über den Index darauf zu und weise einen neuen Wert zu.</item><item value=\"2\" correct=\"false\">Arrays können nicht aktualisiert werden.</item><item value=\"3\" correct=\"false\">Weise dem Wert einen neuen Index zu.</item></selection><p visible-if=\"wrong\">Greife über den Index darauf zu und weise einen neuen Wert zu.</p></body></html>"
          },
          {
            "title": "Question: Valid index",
            "id": 73687,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Welche Indizes können wir in einem Array mit zwei Elementen zugreifen?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>0</code> und <code>1</code></item><item value=\"2\" correct=\"false\"><code>1</code> und <code>2</code></item></selection><p visible-if=\"wrong\"><code>0</code> und <code>1</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Ein Array hat genau zwei Elemente. Über welche Indizes lassen sich vorhandene Elemente abrufen?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>0</code> und <code>1</code></item><item value=\"2\" correct=\"false\"><code>1</code> und <code>2</code></item><item value=\"3\" correct=\"false\"><code>0</code> und <code>2</code></item></selection><p visible-if=\"wrong\">Wähle <code>0</code> und <code>1</code> aus.</p></body></html>"
          },
          {
            "title": "Example: Any value",
            "id": 73690,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Code den Wert <code>false</code> in dieses Array.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" options = [\" /><text value=\"true\" class=\"literal\" /><text value=\", \" /><text value=\"false\" class=\"literal\" /><text value=\"];\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"23\" endIndex=\"28\" /></interactions></code><p visible-if=\"wrong\">Gib <code>false</code> ein.</p></body></html>"
          },
          {
            "title": "Example: Index",
            "id": 73691,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Stelle sicher, dass <code>\"cat\"</code> an Index <code>0</code> und <code>\"dog\"</code> an Index <code>1</code> ist, indem du <code>\"cat\"</code> dann <code>\"dog\"</code> codierst.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" animals = [\" /><text value=\"&quot;cat&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;dog&quot;\" class=\"string\" /><text value=\"];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(animals);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"17\" endIndex=\"22\" /><option startIndex=\"24\" endIndex=\"29\" /><option correct=\"false\"><content><text value=\"&quot;parrot&quot;\" /></content></option></options></interaction></interactions><output><content><text value=\"[ 'cat', 'dog' ]\" /></content></output></code><p visible-if=\"wrong\">Wähle <code>\"cat\"</code>, gefolgt von <code>\"dog\"</code> aus.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Setze <code>\"dog\"</code> an Index <code>2</code>, <code>\"cat\"</code> an Index <code>0</code> und <code>\"parrot\"</code> an Index <code>1</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" \" /><text value=\"animals\" /><text value=\" \" /><text value=\"=\" /><text value=\" \" /><text value=\"[\" /><text value=\"&quot;cat&quot;\" class=\"string\" /><text value=\",\" /><text value=\" \" /><text value=\"&quot;parrot&quot;\" class=\"string\" /><text value=\",\" /><text value=\" \" /><text value=\"&quot;dog&quot;\" class=\"string\" /><text value=\"]\" /><text value=\";\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"17\" endIndex=\"22\" /><option startIndex=\"24\" endIndex=\"32\" /><option startIndex=\"34\" endIndex=\"39\" /><option correct=\"false\"><content><text value=\"&quot;hamster&quot;\" /></content></option><option correct=\"false\"><content><text value=\"&quot;fish&quot;\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Wähle <code>\"cat\"</code>, gefolgt von <code>\"parrot\"</code> und schließlich <code>\"dog\"</code> aus.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example: Start at zero",
            "id": 73692,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Codiere den Wert <code>9</code> an Index null.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" lockCombination = [\" /><text value=\"9\" class=\"number\" /><text value=\", \" /><text value=\"4\" class=\"number\" /><text value=\", \" /><text value=\"7\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(lockCombination);\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"25\" endIndex=\"26\" /></interactions><output><content><text value=\"[ 9, 4, 7 ]\" /></content></output></code><p visible-if=\"wrong\">Gib <code>9</code> ein.</p></body></html>"
          },
          {
            "title": "Example: Access element",
            "id": 73693,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Code <code>items[1]</code>, um das zweite Element, <code>\"tomato\"</code>, im Array anzuzeigen.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" items = [\" /><text value=\"&quot;milk&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;tomato&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;apple&quot;\" class=\"string\" /><text value=\"];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(items[\" /><text value=\"1\" class=\"number\" /><text value=\"]);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"55\" endIndex=\"63\" /><option correct=\"false\"><content><text value=\"items[2]\" /></content></option></options></interaction></interactions><output><content><text value=\"tomato\" /></content></output></code><p visible-if=\"wrong\">Wähle <code>items[1]</code> aus.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Gib das zweite Element <code>tomato</code> aus dem Array aus.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" items = [\" /><text value=\"&quot;milk&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;tomato&quot;\" class=\"string\" /><text value=\", \" /><text value=\"&quot;apple&quot;\" class=\"string\" /><text value=\"];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(items[\" /><text value=\"1\" class=\"number\" /><text value=\"]);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"55\" endIndex=\"63\" /><option correct=\"false\"><content><text value=\"items[2]\" /></content></option><option correct=\"false\"><content><text value=\"items[0]\" /></content></option></options></interaction></interactions><output><content><text value=\"tomato\" /></content></output></code><p visible-if=\"wrong\">Wähle <code>items[1]</code> aus.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example: Change value",
            "id": 73694,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Aktualisiere das erste Element im Array von <code>3</code> auf <code>2</code>.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" even = [\" /><text value=\"3\" class=\"number\" /><text value=\", \" /><text value=\"4\" class=\"number\" /><text value=\", \" /><text value=\"6\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"even[\" /><text value=\"0\" class=\"number\" /><text value=\"] = \" /><text value=\"2\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(even);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"24\" endIndex=\"31\" /><option startIndex=\"32\" endIndex=\"33\" /><option startIndex=\"34\" endIndex=\"35\" /></options></interaction></interactions><output><content><text value=\"[ 2, 4, 6 ]\" /></content></output></code><p visible-if=\"wrong\">Wähle <code>even[0]</code>, gefolgt von <code>=</code> und schließlich <code>2</code> aus.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Korrigiere den ersten Wert, damit das Array als <code>[ 2, 4, 6 ]</code> ausgegeben wird.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" even = [\" /><text value=\"3\" class=\"number\" /><text value=\", \" /><text value=\"4\" class=\"number\" /><text value=\", \" /><text value=\"6\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"even[\" /><text value=\"0\" class=\"number\" /><text value=\"] = \" /><text value=\"2\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(even);\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"24\" endIndex=\"31\" /><option startIndex=\"11\" endIndex=\"12\" /><option startIndex=\"34\" endIndex=\"35\" /><option correct=\"false\"><content><text value=\"even[1]\" /></content></option><option correct=\"false\"><content><text value=\"==\" /></content></option><option correct=\"false\"><content><text value=\"3\" /></content></option></options></interaction></interactions><output><content><text value=\"[ 2, 4, 6 ]\" /></content></output></code><p visible-if=\"wrong\">Wähle <code>=</code>, gefolgt von <code>even[0]</code> und schließlich <code>2</code> aus.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example: Valid index",
            "id": 73695,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Greife auf das dritte Element des Arrays zu.<br /></p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" topSpeeds = [\" /><text value=\"100\" class=\"number\" /><text value=\", \" /><text value=\"130\" class=\"number\" /><text value=\", \" /><text value=\"240\" class=\"number\" /><text value=\"];\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(topSpeeds[\" /><text value=\"2\" class=\"number\" /><text value=\"]);\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"57\" endIndex=\"58\" /></interactions><output><content><text value=\"240\" /></content></output></code><p visible-if=\"wrong\">Gib <code>2</code> ein.</p></body></html>"
          }
        ]
      }
