            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wir stellen eine Spiel-UI-Szene als Baum dar. Welche Teile werden als Knoten betrachtet?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Alle UI-Elemente und deren Text</item><item value=\"2\" correct=\"false\">Nur Elemente, die keinen schließenden Tag haben</item><item value=\"3\" correct=\"false\">Nur Elemente mit Kindern</item></selection><p visible-if=\"wrong\">Alle UI-Elemente und deren Text.</p></body></html>"
