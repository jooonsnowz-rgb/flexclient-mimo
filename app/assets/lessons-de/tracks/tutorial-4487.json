            "id": 149043,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Welcher Code gehört in die Klammern von <code>document.createElement()</code>?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Der Typ des Elements, wie <code>\"img\"</code> für ein <code>img</code>-Element</item><item value=\"2\" correct=\"false\">Der ID-Wert des Elements</item><item value=\"3\" correct=\"false\">Der Name der Variable, die das Element speichert</item></selection><p visible-if=\"wrong\">Der Typ des Elements, wie <code>\"img\"</code> für ein <code>img</code>-Element.</p></body></html>"
