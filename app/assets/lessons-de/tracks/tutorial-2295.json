      {
        "id": 13768,
        "title": "SQL-Filter 2",
        "type": "practiceLevel2",
        "lessons": [
          {
            "title": "Question: Both conditions",
            "id": 95807,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Welche Elemente werden ausgewählt, wenn mit Bedingungen gefiltert wird, die mit <code>AND</code> verknüpft sind?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Elemente, die alle Bedingungen erfüllen</item><item value=\"2\" correct=\"false\">Elemente, die eine oder mehrere Bedingungen erfüllen</item><item value=\"3\" correct=\"false\">Elemente, die keine Bedingungen erfüllen</item></selection><p visible-if=\"wrong\">Elemente, die alle Bedingungen erfüllen.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Damit eine Zeile ausgewählt wird, müssen alle mit <code>AND</code> verknüpften Bedingungen wahr sein.</p><p>Ein Buch stimmt mit dem ersten Filter überein, aber nicht mit dem zweiten, der durch <code>AND</code> verknüpft ist. Wird es ausgewählt?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Nein, es muss beide Filter erfüllen</item><item value=\"2\" correct=\"false\">Ja, ein passender Filter genügt</item><item value=\"3\" correct=\"false\">Ja, AND ignoriert den zweiten Filter</item></selection><p visible-if=\"wrong\">Nein, es muss beide Filter erfüllen.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example: Comparisons",
            "id": 95812,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Verknüpfe eine Bedingung, um auch nach einem <code>year</code> zu filtern, das kleiner als <code>2000</code> ist, indem du den <code>AND</code>-Operator verwendest.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE books (&#xA; title varchar(255),&#xA; year int,&#xA; genre varchar(255)&#xA;);&#xA;&#xA;INSERT INTO books(title, year, genre)&#xA;VALUES ('Ulysses', 1992, 'fiction');&#xA;&#xA;INSERT INTO books(title, year, genre)&#xA;VALUES ('Sapiens', 2011, 'non-fiction');&#xA;&#xA;INSERT INTO books(title, year, genre)&#xA;VALUES ('Beloved', 1987, 'fiction');&#xA;&#xA;INSERT INTO books(title, year, genre)&#xA;VALUES ('The Prince', 1532, 'non-fiction');\"><tables><table name=\"books\"><row><header content=\"title\" /><header content=\"year\" /><header content=\"genre\" /></row><row><data content=\"Ulysses\" /><data content=\"1992\" /><data content=\"fiction\" /></row><row><data content=\"Sapiens\" /><data content=\"2011\" /><data content=\"non-fiction\" /></row><row><data content=\"Beloved\" /><data content=\"1987\" /><data content=\"fiction\" /></row><row><data content=\"The Prince\" /><data content=\"1532\" /><data content=\"non-fiction\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" books\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" genre = \" /><text value=\"'non-fiction'\" class=\"string\" /><text type=\"break\" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" &lt; \" /><text value=\"2000\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"49\" endIndex=\"64\" /></interactions><output><table name=\"Result\"><row><header content=\"title\" /><header content=\"year\" /><header content=\"genre\" /></row><row><data content=\"The Prince\" /><data content=\"1532\" /><data content=\"non-fiction\" /></row></table></output></code><p visible-if=\"wrong\">Gib <code>AND year &lt; 2000</code> ein.</p></body></html>"
          },
          {
            "title": "Question: Equivalent to BETWEEN",
            "id": 95810,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Können wir <code>year &gt; 1800 AND year &lt; 1900</code> durch <code>BETWEEN 1800 AND 1900</code> ersetzen?<br /></p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" books\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" &gt; \" /><text value=\"1800\" class=\"number\" /><text type=\"break\" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" &lt; \" /><text value=\"1900\" class=\"number\" /><text value=\" ;\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Nein, die Operatoren müssten <code>&gt;=</code> und <code>&lt;=</code> sein, damit das möglich ist</item><item value=\"2\" correct=\"false\">Ja, die beiden sind gleichwertig</item><item value=\"3\" correct=\"false\">Nein, wir können <code>BETWEEN</code> nicht mit Zahlen verwenden</item></selection><p visible-if=\"wrong\">Nein, die Operatoren müssten <code>&gt;=</code> und <code>&lt;=</code> sein, damit das möglich ist.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Die Abfrage schließt 1800 und 1900 aus. Welche Änderung macht sie gleichwertig mit <code>BETWEEN 1800 AND 1900</code>?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" books\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" &gt; \" /><text value=\"1800\" class=\"number\" /><text type=\"break\" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" &lt; \" /><text value=\"1900\" class=\"number\" /><text value=\" ;\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Verwende <code>&gt;=</code> und <code>&lt;=</code> in den beiden Bedingungen</item><item value=\"2\" correct=\"false\">Behalte <code>&gt;</code> und <code>&lt;</code> bei, weil BETWEEN die Endpunkte ausschließt</item><item value=\"3\" correct=\"false\">Ersetze <code>AND</code> durch <code>OR</code></item></selection><p visible-if=\"wrong\">Verwende <code>&gt;=</code> und <code>&lt;=</code> in den beiden Bedingungen.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Question: IN, BETWEEN, and LIKE 2",
            "id": 95813,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Welche Art von Elementen wählt diese Abfrage aus?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" books\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" title \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'%a%'\" class=\"string\" /><text type=\"break\" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" \" /><text value=\"IN\" class=\"keyword\" /><text value=\" (\" /><text value=\"2019\" class=\"number\" /><text value=\", \" /><text value=\"2020\" class=\"number\" /><text value=\");\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Elemente mit einem <code>title</code>, das <code>a</code> enthält, und einem <code>year</code> von entweder <code>2019</code> oder <code>2020</code></item><item value=\"2\" correct=\"false\">Elemente mit einem <code>year</code> von entweder <code>2019</code> oder <code>2020</code></item><item value=\"3\" correct=\"false\">Elemente mit einem <code>title</code>, das <code>a</code> enthält</item></selection><p visible-if=\"wrong\">Elemente mit einem <code>title</code>, das <code>a</code> enthält, und einem <code>year</code> von entweder <code>2019</code> oder <code>2020</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p><code>LIKE '%a%'</code> findet Text, der <code>a</code> enthält. Jedes <code>%</code> steht für null oder mehr Zeichen.</p><p>Ein Buch enthält <code>a</code> im Titel, wurde aber 2018 veröffentlicht. Wählt die angezeigte Abfrage es aus?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" books\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" title \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'%a%'\" class=\"string\" /><text type=\"break\" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" \" /><text value=\"IN\" class=\"keyword\" /><text value=\" (\" /><text value=\"2019\" class=\"number\" /><text value=\", \" /><text value=\"2020\" class=\"number\" /><text value=\");\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Nein, sein Jahr ist weder 2019 noch 2020</item><item value=\"2\" correct=\"false\">Ja, sein Titel stimmt mit LIKE überein</item><item value=\"3\" correct=\"false\">Ja, LIKE ignoriert den Jahresfilter</item></selection><p visible-if=\"wrong\">Nein, sein Jahr ist weder 2019 noch 2020.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example: IN, BETWEEN, and LIKE",
            "id": 95811,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Verknüpfe eine Bedingung, die überprüft, ob <code>genre</code> mit f beginnt, indem du das Muster <code>'f%'</code> und den <code>AND</code>-Operator verwendest.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE books (&#xA; title varchar(255),&#xA; year int,&#xA; genre varchar(255)&#xA;);&#xA;&#xA;INSERT INTO books(title, year, genre)&#xA;VALUES ('Ulysses', 1992, 'fiction');&#xA;&#xA;INSERT INTO books(title, year, genre)&#xA;VALUES ('Sapiens', 2011, 'non-fiction');&#xA;&#xA;INSERT INTO books(title, year, genre)&#xA;VALUES ('Beloved', 1987, 'fiction');&#xA;&#xA;INSERT INTO books(title, year, genre)&#xA;VALUES ('The Prince', 1532, 'non-fiction');\"><tables><table name=\"books\"><row><header content=\"title\" /><header content=\"year\" /><header content=\"genre\" /></row><row><data content=\"Ulysses\" /><data content=\"1992\" /><data content=\"fiction\" /></row><row><data content=\"Sapiens\" /><data content=\"2011\" /><data content=\"non-fiction\" /></row><row><data content=\"Beloved\" /><data content=\"1987\" /><data content=\"fiction\" /></row><row><data content=\"The Prince\" /><data content=\"1532\" /><data content=\"non-fiction\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" books\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"1900\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"2000\" class=\"number\" /><text type=\"break\" /><text value=\"AND\" class=\"keyword\" /><text value=\" genre \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'f%'\" class=\"string\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"54\" endIndex=\"73\" /></interactions><output><table name=\"Result\"><row><header content=\"title\" /><header content=\"year\" /><header content=\"genre\" /></row><row><data content=\"Ulysses\" /><data content=\"1992\" /><data content=\"fiction\" /></row><row><data content=\"Beloved\" /><data content=\"1987\" /><data content=\"fiction\" /></row></table></output></code><p visible-if=\"wrong\">Gib <code>AND genre LIKE 'f%'</code> ein.</p></body></html>"
          },
          {
            "title": "Question: At least one condition",
            "id": 95898,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wählt diese Abfrage Elemente mit einem <code>genre</code> gleich <code>'non-fiction'</code> aus?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" books\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" genre = \" /><text value=\"'fiction'\" class=\"string\" /><text type=\"break\" /><text value=\"OR\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" = \" /><text value=\"2011\" class=\"number\" /><text value=\";\" /></content><output><table name=\"Result\"><row><data content=\"No result!\" /></row></table></output></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Ja, wenn diese Elemente die Bedingung <code>year = 2011</code> erfüllen</item><item value=\"2\" correct=\"false\">Nein, da die Elemente alle Bedingungen erfüllen müssen</item><item value=\"3\" correct=\"false\">Ja, da die Abfrage alle Tabellenelemente auswählt</item></selection><p visible-if=\"wrong\">Ja, wenn diese Elemente die Bedingung <code>year = 2011</code> erfüllen.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Ein Sachbuch wurde 2011 veröffentlicht. Wird es von der angezeigten <code>OR</code>-Abfrage ausgewählt?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" books\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" genre = \" /><text value=\"'fiction'\" class=\"string\" /><text type=\"break\" /><text value=\"OR\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" = \" /><text value=\"2011\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Ja, weil es <code>year = 2011</code> erfüllt</item><item value=\"2\" correct=\"false\">Nein, weil sein Genre nicht fiction ist</item><item value=\"3\" correct=\"false\">Nein, weil beide OR-Bedingungen übereinstimmen müssen</item></selection><p visible-if=\"wrong\">Ja, weil es <code>year = 2011</code> erfüllt.</p></body></html>"
          },
          {
            "title": "Example: The logical operator OR",
            "id": 95901,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Stelle sicher, dass die Abfrage Elemente auswählt, deren <code>genre</code> gleich <code>'fiction'</code> ist oder deren <code>year</code> gleich <code>2011</code> ist.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE books (&#xA; title varchar(255),&#xA; year int,&#xA; genre varchar(255)&#xA;);&#xA;&#xA;INSERT INTO books(title, year, genre)&#xA;VALUES ('Ulysses', 1992, 'fiction');&#xA;&#xA;INSERT INTO books(title, year, genre)&#xA;VALUES ('Sapiens', 2011, 'non-fiction');&#xA;&#xA;INSERT INTO books(title, year, genre)&#xA;VALUES ('Beloved', 1987, 'fiction');&#xA;&#xA;INSERT INTO books(title, year, genre)&#xA;VALUES ('The Prince', 1532, 'non-fiction');\"><tables><table name=\"books\"><row><header content=\"title\" /><header content=\"year\" /><header content=\"genre\" /></row><row><data content=\"Ulysses\" /><data content=\"1992\" /><data content=\"fiction\" /></row><row><data content=\"Sapiens\" /><data content=\"2011\" /><data content=\"non-fiction\" /></row><row><data content=\"Beloved\" /><data content=\"1987\" /><data content=\"fiction\" /></row><row><data content=\"The Prince\" /><data content=\"1532\" /><data content=\"non-fiction\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" books\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" genre = \" /><text value=\"'fiction'\" class=\"string\" /><text type=\"break\" /><text value=\"OR\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" = \" /><text value=\"2011\" class=\"number\" /><text value=\";\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"45\" endIndex=\"59\" /></interactions><output><table name=\"Result\"><row><header content=\"title\" /><header content=\"year\" /><header content=\"genre\" /></row><row><data content=\"Ulysses\" /><data content=\"1992\" /><data content=\"fiction\" /></row><row><data content=\"Sapiens\" /><data content=\"2011\" /><data content=\"non-fiction\" /></row><row><data content=\"Beloved\" /><data content=\"1987\" /><data content=\"fiction\" /></row></table></output></code><p visible-if=\"wrong\">Gib <code>OR year = 2011</code> ein.</p></body></html>"
          },
          {
            "title": "Question: IN, BETWEEN, or LIKE",
            "id": 95904,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Was wählt diese Abfrage aus?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" books\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" title \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'%a%'\" class=\"string\" /><text type=\"break\" /><text value=\"OR\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"1950\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"2020\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Elemente mit einem <code>title</code>, das <code>a</code> enthält oder <code>year</code> zwischen <code>1950</code> und <code>2020</code></item><item value=\"2\" correct=\"false\">Elemente mit einem <code>title</code>, das <code>a</code> enthält </item><item value=\"3\" correct=\"false\">Elemente mit einem <code>year</code> zwischen <code>1950</code> und <code>2020</code></item></selection><p visible-if=\"wrong\">Elemente mit einem <code>title</code>, das <code>a</code> enthält oder <code>year</code> zwischen <code>1950</code> und <code>2020</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Mit <code>OR</code> verknüpfte Bedingungen wählen eine Zeile aus, wenn mindestens eine Bedingung wahr ist.</p><p>Ein Titel enthält kein <code>a</code>, aber sein Jahr ist 2000. Wählt die angezeigte Abfrage ihn aus?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" books\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" title \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'%a%'\" class=\"string\" /><text type=\"break\" /><text value=\"OR\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"1950\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text value=\" \" /><text value=\"2020\" class=\"number\" /><text value=\";\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Ja, sein Jahr liegt im BETWEEN-Bereich</item><item value=\"2\" correct=\"false\">Nein, sein Titel stimmt nicht mit LIKE überein</item><item value=\"3\" correct=\"false\">Nein, beide OR-Bedingungen müssen wahr sein</item></selection><p visible-if=\"wrong\">Ja, sein Jahr liegt im BETWEEN-Bereich.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Question: Same as IN 2",
            "id": 95907,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Sind diese beiden Abfragen gleichwertig?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" books\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" \" /><text value=\"IN\" class=\"keyword\" /><text value=\" (\" /><text value=\"1950\" class=\"number\" /><text value=\", \" /><text value=\"2020\" class=\"number\" /><text value=\");\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" books\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" = \" /><text value=\"1950\" class=\"number\" /><text type=\"break\" /><text value=\"OR\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" = \" /><text value=\"2020\" class=\"number\" /><text value=\";\" /><text type=\"break\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Ja, sie wählen beide Elemente mit einem <code>year</code> von entweder <code>1950</code> oder <code>2020</code> aus</item><item value=\"2\" correct=\"false\">Nein, <code>IN</code> hat kein Äquivalent</item><item value=\"3\" correct=\"false\">Nein, wir können <code>OR</code> nicht verwenden, um Bedingungen zu verketten</item></selection><p visible-if=\"wrong\">Ja, sie wählen beide Elemente mit einem <code>year</code> von entweder <code>1950</code> oder <code>2020</code> aus.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Das Jahr eines Buchs ist 1960. Wird es von einer der angezeigten Abfragen ausgewählt?</p><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" books\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" \" /><text value=\"IN\" class=\"keyword\" /><text value=\" (\" /><text value=\"1950\" class=\"number\" /><text value=\", \" /><text value=\"2020\" class=\"number\" /><text value=\");\" /><text type=\"break\" /><text type=\"break\" /><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" books\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" = \" /><text value=\"1950\" class=\"number\" /><text type=\"break\" /><text value=\"OR\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" = \" /><text value=\"2020\" class=\"number\" /><text value=\";\" /><text type=\"break\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Nein, keine der Abfragen enthält 1960</item><item value=\"2\" correct=\"false\">Ja, IN enthält jedes Jahr zwischen 1950 und 2020</item><item value=\"3\" correct=\"false\">Ja, OR enthält jedes beliebige Jahr</item></selection><p visible-if=\"wrong\">Nein, keine der Abfragen enthält 1960.</p></body></html>",
            "hardModeSelected": true
          },
          {
            "title": "Example: IN, BETWEEN, or LIKE",
            "id": 95906,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Verknüpfe eine Bedingung mit <code>'%a%'</code>, um auch Elemente auszuwählen, deren <code>title</code> den Buchstaben <code>a</code> enthält.</p><database visible-if=\"always\" bootstrapScript=\"CREATE TABLE books (&#xA; title varchar(255),&#xA; year int,&#xA; genre varchar(255)&#xA;);&#xA;&#xA;INSERT INTO books(title, year, genre)&#xA;VALUES ('Ulysses', 1992, 'fiction');&#xA;&#xA;INSERT INTO books(title, year, genre)&#xA;VALUES ('Sapiens', 2011, 'non-fiction');&#xA;&#xA;INSERT INTO books(title, year, genre)&#xA;VALUES ('Beloved', 1987, 'fiction');&#xA;&#xA;INSERT INTO books(title, year, genre)&#xA;VALUES ('The Prince', 1532, 'non-fiction');\"><tables><table name=\"books\"><row><header content=\"title\" /><header content=\"year\" /><header content=\"genre\" /></row><row><data content=\"Ulysses\" /><data content=\"1992\" /><data content=\"fiction\" /></row><row><data content=\"Sapiens\" /><data content=\"2011\" /><data content=\"non-fiction\" /></row><row><data content=\"Beloved\" /><data content=\"1987\" /><data content=\"fiction\" /></row><row><data content=\"The Prince\" /><data content=\"1532\" /><data content=\"non-fiction\" /></row></table></tables></database><code version=\"2\" codelang=\"sql\" name=\"script.sql\" visible-if=\"always\"><content><text value=\"SELECT\" class=\"keyword\" /><text value=\" * \" /><text type=\"break\" /><text value=\"FROM\" class=\"keyword\" /><text value=\" books\" /><text type=\"break\" /><text value=\"WHERE\" class=\"keyword\" /><text value=\" title \" /><text value=\"LIKE\" class=\"keyword\" /><text value=\" \" /><text value=\"'%a%'\" class=\"string\" /><text type=\"break\" /><text value=\"OR\" class=\"keyword\" /><text value=\" \" /><text value=\"year\" class=\"keyword\" /><text value=\" \" /><text value=\"BETWEEN\" class=\"keyword\" /><text value=\" \" /><text value=\"1950\" class=\"number\" /><text value=\" \" /><text value=\"AND\" class=\"keyword\" /><text va