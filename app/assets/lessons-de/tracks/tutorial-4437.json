            "interactiveContent": "<!DOCTYPE html ><html><body><p>Was müssen wir als Parameter übergeben, um der <code>.map()</code>-Funktion mitzuteilen, wie jedes Element modifiziert werden soll?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Eine Funktion</item><item value=\"2\" correct=\"false\"><code>element</code></item></selection><p visible-if=\"wrong\">Eine Funktion.</p></body></html>"
          },
          {
