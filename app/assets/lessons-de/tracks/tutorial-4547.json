            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Welche Methode müssen wir aufrufen, um eine Unterklasse zu erstellen, die dieselben Eigenschaften wie ihre Oberklasse hat?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>super()</code></item><item value=\"2\" correct=\"false\"><code>constructor()</code></item></selection><p visible-if=\"wrong\">Wähle <code>super()</code> aus.</p></body></html>"
