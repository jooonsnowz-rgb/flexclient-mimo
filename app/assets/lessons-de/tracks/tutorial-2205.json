            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Welcher Wert ist kein String?</p><selection multiple=\"multiple\" iscode=\"false\"><item correct=\"true\" value=\"1\"><code>true</code></item><item correct=\"false\" value=\"2\"><code>\"true\"</code></item><item correct=\"false\" value=\"2\"><code>\"wrong\"</code></item></selection><p visible-if=\"wrong\">Wähle <code>true</code> aus.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Deine App ist bereit. Welchen besonderen Wert solltest du in <code>isReady</code> speichern, um das anzuzeigen?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>true</code></item><item value=\"2\" correct=\"false\"><code>\"true\"</code></item><item value=\"3\" correct=\"false\"><code>false</code></item></selection><p visible-if=\"wrong\">Wähle <code>true</code> aus.</p></body></html>",
            "hardModeSelected": true
