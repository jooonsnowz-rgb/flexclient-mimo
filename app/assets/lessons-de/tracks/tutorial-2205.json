            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Überprüfe, ob <code>uploaded</code> den Wert <code>100</code> hat.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" uploaded = \" /><text value=\"15\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(uploaded === \" /><text value=\"100\" class=\"number\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"42\" endIndex=\"45\" /><option startIndex=\"46\" endIndex=\"49\" /><option correct=\"false\"><content><text value=\"var\" /></content></option></options></interaction></interactions><output><content><text value=\"false\" /></content></output></code><p visible-if=\"wrong\">Wähle <code>===</code>, gefolgt von <code>100</code> aus.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Prüfe, ob <code>uploaded</code> genau <code>100</code> entspricht.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" uploaded = \" /><text value=\"15\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(uploaded === \" /><text value=\"100\" class=\"number\" /><text value=\");\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"42\" endIndex=\"45\" /><option startIndex=\"46\" endIndex=\"49\" /><option correct=\"false\"><content><text value=\"=\" /></content></option><option correct=\"false\"><content><text value=\"!==\" /></content></option><option correct=\"false\"><content><text value=\"0\" /></content></option></options></interaction></interactions><output><content><text value=\"false\" /></content></output></code><p visible-if=\"wrong\">Wähle <code>===</code>, gefolgt von <code>100</code> aus.</p></body></html>",
