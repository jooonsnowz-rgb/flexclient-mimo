            "interactiveContent": "<!DOCTYPE html ><html><body><p>Was ist das Ergebnis der Verwendung des <code>===</code> Operators?</p><selection multiple=\"multiple\"><item correct=\"true\" value=\"1\">Ein Wert von entweder <code>true</code> oder <code>false</code></item><item correct=\"false\" value=\"2\">Ein Wert von entweder <code>\"true\"</code> oder <code>\"false\"</code></item><item correct=\"false\" value=\"2\">Ein numerischer Wert</item></selection><p visible-if=\"wrong\">Ein Wert von entweder <code>true</code> oder <code>false</code>.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Welche Art von Wert erzeugt der Ausdruck <code>8 === 8</code>?</p><selection multiple=\"multiple\"><item value=\"1\" correct=\"true\">Den booleschen Wert <code>true</code></item><item value=\"2\" correct=\"false\">Den String-Wert <code>\"true\"</code></item><item value=\"3\" correct=\"false\">Die Zahl <code>8</code></item></selection><p visible-if=\"wrong\">Wähle Den booleschen Wert <code>true</code> aus.</p></body></html>"
