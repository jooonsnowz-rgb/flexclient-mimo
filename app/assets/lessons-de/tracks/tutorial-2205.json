            "interactiveContent": "<!DOCTYPE html ><html><body><p>Verwende das spezielle Zeichen, um den Wert zu negieren.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" isConnected = !\" /><text value=\"true\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"20\" endIndex=\"21\" /><option correct=\"false\"><content><text value=\"&quot;\" /></content></option><option correct=\"false\"><content><text value=\";\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Wähle <code>!</code> aus.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Negiere <code>true</code>, damit <code>isConnected</code> false ist.</p><code version=\"2\" codelang=\"javascript\" name=\"script.js\" visible-if=\"always\"><content><text value=\"const\" class=\"keyword\" /><text value=\" isConnected = !\" /><text value=\"true\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"20\" endIndex=\"21\" /><option correct=\"false\"><content><text value=\"!!\" /></content></option><option correct=\"false\"><content><text value=\"-\" /></content></option><option correct=\"false\"><content><text value=\"not\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Wähle <code>!</code> aus.</p></body></html>",
