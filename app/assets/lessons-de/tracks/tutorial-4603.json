            "hardModeContent": "<!DOCTYPE html ><html><body><p>Vervollständige das Befehlszeilentool, das den Paketinstaller von Python startet. Der Paketname ist bereits angegeben.</p><code version=\"2\" codelang=\"bash\" name=\"script.sh\" visible-if=\"always\"><content><text value=\"pip install data_tools\" /></content><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"0\" endIndex=\"3\" /><option startIndex=\"4\" endIndex=\"11\" /><option startIndex=\"12\" endIndex=\"22\" /><option correct=\"false\"><content><text value=\"script\" /></content></option><option correct=\"false\"><content><text value=\"module\" /></content></option><option correct=\"false\"><content><text value=\"main\" /></content></option></options></interaction></interactions></code><p visible-if=\"wrong\">Wähle <code>pip</code>, gefolgt von <code>install</code> und schließlich <code>data_tools</code> aus.</p></body></html>"
