            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Wie viele Methoden kann eine Klasse haben?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Soviel wir wollen</item><item value=\"2\" correct=\"false\">100 Methoden</item><item value=\"3\" correct=\"false\">3 Methoden</item></selection><p visible-if=\"wrong\">Soviel wir wollen.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Eine Klasse hat Methoden zum Speichern und Laden von Daten und braucht auch welche zum Validieren und Löschen. Was sollten wir tun?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Beide Methoden hinzufügen, weil eine Klasse beliebig viele Methoden haben kann</item><item value=\"2\" correct=\"false\">Nur eine hinzufügen, weil eine Klasse höchstens drei Methoden haben kann</item><item value=\"3\" correct=\"false\">Eine neue Klasse erstellen, weil die vorhandene keine weiteren Methoden erhalten kann</item></selection><p visible-if=\"wrong\">Beide Methoden hinzufügen, weil eine Klasse beliebig viele Methoden haben kann.</p></body></html>",
            "hardModeSelected": true
          },
