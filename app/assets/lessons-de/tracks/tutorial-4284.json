            "interactiveContent": "<!DOCTYPE html ><html><body><p>Es ist nicht nötig, sich alle Eingabetypen zu merken. Wir geben dir Übung für interessante wie <code>range</code>, <code>checkbox</code>, <code>date</code> und <code>color</code>.</p><code name=\"index.html\" version=\"2\" codelang=\"html\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option startIndex=\"69\" endIndex=\"74\" /><option startIndex=\"118\" endIndex=\"126\" /><option startIndex=\"166\" endIndex=\"170\" /><option startIndex=\"210\" endIndex=\"215\" /></options></interaction></interactions><content><text value=\"&lt;!doctype html&gt;\" class=\"meta\" /><text type=\"break\" /><text value=\"&lt;\" /><text value=\"html\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\" \" /><text value=\"&lt;\" /><text value=\"body\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Sound volume:\" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"input\" class=\"name\" /><text value=\" \" /><text value=\"type\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;range&quot;\" class=\"string\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text value=\"Enable tutorial:\" /><text value=\"&lt;/\" /><text value=\"p\" class=\"name\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"input\" class=\"name\" /><text value=\" \" /><text value=\"type\" class=\"attr\" /><text value=\"=\" /><text value=\"&quot;checkbox&quot;\" class=\"string\" /><text value=\"&gt;\" /><text type=\"break\" /><text value=\"  \" /><text value=\"&lt;\" /><text value=\"p\" class=\"na