            "interactiveContent": "<!DOCTYPE html ><html><body><p>Drucke das response-Objekt.</p><code version=\"2\" codelang=\"python\" name=\"script.py\" visible-if=\"always\"><content><text value=\"import\" class=\"keyword\" /><text value=\" requests\" /><text type=\"break\" /><text type=\"break\" /><text value=\"response = requests.get(\" /><text value=\"&quot;https://pokedex.mimo.dev/api/pokemon/pikachu&quot;\" class=\"string\" /><text value=\")\" /><text type=\"break\" /><text value=\"print(response)\" /></content><interactions><interaction type=\"validatedInput\" isDefault=\"true\" startIndex=\"95\" endIndex=\"103\" /></interactions><output><content><text value=\"&lt;Response [200]&gt;\" /></content></output></code><p visible-if=\"wrong\">Gib <code>response</code> ein.</p></body></html>"
