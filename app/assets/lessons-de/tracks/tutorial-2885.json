          {
            "title": "Lesson #10",
            "id": 131997,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Was ist der Zweck von Query-Parametern in einer HTTP-Anfrage?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Sie werden verwendet, um zusätzliche Daten an den Server zu übermitteln, wie Filter oder Suchkriterien</item><item value=\"2\" correct=\"false\">Sie werden verwendet, um Authentifizierungsdaten zu senden</item><item value=\"3\" correct=\"false\">Sie werden verwendet, um Daten im Body der Anfrage zu senden</item></selection><p visible-if=\"wrong\">Sie werden verwendet, um zusätzliche Daten an den Server zu übermitteln, wie Filter oder Suchkriterien.</p></body></html>",
            "hardModeContent": "<!DOCTYPE html ><html><body><p>Du fügst <code>?category=books</code> in eine Produktanfrage ein. Welchen Zweck erfüllt dieser Abfrageparameter?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Er übergibt Filterkriterien an den Server</item><item value=\"2\" correct=\"false\">Er authentifiziert die Anfrage mit einer Anmeldeinformation</item><item value=\"3\" correct=\"false\">Er erstellt ein neues Produkt aus Daten des Anfrage-Bodys</item></selection><p visible-if=\"wrong\">Er übergibt Filterkriterien an den Server.</p></body></html>",
            "hardModeSelected": true
