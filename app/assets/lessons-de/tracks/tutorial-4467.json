        "lessons": [
          {
            "title": "Lesson #1",
            "id": 148752,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Was war die Absicht von ES6?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Um Probleme zu beheben und die JS-Syntax zu verbessern</item><item value=\"2\" correct=\"false\">Um neue Scopes zu erstellen</item><item value=\"3\" correct=\"false\">Um neue reservierte Wörter einzuschließen</item></selection><p visible-if=\"wrong\">Um Probleme zu beheben und die JS-Syntax zu verbessern.</p></body></html>"
          },
          {
            "title": "Lesson #2",
            "id": 148753,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Was ist der Gültigkeitsbereich der <code>health</code>-Variable?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"1\" class=\"number\" /><text value=\"; i &lt;= \" /><text value=\"3\" class=\"number\" /><text value=\"; i++) {\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" health = i * \" /><text value=\"10\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(\" /><text value=\"&quot;Player health: &quot;\" class=\"string\" /><text value=\" + health);\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Blockbereich</item><item value=\"2\" correct=\"false\">Lokaler Geltungsbereich</item><item value=\"3\" correct=\"false\">Globaler Scope</item></selection><p visible-if=\"wrong\">Wähle Blockbereich aus.</p></body></html>"
          },
          {
            "title": "Lesson #3",
            "id": 148754,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Welcher Typ von Variable ist <code>score</code>?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"let\" class=\"keyword\" /><text value=\" score = \" /><text value=\"6\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"for\" class=\"keyword\" /><text value=\" (\" /><text value=\"let\" class=\"keyword\" /><text value=\" i = \" /><text value=\"0\" class=\"number\" /><text value=\"; i &lt;= \" /><text value=\"5\" class=\"number\" /><text value=\"; i++) {\" /><text type=\"break\" /><text value=\" score--;\" /><text type=\"break\" /><text value=\" \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(score);\" /><text type=\"break\" /><text value=\"}\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Global</item><item value=\"2\" correct=\"false\">Lokal</item><item value=\"3\" correct=\"false\">Block</item></selection><p visible-if=\"wrong\">Wähle Global aus.</p></body></html>"
          },
          {
            "title": "Lesson #4",
            "id": 148755,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Welche Variable befindet sich in einem Block-Scope?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"var\" class=\"keyword\" /><text value=\" gameRunning = \" /><text value=\"true\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"function\" class=\"keyword\" /><text value=\" \" /><text value=\"toggleGame\" class=\"title\" /><text value=\"(\" /><text value=\"\" class=\"params\" /><text value=\") \" /><text value=\"{\" /><text type=\"break\" /><text value=\"  \" /><text value=\"var\" class=\"keyword\" /><text value=\" logMessage = \" /><text value=\"&quot;Game state: &quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text type=\"break\" /><text value=\"  \" /><text value=\"if\" class=\"keyword\" /><text value=\" (gameRunning) {\" /><text type=\"break\" /><text value=\"    \" /><text value=\"let\" class=\"keyword\" /><text value=\" action = \" /><text value=\"&quot;Pausing game...&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"    \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(logMessage + action);\" /><text type=\"break\" /><text value=\"    gameRunning = \" /><text value=\"false\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"  } \" /><text value=\"else\" class=\"keyword\" /><text value=\" {\" /><text type=\"break\" /><text value=\"    \" /><text value=\"let\" class=\"keyword\" /><text value=\" action = \" /><text value=\"&quot;Resuming game...&quot;\" class=\"string\" /><text value=\";\" /><text type=\"break\" /><text value=\"    \" /><text value=\"console\" class=\"built_in\" /><text value=\".log(logMessage + action);\" /><text type=\"break\" /><text value=\"    gameRunning = \" /><text value=\"true\" class=\"literal\" /><text value=\";\" /><text type=\"break\" /><text value=\"  }\" /><text type=\"break\" /><text value=\"}\" /><text type=\"break\" /><text type=\"break\" /><text value=\"toggleGame();\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>action</code></item><item value=\"2\" correct=\"false\"><code>gameRunning</code></item><item value=\"3\" correct=\"false\"><code>logMessage</code></item></selection><p visible-if=\"wrong\">Wähle <code>action</code> aus.</p></body></html>"
          },
          {
            "title": "Lesson #5",
            "id": 148756,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Welcher Variablentyp kann nicht neu deklariert oder dessen Wert aktualisiert werden?</p><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>const</code></item><item value=\"2\" correct=\"false\"><code>let</code></item><item value=\"3\" correct=\"false\"><code>var</code></item></selection><p visible-if=\"wrong\">Wähle <code>const</code> aus.</p></body></html>"
          },
          {
            "title": "Lesson #6",
            "id": 148757,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Code die Syntax, die eine Arrow Function ohne Parameter erstellt.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"{\" /></content></option><option correct=\"false\"><content><text value=\"}\" /></content></option><option startIndex=\"21\" endIndex=\"22\" /><option startIndex=\"22\" endIndex=\"23\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" getMaxHealth = \" /><text value=\"()\" class=\"params\" /><text value=\" =&gt;\" /><text value=\" \" /><text value=\"200\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getMaxHealth());\" /></content></code><p visible-if=\"wrong\">Wähle <code>(</code>, gefolgt von <code>)</code> aus.</p></body></html>"
          },
          {
            "title": "Lesson #7",
            "id": 148758,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Code den Wert, der verwendet wird, um eine Arrow Function zu deklarieren.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"-&gt;\" /></content></option><option correct=\"false\"><content><text value=\"=\" /></content></option><option startIndex=\"24\" endIndex=\"26\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" getMaxHealth = \" /><text value=\"()\" class=\"params\" /><text value=\" =&gt;\" /><text value=\" \" /><text value=\"200\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getMaxHealth());\" /></content></code><p visible-if=\"wrong\">Wähle <code>=&gt;</code> aus.</p></body></html>"
          },
          {
            "title": "Lesson #8",
            "id": 148759,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Fülle die fehlenden Werte im folgenden Code aus.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"(\" /></content></option><option correct=\"false\"><content><text value=\")\" /></content></option><option startIndex=\"27\" endIndex=\"28\" /><option startIndex=\"66\" endIndex=\"67\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" getMaxHealth = \" /><text value=\"()\" class=\"params\" /><text value=\" =&gt;\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" health = \" /><text value=\"200\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" health;\" /><text type=\"break\" /><text value=\"};\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getMaxHealth());\" /></content></code><p visible-if=\"wrong\">Wähle <code>{</code>, gefolgt von <code>}</code> aus.</p></body></html>"
          },
          {
            "title": "Lesson #9",
            "id": 148760,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Erstelle eine Arrow Function, die den Wert <code>200</code> zurückgibt, wenn sie aufgerufen wird.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"21\" endIndex=\"30\" isDefault=\"true\" /></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" getMaxHealth = \" /><text value=\"()\" class=\"params\" /><text value=\" =&gt;\" /><text value=\" \" /><text value=\"200\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getMaxHealth());}\" /></content></code><p visible-if=\"wrong\">Gib <code>() =&gt; 200</code> ein.</p></body></html>"
          },
          {
            "title": "Lesson #10",
            "id": 148761,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Rufe die Arrow Function innerhalb der Display-Anweisung auf.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"74\" endIndex=\"84\" isDefault=\"true\" /></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" getScore = \" /><text value=\"()\" class=\"params\" /><text value=\" =&gt;\" /><text value=\" {\" /><text type=\"break\" /><text value=\" \" /><text value=\"const\" class=\"keyword\" /><text value=\" score = \" /><text value=\"200\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\" \" /><text value=\"return\" class=\"keyword\" /><text value=\" score\" /><text type=\"break\" /><text value=\"};\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getScore());}\" /></content></code><p visible-if=\"wrong\">Gib <code>getScore()</code> ein.</p></body></html>"
          },
          {
            "title": "Lesson #11",
            "id": 148762,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Was ist das Ergebnis der Ausführung des folgenden Codes?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getDamagePerHit = \" /><text value=\"(\" /><text value=\"totalDamage, hits\" class=\"params\" /><text value=\") =&gt;\" /><text value=\" totalDamage / hits;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getDamagePerHit(\" /><text value=\"20\" class=\"number\" /><text value=\", \" /><text value=\"2\" class=\"number\" /><text value=\"));\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\"><code>10</code></item><item value=\"2\" correct=\"false\"><code>40</code></item><item value=\"3\" correct=\"false\"><code>22</code></item></selection><p visible-if=\"wrong\">Wähle <code>10</code> aus.</p></body></html>"
          },
          {
            "title": "Lesson #12",
            "id": 148763,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Was ist falsch an dem folgenden Code?</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><content><text value=\"const\" class=\"keyword\" /><text value=\" getDoubleDamage = \" /><text value=\"(\" /><text value=\"damage\" class=\"params\" /><text value=\") =&gt;\" /><text value=\" damage * \" /><text value=\"2\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getDoubleDamage());\" /></content></code><selection iscode=\"false\" multiple=\"multiple\"><item value=\"1\" correct=\"true\">Wir müssen einen Standardparameterwert festlegen, um die Anzeige von <code>NaN</code> zu vermeiden</item><item value=\"2\" correct=\"false\">Die Verwendung von Klammern mit einem Parameter führt zu einem Fehler</item><item value=\"3\" correct=\"false\">Die geschweiften Klammern fehlen</item></selection><p visible-if=\"wrong\">Wir müssen einen Standardparameterwert festlegen, um die Anzeige von <code>NaN</code> zu vermeiden.</p></body></html>"
          },
          {
            "title": "Lesson #13",
            "id": 148764,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Füge der Arrow Function den Standardparameterwert <code>0</code> hinzu.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\"=&gt;\" /></content></option><option startIndex=\"38\" endIndex=\"45\" /><option startIndex=\"46\" endIndex=\"47\" /><option startIndex=\"48\" endIndex=\"49\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" getConvertedSecondsToMinutes = \" /><text value=\"(\" /><text value=\"seconds = \" /><text value=\"0\" class=\"number\" /><text value=\") =&gt;\" /><text value=\" seconds / \" /><text value=\"60\" class=\"number\" /><text value=\";\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getConvertedSecondsToMinutes());\" /></content></code><p visible-if=\"wrong\">Wähle <code>seconds</code>, gefolgt von <code>=</code> und schließlich <code>0</code> aus.</p></body></html>"
          },
          {
            "title": "Lesson #14",
            "id": 148765,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Code die kürzeste mögliche Syntax, die einen einzelnen Parameter, <code>deltaTime</code>, an eine Arrow Function übergibt.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"validatedInput\" startIndex=\"26\" endIndex=\"35\" isDefault=\"true\" /></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" getFramesInSecond = \" /><text value=\"deltaTime\" class=\"params\" /><text value=\" =&gt;\" /><text value=\" \" /><text value=\"1\" class=\"number\" /><text value=\" / deltaTime;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getFramesInSecond(\" /><text value=\"0.5\" class=\"number\" /><text value=\"));}\" /></content></code><p visible-if=\"wrong\">Gib <code>deltaTime</code> ein.</p></body></html>"
          },
          {
            "title": "Lesson #15",
            "id": 148766,
            "contentType": "interactive",
            "images": [],
            "interactiveContent": "<!DOCTYPE html ><html><body><p>Füge der Arrow Function einen zweiten Parameter, <code>enemyCount</code>, hinzu.</p><code name=\"script.js\" version=\"2\" codelang=\"javascript\"><interactions><interaction type=\"fillTheGap\" isDefault=\"true\"><options><option correct=\"false\"><content><text value=\":\" /></content></option><option correct=\"false\"><content><text value=\"and\" /></content></option><option startIndex=\"27\" endIndex=\"28\" /><option startIndex=\"29\" endIndex=\"39\" /></options></interaction></interactions><content><text value=\"const\" class=\"keyword\" /><text value=\" getTotalLoot = \" /><text value=\"(\" /><text value=\"coins, enemyCount\" class=\"params\" /><text value=\") =&gt;\" /><text value=\" coins * enemyCount;\" /><text type=\"break\" /><text value=\"console\" class=\"built_in\" /><text value=\".log(getTotalLoot(\" /><text value=\"10\" class=\"number\" /><text value=\", \" /><text value=\"5\" class=\"number\" /><text value=\"));\" /></content></code><p visible-if=\"wrong\">Wähle <code>,</code>, gefolgt von <code>enemyCount</code> aus.</p></body></html>"
          }
        ]
      }
    ]
  }
